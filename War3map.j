endfunction
function MihawkQ_Attack takes nothing returns nothing
if GetUnitAbilityLevel(Source,$41303356)>0 and not BvOPassivesBroken(Source) then
call SaveInteger(Hash,GetHandleId(Source),StringHash("MihawkQ_AttackCount"),1+LoadInteger(Hash,GetHandleId(Source),StringHash("MihawkQ_AttackCount")))
if LoadInteger(Hash,GetHandleId(Source),StringHash("MihawkQ_AttackCount"))>=3 then
call SortEnemiesInRange(Source,GetUnitX(Source)+150*Cos(GetUnitFacing(Source)*bj_DEGTORAD),GetUnitY(Source)+150*Sin(GetUnitFacing(Source)*bj_DEGTORAD),315)
call GroupRemoveUnit(TempGroup,Target)
call DamageAndPlayEffectOnGroup(Source,50.+.7*GetHeroStr(Source,false),CLEAN,UNKNOWN,"chest","Abilities\\Weapons\\GargoyleMissile\\GargoyleMissile.mdl")
call SaveInteger(Hash,GetHandleId(Source),StringHash("MihawkQ_AttackCount"),0)
endif
endif
endfunction
function YamamotoQ_Attack takes nothing returns nothing
local unit u=Source
local unit v=Target
local integer level=GetUnitAbilityLevel(u,'A038')
local real now=TimerGetElapsed(AYClock)
if level>0 and not BvOPassivesBroken(u) then
call SaveInteger(Hash,GetHandleId(u),StringHash("YamamotoQ_AttackCount"),1+LoadInteger(Hash,GetHandleId(u),StringHash("YamamotoQ_AttackCount")))
endif
if level>0 and not BvOPassivesBroken(u) and LoadInteger(Hash,GetHandleId(u),StringHash("YamamotoQ_AttackCount"))>=R2I(RBValue(level,5.,5.,6.,6.,7.,7.)) then
call SaveInteger(Hash,GetHandleId(u),StringHash("YamamotoQ_AttackCount"),0)
call SortEnemiesInRange(u,GetUnitX(v),GetUnitY(v),215.)
call DamageAndPlayEffectOnGroup(u,(RBValue(GetUnitAbilityLevel(u,'A038'),25.0,30.0,35.0,40.0,45.0,50.0)+1.0*GetHeroStr(u,false)+0.5*GetHeroInt(u,true)),PHYSICAL,UNKNOWN,"origin","Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
endif
set Source=u
set Target=v
set u=null
set v=null
endfunction
function SoiFonQ_Attack takes nothing returns nothing
// Q is the Bash of 1.1a again (15% chance: bonus damage, critical and 0.1 second stun); no script damage
if false then
if GetHeroAgi(Target,true)<GetHeroAgi(Source,true) then
call DamageUnit(Source,Target,(GetHeroAgi(Source,true)-GetHeroAgi(Target,true))*(.4+.05*GetUnitAbilityLevel(Source,$41303855)),PHYSICAL,UNKNOWN)
endif
endif
endfunction
function OrbOfAbs_Attack takes nothing returns nothing
local real freeMana
local real maxMana=GetUnitState(Target,UNIT_STATE_MAX_MANA)
local real blockAmount=Damage*.4
if UnitHasItemOfTypeBJ(Target,$49303651) and GetUnitState(Target,UNIT_STATE_MANA)>maxMana*.3 then
set freeMana=GetUnitState(Target,UNIT_STATE_MANA)-maxMana*.3
set maxMana=GetUnitState(Target,UNIT_STATE_MAX_MANA)
if GetUnitAbilityLevel(Target,$42303251)>0 then
set blockAmount=Damage*.3
endif
if blockAmount<freeMana then
call SetWidgetLife(Target,GetWidgetLife(Target)+blockAmount)
call SetUnitState(Target,UNIT_STATE_MANA,GetUnitState(Target,UNIT_STATE_MANA)-blockAmount)
if GetOwningPlayer(Target)==GetLocalPlayer() then
call CreateTextTagUnitBJ("-"+I2S(R2I(blockAmount)),Target,0,9.,0,0,100,0)
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,175.,-90)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,.9)
call SetTextTagFadepointBJ(bj_lastCreatedTextTag,.65)
endif
else
call SetWidgetLife(Target,GetWidgetLife(Target)+freeMana)
call SetUnitState(Target,UNIT_STATE_MANA,GetUnitState(Target,UNIT_STATE_MANA)-freeMana)
if GetOwningPlayer(Target)==GetLocalPlayer() then
call CreateTextTagUnitBJ("-"+I2S(R2I(freeMana)),Target,0,9.,0,0,100,0)
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,175.,-90)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,.9)
call SetTextTagFadepointBJ(bj_lastCreatedTextTag,.65)
endif
endif
endif
endfunction
function AceV_TimerActions takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer timerId=GetHandleId(spellTimer)
local unit caster=L_U(timerId,"caster")
local real damage=L_R(GetHandleId(caster),"AceVBlockedDamage")/4*.2
local real duration=L_R(timerId,"AceVduration")+.2
local unit damageSource=L_U(GetHandleId(caster),"lastAttackerHero")
if GetWidgetLife(caster)<=.405 or duration>4 or damageSource==null then
call PauseTimer(spellTimer)
call FlushChildHashtable(Hash,timerId)
call DestroyTimer(spellTimer)
else
call DamageUnit(damageSource,caster,damage,CLEAN,UNKNOWN)
call S_R(timerId,"AceVduration",duration)
endif
set spellTimer=null
set caster=null
set damageSource=null
endfunction
// Fire Skin (V): the real work is in AceV_FireSkinHook (after the Aizen helpers it uses)
function AceV_BlockDamage takes nothing returns nothing
call ExecuteFunc("AceV_FireSkinHook")
endfunction
