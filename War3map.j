call S_R(timerId,"targetX",targetX)
call S_R(timerId,"targetY",targetY)
call TimerStart(spellTimer,.025,true,function ToshiroWBankai_TimerActions)
set caster=null
set spellTimer=null
set dummy=null
endfunction
