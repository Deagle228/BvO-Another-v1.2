function RBYamamotoRingSlow takes unit rbLocal26_caster returns nothing
local group rbLocal26_g=CreateGroup()
local unit rbLocal26_enemy
call GroupEnumUnitsInRange(rbLocal26_g,GetLocationX(B[62]),GetLocationY(B[62]),1200.,null)
loop
set rbLocal26_enemy=FirstOfGroup(rbLocal26_g)
exitwhen rbLocal26_enemy==null
call GroupRemoveUnit(rbLocal26_g,rbLocal26_enemy)
if RBEnemy(rbLocal26_caster,rbLocal26_enemy) then
call CastToTarget(rbLocal26_caster,rbLocal26_enemy,'RX0C',1,"cripple")
endif
endloop
call DestroyGroup(rbLocal26_g)
set rbLocal26_g=null
set rbLocal26_enemy=null
endfunction
function RBLightFlowerTick takes nothing returns nothing
local timer rbLocal27_t=GetExpiredTimer()
local integer rbLocal27_k=GetHandleId(rbLocal27_t)
local unit rbLocal27_caster=LoadUnitHandle(RBState,rbLocal27_k,0)
local unit rbLocal27_victim=LoadUnitHandle(RBState,rbLocal27_k,1)
local unit rbLocal27_missile=LoadUnitHandle(RBState,rbLocal27_k,2)
local real rbLocal27_dx=GetUnitX(rbLocal27_victim)-GetUnitX(rbLocal27_missile)
local real rbLocal27_dy=GetUnitY(rbLocal27_victim)-GetUnitY(rbLocal27_missile)
local real rbLocal27_d=SquareRoot(rbLocal27_dx*rbLocal27_dx+rbLocal27_dy*rbLocal27_dy)
if GetWidgetLife(rbLocal27_victim)<=.405 or GetUnitTypeId(rbLocal27_victim)==0 or GetUnitTypeId(rbLocal27_caster)==0 or rbLocal27_d<=21. then
if GetWidgetLife(rbLocal27_victim)>.405 and GetUnitTypeId(rbLocal27_caster)!=0 and not IsUnitType(rbLocal27_victim,UNIT_TYPE_MAGIC_IMMUNE) and not IsUnitHidden(rbLocal27_victim) then
call DamageUnit(rbLocal27_caster,rbLocal27_victim,LoadReal(RBState,rbLocal27_k,3),MAGICAL,SPELL)
endif
call DestroyEffect(LoadEffectHandle(RBState,rbLocal27_k,4))
call RemoveUnit(rbLocal27_missile)
call FlushChildHashtable(RBState,rbLocal27_k)
call DestroyTimer(rbLocal27_t)
else
call SetUnitX(rbLocal27_missile,GetUnitX(rbLocal27_missile)+21.*rbLocal27_dx/rbLocal27_d)
call SetUnitY(rbLocal27_missile,GetUnitY(rbLocal27_missile)+21.*rbLocal27_dy/rbLocal27_d)
endif
set rbLocal27_caster=null
set rbLocal27_victim=null
set rbLocal27_missile=null
set rbLocal27_t=null
endfunction
function RBLightFlowerLaunch takes unit rbLocal28_caster,unit rbLocal28_victim,real rbLocal28_amount returns nothing
local timer rbLocal28_t=CreateTimer()
local integer rbLocal28_k=GetHandleId(rbLocal28_t)
local unit rbLocal28_missile=CreateUnit(GetOwningPlayer(rbLocal28_caster),'u002',GetUnitX(rbLocal28_caster),GetUnitY(rbLocal28_caster),0.)
call UnitAddAbility(rbLocal28_missile,'Aloc')
call SetUnitFlyHeight(rbLocal28_missile,75.,0.)
call SaveUnitHandle(RBState,rbLocal28_k,0,rbLocal28_caster)
call SaveUnitHandle(RBState,rbLocal28_k,1,rbLocal28_victim)
call SaveUnitHandle(RBState,rbLocal28_k,2,rbLocal28_missile)
call SaveReal(RBState,rbLocal28_k,3,rbLocal28_amount)
call SaveEffectHandle(RBState,rbLocal28_k,4,AddSpecialEffectTarget("Abilities\\Weapons\\FaerieDragonMissile\\FaerieDragonMissile.mdl",rbLocal28_missile,"origin"))
call TimerStart(rbLocal28_t,.03,true,function RBLightFlowerTick)
set rbLocal28_missile=null
set rbLocal28_t=null
endfunction
function RBPushTick takes nothing returns nothing
local timer rbLocal29_t=GetExpiredTimer()
local integer rbLocal29_k=GetHandleId(rbLocal29_t)
local unit rbLocal29_victim=LoadUnitHandle(RBState,rbLocal29_k,0)
local real rbLocal29_angle=LoadReal(RBState,rbLocal29_k,1)
local real rbLocal29_left=LoadReal(RBState,rbLocal29_k,2)
local real rbLocal29_step=RMinBJ(30.,rbLocal29_left)
local real rbLocal29_x=GetUnitX(rbLocal29_victim)+rbLocal29_step*Cos(rbLocal29_angle)
local real rbLocal29_y=GetUnitY(rbLocal29_victim)+rbLocal29_step*Sin(rbLocal29_angle)
if GetWidgetLife(rbLocal29_victim)>.405 and not IsTerrainPathable(rbLocal29_x,rbLocal29_y,PATHING_TYPE_WALKABILITY) and rbLocal29_x>GetRectMinX(bj_mapInitialPlayableArea) and rbLocal29_x<GetRectMaxX(bj_mapInitialPlayableArea) and rbLocal29_y>GetRectMinY(bj_mapInitialPlayableArea) and rbLocal29_y<GetRectMaxY(bj_mapInitialPlayableArea) then
call SetUnitPosition(rbLocal29_victim,rbLocal29_x,rbLocal29_y)
else
set rbLocal29_left=0.
endif
set rbLocal29_left=rbLocal29_left-rbLocal29_step
if rbLocal29_left<=0. then
call FlushChildHashtable(RBState,rbLocal29_k)
call DestroyTimer(rbLocal29_t)
else
call SaveReal(RBState,rbLocal29_k,2,rbLocal29_left)
endif
set rbLocal29_victim=null
set rbLocal29_t=null
endfunction
function RBPush takes unit rbLocal30_victim,real rbLocal30_angle,real rbLocal30_distance returns nothing
local timer rbLocal30_t=CreateTimer()
call SaveUnitHandle(RBState,GetHandleId(rbLocal30_t),0,rbLocal30_victim)
call SaveReal(RBState,GetHandleId(rbLocal30_t),1,rbLocal30_angle)
call SaveReal(RBState,GetHandleId(rbLocal30_t),2,rbLocal30_distance)
call TimerStart(rbLocal30_t,.03,true,function RBPushTick)
set rbLocal30_t=null
endfunction
function RBDisarmEnd takes nothing returns nothing
local timer rbLocal31_t=GetExpiredTimer()
local unit rbLocal31_victim=LoadUnitHandle(RBState,GetHandleId(rbLocal31_t),0)
if TimerGetElapsed(AYClock)>=LoadReal(RBState,GetHandleId(rbLocal31_victim),220) then
call UnitRemoveAbility(rbLocal31_victim,'RRDS')
endif
call FlushChildHashtable(RBState,GetHandleId(rbLocal31_t))
call DestroyTimer(rbLocal31_t)
set rbLocal31_victim=null
set rbLocal31_t=null
endfunction
function RBDisarm takes unit rbLocal32_victim,real rbLocal32_seconds returns nothing
local timer rbLocal32_t
if GetWidgetLife(rbLocal32_victim)>.405 and not IsUnitType(rbLocal32_victim,UNIT_TYPE_MAGIC_IMMUNE) then
call UnitAddAbility(rbLocal32_victim,'RRDS')
call SaveReal(RBState,GetHandleId(rbLocal32_victim),220,TimerGetElapsed(AYClock)+rbLocal32_seconds)
set rbLocal32_t=CreateTimer()
call SaveUnitHandle(RBState,GetHandleId(rbLocal32_t),0,rbLocal32_victim)
call TimerStart(rbLocal32_t,rbLocal32_seconds,false,function RBDisarmEnd)
set rbLocal32_t=null
endif
endfunction
function RBAceQBurn takes nothing returns nothing
