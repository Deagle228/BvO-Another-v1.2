endif
return (RBValue(GetUnitAbilityLevel(rbLocal22_u,'A05U'),100.,150.,200.,250.,300.,300.)+2.0*GetHeroStr(rbLocal22_u,false)+2.5*GetHeroAgi(rbLocal22_u,true))
