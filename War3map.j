function HakudaOnSell takes nothing returns boolean
local unit buyer=GetBuyingUnit()
if GetItemTypeId(GetSoldItem())==HAKUDA_SHOP_ITEM and IsUnitType(buyer,UNIT_TYPE_HERO) then
if HakudaHasParts(buyer) then
call HakudaAssemble(buyer)
endif
endif
set buyer=null
return false
endfunction
function HakudaOnPickup takes nothing returns boolean
local unit holder=GetManipulatingUnit()
// assembled from the parts alone, like Katen Kyokotsu (a recipe left from an older version is removed)
if IsUnitType(holder,UNIT_TYPE_HERO) and HakudaHasParts(holder) then
if UnitHasItemOfTypeBJ(holder,HAKUDA_RECIPE) then
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,HAKUDA_RECIPE))
endif
call HakudaAssemble(holder)
endif
set holder=null
return false
endfunction
function HakudaInit takes nothing returns nothing
local trigger sellTrigger=CreateTrigger()
local trigger pickupTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(sellTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(sellTrigger,Condition(function HakudaOnSell))
call TriggerRegisterAnyUnitEventBJ(pickupTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(pickupTrigger,Condition(function HakudaOnPickup))
set sellTrigger=null
set pickupTrigger=null
endfunction
// ------------------------------------------------------------------ Kido Cleaver (Kido Grimoire + Drake's Axe)
function KidoCleaverHasParts takes unit buyer returns boolean
return UnitHasItemOfTypeBJ(buyer,KIDO_GRIMOIRE_ITEM) and UnitHasItemOfTypeBJ(buyer,$49303147)
endfunction
function KidoCleaverAssemble takes unit buyer returns nothing
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,KIDO_GRIMOIRE_ITEM))
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303147))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",buyer,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",buyer,"origin"))
call UnitAddItemByIdSwapped(KIDO_CLEAVER_ITEM,buyer)
endfunction
function KidoCleaverOnSell takes nothing returns boolean
local unit buyer=GetBuyingUnit()
if GetItemTypeId(GetSoldItem())==KIDO_CLEAVER_SHOP_ITEM and IsUnitType(buyer,UNIT_TYPE_HERO) then
if KidoCleaverHasParts(buyer) then
call KidoCleaverAssemble(buyer)
endif
endif
set buyer=null
return false
endfunction
function KidoCleaverOnPickup takes nothing returns boolean
local unit holder=GetManipulatingUnit()
// assembled from the parts alone, like Katen Kyokotsu (a recipe left from an older version is removed)
if IsUnitType(holder,UNIT_TYPE_HERO) and KidoCleaverHasParts(holder) then
if UnitHasItemOfTypeBJ(holder,KIDO_CLEAVER_RECIPE) then
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,KIDO_CLEAVER_RECIPE))
endif
call KidoCleaverAssemble(holder)
endif
set holder=null
return false
endfunction
function KidoCleaverInit takes nothing returns nothing
local trigger sellTrigger=CreateTrigger()
local trigger pickupTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(sellTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(sellTrigger,Condition(function KidoCleaverOnSell))
call TriggerRegisterAnyUnitEventBJ(pickupTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(pickupTrigger,Condition(function KidoCleaverOnPickup))
set sellTrigger=null
set pickupTrigger=null
endfunction
// ------------------------------------------------------------------ Byakuya E second use (FOCS Gokei)
// While the Bankai (A04V) lasts, the E button is AB0E: the petals gather on the target unit (two rings of 18 petals at
// 500 and 700 fly to it, 20 every 0.04 s), explode, 2 x agility damage that ignores armor, 2 seconds stun (AB0S), and
// the Bankai ends. The map keeps one Bankai (s9[6], rg = active, Dg[1] = armor effect).
function ByakuyaE2Restore takes nothing returns nothing
if ByakuyaE2Hero!=null then
call UnitRemoveAbility(ByakuyaE2Hero,'AB0E')
call SetPlayerAbilityAvailable(GetOwningPlayer(ByakuyaE2Hero),$41303456,true)
endif
set ByakuyaE2Hero=null
call PauseTimer(ByakuyaE2Watch)
endfunction
function ByakuyaE2WatchTick takes nothing returns nothing
if ByakuyaE2Hero==null or not rg or s9[6]!=ByakuyaE2Hero or GetWidgetLife(ByakuyaE2Hero)<=.405 then
call ByakuyaE2Restore()
endif
endfunction
function ByakuyaE2Enable takes nothing returns nothing
local unit byakuya=LoadUnitHandle(DFHash,GetHandleId(GetExpiredTimer()),0)
call FlushChildHashtable(DFHash,GetHandleId(GetExpiredTimer()))
call DestroyTimer(GetExpiredTimer())
if byakuya!=null and rg and s9[6]==byakuya and GetWidgetLife(byakuya)>.405 then
set ByakuyaE2Hero=byakuya
call SetPlayerAbilityAvailable(GetOwningPlayer(byakuya),$41303456,false)
call UnitAddAbility(byakuya,'AB0E')
call TimerStart(ByakuyaE2Watch,.1,true,function ByakuyaE2WatchTick)
endif
set byakuya=null
endfunction
function ByakuyaE2RemovePetal takes nothing returns nothing
call RemoveUnit(GetEnumUnit())
endfunction
function ByakuyaE2IsOwnSwarm takes nothing returns boolean
return (GetUnitTypeId(GetFilterUnit())==$75303042 or GetUnitTypeId(GetFilterUnit())==$75303030 or GetUnitTypeId(GetFilterUnit())==$75303031) and GetOwningPlayer(GetFilterUnit())==GetOwningPlayer(ByakuyaE2Ender)
endfunction
// the Bankai ends like at the end of its duration, and its petals vanish
function ByakuyaE2IsSweptSwarm takes nothing returns boolean
return (GetUnitTypeId(GetFilterUnit())==$75303042 or GetUnitTypeId(GetFilterUnit())==$75303030 or GetUnitTypeId(GetFilterUnit())==$75303031) and GetOwningPlayer(GetFilterUnit())==ByakuyaE2SweepOwner
endfunction
function ByakuyaE2SweepSwarm takes player swarmOwner returns nothing
local group swarm
local unit swarmUnit
local integer swarmType
set swarm=CreateGroup()
call GroupEnumUnitsOfPlayer(swarm,swarmOwner,null)
loop
set swarmUnit=FirstOfGroup(swarm)
exitwhen swarmUnit==null
call GroupRemoveUnit(swarm,swarmUnit)
set swarmType=GetUnitTypeId(swarmUnit)
if swarmType==$75303042 or swarmType==$75303030 or swarmType==$75303031 then
call RemoveUnit(swarmUnit)
endif
endloop
call DestroyGroup(swarm)
set swarm=CreateGroup()
set ByakuyaE2SweepOwner=swarmOwner
call GroupEnumUnitsInRect(swarm,bj_mapInitialPlayableArea,Filter(function ByakuyaE2IsSweptSwarm))
call ForGroup(swarm,function ByakuyaE2RemovePetal)
call DestroyGroup(swarm)
set swarm=null
endfunction
function ByakuyaE2SweepTick takes nothing returns nothing
local timer sweepTimer=GetExpiredTimer()
local integer sweepKey=GetHandleId(sweepTimer)
call ByakuyaE2SweepSwarm(Player(LoadInteger(DFHash,sweepKey,0)))
call SaveInteger(DFHash,sweepKey,1,LoadInteger(DFHash,sweepKey,1)+1)
if LoadInteger(DFHash,sweepKey,1)>=200 or rg then
call FlushChildHashtable(DFHash,sweepKey)
call DestroyTimer(sweepTimer)
endif
set sweepTimer=null
endfunction
function ByakuyaE2EndBankai takes unit byakuya returns nothing
local group swarm
local timer sweepTimer
if rg and (s9[6]==byakuya or s9[6]==null) then
set qg=GetRectCenter(to)
call CreateNUnitsAtLoc(1,$6F6B6F64,GetOwningPlayer(byakuya),qg,bj_UNIT_FACING)
call RemoveLocation(qg)
set qg=null
call SetUnitAbilityLevel(byakuya,$41304149,1)
call SetUnitAbilityLevel(byakuya,$41303538,1)
call DestroyEffect(Dg[1])
set rg=false
set s9[6]=null
set og=0.
endif
set swarm=k6(GetOwningPlayer(byakuya),$75303042)
call ForGroup(swarm,function ByakuyaE2RemovePetal)
call DestroyGroup(swarm)
set swarm=k6(GetOwningPlayer(byakuya),$75303030)
call ForGroup(swarm,function ByakuyaE2RemovePetal)
call DestroyGroup(swarm)
set ByakuyaE2Ender=byakuya
set swarm=CreateGroup()
call GroupEnumUnitsInRect(swarm,bj_mapInitialPlayableArea,Filter(function ByakuyaE2IsOwnSwarm))
call ForGroup(swarm,function ByakuyaE2RemovePetal)
call DestroyGroup(swarm)
set swarm=null
set ByakuyaE2Ender=null
call ForGroup(ByakuyaE2Swarm,function ByakuyaE2RemovePetal)
call GroupClear(ByakuyaE2Swarm)
call UnitRemoveAbility(byakuya,'BUls')
call ByakuyaE2SweepSwarm(GetOwningPlayer(byakuya))
set sweepTimer=CreateTimer()
call SaveInteger(DFHash,GetHandleId(sweepTimer),0,GetPlayerId(GetOwningPlayer(byakuya)))
call TimerStart(sweepTimer,.1,true,function ByakuyaE2SweepTick)
set sweepTimer=null
endfunction
function ByakuyaE2Blast takes integer blastType,real centerX,real centerY returns nothing
local real blastAngle=GetRandomReal(0.,360.)
local real blastDistance=I2R(GetRandomInt(1,200))
local unit blast=CreateUnit(GetOwningPlayer(ByakuyaE2Caster),blastType,centerX+blastDistance*Cos(blastAngle*bj_DEGTORAD),centerY+blastDistance*Sin(blastAngle*bj_DEGTORAD),GetRandomReal(0.,360.))
call SetUnitTimeScale(blast,GetRandomReal(.5,1.))
call UnitApplyTimedLife(blast,'BTLF',.01)
set blast=null
endfunction
function ByakuyaE2Explode takes nothing returns nothing
local real targetX=GetUnitX(ByakuyaE2Target)
local real targetY=GetUnitY(ByakuyaE2Target)
local integer blastIndex=0
local unit stunCaster
call PauseTimer(ByakuyaE2PetalTimer)
call ForGroup(ByakuyaE2Petals,function ByakuyaE2RemovePetal)
call GroupClear(ByakuyaE2Petals)
set ByakuyaE2Leader=null
loop
exitwhen blastIndex>=16
call ByakuyaE2Blast('hB0A',targetX,targetY)
call ByakuyaE2Blast('hB0C',targetX,targetY)
call ByakuyaE2Blast('hB0B',targetX,targetY)
call ByakuyaE2Blast('hB0D',targetX,targetY)
set blastIndex=blastIndex+1
endloop
call PlaySoundOnUnitBJ(br,100,ByakuyaE2Target)
if GetWidgetLife(ByakuyaE2Target)>.405 and IsUnitEnemy(ByakuyaE2Target,GetOwningPlayer(ByakuyaE2Caster)) then
call DamageUnit(ByakuyaE2Caster,ByakuyaE2Target,2.*I2R(GetHeroAgi(ByakuyaE2Caster,true)),CLEAN,SPELL)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",ByakuyaE2Target,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",ByakuyaE2Target,"head"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",ByakuyaE2Target,"hand right"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",ByakuyaE2Target,"hand left"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",ByakuyaE2Target,"foot left"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",ByakuyaE2Target,"foot right"))
if GetWidgetLife(ByakuyaE2Target)>.405 then
set stunCaster=CreateUnit(GetOwningPlayer(ByakuyaE2Caster),$75303032,targetX,targetY,0.)
call UnitAddAbility(stunCaster,'AB0S')
call IssueTargetOrder(stunCaster,"thunderbolt",ByakuyaE2Target)
call UnitApplyTimedLife(stunCaster,'BTLF',2.)
call SetUnitAnimation(ByakuyaE2Target,"death")
call QueueUnitAnimation(ByakuyaE2Target,"stand")
endif
endif
set stunCaster=null
set ByakuyaE2Caster=null
set ByakuyaE2Target=null
endfunction
function ByakuyaE2MovePetal takes nothing returns nothing
local unit petal=GetEnumUnit()
local real petalAngle=Atan2(GetUnitY(ByakuyaE2Target)-GetUnitY(petal),GetUnitX(ByakuyaE2Target)-GetUnitX(petal))
local real petalGap=SquareRoot((GetUnitX(ByakuyaE2Target)-GetUnitX(petal))*(GetUnitX(ByakuyaE2Target)-GetUnitX(petal))+(GetUnitY(ByakuyaE2Target)-GetUnitY(petal))*(GetUnitY(ByakuyaE2Target)-GetUnitY(petal)))
local real petalStep=petalGap*.04/RMaxBJ(.04,1.-ByakuyaE2PetalTime+.04)
call SetUnitX(petal,GetUnitX(petal)+petalStep*Cos(petalAngle))
call SetUnitY(petal,GetUnitY(petal)+petalStep*Sin(petalAngle))
call SetUnitFacing(petal,petalAngle*bj_RADTODEG)
call QueueUnitAnimation(petal,"birth")
set petal=null
endfunction
function ByakuyaE2PetalTick takes nothing returns nothing
local real gapX
local real gapY
set ByakuyaE2PetalTime=ByakuyaE2PetalTime+.04
call ForGroup(ByakuyaE2Petals,function ByakuyaE2MovePetal)
set gapX=GetUnitX(ByakuyaE2Leader)-GetUnitX(ByakuyaE2Target)
set gapY=GetUnitY(ByakuyaE2Leader)-GetUnitY(ByakuyaE2Target)
if ByakuyaE2PetalTime>=.999 or GetUnitTypeId(ByakuyaE2Target)==0 then
call ByakuyaE2Explode()
endif
endfunction
function ByakuyaE2Cast takes unit byakuya,unit target returns nothing
local integer petalIndex=1
local real ringAngle
local unit petal
if ByakuyaE2Target!=null then
call ByakuyaE2Explode()
endif
set ByakuyaE2Caster=byakuya
set ByakuyaE2Target=target
set ByakuyaE2PetalTime=0.
loop
exitwhen petalIndex>18
set ringAngle=I2R(petalIndex)*20.*bj_DEGTORAD
set petal=CreateUnit(GetOwningPlayer(byakuya),'hB0P',GetUnitX(target)+500.*Cos(ringAngle),GetUnitY(target)+500.*Sin(ringAngle),petalIndex*20.+180.)
call SetUnitPathing(petal,false)
call GroupAddUnit(ByakuyaE2Petals,petal)
if petalIndex==1 then
set ByakuyaE2Leader=petal
endif
set petal=CreateUnit(GetOwningPlayer(byakuya),'hB0P',GetUnitX(target)+700.*Cos(ringAngle),GetUnitY(target)+700.*Sin(ringAngle),petalIndex*20.+180.)
call SetUnitPathing(petal,false)
call GroupAddUnit(ByakuyaE2Petals,petal)
set petalIndex=petalIndex+1
endloop
call TimerStart(ByakuyaE2PetalTimer,.04,true,function ByakuyaE2PetalTick)
set petal=null
endfunction
function ByakuyaE2OnSpell takes nothing returns boolean
local timer enableTimer
local unit byakuya
local unit target
if GetSpellAbilityId()==$41303456 and GetUnitTypeId(GetTriggerUnit())=='UC13' and not IsUnitIllusion(GetTriggerUnit()) then
set enableTimer=CreateTimer()
call SaveUnitHandle(DFHash,GetHandleId(enableTimer),0,GetTriggerUnit())
call TimerStart(enableTimer,.05,false,function ByakuyaE2Enable)
set enableTimer=null
elseif GetSpellAbilityId()=='AB0E' and GetSpellTargetUnit()!=null then
set byakuya=GetTriggerUnit()
set target=GetSpellTargetUnit()
call ByakuyaE2EndBankai(byakuya)
set ByakuyaE2Hero=byakuya
call ByakuyaE2Restore()
call ByakuyaE2Cast(byakuya,target)
elseif GetUnitTypeId(GetSummonedUnit())==$75303042 or GetUnitTypeId(GetSummonedUnit())==$75303030 or GetUnitTypeId(GetSummonedUnit())==$75303031 then
// the petals of the Bankai (Locust Swarm units) are kept to end the Bankai early
call GroupAddUnit(ByakuyaE2Swarm,GetSummonedUnit())
endif
set byakuya=null
set target=null
return false
endfunction
function ByakuyaE2Init takes nothing returns nothing
local trigger spellTrigger=CreateTrigger()
set ByakuyaE2Watch=CreateTimer()
set ByakuyaE2PetalTimer=CreateTimer()
set ByakuyaE2Petals=CreateGroup()
set ByakuyaE2Swarm=CreateGroup()
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SUMMON)
call TriggerAddCondition(spellTrigger,Condition(function ByakuyaE2OnSpell))
set spellTrigger=null
endfunction
// ------------------------------------------------------------------ Divine Rapier in Recipe Shop 6 after Saber Nero
// Both n00Y shops sell the button IP04 (20000) once Saber Nero is slain; every team can buy one Divine Rapier.
// The stock is kept by the script: one in each shop while a team still has not bought its rapier.
function RapierShopIsShop takes nothing returns boolean
return GetUnitTypeId(GetFilterUnit())=='n00Y'
endfunction
function RapierShopRestock takes nothing returns nothing
endfunction
function RapierShopRestockOld takes nothing returns nothing
local group shops=CreateGroup()
local unit shop
local integer playerIndex=0
local boolean teamWaiting=false
loop
exitwhen playerIndex>11
if BvOSlotState(Player(playerIndex))==PLAYER_SLOT_STATE_PLAYING and not RapierShopBought[GetPlayerTeam(Player(playerIndex))] then
set teamWaiting=true
endif
set playerIndex=playerIndex+1
endloop
call GroupEnumUnitsInRect(shops,bj_mapInitialPlayableArea,Filter(function RapierShopIsShop))
loop
set shop=FirstOfGroup(shops)
exitwhen shop==null
call GroupRemoveUnit(shops,shop)
call RemoveItemFromStock(shop,'IP04')
if RapierShopUnlocked and teamWaiting then
call AddItemToStock(shop,'IP04',1,1)
endif
endloop
call DestroyGroup(shops)
set shops=null
endfunction
function RapierShopUnlock takes nothing returns nothing
local integer markerIndex=0
if not RapierShopUnlocked then
loop
exitwhen markerIndex>11
call CreateUnit(Player(markerIndex),'hRAP',-7600.,-6800.,0.)
set markerIndex=markerIndex+1
endloop
endif
set RapierShopUnlocked=true
call RapierShopRestock()
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10,"|cffffcc00Saber Nero is slain: Recipe Shop 7 sells one Divine Rapier for every team.|r")
endfunction
function RapierShopOnSell takes nothing returns boolean
local unit buyer=GetBuyingUnit()
local player buyerOwner=GetOwningPlayer(buyer)
local integer buyerTeam=GetPlayerTeam(buyerOwner)
if GetItemTypeId(GetSoldItem())=='IP04' then
call RemoveItem(GetSoldItem())
if not IsUnitType(buyer,UNIT_TYPE_HERO) or RapierShopBought[buyerTeam] then
call SetPlayerState(buyerOwner,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(buyerOwner,PLAYER_STATE_RESOURCE_GOLD)+20000)
if GetLocalPlayer()==buyerOwner then
if RapierShopBought[buyerTeam] then
call DisplayTimedTextToPlayer(buyerOwner,0,0,6,"|cffffcc00Your team has already bought its Divine Rapier.|r")
else
call DisplayTimedTextToPlayer(buyerOwner,0,0,6,"|cffffcc00Only a hero can buy the Divine Rapier.|r")
endif
endif
else
set RapierShopBought[buyerTeam]=true
call UnitAddItemByIdSwapped($49303041,buyer)
endif
call RapierShopRestock()
endif
set buyer=null
set buyerOwner=null
return false
endfunction
function RapierShopInit takes nothing returns nothing
local trigger sellTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(sellTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(sellTrigger,Condition(function RapierShopOnSell))
set sellTrigger=null
endfunction
// ------------------------------------------------------------------ Nanatsu Yoru (Blood Sword + Excalibur + recipe 15000)
function NanatsuYoruHasParts takes unit buyer returns boolean
return UnitHasItemOfTypeBJ(buyer,$49303039) and UnitHasItemOfTypeBJ(buyer,$49303346)
endfunction
function NanatsuYoruAssemble takes unit buyer returns nothing
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303039))
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303346))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactCaster.mdl",buyer,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",buyer,"origin"))
call UnitAddItemByIdSwapped('IY01',buyer)
endfunction
function NanatsuYoruOnSell takes nothing returns boolean
local unit buyer=GetBuyingUnit()
if GetItemTypeId(GetSoldItem())=='IY04' and IsUnitType(buyer,UNIT_TYPE_HERO) then
if NanatsuYoruHasParts(buyer) then
call NanatsuYoruAssemble(buyer)
else
call UnitAddItemByIdSwapped('IY03',buyer)
endif
endif
set buyer=null
return false
endfunction
function NanatsuYoruOnPickup takes nothing returns boolean
local unit holder=GetManipulatingUnit()
if IsUnitType(holder,UNIT_TYPE_HERO) and UnitHasItemOfTypeBJ(holder,'IY03') and NanatsuYoruHasParts(holder) then
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,'IY03'))
call NanatsuYoruAssemble(holder)
endif
set holder=null
return false
endfunction
function NanatsuYoruInit takes nothing returns nothing
local trigger sellTrigger=CreateTrigger()
local trigger pickupTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(sellTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(sellTrigger,Condition(function NanatsuYoruOnSell))
call TriggerRegisterAnyUnitEventBJ(pickupTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(pickupTrigger,Condition(function NanatsuYoruOnPickup))
set sellTrigger=null
set pickupTrigger=null
endfunction
// ------------------------------------------------------------------ Oken (Soul Booster + 2 Soul Orbs) and Oken Blessing
function OkenIsSceptre takes integer itemType returns boolean
return itemType==$49303342 or itemType==$49303534 or itemType==$49303344
endfunction
function OkenHeld takes unit holder returns item
if UnitHasItemOfTypeBJ(holder,$49303342) then
return GetItemOfTypeFromUnitBJ(holder,$49303342)
elseif UnitHasItemOfTypeBJ(holder,$49303534) then
return GetItemOfTypeFromUnitBJ(holder,$49303534)
endif
return GetItemOfTypeFromUnitBJ(holder,$49303344)
endfunction
function OkenHasParts takes unit buyer returns boolean
return UnitHasItemOfTypeBJ(buyer,$49303241) and GetNumberOfItemsId(buyer,$49303036)>=2
endfunction
function OkenAssemble takes unit buyer returns nothing
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303241))
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303036))
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303036))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",buyer,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",buyer,"origin"))
// the basic Oken; the existing pickup triggers turn it into the version that upgrades this hero's abilities
call UnitAddItemByIdSwapped($49303344,buyer)
endfunction
function OkenIsBlessed takes unit hero returns boolean
return GetUnitAbilityLevel(hero,OKEN_BLESSING_MARKER)>0
endfunction
function OkenBless takes unit hero returns nothing
local integer heroType=GetUnitTypeId(hero)
// the Oken item goes first, so its ability upgrades are undone before the permanent ones are applied
call RemoveItem(OkenHeld(hero))
call UnitAddAbility(hero,OKEN_BLESSING_MARKER)
call UnitMakeAbilityPermanent(hero,true,OKEN_BLESSING_MARKER)
if heroType==$45303034 or heroType==$45303030 or heroType==$45303032 or heroType==$45303031 then
call UnitAddAbility(hero,OKEN_BLESSING_UPGRADE)
call UnitMakeAbilityPermanent(hero,true,OKEN_BLESSING_UPGRADE)
elseif heroType==$4E303058 then
call UnitAddAbility(hero,OKEN_BLESSING_UPGRADE_KUMA)
call UnitMakeAbilityPermanent(hero,true,OKEN_BLESSING_UPGRADE_KUMA)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",hero,"origin"))
endfunction
function OkenOnSell takes nothing returns boolean
local unit buyer=GetBuyingUnit()
local integer soldType=GetItemTypeId(GetSoldItem())
if IsUnitType(buyer,UNIT_TYPE_HERO) then
if soldType==OKEN_SHOP_ITEM then
if OkenHasParts(buyer) then
call OkenAssemble(buyer)
else
call UnitAddItemByIdSwapped(OKEN_RECIPE,buyer)
endif
elseif soldType==OKEN_BLESSING_SHOP_ITEM then
if OkenIsBlessed(buyer) then
call SetPlayerState(GetOwningPlayer(buyer),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(buyer),PLAYER_STATE_RESOURCE_GOLD)+10000)
if GetOwningPlayer(buyer)==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffc3dbffThis hero already has the Oken Blessing.|r")
endif
elseif OkenHeld(buyer)!=null then
call OkenBless(buyer)
else
call UnitAddItemByIdSwapped(OKEN_BLESSING_RECIPE,buyer)
endif
endif
endif
set buyer=null
return false
endfunction
function OkenBonusCheck takes nothing returns nothing
local timer checkTimer=GetExpiredTimer()
local unit holder=LoadUnitHandle(OkenHash,GetHandleId(checkTimer),0)
local boolean holds=OkenHeld(holder)!=null
call BusoshokuSetBonus(holder,OKEN_MANA_REGENERATION,holds)
call BusoshokuSetBonus(holder,OKEN_REGENERATION,holds)
call FlushChildHashtable(OkenHash,GetHandleId(checkTimer))
call DestroyTimer(checkTimer)
set checkTimer=null
set holder=null
endfunction
function OkenQueueBonusCheck takes unit holder returns nothing
local timer checkTimer=CreateTimer()
call SaveUnitHandle(OkenHash,GetHandleId(checkTimer),0,holder)
call TimerStart(checkTimer,0.,false,function OkenBonusCheck)
set checkTimer=null
endfunction
function OkenOnPickup takes nothing returns boolean
local unit holder=GetManipulatingUnit()
local integer itemType=GetItemTypeId(GetManipulatedItem())
if OkenIsSceptre(itemType) and OkenIsBlessed(holder) then
// a blessed hero already has the upgrades; a second set from an item would undo them when the item is dropped
call UnitRemoveItemSwapped(GetManipulatedItem(),holder)
if GetOwningPlayer(holder)==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffc3dbffThis hero already has the Oken Blessing.|r")
endif
elseif IsUnitType(holder,UNIT_TYPE_HERO) then
if UnitHasItemOfTypeBJ(holder,OKEN_RECIPE) and OkenHasParts(holder) then
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,OKEN_RECIPE))
call OkenAssemble(holder)
elseif UnitHasItemOfTypeBJ(holder,OKEN_BLESSING_RECIPE) and OkenHeld(holder)!=null then
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,OKEN_BLESSING_RECIPE))
call OkenBless(holder)
endif
endif
if OkenIsSceptre(itemType) then
call OkenQueueBonusCheck(holder)
endif
set holder=null
return false
endfunction
function OkenOnDrop takes nothing returns boolean
if OkenIsSceptre(GetItemTypeId(GetManipulatedItem())) then
call OkenQueueBonusCheck(GetManipulatingUnit())
endif
return false
endfunction
function OkenInit takes nothing returns nothing
local trigger sellTrigger=CreateTrigger()
local trigger pickupTrigger=CreateTrigger()
local trigger dropTrigger=CreateTrigger()
set OkenHash=InitHashtable()
call TriggerRegisterAnyUnitEventBJ(sellTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(sellTrigger,Condition(function OkenOnSell))
call TriggerRegisterAnyUnitEventBJ(pickupTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(pickupTrigger,Condition(function OkenOnPickup))
call TriggerRegisterAnyUnitEventBJ(dropTrigger,EVENT_PLAYER_UNIT_DROP_ITEM)
call TriggerAddCondition(dropTrigger,Condition(function OkenOnDrop))
set sellTrigger=null
set pickupTrigger=null
set dropTrigger=null
endfunction
// ------------------------------------------------------------------ Onmitsukido Blade (Geppo Cloak + Sokyoku)
function OnmitsuHasParts takes unit buyer returns boolean
return UnitHasItemOfTypeBJ(buyer,$4930324A) and UnitHasItemOfTypeBJ(buyer,$49303143)
endfunction
function OnmitsuAssemble takes unit buyer returns nothing
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$4930324A))
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303143))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",buyer,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",buyer,"origin"))
call UnitAddItemByIdSwapped(ONMITSU_ITEM,buyer)
endfunction
function OnmitsuOnSell takes nothing returns boolean
local unit buyer=GetBuyingUnit()
if GetItemTypeId(GetSoldItem())==ONMITSU_SHOP_ITEM and IsUnitType(buyer,UNIT_TYPE_HERO) then
if OnmitsuHasParts(buyer) then
call OnmitsuAssemble(buyer)
else
call UnitAddItemByIdSwapped(ONMITSU_RECIPE,buyer)
endif
endif
set buyer=null
return false
endfunction
function OnmitsuOnPickup takes nothing returns boolean
local unit holder=GetManipulatingUnit()
if IsUnitType(holder,UNIT_TYPE_HERO) and UnitHasItemOfTypeBJ(holder,ONMITSU_RECIPE) and OnmitsuHasParts(holder) then
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,ONMITSU_RECIPE))
call OnmitsuAssemble(holder)
endif
set holder=null
return false
endfunction
// like Geppo Cloak: the item cannot be dropped while it is on cooldown
function OnmitsuDroppableAgain takes nothing returns nothing
local timer dropTimer=GetExpiredTimer()
call SetItemDroppable(LoadItemHandle(OnmitsuHash,GetHandleId(dropTimer),0),true)
call FlushChildHashtable(OnmitsuHash,GetHandleId(dropTimer))
call DestroyTimer(dropTimer)
set dropTimer=null
endfunction
function OnmitsuOnUse takes nothing returns boolean
local timer dropTimer
if GetItemTypeId(GetManipulatedItem())==ONMITSU_ITEM then
call SetItemDroppable(GetManipulatedItem(),false)
set dropTimer=CreateTimer()
call SaveItemHandle(OnmitsuHash,GetHandleId(dropTimer),0,GetManipulatedItem())
call TimerStart(dropTimer,ONMITSU_COOLDOWN,false,function OnmitsuDroppableAgain)
set dropTimer=null
endif
return false
endfunction
// an attack started while invisible marks the target; the hit itself (damage event) applies the break
function OnmitsuOnAttacked takes nothing returns boolean
local unit attacker=GetAttacker()
if UnitHasItemOfTypeBJ(attacker,ONMITSU_ITEM) and GetUnitAbilityLevel(attacker,ONMITSU_INVISIBILITY_BUFF)>0 then
call SaveUnitHandle(OnmitsuHash,GetHandleId(attacker),1,GetTriggerUnit())
call SaveReal(OnmitsuHash,GetHandleId(attacker),2,TimerGetElapsed(AYClock))
endif
set attacker=null
return false
endfunction
// abilities that cannot be activated (passives) of the heroes; the ones the target has are switched off for its owner
function OnmitsuSetPassives takes unit target,boolean available returns nothing
local integer targetKey=GetHandleId(target)
local integer passiveCount=LoadInteger(OnmitsuHash,0,0)
local integer passiveIndex=1
local integer passiveMask=LoadInteger(OnmitsuHash,targetKey,5)
local integer passiveBit=1
local integer passiveAbility
loop
exitwhen passiveIndex>passiveCount
set passiveAbility=LoadInteger(OnmitsuHash,0,passiveIndex)
if available then
if ModuloInteger(passiveMask/passiveBit,2)==1 and not (passiveAbility=='A03S' and GetUnitAbilityLevel(target,'SDC0')>0) and not (passiveAbility=='A038' and GetUnitAbilityLevel(target,'YMC0')>0) then
call SetPlayerAbilityAvailable(GetOwningPlayer(target),passiveAbility,true)
endif
elseif GetUnitAbilityLevel(target,passiveAbility)>0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(target),passiveAbility,false)
if ModuloInteger(passiveMask/passiveBit,2)==0 then
set passiveMask=passiveMask+passiveBit
endif
endif
set passiveIndex=passiveIndex+1
set passiveBit=passiveBit*2
endloop
if available then
call RemoveSavedInteger(OnmitsuHash,targetKey,5)
else
call SaveInteger(OnmitsuHash,targetKey,5,passiveMask)
endif
endfunction
function OnmitsuBreakEnd takes nothing returns nothing
local timer breakTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(breakTimer)
local unit target=LoadUnitHandle(OnmitsuHash,timerKey,0)
if LoadInteger(OnmitsuHash,GetHandleId(target),3)==timerKey then
call OnmitsuSetPassives(target,true)
call RemoveSavedInteger(OnmitsuHash,GetHandleId(target),3)
call DestroyEffect(LoadEffectHandle(OnmitsuHash,GetHandleId(target),4))
call RemoveSavedHandle(OnmitsuHash,GetHandleId(target),4)
endif
call FlushChildHashtable(OnmitsuHash,timerKey)
call DestroyTimer(breakTimer)
set breakTimer=null
set target=null
endfunction
function OnmitsuBreak takes unit target returns nothing
local integer targetKey=GetHandleId(target)
local timer breakTimer=CreateTimer()
if HaveSavedHandle(OnmitsuHash,targetKey,4) then
call DestroyEffect(LoadEffectHandle(OnmitsuHash,targetKey,4))
endif
call OnmitsuSetPassives(target,false)
call SaveInteger(OnmitsuHash,targetKey,3,GetHandleId(breakTimer))
call SaveEffectHandle(OnmitsuHash,targetKey,4,AddSpecialEffectTarget("Abilities\\Spells\\Other\\Silence\\SilenceTarget.mdl",target,"overhead"))
call SaveUnitHandle(OnmitsuHash,GetHandleId(breakTimer),0,target)
call TimerStart(breakTimer,ONMITSU_BREAK_DURATION,false,function OnmitsuBreakEnd)
set breakTimer=null
endfunction
function OnmitsuIsBroken takes unit target returns boolean
return LoadInteger(OnmitsuHash,GetHandleId(target),3)>0
endfunction
// lifesteal of a broken unit: half of the life it regained from this hit is taken back right after the hit
function OnmitsuLifestealCheck takes nothing returns nothing
local timer checkTimer=GetExpiredTimer()
local unit stealer=LoadUnitHandle(OnmitsuHash,GetHandleId(checkTimer),0)
local real lifeBefore=LoadReal(OnmitsuHash,GetHandleId(checkTimer),1)
local real healed=GetWidgetLife(stealer)-lifeBefore
if healed>0. and GetWidgetLife(stealer)>.405 then
call SetWidgetLife(stealer,GetWidgetLife(stealer)-healed*ONMITSU_LIFESTEAL_CUT)
endif
call FlushChildHashtable(OnmitsuHash,GetHandleId(checkTimer))
call DestroyTimer(checkTimer)
set checkTimer=null
set stealer=null
endfunction
function OnmitsuDamageHook takes nothing returns nothing
local timer checkTimer
if Damage<=0. or Source==null then
return
endif
if LoadUnitHandle(OnmitsuHash,GetHandleId(Source),1)==Target and TimerGetElapsed(AYClock)-LoadReal(OnmitsuHash,GetHandleId(Source),2)<1.5 and AYIsAttackDamage() then
call RemoveSavedHandle(OnmitsuHash,GetHandleId(Source),1)
call OnmitsuBreak(Target)
endif
if OnmitsuIsBroken(Source) and Source!=Target then
set checkTimer=CreateTimer()
call SaveUnitHandle(OnmitsuHash,GetHandleId(checkTimer),0,Source)
call SaveReal(OnmitsuHash,GetHandleId(checkTimer),1,GetWidgetLife(Source))
call TimerStart(checkTimer,0.,false,function OnmitsuLifestealCheck)
set checkTimer=null
endif
endfunction
function OnmitsuInit takes nothing returns nothing
local trigger sellTrigger=CreateTrigger()
local trigger pickupTrigger=CreateTrigger()
local trigger useTrigger=CreateTrigger()
local trigger attackTrigger=CreateTrigger()
set OnmitsuHash=InitHashtable()
call SaveInteger(OnmitsuHash,0,1,'A00K')
call SaveInteger(OnmitsuHash,0,2,'A035')
call SaveInteger(OnmitsuHash,0,3,'A0CA')
call SaveInteger(OnmitsuHash,0,4,'A09O')
call SaveInteger(OnmitsuHash,0,5,'A03S')
call SaveInteger(OnmitsuHash,0,6,'A07L')
call SaveInteger(OnmitsuHash,0,7,'A038')
call SaveInteger(OnmitsuHash,0,8,'A08U')
call SaveInteger(OnmitsuHash,0,9,'A03Z')
call SaveInteger(OnmitsuHash,0,10,'A006')
call SaveInteger(OnmitsuHash,0,11,'A0C2')
call SaveInteger(OnmitsuHash,0,12,'A0CY')
call SaveInteger(OnmitsuHash,0,13,'A03V')
call SaveInteger(OnmitsuHash,0,14,'AS05')
call SaveInteger(OnmitsuHash,0,15,'A09G')
call SaveInteger(OnmitsuHash,0,0,15)
call TriggerRegisterAnyUnitEventBJ(sellTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(sellTrigger,Condition(function OnmitsuOnSell))
call TriggerRegisterAnyUnitEventBJ(pickupTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(pickupTrigger,Condition(function OnmitsuOnPickup))
call TriggerRegisterAnyUnitEventBJ(useTrigger,EVENT_PLAYER_UNIT_USE_ITEM)
call TriggerAddCondition(useTrigger,Condition(function OnmitsuOnUse))
call TriggerRegisterAnyUnitEventBJ(attackTrigger,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(attackTrigger,Condition(function OnmitsuOnAttacked))
set sellTrigger=null
set pickupTrigger=null
set useTrigger=null
set attackTrigger=null
endfunction
// Edward Elric, ported from FOCS Another 10.0 A06 (unit O006, triggers yunsung*, yunsungjin*, yunsungC*,
// yunsungIm*, yunsungEskill*, ADes*, Gajo_1). The GUI globals of the original are replaced by timers and
// per-hero data in EDHash, so several Edwards and several casts can run at the same time.
function EDIsEnemy takes unit candidate,player ownerPlayer returns boolean
return candidate!=null and GetWidgetLife(candidate)>.405 and IsUnitEnemy(candidate,ownerPlayer)
endfunction
function EDDummy takes player dummyOwner,integer dummyType,real dummyX,real dummyY,real dummyFacing,real dummyLife returns unit
set EDLastDummy=CreateUnit(dummyOwner,dummyType,dummyX,dummyY,dummyFacing)
call UnitApplyTimedLife(EDLastDummy,'BTLF',dummyLife)
return EDLastDummy
endfunction
function EDPlaySound takes sound spellSound returns nothing
call StopSound(spellSound,false,false)
call StartSound(spellSound)
endfunction
function EDCreateSound takes string soundPath,integer soundDuration returns sound
local sound spellSound=CreateSound(soundPath,false,false,false,10,10,"DefaultEAXON")
call SetSoundDuration(spellSound,soundDuration)
call SetSoundChannel(spellSound,0)
call SetSoundVolume(spellSound,127)
call SetSoundPitch(spellSound,1.)
call Preload(soundPath)
set EDLastSound=spellSound
set spellSound=null
return EDLastSound
endfunction
function EDStopTimer takes timer spellTimer returns nothing
call FlushChildHashtable(EDHash,GetHandleId(spellTimer))
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endfunction
function EDStun takes unit edwardHero,unit stunTarget,integer stunLevel returns nothing
local unit stunCaster
if stunTarget==null or GetWidgetLife(stunTarget)<=.405 then
return
endif
set stunCaster=CreateUnit(GetOwningPlayer(edwardHero),'hL02',GetUnitX(stunTarget)-16.,GetUnitY(stunTarget),0.)
call UnitAddAbility(stunCaster,'AL0S')
call SetUnitAbilityLevel(stunCaster,'AL0S',stunLevel)
call UnitApplyTimedLife(stunCaster,'BTLF',1.)
call IssueTargetOrder(stunCaster,"thunderbolt",stunTarget)
set stunCaster=null
endfunction
function EDHitTarget takes unit edwardHero,unit hitTarget,real hitDamage,integer stunLevel,string hitEffect returns nothing
if hitDamage>0. then
call BvOHeroSpellDamage(edwardHero,hitTarget,hitDamage,true,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC)
endif
if stunLevel>0 then
call EDStun(edwardHero,hitTarget,stunLevel)
endif
if hitEffect!="" then
call DestroyEffect(AddSpecialEffectTarget(hitEffect,hitTarget,"chest"))
endif
endfunction
function EDDamageArea takes unit edwardHero,real areaX,real areaY,real areaRadius,real areaDamage,integer stunLevel,string hitEffect returns nothing
local group areaTargets=CreateGroup()
local unit areaTarget
local player edwardOwner=GetOwningPlayer(edwardHero)
call GroupEnumUnitsInRange(areaTargets,areaX,areaY,areaRadius,null)
loop
set areaTarget=FirstOfGroup(areaTargets)
exitwhen areaTarget==null
call GroupRemoveUnit(areaTargets,areaTarget)
if EDIsEnemy(areaTarget,edwardOwner) then
call EDHitTarget(edwardHero,areaTarget,areaDamage,stunLevel,hitEffect)
endif
endloop
call DestroyGroup(areaTargets)
set areaTargets=null
set areaTarget=null
set edwardOwner=null
endfunction
// cone like Breath of Fire: starts with startRadius at the origin and widens to endRadius at coneLength
function EDDamageCone takes unit edwardHero,real originX,real originY,real coneAngle,real coneLength,real startRadius,real endRadius,real coneDamage returns nothing
local group coneTargets=CreateGroup()
local unit coneTarget
local player edwardOwner=GetOwningPlayer(edwardHero)
local real targetDeltaX
local real targetDeltaY
local real targetForward
local real targetSideways
call GroupEnumUnitsInRange(coneTargets,originX+coneLength*.5*Cos(coneAngle),originY+coneLength*.5*Sin(coneAngle),coneLength*.5+endRadius,null)
loop
set coneTarget=FirstOfGroup(coneTargets)
exitwhen coneTarget==null
call GroupRemoveUnit(coneTargets,coneTarget)
if EDIsEnemy(coneTarget,edwardOwner) then
set targetDeltaX=GetUnitX(coneTarget)-originX
set targetDeltaY=GetUnitY(coneTarget)-originY
set targetForward=targetDeltaX*Cos(coneAngle)+targetDeltaY*Sin(coneAngle)
set targetSideways=RAbsBJ(-targetDeltaX*Sin(coneAngle)+targetDeltaY*Cos(coneAngle))
if targetForward>=-startRadius and targetForward<=coneLength and targetSideways<=startRadius+(endRadius-startRadius)*RMaxBJ(targetForward,0.)/coneLength then
call EDHitTarget(edwardHero,coneTarget,coneDamage,0,"")
endif
endif
endloop
call DestroyGroup(coneTargets)
set coneTargets=null
set coneTarget=null
set edwardOwner=null
endfunction
function EDGroundTrail takes real originX,real originY,real trailAngle,integer trailCount returns nothing
local integer trailIndex=1
loop
exitwhen trailIndex>trailCount
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",originX+50.*trailIndex*Cos(trailAngle),originY+50.*trailIndex*Sin(trailAngle)))
set trailIndex=trailIndex+1
endloop
endfunction
// thirty spikes rising in a spiral (the n01R part of yunsungIm)
function EDRaiseSpikes takes player edwardOwner,real spikesX,real spikesY,integer spikesLevel returns nothing
local integer spikeIndex=1
local unit spike
loop
exitwhen spikeIndex>30
set spike=EDDummy(edwardOwner,'hE03',spikesX,spikesY,30.*spikeIndex,3.)
call SetUnitScale(spike,spikeIndex*.03*spikesLevel,spikeIndex*.2,spikeIndex*.2)
call SetUnitTimeScale(spike,2.5)
call SetUnitAnimation(spike,"birth")
set spikeIndex=spikeIndex+1
endloop
set spike=null
endfunction
function EDAbilityLevel takes unit edwardHero,integer abilityId returns integer
return IMaxBJ(GetUnitAbilityLevel(edwardHero,abilityId),1)
endfunction
function EDSpikeDamage takes integer spikesLevel returns real
if spikesLevel<=1 then
return 250.
elseif spikesLevel==2 then
return 400.
endif
return 200.*spikesLevel
endfunction
// ------------------------------------------------------------------ T: Transmutation Circle
function EDCircleGroup takes unit edwardHero returns group
local group circleGroup=LoadGroupHandle(EDHash,GetHandleId(edwardHero),1)
if circleGroup==null then
set circleGroup=CreateGroup()
call SaveGroupHandle(EDHash,GetHandleId(edwardHero),1,circleGroup)
endif
set EDLastGroup=circleGroup
set circleGroup=null
return EDLastGroup
endfunction
function EDCountCircles takes unit edwardHero returns integer
local group circleGroup=EDCircleGroup(edwardHero)
local group circleScan=CreateGroup()
local unit circle
local integer circleCount=0
call GroupAddGroup(circleGroup,circleScan)
loop
set circle=FirstOfGroup(circleScan)
exitwhen circle==null
call GroupRemoveUnit(circleScan,circle)
if GetUnitTypeId(circle)!=0 and GetWidgetLife(circle)>.405 then
set circleCount=circleCount+1
else
call GroupRemoveUnit(circleGroup,circle)
endif
endloop
call DestroyGroup(circleScan)
set circleScan=null
set circleGroup=null
return circleCount
endfunction
// with Oken (item or Oken Blessing) Edward keeps one more circle and gets a second circle spell (AE10)
function EDMaxCircles takes unit edwardHero returns integer
local integer circleLimit=1
if GetHeroLevel(edwardHero)>=16 then
set circleLimit=3
elseif GetHeroLevel(edwardHero)>=8 then
set circleLimit=2
endif
if FSHasSceptre(edwardHero) then
set circleLimit=circleLimit+1
endif
return circleLimit
endfunction
// The Alchemy book always holds Q W E T at their slots; a spell is greyed out by its requirement (a marker unit
// of the owner) until it can be used: j003 Q learned, j004 W learned, j005 Giant Cannon loaded, j006 Oken held.
// The markers of a hero are kept at EDHash keys 101-104 of the hero. EDCheckCast still checks every cast.
function EDSetMarker takes unit edwardHero,integer markerKey,integer markerType,boolean markerWanted returns nothing
local integer heroKey=GetHandleId(edwardHero)
local unit marker=LoadUnitHandle(EDHash,heroKey,markerKey)
if markerWanted and marker==null then
call SaveUnitHandle(EDHash,heroKey,markerKey,CreateUnit(GetOwningPlayer(edwardHero),markerType,1.,1.,0.))
elseif not markerWanted and marker!=null then
call RemoveUnit(marker)
call RemoveSavedHandle(EDHash,heroKey,markerKey)
endif
set marker=null
endfunction
function EDSyncHero takes unit edwardHero returns nothing
local boolean heroExists=GetUnitTypeId(edwardHero)!=0
call EDSetMarker(edwardHero,101,'j003',heroExists and GetUnitAbilityLevel(edwardHero,'AE01')>0)
call EDSetMarker(edwardHero,102,'j004',heroExists and GetUnitAbilityLevel(edwardHero,'AE02')>0)
call EDSetMarker(edwardHero,103,'j005',heroExists and LoadBoolean(EDHash,GetHandleId(edwardHero),5))
call EDSetMarker(edwardHero,104,'j006',heroExists and FSHasSceptre(edwardHero))
endfunction
// Giant Cannon: one shot, loaded by Decomposition on a hero or God's Hammer level 2+ (EDHash key 5 on the hero)
function EDLoadGiantCannon takes unit edwardHero returns nothing
call SaveBoolean(EDHash,GetHandleId(edwardHero),5,true)
call EDSetMarker(edwardHero,103,'j005',true)
endfunction
function EDOkenSyncEnum takes nothing returns nothing
local unit edwardHero=GetEnumUnit()
if GetUnitTypeId(edwardHero)==0 then
call EDSyncHero(edwardHero)
call GroupRemoveUnit(EDHeroes,edwardHero)
elseif not IsUnitIllusion(edwardHero) then
call EDSyncHero(edwardHero)
endif
set edwardHero=null
endfunction
function EDOkenSyncTick takes nothing returns nothing
call ForGroup(EDHeroes,function EDOkenSyncEnum)
endfunction
function EDTrackHero takes nothing returns boolean
if GetUnitTypeId(GetTriggerUnit())=='HE00' and not IsUnitIllusion(GetTriggerUnit()) then
call GroupAddUnit(EDHeroes,GetTriggerUnit())
call EDSyncHero(GetTriggerUnit())
endif
return false
endfunction
function EDDrawCircle takes unit edwardHero,real circleX,real circleY returns nothing
local unit circle=EDDummy(GetOwningPlayer(edwardHero),'hE01',circleX,circleY,0.,120.)
call GroupAddUnit(EDCircleGroup(edwardHero),circle)
set circle=null
endfunction
// ------------------------------------------------------------------ Q: Alchemy: Cannon
function EDCannon takes unit edwardHero,real targetX,real targetY returns nothing
local real cannonAngle=Atan2(targetY-GetUnitY(edwardHero),targetX-GetUnitX(edwardHero))
local unit cannon
call EDPlaySound(EDSoundClap)
call EDPlaySound(EDSoundCannon)
set cannon=EDDummy(GetOwningPlayer(edwardHero),'hE02',GetUnitX(edwardHero)+50.*Cos(cannonAngle),GetUnitY(edwardHero)+50.*Sin(cannonAngle),cannonAngle*bj_RADTODEG,1.)
call SetUnitAnimation(cannon,"attack")
call EDGroundTrail(GetUnitX(edwardHero),GetUnitY(edwardHero),cannonAngle,19)
call EDDamageCone(edwardHero,GetUnitX(edwardHero),GetUnitY(edwardHero),cannonAngle,960.,150.,250.,50.*EDAbilityLevel(edwardHero,'AE01')+GetHeroInt(edwardHero,true))
set cannon=null
endfunction
// ------------------------------------------------------------------ W: Alchemy: Spikes
function EDSpikesStun takes integer spikesLevel returns real
if spikesLevel<=1 then
return 1.
elseif spikesLevel<=3 then
return 1.5
endif
return 2.
endfunction
function EDSpikesHit takes unit edwardHero,real areaX,real areaY,real areaRadius,real areaDamage,real stunDuration returns nothing
local group areaTargets=CreateGroup()
local unit areaTarget
local player edwardOwner=GetOwningPlayer(edwardHero)
call GroupEnumUnitsInRange(areaTargets,areaX,areaY,areaRadius,null)
loop
set areaTarget=FirstOfGroup(areaTargets)
exitwhen areaTarget==null
call GroupRemoveUnit(areaTargets,areaTarget)
if EDIsEnemy(areaTarget,edwardOwner) then
call BvOHeroSpellDamage(edwardHero,areaTarget,areaDamage,true,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC)
call AYStun(edwardHero,areaTarget,stunDuration)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",areaTarget,"chest"))
endif
endloop
call DestroyGroup(areaTargets)
set areaTargets=null
set areaTarget=null
set edwardOwner=null
endfunction
function EDSpikes takes unit edwardHero,real targetX,real targetY returns nothing
local integer spikesLevel=EDAbilityLevel(edwardHero,'AE02')
call EDPlaySound(EDSoundClap)
call EDPlaySound(EDSoundSpikes)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",targetX,targetY))
call EDRaiseSpikes(GetOwningPlayer(edwardHero),targetX,targetY,spikesLevel)
call EDSpikesHit(edwardHero,targetX,targetY,175.+25.*spikesLevel,50.+50.*spikesLevel+.5*GetHeroInt(edwardHero,true),EDSpikesStun(spikesLevel))
endfunction
// ------------------------------------------------------------------ V: Alchemy book
function EDNoCircles takes unit edwardHero returns nothing
if GetLocalPlayer()==GetOwningPlayer(edwardHero) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00You have no transmutation circles!|r")
endif
endfunction
function EDCircleCannon takes unit edwardHero,real targetX,real targetY returns nothing
local real cannonAngle=Atan2(targetY-GetUnitY(edwardHero),targetX-GetUnitX(edwardHero))
local real cannonDamage=50.*EDAbilityLevel(edwardHero,'AE01')+GetHeroInt(edwardHero,true)
local group circleGroup=EDCircleGroup(edwardHero)
local unit circle
local unit cannon
local real circleX
local real circleY
local player edwardOwner=GetOwningPlayer(edwardHero)
if EDCountCircles(edwardHero)==0 then
call EDNoCircles(edwardHero)
else
call EDPlaySound(EDSoundClap)
call EDPlaySound(EDSoundCannon)
call GroupClear(EDCircleQueue)
call GroupAddGroup(circleGroup,EDCircleQueue)
call GroupClear(circleGroup)
loop
set circle=FirstOfGroup(EDCircleQueue)
exitwhen circle==null
call GroupRemoveUnit(EDCircleQueue,circle)
set circleX=GetUnitX(circle)
set circleY=GetUnitY(circle)
call EDDummy(edwardOwner,'hE04',circleX,circleY,cannonAngle*bj_RADTODEG,2.)
call KillUnit(circle)
set cannon=EDDummy(edwardOwner,'hE02',circleX,circleY,cannonAngle*bj_RADTODEG,1.)
call SetUnitAnimation(cannon,"attack")
call EDGroundTrail(circleX,circleY,cannonAngle,19)
call EDDamageCone(edwardHero,circleX,circleY,cannonAngle,960.,150.,250.,cannonDamage)
endloop
endif
set circleGroup=null
set circle=null
set cannon=null
set edwardOwner=null
endfunction
function EDCircleSpikes takes unit edwardHero returns nothing
local integer spikesLevel=EDAbilityLevel(edwardHero,'AE02')
local group circleGroup=EDCircleGroup(edwardHero)
local unit circle
local real circleX
local real circleY
local player edwardOwner=GetOwningPlayer(edwardHero)
if EDCountCircles(edwardHero)==0 then
call EDNoCircles(edwardHero)
else
call EDPlaySound(EDSoundClap)
call EDPlaySound(EDSoundSpikes)
call GroupClear(EDCircleQueue)
call GroupAddGroup(circleGroup,EDCircleQueue)
call GroupClear(circleGroup)
loop
set circle=FirstOfGroup(EDCircleQueue)
exitwhen circle==null
call GroupRemoveUnit(EDCircleQueue,circle)
set circleX=GetUnitX(circle)
set circleY=GetUnitY(circle)
call EDDummy(edwardOwner,'hE05',circleX,circleY,GetUnitFacing(edwardHero),2.)
call KillUnit(circle)
call EDRaiseSpikes(edwardOwner,circleX,circleY,spikesLevel)
call EDSpikesHit(edwardHero,circleX,circleY,175.+25.*spikesLevel,50.+50.*spikesLevel+.5*GetHeroInt(edwardHero,true),EDSpikesStun(spikesLevel))
endloop
endif
set circleGroup=null
set circle=null
set edwardOwner=null
endfunction
function EDGiantCannonTick takes nothing returns nothing
local timer trailTimer=GetExpiredTimer()
local integer trailKey=GetHandleId(trailTimer)
local real trailX=LoadReal(EDHash,trailKey,0)
local real trailY=LoadReal(EDHash,trailKey,1)
local real trailAngle=LoadReal(EDHash,trailKey,2)
local real trailDistance=LoadReal(EDHash,trailKey,3)+50.
local integer trailStep=0
loop
exitwhen trailStep>1 or trailDistance>1320.
call EDDummy(LoadPlayerHandle(EDHash,trailKey,4),'hE15',trailX+trailDistance*Cos(trailAngle),trailY+trailDistance*Sin(trailAngle),trailAngle*bj_RADTODEG,2.)
set trailDistance=trailDistance+50.
set trailStep=trailStep+1
endloop
if trailDistance>1320. then
call EDStopTimer(trailTimer)
else
call SaveReal(EDHash,trailKey,3,trailDistance-50.)
endif
set trailTimer=null
endfunction
function EDGiantCannon takes unit edwardHero,real targetX,real targetY returns nothing
local real cannonAngle=Atan2(targetY-GetUnitY(edwardHero),targetX-GetUnitX(edwardHero))
local timer trailTimer=CreateTimer()
local unit cannon
call SaveBoolean(EDHash,GetHandleId(edwardHero),5,false)
call EDSetMarker(edwardHero,103,'j005',false)
call EDPlaySound(EDSoundClap)
call EDPlaySound(EDSoundCannon)
call EDDummy(GetOwningPlayer(edwardHero),'hE09',GetUnitX(edwardHero),GetUnitY(edwardHero),cannonAngle*bj_RADTODEG,2.)
set cannon=EDDummy(GetOwningPlayer(edwardHero),'hE08',GetUnitX(edwardHero),GetUnitY(edwardHero),cannonAngle*bj_RADTODEG,2.)
call SetUnitAnimation(cannon,"attack")
call SaveReal(EDHash,GetHandleId(trailTimer),0,GetUnitX(edwardHero))
call SaveReal(EDHash,GetHandleId(trailTimer),1,GetUnitY(edwardHero))
call SaveReal(EDHash,GetHandleId(trailTimer),2,cannonAngle)
call SaveReal(EDHash,GetHandleId(trailTimer),3,0.)
call SavePlayerHandle(EDHash,GetHandleId(trailTimer),4,GetOwningPlayer(edwardHero))
call TimerStart(trailTimer,.02,true,function EDGiantCannonTick)
call EDDamageCone(edwardHero,GetUnitX(edwardHero),GetUnitY(edwardHero),cannonAngle,1320.,300.,300.,250.+250.*EDAbilityLevel(edwardHero,'AE03')+.75*GetHeroInt(edwardHero,true))
set trailTimer=null
set cannon=null
endfunction
// ------------------------------------------------------------------ E: Decomposition
function EDDecomposeDamage takes integer decomposeLevel returns real
if decomposeLevel<=1 then
return 750.
elseif decomposeLevel==2 then
return 1250.
elseif decomposeLevel==3 then
return 2000.
elseif decomposeLevel==4 then
return 3000.
endif
return 4250.
endfunction
function EDDecompositionTick takes nothing returns nothing
local timer decomposeTimer=GetExpiredTimer()
local integer decomposeKey=GetHandleId(decomposeTimer)
local unit edwardHero=LoadUnitHandle(EDHash,decomposeKey,0)
local unit decomposeTarget=LoadUnitHandle(EDHash,decomposeKey,1)
local integer tickCount=LoadInteger(EDHash,decomposeKey,2)+1
local player edwardOwner=GetOwningPlayer(edwardHero)
local real targetX=GetUnitX(decomposeTarget)
local real targetY=GetUnitY(decomposeTarget)
local real sparkAngle=Atan2(targetY-GetUnitY(edwardHero),targetX-GetUnitX(edwardHero))*bj_RADTODEG
local integer ringIndex=1
call SaveInteger(EDHash,decomposeKey,2,tickCount)
if tickCount<=13 then
call EDDummy(edwardOwner,'hE10',GetUnitX(edwardHero),GetUnitY(edwardHero),sparkAngle,1.)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",targetX,targetY))
call EDDummy(edwardOwner,'hE14',targetX,targetY,0.,2.)
call SetUnitAnimation(decomposeTarget,"death")
call SetUnitAnimation(edwardHero,"Spell One")
else
if not LoadBoolean(EDHash,decomposeKey,3) then
call SetUnitInvulnerable(edwardHero,false)
endif
if not LoadBoolean(EDHash,decomposeKey,4) then
call SetUnitInvulnerable(decomposeTarget,false)
endif
call PauseUnit(edwardHero,false)
call PauseUnit(decomposeTarget,false)
call SetUnitAnimation(decomposeTarget,"stand")
call SetUnitAnimation(edwardHero,"stand")
call EDDummy(edwardOwner,'hE10',GetUnitX(edwardHero),GetUnitY(edwardHero),sparkAngle,1.)
call EDDummy(edwardOwner,'hE12',targetX,targetY,0.,2.)
call EDDummy(edwardOwner,'hE13',targetX,targetY,0.,2.)
call EDDummy(edwardOwner,'hE07',targetX,targetY,0.,1.)
loop
exitwhen ringIndex>12
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIob\\AIobSpecialArt.mdl",targetX+50.*Cos(30.*ringIndex*bj_DEGTORAD),targetY+50.*Sin(30.*ringIndex*bj_DEGTORAD)))
set ringIndex=ringIndex+1
endloop
if GetWidgetLife(decomposeTarget)>.405 then
call BvOKindSpellDamage(edwardHero,decomposeTarget,EDDecomposeDamage(EDAbilityLevel(edwardHero,'AE03')),true,CLEAN)
call EDStun(edwardHero,decomposeTarget,3)
if IsUnitType(decomposeTarget,UNIT_TYPE_HERO) then
call EDLoadGiantCannon(edwardHero)
endif
endif
call EDStopTimer(decomposeTimer)
endif
set decomposeTimer=null
set edwardHero=null
set decomposeTarget=null
set edwardOwner=null
endfunction
function EDDecomposition takes unit edwardHero,unit decomposeTarget returns nothing
local timer decomposeTimer
if decomposeTarget==null or GetWidgetLife(decomposeTarget)<=.405 then
return
endif
set decomposeTimer=CreateTimer()
call EDPlaySound(EDSoundHammer)
call SaveUnitHandle(EDHash,GetHandleId(decomposeTimer),0,edwardHero)
call SaveUnitHandle(EDHash,GetHandleId(decomposeTimer),1,decomposeTarget)
call SaveInteger(EDHash,GetHandleId(decomposeTimer),2,0)
call SaveBoolean(EDHash,GetHandleId(decomposeTimer),3,GetUnitAbilityLevel(edwardHero,'Avul')>0)
call SaveBoolean(EDHash,GetHandleId(decomposeTimer),4,GetUnitAbilityLevel(decomposeTarget,'Avul')>0)
call SetUnitInvulnerable(edwardHero,true)
call SetUnitInvulnerable(decomposeTarget,true)
call PauseUnit(edwardHero,true)
call PauseUnit(decomposeTarget,true)
call TimerStart(decomposeTimer,.15,true,function EDDecompositionTick)
set decomposeTimer=null
endfunction
// ------------------------------------------------------------------ R: God's Hammer
function EDShakeEnd takes nothing returns nothing
local timer shakeTimer=GetExpiredTimer()
local integer playerIndex=0
loop
exitwhen playerIndex>11
call CameraClearNoiseForPlayer(Player(playerIndex))
set playerIndex=playerIndex+1
endloop
call EDStopTimer(shakeTimer)
set shakeTimer=null
endfunction
// God's Hammer: physical 1500/2000/3000/4000/5000 + pure 1.5/2/3/4/5 x INT, stun 2 seconds
function EDHammerHit takes unit edwardHero,real hammerX,real hammerY,integer hammerLevel returns nothing
local group areaTargets=CreateGroup()
local unit areaTarget
local player edwardOwner=GetOwningPlayer(edwardHero)
local real physicalDamage=RBValue(hammerLevel,1500.,2000.,2500.,3000.,4000.,4000.)
local real intFactor=RBValue(hammerLevel,1.5,2.,2.5,3.,3.5,3.5)
call GroupEnumUnitsInRange(areaTargets,hammerX,hammerY,500.,null)
loop
set areaTarget=FirstOfGroup(areaTargets)
exitwhen areaTarget==null
call GroupRemoveUnit(areaTargets,areaTarget)
if EDIsEnemy(areaTarget,edwardOwner) then
call AYStun(edwardHero,areaTarget,2.)
call BvOKindSpellDamage(edwardHero,areaTarget,physicalDamage,true,PHYSICAL)
if GetWidgetLife(areaTarget)>.405 then
call BvOKindSpellDamage(edwardHero,areaTarget,intFactor*GetHeroInt(edwardHero,true),true,CLEAN)
endif
endif
endloop
call DestroyGroup(areaTargets)
set areaTargets=null
set areaTarget=null
set edwardOwner=null
endfunction
function EDHammerFall takes nothing returns nothing
local timer hammerTimer=GetExpiredTimer()
local integer hammerKey=GetHandleId(hammerTimer)
local unit edwardHero=LoadUnitHandle(EDHash,hammerKey,0)
local real hammerX=LoadReal(EDHash,hammerKey,1)
local real hammerY=LoadReal(EDHash,hammerKey,2)
local integer hammerLevel=LoadInteger(EDHash,hammerKey,3)
local integer ringIndex=1
local integer ringRadius
local integer playerIndex=0
call EDStopTimer(hammerTimer)
call EDPlaySound(EDSoundClap)
loop
exitwhen ringIndex>12
set ringRadius=100
loop
exitwhen ringRadius>400
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl",hammerX+ringRadius*Cos(30.*ringIndex*bj_DEGTORAD),hammerY+ringRadius*Sin(30.*ringIndex*bj_DEGTORAD)))
set ringRadius=ringRadius+100
endloop
set ringIndex=ringIndex+1
endloop
call EDDummy(GetOwningPlayer(edwardHero),'hE07',hammerX,hammerY,0.,1.)
call EDHammerHit(edwardHero,hammerX,hammerY,hammerLevel)
loop
exitwhen playerIndex>11
call CameraSetEQNoiseForPlayer(Player(playerIndex),2.)
set playerIndex=playerIndex+1
endloop
call TimerStart(CreateTimer(),1.,false,function EDShakeEnd)
set hammerTimer=null
set edwardHero=null
endfunction
function EDHammer takes unit edwardHero,real targetX,real targetY returns nothing
local timer hammerTimer=CreateTimer()
local integer hammerLevel=EDAbilityLevel(edwardHero,'AE04')
call EDPlaySound(EDSoundHammer)
call EDDummy(GetOwningPlayer(edwardHero),'hE06',targetX,targetY,Atan2(targetY-GetUnitY(edwardHero),targetX-GetUnitX(edwardHero))*bj_RADTODEG,4.)
if hammerLevel>=2 then
call EDLoadGiantCannon(edwardHero)
endif
call SaveUnitHandle(EDHash,GetHandleId(hammerTimer),0,edwardHero)
call SaveReal(EDHash,GetHandleId(hammerTimer),1,targetX)
call SaveReal(EDHash,GetHandleId(hammerTimer),2,targetY)
call SaveInteger(EDHash,GetHandleId(hammerTimer),3,hammerLevel)
call TimerStart(hammerTimer,1.,false,function EDHammerFall)
set hammerTimer=null
endfunction
// ------------------------------------------------------------------ events
function EDCheckCast takes nothing returns boolean
local unit edwardHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
local unit spellTarget
if GetUnitTypeId(edwardHero)=='HE00' then
if (spellId=='AE07' and GetUnitAbilityLevel(edwardHero,'AE01')==0) or (spellId=='AE08' and GetUnitAbilityLevel(edwardHero,'AE02')==0) then
call IssueImmediateOrder(edwardHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(edwardHero) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00Learn the alchemy spell first!|r")
endif
elseif spellId=='AE10' and not FSHasSceptre(edwardHero) then
call IssueImmediateOrder(edwardHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(edwardHero) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00This circle needs the Oken!|r")
endif
elseif spellId=='AE09' and not LoadBoolean(EDHash,GetHandleId(edwardHero),5) then
call IssueImmediateOrder(edwardHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(edwardHero) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00The Giant Cannon is not ready: use Decomposition on a hero or God's Hammer level 2+!|r")
endif
elseif (spellId=='AE05' or spellId=='AE10') and EDCountCircles(edwardHero)>=EDMaxCircles(edwardHero) then
call IssueImmediateOrder(edwardHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(edwardHero) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00You cannot draw more transmutation circles now!|r")
endif
elseif spellId=='AE03' then
set spellTarget=GetSpellTargetUnit()
if spellTarget==null or IsUnitPaused(spellTarget) or GetUnitAbilityLevel(spellTarget,'Avul')>0 or IsUnitType(spellTarget,UNIT_TYPE_STRUCTURE) then
call IssueImmediateOrder(edwardHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(edwardHero) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00You cannot decompose this target now!|r")
endif
endif
endif
endif
set edwardHero=null
set spellTarget=null
return false
endfunction
function EDOnChannel takes nothing returns boolean
local unit edwardHero=GetTriggerUnit()
if GetUnitTypeId(edwardHero)=='HE00' and (GetSpellAbilityId()=='AE05' or GetSpellAbilityId()=='AE10') then
call EDPlaySound(EDSoundCircle)
call EDDummy(GetOwningPlayer(edwardHero),'hE11',GetUnitX(edwardHero),GetUnitY(edwardHero),GetUnitFacing(edwardHero),.75)
endif
set edwardHero=null
return false
endfunction
function EDOnSpell takes nothing returns boolean
local unit edwardHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
if GetUnitTypeId(edwardHero)=='HE00' and SilenceConditions(edwardHero) then
if spellId=='AE01' then
call EDCannon(edwardHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AE02' then
call EDSpikes(edwardHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AE03' then
call EDDecomposition(edwardHero,GetSpellTargetUnit())
elseif spellId=='AE04' then
call EDHammer(edwardHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AE05' or spellId=='AE10' then
call EDDrawCircle(edwardHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AE07' then
call EDCircleCannon(edwardHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AE08' then
call EDCircleSpikes(edwardHero)
elseif spellId=='AE09' then
call EDGiantCannon(edwardHero,GetSpellTargetX(),GetSpellTargetY())
endif
endif
set edwardHero=null
return false
endfunction
function EDPreloadDummies takes nothing returns nothing
local integer dummyIndex=1
local integer array dummyTypes
set dummyTypes[1]='hE01'
set dummyTypes[2]='hE02'
set dummyTypes[3]='hE03'
set dummyTypes[4]='hE04'
set dummyTypes[5]='hE05'
set dummyTypes[6]='hE06'
set dummyTypes[7]='hE07'
set dummyTypes[8]='hE08'
set dummyTypes[9]='hE09'
set dummyTypes[10]='hE10'
set dummyTypes[11]='hE11'
set dummyTypes[12]='hE12'
set dummyTypes[13]='hE13'
set dummyTypes[14]='hE14'
set dummyTypes[15]='hE15'
loop
exitwhen dummyIndex>15
call RemoveUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),dummyTypes[dummyIndex],-7600.,-6800.,0.))
set dummyIndex=dummyIndex+1
endloop
endfunction
function EDInit takes nothing returns nothing
local trigger castCheckTrigger=CreateTrigger()
local trigger trackTrigger=CreateTrigger()
local trigger channelTrigger=CreateTrigger()
local trigger spellTrigger=CreateTrigger()
local integer playerIndex=0
set EDHash=InitHashtable()
set EDHeroes=CreateGroup()
set EDCircleQueue=CreateGroup()
call TriggerRegisterEnterRectSimple(trackTrigger,bj_mapInitialPlayableArea)
call TriggerRegisterAnyUnitEventBJ(trackTrigger,EVENT_PLAYER_HERO_SKILL)
call TriggerRegisterAnyUnitEventBJ(trackTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(trackTrigger,Condition(function EDTrackHero))
call TimerStart(CreateTimer(),.25,true,function EDOkenSyncTick)
set EDSoundClap=EDCreateSound("war3mapImported\\YunsungClap.mp3",287)
set EDSoundCannon=EDCreateSound("war3mapImported\\v2.mp3",758)
set EDSoundCircle=EDCreateSound("war3mapImported\\YunsungC.mp3",1594)
set EDSoundSpikes=EDCreateSound("war3mapImported\\YunsungW.mp3",1123)
set EDSoundHammer=EDCreateSound("war3mapImported\\YunsungR2.mp3",1776)
call EDPreloadDummies()
call TriggerRegisterAnyUnitEventBJ(castCheckTrigger,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(castCheckTrigger,Condition(function EDCheckCast))
call TriggerRegisterAnyUnitEventBJ(channelTrigger,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(channelTrigger,Condition(function EDOnChannel))
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(spellTrigger,Condition(function EDOnSpell))
set castCheckTrigger=null
set channelTrigger=null
set spellTrigger=null
endfunction
// Shukuro Tsukishima (HT00), model and effects from Bleach: War of Souls (unit TK00). Every cast runs on its own
// timer with its data in TSHash, so several Tsukishimas and several casts can run at the same time.
// TSHash keys on a unit: 10 last reflect time (attacker), 20/21/22/23 Enemy Reading charges/end/effect/cast,
// 30/31 Self Revenge weakness end/effect, 40/41/42/43 provoker/provocation end/mark/order dirty,
// 50/51 cached Oken/Tree of the End level, 60 aura owner, 70 tree running.
function TSNow takes nothing returns real
return TimerGetElapsed(TSClock)
endfunction
function TSIsEnemy takes unit candidate,player ownerPlayer returns boolean
return candidate!=null and GetWidgetLife(candidate)>.405 and IsUnitEnemy(candidate,ownerPlayer) and GetUnitAbilityLevel(candidate,'Aloc')==0 and not IsUnitType(candidate,UNIT_TYPE_STRUCTURE)
endfunction
function TSCanStand takes real pointX,real pointY returns boolean
return pointX>GetRectMinX(bj_mapInitialPlayableArea)+32. and pointX<GetRectMaxX(bj_mapInitialPlayableArea)-32. and pointY>GetRectMinY(bj_mapInitialPlayableArea)+32. and pointY<GetRectMaxY(bj_mapInitialPlayableArea)-32. and not IsTerrainPathable(pointX,pointY,PATHING_TYPE_WALKABILITY)
endfunction
function TSRemoveDummy takes nothing returns nothing
local timer removeTimer=GetExpiredTimer()
call RemoveUnit(LoadUnitHandle(TSHash,GetHandleId(removeTimer),0))
call FlushChildHashtable(TSHash,GetHandleId(removeTimer))
call DestroyTimer(removeTimer)
set removeTimer=null
endfunction
// effect dummies are removed, not killed: most effect models play their effect as the first sequence and a
// killed dummy would play it once more as its death animation
function TSRemoveLater takes unit effectDummy,real removeDelay returns nothing
local timer removeTimer=CreateTimer()
call SaveUnitHandle(TSHash,GetHandleId(removeTimer),0,effectDummy)
call TimerStart(removeTimer,removeDelay,false,function TSRemoveDummy)
set removeTimer=null
endfunction
function TSDummy takes player dummyOwner,integer dummyType,real dummyX,real dummyY,real dummyFacing,real dummyLife returns unit
set TSLastDummy=CreateUnit(dummyOwner,dummyType,dummyX,dummyY,dummyFacing)
call SetUnitX(TSLastDummy,dummyX)
call SetUnitY(TSLastDummy,dummyY)
if dummyLife>0. then
call TSRemoveLater(TSLastDummy,dummyLife)
endif
return TSLastDummy
endfunction
function TSScaledDummy takes player dummyOwner,integer dummyType,real dummyX,real dummyY,real dummyFacing,real dummyLife,real dummyScale,real dummyTimeScale returns unit
call TSDummy(dummyOwner,dummyType,dummyX,dummyY,dummyFacing,dummyLife)
call SetUnitScale(TSLastDummy,dummyScale,dummyScale,dummyScale)
call SetUnitTimeScale(TSLastDummy,dummyTimeScale)
return TSLastDummy
endfunction
function TSCreateSound takes string soundPath,integer soundDuration returns sound
local sound spellSound=CreateSound(soundPath,false,true,true,10,10,"DefaultEAXON")
call SetSoundDuration(spellSound,soundDuration)
call SetSoundChannel(spellSound,0)
call SetSoundVolume(spellSound,127)
call SetSoundPitch(spellSound,1.)
call SetSoundDistances(spellSound,2000.,10000.)
call SetSoundDistanceCutoff(spellSound,3000.)
call Preload(soundPath)
set TSLastSound=spellSound
set spellSound=null
return TSLastSound
endfunction
function TSPlaySound takes sound spellSound,real soundX,real soundY returns nothing
call StopSound(spellSound,false,false)
call SetSoundPosition(spellSound,soundX,soundY,0.)
call StartSound(spellSound)
endfunction
function TSStopTimer takes timer spellTimer returns nothing
call FlushChildHashtable(TSHash,GetHandleId(spellTimer))
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endfunction
function TSCastOnTarget takes unit tsukishimaHero,unit spellTarget,integer abilityId,integer abilityLevel,string abilityOrder returns nothing
local unit dummyCaster
if spellTarget==null or GetWidgetLife(spellTarget)<=.405 then
return
endif
set dummyCaster=CreateUnit(GetOwningPlayer(tsukishimaHero),'hL02',GetUnitX(spellTarget)-16.,GetUnitY(spellTarget),0.)
call UnitAddAbility(dummyCaster,abilityId)
call SetUnitAbilityLevel(dummyCaster,abilityId,abilityLevel)
call UnitApplyTimedLife(dummyCaster,'BTLF',1.)
call IssueTargetOrder(dummyCaster,abilityOrder,spellTarget)
set dummyCaster=null
endfunction
function TSDamage takes unit tsukishimaHero,unit hitTarget,real hitDamage returns nothing
call BvOHeroSpellDamage(tsukishimaHero,hitTarget,hitDamage,true,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC)
endfunction
// Q Bringed Blade and R Self Revenge (the sword) deal physical damage
function TSPhysicalDamage takes unit tsukishimaHero,unit hitTarget,real hitDamage returns nothing
call BvOKindSpellDamage(tsukishimaHero,hitTarget,hitDamage,true,PHYSICAL)
endfunction
function TSFacing takes real fromX,real fromY,real toX,real toY returns real
if fromX==toX and fromY==toY then
return 0.
endif
return Atan2(toY-fromY,toX-fromX)
endfunction
// ------------------------------------------------------------------ Q: Bringed Blade
function TSDashFinish takes timer dashTimer,unit tsukishimaHero,real dashAngle returns nothing
local real heroX=GetUnitX(tsukishimaHero)
local real heroY=GetUnitY(tsukishimaHero)
call TSScaledDummy(GetOwningPlayer(tsukishimaHero),'hT02',heroX+100.*Cos(dashAngle),heroY+100.*Sin(dashAngle),dashAngle*bj_RADTODEG,1.4,2.1,.5)
call SetUnitVertexColor(tsukishimaHero,255,255,255,255)
call SetUnitTimeScale(tsukishimaHero,1.)
call DestroyGroup(LoadGroupHandle(TSHash,GetHandleId(dashTimer),4))
call TSStopTimer(dashTimer)
endfunction
function TSDashTick takes nothing returns nothing
local timer dashTimer=GetExpiredTimer()
local integer timerId=GetHandleId(dashTimer)
local unit tsukishimaHero=LoadUnitHandle(TSHash,timerId,0)
local real dashAngle=LoadReal(TSHash,timerId,1)
local real dashLeft=LoadReal(TSHash,timerId,2)
local group hitGroup=LoadGroupHandle(TSHash,timerId,4)
local player heroOwner=GetOwningPlayer(tsukishimaHero)
local real dashStep=48.
local real nextX
local real nextY
local unit dashTarget
if GetWidgetLife(tsukishimaHero)<=.405 or dashLeft<=0. then
call TSDashFinish(dashTimer,tsukishimaHero,dashAngle)
else
if dashStep>dashLeft then
set dashStep=dashLeft
endif
set nextX=GetUnitX(tsukishimaHero)+dashStep*Cos(dashAngle)
set nextY=GetUnitY(tsukishimaHero)+dashStep*Sin(dashAngle)
if TSCanStand(nextX,nextY) then
call SetUnitX(tsukishimaHero,nextX)
call SetUnitY(tsukishimaHero,nextY)
set dashLeft=dashLeft-dashStep
else
set dashLeft=0.
endif
call SetUnitFacing(tsukishimaHero,dashAngle*bj_RADTODEG)
call TSScaledDummy(heroOwner,'hT18',GetUnitX(tsukishimaHero),GetUnitY(tsukishimaHero),dashAngle*bj_RADTODEG+90.,.3,2.,1.25)
call SetUnitVertexColor(TSLastDummy,0,80,0,70)
call GroupEnumUnitsInRange(TSEnumGroup,GetUnitX(tsukishimaHero),GetUnitY(tsukishimaHero),175.,null)
loop
set dashTarget=FirstOfGroup(TSEnumGroup)
exitwhen dashTarget==null
call GroupRemoveUnit(TSEnumGroup,dashTarget)
if TSIsEnemy(dashTarget,heroOwner) and not IsUnitInGroup(dashTarget,hitGroup) then
call GroupAddUnit(hitGroup,dashTarget)
call TSScaledDummy(heroOwner,'hT03',GetUnitX(dashTarget),GetUnitY(dashTarget),dashAngle*bj_RADTODEG,1.,1.5,.4)
call SetUnitFlyHeight(TSLastDummy,70.,0.)
call TSPhysicalDamage(tsukishimaHero,dashTarget,LoadReal(TSHash,timerId,3))
call TSDamage(tsukishimaHero,dashTarget,LoadReal(TSHash,timerId,6))
endif
endloop
call SaveReal(TSHash,timerId,2,dashLeft)
if dashLeft<=0. then
call TSDashFinish(dashTimer,tsukishimaHero,dashAngle)
endif
endif
set dashTimer=null
set tsukishimaHero=null
set hitGroup=null
set heroOwner=null
set dashTarget=null
endfunction
function TSBringedBlade takes unit tsukishimaHero,real targetX,real targetY returns nothing
local timer dashTimer=CreateTimer()
local integer timerId=GetHandleId(dashTimer)
local real heroX=GetUnitX(tsukishimaHero)
local real heroY=GetUnitY(tsukishimaHero)
local real dashAngle=TSFacing(heroX,heroY,targetX,targetY)
local integer abilityLevel=GetUnitAbilityLevel(tsukishimaHero,'TS01')
call TSPlaySound(TSSoundDash,heroX,heroY)
call TSScaledDummy(GetOwningPlayer(tsukishimaHero),'hT01',heroX,heroY,GetRandomReal(0.,359.),1.4,1.5,1.6)
call SetUnitVertexColor(TSLastDummy,255,255,255,75)
call TSScaledDummy(GetOwningPlayer(tsukishimaHero),'hT01',heroX,heroY,GetRandomReal(0.,359.),1.4,1.5,1.6)
call SetUnitVertexColor(TSLastDummy,255,255,255,75)
call SetUnitFacing(tsukishimaHero,dashAngle*bj_RADTODEG)
// Spell Six: the lunge
call SetUnitAnimationByIndex(tsukishimaHero,9)
call SetUnitTimeScale(tsukishimaHero,2.)
call SetUnitVertexColor(tsukishimaHero,0,0,0,50)
call SaveUnitHandle(TSHash,timerId,0,tsukishimaHero)
call SaveReal(TSHash,timerId,1,dashAngle)
call SaveReal(TSHash,timerId,2,600.)
call SaveReal(TSHash,timerId,3,200.*abilityLevel)
call SaveReal(TSHash,timerId,6,(.8+.2*abilityLevel)*GetHeroInt(tsukishimaHero,true))
call SaveGroupHandle(TSHash,timerId,4,CreateGroup())
call TimerStart(dashTimer,.02,true,function TSDashTick)
set dashTimer=null
endfunction
// ------------------------------------------------------------------ W: Insert Presence
function TSPresenceAnimation takes nothing returns nothing
local timer animationTimer=GetExpiredTimer()
local unit tsukishimaHero=LoadUnitHandle(TSHash,GetHandleId(animationTimer),0)
// Spell Eight: a leap that drives the sword into the ground right when the presence bursts (0.5 s)
if GetUnitCurrentOrder(tsukishimaHero)==OrderId("thunderclap") then
call SetUnitAnimationByIndex(tsukishimaHero,7)
call SetUnitTimeScale(tsukishimaHero,1.1)
endif
call TSStopTimer(animationTimer)
set animationTimer=null
set tsukishimaHero=null
endfunction
function TSPushTick takes nothing returns nothing
local timer pushTimer=GetExpiredTimer()
local integer timerId=GetHandleId(pushTimer)
local group pushedUnits=LoadGroupHandle(TSHash,timerId,0)
local integer pushTicks=LoadInteger(TSHash,timerId,1)+1
local real pushStep=36.*(1.-pushTicks/17.)
local group pushQueue=TSEnumGroup
local unit pushedUnit
local real pushAngle
local real nextX
local real nextY
call GroupClear(TSEnumGroup)
call GroupAddGroup(pushedUnits,TSEnumGroup)
loop
set pushedUnit=FirstOfGroup(pushQueue)
exitwhen pushedUnit==null
call GroupRemoveUnit(pushQueue,pushedUnit)
if GetWidgetLife(pushedUnit)>.405 and pushStep>0. then
set pushAngle=LoadReal(TSHash,timerId,GetHandleId(pushedUnit))
set nextX=GetUnitX(pushedUnit)+pushStep*Cos(pushAngle)
set nextY=GetUnitY(pushedUnit)+pushStep*Sin(pushAngle)
if TSCanStand(nextX,nextY) then
call SetUnitX(pushedUnit,nextX)
call SetUnitY(pushedUnit,nextY)
endif
endif
endloop
if pushTicks>=16 then
call DestroyGroup(pushedUnits)
call TSStopTimer(pushTimer)
else
call SaveInteger(TSHash,timerId,1,pushTicks)
endif
set pushTimer=null
set pushedUnits=null
set pushQueue=null
set pushedUnit=null
endfunction
function TSInsertPresence takes unit tsukishimaHero returns nothing
local timer pushTimer=CreateTimer()
local integer timerId=GetHandleId(pushTimer)
local group pushedUnits=CreateGroup()
local player heroOwner=GetOwningPlayer(tsukishimaHero)
local real heroX=GetUnitX(tsukishimaHero)
local real heroY=GetUnitY(tsukishimaHero)
local integer abilityLevel=GetUnitAbilityLevel(tsukishimaHero,'TS02')
local real presenceDamage=150.*abilityLevel+2.*GetHeroInt(tsukishimaHero,true)
local integer ringIndex=0
local unit pushedUnit
call SetUnitTimeScale(tsukishimaHero,1.)
call TSScaledDummy(heroOwner,'hT04',heroX,heroY,GetRandomReal(0.,359.),1.4,2.2,1.)
call TSScaledDummy(heroOwner,'hT05',heroX,heroY,GetRandomReal(0.,359.),1.5,1.55,1.25)
call TSScaledDummy(heroOwner,'hT05',heroX,heroY,GetRandomReal(0.,359.),1.5,1.55,1.25)
loop
exitwhen ringIndex==6
call TSScaledDummy(heroOwner,'hT06',heroX+370.*Cos(ringIndex*60.*bj_DEGTORAD),heroY+370.*Sin(ringIndex*60.*bj_DEGTORAD),ringIndex*60.,1.5,2.9,2.)
set ringIndex=ringIndex+1
endloop
call GroupEnumUnitsInRange(TSEnumGroup,heroX,heroY,650.,null)
loop
set pushedUnit=FirstOfGroup(TSEnumGroup)
exitwhen pushedUnit==null
call GroupRemoveUnit(TSEnumGroup,pushedUnit)
if TSIsEnemy(pushedUnit,heroOwner) then
call GroupAddUnit(pushedUnits,pushedUnit)
call SaveReal(TSHash,timerId,GetHandleId(pushedUnit),TSFacing(heroX,heroY,GetUnitX(pushedUnit),GetUnitY(pushedUnit)))
endif
endloop
call SaveGroupHandle(TSHash,timerId,0,pushedUnits)
call SaveInteger(TSHash,timerId,1,0)
// damage and slow after the push data is saved: the damage hooks may enumerate units themselves
call GroupAddGroup(pushedUnits,TSPresenceGroup)
loop
set pushedUnit=FirstOfGroup(TSPresenceGroup)
exitwhen pushedUnit==null
call GroupRemoveUnit(TSPresenceGroup,pushedUnit)
call TSDamage(tsukishimaHero,pushedUnit,presenceDamage)
call TSCastOnTarget(tsukishimaHero,pushedUnit,'TS10',abilityLevel,"slow")
endloop
call TimerStart(pushTimer,.03,true,function TSPushTick)
set pushTimer=null
set pushedUnits=null
set heroOwner=null
set pushedUnit=null
endfunction
// ------------------------------------------------------------------ E: Enemy Provocation
function TSProvokeEnd takes unit provokedUnit returns nothing
local integer unitId=GetHandleId(provokedUnit)
local unit provocationMark=LoadUnitHandle(TSHash,unitId,42)
if provocationMark!=null then
call KillUnit(provocationMark)
endif
call RemoveSavedHandle(TSHash,unitId,40)
call RemoveSavedReal(TSHash,unitId,41)
call RemoveSavedHandle(TSHash,unitId,42)
call RemoveSavedBoolean(TSHash,unitId,43)
call GroupRemoveUnit(TSProvoked,provokedUnit)
set provocationMark=null
endfunction
function TSProvokeEnum takes nothing returns nothing
local unit provokedUnit=GetEnumUnit()
local integer unitId=GetHandleId(provokedUnit)
local unit provoker=LoadUnitHandle(TSHash,unitId,40)
local unit provocationMark=LoadUnitHandle(TSHash,unitId,42)
if GetUnitTypeId(provokedUnit)==0 or GetWidgetLife(provokedUnit)<=.405 or GetWidgetLife(provoker)<=.405 or TSNow()>=LoadReal(TSHash,unitId,41) then
call TSProvokeEnd(provokedUnit)
else
if provocationMark!=null then
call SetUnitX(provocationMark,GetUnitX(provokedUnit))
call SetUnitY(provocationMark,GetUnitY(provokedUnit))
endif
if GetUnitCurrentOrder(provokedUnit)!=851983 or LoadBoolean(TSHash,unitId,43) then
call SaveBoolean(TSHash,unitId,43,false)
set TSIssuingTaunt=true
call IssueTargetOrderById(provokedUnit,851983,provoker)
set TSIssuingTaunt=false
endif
endif
set provokedUnit=null
set provoker=null
set provocationMark=null
endfunction
function TSAuraEnum takes nothing returns nothing
local unit auraDummy=GetEnumUnit()
local unit auraOwner=LoadUnitHandle(TSHash,GetHandleId(auraDummy),60)
if GetUnitTypeId(auraDummy)==0 or GetWidgetLife(auraDummy)<=.405 then
call RemoveSavedHandle(TSHash,GetHandleId(auraDummy),60)
call GroupRemoveUnit(TSAuras,auraDummy)
elseif auraOwner!=null then
call SetUnitX(auraDummy,GetUnitX(auraOwner))
call SetUnitY(auraDummy,GetUnitY(auraOwner))
endif
set auraDummy=null
set auraOwner=null
endfunction
function TSProvokeTick takes nothing returns nothing
call ForGroup(TSProvoked,function TSProvokeEnum)
call ForGroup(TSAuras,function TSAuraEnum)
endfunction
// a provoked unit that gets any other order is sent back to Tsukishima on the next tick
function TSOnOrder takes nothing returns boolean
local unit orderedUnit=GetTriggerUnit()
if not TSIssuingTaunt and IsUnitInGroup(orderedUnit,TSProvoked) then
if GetIssuedOrderId()!=851983 or GetOrderTargetUnit()!=LoadUnitHandle(TSHash,GetHandleId(orderedUnit),40) then
call SaveBoolean(TSHash,GetHandleId(orderedUnit),43,true)
endif
endif
set orderedUnit=null
return false
endfunction
function TSEnemyProvocation takes unit tsukishimaHero returns nothing
local player heroOwner=GetOwningPlayer(tsukishimaHero)
local real heroX=GetUnitX(tsukishimaHero)
local real heroY=GetUnitY(tsukishimaHero)
local real provocationTime=.5+.5*GetUnitAbilityLevel(tsukishimaHero,'TS03')
local unit provokedUnit
local unit auraDummy
call TSPlaySound(TSSoundProvocation,heroX,heroY)
call SetUnitAnimationByIndex(tsukishimaHero,3)
set auraDummy=TSScaledDummy(heroOwner,'hT07',heroX,heroY,0.,provocationTime,.8,1.)
call SaveUnitHandle(TSHash,GetHandleId(auraDummy),60,tsukishimaHero)
call GroupAddUnit(TSAuras,auraDummy)
call TSScaledDummy(heroOwner,'hT04',heroX,heroY,GetRandomReal(0.,359.),1.4,1.5,1.)
call GroupEnumUnitsInRange(TSEnumGroup,heroX,heroY,400.,null)
loop
set provokedUnit=FirstOfGroup(TSEnumGroup)
exitwhen provokedUnit==null
call GroupRemoveUnit(TSEnumGroup,provokedUnit)
if TSIsEnemy(provokedUnit,heroOwner) then
if IsUnitInGroup(provokedUnit,TSProvoked) then
call TSProvokeEnd(provokedUnit)
endif
call SaveUnitHandle(TSHash,GetHandleId(provokedUnit),40,tsukishimaHero)
call SaveReal(TSHash,GetHandleId(provokedUnit),41,TSNow()+provocationTime)
call TSScaledDummy(heroOwner,'hT08',GetUnitX(provokedUnit),GetUnitY(provokedUnit),0.,provocationTime+1.,2.,1.)
call SaveUnitHandle(TSHash,GetHandleId(provokedUnit),42,TSLastDummy)
call SaveBoolean(TSHash,GetHandleId(provokedUnit),43,true)
call GroupAddUnit(TSProvoked,provokedUnit)
endif
endloop
call TSProvokeTick()
set heroOwner=null
set provokedUnit=null
set auraDummy=null
endfunction
function TSReflectDamage takes nothing returns nothing
local timer reflectTimer=GetExpiredTimer()
local integer timerId=GetHandleId(reflectTimer)
local unit tsukishimaHero=LoadUnitHandle(TSHash,timerId,0)
local unit attacker=LoadUnitHandle(TSHash,timerId,1)
if GetWidgetLife(attacker)>.405 then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl",attacker,"chest"))
call TSDamage(tsukishimaHero,attacker,LoadReal(TSHash,timerId,2))
endif
call TSStopTimer(reflectTimer)
set reflectTimer=null
set tsukishimaHero=null
set attacker=null
endfunction
// ------------------------------------------------------------------ R: Self Revenge
function TSWeakenEnd takes nothing returns nothing
local timer weakenTimer=GetExpiredTimer()
local unit weakenedUnit=LoadUnitHandle(TSHash,GetHandleId(weakenTimer),0)
local integer unitId=GetHandleId(weakenedUnit)
if TSNow()>=LoadReal(TSHash,unitId,30)-.01 then
call DestroyEffect(LoadEffectHandle(TSHash,unitId,31))
call RemoveSavedHandle(TSHash,unitId,31)
call RemoveSavedReal(TSHash,unitId,30)
endif
call TSStopTimer(weakenTimer)
set weakenTimer=null
set weakenedUnit=null
endfunction
function TSWeaken takes unit weakenedUnit returns nothing
local integer unitId=GetHandleId(weakenedUnit)
local timer weakenTimer=CreateTimer()
call SaveReal(TSHash,unitId,30,TSNow()+3.)
if not HaveSavedHandle(TSHash,unitId,31) then
call SaveEffectHandle(TSHash,unitId,31,AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Cripple\\CrippleTarget.mdl",weakenedUnit,"chest"))
endif
call SaveUnitHandle(TSHash,GetHandleId(weakenTimer),0,weakenedUnit)
call TimerStart(weakenTimer,3.,false,function TSWeakenEnd)
set weakenTimer=null
endfunction
function TSSwordExplode takes timer swordTimer,real explosionX,real explosionY returns nothing
local integer timerId=GetHandleId(swordTimer)
local unit tsukishimaHero=LoadUnitHandle(TSHash,timerId,0)
local player heroOwner=LoadPlayerHandle(TSHash,timerId,9)
local group hitGroup=LoadGroupHandle(TSHash,timerId,4)
local real swordDamage=LoadReal(TSHash,timerId,3)
local unit hitTarget
call TSScaledDummy(heroOwner,'hT10',explosionX,explosionY,GetRandomReal(0.,359.),1.5,1.,1.)
call TSScaledDummy(heroOwner,'hT04',explosionX,explosionY,GetRandomReal(0.,359.),1.4,1.15,1.)
call TSPlaySound(TSSoundSwordHit,explosionX,explosionY)
call GroupEnumUnitsInRange(TSEnumGroup,explosionX,explosionY,300.,null)
loop
set hitTarget=FirstOfGroup(TSEnumGroup)
exitwhen hitTarget==null
call GroupRemoveUnit(TSEnumGroup,hitTarget)
if TSIsEnemy(hitTarget,heroOwner) and not IsUnitInGroup(hitTarget,hitGroup) then
call GroupAddUnit(hitGroup,hitTarget)
call GroupAddUnit(TSSwordHitQueue,hitTarget)
endif
endloop
loop
set hitTarget=FirstOfGroup(TSSwordHitQueue)
exitwhen hitTarget==null
call GroupRemoveUnit(TSSwordHitQueue,hitTarget)
call TSWeaken(hitTarget)
call TSPhysicalDamage(tsukishimaHero,hitTarget,swordDamage)
endloop
set tsukishimaHero=null
set heroOwner=null
set hitGroup=null
endfunction
// the nearest visible enemy hero that the sword has not hit yet
function TSFindJumpTarget takes timer swordTimer,real fromX,real fromY returns unit
local integer timerId=GetHandleId(swordTimer)
local player heroOwner=LoadPlayerHandle(TSHash,timerId,9)
local group hitGroup=LoadGroupHandle(TSHash,timerId,4)
local unit candidate
local real candidateDistance
local real bestDistance=900.*900.
set TSLastTarget=null
call GroupEnumUnitsInRange(TSEnumGroup,fromX,fromY,900.,null)
loop
set candidate=FirstOfGroup(TSEnumGroup)
exitwhen candidate==null
call GroupRemoveUnit(TSEnumGroup,candidate)
if TSIsEnemy(candidate,heroOwner) and IsUnitType(candidate,UNIT_TYPE_HERO) and not IsUnitInGroup(candidate,hitGroup) and IsUnitVisible(candidate,heroOwner) then
set candidateDistance=(GetUnitX(candidate)-fromX)*(GetUnitX(candidate)-fromX)+(GetUnitY(candidate)-fromY)*(GetUnitY(candidate)-fromY)
if candidateDistance<bestDistance then
set bestDistance=candidateDistance
set TSLastTarget=candidate
endif
endif
endloop
set heroOwner=null
set hitGroup=null
return TSLastTarget
endfunction
function TSSwordFinish takes timer swordTimer returns nothing
local unit swordDummy=LoadUnitHandle(TSHash,GetHandleId(swordTimer),1)
call RemoveUnit(swordDummy)
call DestroyGroup(LoadGroupHandle(TSHash,GetHandleId(swordTimer),4))
call TSStopTimer(swordTimer)
set swordDummy=null
endfunction
// after an explosion: jump to the next enemy hero or end the throw
function TSSwordNext takes timer swordTimer,real swordX,real swordY returns nothing
local integer timerId=GetHandleId(swordTimer)
local integer jumpsLeft=LoadInteger(TSHash,timerId,5)
local unit jumpTarget=null
if jumpsLeft>0 then
set jumpTarget=TSFindJumpTarget(swordTimer,swordX,swordY)
endif
if jumpTarget==null then
call TSSwordFinish(swordTimer)
else
call SaveInteger(TSHash,timerId,5,jumpsLeft-1)
call SaveUnitHandle(TSHash,timerId,6,jumpTarget)
call SaveReal(TSHash,timerId,7,1.5)
endif
set jumpTarget=null
endfunction
function TSSwordTick takes nothing returns nothing
local timer swordTimer=GetExpiredTimer()
local integer timerId=GetHandleId(swordTimer)
local unit swordDummy=LoadUnitHandle(TSHash,timerId,1)
local player heroOwner=LoadPlayerHandle(TSHash,timerId,9)
local group hitGroup=LoadGroupHandle(TSHash,timerId,4)
local unit jumpTarget=LoadUnitHandle(TSHash,timerId,6)
local real swordX=GetUnitX(swordDummy)
local real swordY=GetUnitY(swordDummy)
local real swordAngle=LoadReal(TSHash,timerId,2)
local real flightLeft=LoadReal(TSHash,timerId,7)
local real swordStep=40.
local integer swordTicks=LoadInteger(TSHash,timerId,8)+1
local boolean exploded=false
local unit candidate
call SaveInteger(TSHash,timerId,8,swordTicks)
if jumpTarget!=null then
// homing jump: flightLeft is the time left in seconds
if GetWidgetLife(jumpTarget)<=.405 or flightLeft<=0. then
call RemoveSavedHandle(TSHash,timerId,6)
call TSSwordNext(swordTimer,swordX,swordY)
else
set swordAngle=TSFacing(swordX,swordY,GetUnitX(jumpTarget),GetUnitY(jumpTarget))
if (GetUnitX(jumpTarget)-swordX)*(GetUnitX(jumpTarget)-swordX)+(GetUnitY(jumpTarget)-swordY)*(GetUnitY(jumpTarget)-swordY)<=swordStep*swordStep then
set swordX=GetUnitX(jumpTarget)
set swordY=GetUnitY(jumpTarget)
set exploded=true
else
set swordX=swordX+swordStep*Cos(swordAngle)
set swordY=swordY+swordStep*Sin(swordAngle)
endif
call SaveReal(TSHash,timerId,7,flightLeft-.02)
endif
else
// the throw: flightLeft is the distance left
set swordX=swordX+swordStep*Cos(swordAngle)
set swordY=swordY+swordStep*Sin(swordAngle)
set flightLeft=flightLeft-swordStep
call SaveReal(TSHash,timerId,7,flightLeft)
call GroupEnumUnitsInRange(TSEnumGroup,swordX,swordY,100.,null)
loop
set candidate=FirstOfGroup(TSEnumGroup)
exitwhen candidate==null
call GroupRemoveUnit(TSEnumGroup,candidate)
if TSIsEnemy(candidate,heroOwner) and not IsUnitInGroup(candidate,hitGroup) then
set exploded=true
endif
endloop
if flightLeft<=0. then
set exploded=true
endif
endif
if HaveSavedHandle(TSHash,timerId,1) then
call SetUnitX(swordDummy,swordX)
call SetUnitY(swordDummy,swordY)
call SetUnitFacing(swordDummy,swordAngle*bj_RADTODEG)
call SaveReal(TSHash,timerId,2,swordAngle)
if swordTicks-swordTicks/4*4==0 then
call TSScaledDummy(heroOwner,'hT11',swordX,swordY,swordAngle*bj_RADTODEG,.5,.35,1.)
endif
if exploded then
call RemoveSavedHandle(TSHash,timerId,6)
call TSSwordExplode(swordTimer,swordX,swordY)
call TSSwordNext(swordTimer,swordX,swordY)
endif
endif
set swordTimer=null
set swordDummy=null
set heroOwner=null
set hitGroup=null
set jumpTarget=null
set candidate=null
endfunction
function TSSelfRevenge takes unit tsukishimaHero,real targetX,real targetY returns nothing
local timer swordTimer=CreateTimer()
local integer timerId=GetHandleId(swordTimer)
local real heroX=GetUnitX(tsukishimaHero)
local real heroY=GetUnitY(tsukishimaHero)
local real swordAngle=TSFacing(heroX,heroY,targetX,targetY)
local integer abilityLevel=GetUnitAbilityLevel(tsukishimaHero,'TS04')
local integer jumps=abilityLevel
if abilityLevel<=2 then
set jumps=abilityLevel+1
endif
call TSPlaySound(TSSoundSwordThrow,heroX,heroY)
call SaveUnitHandle(TSHash,timerId,0,tsukishimaHero)
call SaveUnitHandle(TSHash,timerId,1,TSScaledDummy(GetOwningPlayer(tsukishimaHero),'hT09',heroX+50.*Cos(swordAngle),heroY+50.*Sin(swordAngle),swordAngle*bj_RADTODEG,0.,2.,1.))
call SaveReal(TSHash,timerId,2,swordAngle)
call SaveReal(TSHash,timerId,3,800.+200.*abilityLevel+2.*GetHeroStr(tsukishimaHero,true)+GetHeroInt(tsukishimaHero,true))
call SaveGroupHandle(TSHash,timerId,4,CreateGroup())
call SaveInteger(TSHash,timerId,5,jumps)
call SaveReal(TSHash,timerId,7,1000.)
call SaveInteger(TSHash,timerId,8,0)
call SavePlayerHandle(TSHash,timerId,9,GetOwningPlayer(tsukishimaHero))
call TimerStart(swordTimer,.02,true,function TSSwordTick)
set swordTimer=null
endfunction
// ------------------------------------------------------------------ T: Tree of the End
// timer data: 0 hero, 1/2 point, 3 level, 4 elapsed, 5 root, 6 tree, 7 ground, 8 grass group, 9 burst done,
// 10 next burn time, 11 struck
function TSTreeVisualScale takes unit treeVisual,real elapsedTime,real startTime,real growTime,real startScale,real endScale returns nothing
local real growProgress=(elapsedTime-startTime)/growTime
if treeVisual==null or growProgress<0. then
return
endif
if growProgress>1. then
set growProgress=1.
endif
set growProgress=startScale+(endScale-startScale)*growProgress
call SetUnitScale(treeVisual,growProgress,growProgress,growProgress)
endfunction
function TSTreeFade takes timer treeTimer,real fadeProgress returns nothing
local integer timerId=GetHandleId(treeTimer)
local integer fadeAlpha=R2I(255.*(1.-fadeProgress))
local unit grassDummy
if fadeAlpha<0 then
set fadeAlpha=0
endif
call SetUnitVertexColor(LoadUnitHandle(TSHash,timerId,5),255,255,255,fadeAlpha)
call SetUnitVertexColor(LoadUnitHandle(TSHash,timerId,6),255,255,255,fadeAlpha)
call SetUnitVertexColor(LoadUnitHandle(TSHash,timerId,7),255,255,255,R2I(fadeAlpha*100./255.))
if HaveSavedHandle(TSHash,timerId,8) then
call GroupAddGroup(LoadGroupHandle(TSHash,timerId,8),TSEnumGroup)
endif
loop
set grassDummy=FirstOfGroup(TSEnumGroup)
exitwhen grassDummy==null
call GroupRemoveUnit(TSEnumGroup,grassDummy)
call SetUnitVertexColor(grassDummy,255,255,255,fadeAlpha)
endloop
endfunction
function TSTreeRemoveVisuals takes timer treeTimer returns nothing
local integer timerId=GetHandleId(treeTimer)
local group grassGroup=LoadGroupHandle(TSHash,timerId,8)
local unit grassDummy
call RemoveUnit(LoadUnitHandle(TSHash,timerId,5))
if HaveSavedHandle(TSHash,timerId,6) then
call RemoveUnit(LoadUnitHandle(TSHash,timerId,6))
call RemoveUnit(LoadUnitHandle(TSHash,timerId,7))
endif
if grassGroup==null then
return
endif
loop
set grassDummy=FirstOfGroup(grassGroup)
exitwhen grassDummy==null
call GroupRemoveUnit(grassGroup,grassDummy)
call RemoveUnit(grassDummy)
endloop
call DestroyGroup(grassGroup)
set grassGroup=null
endfunction
function TSTreeRelease takes unit tsukishimaHero returns nothing
if LoadBoolean(TSHash,GetHandleId(tsukishimaHero),70) then
call SaveBoolean(TSHash,GetHandleId(tsukishimaHero),70,false)
call PauseUnit(tsukishimaHero,false)
call SetUnitTimeScale(tsukishimaHero,1.)
call SetUnitAnimation(tsukishimaHero,"stand")
endif
endfunction
function TSTreeGrow takes timer treeTimer returns nothing
local integer timerId=GetHandleId(treeTimer)
local unit tsukishimaHero=LoadUnitHandle(TSHash,timerId,0)
local player heroOwner=GetOwningPlayer(tsukishimaHero)
local real treeX=LoadReal(TSHash,timerId,1)
local real treeY=LoadReal(TSHash,timerId,2)
local group grassGroup=CreateGroup()
local integer grassIndex=0
local integer ringIndex
local real ringRadius
call TSPlaySound(TSSoundTreeGrow,treeX,treeY)
call SaveUnitHandle(TSHash,timerId,6,TSScaledDummy(heroOwner,'hT12',treeX,treeY,180.,0.,.5,1.))
call SetUnitAnimation(TSLastDummy,"birth")
call SaveUnitHandle(TSHash,timerId,7,TSScaledDummy(heroOwner,'hT14',treeX,treeY,0.,0.,.25,.25))
call SetUnitVertexColor(TSLastDummy,255,255,255,100)
loop
exitwhen grassIndex==6
set ringIndex=0
loop
exitwhen ringIndex>2
set ringRadius=240.+200.*ringIndex
call TSScaledDummy(heroOwner,'hT16',treeX+ringRadius*Cos((grassIndex*60.+ringIndex*30.)*bj_DEGTORAD),treeY+ringRadius*Sin((grassIndex*60.+ringIndex*30.)*bj_DEGTORAD),GetRandomReal(0.,359.),0.,1.75,1.)
call SetUnitVertexColor(TSLastDummy,255,255,255,0)
call GroupAddUnit(grassGroup,TSLastDummy)
set ringIndex=ringIndex+1
endloop
set grassIndex=grassIndex+1
endloop
call SaveGroupHandle(TSHash,timerId,8,grassGroup)
set tsukishimaHero=null
set heroOwner=null
set grassGroup=null
endfunction
function TSTreeBurn takes timer treeTimer returns nothing
local integer timerId=GetHandleId(treeTimer)
local unit tsukishimaHero=LoadUnitHandle(TSHash,timerId,0)
local player heroOwner=GetOwningPlayer(tsukishimaHero)
local integer abilityLevel=LoadInteger(TSHash,timerId,3)
local real manaBurn=200.+100.*abilityLevel
local unit burnedUnit
call GroupEnumUnitsInRange(TSEnumGroup,LoadReal(TSHash,timerId,1),LoadReal(TSHash,timerId,2),800.,null)
loop
set burnedUnit=FirstOfGroup(TSEnumGroup)
exitwhen burnedUnit==null
call GroupRemoveUnit(TSEnumGroup,burnedUnit)
if TSIsEnemy(burnedUnit,heroOwner) then
call GroupAddUnit(TSTreeQueue,burnedUnit)
endif
endloop
loop
set burnedUnit=FirstOfGroup(TSTreeQueue)
exitwhen burnedUnit==null
call GroupRemoveUnit(TSTreeQueue,burnedUnit)
if GetUnitState(burnedUnit,UNIT_STATE_MANA)>0. then
call SetUnitState(burnedUnit,UNIT_STATE_MANA,RMaxBJ(0.,GetUnitState(burnedUnit,UNIT_STATE_MANA)-manaBurn-.01*abilityLevel*GetUnitState(burnedUnit,UNIT_STATE_MAX_MANA)))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl",burnedUnit,"chest"))
endif
call TSCastOnTarget(tsukishimaHero,burnedUnit,'TS10',6,"slow")
endloop
set tsukishimaHero=null
set heroOwner=null
set burnedUnit=null
endfunction
function TSTreeStrike takes timer treeTimer returns nothing
local integer timerId=GetHandleId(treeTimer)
local unit tsukishimaHero=LoadUnitHandle(TSHash,timerId,0)
local player heroOwner=GetOwningPlayer(tsukishimaHero)
local real treeX=LoadReal(TSHash,timerId,1)
local real treeY=LoadReal(TSHash,timerId,2)
local integer abilityLevel=LoadInteger(TSHash,timerId,3)
local real strikeDamage=600.+200.*abilityLevel+4.*GetHeroInt(tsukishimaHero,true)+4.*GetHeroStr(tsukishimaHero,true)
local integer stunLevel=(abilityLevel+1)/2
local unit struckUnit
call TSScaledDummy(heroOwner,'hT15',treeX+200.*Cos(270.*bj_DEGTORAD),treeY+200.*Sin(270.*bj_DEGTORAD),GetRandomReal(0.,359.),1.5,11.25,.45)
call SetUnitVertexColor(TSLastDummy,255,255,255,160)
call TSScaledDummy(heroOwner,'hT17',treeX,treeY,215.,1.5,1.4,.45)
call SetUnitFlyHeight(TSLastDummy,150.,0.)
call SetUnitAnimation(LoadUnitHandle(TSHash,timerId,6),"death")
call GroupEnumUnitsInRange(TSEnumGroup,treeX,treeY,800.,null)
loop
set struckUnit=FirstOfGroup(TSEnumGroup)
exitwhen struckUnit==null
call GroupRemoveUnit(TSEnumGroup,struckUnit)
if TSIsEnemy(struckUnit,heroOwner) then
call GroupAddUnit(TSTreeQueue,struckUnit)
endif
endloop
loop
set struckUnit=FirstOfGroup(TSTreeQueue)
exitwhen struckUnit==null
call GroupRemoveUnit(TSTreeQueue,struckUnit)
call TSDamage(tsukishimaHero,struckUnit,strikeDamage)
call TSCastOnTarget(tsukishimaHero,struckUnit,'TS11',stunLevel,"thunderbolt")
endloop
set tsukishimaHero=null
set heroOwner=null
set struckUnit=null
endfunction
function TSTreeTick takes nothing returns nothing
local timer treeTimer=GetExpiredTimer()
local integer timerId=GetHandleId(treeTimer)
local unit tsukishimaHero=LoadUnitHandle(TSHash,timerId,0)
local real elapsedTime=LoadReal(TSHash,timerId,4)+.04
local unit grassDummy
call SaveReal(TSHash,timerId,4,elapsedTime)
if not LoadBoolean(TSHash,timerId,11) then
if GetWidgetLife(tsukishimaHero)<=.405 then
// the caster died: the tree withers without striking
call TSTreeRelease(tsukishimaHero)
call SaveBoolean(TSHash,timerId,11,true)
call SaveReal(TSHash,timerId,4,4.)
set elapsedTime=4.
elseif elapsedTime>=4. then
call SaveBoolean(TSHash,timerId,11,true)
call TSTreeStrike(treeTimer)
call TSTreeRelease(tsukishimaHero)
else
// the cast lasts 1 second, then Tsukishima is free again
if elapsedTime>=1. then
call TSTreeRelease(tsukishimaHero)
endif
if elapsedTime>=1. and not HaveSavedHandle(TSHash,timerId,6) then
call TSTreeGrow(treeTimer)
endif
if elapsedTime>=LoadReal(TSHash,timerId,10) then
call SaveReal(TSHash,timerId,10,LoadReal(TSHash,timerId,10)+1.)
call TSTreeBurn(treeTimer)
endif
endif
endif
// the tree grows for 3 seconds after the 1 second cast
call TSTreeVisualScale(LoadUnitHandle(TSHash,timerId,5),elapsedTime,1.,3.,.5,7.)
call TSTreeVisualScale(LoadUnitHandle(TSHash,timerId,6),elapsedTime,1.,3.,.5,4.8)
call TSTreeVisualScale(LoadUnitHandle(TSHash,timerId,7),elapsedTime,1.,3.,.25,4.6)
if elapsedTime>=1. and elapsedTime<1.6 and HaveSavedHandle(TSHash,timerId,8) then
call GroupAddGroup(LoadGroupHandle(TSHash,timerId,8),TSEnumGroup)
loop
set grassDummy=FirstOfGroup(TSEnumGroup)
exitwhen grassDummy==null
call GroupRemoveUnit(TSEnumGroup,grassDummy)
call SetUnitVertexColor(grassDummy,255,255,255,R2I(RMinBJ(1.,(elapsedTime-1.)/.5)*255.))
endloop
endif
if elapsedTime>4. then
call TSTreeFade(treeTimer,(elapsedTime-4.)/2.)
endif
if elapsedTime>=6. then
call TSTreeRemoveVisuals(treeTimer)
call TSStopTimer(treeTimer)
endif
set treeTimer=null
set tsukishimaHero=null
set grassDummy=null
endfunction
function TSTreeOfTheEnd takes unit tsukishimaHero,real treeX,real treeY returns nothing
local timer treeTimer=CreateTimer()
local integer timerId=GetHandleId(treeTimer)
local player heroOwner=GetOwningPlayer(tsukishimaHero)
call PauseUnit(tsukishimaHero,true)
call SaveBoolean(TSHash,GetHandleId(tsukishimaHero),70,true)
// Spell Twelfth: the sword raised for the 1 second cast (the animation lasts about 2.1 seconds)
call SetUnitAnimationByIndex(tsukishimaHero,3)
call SetUnitTimeScale(tsukishimaHero,2.1)
call TSPlaySound(TSSoundTreeCast,GetUnitX(tsukishimaHero),GetUnitY(tsukishimaHero))
call SaveUnitHandle(TSHash,timerId,0,tsukishimaHero)
call SaveReal(TSHash,timerId,1,treeX)
call SaveReal(TSHash,timerId,2,treeY)
call SaveInteger(TSHash,timerId,3,GetUnitAbilityLevel(tsukishimaHero,'TS05'))
call SaveReal(TSHash,timerId,4,0.)
call SaveUnitHandle(TSHash,timerId,5,TSScaledDummy(heroOwner,'hT13',treeX,treeY,0.,0.,.5,1.))
call TSScaledDummy(heroOwner,'hT15',treeX+200.*Cos(270.*bj_DEGTORAD),treeY+200.*Sin(270.*bj_DEGTORAD),GetRandomReal(0.,359.),1.6,11.25,.5)
call SaveReal(TSHash,timerId,10,0.)
call TSTreeBurn(treeTimer)
call SaveReal(TSHash,timerId,10,1.)
call TimerStart(treeTimer,.04,true,function TSTreeTick)
set treeTimer=null
set heroOwner=null
endfunction
// ------------------------------------------------------------------ V: Enemy Reading
function TSReadingEnd takes nothing returns nothing
local timer readingTimer=GetExpiredTimer()
local unit tsukishimaHero=LoadUnitHandle(TSHash,GetHandleId(readingTimer),0)
local integer heroId=GetHandleId(tsukishimaHero)
if LoadInteger(TSHash,heroId,23)==LoadInteger(TSHash,GetHandleId(readingTimer),1) then
call SaveInteger(TSHash,heroId,20,0)
call DestroyEffect(LoadEffectHandle(TSHash,heroId,22))
call RemoveSavedHandle(TSHash,heroId,22)
endif
call TSStopTimer(readingTimer)
set readingTimer=null
set tsukishimaHero=null
endfunction
function TSReadingText takes unit tsukishimaHero,integer chargesLeft returns nothing
local texttag chargesText=CreateTextTag()
call SetTextTagText(chargesText,"Enemy Reading: "+I2S(chargesLeft),.023)
call SetTextTagPos(chargesText,GetUnitX(tsukishimaHero),GetUnitY(tsukishimaHero),200.)
call SetTextTagColor(chargesText,120,200,255,255)
call SetTextTagVelocity(chargesText,0.,.03)
call SetTextTagPermanent(chargesText,false)
call SetTextTagLifespan(chargesText,1.)
call SetTextTagFadepoint(chargesText,.6)
call SetTextTagVisibility(chargesText,IsUnitVisible(tsukishimaHero,GetLocalPlayer()))
set chargesText=null
endfunction
function TSEnemyReading takes unit tsukishimaHero returns nothing
local integer heroId=GetHandleId(tsukishimaHero)
local timer readingTimer=CreateTimer()
local integer castIndex=LoadInteger(TSHash,heroId,23)+1
local integer charges=2
call SaveInteger(TSHash,heroId,23,castIndex)
call SaveInteger(TSHash,heroId,20,charges)
call SaveReal(TSHash,heroId,21,TSNow()+10.)
if not HaveSavedHandle(TSHash,heroId,22) then
call SaveEffectHandle(TSHash,heroId,22,AddSpecialEffectTarget("Abilities\\Spells\\Other\\HowlOfTerror\\HowlTarget.mdl",tsukishimaHero,"overhead"))
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\UnholyFrenzy\\UnholyFrenzyTarget.mdl",tsukishimaHero,"origin"))
call TSReadingText(tsukishimaHero,charges)
call SaveUnitHandle(TSHash,GetHandleId(readingTimer),0,tsukishimaHero)
call SaveInteger(TSHash,GetHandleId(readingTimer),1,castIndex)
call TimerStart(readingTimer,10.,false,function TSReadingEnd)
set readingTimer=null
endfunction
// ------------------------------------------------------------------ damage hook (called from UnitEventTakesDamage_Actions)
function TSDamageHook takes nothing returns nothing
local integer sourceId
local integer targetId
local real reflectDelay
local timer reflectTimer
if GhostScepterDoubling or Damage<=0. or Source==null or Target==null or not AYIsAttackDamage() then
return
endif
set sourceId=GetHandleId(Source)
set targetId=GetHandleId(Target)
// Self Revenge: -40% attack damage of the weakened attacker
if HaveSavedReal(TSHash,sourceId,30) and TSNow()<LoadReal(TSHash,sourceId,30) then
call AYPreventDamage(Target,Damage*.4)
endif
// Enemy Reading: bonus damage equal to strength
if GetUnitTypeId(Source)=='HT00' and not IsUnitIllusion(Source) and LoadInteger(TSHash,sourceId,20)>0 and TSNow()<LoadReal(TSHash,sourceId,21) and IsUnitEnemy(Target,GetOwningPlayer(Source)) then
call SaveInteger(TSHash,sourceId,20,LoadInteger(TSHash,sourceId,20)-1)
call TSReadingText(Source,LoadInteger(TSHash,sourceId,20))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",Target,"chest"))
if LoadInteger(TSHash,sourceId,20)==0 then
call DestroyEffect(LoadEffectHandle(TSHash,sourceId,22))
call RemoveSavedHandle(TSHash,sourceId,22)
endif
call BvOAddBonusDamage(GetHeroStr(Source,true))
endif
// Enemy Provocation passive: the attacker takes magic damage, at most once per 8 - 4 seconds
if GetUnitTypeId(Target)=='HT00' and not IsUnitIllusion(Target) and GetUnitAbilityLevel(Target,'TS03')>0 and IsUnitEnemy(Source,GetOwningPlayer(Target)) and GetWidgetLife(Source)>.405 then
set reflectDelay=9.-GetUnitAbilityLevel(Target,'TS03')
if not HaveSavedReal(TSHash,sourceId,10) or TSNow()>=LoadReal(TSHash,sourceId,10)+reflectDelay then
call SaveReal(TSHash,sourceId,10,TSNow())
set reflectTimer=CreateTimer()
call SaveUnitHandle(TSHash,GetHandleId(reflectTimer),0,Target)
call SaveUnitHandle(TSHash,GetHandleId(reflectTimer),1,Source)
call SaveReal(TSHash,GetHandleId(reflectTimer),2,25.+50.*GetUnitAbilityLevel(Target,'TS03')+1.25*GetHeroStr(Target,true))
call TimerStart(reflectTimer,0.,false,function TSReflectDamage)
set reflectTimer=null
endif
endif
endfunction
// ------------------------------------------------------------------ Tree of the End level and Oken
function TSSyncTree takes unit tsukishimaHero returns nothing
local integer heroId=GetHandleId(tsukishimaHero)
local integer learnedLevel=GetUnitAbilityLevel(tsukishimaHero,'TS05')
local integer wantedLevel=0
if learnedLevel>0 then
set wantedLevel=learnedLevel
if FSHasSceptre(tsukishimaHero) then
set wantedLevel=learnedLevel+5
endif
endif
if LoadInteger(TSHash,heroId,51)!=wantedLevel or GetUnitAbilityLevel(tsukishimaHero,'TS07')!=wantedLevel then
call SaveInteger(TSHash,heroId,51,wantedLevel)
if wantedLevel==0 then
call UnitRemoveAbility(tsukishimaHero,'TS07')
else
if GetUnitAbilityLevel(tsukishimaHero,'TS07')==0 then
call UnitAddAbility(tsukishimaHero,'TS07')
call UnitMakeAbilityPermanent(tsukishimaHero,true,'TS07')
endif
call SetUnitAbilityLevel(tsukishimaHero,'TS07',wantedLevel)
endif
endif
endfunction
function TSSyncEnum takes nothing returns nothing
local unit tsukishimaHero=GetEnumUnit()
if GetUnitTypeId(tsukishimaHero)==0 then
call FlushChildHashtable(TSHash,GetHandleId(tsukishimaHero))
call GroupRemoveUnit(TSHeroes,tsukishimaHero)
else
call TSSyncTree(tsukishimaHero)
endif
set tsukishimaHero=null
endfunction
function TSSyncTick takes nothing returns nothing
call ForGroup(TSHeroes,function TSSyncEnum)
endfunction
function TSTrackHero takes nothing returns boolean
if GetUnitTypeId(GetTriggerUnit())=='HT00' and not IsUnitIllusion(GetTriggerUnit()) then
call GroupAddUnit(TSHeroes,GetTriggerUnit())
call TSSyncTree(GetTriggerUnit())
endif
return false
endfunction
// ------------------------------------------------------------------ events
function TSCheckCast takes nothing returns boolean
local unit castingUnit=GetTriggerUnit()
// a provoked unit can do nothing but attack
if IsUnitInGroup(castingUnit,TSProvoked) then
call SaveBoolean(TSHash,GetHandleId(castingUnit),43,true)
call IssueImmediateOrder(castingUnit,"stop")
endif
set castingUnit=null
return false
endfunction
function TSOnChannel takes nothing returns boolean
local unit tsukishimaHero=GetTriggerUnit()
local timer animationTimer
if GetUnitTypeId(tsukishimaHero)=='HT00' then
if GetSpellAbilityId()=='TS02' then
call TSPlaySound(TSSoundPresence,GetUnitX(tsukishimaHero),GetUnitY(tsukishimaHero))
set animationTimer=CreateTimer()
call SaveUnitHandle(TSHash,GetHandleId(animationTimer),0,tsukishimaHero)
call TimerStart(animationTimer,0.,false,function TSPresenceAnimation)
set animationTimer=null
elseif GetSpellAbilityId()=='TS04' then
call TSPlaySound(TSSoundSwordCast,GetUnitX(tsukishimaHero),GetUnitY(tsukishimaHero))
endif
endif
set tsukishimaHero=null
return false
endfunction
function TSOnSpell takes nothing returns boolean
local unit tsukishimaHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
if GetUnitTypeId(tsukishimaHero)=='HT00' then
if spellId=='TS02' then
call SetUnitTimeScale(tsukishimaHero,1.)
endif
if SilenceConditions(tsukishimaHero) then
if spellId=='TS01' then
call TSBringedBlade(tsukishimaHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='TS02' then
call TSInsertPresence(tsukishimaHero)
elseif spellId=='TS03' then
call TSEnemyProvocation(tsukishimaHero)
elseif spellId=='TS04' then
call TSSelfRevenge(tsukishimaHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='TS07' then
call TSTreeOfTheEnd(tsukishimaHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='TS06' then
call TSEnemyReading(tsukishimaHero)
endif
endif
endif
set tsukishimaHero=null
return false
endfunction
// an interrupted Insert Presence must not leave Tsukishima slowed down
function TSOnEndCast takes nothing returns boolean
if GetUnitTypeId(GetTriggerUnit())=='HT00' and GetSpellAbilityId()=='TS02' then
call SetUnitTimeScale(GetTriggerUnit(),1.)
endif
return false
endfunction
function TSPreloadDummies takes nothing returns nothing
local integer dummyIndex=1
local integer array dummyTypes
set dummyTypes[1]='hT01'
set dummyTypes[2]='hT02'
set dummyTypes[3]='hT03'
set dummyTypes[4]='hT04'
set dummyTypes[5]='hT05'
set dummyTypes[6]='hT06'
set dummyTypes[7]='hT07'
set dummyTypes[8]='hT08'
set dummyTypes[9]='hT09'
set dummyTypes[10]='hT10'
set dummyTypes[11]='hT11'
set dummyTypes[12]='hT12'
set dummyTypes[13]='hT13'
set dummyTypes[14]='hT14'
set dummyTypes[15]='hT15'
set dummyTypes[16]='hT16'
set dummyTypes[17]='hT17'
set dummyTypes[18]='hT18'
loop
exitwhen dummyIndex>18
call RemoveUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),dummyTypes[dummyIndex],-7600.,-6800.,0.))
set dummyIndex=dummyIndex+1
endloop
endfunction
function TSInit takes nothing returns nothing
local trigger castCheckTrigger=CreateTrigger()
local trigger trackTrigger=CreateTrigger()
local trigger channelTrigger=CreateTrigger()
local trigger spellTrigger=CreateTrigger()
local trigger orderTrigger=CreateTrigger()
local trigger endCastTrigger=CreateTrigger()
set TSHash=InitHashtable()
set TSHeroes=CreateGroup()
set TSEnumGroup=CreateGroup()
set TSProvoked=CreateGroup()
set TSAuras=CreateGroup()
set TSPresenceGroup=CreateGroup()
set TSSwordHitQueue=CreateGroup()
set TSTreeQueue=CreateGroup()
set TSClock=CreateTimer()
call TimerStart(TSClock,1000000.,false,null)
call TriggerRegisterEnterRectSimple(trackTrigger,bj_mapInitialPlayableArea)
call TriggerRegisterAnyUnitEventBJ(trackTrigger,EVENT_PLAYER_HERO_SKILL)
call TriggerRegisterAnyUnitEventBJ(trackTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerRegisterAnyUnitEventBJ(trackTrigger,EVENT_PLAYER_UNIT_DROP_ITEM)
call TriggerAddCondition(trackTrigger,Condition(function TSTrackHero))
call TimerStart(CreateTimer(),.25,true,function TSSyncTick)
call TimerStart(CreateTimer(),.1,true,function TSProvokeTick)
set TSSoundDash=TSCreateSound("Tsukishima1 Q.wav",2000)
set TSSoundPresence=TSCreateSound("Tsukishima3 Q.wav",3131)
set TSSoundProvocation=TSCreateSound("Tsukishima3 E.wav",2878)
set TSSoundSwordCast=TSCreateSound("Tsukishima2 W.wav",1676)
set TSSoundSwordThrow=TSCreateSound("Orihime1 R2.wav",481)
set TSSoundSwordHit=TSCreateSound("Tsukishima1 R.wav",1611)
set TSSoundTreeCast=TSCreateSound("Tsukishima3 T1.wav",5593)
set TSSoundTreeGrow=TSCreateSound("Tsukishima3 T2.wav",7174)
call TSPreloadDummies()
call TriggerRegisterAnyUnitEventBJ(castCheckTrigger,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(castCheckTrigger,Condition(function TSCheckCast))
call TriggerRegisterAnyUnitEventBJ(channelTrigger,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(channelTrigger,Condition(function TSOnChannel))
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(spellTrigger,Condition(function TSOnSpell))
call TriggerRegisterAnyUnitEventBJ(orderTrigger,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call TriggerRegisterAnyUnitEventBJ(orderTrigger,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterAnyUnitEventBJ(orderTrigger,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(orderTrigger,Condition(function TSOnOrder))
call TriggerRegisterAnyUnitEventBJ(endCastTrigger,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(endCastTrigger,Condition(function TSOnEndCast))
set castCheckTrigger=null
set trackTrigger=null
set channelTrigger=null
set spellTrigger=null
set orderTrigger=null
set endCastTrigger=null
endfunction
// Rapier zone golems: once the rapier is taken the Siege Golems ('nsgg', unpaused by Emv / Eyv) are neutral
// hostile creeps with the default creep AI, so they fall asleep at night, return to their guard position and
// often stand still next to heroes. Keep them awake and send them after the nearest visible enemy hero
// (the rapier carrier first).
function BvORapierGolemTarget takes unit rapierGolem returns unit
local real golemX=GetUnitX(rapierGolem)
local real golemY=GetUnitY(rapierGolem)
local real bestDistance=900.*900.
local real candidateDistance
local unit candidate
set BvORapierGolemChosen=null
if T!=null and GetWidgetLife(T)>.405 and IsUnitVisible(T,Player(12)) and (GetUnitX(T)-golemX)*(GetUnitX(T)-golemX)+(GetUnitY(T)-golemY)*(GetUnitY(T)-golemY)<=1200.*1200. then
set BvORapierGolemChosen=T
return BvORapierGolemChosen
endif
call GroupEnumUnitsInRange(BvORapierGolemScan,golemX,golemY,900.,null)
loop
set candidate=FirstOfGroup(BvORapierGolemScan)
exitwhen candidate==null
call GroupRemoveUnit(BvORapierGolemScan,candidate)
if IsUnitType(candidate,UNIT_TYPE_HERO) and GetWidgetLife(candidate)>.405 and IsUnitEnemy(candidate,Player(12)) and IsUnitVisible(candidate,Player(12)) and GetUnitAbilityLevel(candidate,'Avul')==0 then
set candidateDistance=(GetUnitX(candidate)-golemX)*(GetUnitX(candidate)-golemX)+(GetUnitY(candidate)-golemY)*(GetUnitY(candidate)-golemY)
if candidateDistance<bestDistance then
set bestDistance=candidateDistance
set BvORapierGolemChosen=candidate
endif
endif
endloop
set candidate=null
return BvORapierGolemChosen
endfunction
function BvORapierGolemTick takes nothing returns nothing
local unit rapierGolem
local unit golemTarget
call GroupEnumUnitsOfPlayer(BvORapierGolems,Player(12),null)
loop
set rapierGolem=FirstOfGroup(BvORapierGolems)
exitwhen rapierGolem==null
call GroupRemoveUnit(BvORapierGolems,rapierGolem)
if GetUnitTypeId(rapierGolem)=='nsgg' and GetWidgetLife(rapierGolem)>.405 and not IsUnitPaused(rapierGolem) then
call UnitAddSleepPerm(rapierGolem,false)
call UnitWakeUp(rapierGolem)
call SetUnitCreepGuard(rapierGolem,false)
if GetUnitCurrentOrder(rapierGolem)!=851983 then
set golemTarget=BvORapierGolemTarget(rapierGolem)
if golemTarget!=null then
call IssueTargetOrderById(rapierGolem,851983,golemTarget)
endif
endif
endif
endloop
set rapierGolem=null
set golemTarget=null
endfunction
function BvORapierGolemsInit takes nothing returns nothing
set BvORapierGolems=CreateGroup()
set BvORapierGolemScan=CreateGroup()
call TimerStart(CreateTimer(),.5,true,function BvORapierGolemTick)
endfunction
// Unohana Retsu (HU00), model, icons and effects from Bleach: War of Souls 0.7a15 (unit UR00), the Healing Pool from
// BBR (A0E3). Every cast runs on its own timer with its data in UNHash, so several casts can run at the same time.
// UNHash keys on a timer: see each spell. Keys on a hero: 1 cached kido level, 2 cached W level.
function UNIsEnemy takes unit candidate,player ownerPlayer returns boolean
return candidate!=null and GetWidgetLife(candidate)>.405 and IsUnitEnemy(candidate,ownerPlayer) and GetUnitAbilityLevel(candidate,'Aloc')==0 and GetUnitAbilityLevel(candidate,'Avul')==0 and not IsUnitType(candidate,UNIT_TYPE_STRUCTURE)
endfunction
function UNIsAlly takes unit candidate,player ownerPlayer returns boolean
return candidate!=null and GetWidgetLife(candidate)>.405 and IsUnitAlly(candidate,ownerPlayer) and GetUnitAbilityLevel(candidate,'Aloc')==0 and not IsUnitType(candidate,UNIT_TYPE_STRUCTURE)
endfunction
function UNInMap takes real pointX,real pointY returns boolean
return pointX>GetRectMinX(bj_mapInitialPlayableArea)+32. and pointX<GetRectMaxX(bj_mapInitialPlayableArea)-32. and pointY>GetRectMinY(bj_mapInitialPlayableArea)+32. and pointY<GetRectMaxY(bj_mapInitialPlayableArea)-32.
endfunction
function UNStopTimer takes timer spellTimer returns nothing
call FlushChildHashtable(UNHash,GetHandleId(spellTimer))
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endfunction
function UNFacing takes real fromX,real fromY,real toX,real toY returns real
if fromX==toX and fromY==toY then
return 0.
endif
return Atan2(toY-fromY,toX-fromX)
endfunction
function UNCreateSound takes string soundPath,integer soundDuration returns sound
local sound spellSound=CreateSound(soundPath,false,true,true,10,10,"DefaultEAXON")
call SetSoundDuration(spellSound,soundDuration)
call SetSoundChannel(spellSound,0)
call SetSoundVolume(spellSound,127)
call SetSoundPitch(spellSound,1.)
call SetSoundDistances(spellSound,2000.,10000.)
call SetSoundDistanceCutoff(spellSound,3000.)
call Preload(soundPath)
set UNLastSound=spellSound
set spellSound=null
return UNLastSound
endfunction
function UNPlaySound takes sound spellSound,real soundX,real soundY returns nothing
call StopSound(spellSound,false,false)
call SetSoundPosition(spellSound,soundX,soundY,0.)
call StartSound(spellSound)
endfunction
function UNDamage takes unit unohanaHero,unit hitTarget,real hitDamage,integer damageKind returns nothing
call BvOKindSpellDamage(unohanaHero,hitTarget,hitDamage,false,damageKind)
endfunction
function UNCastOnTarget takes unit unohanaHero,unit spellTarget,integer abilityId,integer abilityLevel,string abilityOrder returns nothing
local unit dummyCaster
if spellTarget==null or GetWidgetLife(spellTarget)<=.405 then
return
endif
// the same caster as the Rikujo Koro of Byakuya ('u002': flying, no cast point), created on the target
// 20 to the west of the target and already facing it (east): the caster never has to turn before casting
set dummyCaster=CreateUnit(GetOwningPlayer(unohanaHero),'u002',GetUnitX(spellTarget)-20.,GetUnitY(spellTarget),0.)
call UnitAddAbility(dummyCaster,abilityId)
call SetUnitAbilityLevel(dummyCaster,abilityId,abilityLevel)
call UnitApplyTimedLife(dummyCaster,'BTLF',1.)
call IssueTargetOrderById(dummyCaster,OrderId(abilityOrder),spellTarget)
set dummyCaster=null
endfunction
function UNHeal takes unit healedUnit,real healAmount returns nothing
local texttag healText
local real missingLife=GetUnitState(healedUnit,UNIT_STATE_MAX_LIFE)-GetWidgetLife(healedUnit)
if healAmount>missingLife then
set healAmount=missingLife
endif
if healAmount<=0. then
return
endif
call SetWidgetLife(healedUnit,GetWidgetLife(healedUnit)+healAmount)
set healText=CreateTextTag()
call SetTextTagText(healText,"|c0000DF00+"+I2S(R2I(healAmount))+"|r",.023)
call SetTextTagPos(healText,GetUnitX(healedUnit),GetUnitY(healedUnit),GetUnitFlyHeight(healedUnit)+60.)
call SetTextTagVelocity(healText,0.,.04)
call SetTextTagPermanent(healText,false)
call SetTextTagLifespan(healText,1.5)
call SetTextTagFadepoint(healText,1.)
set healText=null
endfunction
// ------------------------------------------------------------------ effect dummies
// an effect dummy lives for a while, may grow, follow a unit and fade out at the end; removed, not killed
// timer keys: 0 dummy, 1 followed unit, 2 follow height, 3 elapsed, 4 life, 5 scale time, 6 scale from, 7 scale to,
// 8 fade time, 9/10/11 colour, 12 start alpha, 13 grow start
function UNEffectTick takes nothing returns nothing
local timer effectTimer=GetExpiredTimer()
local integer timerId=GetHandleId(effectTimer)
local unit effectDummy=LoadUnitHandle(UNHash,timerId,0)
local unit followedUnit=LoadUnitHandle(UNHash,timerId,1)
local real elapsedTime=LoadReal(UNHash,timerId,3)+.02
local real lifeTime=LoadReal(UNHash,timerId,4)
local real scaleTime=LoadReal(UNHash,timerId,5)
local real fadeTime=LoadReal(UNHash,timerId,8)
local real currentScale
local integer currentAlpha
call SaveReal(UNHash,timerId,3,elapsedTime)
if elapsedTime>=lifeTime or GetUnitTypeId(effectDummy)==0 then
call FlushChildHashtable(UNHash,GetHandleId(effectDummy))
call RemoveUnit(effectDummy)
call UNStopTimer(effectTimer)
else
if scaleTime>0. then
set currentScale=LoadReal(UNHash,timerId,7)
if elapsedTime-LoadReal(UNHash,timerId,13)<scaleTime then
set currentScale=LoadReal(UNHash,timerId,6)+(currentScale-LoadReal(UNHash,timerId,6))*(elapsedTime-LoadReal(UNHash,timerId,13))/scaleTime
endif
call SetUnitScale(effectDummy,currentScale,currentScale,currentScale)
endif
if followedUnit!=null and GetUnitTypeId(followedUnit)!=0 then
call SetUnitX(effectDummy,GetUnitX(followedUnit))
call SetUnitY(effectDummy,GetUnitY(followedUnit))
call SetUnitFlyHeight(effectDummy,GetUnitFlyHeight(followedUnit)+LoadReal(UNHash,timerId,2),0.)
endif
if fadeTime>0. and elapsedTime>lifeTime-fadeTime then
set currentAlpha=R2I(LoadInteger(UNHash,timerId,12)*(lifeTime-elapsedTime)/fadeTime)
call SetUnitVertexColor(effectDummy,LoadInteger(UNHash,timerId,9),LoadInteger(UNHash,timerId,10),LoadInteger(UNHash,timerId,11),currentAlpha)
endif
endif
set effectTimer=null
set effectDummy=null
set followedUnit=null
endfunction
function UNEffect takes player dummyOwner,integer dummyType,real dummyX,real dummyY,real dummyFacing,real lifeTime,real dummyScale,real dummyTimeScale returns unit
local timer effectTimer=CreateTimer()
local integer timerId=GetHandleId(effectTimer)
set UNLastDummy=CreateUnit(dummyOwner,dummyType,dummyX,dummyY,dummyFacing)
call SetUnitX(UNLastDummy,dummyX)
call SetUnitY(UNLastDummy,dummyY)
call SetUnitScale(UNLastDummy,dummyScale,dummyScale,dummyScale)
call SetUnitTimeScale(UNLastDummy,dummyTimeScale)
call SaveUnitHandle(UNHash,timerId,0,UNLastDummy)
call SaveReal(UNHash,timerId,4,lifeTime)
call SaveInteger(UNHash,timerId,9,255)
call SaveInteger(UNHash,timerId,10,255)
call SaveInteger(UNHash,timerId,11,255)
call SaveInteger(UNHash,timerId,12,255)
call SaveTimerHandle(UNHash,GetHandleId(UNLastDummy),0,effectTimer)
call TimerStart(effectTimer,.02,true,function UNEffectTick)
set effectTimer=null
return UNLastDummy
endfunction
function UNEffectTimer takes unit effectDummy returns integer
return GetHandleId(LoadTimerHandle(UNHash,GetHandleId(effectDummy),0))
endfunction
function UNEffectColor takes unit effectDummy,integer red,integer green,integer blue,integer alpha returns nothing
local integer timerId=UNEffectTimer(effectDummy)
call SetUnitVertexColor(effectDummy,red,green,blue,alpha)
call SaveInteger(UNHash,timerId,9,red)
call SaveInteger(UNHash,timerId,10,green)
call SaveInteger(UNHash,timerId,11,blue)
call SaveInteger(UNHash,timerId,12,alpha)
endfunction
function UNEffectGrow takes unit effectDummy,real growTime,real scaleFrom,real scaleTo returns nothing
local integer timerId=UNEffectTimer(effectDummy)
call SaveReal(UNHash,timerId,5,growTime)
call SaveReal(UNHash,timerId,6,scaleFrom)
call SaveReal(UNHash,timerId,7,scaleTo)
call SaveReal(UNHash,timerId,13,LoadReal(UNHash,timerId,3))
call SetUnitScale(effectDummy,scaleFrom,scaleFrom,scaleFrom)
endfunction
function UNEffectFollow takes unit effectDummy,unit followedUnit,real followHeight returns nothing
local integer timerId=UNEffectTimer(effectDummy)
call SaveUnitHandle(UNHash,timerId,1,followedUnit)
call SaveReal(UNHash,timerId,2,followHeight)
call SetUnitFlyHeight(effectDummy,GetUnitFlyHeight(followedUnit)+followHeight,0.)
endfunction
function UNEffectFade takes unit effectDummy,real fadeTime returns nothing
call SaveReal(UNHash,UNEffectTimer(effectDummy),8,fadeTime)
endfunction
// the effect dummy is removed after the given time from now
function UNEffectEndIn takes unit effectDummy,real removeDelay returns nothing
local integer timerId=UNEffectTimer(effectDummy)
call SaveReal(UNHash,timerId,4,LoadReal(UNHash,timerId,3)+removeDelay)
endfunction
// a projectile ends: it plays its death and is removed a little later
function UNEffectDie takes unit effectDummy,real removeDelay,real dummyTimeScale returns nothing
call SetUnitTimeScale(effectDummy,dummyTimeScale)
call SetUnitAnimation(effectDummy,"death")
call UNEffectEndIn(effectDummy,removeDelay)
endfunction
// ------------------------------------------------------------------ the kido book (Q)
function UNKidoLevel takes unit unohanaHero returns integer
return GetUnitAbilityLevel(unohanaHero,'UN01')
endfunction
function UNSyncHero takes unit unohanaHero returns nothing
local integer heroId=GetHandleId(unohanaHero)
local integer kidoLevel=UNKidoLevel(unohanaHero)
local integer bindLevel=GetUnitAbilityLevel(unohanaHero,'UN02')
if kidoLevel>0 and (LoadInteger(UNHash,heroId,1)!=kidoLevel or GetUnitAbilityLevel(unohanaHero,'UN0B')==0 or GetUnitAbilityLevel(unohanaHero,'UN11')!=kidoLevel) then
call SaveInteger(UNHash,heroId,1,kidoLevel)
if GetUnitAbilityLevel(unohanaHero,'UN0B')==0 then
call UnitAddAbility(unohanaHero,'UN0B')
call UnitMakeAbilityPermanent(unohanaHero,true,'UN0B')
endif
call UnitMakeAbilityPermanent(unohanaHero,true,'UN11')
call UnitMakeAbilityPermanent(unohanaHero,true,'UN12')
call UnitMakeAbilityPermanent(unohanaHero,true,'UN13')
call SetUnitAbilityLevel(unohanaHero,'UN11',kidoLevel)
call SetUnitAbilityLevel(unohanaHero,'UN12',kidoLevel)
call SetUnitAbilityLevel(unohanaHero,'UN13',kidoLevel)
elseif kidoLevel==0 and GetUnitAbilityLevel(unohanaHero,'UN0B')>0 then
call UnitRemoveAbility(unohanaHero,'UN0B')
call SaveInteger(UNHash,heroId,1,0)
endif
// the second W keeps the level of the first one
if bindLevel>0 and GetUnitAbilityLevel(unohanaHero,'UN22')>0 and GetUnitAbilityLevel(unohanaHero,'UN22')!=bindLevel then
call SetUnitAbilityLevel(unohanaHero,'UN22',bindLevel)
endif
endfunction
function UNSyncEnum takes nothing returns nothing
local unit unohanaHero=GetEnumUnit()
if GetUnitTypeId(unohanaHero)==0 then
call FlushChildHashtable(UNHash,GetHandleId(unohanaHero))
call GroupRemoveUnit(UNHeroes,unohanaHero)
else
call UNSyncHero(unohanaHero)
endif
set unohanaHero=null
endfunction
function UNSyncTick takes nothing returns nothing
call ForGroup(UNHeroes,function UNSyncEnum)
endfunction
function UNTrackHero takes nothing returns boolean
if GetUnitTypeId(GetTriggerUnit())=='HU00' and not IsUnitIllusion(GetTriggerUnit()) then
call GroupAddUnit(UNHeroes,GetTriggerUnit())
call UNSyncHero(GetTriggerUnit())
if GetLearnedSkill()=='UN02' and GetUnitAbilityLevel(GetTriggerUnit(),'UN22')==0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),'UN02',true)
endif
endif
return false
endfunction
// the cast of a kido: Unohana takes her pose, after 0.35 seconds the kido is released unless she was interrupted
// timer keys: 0 hero, 1 target x, 2 target y, 3 elapsed, 4 kido (1 - 3), 5 order
function UNShakkahoExplode takes timer ballTimer returns nothing
local integer timerId=GetHandleId(ballTimer)
local unit unohanaHero=LoadUnitHandle(UNHash,timerId,0)
local unit kidoBall=LoadUnitHandle(UNHash,timerId,1)
local player heroOwner=GetOwningPlayer(unohanaHero)
local real ballX=GetUnitX(kidoBall)
local real ballY=GetUnitY(kidoBall)
local real ballAngle=LoadReal(UNHash,timerId,2)
local integer ringIndex=0
local unit hitUnit
call UNEffect(heroOwner,'hU04',ballX,ballY,ballAngle*bj_RADTODEG,1.5,1.,1.35)
call UNEffectFade(UNLastDummy,1.5)
call GroupEnumUnitsInRange(UNEnumGroup,ballX,ballY,420.,null)
loop
set hitUnit=FirstOfGroup(UNEnumGroup)
exitwhen hitUnit==null
call GroupRemoveUnit(UNEnumGroup,hitUnit)
if UNIsEnemy(hitUnit,heroOwner) then
call UNDamage(unohanaHero,hitUnit,LoadReal(UNHash,timerId,4),MAGICAL)
endif
endloop
loop
exitwhen ringIndex>4
call UNEffect(heroOwner,'hU05',ballX,ballY,GetRandomReal(0.,359.),1.5,1.+ringIndex*.2,1.4-.12*ringIndex)
call UNEffectColor(UNLastDummy,255,255,255,105)
call SetUnitFlyHeight(UNLastDummy,10.,0.)
set ringIndex=ringIndex+1
endloop
call UNEffectDie(kidoBall,.5,2.)
call UNStopTimer(ballTimer)
set unohanaHero=null
set kidoBall=null
set heroOwner=null
set hitUnit=null
endfunction
// timer keys: 0 hero, 1 ball, 2 angle, 3 elapsed, 4 damage
function UNShakkahoTick takes nothing returns nothing
local timer ballTimer=GetExpiredTimer()
local integer timerId=GetHandleId(ballTimer)
local unit kidoBall=LoadUnitHandle(UNHash,timerId,1)
local real ballAngle=LoadReal(UNHash,timerId,2)
local real elapsedTime=LoadReal(UNHash,timerId,3)+.02
local player heroOwner=GetOwningPlayer(LoadUnitHandle(UNHash,timerId,0))
local boolean enemyHit=false
local unit nearUnit
call SaveReal(UNHash,timerId,3,elapsedTime)
if UNInMap(GetUnitX(kidoBall)+75.*Cos(ballAngle),GetUnitY(kidoBall)+75.*Sin(ballAngle)) then
call SetUnitX(kidoBall,GetUnitX(kidoBall)+75.*Cos(ballAngle))
call SetUnitY(kidoBall,GetUnitY(kidoBall)+75.*Sin(ballAngle))
else
set elapsedTime=1.
endif
if GetUnitFlyHeight(kidoBall)>50. then
call SetUnitFlyHeight(kidoBall,GetUnitFlyHeight(kidoBall)-6.,0.)
endif
call GroupEnumUnitsInRange(UNEnumGroup,GetUnitX(kidoBall),GetUnitY(kidoBall),255.,null)
loop
set nearUnit=FirstOfGroup(UNEnumGroup)
exitwhen nearUnit==null
call GroupRemoveUnit(UNEnumGroup,nearUnit)
if UNIsEnemy(nearUnit,heroOwner) then
set enemyHit=true
endif
endloop
if enemyHit or elapsedTime>=.199 then
call UNShakkahoExplode(ballTimer)
endif
set ballTimer=null
set kidoBall=null
set heroOwner=null
set nearUnit=null
endfunction
function UNShakkaho takes unit unohanaHero,real targetX,real targetY,integer kidoLevel returns nothing
local timer ballTimer=CreateTimer()
local integer timerId=GetHandleId(ballTimer)
local player heroOwner=GetOwningPlayer(unohanaHero)
local real ballAngle=UNFacing(GetUnitX(unohanaHero),GetUnitY(unohanaHero),targetX,targetY)
local unit kidoBall=UNEffect(heroOwner,'hU01',GetUnitX(unohanaHero)+50.*Cos(ballAngle),GetUnitY(unohanaHero)+50.*Sin(ballAngle),ballAngle*bj_RADTODEG,5.,.7,5.)
call SetUnitFlyHeight(kidoBall,GetRandomReal(30.,180.),0.)
call UNEffect(heroOwner,'hU02',GetUnitX(kidoBall)+80.*Cos(ballAngle),GetUnitY(kidoBall)+80.*Sin(ballAngle),ballAngle*bj_RADTODEG,1.,.75,1.5)
call UNEffectColor(UNLastDummy,255,100,100,255)
call UNEffect(heroOwner,'hU03',GetUnitX(kidoBall)+80.*Cos(ballAngle),GetUnitY(kidoBall)+80.*Sin(ballAngle),ballAngle*bj_RADTODEG+180.,1.35,1.45,1.65)
call UNEffectColor(UNLastDummy,255,100,100,255)
call SaveUnitHandle(UNHash,timerId,0,unohanaHero)
call SaveUnitHandle(UNHash,timerId,1,kidoBall)
call SaveReal(UNHash,timerId,2,ballAngle)
call SaveReal(UNHash,timerId,4,50.+50.*kidoLevel+(.75+.25*kidoLevel)*GetHeroInt(unohanaHero,true))
call TimerStart(ballTimer,.02,true,function UNShakkahoTick)
set ballTimer=null
set heroOwner=null
set kidoBall=null
endfunction
// timer keys: 0 hero, 1 mover, 2 angle, 3 elapsed, 4 damage, 5 hit group
function UNByakuraiTick takes nothing returns nothing
local timer boltTimer=GetExpiredTimer()
local integer timerId=GetHandleId(boltTimer)
local unit unohanaHero=LoadUnitHandle(UNHash,timerId,0)
local real boltX=LoadReal(UNHash,timerId,6)
local real boltY=LoadReal(UNHash,timerId,7)
local real boltAngle=LoadReal(UNHash,timerId,2)
local real elapsedTime=LoadReal(UNHash,timerId,3)+.02
local group hitGroup=LoadGroupHandle(UNHash,timerId,5)
local player heroOwner=GetOwningPlayer(unohanaHero)
local unit nearUnit
call SaveReal(UNHash,timerId,3,elapsedTime)
call GroupEnumUnitsInRange(UNEnumGroup,boltX,boltY,325.,null)
loop
set nearUnit=FirstOfGroup(UNEnumGroup)
exitwhen nearUnit==null
call GroupRemoveUnit(UNEnumGroup,nearUnit)
if UNIsEnemy(nearUnit,heroOwner) and not IsUnitInGroup(nearUnit,hitGroup) then
call GroupAddUnit(hitGroup,nearUnit)
call UNDamage(unohanaHero,nearUnit,LoadReal(UNHash,timerId,4),MAGICAL)
call UNCastOnTarget(unohanaHero,nearUnit,'UN30',1,"slow")
endif
endloop
call SaveReal(UNHash,timerId,6,boltX+175.*Cos(boltAngle))
call SaveReal(UNHash,timerId,7,boltY+175.*Sin(boltAngle))
if elapsedTime>=.099 then
call DestroyGroup(hitGroup)
call UNStopTimer(boltTimer)
endif
set boltTimer=null
set unohanaHero=null
set hitGroup=null
set heroOwner=null
set nearUnit=null
endfunction
function UNByakurai takes unit unohanaHero,real targetX,real targetY,integer kidoLevel returns nothing
local timer boltTimer=CreateTimer()
local integer timerId=GetHandleId(boltTimer)
local real heroX=GetUnitX(unohanaHero)
local real heroY=GetUnitY(unohanaHero)
local real boltAngle=UNFacing(heroX,heroY,targetX,targetY)
call UNEffect(GetOwningPlayer(unohanaHero),'hU06',heroX+50.*Cos(boltAngle),heroY+50.*Sin(boltAngle),boltAngle*bj_RADTODEG,2.,1.5,.9)
call SaveUnitHandle(UNHash,timerId,0,unohanaHero)
call SaveReal(UNHash,timerId,2,boltAngle)
call SaveReal(UNHash,timerId,4,50.+50.*kidoLevel+(.75+.25*kidoLevel)*GetHeroInt(unohanaHero,true))
call SaveGroupHandle(UNHash,timerId,5,CreateGroup())
call SaveReal(UNHash,timerId,6,heroX+100.*Cos(boltAngle))
call SaveReal(UNHash,timerId,7,heroY+100.*Sin(boltAngle))
call TimerStart(boltTimer,.02,true,function UNByakuraiTick)
set boltTimer=null
endfunction
// timer keys: 0 hero, 1 bar, 2 angle, 3 elapsed, 4 damage, 5 hit group (shared by the 12 bars), 6 speed, 7 flight time
function UNBarEnd takes timer barTimer returns nothing
local unit lightBar=LoadUnitHandle(UNHash,GetHandleId(barTimer),1)
call UNEffect(GetOwningPlayer(lightBar),'hU08',GetUnitX(lightBar),GetUnitY(lightBar),GetRandomReal(0.,359.),1.35,5.2,1.)
call SetUnitFlyHeight(UNLastDummy,GetUnitFlyHeight(lightBar)/1.15,0.)
call UNEffectDie(lightBar,.15,2.)
call UNEffectFade(lightBar,.15)
call UNStopTimer(barTimer)
set lightBar=null
endfunction
function UNBarTick takes nothing returns nothing
local timer barTimer=GetExpiredTimer()
local integer timerId=GetHandleId(barTimer)
local unit unohanaHero=LoadUnitHandle(UNHash,timerId,0)
local unit lightBar=LoadUnitHandle(UNHash,timerId,1)
local real barAngle=LoadReal(UNHash,timerId,2)
local real elapsedTime=LoadReal(UNHash,timerId,3)+.02
local group hitGroup=LoadGroupHandle(UNHash,timerId,5)
local player heroOwner=GetOwningPlayer(unohanaHero)
local unit nearUnit
call SaveReal(UNHash,timerId,3,elapsedTime)
if UNInMap(GetUnitX(lightBar)+LoadReal(UNHash,timerId,6)*Cos(barAngle),GetUnitY(lightBar)+LoadReal(UNHash,timerId,6)*Sin(barAngle)) then
call SetUnitX(lightBar,GetUnitX(lightBar)+LoadReal(UNHash,timerId,6)*Cos(barAngle))
call SetUnitY(lightBar,GetUnitY(lightBar)+LoadReal(UNHash,timerId,6)*Sin(barAngle))
else
set elapsedTime=99.
endif
if GetUnitFlyHeight(lightBar)>50. then
call SetUnitFlyHeight(lightBar,GetUnitFlyHeight(lightBar)-6.,0.)
endif
call GroupEnumUnitsInRange(UNEnumGroup,GetUnitX(lightBar),GetUnitY(lightBar),255.,null)
loop
set nearUnit=FirstOfGroup(UNEnumGroup)
exitwhen nearUnit==null
call GroupRemoveUnit(UNEnumGroup,nearUnit)
if UNIsEnemy(nearUnit,heroOwner) and not IsUnitInGroup(nearUnit,hitGroup) then
call GroupAddUnit(hitGroup,nearUnit)
call UNDamage(unohanaHero,nearUnit,LoadReal(UNHash,timerId,4),PHYSICAL)
call UNCastOnTarget(unohanaHero,nearUnit,'UN32',1,"entanglingroots")
endif
endloop
if elapsedTime>=LoadReal(UNHash,timerId,7) then
call UNBarEnd(barTimer)
endif
set barTimer=null
set unohanaHero=null
set lightBar=null
set hitGroup=null
set heroOwner=null
set nearUnit=null
endfunction
function UNDestroyHitGroup takes nothing returns nothing
local timer groupTimer=GetExpiredTimer()
call DestroyGroup(LoadGroupHandle(UNHash,GetHandleId(groupTimer),0))
call UNStopTimer(groupTimer)
set groupTimer=null
endfunction
function UNHyapporankan takes unit unohanaHero,real targetX,real targetY,integer kidoLevel returns nothing
local real heroX=GetUnitX(unohanaHero)
local real heroY=GetUnitY(unohanaHero)
local real barAngle=UNFacing(heroX,heroY,targetX,targetY)
local group hitGroup=CreateGroup()
local timer groupTimer=CreateTimer()
local timer barTimer
local integer barIndex=0
local real sideOffset
local real sideAngle
local real alongOffset
local real barSpeed
local real barX
local real barY
loop
exitwhen barIndex>11
set sideOffset=GetRandomReal(55.,240.)
set alongOffset=GetRandomReal(-50.,50.)
if ModuloInteger(barIndex,2)==0 then
set sideAngle=barAngle-.9
else
set sideAngle=barAngle+.9
endif
set barSpeed=2.*GetRandomReal(32.,45.)
set barX=heroX+sideOffset*Cos(sideAngle)+alongOffset*Cos(barAngle)
set barY=heroY+sideOffset*Sin(sideAngle)+alongOffset*Sin(barAngle)
if not UNInMap(barX,barY) then
set barX=heroX
set barY=heroY
endif
set barTimer=CreateTimer()
call UNEffect(GetOwningPlayer(unohanaHero),'hU07',barX,barY,barAngle*bj_RADTODEG+180.,5.,2.25,1.)
call SetUnitFlyHeight(UNLastDummy,GetRandomReal(60.,320.),0.)
call SaveUnitHandle(UNHash,GetHandleId(barTimer),0,unohanaHero)
call SaveUnitHandle(UNHash,GetHandleId(barTimer),1,UNLastDummy)
call SaveReal(UNHash,GetHandleId(barTimer),2,barAngle)
call SaveReal(UNHash,GetHandleId(barTimer),4,150.+50.*kidoLevel+(.25+.25*kidoLevel)*GetHeroAgi(unohanaHero,true))
call SaveGroupHandle(UNHash,GetHandleId(barTimer),5,hitGroup)
call SaveReal(UNHash,GetHandleId(barTimer),6,barSpeed)
call SaveReal(UNHash,GetHandleId(barTimer),7,.02*800./barSpeed)
call TimerStart(barTimer,.02,true,function UNBarTick)
set barIndex=barIndex+1
endloop
call SaveGroupHandle(UNHash,GetHandleId(groupTimer),0,hitGroup)
call TimerStart(groupTimer,2.,false,function UNDestroyHitGroup)
set hitGroup=null
set groupTimer=null
set barTimer=null
endfunction
// the kido are cast like any other spell: the 0.35 seconds windup is the casting time of UN11 - UN13, so the stop
// order, a stun or a silence cancel the kido before it costs mana or starts the cooldown. This tick only plays the
// windup (animation, hand effects) and ends with it.
// timer keys: 0 hero, 3 elapsed, 4 kido index, 5 order
function UNKidoCastTick takes nothing returns nothing
local timer castTimer=GetExpiredTimer()
local integer timerId=GetHandleId(castTimer)
local unit unohanaHero=LoadUnitHandle(UNHash,timerId,0)
local real elapsedTime=LoadReal(UNHash,timerId,3)+.05
local integer kidoIndex=LoadInteger(UNHash,timerId,4)
local boolean stillCasting=LoadInteger(UNHash,GetHandleId(unohanaHero),20)==timerId and GetUnitCurrentOrder(unohanaHero)==LoadInteger(UNHash,timerId,5)
call SaveReal(UNHash,timerId,3,elapsedTime)
if GetWidgetLife(unohanaHero)<=.405 or not stillCasting or elapsedTime>=.399 then
if LoadInteger(UNHash,GetHandleId(unohanaHero),20)==timerId then
call SetUnitTimeScale(unohanaHero,1.)
call SaveInteger(UNHash,GetHandleId(unohanaHero),20,0)
endif
call UNStopTimer(castTimer)
else
if elapsedTime<.06 then
if kidoIndex==1 then
call SetUnitAnimationByIndex(unohanaHero,5)
call SetUnitTimeScale(unohanaHero,.8)
elseif kidoIndex==2 then
call SetUnitAnimationByIndex(unohanaHero,9)
call SetUnitTimeScale(unohanaHero,.4)
else
call SetUnitAnimationByIndex(unohanaHero,11)
call SetUnitTimeScale(unohanaHero,.5)
endif
endif
if kidoIndex==1 and ModuloInteger(R2I(elapsedTime*100.+.5),15)==0 then
call DestroyEffect(AddSpecialEffectTarget("yooobug_hitfx_heavy.mdl",unohanaHero,"hand right"))
endif
endif
set castTimer=null
set unohanaHero=null
endfunction
// the windup, when the hero starts casting a kido
function UNKidoCast takes unit unohanaHero,integer kidoIndex,real targetX,real targetY returns nothing
local timer castTimer=CreateTimer()
local integer timerId=GetHandleId(castTimer)
call SetUnitFacing(unohanaHero,UNFacing(GetUnitX(unohanaHero),GetUnitY(unohanaHero),targetX,targetY)*bj_RADTODEG)
if kidoIndex==1 then
call UNPlaySound(UNSoundShakkaho,GetUnitX(unohanaHero),GetUnitY(unohanaHero))
call DestroyEffect(AddSpecialEffectTarget("yooobug_hitfx_heavy.mdl",unohanaHero,"hand right"))
elseif kidoIndex==2 then
call UNPlaySound(UNSoundByakurai,GetUnitX(unohanaHero),GetUnitY(unohanaHero))
call DestroyEffect(AddSpecialEffectTarget("Boros-3.mdl",unohanaHero,"hand left"))
call DestroyEffect(AddSpecialEffectTarget("az_storm_impact.mdl",unohanaHero,"hand left"))
else
call UNPlaySound(UNSoundHyapporankan,GetUnitX(unohanaHero),GetUnitY(unohanaHero))
endif
call SaveUnitHandle(UNHash,timerId,0,unohanaHero)
call SaveInteger(UNHash,timerId,4,kidoIndex)
call SaveInteger(UNHash,timerId,5,GetUnitCurrentOrder(unohanaHero))
call SaveInteger(UNHash,GetHandleId(unohanaHero),20,timerId)
call TimerStart(castTimer,.05,true,function UNKidoCastTick)
set castTimer=null
endfunction
// the kido itself, when the casting time is over (mana and cooldown are spent now)
function UNKidoFire takes unit unohanaHero,integer kidoIndex,real targetX,real targetY returns nothing
local integer kidoLevel=UNKidoLevel(unohanaHero)
if kidoLevel<1 then
set kidoLevel=1
endif
call SetUnitTimeScale(unohanaHero,1.)
call SaveInteger(UNHash,GetHandleId(unohanaHero),20,0)
if kidoIndex==1 then
call UNShakkaho(unohanaHero,targetX,targetY,kidoLevel)
elseif kidoIndex==2 then
call UNByakurai(unohanaHero,targetX,targetY,kidoLevel)
else
call UNHyapporankan(unohanaHero,targetX,targetY,kidoLevel)
endif
endfunction
function UNKidoIndex takes integer spellId returns integer
if spellId=='UN11' then
return 1
elseif spellId=='UN12' then
return 2
elseif spellId=='UN13' then
return 3
endif
return 0
endfunction
function UNOnChannel takes nothing returns boolean
local integer kidoIndex=UNKidoIndex(GetSpellAbilityId())
if kidoIndex>0 and GetUnitTypeId(GetTriggerUnit())=='HU00' then
call UNKidoCast(GetTriggerUnit(),kidoIndex,GetSpellTargetX(),GetSpellTargetY())
endif
return false
endfunction
function UNOnEndCast takes nothing returns boolean
if UNKidoIndex(GetSpellAbilityId())>0 and GetUnitTypeId(GetTriggerUnit())=='HU00' then
call SetUnitTimeScale(GetTriggerUnit(),1.)
call SaveInteger(UNHash,GetHandleId(GetTriggerUnit()),20,0)
endif
return false
endfunction
// ------------------------------------------------------------------ W: Rikujokoro <-> Sajo Sabaku
function UNShowSecondW takes unit unohanaHero returns nothing
local player heroOwner=GetOwningPlayer(unohanaHero)
call SetPlayerAbilityAvailable(heroOwner,'UN02',false)
if GetUnitAbilityLevel(unohanaHero,'UN22')==0 then
call UnitAddAbility(unohanaHero,'UN22')
call UnitMakeAbilityPermanent(unohanaHero,true,'UN22')
endif
call SetUnitAbilityLevel(unohanaHero,'UN22',GetUnitAbilityLevel(unohanaHero,'UN02'))
call SetPlayerAbilityAvailable(heroOwner,'UN22',true)
set heroOwner=null
endfunction
function UNShowFirstW takes unit unohanaHero returns nothing
call SetPlayerAbilityAvailable(GetOwningPlayer(unohanaHero),'UN22',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(unohanaHero),'UN02',true)
endfunction
// W targets an area like Byakuya's Rikujo Koro: the valid enemy hero nearest to the point, within 120
function UNRikujokoroTarget takes unit unohanaHero,real pointX,real pointY returns unit
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
local unit bestUnit=null
local real bestDistance=1000000.
local real distance
call GroupEnumUnitsInRange(nearbyUnits,pointX,pointY,120.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if ByakuyaWCanBind(unohanaHero,nearbyUnit) then
set distance=(GetUnitX(nearbyUnit)-pointX)*(GetUnitX(nearbyUnit)-pointX)+(GetUnitY(nearbyUnit)-pointY)*(GetUnitY(nearbyUnit)-pointY)
if distance<bestDistance then
set bestDistance=distance
set bestUnit=nearbyUnit
endif
endif
endloop
call DestroyGroup(nearbyUnits)
set nearbyUnits=null
set UNLastTarget=bestUnit
set bestUnit=null
return UNLastTarget
endfunction
function UNRikujokoro takes unit unohanaHero,unit spellTarget returns nothing
call UNPlaySound(UNSoundRikujokoro,GetUnitX(spellTarget),GetUnitY(spellTarget))
call UNEffect(GetOwningPlayer(unohanaHero),'hU09',GetUnitX(spellTarget),GetUnitY(spellTarget),GetRandomReal(0.,359.),2.,3.,2.)
call UNEffectFollow(UNLastDummy,spellTarget,100.)
call UNEffectFade(UNLastDummy,.25)
// like Byakuya: the stuns already on the target are removed so the bind always starts at once
call UnitRemoveAbility(spellTarget,'BPSE')
call UnitRemoveAbility(spellTarget,'B021')
call UnitRemoveAbility(spellTarget,'B022')
call UnitRemoveAbility(spellTarget,'B00X')
call UnitRemoveAbility(spellTarget,'BSTN')
call UNCastOnTarget(unohanaHero,spellTarget,'UN31',1,"thunderbolt")
call UNShowSecondW(unohanaHero)
endfunction
// timer keys: 0 hero, 1 target, 2 elapsed, 3 time to the next shine
function UNSajoTick takes nothing returns nothing
local timer chainTimer=GetExpiredTimer()
local integer timerId=GetHandleId(chainTimer)
local unit spellTarget=LoadUnitHandle(UNHash,timerId,1)
local real elapsedTime=LoadReal(UNHash,timerId,2)+.02
local real shineTime=LoadReal(UNHash,timerId,3)+.02
call SaveReal(UNHash,timerId,2,elapsedTime)
if elapsedTime>=2. or GetWidgetLife(spellTarget)<=.405 then
call UNStopTimer(chainTimer)
elseif shineTime>.28 then
call SaveReal(UNHash,timerId,3,0.)
call UNEffect(GetOwningPlayer(LoadUnitHandle(UNHash,timerId,0)),'hU11',GetUnitX(spellTarget),GetUnitY(spellTarget),GetRandomReal(0.,359.),.4,1.,GetRandomReal(.5,.95))
call UNEffectGrow(UNLastDummy,.3,1.,1.9)
call UNEffectFollow(UNLastDummy,spellTarget,167.)
else
call SaveReal(UNHash,timerId,3,shineTime)
endif
set chainTimer=null
set spellTarget=null
endfunction
function UNSajoSabaku takes unit unohanaHero,unit spellTarget returns nothing
local timer chainTimer=CreateTimer()
local integer chainIndex=0
call UNPlaySound(UNSoundSajoSabaku,GetUnitX(spellTarget),GetUnitY(spellTarget))
loop
exitwhen chainIndex>6
call UNEffect(GetOwningPlayer(unohanaHero),'hU10',GetUnitX(spellTarget),GetUnitY(spellTarget),GetRandomReal(0.,359.),2.4,1.,GetRandomReal(.1,.15))
call UNEffectGrow(UNLastDummy,.3,1.,1.9)
call UNEffectFollow(UNLastDummy,spellTarget,chainIndex*35.)
call UNEffectFade(UNLastDummy,.4)
set chainIndex=chainIndex+1
endloop
call UnitRemoveAbility(spellTarget,'BPSE')
call UnitRemoveAbility(spellTarget,'BSTN')
call UNCastOnTarget(unohanaHero,spellTarget,'UN31',1,"thunderbolt")
call SaveUnitHandle(UNHash,GetHandleId(chainTimer),0,unohanaHero)
call SaveUnitHandle(UNHash,GetHandleId(chainTimer),1,spellTarget)
call SaveReal(UNHash,GetHandleId(chainTimer),3,1.)
call TimerStart(chainTimer,.02,true,function UNSajoTick)
call UNShowFirstW(unohanaHero)
set chainTimer=null
endfunction
// ------------------------------------------------------------------ E: Kaido and its barrier
// The barrier is the Danku of Bleach: War of Souls (the same glass wall and shield as the Aizen W, AYHash keys
// 110 shield left / 111 inside a barrier): 3 seconds 150 in front of Unohana, allies within 525 of its two ends get
// a shield of 800 + 4 x STR against spell damage, every 1.5 seconds enemies close to the wall are pushed away.
// timer keys: 0 hero, 1 wall, 2 shielded group, 3 elapsed, 4 time to the next push, 5 wall angle, 6 shield
function UNBarrierTick takes nothing returns nothing
local timer wallTimer=GetExpiredTimer()
local integer timerId=GetHandleId(wallTimer)
local unit unohanaHero=LoadUnitHandle(UNHash,timerId,0)
local unit wallUnit=LoadUnitHandle(UNHash,timerId,1)
local group shieldedUnits=LoadGroupHandle(UNHash,timerId,2)
local real elapsedTime=LoadReal(UNHash,timerId,3)+.04
local real pushWait=LoadReal(UNHash,timerId,4)+.04
local real wallAngle=LoadReal(UNHash,timerId,5)
local player heroOwner=GetOwningPlayer(unohanaHero)
local real endX
local real endY
local real pushAngle
local real nearDistance
local integer endIndex=0
local unit nearUnit
call SaveReal(UNHash,timerId,3,elapsedTime)
if elapsedTime<3. then
loop
exitwhen endIndex>1
set endX=GetUnitX(wallUnit)+225.*Cos(wallAngle+(endIndex*2-1)*bj_PI/2.)
set endY=GetUnitY(wallUnit)+225.*Sin(wallAngle+(endIndex*2-1)*bj_PI/2.)
call GroupEnumUnitsInRange(UNEnumGroup,endX,endY,525.,null)
loop
set nearUnit=FirstOfGroup(UNEnumGroup)
exitwhen nearUnit==null
call GroupRemoveUnit(UNEnumGroup,nearUnit)
if UNIsAlly(nearUnit,heroOwner) then
if not IsUnitInGroup(nearUnit,shieldedUnits) then
call GroupAddUnit(shieldedUnits,nearUnit)
if LoadReal(AYHash,GetHandleId(nearUnit),110)<=0. then
call SaveReal(AYHash,GetHandleId(nearUnit),110,LoadReal(UNHash,timerId,6))
endif
endif
call SaveBoolean(AYHash,GetHandleId(nearUnit),111,true)
elseif pushWait>1.48 and UNIsEnemy(nearUnit,heroOwner) and GetUnitFlyHeight(nearUnit)<700. then
set nearDistance=SquareRoot((GetUnitX(nearUnit)-endX)*(GetUnitX(nearUnit)-endX)+(GetUnitY(nearUnit)-endY)*(GetUnitY(nearUnit)-endY))
if nearDistance<400. then
set pushAngle=Atan2(GetUnitY(nearUnit)-endY,GetUnitX(nearUnit)-endX)
if UNInMap(GetUnitX(nearUnit)+(550.-nearDistance)*Cos(pushAngle),GetUnitY(nearUnit)+(550.-nearDistance)*Sin(pushAngle)) then
call TLSlide(nearUnit,GetUnitX(nearUnit)+(550.-nearDistance)*Cos(pushAngle),GetUnitY(nearUnit)+(550.-nearDistance)*Sin(pushAngle),.2,.02)
endif
endif
endif
endloop
set endIndex=endIndex+1
endloop
if pushWait>1.48 then
set pushWait=0.
endif
call SaveReal(UNHash,timerId,4,pushWait)
// an ally who left the barrier loses its shield
call GroupClear(UNBarrierQueue)
call GroupAddGroup(shieldedUnits,UNBarrierQueue)
loop
set nearUnit=FirstOfGroup(UNBarrierQueue)
exitwhen nearUnit==null
call GroupRemoveUnit(UNBarrierQueue,nearUnit)
set endX=GetUnitX(wallUnit)+225.*Cos(wallAngle+bj_PI/2.)
set endY=GetUnitY(wallUnit)+225.*Sin(wallAngle+bj_PI/2.)
set nearDistance=SquareRoot((GetUnitX(nearUnit)-endX)*(GetUnitX(nearUnit)-endX)+(GetUnitY(nearUnit)-endY)*(GetUnitY(nearUnit)-endY))
set endX=GetUnitX(wallUnit)+225.*Cos(wallAngle-bj_PI/2.)
set endY=GetUnitY(wallUnit)+225.*Sin(wallAngle-bj_PI/2.)
if nearDistance>525. and SquareRoot((GetUnitX(nearUnit)-endX)*(GetUnitX(nearUnit)-endX)+(GetUnitY(nearUnit)-endY)*(GetUnitY(nearUnit)-endY))>525. then
call SaveBoolean(AYHash,GetHandleId(nearUnit),111,false)
call SaveReal(AYHash,GetHandleId(nearUnit),110,0.)
call GroupRemoveUnit(shieldedUnits,nearUnit)
endif
endloop
else
call SetUnitTimeScale(wallUnit,1.75)
call SetUnitAnimation(wallUnit,"death")
call AYRemoveUnitLater(wallUnit,1.5)
loop
set nearUnit=FirstOfGroup(shieldedUnits)
exitwhen nearUnit==null
call GroupRemoveUnit(shieldedUnits,nearUnit)
call SaveBoolean(AYHash,GetHandleId(nearUnit),111,false)
call SaveReal(AYHash,GetHandleId(nearUnit),110,0.)
endloop
call DestroyGroup(shieldedUnits)
call UNStopTimer(wallTimer)
endif
set wallTimer=null
set unohanaHero=null
set wallUnit=null
set shieldedUnits=null
set heroOwner=null
set nearUnit=null
endfunction
function UNKaidoBarrier takes unit unohanaHero returns nothing
local timer wallTimer=CreateTimer()
local integer timerId=GetHandleId(wallTimer)
local real wallAngle=GetUnitFacing(unohanaHero)*bj_DEGTORAD
local real wallX=GetUnitX(unohanaHero)+150.*Cos(wallAngle)
local real wallY=GetUnitY(unohanaHero)+150.*Sin(wallAngle)
local unit wallUnit
if not UNInMap(wallX,wallY) then
set wallX=GetUnitX(unohanaHero)
set wallY=GetUnitY(unohanaHero)
endif
set wallUnit=CreateUnit(GetOwningPlayer(unohanaHero),'hY15',wallX,wallY,wallAngle*bj_RADTODEG+180.)
call SetUnitX(wallUnit,wallX)
call SetUnitY(wallUnit,wallY)
call SetUnitTimeScale(wallUnit,1.2)
call SetUnitAnimation(wallUnit,"birth")
call UNEffect(GetOwningPlayer(unohanaHero),'hY16',wallX,wallY,wallAngle*bj_RADTODEG+180.,3.,.6,0.)
call UNEffectColor(UNLastDummy,255,255,255,100)
call UNPlaySound(UNSoundBarrier,wallX,wallY)
call SaveUnitHandle(UNHash,timerId,0,unohanaHero)
call SaveUnitHandle(UNHash,timerId,1,wallUnit)
call SaveGroupHandle(UNHash,timerId,2,CreateGroup())
call SaveReal(UNHash,timerId,4,99.)
call SaveReal(UNHash,timerId,5,wallAngle)
call SaveReal(UNHash,timerId,6,450.+50.*IMaxBJ(1,GetUnitAbilityLevel(unohanaHero,'UN03'))+(1.5+.5*IMaxBJ(1,GetUnitAbilityLevel(unohanaHero,'UN03')))*GetHeroStr(unohanaHero,true))
call TimerStart(wallTimer,.04,true,function UNBarrierTick)
set wallTimer=null
set wallUnit=null
endfunction
function UNKaido takes unit unohanaHero returns nothing
local player heroOwner=GetOwningPlayer(unohanaHero)
local real healAmount=500.+100.*GetUnitAbilityLevel(unohanaHero,'UN03')+(1.+.25*GetUnitAbilityLevel(unohanaHero,'UN03'))*GetHeroInt(unohanaHero,true)
local unit nearUnit
call GroupEnumUnitsInRange(UNEnumGroup,GetUnitX(unohanaHero),GetUnitY(unohanaHero),650.,null)
loop
set nearUnit=FirstOfGroup(UNEnumGroup)
exitwhen nearUnit==null
call GroupRemoveUnit(UNEnumGroup,nearUnit)
if UNIsAlly(nearUnit,heroOwner) then
call UNHeal(nearUnit,healAmount)
call UNEffect(heroOwner,'hU12',GetUnitX(nearUnit),GetUnitY(nearUnit),GetRandomReal(0.,359.),1.4,3.,1.25)
call UNEffectFollow(UNLastDummy,nearUnit,1.)
endif
endloop
call UNKaidoBarrier(unohanaHero)
set heroOwner=null
set nearUnit=null
endfunction
// ------------------------------------------------------------------ R: Healing Pool
// timer keys: 0 pool, 1 elapsed, 2 time to the next heal
function UNPoolTick takes nothing returns nothing
local timer poolTimer=GetExpiredTimer()
local integer timerId=GetHandleId(poolTimer)
local unit healingPool=LoadUnitHandle(UNHash,timerId,0)
local real elapsedTime=LoadReal(UNHash,timerId,1)+.25
local real healTime=LoadReal(UNHash,timerId,2)+.25
local player poolOwner=GetOwningPlayer(healingPool)
local unit nearUnit
call SaveReal(UNHash,timerId,1,elapsedTime)
if healTime>=1. then
set healTime=0.
call GroupEnumUnitsInRange(UNEnumGroup,GetUnitX(healingPool),GetUnitY(healingPool),400.,null)
loop
set nearUnit=FirstOfGroup(UNEnumGroup)
exitwhen nearUnit==null
call GroupRemoveUnit(UNEnumGroup,nearUnit)
if UNIsAlly(nearUnit,poolOwner) then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",nearUnit,"origin"))
call UNHeal(nearUnit,GetUnitState(nearUnit,UNIT_STATE_MAX_LIFE)*(2.+LoadInteger(UNHash,GetHandleId(healingPool),1))/100.)
call SetUnitState(nearUnit,UNIT_STATE_MANA,GetUnitState(nearUnit,UNIT_STATE_MANA)+GetUnitState(nearUnit,UNIT_STATE_MAX_MANA)*.03)
endif
endloop
endif
call SaveReal(UNHash,timerId,2,healTime)
if elapsedTime>=10. then
call GroupRemoveUnit(UNPools,healingPool)
call FlushChildHashtable(UNHash,GetHandleId(healingPool))
call RemoveUnit(healingPool)
call UNStopTimer(poolTimer)
endif
set poolTimer=null
set healingPool=null
set poolOwner=null
set nearUnit=null
endfunction
function UNHealingPool takes unit unohanaHero,real poolX,real poolY returns nothing
local timer poolTimer=CreateTimer()
local unit healingPool=CreateUnit(GetOwningPlayer(unohanaHero),'hU20',poolX,poolY,bj_UNIT_FACING)
call SetUnitX(healingPool,poolX)
call SetUnitY(healingPool,poolY)
call SetUnitFlyHeight(healingPool,100.,0.)
call SaveInteger(UNHash,GetHandleId(healingPool),1,IMaxBJ(1,GetUnitAbilityLevel(unohanaHero,'UN04')))
call GroupAddUnit(UNPools,healingPool)
call UNPlaySound(UNSoundPool,poolX,poolY)
call UNPlaySound(UNSoundTranquility,poolX,poolY)
call SaveUnitHandle(UNHash,GetHandleId(poolTimer),0,healingPool)
call TimerStart(poolTimer,.25,true,function UNPoolTick)
set poolTimer=null
set healingPool=null
endfunction
// allies inside a Healing Pool take 10 - 30% less damage (several pools do not stack, the highest level counts)
function UNDamageHook takes nothing returns nothing
local unit healingPool
local integer poolLevel=0
if GhostScepterDoubling or Damage<=0. or Target==null or FirstOfGroup(UNPools)==null then
return
endif
call GroupClear(UNPoolQueue)
call GroupAddGroup(UNPools,UNPoolQueue)
loop
set healingPool=FirstOfGroup(UNPoolQueue)
exitwhen healingPool==null
call GroupRemoveUnit(UNPoolQueue,healingPool)
if IsUnitAlly(Target,GetOwningPlayer(healingPool)) and IsUnitInRange(Target,healingPool,400.) and LoadInteger(UNHash,GetHandleId(healingPool),1)>poolLevel then
set poolLevel=LoadInteger(UNHash,GetHandleId(healingPool),1)
endif
endloop
// 10 / 15 / 20 / 25 / 30% less damage
if poolLevel>0 then
call AYPreventDamage(Target,Damage*(5.+5.*poolLevel)/100.)
endif
set healingPool=null
endfunction
// ------------------------------------------------------------------ T: Minazuki
// timer keys: 0 hero, 1 missile, 2 heal, 3 elapsed, 4 step, 5 angle, 6 height step
function UNAcidTick takes nothing returns nothing
local timer acidTimer=GetExpiredTimer()
local integer timerId=GetHandleId(acidTimer)
local unit acidMissile=LoadUnitHandle(UNHash,timerId,1)
local real elapsedTime=LoadReal(UNHash,timerId,3)+.02
local real missileAngle=LoadReal(UNHash,timerId,5)
local player heroOwner
local unit nearUnit
call SaveReal(UNHash,timerId,3,elapsedTime)
if elapsedTime<.4 then
call SetUnitX(acidMissile,GetUnitX(acidMissile)+LoadReal(UNHash,timerId,4)*Cos(missileAngle))
call SetUnitY(acidMissile,GetUnitY(acidMissile)+LoadReal(UNHash,timerId,4)*Sin(missileAngle))
call SetUnitFlyHeight(acidMissile,GetUnitFlyHeight(acidMissile)-LoadReal(UNHash,timerId,6),0.)
else
set heroOwner=GetOwningPlayer(LoadUnitHandle(UNHash,timerId,0))
call GroupEnumUnitsInRange(UNEnumGroup,GetUnitX(acidMissile),GetUnitY(acidMissile),525.,null)
loop
set nearUnit=FirstOfGroup(UNEnumGroup)
exitwhen nearUnit==null
call GroupRemoveUnit(UNEnumGroup,nearUnit)
if UNIsAlly(nearUnit,heroOwner) then
call UNHeal(nearUnit,LoadReal(UNHash,timerId,2))
endif
endloop
call UNEffect(heroOwner,'hU15',GetUnitX(acidMissile),GetUnitY(acidMissile),GetRandomReal(0.,359.),1.5,5.,1.5)
call UNEffectDie(acidMissile,1.,2.)
call UNStopTimer(acidTimer)
endif
set acidTimer=null
set acidMissile=null
set heroOwner=null
set nearUnit=null
endfunction
function UNThrowAcid takes unit unohanaHero,unit minazukiSpirit,real targetX,real targetY returns nothing
local timer acidTimer=CreateTimer()
local integer timerId=GetHandleId(acidTimer)
local real spiritX=GetUnitX(minazukiSpirit)
local real spiritY=GetUnitY(minazukiSpirit)
local real missileAngle=UNFacing(spiritX,spiritY,targetX,targetY)
local real missileDistance=SquareRoot((targetX-spiritX)*(targetX-spiritX)+(targetY-spiritY)*(targetY-spiritY))
call UNEffect(GetOwningPlayer(unohanaHero),'hU14',spiritX,spiritY,missileAngle*bj_RADTODEG,5.,2.5,.05)
call SetUnitFlyHeight(UNLastDummy,800.,0.)
call SaveUnitHandle(UNHash,timerId,0,unohanaHero)
call SaveUnitHandle(UNHash,timerId,1,UNLastDummy)
call SaveReal(UNHash,timerId,2,400.+100.*GetUnitAbilityLevel(unohanaHero,'UN05')+.8*GetHeroStr(unohanaHero,true))
call SaveReal(UNHash,timerId,4,missileDistance/20.)
call SaveReal(UNHash,timerId,5,missileAngle)
call SaveReal(UNHash,timerId,6,40.)
call TimerStart(acidTimer,.02,true,function UNAcidTick)
set acidTimer=null
endfunction
function UNRandomAllyHero takes unit unohanaHero returns unit
local player heroOwner=GetOwningPlayer(unohanaHero)
local integer heroCount=0
local integer chosenIndex
local unit nearUnit
set UNChosenHero=null
call GroupEnumUnitsInRange(UNEnumGroup,GetUnitX(unohanaHero),GetUnitY(unohanaHero),1700.,null)
loop
set nearUnit=FirstOfGroup(UNEnumGroup)
exitwhen nearUnit==null
call GroupRemoveUnit(UNEnumGroup,nearUnit)
if UNIsAlly(nearUnit,heroOwner) and IsUnitType(nearUnit,UNIT_TYPE_HERO) then
set heroCount=heroCount+1
// reservoir sampling: every hero has the same chance
if GetRandomInt(1,heroCount)==1 then
set UNChosenHero=nearUnit
endif
endif
endloop
set heroOwner=null
set nearUnit=null
return UNChosenHero
endfunction
// timer keys: 0 hero, 1 spirit, 2 elapsed, 3 time to the next throw, 4 time to the next move
function UNMinazukiTick takes nothing returns nothing
local timer spiritTimer=GetExpiredTimer()
local integer timerId=GetHandleId(spiritTimer)
local unit unohanaHero=LoadUnitHandle(UNHash,timerId,0)
local unit minazukiSpirit=LoadUnitHandle(UNHash,timerId,1)
local real elapsedTime=LoadReal(UNHash,timerId,2)+.05
local real throwTime=LoadReal(UNHash,timerId,3)+.05
local real moveTime=LoadReal(UNHash,timerId,4)+.05
local real spiritDistance
local real moveDistance
local real moveAngle
local unit acidTarget
call SaveReal(UNHash,timerId,2,elapsedTime)
if elapsedTime>=8. or GetUnitTypeId(unohanaHero)==0 then
call UNEffectGrow(minazukiSpirit,.4,4.,.01)
call UNEffectFade(minazukiSpirit,.4)
call UNEffectEndIn(minazukiSpirit,.4)
call UNStopTimer(spiritTimer)
else
if throwTime>=1.4999 or (throwTime>=.7499 and FSHasSceptre(unohanaHero)) then
set throwTime=0.
set acidTarget=UNRandomAllyHero(unohanaHero)
if acidTarget!=null then
call UNThrowAcid(unohanaHero,minazukiSpirit,GetUnitX(acidTarget),GetUnitY(acidTarget))
endif
endif
set spiritDistance=SquareRoot((GetUnitX(unohanaHero)-GetUnitX(minazukiSpirit))*(GetUnitX(unohanaHero)-GetUnitX(minazukiSpirit))+(GetUnitY(unohanaHero)-GetUnitY(minazukiSpirit))*(GetUnitY(unohanaHero)-GetUnitY(minazukiSpirit)))
if spiritDistance>1100. or moveTime>1.25 then
set moveTime=0.
if spiritDistance>2400. then
set moveDistance=GetRandomReal(550.,1100.)
set moveAngle=(GetUnitFacing(unohanaHero)+GetRandomReal(-75.,75.))*bj_DEGTORAD
call SetUnitX(minazukiSpirit,GetUnitX(unohanaHero)+moveDistance*Cos(moveAngle))
call SetUnitY(minazukiSpirit,GetUnitY(unohanaHero)+moveDistance*Sin(moveAngle))
else
set moveDistance=GetRandomReal(800.,1400.)
set moveAngle=(GetUnitFacing(unohanaHero)+GetRandomReal(-180.,180.))*bj_DEGTORAD
call IssuePointOrderById(minazukiSpirit,851986,GetUnitX(unohanaHero)+moveDistance*Cos(moveAngle),GetUnitY(unohanaHero)+moveDistance*Sin(moveAngle))
endif
endif
call SaveReal(UNHash,timerId,3,throwTime)
call SaveReal(UNHash,timerId,4,moveTime)
endif
set spiritTimer=null
set unohanaHero=null
set minazukiSpirit=null
set acidTarget=null
endfunction
function UNMinazuki takes unit unohanaHero returns nothing
local timer spiritTimer=CreateTimer()
call UNPlaySound(UNSoundMinazuki,GetUnitX(unohanaHero),GetUnitY(unohanaHero))
call UNEffect(GetOwningPlayer(unohanaHero),'hU13',GetUnitX(unohanaHero),GetUnitY(unohanaHero),GetUnitFacing(unohanaHero),9.,.01,1.)
call UNEffectGrow(UNLastDummy,.45,.01,4.)
call SaveUnitHandle(UNHash,GetHandleId(spiritTimer),0,unohanaHero)
call SaveUnitHandle(UNHash,GetHandleId(spiritTimer),1,UNLastDummy)
call SaveReal(UNHash,GetHandleId(spiritTimer),4,1.25)
call TimerStart(spiritTimer,.05,true,function UNMinazukiTick)
set spiritTimer=null
endfunction
// ------------------------------------------------------------------ events
function UNOnSpell takes nothing returns boolean
local unit unohanaHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
local unit spellTarget=GetSpellTargetUnit()
if GetUnitTypeId(unohanaHero)=='HU00' and SilenceConditions(unohanaHero) then
if spellId=='UN11' then
call UNKidoFire(unohanaHero,1,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='UN12' then
call UNKidoFire(unohanaHero,2,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='UN13' then
call UNKidoFire(unohanaHero,3,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='UN02' then
set spellTarget=UNRikujokoroTarget(unohanaHero,GetSpellTargetX(),GetSpellTargetY())
if spellTarget!=null then
call UNRikujokoro(unohanaHero,spellTarget)
else
call DisplayTimedTextToPlayer(GetOwningPlayer(unohanaHero),0.,0.,4.,"|cffffcc00No valid target found|r")
endif
elseif spellId=='UN22' then
call UNSajoSabaku(unohanaHero,spellTarget)
elseif spellId=='UN03' then
call UNKaido(unohanaHero)
elseif spellId=='UN04' then
call UNHealingPool(unohanaHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='UN05' then
call UNMinazuki(unohanaHero)
endif
endif
set unohanaHero=null
set spellTarget=null
return false
endfunction
function UNPreloadDummies takes nothing returns nothing
local integer dummyIndex=1
local integer array dummyTypes
set dummyTypes[1]='hU01'
set dummyTypes[2]='hU02'
set dummyTypes[3]='hU03'
set dummyTypes[4]='hU04'
set dummyTypes[5]='hU05'
set dummyTypes[6]='hU06'
set dummyTypes[7]='hU07'
set dummyTypes[8]='hU08'
set dummyTypes[9]='hU09'
set dummyTypes[10]='hU10'
set dummyTypes[11]='hU11'
set dummyTypes[12]='hU12'
set dummyTypes[13]='hU13'
set dummyTypes[14]='hU14'
set dummyTypes[15]='hU15'
set dummyTypes[16]='hU20'
loop
exitwhen dummyIndex>16
call RemoveUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),dummyTypes[dummyIndex],-7600.,-6800.,0.))
set dummyIndex=dummyIndex+1
endloop
endfunction
function UNInit takes nothing returns nothing
local trigger trackTrigger=CreateTrigger()
local trigger spellTrigger=CreateTrigger()
set UNHash=InitHashtable()
set UNHeroes=CreateGroup()
set UNEnumGroup=CreateGroup()
set UNPools=CreateGroup()
set UNPoolQueue=CreateGroup()
set UNBarrierQueue=CreateGroup()
call TriggerRegisterEnterRectSimple(trackTrigger,bj_mapInitialPlayableArea)
call TriggerRegisterAnyUnitEventBJ(trackTrigger,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(trackTrigger,Condition(function UNTrackHero))
call TimerStart(CreateTimer(),.5,true,function UNSyncTick)
set UNSoundShakkaho=UNCreateSound("Unohana1 Q1.mp3",1123)
set UNSoundByakurai=UNCreateSound("Unohana1 Q2.mp3",1541)
set UNSoundHyapporankan=UNCreateSound("Unohana1 Q3.mp3",3161)
set UNSoundRikujokoro=UNCreateSound("Unohana1 W1.mp3",3291)
set UNSoundSajoSabaku=UNCreateSound("Unohana1 W2.mp3",2691)
set UNSoundMinazuki=UNCreateSound("Unohana1 T.mp3",6531)
set UNSoundBarrier=UNCreateSound("Unohana1 E2.mp3",3187)
set UNSoundPool=UNCreateSound("war3mapImported\\mouzhihua02.mp3",1200)
set UNSoundTranquility=UNCreateSound("Abilities\\Spells\\NightElf\\Tranquility\\Tranquility.wav",3572)
call UNPreloadDummies()
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(spellTrigger,Condition(function UNOnSpell))
set spellTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(spellTrigger,Condition(function UNOnChannel))
set spellTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(spellTrigger,Condition(function UNOnEndCast))
set trackTrigger=null
set spellTrigger=null
endfunction
// ------------------------------------------------------------------ Gem of Eternal Sight (6 Gems of True Seeing + recipe 10000)
// the six gems fill the inventory, so the recipe is only a shop button: with six Gems of True Seeing ('gemt') it makes
// the Gem of Eternal Sight, otherwise the 10000 gold come back. The active gives every allied hero the detector AX06
// for 5 seconds (a counter per hero, so a second use before the end extends it).
function GemSightOnSell takes nothing returns boolean
local unit buyer=GetBuyingUnit()
local player buyerOwner=GetOwningPlayer(buyer)
local integer gemIndex=0
if GetItemTypeId(GetSoldItem())=='IK04' then
if IsUnitType(buyer,UNIT_TYPE_HERO) and GetNumberOfItemsId(buyer,'gemt')>=6 then
loop
exitwhen gemIndex>=6
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,'gemt'))
set gemIndex=gemIndex+1
endloop
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MagicSentry\\MagicSentryCaster.mdl",buyer,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",buyer,"origin"))
call UnitAddItemByIdSwapped('IK01',buyer)
else
call SetPlayerState(buyerOwner,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(buyerOwner,PLAYER_STATE_RESOURCE_GOLD)+10000)
if GetLocalPlayer()==buyerOwner then
call DisplayTimedTextToPlayer(buyerOwner,0,0,6,"|cffffcc00The Gem of Eternal Sight needs a hero with 6 Gems of True Seeing in the inventory.|r")
endif
endif
endif
set buyer=null
set buyerOwner=null
return false
endfunction
function GemSightEnd takes nothing returns nothing
local timer sightTimer=GetExpiredTimer()
local unit seeingHero=LoadUnitHandle(GemSightHash,GetHandleId(sightTimer),0)
local integer heroId=GetHandleId(seeingHero)
local integer activeCount=LoadInteger(GemSightHash,heroId,0)-1
call SaveInteger(GemSightHash,heroId,0,activeCount)
if activeCount<=0 then
call UnitRemoveAbility(seeingHero,'AX09')
call DestroyEffect(LoadEffectHandle(GemSightHash,heroId,1))
call FlushChildHashtable(GemSightHash,heroId)
endif
call FlushChildHashtable(GemSightHash,GetHandleId(sightTimer))
call DestroyTimer(sightTimer)
set sightTimer=null
set seeingHero=null
endfunction
function GemSightGive takes unit seeingHero returns nothing
local integer heroId=GetHandleId(seeingHero)
local timer sightTimer=CreateTimer()
if LoadInteger(GemSightHash,heroId,0)<=0 then
call UnitAddAbility(seeingHero,'AX09')
call UnitMakeAbilityPermanent(seeingHero,true,'AX09')
call SaveEffectHandle(GemSightHash,heroId,1,AddSpecialEffectTarget("Abilities\\Spells\\Human\\MagicSentry\\MagicSentryCaster.mdl",seeingHero,"overhead"))
endif
call SaveInteger(GemSightHash,heroId,0,LoadInteger(GemSightHash,heroId,0)+1)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIta\\CrystalBallCaster.mdl",seeingHero,"overhead"))
call SaveUnitHandle(GemSightHash,GetHandleId(sightTimer),0,seeingHero)
call TimerStart(sightTimer,5.,false,function GemSightEnd)
set sightTimer=null
endfunction
function GemSightOnSpell takes nothing returns boolean
local player casterOwner
local group allHeroes
local unit nextHero
if GetSpellAbilityId()=='AX05' then
set casterOwner=GetOwningPlayer(GetTriggerUnit())
set allHeroes=CreateGroup()
call GroupEnumUnitsInRect(allHeroes,bj_mapInitialPlayableArea,null)
loop
set nextHero=FirstOfGroup(allHeroes)
exitwhen nextHero==null
call GroupRemoveUnit(allHeroes,nextHero)
if IsUnitType(nextHero,UNIT_TYPE_HERO) and GetWidgetLife(nextHero)>.405 and IsUnitAlly(nextHero,casterOwner) and not IsUnitIllusion(nextHero) then
call GemSightGive(nextHero)
endif
endloop
call DestroyGroup(allHeroes)
if GetLocalPlayer()==casterOwner or IsPlayerAlly(GetLocalPlayer(),casterOwner) then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,5,"|cff80ffffEternal Sight: your team sees invisible units for 5 seconds.|r")
endif
endif
set casterOwner=null
set allHeroes=null
set nextHero=null
return false
endfunction
function GemSightInit takes nothing returns nothing
local trigger sellTrigger=CreateTrigger()
local trigger spellTrigger=CreateTrigger()
local integer sightPlayer=0
set GemSightHash=InitHashtable()
loop
exitwhen sightPlayer>=16
call SetPlayerAbilityAvailable(Player(sightPlayer),'AX09',false)
set sightPlayer=sightPlayer+1
endloop
call TriggerRegisterAnyUnitEventBJ(sellTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(sellTrigger,Condition(function GemSightOnSell))
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(spellTrigger,Condition(function GemSightOnSpell))
set sellTrigger=null
set spellTrigger=null
endfunction
// ------------------------------------------------------------------ Divine Wind Bow (Alleria's Sacred Sight + Divine Rapier + Geppo Cloak)
// no recipe: the bow is made as soon as a hero carries the three parts. A ranged hero with the bow gets +300 attack
// range: one more level of Long Rifles (Rhri, +300 per level) when it gets the bow, one more level of Improved Bows
// (Reib, -300 per level) when it loses it (upgrades can not be unresearched in 1.26); both are used by every hero.
function WindBowHasParts takes unit holder returns boolean
return UnitHasItemOfTypeBJ(holder,'IKB1') and UnitHasItemOfTypeBJ(holder,$49303250) and UnitHasItemOfTypeBJ(holder,$49303041) and UnitHasItemOfTypeBJ(holder,$4930324A)
endfunction
function WindBowOnPickup takes nothing returns boolean
local unit holder=GetManipulatingUnit()
if IsUnitType(holder,UNIT_TYPE_HERO) and WindBowHasParts(holder) then
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,$49303250))
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,$49303041))
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,$4930324A))
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,'IKB1'))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\ReviveHuman\\ReviveHuman.mdl",holder,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Starfall\\StarfallTarget.mdl",holder,"origin"))
call UnitAddItemByIdSwapped('IK02',holder)
endif
set holder=null
return false
endfunction
// Wind Walk of the bow: like the Geppo Cloak, the bow can not be dropped for 20 seconds after it
function WindBowDroppableAgain takes nothing returns nothing
local timer dropTimer=GetExpiredTimer()
call SetItemDroppable(LoadItemHandle(WindBowHash,GetHandleId(dropTimer),0),true)
call FlushChildHashtable(WindBowHash,GetHandleId(dropTimer))
call DestroyTimer(dropTimer)
set dropTimer=null
endfunction
function WindBowOnUse takes nothing returns boolean
local timer dropTimer
if GetItemTypeId(GetManipulatedItem())=='IK02' then
call SetItemDroppable(GetManipulatedItem(),false)
set dropTimer=CreateTimer()
call SaveItemHandle(WindBowHash,GetHandleId(dropTimer),0,GetManipulatedItem())
call TimerStart(dropTimer,20.,false,function WindBowDroppableAgain)
set dropTimer=null
endif
return false
endfunction
function WindBowRangeTick takes nothing returns nothing
local integer playerIndex=0
local player rangePlayer
local group playerUnits=CreateGroup()
local unit candidate
local boolean wanted
loop
exitwhen playerIndex>11
set rangePlayer=Player(playerIndex)
set wanted=false
call GroupEnumUnitsOfPlayer(playerUnits,rangePlayer,null)
loop
set candidate=FirstOfGroup(playerUnits)
exitwhen candidate==null
call GroupRemoveUnit(playerUnits,candidate)
if not wanted and IsUnitType(candidate,UNIT_TYPE_HERO) and IsUnitType(candidate,UNIT_TYPE_RANGED_ATTACKER) and not IsUnitIllusion(candidate) and UnitHasItemOfTypeBJ(candidate,'IK02') then
set wanted=true
endif
endloop
if wanted and not WindBowRangeOn[playerIndex] and GetPlayerTechCount(rangePlayer,'Rhri',true)<60 then
set WindBowRangeOn[playerIndex]=true
call SetPlayerTechResearched(rangePlayer,'Rhri',GetPlayerTechCount(rangePlayer,'Rhri',true)+1)
elseif not wanted and WindBowRangeOn[playerIndex] then
set WindBowRangeOn[playerIndex]=false
call SetPlayerTechResearched(rangePlayer,'Reib',GetPlayerTechCount(rangePlayer,'Reib',true)+1)
endif
set playerIndex=playerIndex+1
endloop
call DestroyGroup(playerUnits)
set playerUnits=null
set rangePlayer=null
set candidate=null
endfunction
function WindBowOnSell takes nothing returns boolean
local unit buyer=GetBuyingUnit()
if GetItemTypeId(GetSoldItem())=='IKB0' then
call RemoveItem(GetSoldItem())
if not IsUnitType(buyer,UNIT_TYPE_HERO) then
call SetPlayerState(GetOwningPlayer(buyer),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(buyer),PLAYER_STATE_RESOURCE_GOLD)+15000)
elseif UnitHasItemOfTypeBJ(buyer,$49303250) and UnitHasItemOfTypeBJ(buyer,$49303041) and UnitHasItemOfTypeBJ(buyer,$4930324A) then
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303250))
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303041))
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$4930324A))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\ReviveHuman\\ReviveHuman.mdl",buyer,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Starfall\\StarfallTarget.mdl",buyer,"origin"))
call UnitAddItemByIdSwapped('IK02',buyer)
else
call UnitAddItemByIdSwapped('IKB1',buyer)
endif
endif
set buyer=null
return false
endfunction
function WindBowInit takes nothing returns nothing
local trigger pickupTrigger=CreateTrigger()
local trigger useTrigger=CreateTrigger()
set WindBowHash=InitHashtable()
call TriggerRegisterAnyUnitEventBJ(pickupTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(pickupTrigger,Condition(function WindBowOnPickup))
call TriggerRegisterAnyUnitEventBJ(useTrigger,EVENT_PLAYER_UNIT_USE_ITEM)
call TriggerAddCondition(useTrigger,Condition(function WindBowOnUse))
set useTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(useTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(useTrigger,Condition(function WindBowOnSell))
call TimerStart(CreateTimer(),.5,true,function WindBowRangeTick)
set pickupTrigger=null
set useTrigger=null
endfunction
