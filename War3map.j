set BvOPickName[1]="Kurosaki Ichigo"
set BvOPickLines[1]=10
set BvOPickText[16]="Ichigo is an orange-haired student who becomes a"
set BvOPickText[17]="substitute Shinigami after absorbing Rukia's"
set BvOPickText[18]="powers. Though reluctant at first, he learns to"
set BvOPickText[19]="wield Zangetsu and accepts his duty to protect"
set BvOPickText[20]="the people close to him."
