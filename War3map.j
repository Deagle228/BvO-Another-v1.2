call TriggerRegisterAnyUnitEventBJ(orderTrigger,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterAnyUnitEventBJ(orderTrigger,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddAction(orderTrigger,function FZTRecordOrder)
call TriggerRegisterAnyUnitEventBJ(s,EVENT_PLAYER_UNIT_SUMMON)
call TriggerAddAction(s,function FZMiniSummon)
set t=null
set s=null
set orderTrigger=null
endfunction

// Nanaya Shiki, isolated from FOCS's shared and global hero triggers.

function FSRDamageBase takes integer level returns real
if level<=1 then
return 2000.
elseif level==2 then
return 2500.
elseif level==3 then
return 3000.
elseif level==4 then
return 3500.
endif
return 4000.
endfunction
function FSQFilter takes nothing returns boolean
return GetWidgetLife(GetFilterUnit())>.405 and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(LoadUnitHandle(FSHash,GetHandleId(GetExpiredTimer()),0))) and not IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)
endfunction

function FSQDamage takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit caster=LoadUnitHandle(FSHash,GetHandleId(t),0)
local unit target=GetEnumUnit()
local group hit=LoadGroupHandle(FSHash,GetHandleId(t),4)
if not IsUnitInGroup(target,hit) then
call GroupAddUnit(hit,target)
call BvOKindSpellDamage(caster,target,150.+100.*I2R(GetUnitAbilityLevel(caster,'AS01'))+.25*I2R(GetUnitAbilityLevel(caster,'AS01'))*I2R(GetHeroAgi(caster,false)),true,MAGICAL)
endif
set caster=null
set target=null
set hit=null
set t=null
endfunction

function FSPathHideItem takes nothing returns nothing
local item nearbyItem=GetEnumItem()
if nearbyItem!=FSPathProbe and IsItemVisible(nearbyItem) then
set FSPathHiddenCount=FSPathHiddenCount+1
set FSPathHiddenItems[FSPathHiddenCount]=nearbyItem
call SetItemVisible(nearbyItem,false)
endif
set nearbyItem=null
endfunction
function FSPointWalkable takes real checkX,real checkY returns boolean
local real probeOffsetX
local real probeOffsetY
if checkX<GetRectMinX(bj_mapInitialPlayableArea)+32. or checkX>GetRectMaxX(bj_mapInitialPlayableArea)-32. or checkY<GetRectMinY(bj_mapInitialPlayableArea)+32. or checkY>GetRectMaxY(bj_mapInitialPlayableArea)-32. then
return false
endif
if IsTerrainPathable(checkX,checkY,PATHING_TYPE_WALKABILITY) then
return false
endif
if FSPathProbe==null or GetItemTypeId(FSPathProbe)==0 then
set FSPathProbe=CreateItem('wolg',checkX,checkY)
endif
if FSPathItemArea==null then
set FSPathItemArea=Rect(0.,0.,128.,128.)
endif
call MoveRectTo(FSPathItemArea,checkX,checkY)
call EnumItemsInRect(FSPathItemArea,null,function FSPathHideItem)
call SetItemPosition(FSPathProbe,checkX,checkY)
set probeOffsetX=GetItemX(FSPathProbe)-checkX
set probeOffsetY=GetItemY(FSPathProbe)-checkY
call SetItemVisible(FSPathProbe,false)
loop
exitwhen FSPathHiddenCount<=0
call SetItemVisible(FSPathHiddenItems[FSPathHiddenCount],true)
set FSPathHiddenItems[FSPathHiddenCount]=null
set FSPathHiddenCount=FSPathHiddenCount-1
endloop
return probeOffsetX*probeOffsetX+probeOffsetY*probeOffsetY<=100.
endfunction
function FSPathClear takes real pathStartX,real pathStartY,real pathEndX,real pathEndY returns boolean
local real pathDeltaX=pathEndX-pathStartX
local real pathDeltaY=pathEndY-pathStartY
local real pathLength=SquareRoot(pathDeltaX*pathDeltaX+pathDeltaY*pathDeltaY)
local integer pathStepCount=R2I(pathLength/16.)
local integer pathStepIndex=1
loop
exitwhen pathStepIndex>pathStepCount
if not FSPointWalkable(pathStartX+pathDeltaX*16.*I2R(pathStepIndex)/pathLength,pathStartY+pathDeltaY*16.*I2R(pathStepIndex)/pathLength) then
return false
endif
set pathStepIndex=pathStepIndex+1
endloop
return true
endfunction
function FSCheckTargetReachable takes nothing returns boolean
local unit shikiCaster=GetTriggerUnit()
local unit shikiTarget=GetSpellTargetUnit()
local integer shikiSpell=GetSpellAbilityId()
if GetUnitTypeId(shikiCaster)=='HS00' and (shikiSpell=='AS03' or shikiSpell=='AS04') and shikiTarget!=null then
if not FSPathClear(GetUnitX(shikiCaster),GetUnitY(shikiCaster),GetUnitX(shikiTarget),GetUnitY(shikiTarget)) then
call IssueImmediateOrder(shikiCaster,"stop")
if GetOwningPlayer(shikiCaster)==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00Target is unreachable|r")
endif
endif
endif
set shikiCaster=null
set shikiTarget=null
return false
endfunction
function FSChangeSpellInvulnerability takes unit shikiHero,integer shikiSpellSlot,integer shikiSpellDelta returns nothing
local integer shikiHeroKey=GetHandleId(shikiHero)
local integer shikiGeneration=LoadInteger(Hash,shikiHeroKey,StringHash("BvORevivalGeneration"))
local integer shikiActiveSpells
if shikiHero==null then
return
endif
if LoadInteger(FSHash,shikiHeroKey,26)!=shikiGeneration then
call SaveInteger(FSHash,shikiHeroKey,24,0)
call SaveInteger(FSHash,shikiHeroKey,25,0)
call SaveInteger(FSHash,shikiHeroKey,26,shikiGeneration)
endif
set shikiActiveSpells=LoadInteger(FSHash,shikiHeroKey,shikiSpellSlot)+shikiSpellDelta
if shikiActiveSpells<0 then
set shikiActiveSpells=0
endif
call SaveInteger(FSHash,shikiHeroKey,shikiSpellSlot,shikiActiveSpells)
if LoadInteger(FSHash,shikiHeroKey,24)+LoadInteger(FSHash,shikiHeroKey,25)>0 then
call SetUnitInvulnerable(shikiHero,true)
else
call SetUnitInvulnerable(shikiHero,false)
endif
endfunction
function FSStop takes timer t returns nothing
local integer k=GetHandleId(t)
local group g=LoadGroupHandle(FSHash,k,4)
if LoadInteger(FSHash,k,2)==2 then
call FSChangeSpellInvulnerability(LoadUnitHandle(FSHash,k,0),25,-1)
endif
if g!=null then
call DestroyGroup(g)
endif
call FlushChildHashtable(FSHash,k)
call PauseTimer(t)
call DestroyTimer(t)
set g=null
endfunction

function FSRelease takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit victim=LoadUnitHandle(FSHash,GetHandleId(t),0)
local effect fsQDelayedWave=LoadEffectHandle(FSHash,GetHandleId(t),9)
local integer fsComboHeroId=LoadInteger(FSHash,GetHandleId(t),13)
if LoadBoolean(FSHash,GetHandleId(t),14) then
if LoadTimerHandle(FSHash,fsComboHeroId,21)==t then
call SaveInteger(FSHash,fsComboHeroId,22,0)
call RemoveSavedHandle(FSHash,fsComboHeroId,21)
endif
elseif fsQDelayedWave!=null then
call DestroyEffect(fsQDelayedWave)
elseif victim!=null then
if LoadBoolean(FSHash,GetHandleId(t),12) then
call SetUnitVertexColor(victim,255,255,255,255)
call SetUnitPathing(victim,true)
call PauseUnit(victim,false)
elseif LoadBoolean(FSHash,GetHandleId(t),8) then
call RemoveUnit(victim)
else
call PauseUnit(victim,false)
endif
endif
call FSStop(t)
set victim=null
set fsQDelayedWave=null
set t=null
endfunction

function FSQReturn takes nothing returns nothing
local timer shikiReturnTimer=GetExpiredTimer()
local integer shikiReturnKey=GetHandleId(shikiReturnTimer)
local unit shikiHero=LoadUnitHandle(FSHash,shikiReturnKey,0)
if shikiHero!=null and LoadTimerHandle(FSHash,GetHandleId(shikiHero),23)==shikiReturnTimer then
call RemoveSavedHandle(FSHash,GetHandleId(shikiHero),23)
call FSChangeSpellInvulnerability(shikiHero,24,-1)
if GetWidgetLife(shikiHero)>.405 and LoadInteger(Hash,GetHandleId(shikiHero),StringHash("BvORevivalGeneration"))==LoadInteger(FSHash,shikiReturnKey,3) then
call SetUnitPosition(shikiHero,LoadReal(FSHash,shikiReturnKey,1),LoadReal(FSHash,shikiReturnKey,2))
endif
endif
call FSStop(shikiReturnTimer)
set shikiHero=null
set shikiReturnTimer=null
endfunction
function FSQScheduleReturn takes unit shikiHero,real shikiOriginX,real shikiOriginY returns nothing
local timer shikiReturnTimer=CreateTimer()
local integer shikiReturnKey=GetHandleId(shikiReturnTimer)
call SaveUnitHandle(FSHash,shikiReturnKey,0,shikiHero)
call SaveReal(FSHash,shikiReturnKey,1,shikiOriginX)
call SaveReal(FSHash,shikiReturnKey,2,shikiOriginY)
call SaveInteger(FSHash,shikiReturnKey,3,LoadInteger(Hash,GetHandleId(shikiHero),StringHash("BvORevivalGeneration")))
if LoadTimerHandle(FSHash,GetHandleId(shikiHero),23)!=null then
call FSChangeSpellInvulnerability(shikiHero,24,-1)
endif
call SaveTimerHandle(FSHash,GetHandleId(shikiHero),23,shikiReturnTimer)
call TimerStart(shikiReturnTimer,.5,false,function FSQReturn)
set shikiReturnTimer=null
endfunction
function FSQCancelReturn takes unit shikiHero returns nothing
if LoadTimerHandle(FSHash,GetHandleId(shikiHero),23)!=null then
call RemoveSavedHandle(FSHash,GetHandleId(shikiHero),23)
call FSChangeSpellInvulnerability(shikiHero,24,-1)
endif
endfunction
function FSQTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer k=GetHandleId(t)
local unit caster=LoadUnitHandle(FSHash,k,0)
local real angle=LoadReal(FSHash,k,1)
local real originX=LoadReal(FSHash,k,6)
local real originY=LoadReal(FSHash,k,7)
local real landingDistance=LoadReal(FSHash,k,8)
local real nx
local real ny
local integer steps=0
local integer i=0
local group nearby=CreateGroup()
local unit afterimage
local unit fsQWaveCarrier
local timer fsQCloneTimer
if GetWidgetLife(caster)>.405 then
loop
exitwhen steps>=20
set nx=originX+40.*I2R(steps+1)*Cos(angle)
set ny=originY+40.*I2R(steps+1)*Sin(angle)
exitwhen nx<GetRectMinX(bj_mapInitialPlayableArea)+32. or nx>GetRectMaxX(bj_mapInitialPlayableArea)-32. or ny<GetRectMinY(bj_mapInitialPlayableArea)+32. or ny>GetRectMaxY(bj_mapInitialPlayableArea)-32. or IsTerrainPathable(nx,ny,PATHING_TYPE_WALKABILITY)
call GroupEnumUnitsInRange(nearby,nx,ny,262.5,Condition(function FSQFilter))
call ForGroup(nearby,function FSQDamage)
call GroupClear(nearby)
set steps=steps+1
endloop
if steps==20 then
set nx=originX+840.*Cos(angle)
set ny=originY+840.*Sin(angle)
if nx>=GetRectMinX(bj_mapInitialPlayableArea)+32. and nx<=GetRectMaxX(bj_mapInitialPlayableArea)-32. and ny>=GetRectMinY(bj_mapInitialPlayableArea)+32. and ny<=GetRectMaxY(bj_mapInitialPlayableArea)-32. and not IsTerrainPathable(nx,ny,PATHING_TYPE_WALKABILITY) then
call GroupEnumUnitsInRange(nearby,nx,ny,262.5,Condition(function FSQFilter))
call ForGroup(nearby,function FSQDamage)
call GroupClear(nearby)
endif
endif
if steps>0 then
if landingDistance>40.*I2R(steps) then
set landingDistance=40.*I2R(steps)
endif
if not LoadBoolean(FSHash,GetHandleId(caster),27) then
call SetUnitPosition(caster,originX+landingDistance*Cos(angle),originY+landingDistance*Sin(angle))
endif
loop
exitwhen i>8 or 100.*I2R(i)>40.*I2R(steps)
set nx=originX+100.*I2R(i)*Cos(angle)
set ny=originY+100.*I2R(i)*Sin(angle)
set afterimage=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),'HS04',nx,ny,angle*bj_RADTODEG)
call UnitAddAbility(afterimage,'Aloc')
call UnitAddAbility(afterimage,'Avul')
call SetUnitPathing(afterimage,false)
call SetUnitX(afterimage,nx)
call SetUnitY(afterimage,ny)
call SetUnitVertexColor(afterimage,255,255,255,178)
call SetUnitAnimationByIndex(afterimage,0)
set fsQCloneTimer=CreateTimer()
call SaveUnitHandle(FSHash,GetHandleId(fsQCloneTimer),0,afterimage)
call SaveBoolean(FSHash,GetHandleId(fsQCloneTimer),8,true)
call TimerStart(fsQCloneTimer,.5,false,function FSRelease)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",nx,ny))
set i=i+1
endloop
set fsQWaveCarrier=CreateUnit(GetOwningPlayer(caster),'zZ14',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
call SetUnitScale(fsQWaveCarrier,2.,2.,2.)
call SetUnitFlyHeight(fsQWaveCarrier,50.,0.)
call BvOVfxExpire(fsQWaveCarrier,AddSpecialEffectTarget("FOCSShiki\\asset010.mdx",fsQWaveCarrier,"origin"),1.)
call SetUnitAnimationByIndex(fsQWaveCarrier,90)
// Carrier and attached effect are released together by BvOVfxExpire.
endif
endif
if steps>0 and caster!=null and GetWidgetLife(caster)>.405 and not LoadBoolean(FSHash,GetHandleId(caster),27) then
call SetUnitPathing(caster,true)
call FSQScheduleReturn(caster,originX,originY)
else
if caster!=null and GetWidgetLife(caster)>.405 and not LoadBoolean(FSHash,GetHandleId(caster),27) then
call SetUnitPosition(caster,originX,originY)
endif
call SetUnitPathing(caster,true)
call FSChangeSpellInvulnerability(caster,24,-1)
endif
call DestroyGroup(nearby)
call FSStop(t)
set fsQCloneTimer=null
set fsQWaveCarrier=null
set afterimage=null
set nearby=null
set caster=null
set t=null
endfunction


function FSHasSceptre takes unit hero returns boolean
return UnitHasItemOfTypeBJ(hero,'I03D') or UnitHasItemOfTypeBJ(hero,'I03B') or UnitHasItemOfTypeBJ(hero,'I054') or GetUnitAbilityLevel(hero,OKEN_BLESSING_MARKER)>0
endfunction

function FSPoisonTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer k=GetHandleId(t)
local unit caster=LoadUnitHandle(FSHash,k,0)
local integer ticks=LoadInteger(FSHash,k,5)
if caster==null or ticks>=30 or not FSHasSceptre(caster) then
if caster!=null then
call UnitRemoveAbility(caster,'AS07')
endif
call FSStop(t)
else
call SaveInteger(FSHash,k,5,ticks+1)
endif
set caster=null
set t=null
endfunction

function FSPulse takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer k=GetHandleId(t)
local unit caster=LoadUnitHandle(FSHash,k,0)
local unit victim=LoadUnitHandle(FSHash,k,1)
local integer mode=LoadInteger(FSHash,k,2)
local integer count=LoadInteger(FSHash,k,3)
local integer level
local unit fsWImage
local unit fsWStunDummy
local timer fsWImageTimer
local real fsWOriginX
local real fsWOriginY
local real fsEAngle
local real fsEDistance
local real fsENextX
local real fsENextY
local integer fsEBloodCount
local unit fsEEffectCarrier
local unit fsEStunDummy
local unit fsELead=LoadUnitHandle(FSHash,k,9)
local effect fsEMark=LoadEffectHandle(FSHash,k,10)
local group fsETrail=LoadGroupHandle(FSHash,k,4)
local unit fsETrailUnit
local unit fsRProjectile=LoadUnitHandle(FSHash,k,9)
local effect fsRDaggerEffect=LoadEffectHandle(FSHash,k,10)
local unit fsRImpactImage
local unit fsRDamageDummy
local timer fsRFinishTimer
local timer fsRImageTimer
local real fsRDistance
local integer fsRLevel
local real fsRDamage
if caster==null or victim==null or GetWidgetLife(caster)<=.405 or GetWidgetLife(victim)<=.405 then
if victim!=null then
call PauseUnit(victim,false)
if mode==2 or mode==3 then
call SetUnitInvulnerable(victim,false)
endif
endif
if mode==2 and caster!=null then
call SetUnitVertexColor(caster,255,255,255,255)
call SetUnitPathing(caster,true)
call PauseUnit(caster,false)
endif
if mode==2 and fsELead!=null then
call RemoveUnit(fsELead)
endif
if mode==3 then
call DestroyEffect(fsRDaggerEffect)
if fsRProjectile!=null then
call RemoveUnit(fsRProjectile)
endif
if caster!=null then
call SetUnitVertexColor(caster,255,255,255,255)
call SetUnitPathing(caster,true)
call PauseUnit(caster,false)
endif
endif
if mode==2 then
call DestroyEffect(fsEMark)
if fsETrail!=null then
loop
set fsETrailUnit=FirstOfGroup(fsETrail)
exitwhen fsETrailUnit==null
call GroupRemoveUnit(fsETrail,fsETrailUnit)
call RemoveUnit(fsETrailUnit)
endloop
endif
endif
call FSStop(t)
elseif mode==1 then
if count<8 then
set fsWOriginX=LoadReal(FSHash,k,6)
set fsWOriginY=LoadReal(FSHash,k,7)
call SetUnitAnimation(victim,"death")
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",victim,"chest"))
call SaveInteger(FSHash,k,3,count+1)
else
set level=GetUnitAbilityLevel(caster,'AS02')
call PauseUnit(victim,false)
call SetUnitAnimation(victim,"stand")
call BvOKindSpellDamage(caster,victim,250.+50.*I2R(level)+I2R(GetHeroAgi(caster,false)),true,MAGICAL)
if GetWidgetLife(victim)>.405 then
set fsWStunDummy=CreateUnit(GetOwningPlayer(caster),'zZ01',GetUnitX(victim),GetUnitY(victim),0.)
call UnitAddAbility(fsWStunDummy,'Aloc')
call UnitAddAbility(fsWStunDummy,'AS0W')
call SetUnitAbilityLevel(fsWStunDummy,'AS0W',level)
call IssueTargetOrderById(fsWStunDummy,852095,victim)
call UnitApplyTimedLife(fsWStunDummy,'BTLF',.8)
endif
call FSStop(t)
endif
elseif mode==2 then
call PauseUnit(victim,true)
set fsEAngle=Atan2(GetUnitY(victim)-GetUnitY(caster),GetUnitX(victim)-GetUnitX(caster))
set fsEDistance=SquareRoot((GetUnitX(victim)-GetUnitX(caster))*(GetUnitX(victim)-GetUnitX(caster))+(GetUnitY(victim)-GetUnitY(caster))*(GetUnitY(victim)-GetUnitY(caster)))
if fsEDistance<=50. then
call DestroyEffect(fsEMark)
if fsETrail!=null then
loop
set fsETrailUnit=FirstOfGroup(fsETrail)
exitwhen fsETrailUnit==null
call GroupRemoveUnit(fsETrail,fsETrailUnit)
call RemoveUnit(fsETrailUnit)
endloop
endif
call RemoveUnit(fsELead)
call SetUnitVertexColor(caster,255,255,255,255)
call SetUnitPathing(caster,true)
call PauseUnit(caster,false)
call PauseUnit(victim,false)
call SetUnitInvulnerable(victim,false)
call SetUnitFacing(caster,fsEAngle*bj_RADTODEG)
call PlaySoundBJ(FSEImpactSound)
set fsEEffectCarrier=CreateUnit(GetOwningPlayer(caster),'zZ14',GetUnitX(victim),GetUnitY(victim),fsEAngle*bj_RADTODEG)
call SetUnitScale(fsEEffectCarrier,3.5,3.5,3.5)
call SetUnitFlyHeight(fsEEffectCarrier,100.,0.)
call BvOVfxExpire(fsEEffectCarrier,AddSpecialEffectTarget("FOCSShiki\\asset026.mdx",fsEEffectCarrier,"origin"),1.)
call SetUnitAnimationByIndex(fsEEffectCarrier,90)
// Carrier and attached effect are released together by BvOVfxExpire.
set fsEEffectCarrier=CreateUnit(GetOwningPlayer(caster),'zZ14',GetUnitX(victim),GetUnitY(victim),fsEAngle*bj_RADTODEG)
call SetUnitScale(fsEEffectCarrier,1.5,1.5,1.5)
call SetUnitFlyHeight(fsEEffectCarrier,150.,0.)
call BvOVfxExpire(fsEEffectCarrier,AddSpecialEffectTarget("FOCSShiki\\asset029.mdx",fsEEffectCarrier,"origin"),1.)
call SetUnitAnimationByIndex(fsEEffectCarrier,90)
// Carrier and attached effect are released together by BvOVfxExpire.
set fsEBloodCount=0
loop
exitwhen fsEBloodCount>=3
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",GetUnitX(victim),GetUnitY(victim)))
set fsEBloodCount=fsEBloodCount+1
endloop
set level=GetUnitAbilityLevel(caster,'AS03')
call BvOKindSpellDamage(caster,victim,200.+600.*I2R(level)+.5*I2R(level)*I2R(GetHeroAgi(caster,false)),true,MIXED)
if GetWidgetLife(victim)>.405 then
set fsEStunDummy=CreateUnit(GetOwningPlayer(caster),'zZ01',GetUnitX(victim),GetUnitY(victim),0.)
call UnitAddAbility(fsEStunDummy,'Aloc')
call UnitAddAbility(fsEStunDummy,'AZ04')
call SetUnitAbilityLevel(fsEStunDummy,'AZ04',1)
call IssueTargetOrderById(fsEStunDummy,852095,victim)
call UnitApplyTimedLife(fsEStunDummy,'BTLF',.8)
endif
call FSStop(t)
elseif count>=50 then
call DestroyEffect(fsEMark)
call SetUnitInvulnerable(victim,false)
if fsETrail!=null then
loop
set fsETrailUnit=FirstOfGroup(fsETrail)
exitwhen fsETrailUnit==null
call GroupRemoveUnit(fsETrail,fsETrailUnit)
call RemoveUnit(fsETrailUnit)
endloop
endif
call RemoveUnit(fsELead)
call SetUnitVertexColor(caster,255,255,255,255)
call SetUnitPathing(caster,true)
call PauseUnit(caster,false)
call PauseUnit(victim,false)
call FSStop(t)
else
set fsENextX=GetUnitX(caster)+15.*Cos(fsEAngle)
set fsENextY=GetUnitY(caster)+15.*Sin(fsEAngle)
if not FSPointWalkable(fsENextX,fsENextY) then
call DestroyEffect(fsEMark)
call SetUnitInvulnerable(victim,false)
if fsETrail!=null then
loop
set fsETrailUnit=FirstOfGroup(fsETrail)
exitwhen fsETrailUnit==null
call GroupRemoveUnit(fsETrail,fsETrailUnit)
call RemoveUnit(fsETrailUnit)
endloop
endif
call RemoveUnit(fsELead)
call SetUnitVertexColor(caster,255,255,255,255)
call SetUnitPathing(caster,true)
call PauseUnit(caster,false)
call PauseUnit(victim,false)
call FSStop(t)
else
call SetUnitPosition(caster,fsENextX,fsENextY)
call SetUnitPosition(fsELead,fsENextX,fsENextY)
call SetUnitFacing(fsELead,fsEAngle*bj_RADTODEG)
call SetUnitAnimation(fsELead,"walk")
call SetUnitFacing(caster,fsEAngle*bj_RADTODEG)
if ModuloInteger(count,5)==2 or ModuloInteger(count,5)==4 then
set fsWImage=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),'HS01',fsENextX,fsENextY,fsEAngle*bj_RADTODEG)
call UnitAddAbility(fsWImage,'Aloc')
call UnitAddAbility(fsWImage,'Avul')
call SetUnitPathing(fsWImage,false)
call SetUnitPosition(fsWImage,fsENextX,fsENextY)
call SetUnitVertexColor(fsWImage,255,255,255,178)
call SetUnitTimeScale(fsWImage,.5)
call SetUnitAnimation(fsWImage,"walk")
call GroupAddUnit(fsETrail,fsWImage)
endif
call SaveInteger(FSHash,k,3,count+1)
endif
endif
else
call PauseUnit(victim,true)
set fsRDistance=SquareRoot((GetUnitX(victim)-GetUnitX(fsRProjectile))*(GetUnitX(victim)-GetUnitX(fsRProjectile))+(GetUnitY(victim)-GetUnitY(fsRProjectile))*(GetUnitY(victim)-GetUnitY(fsRProjectile)))
if fsRDistance<=80. then
call PlaySoundBJ(FSRHitSound)
call SetUnitPathing(caster,false)
call SetUnitPosition(caster,GetUnitX(fsRProjectile),GetUnitY(fsRProjectile))
call PauseUnit(victim,false)
call SetUnitInvulnerable(victim,false)
call DestroyEffect(fsRDaggerEffect)
call RemoveUnit(fsRProjectile)
set fsRImpactImage=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),'HS02',GetUnitX(victim),GetUnitY(victim),Atan2(GetUnitY(victim)-GetUnitY(caster),GetUnitX(victim)-GetUnitX(caster))*bj_RADTODEG)
call UnitAddAbility(fsRImpactImage,'Aloc')
call UnitAddAbility(fsRImpactImage,'Avul')
call SetUnitPathing(fsRImpactImage,false)
call SetUnitAnimation(fsRImpactImage,"attack")
set fsRImageTimer=CreateTimer()
call SaveUnitHandle(FSHash,GetHandleId(fsRImageTimer),0,fsRImpactImage)
call SaveBoolean(FSHash,GetHandleId(fsRImageTimer),8,true)
call TimerStart(fsRImageTimer,.5,false,function FSRelease)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",victim,"chest"))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",GetUnitX(victim),GetUnitY(victim)))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",GetUnitX(victim),GetUnitY(victim)))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",GetUnitX(victim),GetUnitY(victim)))
set fsRLevel=GetUnitAbilityLevel(caster,'AS04')
set fsRDamageDummy=CreateUnit(GetOwningPlayer(caster),'zZ01',GetUnitX(victim),GetUnitY(victim),0.)
call UnitAddAbility(fsRDamageDummy,'Aloc')
call UnitAddAbility(fsRDamageDummy,'AS08')
call SetUnitAbilityLevel(fsRDamageDummy,'AS08',fsRLevel)
call IssueTargetOrderById(fsRDamageDummy,852095,victim)
call UnitApplyTimedLife(fsRDamageDummy,'BTLF',.8)
set fsRDamage=FSRDamageBase(fsRLevel)
if GetUnitTypeId(victim)!='Osam' and GetRandomInt(1,100)<=10 then
set fsRDamage=3.*fsRDamage
endif
call BvOHeroSpellDamage(caster,victim,fsRDamage,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_FIRE)
set fsRFinishTimer=CreateTimer()
call SaveUnitHandle(FSHash,GetHandleId(fsRFinishTimer),0,caster)
call SaveBoolean(FSHash,GetHandleId(fsRFinishTimer),12,true)
call TimerStart(fsRFinishTimer,.5,false,function FSRelease)
call FSStop(t)
elseif count>=60 then
call SetUnitInvulnerable(victim,false)
call DestroyEffect(fsRDaggerEffect)
call RemoveUnit(fsRProjectile)
call SetUnitVertexColor(caster,255,255,255,255)
call PauseUnit(caster,false)
call PauseUnit(victim,false)
call FSStop(t)
else
set fsEAngle=Atan2(GetUnitY(victim)-GetUnitY(fsRProjectile),GetUnitX(victim)-GetUnitX(fsRProjectile))
set fsENextX=GetUnitX(fsRProjectile)+40.*Cos(fsEAngle)
set fsENextY=GetUnitY(fsRProjectile)+40.*Sin(fsEAngle)
if not FSPointWalkable(fsENextX,fsENextY) then
call SetUnitInvulnerable(victim,false)
call DestroyEffect(fsRDaggerEffect)
call RemoveUnit(fsRProjectile)
call SetUnitVertexColor(caster,255,255,255,255)
call PauseUnit(caster,false)
call PauseUnit(victim,false)
call FSStop(t)
else
call SetUnitPosition(fsRProjectile,fsENextX,fsENextY)
call SetUnitFacing(fsRProjectile,fsEAngle*bj_RADTODEG)
call DestroyEffect(fsRDaggerEffect)
call SaveEffectHandle(FSHash,k,10,AddSpecialEffect("Abilities\\Weapons\\WardenMissile\\WardenMissile.mdl",fsENextX,fsENextY))
call SaveInteger(FSHash,k,3,count+1)
endif
endif
endif
set fsWImageTimer=null
set fsWImage=null
set fsEEffectCarrier=null
set fsELead=null
set fsEMark=null
set fsETrail=null
set fsETrailUnit=null
set fsEStunDummy=null
set fsRProjectile=null
set fsRDaggerEffect=null
set fsRImpactImage=null
set fsRDamageDummy=null
set fsRFinishTimer=null
set fsRImageTimer=null
set fsWStunDummy=null
set caster=null
set victim=null
set t=null
endfunction

function FSCast takes nothing returns nothing
local integer spell=GetSpellAbilityId()
local unit caster=GetTriggerUnit()
local unit victim=GetSpellTargetUnit()
local timer t
local integer k
local unit fsQEffectCarrier
local unit fsWEffectCarrier
local real fsWAngle
local unit fsEEffectCarrier
local unit fsELead
local unit fsRProjectile
local real fsRAngle
local integer fsComboId
local integer fsComboStage
local real fsComboBonus=0.
local real fsComboWindow=0.
local timer fsComboTimer
if not SilenceConditions(caster) then
set caster=null
set victim=null
return
endif
if GetUnitTypeId(caster)!='HS00' then
set caster=null
set victim=null
return
endif
if spell=='AS03' or spell=='AS04' then
call FSQCancelReturn(caster)
call SaveBoolean(FSHash,GetHandleId(caster),27,true)
elseif spell=='AS01' then
call SaveBoolean(FSHash,GetHandleId(caster),27,false)
endif
if FSHasSceptre(caster) and not BvOPassivesBroken(caster) and (spell=='AS01' or spell=='AS02' or spell=='AS03' or spell=='AS04') then
set fsComboId=GetHandleId(caster)
set fsComboStage=LoadInteger(FSHash,fsComboId,22)
if spell=='AS01' then
set fsComboStage=1
set fsComboWindow=1.
elseif spell=='AS03' and fsComboStage==1 then
set fsComboBonus=5.*I2R(GetHeroAgi(caster,true))
set fsComboStage=2
set fsComboWindow=2.
elseif spell=='AS02' and fsComboStage==2 then
set fsComboBonus=7.5*I2R(GetHeroAgi(caster,true))
set fsComboStage=3
set fsComboWindow=1.
elseif spell=='AS04' and fsComboStage==3 then
set fsComboBonus=15.*I2R(GetHeroAgi(caster,true))
set fsComboStage=0
elseif spell=='AS02' and fsComboStage==1 then
set fsComboBonus=3.*I2R(GetHeroAgi(caster,true))
set fsComboStage=0
elseif spell=='AS04' and fsComboStage==1 then
set fsComboBonus=5.*I2R(GetHeroAgi(caster,true))
set fsComboStage=0
else
set fsComboStage=0
endif
if fsComboBonus>0. and victim!=null and IsUnitEnemy(victim,GetOwningPlayer(caster)) then
call BvOKindSpellDamage(caster,victim,fsComboBonus,true,CLEAN)
call CreateTextTagUnitBJ("Combo Damage "+I2S(R2I(fsComboBonus)),caster,0.,10.,100.,100.,0.,0.)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,2.5)
call SetTextTagFadepointBJ(bj_lastCreatedTextTag,2.)
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,64.,90.)
endif
set fsComboTimer=LoadTimerHandle(FSHash,fsComboId,21)
if fsComboTimer!=null then
call FSStop(fsComboTimer)
endif
call SaveInteger(FSHash,fsComboId,22,fsComboStage)
if fsComboStage>0 then
set fsComboTimer=CreateTimer()
call SaveTimerHandle(FSHash,fsComboId,21,fsComboTimer)
call SaveInteger(FSHash,GetHandleId(fsComboTimer),13,fsComboId)
call SaveBoolean(FSHash,GetHandleId(fsComboTimer),14,true)
call TimerStart(fsComboTimer,fsComboWindow,false,function FSRelease)
else
call RemoveSavedHandle(FSHash,fsComboId,21)
endif
endif
if spell=='AS00' then
if FSHasSceptre(caster) then
call UnitAddAbility(caster,'AS07')
set t=CreateTimer()
call SaveUnitHandle(FSHash,GetHandleId(t),0,caster)
call TimerStart(t,.2,true,function FSPoisonTick)
endif
elseif spell=='AS01' then
call FSChangeSpellInvulnerability(caster,24,1)
call PlaySoundBJ(FSQVoice)
set fsQEffectCarrier=CreateUnit(GetOwningPlayer(caster),'zZ14',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
call BvOVfxExpire(fsQEffectCarrier,AddSpecialEffectTarget("FOCSShiki\\asset005.mdx",fsQEffectCarrier,"origin"),1.)
call SetUnitAnimationByIndex(fsQEffectCarrier,90)
// Carrier and attached effect are released together by BvOVfxExpire.
set fsQEffectCarrier=CreateUnit(GetOwningPlayer(caster),'zZ14',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
call BvOVfxExpire(fsQEffectCarrier,AddSpecialEffectTarget("FOCSShiki\\asset009.mdx",fsQEffectCarrier,"origin"),1.)
call SetUnitAnimationByIndex(fsQEffectCarrier,90)
// Carrier and attached effect are released together by BvOVfxExpire.
set fsQEffectCarrier=CreateUnit(GetOwningPlayer(caster),'zZ14',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
call SetUnitFlyHeight(fsQEffectCarrier,100.,0.)
call SetUnitScale(fsQEffectCarrier,2.,2.,2.)
call BvOVfxExpire(fsQEffectCarrier,AddSpecialEffectTarget("FOCSShiki\\asset003.mdx",fsQEffectCarrier,"origin"),1.)
call SetUnitAnimationByIndex(fsQEffectCarrier,90)
// Carrier and attached effect are released together by BvOVfxExpire.
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(caster),GetUnitY(caster)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",GetUnitX(caster),GetUnitY(caster)))
set t=CreateTimer()
set k=GetHandleId(t)
call SaveUnitHandle(FSHash,k,0,caster)
call SetUnitPathing(caster,false)
call SaveReal(FSHash,k,1,Atan2(GetSpellTargetY()-GetUnitY(caster),GetSpellTargetX()-GetUnitX(caster)))
call SaveReal(FSHash,k,6,GetUnitX(caster))
call SaveReal(FSHash,k,7,GetUnitY(caster))
call SaveReal(FSHash,k,8,SquareRoot((GetSpellTargetX()-GetUnitX(caster))*(GetSpellTargetX()-GetUnitX(caster))+(GetSpellTargetY()-GetUnitY(caster))*(GetSpellTargetY()-GetUnitY(caster))))
call SaveGroupHandle(FSHash,k,4,CreateGroup())
call SetUnitFacing(caster,Atan2(GetSpellTargetY()-GetUnitY(caster),GetSpellTargetX()-GetUnitX(caster))*bj_RADTODEG)
call TimerStart(t,.2,false,function FSQTick)
elseif spell=='AS02' or spell=='AS03' then
if victim!=null and IsUnitEnemy(victim,GetOwningPlayer(caster)) then
set t=CreateTimer()
set k=GetHandleId(t)
call SaveUnitHandle(FSHash,k,0,caster)
call SaveUnitHandle(FSHash,k,1,victim)
if spell=='AS02' then
call SaveInteger(FSHash,k,2,1)
call PlaySoundBJ(FSWSound)
call PauseUnit(victim,true)
call SetUnitAnimation(victim,"death")
call SaveReal(FSHash,k,6,GetUnitX(caster))
call SaveReal(FSHash,k,7,GetUnitY(caster))
set fsWAngle=Atan2(GetUnitY(victim)-GetUnitY(caster),GetUnitX(victim)-GetUnitX(caster))
set fsWEffectCarrier=CreateUnit(GetOwningPlayer(caster),'zZ14',GetUnitX(caster),GetUnitY(caster),fsWAngle*bj_RADTODEG)
call SetUnitScale(fsWEffectCarrier,2.,2.,2.)
call BvOVfxExpire(fsWEffectCarrier,AddSpecialEffectTarget("FOCSShiki\\asset019.mdx",fsWEffectCarrier,"origin"),1.)
call SetUnitAnimationByIndex(fsWEffectCarrier,90)
// Carrier and attached effect are released together by BvOVfxExpire.
set fsWEffectCarrier=CreateUnit(GetOwningPlayer(caster),'zZ14',GetUnitX(caster)-150.*Cos(fsWAngle),GetUnitY(caster)-150.*Sin(fsWAngle),fsWAngle*bj_RADTODEG)
call SetUnitScale(fsWEffectCarrier,2.5,2.5,2.5)
call SetUnitFlyHeight(fsWEffectCarrier,50.,0.)
call BvOVfxExpire(fsWEffectCarrier,AddSpecialEffectTarget("FOCSShiki\\asset007.mdx",fsWEffectCarrier,"origin"),1.)
call SetUnitAnimationByIndex(fsWEffectCarrier,90)
// Carrier and attached effect are released together by BvOVfxExpire.
set fsWEffectCarrier=CreateUnit(GetOwningPlayer(caster),'zZ14',GetUnitX(caster),GetUnitY(caster),fsWAngle*bj_RADTODEG)
call SetUnitScale(fsWEffectCarrier,2.5,2.5,2.5)
call SetUnitFlyHeight(fsWEffectCarrier,100.,0.)
call BvOVfxExpire(fsWEffectCarrier,AddSpecialEffectTarget("FOCSShiki\\asset021.mdx",fsWEffectCarrier,"origin"),1.)
call SetUnitAnimationByIndex(fsWEffectCarrier,90)
// Carrier and attached effect are released together by BvOVfxExpire.
else
call SaveInteger(FSHash,k,2,2)
call FSChangeSpellInvulnerability(caster,25,1)
call SaveGroupHandle(FSHash,k,4,CreateGroup())
call PlaySoundBJ(FSEStartSound)
call PauseUnit(caster,true)
call PauseUnit(victim,true)
call SetUnitInvulnerable(victim,true)
call SaveEffectHandle(FSHash,k,10,AddSpecialEffectTarget("Abilities\\Spells\\Other\\SoulBurn\\SoulBurnbuff.mdl",victim,"overhead"))
set fsWAngle=Atan2(GetUnitY(victim)-GetUnitY(caster),GetUnitX(victim)-GetUnitX(caster))
call SetUnitFacing(caster,fsWAngle*bj_RADTODEG)
set fsEEffectCarrier=CreateUnit(GetOwningPlayer(caster),'zZ14',GetUnitX(caster),GetUnitY(caster),fsWAngle*bj_RADTODEG)
call BvOVfxExpire(fsEEffectCarrier,AddSpecialEffectTarget("FOCSShiki\\asset003.mdx",fsEEffectCarrier,"origin"),1.)
call SetUnitAnimationByIndex(fsEEffectCarrier,90)
// Carrier and attached effect are released together by BvOVfxExpire.
set fsEEffectCarrier=CreateUnit(GetOwningPlayer(caster),'zZ14',GetUnitX(caster),GetUnitY(caster),fsWAngle*bj_RADTODEG)
call BvOVfxExpire(fsEEffectCarrier,AddSpecialEffectTarget("FOCSShiki\\asset009.mdx",fsEEffectCarrier,"origin"),1.)
call SetUnitAnimationByIndex(fsEEffectCarrier,90)
// Carrier and attached effect are released together by BvOVfxExpire.
call SetUnitPathing(caster,false)
call SetUnitVertexColor(caster,255,255,255,0)
set fsELead=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),'HS01',GetUnitX(caster),GetUnitY(caster),fsWAngle*bj_RADTODEG)
call UnitAddAbility(fsELead,'Aloc')
call UnitAddAbility(fsELead,'Avul')
call SetUnitPathing(fsELead,false)
call SetUnitAnimation(fsELead,"walk")
call IssueTargetOrderById(fsELead,851983,victim)
call SaveUnitHandle(FSHash,k,9,fsELead)
endif
if spell=='AS03' then
call TimerStart(t,.04,true,function FSPulse)
else
call TimerStart(t,.0833333,true,function FSPulse)
endif
endif
elseif spell=='AS04' then
if victim!=null and IsUnitEnemy(victim,GetOwningPlayer(caster)) then
call PlaySoundBJ(FSRStartSound)
call PauseUnit(caster,true)
call PauseUnit(victim,true)
call SetUnitInvulnerable(victim,true)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(caster),GetUnitY(caster)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",GetUnitX(caster),GetUnitY(caster)))
set fsRAngle=Atan2(GetUnitY(victim)-GetUnitY(caster),GetUnitX(victim)-GetUnitX(caster))
set fsRProjectile=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),'HS03',GetUnitX(caster),GetUnitY(caster),fsRAngle*bj_RADTODEG)
call SetUnitScale(fsRProjectile,2.,2.,2.)
call SetUnitFlyHeight(fsRProjectile,100.,0.)
call SetUnitPathing(fsRProjectile,false)
call SetUnitVertexColor(caster,255,255,255,0)
set t=CreateTimer()
set k=GetHandleId(t)
call SaveUnitHandle(FSHash,k,0,caster)
call SaveUnitHandle(FSHash,k,1,victim)
call SaveUnitHandle(FSHash,k,9,fsRProjectile)
call SaveEffectHandle(FSHash,k,10,AddSpecialEffect("Abilities\\Weapons\\WardenMissile\\WardenMissile.mdl",GetUnitX(fsRProjectile),GetUnitY(fsRProjectile)))
call SaveInteger(FSHash,k,2,3)
call TimerStart(t,.02,true,function FSPulse)
endif
endif
set t=null
set caster=null
set victim=null
set fsQEffectCarrier=null
set fsWEffectCarrier=null
set fsEEffectCarrier=null
set fsELead=null
set fsRProjectile=null
set fsComboTimer=null
endfunction

function FSOnKill takes nothing returns nothing
local unit dying=GetTriggerUnit()
local unit killer=GetKillingUnit()
local unit hero
local group owned
local integer deadType=GetUnitTypeId(dying)
if killer!=null and IsUnitEnemy(dying,GetOwningPlayer(killer)) and (IsUnitType(dying,UNIT_TYPE_HERO) or deadType=='n00F' or deadType=='n00L' or deadType=='n00K' or deadType=='n00J' or deadType=='n00I' or deadType=='n00H' or deadType=='n00G' or deadType=='n00E' or deadType=='n010' or deadType=='n011' or deadType=='n012' or deadType=='nfgl') then
set owned=CreateGroup()
call GroupEnumUnitsOfPlayer(owned,GetOwningPlayer(killer),null)
loop
set hero=FirstOfGroup(owned)
exitwhen hero==null
call GroupRemoveUnit(owned,hero)
if GetUnitTypeId(hero)=='HS00' and GetWidgetLife(hero)>.405 and FSHasSceptre(hero) and not BvOPassivesBroken(hero) then
call ModifyHeroStat(bj_HEROSTAT_AGI,hero,bj_MODIFYMETHOD_ADD,5)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl",hero,"origin"))
exitwhen true
endif
endloop
call DestroyGroup(owned)
endif
set dying=null
set killer=null
set hero=null
set owned=null
endfunction

function FSInit takes nothing returns nothing
local trigger tr=CreateTrigger()
local trigger fsKillTrigger=CreateTrigger()
local trigger fsReachTrigger=CreateTrigger()
local integer fsPlayerIndex=0
set FSHash=InitHashtable()
call TriggerRegisterAnyUnitEventBJ(fsReachTrigger,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(fsReachTrigger,Condition(function FSCheckTargetReachable))
set fsReachTrigger=null
loop
exitwhen fsPlayerIndex>=16
call SetPlayerAbilityAvailable(Player(fsPlayerIndex),'AS07',false)
set fsPlayerIndex=fsPlayerIndex+1
endloop
set FSQVoice=CreateSound("FOCSShiki\\asset004.wav",false,false,false,10,10,"")
call SetSoundDuration(FSQVoice,529)
call SetSoundChannel(FSQVoice,0)
call SetSoundVolume(FSQVoice,127)
call SetSoundPitch(FSQVoice,1.)
set FSWSound=CreateSound("FOCSShiki\\asset018.mp3",false,false,false,10,10,"")
call SetSoundDuration(FSWSound,653)
call SetSoundChannel(FSWSound,0)
call SetSoundVolume(FSWSound,127)
call SetSoundPitch(FSWSound,1.)
set FSEStartSound=CreateSound("FOCSShiki\\asset024.mp3",false,false,false,10,10,"")
call SetSoundDuration(FSEStartSound,522)
call SetSoundChannel(FSEStartSound,0)
call SetSoundVolume(FSEStartSound,127)
call SetSoundPitch(FSEStartSound,1.)
set FSEImpactSound=CreateSound("FOCSShiki\\asset025.mp3",false,false,false,10,10,"")
call SetSoundDuration(FSEImpactSound,693)
call SetSoundChannel(FSEImpactSound,0)
call SetSoundVolume(FSEImpactSound,127)
call SetSoundPitch(FSEImpactSound,1.)
set FSRStartSound=CreateSound("FOCSShiki\\asset031.mp3",false,false,false,10,10,"")
call SetSoundDuration(FSRStartSound,333)
call SetSoundChannel(FSRStartSound,0)
call SetSoundVolume(FSRStartSound,127)
call SetSoundPitch(FSRStartSound,1.)
set FSRHitSound=CreateSound("FOCSShiki\\asset032.mp3",false,false,false,10,10,"")
call SetSoundDuration(FSRHitSound,346)
call SetSoundChannel(FSRHitSound,0)
call SetSoundVolume(FSRHitSound,127)
call SetSoundPitch(FSRHitSound,1.)
call TriggerRegisterAnyUnitEventBJ(tr,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(tr,function FSCast)
call TriggerRegisterAnyUnitEventBJ(fsKillTrigger,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(fsKillTrigger,function FSOnKill)
set fsKillTrigger=null
set tr=null
endfunction

function ULQ_GetDummy takes integer ulquiorraPlayerIndex returns unit
if LoadUnitHandle(ULQ_HashTable,-12003,ulquiorraPlayerIndex)==null then
call SaveUnitHandle(ULQ_HashTable,-12003,ulquiorraPlayerIndex,CreateUnit(Player(ulquiorraPlayerIndex),'j000',1.,1.,0.))
endif
return LoadUnitHandle(ULQ_HashTable,-12003,ulquiorraPlayerIndex)
endfunction
function ULQ_GetAxisAngle takes real ulquiorraSourceX,real ulquiorraSourceY,real ulquiorraDestinationX,real ulquiorraDestinationY returns real
return Rad2Deg(Atan2(ulquiorraDestinationY-ulquiorraSourceY,ulquiorraDestinationX-ulquiorraSourceX))
endfunction
function ULQ_GetUnitsAngle takes unit ulquiorraSourceUnit,unit ulquiorraTargetUnit returns real
return ULQ_GetAxisAngle(GetUnitX(ulquiorraSourceUnit),GetUnitY(ulquiorraSourceUnit),GetUnitX(ulquiorraTargetUnit),GetUnitY(ulquiorraTargetUnit))
endfunction
function ULQ_UnitLife takes unit ulquiorraTargetUnit returns real
return GetUnitState(ulquiorraTargetUnit,UNIT_STATE_LIFE)
endfunction
function ULQ_SetUnitXY takes unit ulquiorraTargetUnit,real ulquiorraDestinationX,real ulquiorraDestinationY returns nothing
if GetUnitMoveSpeed(ulquiorraTargetUnit)>0 then
call SetUnitX(ulquiorraTargetUnit,ulquiorraDestinationX)
call SetUnitY(ulquiorraTargetUnit,ulquiorraDestinationY)
else
call SetUnitPosition(ulquiorraTargetUnit,ulquiorraDestinationX,ulquiorraDestinationY)
endif
endfunction
function ULQ_SetUnitXY_1 takes unit ulquiorraTargetUnit,real ulquiorraDestinationX,real ulquiorraDestinationY,boolean ulquiorraPathingEnabled returns nothing
if ulquiorraPathingEnabled and IsTerrainPathable(ulquiorraDestinationX,ulquiorraDestinationY,PATHING_TYPE_WALKABILITY)then
return
endif
call ULQ_SetUnitXY(ulquiorraTargetUnit,ulquiorraDestinationX,ulquiorraDestinationY)
endfunction
function ULQ_PlaySoundOnUnit takes sound ulquiorraSoundHandle,real ulquiorraVolumePercent,unit ulquiorraAffectedUnit returns nothing
if ulquiorraSoundHandle==null then
return
endif
call SetSoundPosition(ulquiorraSoundHandle,GetUnitX(ulquiorraAffectedUnit),GetUnitY(ulquiorraAffectedUnit),0)
call SetSoundVolume(ulquiorraSoundHandle,PercentToInt(ulquiorraVolumePercent,127))
if ulquiorraSoundHandle!=null then
call StartSound(ulquiorraSoundHandle)
endif
endfunction
function ULQ_PlayRandomVoice takes unit ulquiorraHero,integer ulquiorraFirstVoice,integer ulquiorraLastVoice returns nothing
local integer ulquiorraVoiceSlot=GetRandomInt(ulquiorraFirstVoice,ulquiorraLastVoice)
call ULQ_PlaySoundOnUnit(LoadSoundHandle(ULQ_HashTable,-12002,ulquiorraVoiceSlot),100,ulquiorraHero)
endfunction
function ULQ_NewMUITimer takes integer ulquiorraPlayerId returns integer
local integer MaxTimer=100
local integer Iterator=LoadInteger(ULQ_HashTable,GetHandleId(Player(ulquiorraPlayerId)),StringHash("TimerIterator"))
loop
exitwhen not LoadBoolean(ULQ_HashTable,GetHandleId(LoadTimerHandle(ULQ_HashTable,GetHandleId(Player(ulquiorraPlayerId)),StringHash("Timer_Num_"+I2S(Iterator)))),StringHash("TimerStarted"))and Iterator<=MaxTimer
if Iterator>MaxTimer then
set Iterator=0
else
set Iterator=Iterator+1
endif
endloop
call SaveInteger(ULQ_HashTable,GetHandleId(Player(ulquiorraPlayerId)),StringHash("TimerIterator"),Iterator)
if LoadTimerHandle(ULQ_HashTable,GetHandleId(Player(ulquiorraPlayerId)),StringHash("Timer_Num_"+I2S(Iterator)))==null then
call SaveTimerHandle(ULQ_HashTable,GetHandleId(Player(ulquiorraPlayerId)),StringHash("Timer_Num_"+I2S(Iterator)),CreateTimer())
endif
return GetHandleId(LoadTimerHandle(ULQ_HashTable,GetHandleId(Player(ulquiorraPlayerId)),StringHash("Timer_Num_"+I2S(Iterator))))
endfunction
function ULQ_LoadMUITimer takes integer ulquiorraPlayerId returns timer
local integer Iterator=LoadInteger(ULQ_HashTable,GetHandleId(Player(ulquiorraPlayerId)),StringHash("TimerIterator"))
call SaveBoolean(ULQ_HashTable,GetHandleId(LoadTimerHandle(ULQ_HashTable,GetHandleId(Player(ulquiorraPlayerId)),StringHash("Timer_Num_"+I2S(Iterator)))),StringHash("TimerStarted"),true)
return LoadTimerHandle(ULQ_HashTable,GetHandleId(Player(ulquiorraPlayerId)),StringHash("Timer_Num_"+I2S(Iterator)))
endfunction
function ULQ_TimerPause takes timer ulquiorraActionTimer returns nothing
if LoadBoolean(ULQ_HashTable,GetHandleId(ulquiorraActionTimer),StringHash("TimerStarted"))then
call PauseTimer(ulquiorraActionTimer)
call SaveBoolean(ULQ_HashTable,GetHandleId(ulquiorraActionTimer),StringHash("TimerStarted"),false)
endif
endfunction
function ULQ_CleanMUI takes timer ulquiorraActionTimer returns nothing
call ULQ_TimerPause(ulquiorraActionTimer)
call FlushChildHashtable(ULQ_HashTable,GetHandleId(ulquiorraActionTimer))
endfunction
function ULQ_MUIHandle takes nothing returns integer
return GetHandleId(GetExpiredTimer())
endfunction
function ULQ_GetUnit takes string ulquiorraStateKey returns unit
return LoadUnitHandle(ULQ_HashTable,ULQ_MUIHandle(),StringHash(ulquiorraStateKey))
endfunction
