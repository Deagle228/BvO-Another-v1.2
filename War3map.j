function SHArmorCheck takes nothing returns nothing
local timer checkTimer=GetExpiredTimer()
local integer key=GetHandleId(checkTimer)
local unit holder=LoadUnitHandle(Hash,key,0)
call RemoveSavedHandle(Hash,GetHandleId(holder),StringHash("SHArmorTimer"))
if holder!=null and GetUnitTypeId(holder)!=0 then
if UnitHasItemOfTypeBJ(holder,'I01T') then
if GetUnitAbilityLevel(holder,'SHAR')==0 then
call UnitAddAbility(holder,'SHAR')
call UnitMakeAbilityPermanent(holder,true,'SHAR')
endif
elseif GetUnitAbilityLevel(holder,'SHAR')>0 then
call UnitRemoveAbility(holder,'SHAR')
endif
endif
call FlushChildHashtable(Hash,key)
call DestroyTimer(checkTimer)
set holder=null
set checkTimer=null
endfunction
function SHQueueArmor takes unit holder returns nothing
local timer checkTimer
if holder==null or LoadTimerHandle(Hash,GetHandleId(holder),StringHash("SHArmorTimer"))!=null then
return
endif
set checkTimer=CreateTimer()
call SaveTimerHandle(Hash,GetHandleId(holder),StringHash("SHArmorTimer"),checkTimer)
call SaveUnitHandle(Hash,GetHandleId(checkTimer),0,holder)
call TimerStart(checkTimer,0.,false,function SHArmorCheck)
set checkTimer=null
endfunction
function SHInventory takes nothing returns nothing
if GetItemTypeId(GetManipulatedItem())=='I01T' then
call SHQueueArmor(GetManipulatingUnit())
endif
endfunction
function SHCraft takes nothing returns nothing
local timer craftTimer=GetExpiredTimer()
local integer key=GetHandleId(craftTimer)
local unit holder=LoadUnitHandle(Hash,key,0)
local item sphere=LoadItemHandle(Hash,key,1)
local item hood=LoadItemHandle(Hash,key,2)
local item recipe=LoadItemHandle(Hash,key,3)
if holder!=null and GetUnitTypeId(holder)!=0 and not UnitHasItemOfTypeBJ(holder,'I01T') and GetItemTypeId(sphere)=='I007' and GetItemTypeId(hood)=='I01Q' and GetItemTypeId(recipe)=='I02C' and UnitHasItem(holder,sphere) and UnitHasItem(holder,hood) and (UnitHasItem(holder,recipe) or (LoadBoolean(Hash,key,4) and not IsItemOwned(recipe))) then
// Resolve inventory replacement outside pickup/sell events in Warcraft1.26.
call RemoveItem(sphere)
call RemoveItem(hood)
call RemoveItem(recipe)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",holder,"origin"))
call UnitAddItemByIdSwapped('I01T',holder)
call SHQueueArmor(holder)
elseif LoadBoolean(Hash,key,4) and GetItemTypeId(recipe)=='I02C' then
// A shop receipt held aside for a full inventory remains available if the craft was cancelled.
call SetItemVisible(recipe,true)
call SetItemPosition(recipe,GetUnitX(holder),GetUnitY(holder))
endif
call RemoveSavedHandle(Hash,GetHandleId(holder),StringHash("SHCraftTimer"))
call FlushChildHashtable(Hash,key)
call DestroyTimer(craftTimer)
set holder=null
set sphere=null
set hood=null
set recipe=null
set craftTimer=null
endfunction
function SHQueueCraftReceipt takes unit holder,item recipe,boolean shopReceipt returns nothing
local timer craftTimer
if holder==null or UnitHasItemOfTypeBJ(holder,'I01T') or LoadTimerHandle(Hash,GetHandleId(holder),StringHash("SHCraftTimer"))!=null or not UnitHasItemOfTypeBJ(holder,'I007') or not UnitHasItemOfTypeBJ(holder,'I01Q') or GetItemTypeId(recipe)!='I02C' then
return
endif
set craftTimer=CreateTimer()
call SaveTimerHandle(Hash,GetHandleId(holder),StringHash("SHCraftTimer"),craftTimer)
call SaveUnitHandle(Hash,GetHandleId(craftTimer),0,holder)
call SaveItemHandle(Hash,GetHandleId(craftTimer),1,GetItemOfTypeFromUnitBJ(holder,'I007'))
call SaveItemHandle(Hash,GetHandleId(craftTimer),2,GetItemOfTypeFromUnitBJ(holder,'I01Q'))
call SaveItemHandle(Hash,GetHandleId(craftTimer),3,recipe)
call SaveBoolean(Hash,GetHandleId(craftTimer),4,shopReceipt)
if shopReceipt then
call SetItemVisible(recipe,false)
endif
call TimerStart(craftTimer,0.,false,function SHCraft)
set craftTimer=null
endfunction
function SHQueueCraft takes unit holder returns nothing
if UnitHasItemOfTypeBJ(holder,'I02C') then
call SHQueueCraftReceipt(holder,GetItemOfTypeFromUnitBJ(holder,'I02C'),false)
endif
endfunction
function SHBuyRecipe takes unit holder returns nothing
local item recipe=CreateItem('I02C',GetUnitX(holder),GetUnitY(holder))
if not UnitAddItem(holder,recipe) then
call SHQueueCraftReceipt(holder,recipe,true)
endif
set recipe=null
endfunction
