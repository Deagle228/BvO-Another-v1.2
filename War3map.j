local integer bvo33Local1_ownerId=GetPlayerId(GetOwningPlayer(bvo33Local1_caster))
call SaveStr(MVHash,bvo33Local1_ownerId,901,bvo33Local1_stage)
if LoadBoolean(MVHash,bvo33Local1_ownerId,900) then
call DisplayTimedTextToPlayer(GetOwningPlayer(bvo33Local1_caster),0.,0.,12.,"Sasuke V: "+bvo33Local1_stage)
endif
endfunction
function MVChat takes nothing returns nothing
local player bvo33Local2_owner=GetTriggerPlayer()
local integer bvo33Local2_ownerId=GetPlayerId(bvo33Local2_owner)
local boolean bvo33Local2_enabled=not LoadBoolean(MVHash,bvo33Local2_ownerId,900)
local unit bvo33Local2_hero=m[bvo33Local2_ownerId+1]
call SaveBoolean(MVHash,bvo33Local2_ownerId,900,bvo33Local2_enabled)
if bvo33Local2_enabled then
call DisplayTimedTextToPlayer(bvo33Local2_owner,0.,0.,15.,"Sasuke V trace ON. Cast Susanoo, then V on an enemy.")
else
call DisplayTimedTextToPlayer(bvo33Local2_owner,0.,0.,8.,"Sasuke V trace OFF.")
endif
call DisplayTimedTextToPlayer(bvo33Local2_owner,0.,0.,15.,"Last: "+LoadStr(MVHash,bvo33Local2_ownerId,901))
if MVReady(bvo33Local2_hero) then
call DisplayTimedTextToPlayer(bvo33Local2_owner,0.,0.,15.,"Susanoo state: active; V level: "+I2S(GetUnitAbilityLevel(bvo33Local2_hero,'ASV1')))
else
call DisplayTimedTextToPlayer(bvo33Local2_owner,0.,0.,15.,"Susanoo state: inactive; V level: "+I2S(GetUnitAbilityLevel(bvo33Local2_hero,'ASV1')))
endif
set bvo33Local2_owner=null
set bvo33Local2_hero=null
endfunction
function MVPlay takes sound bvo33Local3_voice returns nothing
call StopSound(bvo33Local3_voice,false,false)
call StartSound(bvo33Local3_voice)
endfunction
function MVEnable takes unit bvo33Local4_sasuke returns nothing
// A09G itself always stays on the hero, including its existing break logic.
call SetPlayerAbilityAvailable(GetOwningPlayer(bvo33Local4_sasuke),'ASVP',false)
call UnitAddAbility(bvo33Local4_sasuke,'ASV1')
call UnitMakeAbilityPermanent(bvo33Local4_sasuke,true,'ASV1')
call SetPlayerAbilityAvailable(GetOwningPlayer(bvo33Local4_sasuke),'ASV1',true)
endfunction
function MVDisable takes unit bvo33Local5_sasuke returns nothing
// Hide rather than remove the active spell so its cooldown survives forms.
call SetPlayerAbilityAvailable(GetOwningPlayer(bvo33Local5_sasuke),'ASV1',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(bvo33Local5_sasuke),'ASVP',true)
endfunction
function MVRelease takes timer bvo33Local6_curseTimer returns nothing
local integer bvo33Local6_key=GetHandleId(bvo33Local6_curseTimer)
local unit bvo33Local6_target=LoadUnitHandle(MVHash,bvo33Local6_key,1)
if LoadTimerHandle(MVHash,GetHandleId(bvo33Local6_target),0)==bvo33Local6_curseTimer then
if LoadInteger(MVHash,bvo33Local6_key,8)==LoadInteger(Hash,GetHandleId(bvo33Local6_target),StringHash("BvORevivalGeneration")) then
if LoadBoolean(MVHash,bvo33Local6_key,4) then
call PauseUnit(bvo33Local6_target,false)
endif
call UnitRemoveAbility(bvo33Local6_target,'BMV1')
endif
call RemoveSavedHandle(MVHash,GetHandleId(bvo33Local6_target),0)
endif
call SaveBoolean(MVHash,bvo33Local6_key,4,false)
set bvo33Local6_target=null
endfunction
function MVCleanup takes timer bvo33Local7_curseTimer returns nothing
local integer bvo33Local7_key=GetHandleId(bvo33Local7_curseTimer)
local integer bvo33Local7_index=0
call MVRelease(bvo33Local7_curseTimer)
call RemoveUnit(LoadUnitHandle(MVHash,bvo33Local7_key,3))
loop
exitwhen bvo33Local7_index>32
call RemoveUnit(LoadUnitHandle(MVHash,bvo33Local7_key,100+bvo33Local7_index))
call RemoveUnit(LoadUnitHandle(MVHash,bvo33Local7_key,200+bvo33Local7_index))
call RemoveUnit(LoadUnitHandle(MVHash,bvo33Local7_key,300+bvo33Local7_index))
set bvo33Local7_index=bvo33Local7_index+1
endloop
call FlushChildHashtable(MVHash,bvo33Local7_key)
call PauseTimer(bvo33Local7_curseTimer)
call DestroyTimer(bvo33Local7_curseTimer)
endfunction
function MVFlame takes timer bvo33Local8_curseTimer,integer bvo33Local8_index,real bvo33Local8_x,real bvo33Local8_y returns nothing
local unit bvo33Local8_caster=LoadUnitHandle(MVHash,GetHandleId(bvo33Local8_curseTimer),0)
local unit bvo33Local8_flame=CreateUnit(GetOwningPlayer(bvo33Local8_caster),'uMV3',bvo33Local8_x,bvo33Local8_y,270.)
call SetUnitPathing(bvo33Local8_flame,false)
call SetUnitAnimationByIndex(bvo33Local8_flame,0)
call SaveUnitHandle(MVHash,GetHandleId(bvo33Local8_curseTimer),300+bvo33Local8_index,bvo33Local8_flame)
set bvo33Local8_caster=null
set bvo33Local8_flame=null
endfunction
function MVTick takes nothing returns nothing
local timer bvo33Local9_curseTimer=GetExpiredTimer()
local integer bvo33Local9_key=GetHandleId(bvo33Local9_curseTimer)
local unit bvo33Local9_caster=LoadUnitHandle(MVHash,bvo33Local9_key,0)
local unit bvo33Local9_target=LoadUnitHandle(MVHash,bvo33Local9_key,1)
local integer bvo33Local9_ticks=LoadInteger(MVHash,bvo33Local9_key,2)+1
local integer bvo33Local9_index=1
local unit bvo33Local9_copyUnit
local unit bvo33Local9_visual
local real bvo33Local9_angle
local real bvo33Local9_distance
local real bvo33Local9_dx
local real bvo33Local9_dy
local real bvo33Local9_x=GetUnitX(bvo33Local9_target)
local real bvo33Local9_y=GetUnitY(bvo33Local9_target)
local real bvo33Local9_damage
local boolean bvo33Local9_finished=LoadBoolean(MVHash,bvo33Local9_key,5)
call SaveInteger(MVHash,bvo33Local9_key,2,bvo33Local9_ticks)
if not bvo33Local9_finished and (GetUnitTypeId(bvo33Local9_caster)==0 or GetUnitTypeId(bvo33Local9_target)==0 or GetWidgetLife(bvo33Local9_target)<=.405 or LoadInteger(MVHash,bvo33Local9_key,8)!=LoadInteger(Hash,GetHandleId(bvo33Local9_target),StringHash("BvORevivalGeneration"))) then
call MVCleanup(bvo33Local9_curseTimer)
elseif bvo33Local9_ticks==6 then
// Like FOCS, wait 0.15 seconds and verify that the native targeted spell
// actually landed. Spell block/immunity must not produce an illusion.
if GetUnitAbilityLevel(bvo33Local9_target,'BMV1')==0 then
call MVTrace(bvo33Local9_caster,"stopped: native genjutsu mark missing (block/immunity/dispel)")
call MVCleanup(bvo33Local9_curseTimer)
else
call MVTrace(bvo33Local9_caster,"visuals started; native mark confirmed")
// Do not steal an existing pause from another spell, or reject its target.
if not IsUnitPaused(bvo33Local9_target) then
call PauseUnit(bvo33Local9_target,true)
call SaveBoolean(MVHash,bvo33Local9_key,4,true)
endif
set bvo33Local9_visual=CreateUnit(GetOwningPlayer(bvo33Local9_caster),'uMV2',bvo33Local9_x,bvo33Local9_y,270.)
call SetUnitPathing(bvo33Local9_visual,false)
call SetUnitAnimationByIndex(bvo33Local9_visual,0)
call SaveUnitHandle(MVHash,bvo33Local9_key,3,bvo33Local9_visual)
call MVPlay(MVStartVoice)
loop
exitwhen bvo33Local9_index>8
set bvo33Local9_angle=135.*I2R(bvo33Local9_index)*bj_DEGTORAD
set bvo33Local9_copyUnit=CreateUnit(GetOwningPlayer(bvo33Local9_caster),'uMV1',bvo33Local9_x+350.*Cos(bvo33Local9_angle),bvo33Local9_y+350.*Sin(bvo33Local9_angle),135.*I2R(bvo33Local9_index)+180.)
call SetUnitPathing(bvo33Local9_copyUnit,false)
call SetUnitVertexColor(bvo33Local9_copyUnit,255,255,255,255)
call SetUnitAnimationByIndex(bvo33Local9_copyUnit,11)
call SaveUnitHandle(MVHash,bvo33Local9_key,100+bvo33Local9_index,bvo33Local9_copyUnit)
// FOCS uses an attached one-shot effect, not a persistent dummy unit.
call DestroyEffect(AddSpecialEffectTarget("MV_Entry.mdx",bvo33Local9_copyUnit,"origin"))
set bvo33Local9_index=bvo33Local9_index+1
endloop
endif
elseif bvo33Local9_ticks>6 and bvo33Local9_ticks<120 then
set bvo33Local9_visual=LoadUnitHandle(MVHash,bvo33Local9_key,3)
if RAbsBJ(GetUnitX(bvo33Local9_visual)-bvo33Local9_x)+RAbsBJ(GetUnitY(bvo33Local9_visual)-bvo33Local9_y)>.5 then
call SetUnitPosition(bvo33Local9_visual,bvo33Local9_x,bvo33Local9_y)
endif
set bvo33Local9_distance=RMaxBJ(80.,350.-13.05*I2R(bvo33Local9_ticks-6))
loop
exitwhen bvo33Local9_index>8
set bvo33Local9_copyUnit=LoadUnitHandle(MVHash,bvo33Local9_key,100+bvo33Local9_index)
if bvo33Local9_ticks>=6+12*(10-bvo33Local9_index) then
call RemoveUnit(bvo33Local9_copyUnit)
call RemoveSavedHandle(MVHash,bvo33Local9_key,100+bvo33Local9_index)
elseif bvo33Local9_copyUnit!=null then
// FOCS n01W instant-weapon impact. Play the same native impact asset;
// its model event track supplies the action audio without another voice.
if LoadInteger(MVHash,bvo33Local9_key,500+bvo33Local9_index)>0 and bvo33Local9_ticks>=LoadInteger(MVHash,bvo33Local9_key,500+bvo33Local9_index) then
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",bvo33Local9_target,"chest"))
call SaveInteger(MVHash,bvo33Local9_key,500+bvo33Local9_index,0)
endif
set bvo33Local9_angle=135.*I2R(bvo33Local9_index)*bj_DEGTORAD
if RAbsBJ(GetUnitX(bvo33Local9_copyUnit)-bvo33Local9_x-bvo33Local9_distance*Cos(bvo33Local9_angle))+RAbsBJ(GetUnitY(bvo33Local9_copyUnit)-bvo33Local9_y-bvo33Local9_distance*Sin(bvo33Local9_angle))>.5 then
call SetUnitPosition(bvo33Local9_copyUnit,bvo33Local9_x+bvo33Local9_distance*Cos(bvo33Local9_angle),bvo33Local9_y+bvo33Local9_distance*Sin(bvo33Local9_angle))
endif
if bvo33Local9_distance<=80. and bvo33Local9_ticks>=LoadInteger(MVHash,bvo33Local9_key,400+bvo33Local9_index) then
call SetUnitTimeScale(bvo33Local9_copyUnit,2.273333)
call SetUnitAnimationByIndex(bvo33Local9_copyUnit,2)
call QueueUnitAnimation(bvo33Local9_copyUnit,"stand")
call SaveInteger(MVHash,bvo33Local9_key,400+bvo33Local9_index,bvo33Local9_ticks+30)
// Donor nenf attack point: 0.30s; timer period: 0.025s.
call SaveInteger(MVHash,bvo33Local9_key,500+bvo33Local9_index,bvo33Local9_ticks+12)
endif
endif
if bvo33Local9_ticks>=46 then
call RemoveUnit(LoadUnitHandle(MVHash,bvo33Local9_key,200+bvo33Local9_index))
call RemoveSavedHandle(MVHash,bvo33Local9_key,200+bvo33Local9_index)
endif
set bvo33Local9_index=bvo33Local9_index+1
endloop
elseif bvo33Local9_ticks==120 then
call MVTrace(bvo33Local9_caster,"Amaterasu / final damage")
call MVRelease(bvo33Local9_curseTimer)
call RemoveUnit(LoadUnitHandle(MVHash,bvo33Local9_key,3))
call RemoveSavedHandle(MVHash,bvo33Local9_key,3)
loop
exitwhen bvo33Local9_index>8
call RemoveUnit(LoadUnitHandle(MVHash,bvo33Local9_key,100+bvo33Local9_index))
call RemoveSavedHandle(MVHash,bvo33Local9_key,100+bvo33Local9_index)
call RemoveUnit(LoadUnitHandle(MVHash,bvo33Local9_key,200+bvo33Local9_index))
call RemoveSavedHandle(MVHash,bvo33Local9_key,200+bvo33Local9_index)
set bvo33Local9_index=bvo33Local9_index+1
endloop
call SaveBoolean(MVHash,bvo33Local9_key,5,true)
call SaveReal(MVHash,bvo33Local9_key,6,bvo33Local9_x)
call SaveReal(MVHash,bvo33Local9_key,7,bvo33Local9_y)
call MVPlay(MVEndVoice)
call MVFlame(bvo33Local9_curseTimer,0,bvo33Local9_x,bvo33Local9_y)
set bvo33Local9_damage=I2R(GetHeroAgi(bvo33Local9_caster,false))
if GetWidgetLife(bvo33Local9_target)>.405 then
call UnitDamageTarget(bvo33Local9_caster,bvo33Local9_target,bvo33Local9_damage,false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
endif
elseif bvo33Local9_ticks>120 and bvo33Local9_ticks<=135 then
set bvo33Local9_angle=I2R(bvo33Local9_ticks-120)*30.*bj_DEGTORAD
call MVFlame(bvo33Local9_curseTimer,bvo33Local9_ticks-120,LoadReal(MVHash,bvo33Local9_key,6)+100.*Cos(bvo33Local9_angle),LoadReal(MVHash,bvo33Local9_key,7)+100.*Sin(bvo33Local9_angle))
elseif bvo33Local9_ticks>=215 then
call MVCleanup(bvo33Local9_curseTimer)
endif
set bvo33Local9_caster=null
set bvo33Local9_target=null
set bvo33Local9_copyUnit=null
set bvo33Local9_visual=null
set bvo33Local9_curseTimer=null
endfunction
function MVChannel takes nothing returns nothing
local unit bvo33Local10_caster=GetTriggerUnit()
local unit bvo33Local10_target=GetSpellTargetUnit()
if GetSpellAbilityId()=='ASV1' then
call MVTrace(bvo33Local10_caster,"channel")
if not MVReady(bvo33Local10_caster) then
call MVTrace(bvo33Local10_caster,"rejected: Susanoo state is inactive")
call IssueImmediateOrder(bvo33Local10_caster,"stop")
elseif not SilenceConditions(bvo33Local10_caster) then
call MVTrace(bvo33Local10_caster,"rejected: caster is silenced")
call IssueImmediateOrder(bvo33Local10_caster,"stop")
elseif bvo33Local10_target==null then
call MVTrace(bvo33Local10_caster,"rejected: no target")
call IssueImmediateOrder(bvo33Local10_caster,"stop")
elseif LoadTimerHandle(MVHash,GetHandleId(bvo33Local10_target),0)!=null then
call MVTrace(bvo33Local10_caster,"rejected: target is already in genjutsu")
call IssueImmediateOrder(bvo33Local10_caster,"stop")
endif
endif
set bvo33Local10_caster=null
set bvo33Local10_target=null
endfunction
function MVEffect takes nothing returns nothing
local unit bvo33Local11_caster=GetTriggerUnit()
local unit bvo33Local11_target=GetSpellTargetUnit()
local timer bvo33Local11_curseTimer
if GetSpellAbilityId()=='ASV1' then
call MVTrace(bvo33Local11_caster,"spell effect")
if MVReady(bvo33Local11_caster) and bvo33Local11_target!=null and LoadTimerHandle(MVHash,GetHandleId(bvo33Local11_target),0)==null then
set bvo33Local11_curseTimer=CreateTimer()
call SaveUnitHandle(MVHash,GetHandleId(bvo33Local11_curseTimer),0,bvo33Local11_caster)
call SaveUnitHandle(MVHash,GetHandleId(bvo33Local11_curseTimer),1,bvo33Local11_target)
call SaveInteger(MVHash,GetHandleId(bvo33Local11_curseTimer),8,LoadInteger(Hash,GetHandleId(bvo33Local11_target),StringHash("BvORevivalGeneration")))
call SaveTimerHandle(MVHash,GetHandleId(bvo33Local11_target),0,bvo33Local11_curseTimer)
call TimerStart(bvo33Local11_curseTimer,.025,true,function MVTick)
else
call MVTrace(bvo33Local11_caster,"effect rejected: inactive form, missing or busy target")
endif
endif
set bvo33Local11_caster=null
set bvo33Local11_target=null
set bvo33Local11_curseTimer=null
endfunction
function MVInit takes nothing returns nothing
local trigger bvo33Local12_channelTrigger=CreateTrigger()
local trigger bvo33Local12_effectTrigger=CreateTrigger()
local trigger bvo33Local12_chatTrigger=CreateTrigger()
local integer bvo33Local12_playerIndex=0
set MVHash=InitHashtable()
set MVStartVoice=CreateSound("MV_Start.mp3",false,false,false,10,10,"")
set MVEndVoice=CreateSound("MV_End.mp3",false,false,false,10,10,"")
call SetSoundDuration(MVStartVoice,993)
call SetSoundDuration(MVEndVoice,2613)
call SetSoundChannel(MVStartVoice,0)
call SetSoundChannel(MVEndVoice,0)
call SetSoundVolume(MVStartVoice,127)
call SetSoundVolume(MVEndVoice,127)
call TriggerRegisterAnyUnitEventBJ(bvo33Local12_channelTrigger,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddAction(bvo33Local12_channelTrigger,function MVChannel)
call TriggerRegisterAnyUnitEventBJ(bvo33Local12_effectTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(bvo33Local12_effectTrigger,function MVEffect)
loop
exitwhen bvo33Local12_playerIndex>=12
call TriggerRegisterPlayerChatEvent(bvo33Local12_chatTrigger,Player(bvo33Local12_playerIndex),"-svdebug",true)
set bvo33Local12_playerIndex=bvo33Local12_playerIndex+1
endloop
call TriggerAddAction(bvo33Local12_chatTrigger,function MVChat)
call Preload("MV_Start.mp3")
call Preload("MV_End.mp3")
set bvo33Local12_chatTrigger=null
set bvo33Local12_channelTrigger=null
set bvo33Local12_effectTrigger=null
endfunction

function SC38HasOken takes unit sc38Local0_caster returns boolean
return UnitHasItemOfTypeBJ(sc38Local0_caster,'I03D') or UnitHasItemOfTypeBJ(sc38Local0_caster,'I03B') or UnitHasItemOfTypeBJ(sc38Local0_caster,'I054') or GetUnitAbilityLevel(sc38Local0_caster,OKEN_BLESSING_MARKER)>0
endfunction
function SC38CooldownReady takes unit caster,integer abilityId returns boolean
local string cooldownKey="SC38AmaterasuReady"
if abilityId=='A09A' then
set cooldownKey="SC38SusanoReady"
endif
return BvOFreeSpellsEnabled or TimerGetElapsed(AYClock)>=LoadReal(Hash,GetHandleId(caster),StringHash(cooldownKey))
endfunction
function SC38Hide takes unit sc38Local1_caster returns nothing
if LoadBoolean(Hash,GetHandleId(sc38Local1_caster),StringHash("SC38Shown")) then
call SetPlayerAbilityAvailable(GetOwningPlayer(sc38Local1_caster),'ASOC',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(sc38Local1_caster),'A09A',true)
call SaveBoolean(Hash,GetHandleId(sc38Local1_caster),StringHash("SC38Shown"),false)
endif
endfunction
function SC38Sync takes unit sc38Local2_caster returns nothing
if sc38Local2_caster==null then
return
endif
if MVReady(sc38Local2_caster) and SC38HasOken(sc38Local2_caster) then
if not LoadBoolean(Hash,GetHandleId(sc38Local2_caster),StringHash("SC38Shown")) then
if GetUnitAbilityLevel(sc38Local2_caster,'ASOC')==0 then
call UnitAddAbility(sc38Local2_caster,'ASOC')
endif
call UnitMakeAbilityPermanent(sc38Local2_caster,true,'ASOC')
call SetPlayerAbilityAvailable(GetOwningPlayer(sc38Local2_caster),'ASOC',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(sc38Local2_caster),'A09A',false)
call SaveBoolean(Hash,GetHandleId(sc38Local2_caster),StringHash("SC38Shown"),true)
endif
else
call SC38Hide(sc38Local2_caster)
endif
endfunction
function SC38Cleanup takes nothing returns nothing
local timer sc38Local3_fxTimer=GetExpiredTimer()
local integer sc38Local3_key=GetHandleId(sc38Local3_fxTimer)
local integer sc38Local3_index=0
loop
exitwhen sc38Local3_index>6
call DestroyEffect(LoadEffectHandle(MVHash,sc38Local3_key,sc38Local3_index))
set sc38Local3_index=sc38Local3_index+1
endloop
call FlushChildHashtable(MVHash,sc38Local3_key)
call PauseTimer(sc38Local3_fxTimer)
call DestroyTimer(sc38Local3_fxTimer)
set sc38Local3_fxTimer=null
endfunction
function SC38Cast takes unit sc38Local4_caster,real sc38Local4_x,real sc38Local4_y returns nothing
local group sc38Local4_victims=CreateGroup()
local unit sc38Local4_victim
local unit sc38Local4_stunCaster
local timer sc38Local4_fxTimer=CreateTimer()
local integer sc38Local4_key=GetHandleId(sc38Local4_fxTimer)
local integer sc38Local4_index=1
local real sc38Local4_angle
local real sc38Local4_damage=3.*I2R(GetHeroAgi(sc38Local4_caster,true))
local integer sc38Local4_previousMode=DamageSystem_DamageMode
local integer sc38Local4_previousType=DamageType
local real sc38Local4_previousPrimary=PrimaryDamage
// FOCS I01C branch: centre plus six black-flame effects, alive for1.5sec.
// Expand the170-radius effect ring to270 to match225 ->325 damage radius.
call SaveEffectHandle(MVHash,sc38Local4_key,0,AddSpecialEffect("SC_Amaterasu.mdx",sc38Local4_x,sc38Local4_y))
loop
exitwhen sc38Local4_index>6
set sc38Local4_angle=60.*I2R(sc38Local4_index)*bj_DEGTORAD
call SaveEffectHandle(MVHash,sc38Local4_key,sc38Local4_index,AddSpecialEffect("SC_Amaterasu.mdx",sc38Local4_x+270.*Cos(sc38Local4_angle),sc38Local4_y+270.*Sin(sc38Local4_angle)))
set sc38Local4_index=sc38Local4_index+1
endloop
call TimerStart(sc38Local4_fxTimer,1.5,false,function SC38Cleanup)
// No separate voice is assigned to A03Y in the donor. Reuse that Sasuke's
// Amaterasu line, with its own sound handle so V's voice is not interrupted.
call StopSound(SC38CVoice,false,false)
call StartSound(SC38CVoice)
call GroupEnumUnitsInRange(sc38Local4_victims,sc38Local4_x,sc38Local4_y,325.,null)
loop
set sc38Local4_victim=FirstOfGroup(sc38Local4_victims)
exitwhen sc38Local4_victim==null
call GroupRemoveUnit(sc38Local4_victims,sc38Local4_victim)
if GetWidgetLife(sc38Local4_victim)>.405 and IsUnitEnemy(sc38Local4_victim,GetOwningPlayer(sc38Local4_caster)) and not IsUnitType(sc38Local4_victim,UNIT_TYPE_MAGIC_IMMUNE) then
// Reuse the map's tested Aizen stun dummy: level8 has2.00/2.00sec and0 damage.
if not IsUnitType(sc38Local4_victim,UNIT_TYPE_STRUCTURE) then
set sc38Local4_stunCaster=CreateUnit(GetOwningPlayer(sc38Local4_caster),'hL02',GetUnitX(sc38Local4_victim)-16.,GetUnitY(sc38Local4_victim),0.)
call UnitAddAbility(sc38Local4_stunCaster,'AY0S')
call SetUnitAbilityLevel(sc38Local4_stunCaster,'AY0S',2)
call UnitApplyTimedLife(sc38Local4_stunCaster,'BTLF',1.)
call IssueTargetOrder(sc38Local4_stunCaster,"thunderbolt",sc38Local4_victim)
endif
call DamageUnit(sc38Local4_caster,sc38Local4_victim,sc38Local4_damage,MAGICAL,SPELL)
endif
endloop
set DamageSystem_DamageMode=sc38Local4_previousMode
set DamageType=sc38Local4_previousType
set PrimaryDamage=sc38Local4_previousPrimary
call DestroyGroup(sc38Local4_victims)
set sc38Local4_victims=null
set sc38Local4_victim=null
set sc38Local4_stunCaster=null
set sc38Local4_fxTimer=null
endfunction
function SC38Channel takes nothing returns nothing
local unit sc38Local5_caster=GetTriggerUnit()
if GetSpellAbilityId()=='ASOC' and (not MVReady(sc38Local5_caster) or not SC38HasOken(sc38Local5_caster) or not SilenceConditions(sc38Local5_caster) or not SC38CooldownReady(sc38Local5_caster,'ASOC')) then
call IssueImmediateOrder(sc38Local5_caster,"stop")
endif
set sc38Local5_caster=null
endfunction
function SC38Spell takes nothing returns nothing
local unit sc38Local6_caster=GetTriggerUnit()
local integer sc38Local6_ability=GetSpellAbilityId()
if sc38Local6_ability=='A09E' and (GetUnitTypeId(sc38Local6_caster)=='O004' or BvOSusanoType(GetUnitTypeId(sc38Local6_caster))) then
// Same global/non-3D playback as FOCS gg_snd_kadun, in both Sasuke forms.
call StopSound(SC38QVoice,false,false)
call StartSound(SC38QVoice)
elseif sc38Local6_ability=='ASOC' and MVReady(sc38Local6_caster) and SC38HasOken(sc38Local6_caster) and SC38CooldownReady(sc38Local6_caster,'ASOC') then
// Commit before damage callbacks; survives hiding the button, morphing and death.
call SaveReal(Hash,GetHandleId(sc38Local6_caster),StringHash("SC38AmaterasuReady"),TimerGetElapsed(AYClock)+20.)
call SC38Cast(sc38Local6_caster,GetSpellTargetX(),GetSpellTargetY())
endif
set sc38Local6_caster=null
endfunction
function SC38Init takes nothing returns nothing
local trigger sc38Local7_spellTrigger=CreateTrigger()
local trigger sc38Local7_channelTrigger=CreateTrigger()
local integer sc38Local7_index=0
set SC38QVoice=CreateSound("Special\\Spells\\Sasuke\\Gokakyu.mp3",false,false,false,10,10,"")
call SetSoundDuration(SC38QVoice,1620)
call SetSoundChannel(SC38QVoice,0)
call SetSoundVolume(SC38QVoice,127)
set SC38CVoice=CreateSound("MV_End.mp3",false,false,false,10,10,"")
call SetSoundDuration(SC38CVoice,2613)
call SetSoundChannel(SC38CVoice,0)
call SetSoundVolume(SC38CVoice,127)
loop
exitwhen sc38Local7_index>=16
call SetPlayerAbilityAvailable(Player(sc38Local7_index),'ASOC',false)
set sc38Local7_index=sc38Local7_index+1
endloop
call TriggerRegisterAnyUnitEventBJ(sc38Local7_spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(sc38Local7_spellTrigger,function SC38Spell)
call TriggerRegisterAnyUnitEventBJ(sc38Local7_channelTrigger,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddAction(sc38Local7_channelTrigger,function SC38Channel)
set sc38Local7_spellTrigger=null
set sc38Local7_channelTrigger=null
endfunction

function SasukeSusanoShiftFx takes unit sasuke returns nothing
// Original R's native Warcraft effects, including their embedded sound.
call DestroyEffect(AddSpecialEffectTarget("units\\nightelf\\SpiritOfVengeance\\SpiritOfVengeance.mdl",sasuke,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\HowlOfTerror\\HowlCaster.mdl",sasuke,"origin"))
endfunction
function SasukeSusanoIdle takes timer susanoTimer returns nothing
local integer key=GetHandleId(susanoTimer)
local unit shell=LoadUnitHandle(Hash,key,StringHash("SusanoShell"))
call SetUnitTimeScale(shell,1.)
call SetUnitAnimation(shell,"stand")
call SaveInteger(Hash,key,StringHash("SusanoAnimUntil"),0)
call SaveInteger(Hash,key,StringHash("SusanoAnimKind"),0)
set shell=null
endfunction
function SasukeSusanoEnd takes timer susanoTimer returns nothing
local integer key=GetHandleId(susanoTimer)
local unit sasuke=LoadUnitHandle(Hash,key,StringHash("SusanoCaster"))
local unit shell=LoadUnitHandle(Hash,key,StringHash("SusanoShell"))
if sasuke!=null and LoadTimerHandle(Hash,GetHandleId(sasuke),StringHash("SusanoTimer"))==susanoTimer then
call SC38Hide(sasuke)
call MVDisable(sasuke)
call UnitRemoveAbility(sasuke,'ASR1')
call RemoveSavedHandle(Hash,GetHandleId(sasuke),StringHash("SusanoTimer"))
if GetWidgetLife(sasuke)>.405 then
if LoadBoolean(Hash,key,StringHash("SusanoActive")) then
call SasukeSusanoShiftFx(sasuke)
endif
call AddUnitAnimationProperties(sasuke,"alternate",false)
call ResetUnitAnimation(sasuke)
endif
endif
// Hide and remove the actual model: do not wait for an effect death sequence.
call ShowUnit(shell,false)
call RemoveUnit(shell)
call DestroyTrigger(LoadTriggerHandle(Hash,key,StringHash("SusanoDamageTrigger")))
call FlushChildHashtable(Hash,key)
call PauseTimer(susanoTimer)
call DestroyTimer(susanoTimer)
set sasuke=null
set shell=null
endfunction
function SasukeSusanoTick takes nothing returns nothing
local timer susanoTimer=GetExpiredTimer()
local integer key=GetHandleId(susanoTimer)
local unit sasuke=LoadUnitHandle(Hash,key,StringHash("SusanoCaster"))
local unit shell=LoadUnitHandle(Hash,key,StringHash("SusanoShell"))
local integer ticks=LoadInteger(Hash,key,StringHash("SusanoTicks"))+1
local integer rank=GetUnitAbilityLevel(sasuke,'A09A')
local boolean active=LoadBoolean(Hash,key,StringHash("SusanoActive"))
local boolean buffSeen=LoadBoolean(Hash,key,StringHash("SusanoBuffSeen"))
local boolean morphStarted=LoadBoolean(Hash,key,StringHash("SusanoMorphStarted"))
local real dx=GetUnitX(sasuke)-GetUnitX(shell)
local real dy=GetUnitY(sasuke)-GetUnitY(shell)
local real facing=GetUnitFacing(sasuke)
call SaveInteger(Hash,key,StringHash("SusanoTicks"),ticks)
if sasuke==null or GetUnitTypeId(sasuke)==0 or GetWidgetLife(sasuke)<=.405 or LoadInteger(Hash,key,StringHash("SusanoLife"))!=LoadInteger(Hash,GetHandleId(sasuke),StringHash("BvORevivalGeneration")) then
call SasukeSusanoEnd(susanoTimer)
elseif active and buffSeen and GetUnitAbilityLevel(sasuke,'B01J')==0 then
call SasukeSusanoEnd(susanoTimer)
else
// A zero-speed visual unit needs its position refreshed to accept facing on the spot.
// Refresh on actual movement OR heading change; do not reset it every idle tick.
if dx*dx+dy*dy>.25 or RAbsBJ(facing-LoadReal(Hash,key,StringHash("SusanoAppliedFacing")))>.01 then
call SetUnitPosition(shell,GetUnitX(sasuke),GetUnitY(sasuke))
call SetUnitFacingTimed(shell,facing,0.)
call SaveReal(Hash,key,StringHash("SusanoAppliedFacing"),facing)
endif
if RAbsBJ(GetUnitFlyHeight(shell)-GetUnitFlyHeight(sasuke))>.5 then
call SetUnitFlyHeight(shell,GetUnitFlyHeight(sasuke),0.)
endif
if LoadInteger(Hash,key,StringHash("SusanoAnimUntil"))>0 and (ticks>=LoadInteger(Hash,key,StringHash("SusanoAnimUntil")) or (LoadInteger(Hash,key,StringHash("SusanoAnimKind"))==1 and (GetUnitCurrentOrder(sasuke)==OrderId("stop") or GetUnitCurrentOrder(sasuke)==0))) then
call SasukeSusanoIdle(susanoTimer)
endif
if not morphStarted and GetUnitTypeId(sasuke)=='O004' then
call UnitAddAbility(sasuke,'ASR2')
call UnitMakeAbilityPermanent(sasuke,true,'ASR2')
call SetUnitAbilityLevel(sasuke,'ASR2',rank)
call SaveBoolean(Hash,key,StringHash("SusanoMorphStarted"),true)
call IssueImmediateOrder(sasuke,"chemicalrage")
elseif morphStarted and BvOSusanoType(GetUnitTypeId(sasuke)) then
if not active then
call SaveBoolean(Hash,key,StringHash("SusanoActive"),true)
call UnitMakeAbilityPermanent(sasuke,true,'A09A')
call AddUnitAnimationProperties(sasuke,"alternate",false)
call SetUnitAnimationByIndex(sasuke,0)
call UnitAddAbility(sasuke,'ASR1')
call MVEnable(sasuke)
endif
if GetUnitAbilityLevel(sasuke,'B01J')>0 then
call SaveBoolean(Hash,key,StringHash("SusanoBuffSeen"),true)
endif
if GetUnitAbilityLevel(sasuke,'ASR1')!=rank then
call SetUnitAbilityLevel(sasuke,'ASR1',rank)
endif
elseif active or ticks>80 then
call SasukeSusanoEnd(susanoTimer)
endif
endif
call SC38Sync(sasuke)
set susanoTimer=null
set sasuke=null
set shell=null
endfunction
function SasukeSusanoGuard takes nothing returns nothing
local unit sasuke=GetTriggerUnit()
local timer susanoTimer=LoadTimerHandle(Hash,GetHandleId(sasuke),StringHash("SusanoTimer"))
local integer key=GetHandleId(susanoTimer)
local integer ticks=LoadInteger(Hash,key,StringHash("SusanoTicks"))
local unit shell
if susanoTimer!=null and BvOSusanoType(GetUnitTypeId(sasuke)) and GetWidgetLife(sasuke)>.405 and GetEventDamage()>0. and ticks>=LoadInteger(Hash,key,StringHash("SusanoNextGuard")) then
// FOCS uses rolls 7..10 out of 0..10 for the guard visual. No damage,
// healing, reflection or absorption mechanics are transferred here.
if GetRandomInt(0,10)>=7 then
call SaveInteger(Hash,key,StringHash("SusanoNextGuard"),ticks+12)
call DestroyEffect(AddSpecialEffectTarget("Units\\NightElf\\Wisp\\WispExplode.mdl",sasuke,"chest"))
if LoadInteger(Hash,key,StringHash("SusanoAnimUntil"))<=ticks then
set shell=LoadUnitHandle(Hash,key,StringHash("SusanoShell"))
call SetUnitTimeScale(shell,2.)
call SetUnitAnimationByIndex(shell,2)
call SaveInteger(Hash,key,StringHash("SusanoAnimUntil"),ticks+34)
call SaveInteger(Hash,key,StringHash("SusanoAnimKind"),2)
endif
endif
endif
set shell=null
set sasuke=null
set susanoTimer=null
endfunction
function SasukeSusanoCast takes unit sasuke returns nothing
local timer oldTimer=LoadTimerHandle(Hash,GetHandleId(sasuke),StringHash("SusanoTimer"))
local timer susanoTimer
local unit shell
local trigger damageTrigger
if oldTimer!=null then
set oldTimer=null
return
endif
if GetUnitTypeId(sasuke)=='O004' and GetUnitAbilityLevel(sasuke,'B01J')==0 and SC38CooldownReady(sasuke,'A09A') then
call SaveReal(Hash,GetHandleId(sasuke),StringHash("SC38SusanoReady"),TimerGetElapsed(AYClock)+60.)
call UnitMakeAbilityPermanent(sasuke,true,'A09A')
call SasukeSusanoShiftFx(sasuke)
set susanoTimer=CreateTimer()
set shell=CreateUnit(GetOwningPlayer(sasuke),'uSR1',GetUnitX(sasuke),GetUnitY(sasuke),GetUnitFacing(sasuke))
call SetUnitPathing(shell,false)
call SetUnitScale(shell,1.,1.,1.)
call SetUnitVertexColor(shell,255,255,255,255)
call SetUnitAnimationByIndex(shell,0)
call SetUnitTimeScale(shell,1.)
call SaveTimerHandle(Hash,GetHandleId(sasuke),StringHash("SusanoTimer"),susanoTimer)
call SaveUnitHandle(Hash,GetHandleId(susanoTimer),StringHash("SusanoCaster"),sasuke)
call SaveUnitHandle(Hash,GetHandleId(susanoTimer),StringHash("SusanoShell"),shell)
call SaveInteger(Hash,GetHandleId(susanoTimer),StringHash("SusanoLife"),LoadInteger(Hash,GetHandleId(sasuke),StringHash("BvORevivalGeneration")))
set damageTrigger=CreateTrigger()
call TriggerRegisterUnitEvent(damageTrigger,sasuke,EVENT_UNIT_DAMAGED)
call TriggerAddAction(damageTrigger,function SasukeSusanoGuard)
call SaveTriggerHandle(Hash,GetHandleId(susanoTimer),StringHash("SusanoDamageTrigger"),damageTrigger)
call TimerStart(susanoTimer,.025,true,function SasukeSusanoTick)
endif
set oldTimer=null
set susanoTimer=null
set shell=null
set damageTrigger=null
endfunction
function SasukeSusanoChannel takes nothing returns nothing
local unit sasuke=GetTriggerUnit()
if GetSpellAbilityId()=='A09A' and (LoadTimerHandle(Hash,GetHandleId(sasuke),StringHash("SusanoTimer"))!=null or BvOSusanoType(GetUnitTypeId(sasuke)) or GetUnitAbilityLevel(sasuke,'B01J')>0 or not SC38CooldownReady(sasuke,'A09A')) then
// SPELL_CHANNEL occurs before SPELL_EFFECT, mana payment and cooldown.
call IssueImmediateOrder(sasuke,"stop")
call DisplayTimedTextToPlayer(GetOwningPlayer(sasuke),0.,0.,2.,"Susanoo is active or recharging.")
endif
set sasuke=null
endfunction
function SasukeSusanoOrder takes nothing returns nothing
local timer susanoTimer=LoadTimerHandle(Hash,GetHandleId(GetTriggerUnit()),StringHash("SusanoTimer"))
if susanoTimer!=null then
call SasukeSusanoIdle(susanoTimer)
call RemoveSavedInteger(Hash,GetHandleId(susanoTimer),StringHash("SusanoLastAttack"))
endif
set susanoTimer=null
endfunction
function SasukeSusanoAttack takes nothing returns nothing
local unit sasuke=GetAttacker()
local timer susanoTimer=LoadTimerHandle(Hash,GetHandleId(sasuke),StringHash("SusanoTimer"))
local integer key=GetHandleId(susanoTimer)
local unit shell
local integer ticks
local integer previous
local integer rank
local real interval
local real haste
if susanoTimer!=null and BvOSusanoType(GetUnitTypeId(sasuke)) and GetWidgetLife(sasuke)>.405 then
set shell=LoadUnitHandle(Hash,key,StringHash("SusanoShell"))
set ticks=LoadInteger(Hash,key,StringHash("SusanoTicks"))
set previous=LoadInteger(Hash,key,StringHash("SusanoLastAttack"))
set rank=GetUnitAbilityLevel(sasuke,'A09A')
set haste=0.
// First swing uses the native form/AGI estimate; subsequent swings follow
// the actual attack cadence, including items, buffs and slows.
set interval=1.35/(1.+.02*I2R(GetHeroAgi(sasuke,true))+haste)
if previous>0 and ticks>previous and ticks-previous<80 then
set interval=.025*I2R(ticks-previous)
endif
call SaveInteger(Hash,key,StringHash("SusanoLastAttack"),ticks)
// Refresh the stationary carrier before setting facing and starting its swing.
call SetUnitPosition(shell,GetUnitX(sasuke),GetUnitY(sasuke))
call SetUnitFacingTimed(shell,GetUnitFacing(sasuke),0.)
call SaveReal(Hash,key,StringHash("SusanoAppliedFacing"),GetUnitFacing(sasuke))
call SetUnitTimeScale(shell,1.309/RMaxBJ(.10,interval))
call SetUnitAnimationByIndex(shell,1)
call QueueUnitAnimation(shell,"stand")
call SaveInteger(Hash,key,StringHash("SusanoAnimUntil"),ticks+R2I(RMaxBJ(.10,interval)/.025)+1)
call SaveInteger(Hash,key,StringHash("SusanoAnimKind"),1)
endif
set shell=null
set sasuke=null
set susanoTimer=null
endfunction
function SasukeSusanoDeath takes nothing returns nothing
local timer susanoTimer=LoadTimerHandle(Hash,GetHandleId(GetTriggerUnit()),StringHash("SusanoTimer"))
if susanoTimer!=null then
call SasukeSusanoEnd(susanoTimer)
endif
set susanoTimer=null
endfunction
