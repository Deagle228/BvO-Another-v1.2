call EnableTrigger(Rs)
call EnableTrigger(Js)
call EnableTrigger(Ks)
call EnableTrigger(Ls)
call EnableTrigger(Ms)
call EnableTrigger(Ns)
call EnableTrigger(Os)
call EnableTrigger(Ss)
call EnableTrigger(Ts)
else
call DestroyTrigger(ls)
call DestroyTrigger(Ps)
call DestroyTrigger(Qs)
call DestroyTrigger(Rs)
call DestroyTrigger(Js)
call DestroyTrigger(Ks)
call DestroyTrigger(Ls)
call DestroyTrigger(Ms)
call DestroyTrigger(Ns)
call DestroyTrigger(Os)
call DestroyTrigger(Ss)
call DestroyTrigger(Ts)
call DestroyTrigger(Us)
endif
if uH() then
call EnableTrigger(V3)
endif
if BH() then
call EnableTrigger(W3)
endif
call TriggerExecute(bt)
call DestroyTrigger(GetTriggeringTrigger())
endfunction
