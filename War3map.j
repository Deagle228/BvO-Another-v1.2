function nmv takes nothing returns nothing
set P8[1]=YG(bj_mapInitialPlayableArea,Condition(function nbv))
set P8[2]=YG(bj_mapInitialPlayableArea,Condition(function nBv))
set P8[3]=YG(bj_mapInitialPlayableArea,Condition(function ncv))
set P8[4]=YG(bj_mapInitialPlayableArea,Condition(function nCv))
set P8[5]=YG(bj_mapInitialPlayableArea,Condition(function ndv))
call ForGroupBJ(P8[1],function ngv)
if nhv() then
call ForGroupBJ(P8[2],function nGv)
endif
if njv() then
call ForGroupBJ(P8[3],function nHv)
endif
if nkv() then
call ForGroupBJ(P8[4],function nJv)
endif
if nlv() then
call ForGroupBJ(P8[5],function nKv)
endif
call DestroyGroup(P8[1])
set P8[1]=null
call DestroyGroup(P8[2])
set P8[2]=null
