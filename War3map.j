function SasukeArtReady takes nothing returns nothing
local timer artTimer=GetExpiredTimer()
local integer key=GetHandleId(artTimer)
local unit sasuke=LoadUnitHandle(Hash,key,StringHash("SasukeArtReady"))
if sasuke!=null and GetWidgetLife(sasuke)>.405 and (GetUnitTypeId(sasuke)=='O004' or BvOSusanoType(GetUnitTypeId(sasuke))) then
call SetUnitScale(sasuke,1.,1.,1.)
call SetUnitVertexColor(sasuke,255,255,255,255)
call SetUnitAnimationByIndex(sasuke,0)
call UnitAddAbility(sasuke,'ASVP')
call UnitMakeAbilityPermanent(sasuke,true,'ASVP')
endif
call RemoveSavedHandle(Hash,key,StringHash("SasukeArtReady"))
call DestroyTimer(artTimer)
set artTimer=null
set sasuke=null
endfunction
function SasukeScheduleArt takes unit sasuke returns nothing
local timer artTimer=CreateTimer()
call SaveUnitHandle(Hash,GetHandleId(artTimer),StringHash("SasukeArtReady"),sasuke)
call TimerStart(artTimer,0.,false,function SasukeArtReady)
set artTimer=null
endfunction
