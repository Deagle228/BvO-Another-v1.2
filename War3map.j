call UnitAddAbility(ulquiorraDamageSourceUnit,0x55413048)
call BvOHeroSpellDamage(ulquiorraDamageSourceUnit,ulquiorraDamagedUnit,ulquiorraDamageAmount,true,true,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC)
call UnitRemoveAbility(ulquiorraDamageSourceUnit,0x55413048)
call SetUnitX(ULQ_GetDummy(GetPlayerId(GetOwningPlayer(ulquiorraDamageSourceUnit))),x)
call SetUnitY(ULQ_GetDummy(GetPlayerId(GetOwningPlayer(ulquiorraDamageSourceUnit))),y)
