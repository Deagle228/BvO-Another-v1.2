function KuzanIceTimeIssueTargetOrder takes unit kuzanCaster,unit kuzanIceTimeDummy,unit kuzanIceTimeTarget,integer kuzanIceTimeOrderId returns nothing
local player kuzanOwner=GetOwningPlayer(kuzanCaster)
local boolean kuzanNeedsTargetVision=not IsUnitVisible(kuzanIceTimeTarget,kuzanOwner)
if kuzanNeedsTargetVision then
call UnitShareVision(kuzanIceTimeTarget,kuzanOwner,true)
endif
call IssueTargetOrderById(kuzanIceTimeDummy,kuzanIceTimeOrderId,kuzanIceTimeTarget)
if kuzanNeedsTargetVision then
call UnitShareVision(kuzanIceTimeTarget,kuzanOwner,false)
endif
set kuzanOwner=null
endfunction
