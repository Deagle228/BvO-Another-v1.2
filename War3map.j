call DisableTrigger(KF)
call DisableTrigger(DF)
call DisableTrigger(EF)
call DisableTrigger(MF)
call DisableTrigger(TF)
call DisableTrigger(SF)
call EnableTrigger(Gt)
call CinematicModeBJ(true,bj_FORCE_ALL_PLAYERS)
call ClearTextMessagesBJ(bj_FORCE_ALL_PLAYERS)
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,"|cffff0000LOADING RESULT....|r")
call StopMusic(false)
call PlaySoundBJ(ap)
call EnableTrigger(Ft)
call TriggerSleepAction(4.)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call SetUnitPositionLocFacingLocBJ(m[bj_forLoopAIndex],GetRandomLocInRect(Io),GetRectCenter(do))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=7
set bj_forLoopAIndexEnd=12
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call SetUnitPositionLocFacingLocBJ(m[bj_forLoopAIndex],GetRandomLocInRect(do),GetRectCenter(Io))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call DisableTrigger(Ft)
call ForForce(bj_FORCE_ALL_PLAYERS,function niv)
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,"Team 1 Wins!")
call MultiboardMinimize(X,true)
call TimerDialogDisplay(s,false)
call PauseAllUnitsBJ(true)
call TriggerSleepAction(.5)
call PauseAllUnitsBJ(true)
call TriggerExecute(Ht)
endfunction
