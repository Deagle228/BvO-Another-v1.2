endfunction
function KumaW_Reflect takes nothing returns nothing
if GetUnitAbilityLevel(Target,$41304359)>0 and not BvOPassivesBroken(Target) and IsUnitType(Source,UNIT_TYPE_MELEE_ATTACKER) and IsUnitEnemy(Target,GetOwningPlayer(Source)) then
call DamageUnit(Target,Source,Damage*.15,CLEAN,UNKNOWN)
