endfunction
function ULQ_DestroyFilterDestruct takes nothing returns boolean
if GetDestructableLife(GetFilterDestructable())>0 then
call KillDestructable(GetFilterDestructable())
endif
return true
endfunction
function ULQ_DestroyAoEDestruct takes real ulquiorraCenterX,real ulquiorraCenterY,real ulquiorraDestructibleRadius returns nothing
if ulquiorraDestructibleRadius>0 then
call SetRect(LoadRectHandle(ULQ_HashTable,-12001,0),ulquiorraCenterX-ulquiorraDestructibleRadius,ulquiorraCenterY-ulquiorraDestructibleRadius,ulquiorraCenterX+ulquiorraDestructibleRadius,ulquiorraCenterY+ulquiorraDestructibleRadius)
call EnumDestructablesInRect(LoadRectHandle(ULQ_HashTable,-12001,0),Filter(function ULQ_DestroyFilterDestruct),null)
endif
endfunction
function ULQ_LinearDisplacementAction takes nothing returns nothing
local integer HandleID=ULQ_MUIHandle()
local real MoveX=GetUnitX(ULQ_GetUnit("Displaced"))+ULQ_GetReal("MaxDistance")*ULQ_GetReal("AngleX")
local real MoveY=GetUnitY(ULQ_GetUnit("Displaced"))+ULQ_GetReal("MaxDistance")*ULQ_GetReal("AngleY")
if ULQ_GetReal("Duration")>0 and ULQ_UnitLife(ULQ_GetUnit("Displaced"))>0 and not ULQ_GetBool("StopMovement")then
if not ULQ_GetBool("Pathing")and IsTerrainPathable(MoveX,MoveY,PATHING_TYPE_WALKABILITY)then
call SaveBoolean(ULQ_HashTable,HandleID,StringHash("StopMovement"),true)
else
call IssueImmediateOrder(ULQ_GetUnit("Displaced"),"stop")
call SaveReal(ULQ_HashTable,HandleID,StringHash("Duration"),ULQ_GetReal("Duration")-1)
call ULQ_SetUnitXY_1(ULQ_GetUnit("Displaced"),MoveX,MoveY,true)
call ULQ_DestroyAoEDestruct(MoveX,MoveY,150)
if ULQ_GetStr("Effect")!=null and GetUnitFlyHeight(ULQ_GetUnit("Displaced"))<5.then
call DestroyEffect(AddSpecialEffect(ULQ_GetStr("Effect"),GetUnitX(ULQ_GetUnit("Displaced")),GetUnitY(ULQ_GetUnit("Displaced"))))
endif
call SaveReal(ULQ_HashTable,HandleID,StringHash("MaxDistance"),ULQ_GetReal("MaxDistance")-ULQ_GetReal("MoveRate"))
endif
else
call SaveBoolean(ULQ_HashTable,GetHandleId(ULQ_GetUnit("Displaced")),StringHash("IsDisplaced"),false)
call ULQ_CleanMUI(GetExpiredTimer())
endif
endfunction
function ULQ_LinearDisplacement takes unit ulquiorraAffectedUnit,real ulquiorraFacingAngle,real ulquiorraTravelDistance,real ulquiorraTravelDuration,real ulquiorraUpdateInterval,boolean ulquiorraDestroyDoodads,boolean ulquiorraPathingEnabled,string ulquiorraAttachmentPoint,string ulquiorraEffectModelPath returns nothing
local integer PID
local integer HandleID
if ulquiorraAffectedUnit!=null then
set PID=GetPlayerId(GetOwningPlayer(ulquiorraAffectedUnit))
set HandleID=ULQ_NewMUITimer(PID)
call SaveReal(ULQ_HashTable,HandleID,StringHash("AngleX"),Cos(Deg2Rad(ulquiorraFacingAngle)))
call SaveReal(ULQ_HashTable,HandleID,StringHash("AngleY"),Sin(Deg2Rad(ulquiorraFacingAngle)))
call SaveReal(ULQ_HashTable,HandleID,StringHash("MaxDistance"),2*ulquiorraTravelDistance*ulquiorraUpdateInterval/ulquiorraTravelDuration)
call SaveReal(ULQ_HashTable,HandleID,StringHash("MoveRate"),(2*ulquiorraTravelDistance*ulquiorraUpdateInterval/ulquiorraTravelDuration)*ulquiorraUpdateInterval/ulquiorraTravelDuration)
call SaveReal(ULQ_HashTable,HandleID,StringHash("InitX"),GetUnitX(ulquiorraAffectedUnit))
call SaveReal(ULQ_HashTable,HandleID,StringHash("InitY"),GetUnitY(ulquiorraAffectedUnit))
call SaveUnitHandle(ULQ_HashTable,HandleID,StringHash("Displaced"),ulquiorraAffectedUnit)
call SaveBoolean(ULQ_HashTable,HandleID,StringHash("Pathing"),ulquiorraPathingEnabled)
call SaveStr(ULQ_HashTable,HandleID,StringHash("Effect"),ulquiorraEffectModelPath)
call SaveReal(ULQ_HashTable,HandleID,StringHash("Duration"),ulquiorraTravelDuration/ulquiorraUpdateInterval)
call SaveBoolean(ULQ_HashTable,GetHandleId(ulquiorraAffectedUnit),StringHash("IsDisplaced"),true)
call TimerStart(ULQ_LoadMUITimer(PID),ulquiorraUpdateInterval,true,function ULQ_LinearDisplacementAction)
endif
endfunction
