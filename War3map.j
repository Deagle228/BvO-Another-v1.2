endfunction
function ULQ_MoveUnit takes unit ulquiorraMovedUnit,real ulquiorraMoveDistance,real ulquiorraFacingAngleRadians returns nothing
if ULQ_PathingCheck(GetUnitX(ulquiorraMovedUnit)+ulquiorraMoveDistance*Cos(ulquiorraFacingAngleRadians),GetUnitY(ulquiorraMovedUnit)+ulquiorraMoveDistance*Sin(ulquiorraFacingAngleRadians))==true then
