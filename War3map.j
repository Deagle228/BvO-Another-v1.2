function ULQ_s__UlquiorraSpells__UlquiorraT1_Act_Loop takes nothing returns nothing
local integer this
local integer i=0
loop
exitwhen i>LoadInteger(ULQ_HashTable,-12201,0)
set this=LoadInteger(ULQ_HashTable,-12200,i)
if LoadReal(ULQ_HashTable,-12214,this)<LoadReal(ULQ_HashTable,-12216,this)and LoadReal(ULQ_HashTable,-12210,this)<LoadReal(ULQ_HashTable,-12211,this)then
call SaveReal(ULQ_HashTable,-12214,this,LoadReal(ULQ_HashTable,-12214,this)+0.02)
call ULQ_MoveUnit(LoadUnitHandle(ULQ_HashTable,-12207,this),81.5,LoadReal(ULQ_HashTable,-12215,this))
call SaveReal(ULQ_HashTable,-12210,this,LoadReal(ULQ_HashTable,-12210,this)+(81.5))
if LoadReal(ULQ_HashTable,-12205,this)>0.03 then
call SaveReal(ULQ_HashTable,-12205,this,0)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(LoadUnitHandle(ULQ_HashTable,-12202,this)),0x6D303136,GetUnitX(LoadUnitHandle(ULQ_HashTable,-12207,this)),GetUnitY(LoadUnitHandle(ULQ_HashTable,-12207,this)),LoadReal(ULQ_HashTable,-12215,this)*bj_RADTODEG)
call SetUnitVertexColor(bj_lastCreatedUnit,255,255,255,175)
call SetUnitTimeScale(bj_lastCreatedUnit,8.5)
call ULQ_AnimDummy(bj_lastCreatedUnit,0.05,1.1)
call ULQ_MyRemoveUnit(bj_lastCreatedUnit,0.35)
else
call SaveReal(ULQ_HashTable,-12205,this,LoadReal(ULQ_HashTable,-12205,this)+(0.02))
endif
call GroupEnumUnitsInRange(ULQ_SpearSlashEnumGroup,GetUnitX(LoadUnitHandle(ULQ_HashTable,-12207,this)),GetUnitY(LoadUnitHandle(ULQ_HashTable,-12207,this)),165,Condition(function ULQ_NoDecor_Filter))
loop
call SaveUnitHandle(ULQ_HashTable,-12212,this,FirstOfGroup(ULQ_SpearSlashEnumGroup))
exitwhen LoadUnitHandle(ULQ_HashTable,-12212,this)==null
if ULQ_IsUnitInvulnerable2(LoadUnitHandle(ULQ_HashTable,-12212,this))==false and IsUnitEnemy(LoadUnitHandle(ULQ_HashTable,-12212,this),GetOwningPlayer(LoadUnitHandle(ULQ_HashTable,-12202,this)))and GetWidgetLife(LoadUnitHandle(ULQ_HashTable,-12212,this))>0.405 then
if IsUnitInGroup(LoadUnitHandle(ULQ_HashTable,-12212,this),LoadGroupHandle(ULQ_HashTable,-12209,this))==false then
call BvOHeroSpellDamage(LoadUnitHandle(ULQ_HashTable,-12202,this),LoadUnitHandle(ULQ_HashTable,-12212,this),LoadReal(ULQ_HashTable,-12213,this),true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNKNOWN)
call GroupAddUnit(LoadGroupHandle(ULQ_HashTable,-12209,this),LoadUnitHandle(ULQ_HashTable,-12212,this))
endif
call IssueImmediateOrder(LoadUnitHandle(ULQ_HashTable,-12212,this),"stop")
endif
call GroupRemoveUnit(ULQ_SpearSlashEnumGroup,LoadUnitHandle(ULQ_HashTable,-12212,this))
endloop
call SaveUnitHandle(ULQ_HashTable,-12212,this,null)
call GroupClear(ULQ_SpearSlashEnumGroup)
else
call ULQ_MyRemoveUnit(LoadUnitHandle(ULQ_HashTable,-12207,this),0.01)
call GroupClear(LoadGroupHandle(ULQ_HashTable,-12209,this))
call DestroyGroup(LoadGroupHandle(ULQ_HashTable,-12209,this))
call SaveUnitHandle(ULQ_HashTable,-12207,this,null)
call SaveUnitHandle(ULQ_HashTable,-12212,this,null)
call SaveUnitHandle(ULQ_HashTable,-12202,this,null)
call SaveReal(ULQ_HashTable,-12214,this,0)
call SaveSoundHandle(ULQ_HashTable,-12208,this,null)
call SaveReal(ULQ_HashTable,-12215,this,0)
call SaveReal(ULQ_HashTable,-12205,this,0)
call SaveReal(ULQ_HashTable,-12216,this,0)
call SaveReal(ULQ_HashTable,-12203,this,0)
call SaveReal(ULQ_HashTable,-12204,this,0)
call ULQ_s__UlquiorraSpells__UlquiorraT1_Act_StopAction(this,i)
call ULQ_s__UlquiorraSpells__UlquiorraT1_Act_deallocate(this)
endif
set i=i+1
endloop
endfunction
