// R / E learned markers 'j007' / 'j008' of the owner (ULQ_HashTable keys 9105 / 9106 of the hero): with the
// Resurreccion marker 'j001' they are the requirements of the book spells ZB05 / ZB06, which stay greyed out
// until both are met. Pull Lance ZZ07 needs the Luz de la Luna marker 'j002'.
function ULQ_SetLearnedMarker takes unit ulquiorraHero,integer markerKey,integer markerType,boolean markerWanted returns nothing
local integer heroKey=GetHandleId(ulquiorraHero)
local unit marker=LoadUnitHandle(ULQ_HashTable,heroKey,markerKey)
if markerWanted and marker==null then
call SaveUnitHandle(ULQ_HashTable,heroKey,markerKey,CreateUnit(GetOwningPlayer(ulquiorraHero),markerType,1.,1.,0.))
elseif not markerWanted and marker!=null then
call RemoveUnit(marker)
call RemoveSavedHandle(ULQ_HashTable,heroKey,markerKey)
endif
set marker=null
endfunction
// the Luz de la Luna marker 'j002' (required by Pull Lance) exists for the owner while Luz de la Luna is active
function ULQ_SetLuzMarker takes unit ulquiorraHero,boolean luzActive returns nothing
local integer heroKey=GetHandleId(ulquiorraHero)
local unit luzMarker=LoadUnitHandle(ULQ_HashTable,heroKey,9104)
if luzActive and luzMarker==null then
call SaveUnitHandle(ULQ_HashTable,heroKey,9104,CreateUnit(GetOwningPlayer(ulquiorraHero),'j002',1.,1.,0.))
elseif not luzActive and luzMarker!=null then
call RemoveUnit(luzMarker)
call RemoveSavedHandle(ULQ_HashTable,heroKey,9104)
endif
set luzMarker=null
endfunction
function ULQ_BookMessage takes unit ulquiorraHero,string bookMessage returns nothing
call IssueImmediateOrder(ulquiorraHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(ulquiorraHero) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00"+bookMessage+"|r")
endif
endfunction
function ULQ_CheckBookCast takes nothing returns boolean
local unit ulquiorraHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
local boolean inResurreccion=GetUnitTypeId(ulquiorraHero)=='US1_' or GetUnitTypeId(ulquiorraHero)=='US2_'
if spellId=='ZB05' or spellId=='ZB06' or (spellId=='ZZ07' and GetUnitAbilityLevel(ulquiorraHero,'ZZ07')<6) then
if not inResurreccion then
call ULQ_BookMessage(ulquiorraHero,"Only in Resurreccion!")
elseif spellId=='ZB05' and GetUnitAbilityLevel(ulquiorraHero,'ZZ05')==0 then
call ULQ_BookMessage(ulquiorraHero,"Learn this technique first!")
elseif spellId=='ZB06' and GetUnitAbilityLevel(ulquiorraHero,'ZZ06')==0 then
call ULQ_BookMessage(ulquiorraHero,"Learn this technique first!")
elseif spellId=='ZB06' and GetUnitAbilityLevel(ulquiorraHero,'ZS02')>0 then
call ULQ_BookMessage(ulquiorraHero,"Luz de la Luna is already active!")
elseif spellId=='ZZ07' and GetUnitAbilityLevel(ulquiorraHero,'ZS02')==0 then
call ULQ_BookMessage(ulquiorraHero,"Only while Luz de la Luna is active!")
elseif spellId=='ZZ07' and TimerGetElapsed(AYClock)<LoadReal(ULQ_HashTable,GetHandleId(ulquiorraHero),9301) then
call ULQ_BookMessage(ulquiorraHero,"Pull Lance is recharging: "+I2S(R2I(LoadReal(ULQ_HashTable,GetHandleId(ulquiorraHero),9301)-TimerGetElapsed(AYClock)+.99))+" s")
endif
endif
set ulquiorraHero=null
return false
endfunction
// R and T live in the book ZB00 as copies ZB05/ZB06; the hidden hero abilities ZZ05/ZZ06 keep the learned levels
function ULQ_SyncResurreccionBook takes unit ulquiorraHero returns nothing
local integer strikeLevel=GetUnitAbilityLevel(ulquiorraHero,'ZZ05')
local integer moonLevel=GetUnitAbilityLevel(ulquiorraHero,'ZZ06')
if GetUnitTypeId(ulquiorraHero)==0 then
call ULQ_SetLearnedMarker(ulquiorraHero,9105,'j007',false)
call ULQ_SetLearnedMarker(ulquiorraHero,9106,'j008',false)
return
endif
call ULQ_SetLearnedMarker(ulquiorraHero,9105,'j007',strikeLevel>0)
call ULQ_SetLearnedMarker(ulquiorraHero,9106,'j008',moonLevel>0)
if GetUnitAbilityLevel(ulquiorraHero,'ZB00')==0 then
return
endif
// a morph (Resurreccion, Segunda Etapa and back) keeps the book ZB00 but not the spells inside it: after every
// change of the unit type the book is added again, which adds R, E and T again (their levels are set below)
if LoadInteger(ULQ_HashTable,GetHandleId(ulquiorraHero),9107)!=GetUnitTypeId(ulquiorraHero) then
call SaveInteger(ULQ_HashTable,GetHandleId(ulquiorraHero),9107,GetUnitTypeId(ulquiorraHero))
call UnitRemoveAbility(ulquiorraHero,'ZB00')
call UnitAddAbility(ulquiorraHero,'ZB00')
call UnitMakeAbilityPermanent(ulquiorraHero,true,'ZB00')
endif
if strikeLevel>0 and GetUnitAbilityLevel(ulquiorraHero,'ZB05')!=strikeLevel then
call SetUnitAbilityLevel(ulquiorraHero,'ZB05',strikeLevel)
endif
if moonLevel>0 and GetUnitAbilityLevel(ulquiorraHero,'ZB06')!=moonLevel then
call SetUnitAbilityLevel(ulquiorraHero,'ZB06',moonLevel)
endif
endfunction
function ULQ_SyncBookEnum takes nothing returns nothing
local unit ulquiorraHero=GetEnumUnit()
call ULQ_SyncResurreccionBook(ulquiorraHero)
if GetUnitTypeId(ulquiorraHero)==0 then
call GroupRemoveUnit(ULQ_BookHeroes,ulquiorraHero)
endif
set ulquiorraHero=null
endfunction
function ULQ_SyncBookTick takes nothing returns nothing
call ForGroup(ULQ_BookHeroes,function ULQ_SyncBookEnum)
endfunction
function ULQ_TrackBookHero takes unit ulquiorraHero returns nothing
local integer heroType=GetUnitTypeId(ulquiorraHero)
if (heroType=='US00' or heroType=='US1_' or heroType=='US2_') and not IsUnitIllusion(ulquiorraHero) then
call GroupAddUnit(ULQ_BookHeroes,ulquiorraHero)
call ULQ_SyncResurreccionBook(ulquiorraHero)
endif
endfunction
function ULQ_OnBookLearn takes nothing returns boolean
call ULQ_TrackBookHero(GetTriggerUnit())
return false
endfunction
function ULQ_s__UlquiorraSpells__UlquiorraT_StopAction takes integer ulquiorraInstanceIndex,integer ulquiorraLoopIndex returns nothing
call SaveInteger(ULQ_HashTable,-12187,ulquiorraLoopIndex,LoadInteger(ULQ_HashTable,-12187,LoadInteger(ULQ_HashTable,-12188,0)))
