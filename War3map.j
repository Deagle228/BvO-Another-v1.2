call DestroyGroup(LoadGroupHandle(ULQ_HashTable,-12175,this))
call SetUnitTimeScale(LoadUnitHandle(ULQ_HashTable,-12170,this),1)
call SaveUnitHandle(ULQ_HashTable,-12170,this,null)
call SaveUnitHandle(ULQ_HashTable,-12170,this,null)
call SaveReal(ULQ_HashTable,-12179,this,0)
call SaveReal(ULQ_HashTable,-12171,this,0)
call SaveReal(ULQ_HashTable,-12172,this,0)
call ULQ_s__UlquiorraSpells__UlquiorraR1_StopAction(this,i)
call ULQ_s__UlquiorraSpells__UlquiorraR1_deallocate(this)
endif
set i=i+1
endloop
endfunction
function ULQ_s__UlquiorraSpells__UlquiorraR1_UlquiorraR1_Start takes unit ulquiorraCasterUnit,real ulquiorraDestinationX,real ulquiorraDestinationY returns nothing
local integer this=ULQ_s__UlquiorraSpells__UlquiorraR1__allocate()
