function ToshiroWBankai_TimerActions takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer timerId=GetHandleId(spellTimer)
local real duration=L_R(timerId,"duration")+.025
local real distance=L_R(timerId,"distance")-9
local real damage=L_R(timerId,"damage")
local unit caster=L_U(timerId,"caster")
local real targetX=L_R(timerId,"targetX")
local real targetY=L_R(timerId,"targetY")
local real dummyX
local real dummyY
local real angle
local unit dummy
local unit target
local group targetGroup
local group nonTargetGroup
local integer index
if duration<=1 then
set index=0
loop
exitwhen index>17
set dummy=L_U(timerId,I2S(index)+"dummy")
call SetUnitVertexColorBJ(dummy,100,100,100,100-100*duration)
set index=index+1
endloop
call S_R(timerId,"duration",duration)
elseif distance>120 then
call S_R(timerId,"distance",distance)
set index=0
loop
exitwhen index>17
set dummy=L_U(timerId,I2S(index)+"dummy")
call S_R(GetHandleId(dummy),"angle",L_R(GetHandleId(dummy),"angle")-6)
set dummyX=GetPolarOffsetX(targetX,distance,L_R(GetHandleId(dummy),"angle"))
set dummyY=GetPolarOffsetY(targetY,distance,L_R(GetHandleId(dummy),"angle"))
call SetUnitPosition(dummy,dummyX,dummyY)
set index=index+1
endloop
set targetGroup=CreateGroup()
set nonTargetGroup=CreateGroup()
call GroupEnumUnitsInRange(targetGroup,targetX,targetY,distance+25,null)
call GroupEnumUnitsInRange(nonTargetGroup,targetX,targetY,distance-40,null)
loop
set target=FirstOfGroup(targetGroup)
exitwhen target==null
if not IsUnitInGroup(target,nonTargetGroup) and GetWidgetLife(target)>.405 and not IsUnitType(target,UNIT_TYPE_STRUCTURE) and IsUnitEnemy(target,GetOwningPlayer(caster)) and not IsUnitPaused(target) then
set angle=AngleBetween(targetX,targetY,GetUnitX(target),GetUnitY(target))
set dummyX=GetPolarOffsetX(targetX,distance-40,angle)
set dummyY=GetPolarOffsetY(targetY,distance-40,angle)
if not IsTerrainPathable(dummyX,dummyY,PATHING_TYPE_WALKABILITY) then
call SetUnitX(target,dummyX)
call SetUnitY(target,dummyY)
endif
endif
call GroupRemoveUnit(targetGroup,target)
endloop
call DestroyGroup(targetGroup)
call DestroyGroup(nonTargetGroup)
else
call SortEnemiesInRange(caster,targetX,targetY,425)
call DamageGroup(caster,damage,MAGICAL,SPELL)
call CastToGroup(caster,$41303248,8,"frostnova")
call DestroyEffect(AddSpecialEffect("war3mapImported\\icestomp.mdx",targetX,targetY))
call DestroyEffect(AddSpecialEffect("war3mapImported\\FrostNova.mdx",targetX,targetY))
set index=0
loop
exitwhen index>17
set dummy=L_U(timerId,I2S(index)+"dummy")
call FlushChildHashtable(Hash,GetHandleId(dummy))
call KillUnit(dummy)
set index=index+1
endloop
call FlushChildHashtable(Hash,timerId)
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endif
set caster=null
set spellTimer=null
set dummy=null
set target=null
set targetGroup=null
set nonTargetGroup=null
endfunction
