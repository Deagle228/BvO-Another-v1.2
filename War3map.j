// Ace R (Hidaruma) as in 1.1A: a swarm of fireflies gathers around Ace (Hotarubi), fans out, and every group of 10
// fireflies flies at its own enemy hero (Hidaruma) and explodes on it. Our values are kept: 800/950/1100/1250/1400
// magic damage, 1/1/2/3/4 targets within 2600, the same firefly speed (25 every 0.03 s) and stun.
function AceRFly takes integer timerKey,integer groupIndex,integer flyIndex returns unit
return LoadUnitHandle(RBState,timerKey,100+groupIndex*10+flyIndex)
endfunction
function AceRRemoveGroup takes integer timerKey,integer groupIndex returns nothing
local integer flyIndex=0
loop
exitwhen flyIndex>9
call RemoveUnit(AceRFly(timerKey,groupIndex,flyIndex))
call RemoveSavedHandle(RBState,timerKey,100+groupIndex*10+flyIndex)
set flyIndex=flyIndex+1
endloop
call SaveBoolean(RBState,timerKey,60+groupIndex,true)
endfunction
function AceRNewFly takes unit caster,real flyX,real flyY,real flyFacing returns unit
local unit fly=CreateUnit(GetOwningPlayer(caster),'h001',flyX,flyY,flyFacing)
// the fireflies are created and moved as in 1.1A (h001 already has Locust; SetUnitPosition keeps the model drawn)
call SetUnitFlyHeight(fly,500.,0.)
set RBLastFly=fly
set fly=null
return RBLastFly
endfunction
function AceRTick takes nothing returns nothing
local timer swarmTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(swarmTimer)
local unit caster=LoadUnitHandle(RBState,timerKey,0)
local integer count=LoadInteger(RBState,timerKey,1)
local real elapsed=LoadReal(RBState,timerKey,3)+.03
local real spread=360./I2R(count)
local integer groupIndex=0
local integer flyIndex
local integer live=0
local unit fly
local unit carrier
local unit target
local real angle
local real dx
local real dy
local real distance
local group pool
local group nearby
call SaveReal(RBState,timerKey,3,elapsed)
// 1.2 s: the other carriers appear; 1.2-1.7 s: the carriers move out
if elapsed>=1.2 and not LoadBoolean(RBState,timerKey,4) then
call SaveBoolean(RBState,timerKey,4,true)
set groupIndex=1
loop
exitwhen groupIndex>=count
call SaveUnitHandle(RBState,timerKey,10+groupIndex,AceRNewFly(caster,LoadReal(RBState,timerKey,7),LoadReal(RBState,timerKey,8),0.))
set groupIndex=groupIndex+1
endloop
set groupIndex=0
endif
if elapsed>=1.2 and elapsed<1.7 then
set groupIndex=0
loop
exitwhen groupIndex>=count
set carrier=LoadUnitHandle(RBState,timerKey,10+groupIndex)
set angle=(120.+spread*I2R(groupIndex))*bj_DEGTORAD
call SetUnitPosition(carrier,GetUnitX(carrier)+20.*Cos(angle),GetUnitY(carrier)+20.*Sin(angle))
set groupIndex=groupIndex+1
endloop
endif
// 1.7 s: every carrier becomes a fan of 10 fireflies
if elapsed>=1.7 and not LoadBoolean(RBState,timerKey,5) then
call SaveBoolean(RBState,timerKey,5,true)
set groupIndex=0
loop
exitwhen groupIndex>=count
set carrier=LoadUnitHandle(RBState,timerKey,10+groupIndex)
set flyIndex=0
loop
exitwhen flyIndex>9
set fly=AceRNewFly(caster,GetUnitX(carrier),GetUnitY(carrier),120.+spread*I2R(groupIndex)-spread/10.*5.+spread/10.*I2R(flyIndex+1))
call SetUnitFlyHeight(fly,GetRandomReal(300.,750.),1000.)
call SaveUnitHandle(RBState,timerKey,100+groupIndex*10+flyIndex,fly)
set flyIndex=flyIndex+1
endloop
call RemoveUnit(carrier)
set groupIndex=groupIndex+1
endloop
endif
if elapsed>=1.7 and elapsed<2.3 then
set groupIndex=0
loop
exitwhen groupIndex>=count
set flyIndex=0
loop
exitwhen flyIndex>9
set fly=AceRFly(timerKey,groupIndex,flyIndex)
set angle=GetUnitFacing(fly)*bj_DEGTORAD
call SetUnitPosition(fly,GetUnitX(fly)+20.*Cos(angle),GetUnitY(fly)+20.*Sin(angle))
set flyIndex=flyIndex+1
endloop
set groupIndex=groupIndex+1
endloop
endif
// 2.3 s: the targets (different random enemy heroes within 2600 of Ace)
if elapsed>=2.3 and not LoadBoolean(RBState,timerKey,6) then
call SaveBoolean(RBState,timerKey,6,true)
set pool=CreateGroup()
set nearby=CreateGroup()
call GroupEnumUnitsInRange(nearby,GetUnitX(caster),GetUnitY(caster),2600.,null)
loop
set target=FirstOfGroup(nearby)
exitwhen target==null
call GroupRemoveUnit(nearby,target)
if RBEnemy(caster,target) and IsUnitType(target,UNIT_TYPE_HERO) and IsUnitVisible(target,GetOwningPlayer(caster)) and not IsUnitType(target,UNIT_TYPE_MAGIC_IMMUNE) then
call GroupAddUnit(pool,target)
endif
endloop
set groupIndex=0
loop
exitwhen groupIndex>=count
set target=null
if FirstOfGroup(pool)!=null and GetWidgetLife(caster)>.405 then
set target=GroupPickRandomUnit(pool)
call GroupRemoveUnit(pool,target)
endif
if target==null then
call AceRRemoveGroup(timerKey,groupIndex)
else
set live=live+1
call SaveUnitHandle(RBState,timerKey,50+groupIndex,target)
set flyIndex=0
loop
exitwhen flyIndex>9
call SetUnitFlyHeight(AceRFly(timerKey,groupIndex,flyIndex),0.,GetRandomReal(600.,1500.))
set flyIndex=flyIndex+1
endloop
endif
set groupIndex=groupIndex+1
endloop
call DestroyGroup(pool)
call DestroyGroup(nearby)
set pool=null
set nearby=null
if live>0 then
call CreateTextTagUnitBJ("Hidaruma",caster,0,10.,100,100.,100.,0)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,1.)
call ShowTextTagForceBJ(false,bj_lastCreatedTextTag,t6(Condition(function Iex)))
call PlaySoundOnUnitBJ(sq,100,caster)
endif
set live=0
endif
// after 2.3 s: every group flies at its hero and explodes on it
if elapsed>2.3 then
set groupIndex=0
loop
exitwhen groupIndex>=count
if not LoadBoolean(RBState,timerKey,60+groupIndex) then
set target=LoadUnitHandle(RBState,timerKey,50+groupIndex)
if target==null or GetWidgetLife(target)<=.405 or GetUnitTypeId(caster)==0 then
call AceRRemoveGroup(timerKey,groupIndex)
else
set live=live+1
set flyIndex=0
loop
exitwhen flyIndex>9
set fly=AceRFly(timerKey,groupIndex,flyIndex)
set dx=GetUnitX(target)-GetUnitX(fly)
set dy=GetUnitY(target)-GetUnitY(fly)
set distance=SquareRoot(dx*dx+dy*dy)
if distance>25. then
call SetUnitPosition(fly,GetUnitX(fly)+25.*dx/distance,GetUnitY(fly)+25.*dy/distance)
call SetUnitFacing(fly,Atan2(dy,dx)*bj_RADTODEG)
endif
set flyIndex=flyIndex+1
endloop
set fly=AceRFly(timerKey,groupIndex,0)
set dx=GetUnitX(target)-GetUnitX(fly)
set dy=GetUnitY(target)-GetUnitY(fly)
if dx*dx+dy*dy<=14400. then
call DamageUnit(caster,target,LoadReal(RBState,timerKey,2),MAGICAL,SPELL)
if GetWidgetLife(target)>.405 then
call RBDoTBurn(caster,target,.5*GetHeroStr(caster,false),MAGICAL,.5,3)
endif
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",GetUnitX(target),GetUnitY(target)))
call DestroyEffect(AddSpecialEffect("war3mapImported\\ChaosExplosion.mdx",GetUnitX(target),GetUnitY(target)))
call RBAceStartStunBurn(caster,target)
call AceRRemoveGroup(timerKey,groupIndex)
endif
endif
endif
set groupIndex=groupIndex+1
endloop
endif
if elapsed>8.3 or (elapsed>2.3 and live==0) then
set groupIndex=0
loop
exitwhen groupIndex>=count
call AceRRemoveGroup(timerKey,groupIndex)
call RemoveUnit(LoadUnitHandle(RBState,timerKey,10+groupIndex))
set groupIndex=groupIndex+1
endloop
call FlushChildHashtable(RBState,timerKey)
call DestroyTimer(swarmTimer)
endif
set swarmTimer=null
set caster=null
set fly=null
set carrier=null
set target=null
endfunction
function Iix takes nothing returns nothing
local unit caster=GetTriggerUnit()
local timer swarmTimer=CreateTimer()
local integer timerKey=GetHandleId(swarmTimer)
local integer count=R2I(RBValue(GetUnitAbilityLevel(caster,'A033'),1.,2.,3.,3.,4.,4.))
if count<1 then
set count=1
endif
call SaveUnitHandle(RBState,timerKey,0,caster)
call SaveInteger(RBState,timerKey,1,count)
call SaveReal(RBState,timerKey,2,650.+150.*I2R(GetUnitAbilityLevel(caster,'A033')))
call SaveReal(RBState,timerKey,3,0.)
call SaveReal(RBState,timerKey,7,GetUnitX(caster))
call SaveReal(RBState,timerKey,8,GetUnitY(caster))
call SaveUnitHandle(RBState,timerKey,10,AceRNewFly(caster,GetUnitX(caster),GetUnitY(caster),120.))
call CreateTextTagUnitBJ("Hotarubi",caster,0,10.,100,100.,100.,0)
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,100.,90)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,.7)
call ShowTextTagForceBJ(false,bj_lastCreatedTextTag,t6(Condition(function ROx)))
call PlaySoundOnUnitBJ(ts,100,caster)
call TimerStart(swarmTimer,.03,true,function AceRTick)
set swarmTimer=null
set caster=null
endfunction
