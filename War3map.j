function RBIchigoStoreItems takes unit rbLocal48_sourceHero,integer rbLocal48_ownerIndex returns nothing
local integer rbLocal48_slot=0
local integer rbLocal48_itemType
local integer rbLocal48_baseType
local item rbLocal48_carriedItem
local item rbLocal48_normalizedItem
local boolean rbLocal48_questDrop
loop
exitwhen rbLocal48_slot>=6
set rbLocal48_carriedItem=UnitItemInSlot(rbLocal48_sourceHero,rbLocal48_slot)
if rbLocal48_carriedItem!=null then
set rbLocal48_questDrop=rbLocal48_carriedItem==oG and rbLocal48_sourceHero==T
call UnitRemoveItem(rbLocal48_sourceHero,rbLocal48_carriedItem)
if not rbLocal48_questDrop then
set rbLocal48_itemType=GetItemTypeId(rbLocal48_carriedItem)
set rbLocal48_baseType=rbLocal48_itemType
if rbLocal48_itemType=='I055' then
set rbLocal48_baseType='I00K'
elseif rbLocal48_itemType==HAOSHOKU_COOLDOWN_ITEM then
set rbLocal48_baseType=HAOSHOKU_ITEM
endif
if rbLocal48_baseType!=rbLocal48_itemType then
set rbLocal48_normalizedItem=CreateItem(rbLocal48_baseType,GetUnitX(rbLocal48_sourceHero),GetUnitY(rbLocal48_sourceHero))
call SetItemCharges(rbLocal48_normalizedItem,GetItemCharges(rbLocal48_carriedItem))
call SetItemUserData(rbLocal48_normalizedItem,GetItemUserData(rbLocal48_carriedItem))
call RemoveItem(rbLocal48_carriedItem)
set rbLocal48_carriedItem=rbLocal48_normalizedItem
endif
set RBIchigoPendingCount=RBIchigoPendingCount+1
set RBIchigoPendingItem[RBIchigoPendingCount]=rbLocal48_carriedItem
set RBIchigoPendingOwner[RBIchigoPendingCount]=rbLocal48_ownerIndex
set RBIchigoPendingSlot[RBIchigoPendingCount]=rbLocal48_slot
call SetItemVisible(rbLocal48_carriedItem,false)
endif
endif
set rbLocal48_slot=rbLocal48_slot+1
endloop
set rbLocal48_carriedItem=null
set rbLocal48_normalizedItem=null
endfunction
function RBIchigoRestoreItems takes unit rbLocal49_targetHero returns nothing
local integer rbLocal49_index=1
local integer rbLocal49_ownerIndex=GetPlayerId(GetOwningPlayer(rbLocal49_targetHero))
local item rbLocal49_carriedItem
local boolean rbLocal49_finished
if RBIchigoInventoryBusy then
return
endif
set RBIchigoInventoryBusy=true
loop
exitwhen rbLocal49_index>RBIchigoPendingCount
set rbLocal49_carriedItem=RBIchigoPendingItem[rbLocal49_index]
set rbLocal49_finished=rbLocal49_carriedItem==null or GetItemTypeId(rbLocal49_carriedItem)==0
if not rbLocal49_finished and RBIchigoPendingOwner[rbLocal49_index]==rbLocal49_ownerIndex then
if not IsItemOwned(rbLocal49_carriedItem) then
call SetItemVisible(rbLocal49_carriedItem,true)
call UnitAddItem(rbLocal49_targetHero,rbLocal49_carriedItem)
endif
if UnitHasItem(rbLocal49_targetHero,rbLocal49_carriedItem) then
call UnitDropItemSlot(rbLocal49_targetHero,rbLocal49_carriedItem,RBIchigoPendingSlot[rbLocal49_index])
endif
set rbLocal49_finished=GetItemTypeId(rbLocal49_carriedItem)==0 or IsItemOwned(rbLocal49_carriedItem)
if not rbLocal49_finished then
call SetItemVisible(rbLocal49_carriedItem,false)
endif
endif
if rbLocal49_finished then
call RBIchigoForgetItem(rbLocal49_index)
else
set rbLocal49_index=rbLocal49_index+1
endif
endloop
set RBIchigoInventoryBusy=false
set rbLocal49_carriedItem=null
endfunction
function Bladebane_ReturnDamage takes real returnedDamage returns nothing
local unit savedSource=Source
local unit savedTrueSource=TrueSource
local unit savedTarget=Target
local real savedDamage=Damage
local real savedPrimaryDamage=PrimaryDamage
local integer savedDamageMode=DamageMode
local integer savedDamageType=DamageType
local integer savedSystemMode=DamageSystem_DamageMode
set BladebaneReturning=true
call DamageUnit(savedTarget,savedSource,returnedDamage,CLEAN,SPELL)
set BladebaneReturning=false
set Source=savedSource
set TrueSource=savedTrueSource
set Target=savedTarget
set Damage=savedDamage
set PrimaryDamage=savedPrimaryDamage
set DamageMode=savedDamageMode
set DamageType=savedDamageType
set DamageSystem_DamageMode=savedSystemMode
set savedSource=null
set savedTrueSource=null
set savedTarget=null
endfunction
function Bladebane_Reflect takes nothing returns nothing
if not BladebaneReturning and Damage>0. and Source!=Target and GetWidgetLife(Source)>.405 then
if IsUnitInGroup(Target,dn) then
call Bladebane_ReturnDamage(Damage*BLADEBANE_ACTIVE_RETURN)
elseif UnitHasItemOfTypeBJ(Target,'IB01') and not IsUnitIllusion(Target) then
call Bladebane_ReturnDamage(Damage*BUSOSHOKU_PASSIVE_RETURN)
elseif UnitHasItemOfTypeBJ(Target,$49303441) and not IsUnitIllusion(Target) then
call Bladebane_ReturnDamage(Damage*BLADEBANE_PASSIVE_RETURN)
endif
endif
endfunction
