return IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(GetAttacker())) and GetBooleanAnd(LFv(),Lgv()) and (UnitHasItemOfTypeBJ(GetAttacker(),$49303039) or UnitHasItemOfTypeBJ(GetAttacker(),'IY01')) and UnitHasBuffBJ(GetAttacker(),$42303034)==false
endfunction
