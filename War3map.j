endfunction
function LHv takes nothing returns nothing
if Lhv() then
call SetWidgetLife(GetAttacker(),GetUnitStateSwap(UNIT_STATE_LIFE,GetAttacker())-.09*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetAttacker()))
else
call SetWidgetLife(GetAttacker(),1.)
endif
endfunction
