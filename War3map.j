function AceV_Cond takes nothing returns boolean
return GetSpellAbilityId()==$41304550 and SilenceConditions(GetTriggerUnit())
endfunction
function ShortPeriodicEffect_Filter takes nothing returns nothing
local real amount=0
set Hero=GetEnumUnit()
if GetWidgetLife(Hero)>.405 and GetUnitTypeId(Hero)!=0 then
if GetUnitAbilityLevel(Hero,$42303041)==1 then
set amount=amount+GetUnitState(Hero,UNIT_STATE_MAX_LIFE)*.1*.25
call SetUnitState(Hero,UNIT_STATE_MANA,GetUnitState(Hero,UNIT_STATE_MANA)+GetUnitState(Hero,UNIT_STATE_MAX_MANA)*.1*.25)
endif
call SetWidgetLife(Hero,GetWidgetLife(Hero)+amount)
if GetUnitCustomPropertyValue(Hero,"mamaragancd")>0 then
call SetUnitCustomPropertyValue(Hero,"mamaragancd",GetUnitCustomPropertyValue(Hero,"mamaragancd")-.25)
endif
endif
endfunction
function ShortPeriodicEffect takes nothing returns nothing
call ForGroup(HeroesGroup,function ShortPeriodicEffect_Filter)
if GlobalHexCooldownTeamOne>0 then
set GlobalHexCooldownTeamOne=GlobalHexCooldownTeamOne-.25
endif
if GlobalHexCooldownTeamTwo>0 then
set GlobalHexCooldownTeamTwo=GlobalHexCooldownTeamTwo-.25
endif
endfunction
function UltimaSwordGroupActions takes nothing returns nothing
call DamageUnit(RadianceSource,GetEnumUnit(),RadianceDamage,CLEAN,UNKNOWN)
if not IsUnitInGroup(GetEnumUnit(),UltimaSwordEffectGroup) and not IsUnitPaused(GetEnumUnit()) then
call GroupAddUnit(UltimaSwordEffectGroup,GetEnumUnit())
call DestroyEffect(AddSpecialEffectTarget(RadianceEffectPath,GetEnumUnit(),"chest"))
endif
endfunction
function RadianceGroupActions takes nothing returns nothing
call DamageUnit(RadianceSource,GetEnumUnit(),RadianceDamage,CLEAN,UNKNOWN)
if not IsUnitInGroup(GetEnumUnit(),RadianceEffectGroup) and not IsUnitPaused(GetEnumUnit()) then
call GroupAddUnit(RadianceEffectGroup,GetEnumUnit())
call DestroyEffect(AddSpecialEffectTarget(RadianceEffectPath,GetEnumUnit(),"chest"))
endif
endfunction
function SecondPeriodicEffect_Filter takes nothing returns nothing
set Hero=GetEnumUnit()
set RadianceSource=Hero
if GetWidgetLife(Hero)>.405 and GetUnitTypeId(Hero)!=0 and not IsUnitIllusion(Hero) and not IsUnitType(Hero,UNIT_TYPE_DEAD) then
if UnitHasItemOfTypeBJ(Hero,$49303153) then
call SortEnemiesInRange(Hero,GetUnitX(Hero),GetUnitY(Hero),600)
set RadianceDamage=300
set RadianceEffectPath="Abilities\\Spells\\Undead\\OrbOfDeath\\OrbOfDeathMissile.mdl"
call ForGroup(TempGroup,function UltimaSwordGroupActions)
else
if UnitHasItemOfTypeBJ(Hero,$4930304D) then
call SortEnemiesInRange(Hero,GetUnitX(Hero),GetUnitY(Hero),600)
set RadianceDamage=80
set RadianceEffectPath="Abilities\\Weapons\\FaerieDragonMissile\\FaerieDragonMissile.mdl"
call ForGroup(TempGroup,function RadianceGroupActions)
endif
endif
endif
endfunction
function SecondPeriodicEffect takes nothing returns nothing
call GroupClear(RadianceEffectGroup)
call GroupClear(UltimaSwordEffectGroup)
call ForGroup(HeroesGroup,function SecondPeriodicEffect_Filter)
endfunction
function DuobleClickCast takes nothing returns nothing
// Force Boots: double click on the boots casts Force Rush on yourself
if GetSpellTargetItem()!=null and GetSpellAbilityId()=='ABF0' then
if GetItemTypeId(GetSpellTargetItem())=='I06L' and UnitHasItem(GetTriggerUnit(),GetSpellTargetItem()) then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
call UnitUseItemTarget(GetTriggerUnit(),GetSpellTargetItem(),GetTriggerUnit())
else
call IssueImmediateOrder(GetTriggerUnit(),"stop")
endif
endif
if GetSpellTargetItem()!=null and GetSpellAbilityId()==$41304456 then
if GetItemTypeId(GetSpellTargetItem())==$49303448 and UnitHasItem(GetTriggerUnit(),GetSpellTargetItem()) then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
call UnitUseItemTarget(GetTriggerUnit(),GetItemOfTypeFromUnitBJ(Hero,$49303448),GetTriggerUnit())
else
call IssueImmediateOrder(GetTriggerUnit(),"stop")
endif
endif
endfunction
function PlaySilenceEffectOnUnit takes nothing returns nothing
local effect targetEffect=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Silence\\SilenceTarget.mdl",Hero,"overhead")
call TriggerSleepAction(.75)
call DestroyEffect(targetEffect)
set targetEffect=null
endfunction
function SleepcastConditions takes unit caster returns boolean
return GetUnitAbilityLevel(caster,$42306878)==0
endfunction
function BvOCanUseKumaItems takes unit itemUser returns boolean
local integer unitType=GetUnitTypeId(itemUser)
// Unohana and Luffy (also in Gear 2) can not use Kuma's Unique Book nor Teleportation boots
if unitType=='HN00' or unitType=='HN01' or unitType=='HU00' or unitType=='N002' or unitType=='N00C' or unitType=='U00S' or unitType=='U00T' or unitType=='U005' or unitType=='U006' or unitType=='U007' or unitType=='U008' then
return false
endif
return unitType=='O004' or BvOSusanoType(unitType) or unitType=='U009' or unitType=='HZ00' or unitType=='HT00' or unitType=='HW00' or unitType=='HP00' or unitType=='HE00' or unitType==$45303030 or unitType==$4E303054 or unitType==$4E303032 or unitType==$4E303039 or unitType==$4E303053 or unitType==$4E303055 or unitType==$45303031 or unitType==$4E303033 or unitType==$4E303037 or unitType==$4E303034 or unitType==$4E303035 or unitType==$4E303038 or unitType==$4E303052 or unitType==$4E303030 or unitType==$48303034 or unitType==$48303055 or unitType==$45303034 or unitType=='HS00' or unitType=='HL00' or unitType=='HD00' or GetUnitAbilityLevel(itemUser,$41303854)>0
endfunction
function KumaItemIsRestricted takes integer itemType returns boolean
return itemType==$64657363 or itemType==$49303536 or itemType==$49303544
endfunction
function KumaItemAudit takes nothing returns nothing
local timer auditTimer=GetExpiredTimer()
local unit itemOwner=LoadUnitHandle(KumaItemHash,GetHandleId(auditTimer),0)
local integer ownerKey=GetHandleId(itemOwner)
local integer refundsLeft=LoadInteger(KumaItemHash,ownerKey,1)
local item soldItem=LoadItemHandle(KumaItemHash,ownerKey,2)
local integer slotIndex=0
local item slotItem
local boolean itemRejected=false
loop
exitwhen slotIndex>5
set slotItem=UnitItemInSlot(itemOwner,slotIndex)
if slotItem!=null and KumaItemIsRestricted(GetItemTypeId(slotItem)) then
if refundsLeft>0 and GetItemTypeId(slotItem)!=$49303544 then
call RemoveItem(slotItem)
call AdjustPlayerStateBJ(2500,GetOwningPlayer(itemOwner),PLAYER_STATE_RESOURCE_GOLD)
set refundsLeft=refundsLeft-1
else
call UnitRemoveItem(itemOwner,slotItem)
endif
set itemRejected=true
endif
set slotIndex=slotIndex+1
endloop
if refundsLeft>0 and soldItem!=null and GetItemTypeId(soldItem)!=0 then
call RemoveItem(soldItem)
call AdjustPlayerStateBJ(2500,GetOwningPlayer(itemOwner),PLAYER_STATE_RESOURCE_GOLD)
set itemRejected=true
endif
if itemRejected and GetOwningPlayer(itemOwner)==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00Your hero cannot use this item!|r")
endif
call FlushChildHashtable(KumaItemHash,ownerKey)
call FlushChildHashtable(KumaItemHash,GetHandleId(auditTimer))
call DestroyTimer(auditTimer)
set auditTimer=null
set itemOwner=null
set soldItem=null
set slotItem=null
endfunction
function KumaItemScheduleAudit takes unit itemOwner returns nothing
local timer auditTimer
if LoadBoolean(KumaItemHash,GetHandleId(itemOwner),3) then
return
endif
call SaveBoolean(KumaItemHash,GetHandleId(itemOwner),3,true)
set auditTimer=CreateTimer()
call SaveUnitHandle(KumaItemHash,GetHandleId(auditTimer),0,itemOwner)
call TimerStart(auditTimer,0.,false,function KumaItemAudit)
set auditTimer=null
endfunction
function KumaItemOnPickup takes nothing returns boolean
local unit itemOwner=GetManipulatingUnit()
if IsUnitType(itemOwner,UNIT_TYPE_HERO) and KumaItemIsRestricted(GetItemTypeId(GetManipulatedItem())) and not BvOCanUseKumaItems(itemOwner) then
call KumaItemScheduleAudit(itemOwner)
endif
set itemOwner=null
return false
endfunction
function KumaItemOnSell takes nothing returns boolean
local unit itemBuyer=GetBuyingUnit()
local integer soldType=GetItemTypeId(GetSoldItem())
// only one of Kuma's Unique Book / Teleportation boots: a second one can not be bought
if IsUnitType(itemBuyer,UNIT_TYPE_HERO) and soldType=='I04Z' and (UnitHasItemOfTypeBJ(itemBuyer,$64657363) or UnitHasItemOfTypeBJ(itemBuyer,$49303536) or UnitHasItemOfTypeBJ(itemBuyer,$49303544)) then
call RemoveItem(GetSoldItem())
call AdjustPlayerStateBJ(2500,GetOwningPlayer(itemBuyer),PLAYER_STATE_RESOURCE_GOLD)
if GetOwningPlayer(itemBuyer)==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00You can only have one Kuma's Unique Book or Teleportation boots!|r")
endif
set itemBuyer=null
return false
endif
if soldType=='I04Z' then
if not IsUnitType(itemBuyer,UNIT_TYPE_HERO) or not BvOCanUseKumaItems(itemBuyer) then
call RemoveItem(GetSoldItem())
call AdjustPlayerStateBJ(2500,GetOwningPlayer(itemBuyer),PLAYER_STATE_RESOURCE_GOLD)
if GetOwningPlayer(itemBuyer)==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00Your hero cannot buy Kuma's Unique Book.|r")
endif
else
call UnitAddItemByIdSwapped($64657363,itemBuyer)
endif
set itemBuyer=null
return false
endif
if (GetUnitTypeId(itemBuyer)=='HN00' or GetUnitTypeId(itemBuyer)=='HN01' or GetUnitTypeId(itemBuyer)=='HU00' or GetUnitTypeId(itemBuyer)=='N002' or GetUnitTypeId(itemBuyer)=='N00C' or GetUnitTypeId(itemBuyer)=='U00S' or BvOIkkakuBankai(itemBuyer)) and (soldType==$49303545 or soldType==$49303544 or soldType==$49303646) then
if soldType==$49303545 then
call AdjustPlayerStateBJ(4000,GetOwningPlayer(itemBuyer),PLAYER_STATE_RESOURCE_GOLD)
elseif soldType==$49303544 then
call AdjustPlayerStateBJ(8060,GetOwningPlayer(itemBuyer),PLAYER_STATE_RESOURCE_GOLD)
else
call AdjustPlayerStateBJ(4000,GetOwningPlayer(itemBuyer),PLAYER_STATE_RESOURCE_GOLD)
endif
call RemoveItem(GetSoldItem())
if GetOwningPlayer(itemBuyer)==GetLocalPlayer() then
if GetUnitTypeId(itemBuyer)=='HU00' then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00Unohana cannot buy Teleportation boots: she already has Shunpo.|r")
elseif GetUnitTypeId(itemBuyer)=='HN00' or GetUnitTypeId(itemBuyer)=='HN01' then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00Nell cannot buy Teleportation boots: she already has Sonido.|r")
elseif GetUnitTypeId(itemBuyer)=='U00S' or BvOIkkakuBankai(itemBuyer) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00Ikkaku cannot buy Teleportation boots: he already has Shunpo.|r")
else
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00Luffy cannot buy Teleportation boots.|r")
endif
endif
set itemBuyer=null
return false
endif
if IsUnitType(itemBuyer,UNIT_TYPE_HERO) and (soldType==$64657363 or soldType==$49303536) and not BvOCanUseKumaItems(itemBuyer) then
call SaveInteger(KumaItemHash,GetHandleId(itemBuyer),1,LoadInteger(KumaItemHash,GetHandleId(itemBuyer),1)+1)
call SaveItemHandle(KumaItemHash,GetHandleId(itemBuyer),2,GetSoldItem())
call KumaItemScheduleAudit(itemBuyer)
endif
set itemBuyer=null
return false
endfunction
function KumaItemRulesInit takes nothing returns nothing
local trigger pickupTrigger=CreateTrigger()
local trigger sellTrigger=CreateTrigger()
set KumaItemHash=InitHashtable()
call TriggerRegisterAnyUnitEventBJ(pickupTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(pickupTrigger,Condition(function KumaItemOnPickup))
call TriggerRegisterAnyUnitEventBJ(sellTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(sellTrigger,Condition(function KumaItemOnSell))
set pickupTrigger=null
set sellTrigger=null
endfunction
function ItemAbilityControl takes nothing returns boolean
if not SilenceConditions(GetTriggerUnit()) then
set Hero=GetTriggerUnit()
call IssueImmediateOrder(Hero,"stop")
call ExecuteFunc("PlaySilenceEffectOnUnit")
endif
if GetSpellAbilityId()==$41304342 and GetSpellTargetUnit()!=null then
if IsUnitPaused(GetSpellTargetUnit()) then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
if GetOwningPlayer(GetTriggerUnit())==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00You cannot cast on this target now!|r")
endif
endif
endif
if GetSpellAbilityId()=='AHX0' then
if GetPlayerId(GetOwningPlayer(GetTriggerUnit()))<5 then
if GlobalHexCooldownTeamOne>0 then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
if GetOwningPlayer(GetTriggerUnit())==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Global Hex team |cffc3dbffcooldown: |r"+R2S(GlobalHexCooldownTeamOne))
endif
endif
else
if GlobalHexCooldownTeamTwo>0 then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
if GetOwningPlayer(GetTriggerUnit())==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Global Hex team |cffc3dbffcooldown: |r"+R2S(GlobalHexCooldownTeamTwo))
endif
endif
endif
endif
if GetSpellAbilityId()==$41304439 or GetSpellAbilityId()==$4149626B or GetSpellAbilityId()==$41304455 then
if not BvOCanUseKumaItems(GetTriggerUnit()) then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
if GetOwningPlayer(GetTriggerUnit())==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00Your hero cannot use this item!|r")
endif
elseif (GetSpellAbilityId()==$41304439 or GetSpellAbilityId()==$4149626B) and UnitHasItemOfTypeBJ(GetTriggerUnit(),$49303544) then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
if GetOwningPlayer(GetTriggerUnit())==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00Please use your boots!|r")
endif
endif
endif
return false
endfunction
function ForceStaff_TimerActions takes nothing returns nothing
local integer timerId=GetHandleId(GetExpiredTimer())
local unit target=LoadUnitHandle(Hash,timerId,StringHash("target"))
local real angle=LoadReal(Hash,timerId,StringHash("angle"))
local real speed=1600*.02
local real newX
local real newY
if target!=null and LoadReal(Hash,timerId,StringHash("distance"))>0 then
set newX=GetUnitX(target)+125*Cos(angle*bj_DEGTORAD)
set newY=GetUnitY(target)+125*Sin(angle*bj_DEGTORAD)
if not IsTerrainPathable(newX,newY,PATHING_TYPE_WALKABILITY) then
set newX=GetUnitX(target)+speed*Cos(angle*bj_DEGTORAD)
set newY=GetUnitY(target)+speed*Sin(angle*bj_DEGTORAD)
call SetUnitX(target,newX)
call SetUnitY(target,newY)
call DestroyDestructable(150,Location(newX,newY))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",newX,newY))
call SaveReal(Hash,timerId,StringHash("distance"),LoadReal(Hash,timerId,StringHash("distance"))-speed)
else
call FlushChildHashtable(Hash,timerId)
call PauseTimer(GetExpiredTimer())
call DestroyTimer(GetExpiredTimer())
endif
else
call FlushChildHashtable(Hash,timerId)
call PauseTimer(GetExpiredTimer())
call DestroyTimer(GetExpiredTimer())
endif
set target=null
endfunction
function IsUnitCanMove takes unit target returns boolean
return GetUnitAbilityLevel(target,$42303259)==0 and GetUnitAbilityLevel(target,$4230325A)==0 and GetUnitAbilityLevel(target,$42303031)==0 and GetUnitAbilityLevel(target,$42303030)==0 and GetUnitAbilityLevel(target,$4230314E)==0 and GetUnitAbilityLevel(target,$4230314F)==0 and GetUnitAbilityLevel(target,$42303032)==0 and GetUnitAbilityLevel(target,$42303033)==0
endfunction
// pushes the unit 800 in the direction it is facing (Force Staff, and Force Rush of Force Boots)
function ForceStaffPush takes unit pushTarget returns nothing
local timer spellTimer
local integer timerId
if pushTarget!=null and IsUnitCanMove(pushTarget) and not IsUnitPaused(pushTarget) and GetWidgetLife(pushTarget)>.405 then
set spellTimer=CreateTimer()
set timerId=GetHandleId(spellTimer)
call SaveUnitHandle(Hash,timerId,StringHash("target"),pushTarget)
call SaveReal(Hash,timerId,StringHash("distance"),800)
call SaveReal(Hash,timerId,StringHash("angle"),GetUnitFacing(pushTarget))
call TimerStart(spellTimer,.02,true,function ForceStaff_TimerActions)
endif
set spellTimer=null
endfunction
function ForceStaff_Actions takes nothing returns nothing
call ForceStaffPush(GetSpellTargetUnit())
endfunction
function ForceStaff_Cond takes nothing returns boolean
return GetSpellAbilityId()==$41304456 and SilenceConditions(GetTriggerUnit())
endfunction
function ForceBoots_TimerActions takes nothing returns nothing
local integer timerId=GetHandleId(GetExpiredTimer())
local unit target=LoadUnitHandle(Hash,timerId,StringHash("target"))
local real speed=278*.02
local real newX=LoadReal(Hash,timerId,StringHash("unitX"))
local real newY=LoadReal(Hash,timerId,StringHash("unitY"))
if target!=null and GetWidgetLife(target)>.405 and UnitHasBuffBJ(target,$42303254) and not IsUnitPaused(target) then
set newX=GetUnitX(target)+125*Cos(GetUnitFacing(target)*bj_DEGTORAD)
set newY=GetUnitY(target)+125*Sin(GetUnitFacing(target)*bj_DEGTORAD)
if GetUnitX(target)!=newX or GetUnitY(target)!=newY then
set newX=GetUnitX(target)+speed*Cos(GetUnitFacing(target)*bj_DEGTORAD)
set newY=GetUnitY(target)+speed*Sin(GetUnitFacing(target)*bj_DEGTORAD)
if not IsTerrainPathable(newX,newY,PATHING_TYPE_WALKABILITY) then
call SetUnitX(target,newX)
call SetUnitY(target,newY)
call DestroyDestructable(150,Location(newX,newY))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",newX,newY))
endif
call SaveReal(Hash,timerId,StringHash("unitX"),GetUnitX(target))
call SaveReal(Hash,timerId,StringHash("unitY"),GetUnitY(target))
endif
else
call FlushChildHashtable(Hash,timerId)
call PauseTimer(GetExpiredTimer())
call DestroyTimer(GetExpiredTimer())
endif
set target=null
endfunction
// Force Rush: the Wind Walk of the boots (A0DY) does not always give its speed on the first use, so the script sets
// the hero to the maximum speed (522) for the 2.5 seconds itself and then gives the base speed back
function ForceBoots_End takes nothing returns nothing
local timer rushTimer=GetExpiredTimer()
local integer timerId=GetHandleId(rushTimer)
local unit target=LoadUnitHandle(Hash,timerId,StringHash("target"))
if LoadInteger(Hash,GetHandleId(target),StringHash("forceRushTimer"))==timerId then
call RemoveSavedInteger(Hash,GetHandleId(target),StringHash("forceRushTimer"))
if GetUnitTypeId(target)!=0 then
call SetUnitMoveSpeed(target,GetUnitDefaultMoveSpeed(target))
endif
endif
call FlushChildHashtable(Hash,timerId)
call DestroyTimer(rushTimer)
set rushTimer=null
set target=null
endfunction
// Force Rush (ABF0) of Force Boots is cast on a unit like Force Staff: the target is pushed forward;
// the caster himself or an ally also gets the maximum speed (522) for 2.5 seconds with the Force Rush status
function ForceBoots_Actions takes nothing returns nothing
local unit target=GetSpellTargetUnit()
if target!=null then
call ForceStaffPush(target)
endif
set target=null
endfunction
function ForceBoots_Cond takes nothing returns boolean
return GetSpellAbilityId()=='ABF0' and SilenceConditions(GetTriggerUnit())
endfunction
function Unbreake_Actions takes nothing returns nothing
local unit target=GetTriggerUnit()
call CastToTarget(target,target,$41304530,1,"slow")
call UnitAddAbility(target,$41304557)
call UnitMakeAbilityPermanent(target,true,$41304557)
call SetUnitVertexColorBJ(target,20.,20.,20.,0)
call TriggerSleepAction(3)
if target!=null then
call SetUnitVertexColorBJ(target,100.,100.,100.,0)
call UnitRemoveAbility(target,$41304557)
call UnitRemoveBuffBJ($42303255,target)
endif
set target=null
endfunction
function Unbreake_Cond takes nothing returns boolean
return GetSpellAbilityId()==$4130445A and SilenceConditions(GetTriggerUnit())
endfunction
function UnitItemCount takes unit whichUnit,integer itemId returns integer
local integer index=0
local integer count=0
loop
if GetItemTypeId(UnitItemInSlot(whichUnit,index))==itemId then
set count=count+1
endif
set index=index+1
exitwhen index>=bj_MAX_INVENTORY
endloop
return count
endfunction
function DFruitCraft takes nothing returns nothing
local timer craftTimer=GetExpiredTimer()
local integer key=GetHandleId(craftTimer)
local unit holder=LoadUnitHandle(Hash,key,0)
local item recipe=LoadItemHandle(Hash,key,1)
local boolean receipt=LoadBoolean(Hash,key,2)
if holder!=null and GetUnitTypeId(holder)!=0 and GetItemTypeId(recipe)=='IFD3' and (UnitHasItem(holder,recipe) or (receipt and not IsItemOwned(recipe))) then
if UnitHasItemOfTypeBJ(holder,'I002') and UnitHasItemOfTypeBJ(holder,'I003') and UnitHasItemOfTypeBJ(holder,'I005') then
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,'I002'))
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,'I003'))
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,'I005'))
call RemoveItem(recipe)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl",holder,"origin"))
call UnitAddItemByIdSwapped('IFD1',holder)
elseif receipt then
call SetItemVisible(recipe,true)
if not UnitAddItem(holder,recipe) then
call SetItemPosition(recipe,GetUnitX(holder),GetUnitY(holder))
endif
endif
endif
call FlushChildHashtable(Hash,key)
call DestroyTimer(craftTimer)
set craftTimer=null
set holder=null
set recipe=null
endfunction
function DFruitQueue takes unit holder,item recipe,boolean receipt returns nothing
local timer craftTimer
if GetItemTypeId(recipe)!='IFD3' then
return
endif
set craftTimer=CreateTimer()
call SaveUnitHandle(Hash,GetHandleId(craftTimer),0,holder)
call SaveItemHandle(Hash,GetHandleId(craftTimer),1,recipe)
call SaveBoolean(Hash,GetHandleId(craftTimer),2,receipt)
call TimerStart(craftTimer,0.,false,function DFruitCraft)
set craftTimer=null
endfunction
function DFruitBuy takes unit holder returns nothing
local item recipe=CreateItem('IFD3',GetUnitX(holder),GetUnitY(holder))
call SetItemVisible(recipe,false)
call DFruitQueue(holder,recipe,true)
set recipe=null
endfunction
function HeroBuyItem takes nothing returns nothing
local unit recipeHero=GetBuyingUnit()
set Hero=recipeHero
if GetItemTypeId(GetSoldItem())=='IFD4' then
call DFruitBuy(recipeHero)
endif
if (GetUnitTypeId(recipeHero)=='HU00' or GetUnitTypeId(recipeHero)=='N002' or GetUnitTypeId(recipeHero)=='N00C') and GetItemTypeId(GetSoldItem())==$49303545 then
set recipeHero=null
return
endif
// only one Teleportation boots: they (or their recipe) can not be bought again while the hero has them
if (GetItemTypeId(GetSoldItem())==$49303545 or GetItemTypeId(GetSoldItem())==$49303646) and UnitHasItemOfTypeBJ(recipeHero,$49303544) then
if GetItemTypeId(GetSoldItem())==$49303545 then
call AdjustPlayerStateBJ(4000,GetOwningPlayer(recipeHero),PLAYER_STATE_RESOURCE_GOLD)
else
call AdjustPlayerStateBJ(4000,GetOwningPlayer(recipeHero),PLAYER_STATE_RESOURCE_GOLD)
endif
call RemoveItem(GetSoldItem())
if GetOwningPlayer(recipeHero)==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00You can only have one Kuma's Unique Book or Teleportation boots!|r")
endif
set recipeHero=null
return
endif
if GetItemTypeId(GetSoldItem())==$49303539 then
call UnitAddItemByIdSwapped($49303537,recipeHero)
endif
if GetItemTypeId(GetSoldItem())==$49303545 then
if UnitHasItemOfTypeBJ(recipeHero,$49303536) or UnitHasItemOfTypeBJ(recipeHero,$64657363) and UnitHasItemOfTypeBJ(recipeHero,$49303043) then
if UnitHasItemOfTypeBJ(recipeHero,$49303536) then
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303536))
else
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$64657363))
endif
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303043))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl",recipeHero,"origin"))
call UnitAddItemByIdSwapped($49303544,recipeHero)
else
call UnitAddItemByIdSwapped($49303646,recipeHero)
endif
endif
if GetItemTypeId(GetSoldItem())==$49303649 then
if UnitHasItemOfTypeBJ(recipeHero,$49303043) and UnitHasItemOfTypeBJ(recipeHero,$49303448) then
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303043))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303448))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl",recipeHero,"origin"))
call UnitAddItemByIdSwapped($4930364C,recipeHero)
else
call UnitAddItemByIdSwapped($4930364D,recipeHero)
endif
endif
if GetItemTypeId(GetSoldItem())==$4930364F then
if UnitHasItemOfTypeBJ(recipeHero,$49303043) and UnitHasItemOfTypeBJ(recipeHero,$49303152) then
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303043))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303152))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl",recipeHero,"origin"))
call UnitAddItemByIdSwapped($4930364E,recipeHero)
else
call UnitAddItemByIdSwapped($49303650,recipeHero)
endif
endif
if GetItemTypeId(GetSoldItem())==$49303756 then
if UnitHasItemOfTypeBJ(recipeHero,$49303152) and UnitHasItemOfTypeBJ(recipeHero,$49303339) then
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303152))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303339))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\OrbOfDeath\\OrbOfDeathMissile.mdl",recipeHero,"origin"))
call UnitAddItemByIdSwapped($49303651,recipeHero)
else
call UnitAddItemByIdSwapped($49303759,recipeHero)
endif
endif
set Hero=recipeHero
set recipeHero=null
endfunction
function HeroGetItem takes nothing returns nothing
local unit recipeHero=GetTriggerUnit()
set Hero=recipeHero
call DFruitQueue(recipeHero,GetItemOfTypeFromUnitBJ(recipeHero,'IFD3'),false)
if UnitHasItemOfTypeBJ(recipeHero,$49303459) and UnitHasItemOfTypeBJ(recipeHero,$49303130) and UnitHasItemOfTypeBJ(recipeHero,$4930305A) then
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303459))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303130))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$4930305A))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",recipeHero,"origin"))
