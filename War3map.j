set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(LoadUnitHandle(ULQ_HashTable,-12170,this)),0x6D303132,GetUnitX(LoadUnitHandle(ULQ_HashTable,-12170,this)),GetUnitY(LoadUnitHandle(ULQ_HashTable,-12170,this)),LoadReal(ULQ_HashTable,-12174,this)*bj_RADTODEG)
