function Dfx takes nothing returns nothing
set jf[12]=GetTriggerUnit()
set kf[6]=GetUnitLoc(jf[12])
call PlaySoundAtPointBJ(vRv,100,kf[6],0)
set uf=null
call CreateNUnitsAtLoc(1,$6E303056,GetOwningPlayer(jf[12]),kf[6],GetRandomReal(0,360))
set uf=bj_lastCreatedUnit
call SaveUnitHandle(RBState,GetHandleId(uf),212,jf[12])
// the trap is armed 1 second after it is placed
call SaveReal(RBState,GetHandleId(uf),213,TimerGetElapsed(AYClock)+1.)
// Mine explosion is handled by its proximity callback.
call UnitApplyTimedLifeBJ(20.,$42544C46,uf)
set jf[12]=null
call RemoveLocation(kf[6])
set kf[6]=null
// Instant arming.
set yf=true
endfunction
