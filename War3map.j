set I[1+GetPlayerId(GetTriggerPlayer())]=m[1+GetPlayerId(GetTriggerPlayer())]
call PauseUnit(m[1+GetPlayerId(GetTriggerPlayer())],true)
call AddSpecialEffectTargetUnitBJ("origin",m[1+GetPlayerId(GetTriggerPlayer())],"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTo.mdl")
set K[1+GetPlayerId(GetTriggerPlayer())]=bj_lastCreatedEffect
call DisplayTextToForce(m6(GetTriggerPlayer()),"Please wait for 15 seconds...")
endif
call TriggerSleepAction(15.)
if Max() then
call DestroyEffect(K[1+GetPlayerId(GetTriggerPlayer())])
call PauseUnit(m[1+GetPlayerId(GetTriggerPlayer())],false)
call SetUnitPositionLoc(m[1+GetPlayerId(GetTriggerPlayer())],GetUnitLoc(mG))
call AddSpecialEffectTargetUnitBJ("origin",m[1+GetPlayerId(GetTriggerPlayer())],"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl")
call DestroyEffect(bj_lastCreatedEffect)
call PanCameraToTimedLocForPlayer(GetTriggerPlayer(),GetUnitLoc(m[1+GetPlayerId(GetTriggerPlayer())]),0)
call SetUnitInvulnerable(m[1+GetPlayerId(GetTriggerPlayer())],false)
call SetUnitTimeScalePercent(m[1+GetPlayerId(GetTriggerPlayer())],100)
call SetUnitVertexColorBJ(m[1+GetPlayerId(GetTriggerPlayer())],100,100,100,0)
else
call DestroyEffect(K[1+GetPlayerId(GetTriggerPlayer())])
endif
call TriggerSleepAction(.01)
set J[1+GetPlayerId(GetTriggerPlayer())]=false
endfunction
