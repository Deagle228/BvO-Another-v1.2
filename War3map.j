function InoeT_TimerActioins takes nothing returns nothing
local timer inoueFieldTimer=GetExpiredTimer()
local integer inoueFieldId=GetHandleId(inoueFieldTimer)
local unit inoueCaster=L_U(inoueFieldId,"caster")
local unit inoueVisual=L_U(inoueFieldId,"dummy")
local real inoueHeal=L_R(inoueFieldId,"healAmount")
local real inoueDamage=L_R(inoueFieldId,"damageAmount")
local real inoueTime=L_R(inoueFieldId,"time")+.03
local real inouePeriod=L_R(inoueFieldId,"period")+.03
local real inoueControlPeriod=L_R(inoueFieldId,"controlPeriod")+.03
local real inoueFieldX=L_R(inoueFieldId,"fieldX")
local real inoueFieldY=L_R(inoueFieldId,"fieldY")
local real inoueTargetX
local real inoueTargetY
local boolean inoueDamageTick=inouePeriod>=L_R(inoueFieldId,"damagePeriodic")
local boolean inoueRefreshControl=inoueControlPeriod>=.12
local group inoueTargets=CreateGroup()
local group inoueEnemies=L_G(inoueFieldId,"enemies")
local unit inoueTarget
local integer inoueTargetId
if inoueTime>L_R(inoueFieldId,"duration")+.0001 or GetUnitTypeId(inoueCaster)==0 then
call InoueTRemoveField(inoueFieldTimer)
call GroupAddGroup(inoueEnemies,inoueTargets)
loop
set inoueTarget=FirstOfGroup(inoueTargets)
exitwhen inoueTarget==null
call GroupRemoveUnit(inoueTargets,inoueTarget)
if not InoueTContainsTarget(inoueTarget) then
call InoueTReleaseControl(inoueTarget)
endif
endloop
call DestroyGroup(inoueEnemies)
call RemoveUnit(inoueVisual)
call FlushChildHashtable(Hash,inoueFieldId)
call PauseTimer(inoueFieldTimer)
call DestroyTimer(inoueFieldTimer)
else
call GroupEnumUnitsInRange(inoueTargets,inoueFieldX,inoueFieldY,610.,null)
loop
set inoueTarget=FirstOfGroup(inoueTargets)
exitwhen inoueTarget==null
call GroupRemoveUnit(inoueTargets,inoueTarget)
if GetUnitTypeId(inoueTarget)!=0 and GetWidgetLife(inoueTarget)>.405 and not IsUnitType(inoueTarget,UNIT_TYPE_STRUCTURE) and GetUnitAbilityLevel(inoueTarget,'Aloc')==0 then
if IsUnitEnemy(inoueTarget,GetOwningPlayer(inoueCaster)) then
if not IsUnitInGroup(inoueTarget,inoueEnemies) then
call GroupAddUnit(inoueEnemies,inoueTarget)
call GroupAddUnit(InoueTCleanupUnits,inoueTarget)
set inoueTargetId=GetHandleId(inoueTarget)
call S_R(inoueFieldId,"lockX"+I2S(inoueTargetId),GetUnitX(inoueTarget))
call S_R(inoueFieldId,"lockY"+I2S(inoueTargetId),GetUnitY(inoueTarget))
endif
elseif GetWidgetLife(inoueTarget)>.405 and inoueDamageTick then
call SetWidgetLife(inoueTarget,GetWidgetLife(inoueTarget)+inoueHeal)
call SetUnitState(inoueTarget,UNIT_STATE_MANA,GetUnitState(inoueTarget,UNIT_STATE_MANA)+inoueHeal*.5)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",inoueTarget,"origin"))
endif
endif
endloop
call GroupAddGroup(inoueEnemies,inoueTargets)
loop
set inoueTarget=FirstOfGroup(inoueTargets)
exitwhen inoueTarget==null
call GroupRemoveUnit(inoueTargets,inoueTarget)
if GetUnitTypeId(inoueTarget)==0 then
call GroupRemoveUnit(inoueEnemies,inoueTarget)
elseif GetWidgetLife(inoueTarget)<=.405 then
if GetUnitAbilityLevel(inoueTarget,'A0A9')==0 then
call GroupRemoveUnit(inoueEnemies,inoueTarget)
call InoueTReleaseControl(inoueTarget)
endif
elseif IsUnitEnemy(inoueTarget,GetOwningPlayer(inoueCaster)) then
if GetWidgetLife(inoueTarget)>.405 then
set inoueTargetId=GetHandleId(inoueTarget)
set inoueTargetX=L_R(inoueFieldId,"lockX"+I2S(inoueTargetId))
set inoueTargetY=L_R(inoueFieldId,"lockY"+I2S(inoueTargetId))
call InoueTDisableAttack(inoueTarget)
if not IsUnitHidden(inoueTarget) and not IsUnitPaused(inoueTarget) then
call IssueImmediateOrder(inoueTarget,"stop")
call SetUnitX(inoueTarget,inoueTargetX)
call SetUnitY(inoueTarget,inoueTargetY)
endif
if inoueDamageTick then
