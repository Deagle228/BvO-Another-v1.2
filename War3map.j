set BvOPickLines[28]=9
set BvOPickText[448]="Robin is the Straw Hats' archaeologist. She"
set BvOPickText[449]="seeks the Rio Poneglyph to uncover the forbidden"
set BvOPickText[450]="history of the Void Century. After Luffy saves"
set BvOPickText[451]="her, she joins his crew and comes to care deeply"
set BvOPickText[452]="for them, especially after the events at Enies"
set BvOPickText[453]="Lobby."
