function Wuv takes nothing returns nothing
local trigger tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(tempTrigger,Condition(function KumaBookReplace_Cond))
call TriggerAddAction(tempTrigger,function KumaBookReplace)
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(tempTrigger,Condition(function BonecrusherLimit_Cond))
call TriggerAddAction(tempTrigger,function BonecrusherLimit)
set tempTrigger=null
set Fy=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(Fy,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(Fy,Condition(function WSv))
call TriggerAddAction(Fy,function WTv)
endfunction
