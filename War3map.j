// ------------------------------------------------------------------ Hero pick screen (like BvO Another v1.1c)
// The camera of a player without a hero looks straight down at a black floor in the pick area. The hero icons lie on
// it (units with a flat clickable icon model); the first click on an icon shows the model (attached to a dummy whose
// attachment point is turned by 90 degrees, so the hero stands towards the camera) and the description of the hero,
// only for the clicking player; the second click on the same icon buys it from its tavern (under the console).
function BvOPickTavernUnit takes integer tavernIndex returns unit
if tavernIndex==1 then
return VF
elseif tavernIndex==2 then
return XF
elseif tavernIndex==3 then
return tG
elseif tavernIndex==4 then
return uG
endif
return fsNewTavern
endfunction
// a hero shown by the All Random preview does not count yet: the pick screen stays until it is released
function BvOPickHasHero takes integer playerIndex returns boolean
return m[1+playerIndex]!=null and not BvOPickPreview[playerIndex]
endfunction
function BvOPickShowText takes integer playerIndex,integer heroIndex returns nothing
local integer lineIndex=0
if GetLocalPlayer()==Player(playerIndex) then
if heroIndex>0 then
call SetTextTagText(BvOPickTag[0],"|cffffcc00"+BvOPickName[heroIndex]+"|r",.025)
else
call SetTextTagText(BvOPickTag[0],"",.025)
endif
loop
exitwhen lineIndex>=15
if heroIndex>0 and lineIndex<BvOPickLines[heroIndex] then
call SetTextTagText(BvOPickTag[lineIndex+1],BvOPickText[heroIndex*16+lineIndex],.0185)
else
call SetTextTagText(BvOPickTag[lineIndex+1],"",.0185)
endif
set lineIndex=lineIndex+1
endloop
endif
endfunction
function BvOPickClearModel takes integer playerIndex returns nothing
if BvOPickModelFx[playerIndex]!=null then
call DestroyEffect(BvOPickModelFx[playerIndex])
set BvOPickModelFx[playerIndex]=null
endif
if BvOPickModelUnit[playerIndex]!=null then
call RemoveUnit(BvOPickModelUnit[playerIndex])
set BvOPickModelUnit[playerIndex]=null
endif
endfunction
function BvOPickShow takes integer playerIndex,integer heroIndex returns nothing
local string modelPath=""
local integer tavernIndex=1
loop
exitwhen tavernIndex>5
if BvOPickBuyer[playerIndex*5+tavernIndex]!=null then
call ShowUnit(BvOPickBuyer[playerIndex*5+tavernIndex],tavernIndex==BvOPickTavern[heroIndex])
endif
set tavernIndex=tavernIndex+1
endloop
call BvOPickClearModel(playerIndex)
if GetLocalPlayer()==Player(playerIndex) then
set modelPath=BvOPickModel[heroIndex]
endif
set BvOPickModelUnit[playerIndex]=CreateUnit(Player(playerIndex),'uP96',4032.,-6300.,270.)
call SetUnitScale(BvOPickModelUnit[playerIndex],BvOPickScale[heroIndex],BvOPickScale[heroIndex],BvOPickScale[heroIndex])
set BvOPickModelFx[playerIndex]=AddSpecialEffectTarget(modelPath,BvOPickModelUnit[playerIndex],"origin")
call BvOPickShowText(playerIndex,heroIndex)
endfunction
// the tavern and the buyer are shown only while buying (hidden, nobody can select them on the pick screen); a shop
// notices a unit that was just shown only a moment later, so the order is repeated every 0.1 s for up to 2 s
function BvOPickBuyTick takes nothing returns nothing
local timer buyTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(buyTimer)
local integer playerIndex=LoadInteger(BvOPickHash,timerKey,0)
local integer heroIndex=LoadInteger(BvOPickHash,timerKey,1)
local unit tavern=LoadUnitHandle(BvOPickHash,timerKey,2)
local integer tries=LoadInteger(BvOPickHash,timerKey,4)+1
local boolean done=BvOPickHasHero(playerIndex) or m[1+playerIndex]!=null
if not done and tries<=20 then
call SaveInteger(BvOPickHash,timerKey,4,tries)
call IssueNeutralImmediateOrderById(Player(playerIndex),tavern,BvOPickHero[heroIndex])
else
if not done then
call DisplayTimedTextToPlayer(Player(playerIndex),0.,0.,5.,"|cffff4040"+BvOPickName[heroIndex]+" cannot be picked now.|r")
endif
call ShowUnit(LoadUnitHandle(BvOPickHash,timerKey,3),false)
set BvOPickBuying[playerIndex]=false
call FlushChildHashtable(BvOPickHash,timerKey)
call DestroyTimer(buyTimer)
endif
set buyTimer=null
set tavern=null
endfunction
function BvOPickHeroTaken takes integer heroIndex returns boolean
local integer otherIndex=1
loop
exitwhen otherIndex>12
if m[otherIndex]!=null and GetUnitTypeId(m[otherIndex])==BvOPickHero[heroIndex] then
return true
endif
set otherIndex=otherIndex+1
endloop
return false
endfunction
function BvOPickBuy takes integer playerIndex,integer heroIndex returns nothing
local unit tavern=BvOPickTavernUnit(BvOPickTavern[heroIndex])
local unit buyer=BvOPickBuyer[playerIndex*5+BvOPickTavern[heroIndex]]
local timer buyTimer
if BvOPickBuying[playerIndex] then
set tavern=null
set buyer=null
return
endif
if tavern==null or GetWidgetLife(tavern)<=.405 or GetUnitTypeId(tavern)==0 then
call DisplayTimedTextToPlayer(Player(playerIndex),0.,0.,5.,"|cffff4040"+BvOPickName[heroIndex]+" is not available in this game mode.|r")
set tavern=null
set buyer=null
return
endif
if BvOPickHeroTaken(heroIndex) then
call DisplayTimedTextToPlayer(Player(playerIndex),0.,0.,5.,"|cffff4040"+BvOPickName[heroIndex]+" is already taken.|r")
set tavern=null
set buyer=null
return
endif
set BvOPickBuying[playerIndex]=true
// A repick must not depend on the weighted random pool. The sale handler
// disables the new roster after a pick; restore only this validated choice.
call SetPlayerUnitAvailableBJ(BvOPickHero[heroIndex],true,Player(playerIndex))
call AddUnitToStock(tavern,BvOPickHero[heroIndex],1,1)
call ShowUnit(buyer,true)
call SetUnitX(buyer,GetUnitX(tavern))
call SetUnitY(buyer,GetUnitY(tavern)-90.)
call IssueNeutralImmediateOrderById(Player(playerIndex),tavern,BvOPickHero[heroIndex])
set buyTimer=CreateTimer()
call SaveInteger(BvOPickHash,GetHandleId(buyTimer),0,playerIndex)
call SaveInteger(BvOPickHash,GetHandleId(buyTimer),1,heroIndex)
call SaveUnitHandle(BvOPickHash,GetHandleId(buyTimer),2,tavern)
call SaveUnitHandle(BvOPickHash,GetHandleId(buyTimer),3,buyer)
call SaveInteger(BvOPickHash,GetHandleId(buyTimer),4,0)
call TimerStart(buyTimer,.1,true,function BvOPickBuyTick)
set buyTimer=null
set tavern=null
set buyer=null
endfunction
function BvOPickOnSelect takes nothing returns boolean
local unit icon=GetTriggerUnit()
local integer playerIndex=GetPlayerId(GetTriggerPlayer())
local integer heroIndex
if BvOSlotState(GetTriggerPlayer())!=PLAYER_SLOT_STATE_PLAYING then
set icon=null
return false
endif
if GetUnitUserData(icon)>0 and GetUnitUserData(icon)<=BvOPickCount and BvOPickIcon[GetUnitUserData(icon)]==icon then
set heroIndex=GetUnitUserData(icon)
if GetLocalPlayer()==GetTriggerPlayer() then
call ClearSelection()
endif
if heroIndex>0 and not BvOPickHasHero(playerIndex) then
if BvOPickChosen[playerIndex]!=heroIndex then
set BvOPickChosen[playerIndex]=heroIndex
call BvOPickShow(playerIndex,heroIndex)
elseif BvOPickLocked then
// the host still has time to type the modes: the hero can be looked at, but not picked yet (the icons show the
// cooldown)
else
call BvOPickBuy(playerIndex,heroIndex)
endif
endif
endif
set icon=null
return false
endfunction
// players without a hero: the camera is held over the pick screen; once a hero is picked the model and the
// description are removed and the normal camera comes back
function BvOPickCamera takes nothing returns nothing
local integer localIndex=GetPlayerId(GetLocalPlayer())
if localIndex<12 and BvOSlotState(GetLocalPlayer())==PLAYER_SLOT_STATE_PLAYING and not BvOPickHasHero(localIndex) then
call SetCameraPosition(4032.,-5950.)
call SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK,270.,0.)
call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE,1650.,0.)
call SetCameraField(CAMERA_FIELD_ROTATION,90.,0.)
call SetCameraField(CAMERA_FIELD_ZOFFSET,0.,0.)
call SetCameraField(CAMERA_FIELD_FIELD_OF_VIEW,70.,0.)
set BvOPickLocalLocked=true
elseif BvOPickLocalLocked then
set BvOPickLocalLocked=false
call SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK,304.,0.)
call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE,2250.,0.)
call SetCameraField(CAMERA_FIELD_ZOFFSET,0.,0.)
endif
endfunction
// while the picks are locked the icons are dark and show the seconds left, like the cooldown of the old taverns
function BvOPickCooldown takes nothing returns nothing
local integer heroIndex=1
local string secondsLeft
if BvOPickLocked and not k4 then
set secondsLeft=I2S(R2I(TimerGetRemaining(BvOPickLockTimer)+.99))
loop
exitwhen heroIndex>BvOPickCount
if not BvOPickCdShown then
set BvOPickCdTag[heroIndex]=CreateTextTag()
call SetTextTagPos(BvOPickCdTag[heroIndex],BvOPickX[heroIndex]-5.,BvOPickY[heroIndex]-14.,14.)
call SetTextTagColor(BvOPickCdTag[heroIndex],255,255,255,255)
call SetTextTagPermanent(BvOPickCdTag[heroIndex],true)
call SetTextTagVisibility(BvOPickCdTag[heroIndex],true)
call SetUnitVertexColor(BvOPickIcon[heroIndex],90,90,90,255)
endif
call SetTextTagText(BvOPickCdTag[heroIndex],secondsLeft,.03)
set heroIndex=heroIndex+1
endloop
set BvOPickCdShown=true
elseif BvOPickCdShown then
set BvOPickCdShown=false
loop
exitwhen heroIndex>BvOPickCount
call DestroyTextTag(BvOPickCdTag[heroIndex])
set BvOPickCdTag[heroIndex]=null
call SetUnitVertexColor(BvOPickIcon[heroIndex],255,255,255,255)
set heroIndex=heroIndex+1
endloop
endif
if not BvOPickLocked then
call PauseTimer(BvOPickCooldownTimer)
endif
endfunction
function BvOPickNeedsScreen takes nothing returns boolean
local integer p=0
loop
exitwhen p>11
if BvOSlotState(Player(p))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(p))==MAP_CONTROL_USER then
if not BvOPickHasHero(p) or BvOPickBuying[p] then
return true
endif
endif
set p=p+1
endloop
return false
endfunction
function BvOPickHideBuyers takes integer playerIndex returns nothing
local integer slot=1
local unit buyer
loop
exitwhen slot>5
set buyer=BvOPickBuyer[playerIndex*5+slot]
if buyer!=null and not IsUnitHidden(buyer) then
call ShowUnit(buyer,false)
endif
set slot=slot+1
endloop
set buyer=null
endfunction
function BvOPickSleep takes nothing returns nothing
local integer heroIndex=1
set BvOPickRunning=false
call PauseTimer(BvOPickCameraTimer)
call PauseTimer(BvOPickSyncTimer)
call PauseTimer(BvOPickCooldownTimer)
// Finish any local camera release before its timer stops.
call BvOPickCamera()
call BvOPickCooldown()
loop
exitwhen heroIndex>BvOPickCount
if not IsUnitHidden(BvOPickIcon[heroIndex]) then
call ShowUnit(BvOPickIcon[heroIndex],false)
endif
set heroIndex=heroIndex+1
endloop
set BvOPickIconsHidden=true
endfunction
function BvOPickUpdateVision takes integer playerIndex returns nothing
local boolean needsVision=BvOSlotState(Player(playerIndex))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(playerIndex))==MAP_CONTROL_USER and not BvOPickHasHero(playerIndex)
if needsVision and BvOPickVision[playerIndex]==null then
set BvOPickVision[playerIndex]=CreateFogModifierRect(Player(playerIndex),FOG_OF_WAR_VISIBLE,BvOPickVisionArea,false,false)
call FogModifierStart(BvOPickVision[playerIndex])
elseif not needsVision and BvOPickVision[playerIndex]!=null then
call FogModifierStop(BvOPickVision[playerIndex])
call DestroyFogModifier(BvOPickVision[playerIndex])
set BvOPickVision[playerIndex]=null
endif
endfunction
function BvOPickSync takes nothing returns nothing
local integer playerIndex=0
local group nearUnits=null
local unit nearUnit
loop
exitwhen playerIndex>11
call BvOPickUpdateVision(playerIndex)
if BvOPickHasHero(playerIndex) and (BvOPickModelUnit[playerIndex]!=null or BvOPickChosen[playerIndex]!=0) then
call BvOPickClearModel(playerIndex)
set BvOPickChosen[playerIndex]=0
call BvOPickShowText(playerIndex,0)
endif
if BvOPickHasHero(playerIndex) and not BvOPickBuying[playerIndex] then
call BvOPickHideBuyers(playerIndex)
endif
set playerIndex=playerIndex+1
endloop
if not BvOPickLocked and not BvOPickNeedsScreen() then
call BvOPickSleep()
return
endif
if k4 and not BvOPickIconsHidden then
set BvOPickIconsHidden=true
set playerIndex=1
loop
exitwhen playerIndex>BvOPickCount
call ShowUnit(BvOPickIcon[playerIndex],false)
set playerIndex=playerIndex+1
endloop
endif
if not k4 then
set playerIndex=1
loop
exitwhen playerIndex>BvOPickCount
if BvOPickHeroTaken(playerIndex) then
if not IsUnitHidden(BvOPickIcon[playerIndex]) then
call ShowUnit(BvOPickIcon[playerIndex],false)
if BvOPickCdTag[playerIndex]!=null then
call SetTextTagVisibility(BvOPickCdTag[playerIndex],false)
endif
endif
elseif IsUnitHidden(BvOPickIcon[playerIndex]) then
call ShowUnit(BvOPickIcon[playerIndex],true)
if BvOPickCdTag[playerIndex]!=null then
call SetTextTagVisibility(BvOPickCdTag[playerIndex],true)
endif
endif
set playerIndex=playerIndex+1
endloop
endif
// Only scan the pick area while a player still needs the pick screen.
set nearUnits=CreateGroup()
call GroupEnumUnitsInRect(nearUnits,BvOPickArea,null)
loop
set nearUnit=FirstOfGroup(nearUnits)
exitwhen nearUnit==null
call GroupRemoveUnit(nearUnits,nearUnit)
if GetPlayerId(GetOwningPlayer(nearUnit))<12 and not IsUnitType(nearUnit,UNIT_TYPE_HERO) and GetUnitTypeId(nearUnit)!='uP98' and GetUnitTypeId(nearUnit)!='uP96' then
call SetUnitX(nearUnit,4060.)
call SetUnitY(nearUnit,-6700.)
endif
endloop
call DestroyGroup(nearUnits)
set nearUnits=null
endfunction
function BvOPickOnSell takes nothing returns boolean
local unit seller=GetSellingUnit()
if IsUnitType(GetSoldUnit(),UNIT_TYPE_HERO) and (seller==VF or seller==XF or seller==tG or seller==uG or seller==fsNewTavern) then
call SetUnitPosition(GetSoldUnit(),4032.,-6016.)
endif
set seller=null
return false
endfunction
// All Random: the randomed hero is first shown on the pick screen for 2 seconds like after one click, then it enters
// the pick rect again and the usual handling sends it to the base
function BvOPickARReturn takes nothing returns nothing
local timer releaseTimer=GetExpiredTimer()
local unit hero=LoadUnitHandle(BvOPickHash,GetHandleId(releaseTimer),0)
call SetUnitPosition(hero,4032.,-6016.)
call FlushChildHashtable(BvOPickHash,GetHandleId(releaseTimer))
call DestroyTimer(releaseTimer)
set releaseTimer=null
set hero=null
endfunction
function BvOPickARRelease takes nothing returns nothing
local timer releaseTimer=GetExpiredTimer()
local unit hero=LoadUnitHandle(BvOPickHash,GetHandleId(releaseTimer),0)
local integer playerIndex=GetPlayerId(GetOwningPlayer(hero))
set BvOPickPreview[playerIndex]=false
call ShowUnit(hero,true)
call PauseUnit(hero,false)
// out of the pick rect and back in, so that the enter event of the rect runs again
call SetUnitPosition(hero,4060.,-6850.)
call TimerStart(releaseTimer,.05,false,function BvOPickARReturn)
set releaseTimer=null
set hero=null
endfunction
function BvOPickARPreview takes nothing returns nothing
local unit hero=BvOPickARUnit
local integer playerIndex=GetPlayerId(GetOwningPlayer(hero))
local integer heroIndex=1
local integer foundIndex=0
local timer releaseTimer=CreateTimer()
call SaveBoolean(BvOPickHash,GetHandleId(hero),5,true)
loop
exitwhen heroIndex>BvOPickCount
if BvOPickHero[heroIndex]==GetUnitTypeId(hero) then
set foundIndex=heroIndex
endif
set heroIndex=heroIndex+1
endloop
call ShowUnit(hero,false)
call PauseUnit(hero,true)
call SaveUnitHandle(BvOPickHash,GetHandleId(releaseTimer),0,hero)
if foundIndex>0 and playerIndex<12 then
set BvOPickPreview[playerIndex]=true
set BvOPickChosen[playerIndex]=foundIndex
call BvOPickShow(playerIndex,foundIndex)
call TimerStart(releaseTimer,3.,false,function BvOPickARRelease)
else
call TimerStart(releaseTimer,0.,false,function BvOPickARRelease)
endif
set releaseTimer=null
set hero=null
endfunction
function BvOPickWatch takes nothing returns nothing
// Read-only while everybody has a hero; reopen the screen for a repick.
if not BvOPickRunning and BvOPickNeedsScreen() then
set BvOPickRunning=true
call TimerStart(BvOPickCameraTimer,.03,true,function BvOPickCamera)
call TimerStart(BvOPickSyncTimer,.25,true,function BvOPickSync)
call BvOPickSync()
endif
endfunction
function BvOPickSetup takes nothing returns nothing
local integer heroIndex=1
local integer playerIndex=0
local integer lineIndex=0
local unit icon
local group nearUnits=CreateGroup()
local unit nearUnit
local trigger selectTrigger=CreateTrigger()
call DestroyTimer(GetExpiredTimer())
// circles of power of the old pick area
call GroupEnumUnitsInRect(nearUnits,bj_mapInitialPlayableArea,null)
loop
set nearUnit=FirstOfGroup(nearUnits)
exitwhen nearUnit==null
call GroupRemoveUnit(nearUnits,nearUnit)
if GetUnitTypeId(nearUnit)=='ncop' and GetUnitX(nearUnit)>3300. and GetUnitX(nearUnit)<4800. and GetUnitY(nearUnit)<-5200. and GetUnitY(nearUnit)>-6800. then
call RemoveUnit(nearUnit)
endif
endloop
call DestroyGroup(nearUnits)
set nearUnits=null
loop
exitwhen heroIndex>5
if BvOPickTavernUnit(heroIndex)!=null then
call SetUnitVertexColor(BvOPickTavernUnit(heroIndex),255,255,255,0)
call UnitAddAbility(BvOPickTavernUnit(heroIndex),'Aloc')
call UnitRemoveAbility(BvOPickTavernUnit(heroIndex),'Aloc')
endif
set heroIndex=heroIndex+1
endloop
set heroIndex=1
loop
exitwhen heroIndex>BvOPickCount
set icon=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),BvOPickIconType[heroIndex],BvOPickX[heroIndex],BvOPickY[heroIndex],0.)
call SetUnitUserData(icon,heroIndex)
call SetUnitPathing(icon,false)
call SetUnitX(icon,BvOPickX[heroIndex])
call SetUnitY(icon,BvOPickY[heroIndex])
call SetUnitFacing(icon,0.)
set BvOPickIcon[heroIndex]=icon
set heroIndex=heroIndex+1
endloop
set icon=null
// the black floor under the icons
call AddSpecialEffect("war3mapImported\\PickBackdrop.mdl",4032.,-5950.)
// description: the name and up to 15 lines above the model
loop
exitwhen lineIndex>15
set BvOPickTag[lineIndex]=CreateTextTag()
call SetTextTagText(BvOPickTag[lineIndex],"",.0185)
if lineIndex==0 then
call SetTextTagPos(BvOPickTag[lineIndex],3790.,-5520.,0.)
else
call SetTextTagPos(BvOPickTag[lineIndex],3790.,-5525.-28.*lineIndex,0.)
endif
call SetTextTagPermanent(BvOPickTag[lineIndex],true)
call SetTextTagVisibility(BvOPickTag[lineIndex],true)
set lineIndex=lineIndex+1
endloop
loop
exitwhen playerIndex>11
set heroIndex=1
loop
exitwhen heroIndex>5
if BvOPickTavernUnit(heroIndex)!=null then
set BvOPickBuyer[playerIndex*5+heroIndex]=CreateUnit(Player(playerIndex),'uP98',GetUnitX(BvOPickTavernUnit(heroIndex)),GetUnitY(BvOPickTavernUnit(heroIndex))-90.,270.)
call ShowUnit(BvOPickBuyer[playerIndex*5+heroIndex],false)
endif
set heroIndex=heroIndex+1
endloop
call BvOPickUpdateVision(playerIndex)
call TriggerRegisterPlayerUnitEvent(selectTrigger,Player(playerIndex),EVENT_PLAYER_UNIT_SELECTED,null)
set playerIndex=playerIndex+1
endloop
call TriggerAddCondition(selectTrigger,Condition(function BvOPickOnSelect))
set selectTrigger=null
set selectTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(selectTrigger,EVENT_PLAYER_UNIT_SELL)
call TriggerAddCondition(selectTrigger,Condition(function BvOPickOnSell))
set selectTrigger=null
set BvOPickCameraTimer=CreateTimer()
set BvOPickSyncTimer=CreateTimer()
set BvOPickCooldownTimer=CreateTimer()
set BvOPickRunning=true
call TimerStart(BvOPickCameraTimer,.03,true,function BvOPickCamera)
call TimerStart(BvOPickSyncTimer,.25,true,function BvOPickSync)
call TimerStart(BvOPickCooldownTimer,.1,true,function BvOPickCooldown)
call TimerStart(CreateTimer(),1.,true,function BvOPickWatch)
call BvOPickCooldown()
endfunction
function BvOPickUnlock takes nothing returns nothing
if not BvOPickLocked then
return
endif
set BvOPickLocked=false
if not k4 then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0.,0.,5.,"|cff00ff00Heroes can be picked now.|r")
endif
endfunction
function BvOPickModesTyped takes nothing returns nothing
call PauseTimer(BvOPickLockTimer)
call BvOPickUnlock()
call BvOPickCooldown()
endfunction
function BvOPickInit takes nothing returns nothing
set BvOPickHash=InitHashtable()
// picks are locked for the first 15 seconds, while the host types the modes (the mode window ends at 15 s)
set BvOPickLockTimer=CreateTimer()
call TimerStart(BvOPickLockTimer,15.,false,function BvOPickUnlock)
set BvOPickVisionArea=Rect(2900.,-6950.,5200.,-5100.)
set BvOPickArea=Rect(3000.,-6300.,5100.,-5300.)
call BvOPickData()
call TimerStart(CreateTimer(),0.,false,function BvOPickSetup)
endfunction
function RBReplaceDummyDamage takes nothing returns nothing
local unit rbLocal50_savedSource=Source
local unit rbLocal50_savedTrueSource=TrueSource
local unit rbLocal50_savedTarget=Target
local real rbLocal50_savedDamage=Damage
local real rbLocal50_savedPrimary=PrimaryDamage
local integer rbLocal50_savedMode=DamageMode
local integer rbLocal50_savedType=DamageType
local integer rbLocal50_savedSystemMode=DamageSystem_DamageMode
local unit rbLocal50_hero=LoadUnitHandle(RBDummyReg,GetHandleId(TrueSource),0)
if not RBReplacing and rbLocal50_hero!=null and LoadInteger(RBDummyReg,GetHandleId(TrueSource),3)==GetPlayerId(GetOwningPlayer(TrueSource))+1 and LoadInteger(RBDummyReg,GetHandleId(TrueSource),4)==GetUnitTypeId(TrueSource) and IsUnitEnemy(Target,GetOwningPlayer(rbLocal50_hero)) then
set RBReplacing=true
call AYPreventDamage(Target,Damage)
call DamageUnit(rbLocal50_hero,rbLocal50_savedTarget,LoadReal(RBDummyReg,GetHandleId(rbLocal50_savedTrueSource),1),LoadInteger(RBDummyReg,GetHandleId(rbLocal50_savedTrueSource),2),SPELL)
set Source=rbLocal50_savedSource
set TrueSource=rbLocal50_savedTrueSource
set Target=rbLocal50_savedTarget
set Damage=0.
set PrimaryDamage=rbLocal50_savedPrimary
set DamageMode=rbLocal50_savedMode
set DamageType=rbLocal50_savedType
set DamageSystem_DamageMode=rbLocal50_savedSystemMode
set RBReplacing=false
endif
set rbLocal50_savedSource=null
set rbLocal50_savedTrueSource=null
set rbLocal50_savedTarget=null
set rbLocal50_hero=null
endfunction
function RBShieldHook takes nothing returns nothing
local real rbLocal51_shield=LoadReal(Hash,GetHandleId(Target),StringHash("InoeW_Shield"))
local real rbLocal51_blocked
if GetUnitAbilityLevel(Target,'B02Q')>0 and rbLocal51_shield>0. and (DamageMode==MODE_ATTACK or DamageType!=CLEAN) then
set rbLocal51_blocked=RMinBJ(Damage,rbLocal51_shield)
call AYPreventDamage(Target,rbLocal51_blocked)
call SaveReal(Hash,GetHandleId(Target),StringHash("InoeW_Shield"),rbLocal51_shield-rbLocal51_blocked)
if rbLocal51_shield<=rbLocal51_blocked then
call UnitRemoveAbility(Target,'B02Q')
endif
endif
endfunction
function RBLightningArea takes unit rbLocal52_caster,real rbLocal52_x,real rbLocal52_y,real rbLocal52_amount,integer rbLocal52_slowAbility returns nothing
local group rbLocal52_g=CreateGroup()
local unit rbLocal52_u
call GroupEnumUnitsInRange(rbLocal52_g,rbLocal52_x,rbLocal52_y,250.,null)
call DestroyEffect(AddSpecialEffect("war3mapImported\\LightningWrath.mdx",rbLocal52_x,rbLocal52_y))
loop
set rbLocal52_u=FirstOfGroup(rbLocal52_g)
exitwhen rbLocal52_u==null
call GroupRemoveUnit(rbLocal52_g,rbLocal52_u)
if RBEnemy(rbLocal52_caster,rbLocal52_u) then
call DamageUnit(rbLocal52_caster,rbLocal52_u,rbLocal52_amount,MAGICAL,SPELL)
call CastToTarget(rbLocal52_caster,rbLocal52_u,rbLocal52_slowAbility,1,"cripple")
endif
endloop
call DestroyGroup(rbLocal52_g)
set rbLocal52_g=null
set rbLocal52_u=null
endfunction
function RBToshiroWBurst takes unit rbLocal53_caster,real rbLocal53_x,real rbLocal53_y,boolean rbLocal53_bankai returns nothing
local group rbLocal53_g=CreateGroup()
local unit rbLocal53_u
local real rbLocal53_damage=(RBValue(GetUnitAbilityLevel(rbLocal53_caster,'A06F'),300.0,525.0,750.0,975.0,1200.0,1200.0)+1.25*GetHeroAgi(rbLocal53_caster,false)+0.75*GetHeroInt(rbLocal53_caster,true))
if rbLocal53_bankai then
set rbLocal53_damage=(RBValue(GetUnitAbilityLevel(rbLocal53_caster,'A06F'),300.0,525.0,750.0,975.0,1200.0,1200.0)+2.5*GetHeroAgi(rbLocal53_caster,false)+1.5*GetHeroInt(rbLocal53_caster,true))
endif
call GroupEnumUnitsInRange(rbLocal53_g,rbLocal53_x,rbLocal53_y,400.,null)
loop
set rbLocal53_u=FirstOfGroup(rbLocal53_g)
exitwhen rbLocal53_u==null
call GroupRemoveUnit(rbLocal53_g,rbLocal53_u)
if RBEnemy(rbLocal53_caster,rbLocal53_u) then
call DamageUnit(rbLocal53_caster,rbLocal53_u,rbLocal53_damage,MAGICAL,SPELL)
if rbLocal53_bankai then
call CastToTarget(rbLocal53_caster,rbLocal53_u,'RT02',1,"thunderbolt")
call RBDelayedSlow(rbLocal53_caster,rbLocal53_u,'RX08',.7)
else
call CastToTarget(rbLocal53_caster,rbLocal53_u,'RT03',1,"thunderbolt")
call RBDelayedSlow(rbLocal53_caster,rbLocal53_u,'RX09',.35)
endif
endif
endloop
call DestroyEffect(AddSpecialEffect("war3mapImported\\icestomp.mdx",rbLocal53_x,rbLocal53_y))
call DestroyGroup(rbLocal53_g)
set rbLocal53_u=null
set rbLocal53_g=null
endfunction
function RBToshiroWTick takes nothing returns nothing
local timer rbLocal54_t=GetExpiredTimer()
local integer rbLocal54_k=GetHandleId(rbLocal54_t)
local unit rbLocal54_caster=LoadUnitHandle(RBState,rbLocal54_k,0)
local real rbLocal54_x=LoadReal(RBState,rbLocal54_k,1)
local real rbLocal54_y=LoadReal(RBState,rbLocal54_k,2)
local real rbLocal54_elapsed=LoadReal(RBState,rbLocal54_k,3)+.05
local boolean rbLocal54_bankai=LoadBoolean(RBState,rbLocal54_k,4)
local integer rbLocal54_count=3
local integer rbLocal54_i=1
local real rbLocal54_angle
local real rbLocal54_ux
local real rbLocal54_uy
local real rbLocal54_dx
local real rbLocal54_dy
local real rbLocal54_distance
local unit rbLocal54_dummy
local unit rbLocal54_u
local group rbLocal54_g=CreateGroup()
local boolean rbLocal54_done=false
if rbLocal54_bankai then
set rbLocal54_count=18
set rbLocal54_done=rbLocal54_elapsed>=1.449 or IsUnitPaused(rbLocal54_caster) or GetUnitAbilityLevel(rbLocal54_caster,'BSTN')>0
else
set rbLocal54_done=rbLocal54_elapsed>=.199
endif
if GetWidgetLife(rbLocal54_caster)<=.405 or GetUnitTypeId(rbLocal54_caster)==0 then
set rbLocal54_done=true
endif
loop
exitwhen rbLocal54_i>rbLocal54_count
set rbLocal54_dummy=LoadUnitHandle(RBState,rbLocal54_k,10+rbLocal54_i)
if rbLocal54_done then
call RemoveUnit(rbLocal54_dummy)
elseif not rbLocal54_bankai or rbLocal54_elapsed>=.549 then
if rbLocal54_bankai then
set rbLocal54_angle=Atan2(rbLocal54_y-GetUnitY(rbLocal54_dummy),rbLocal54_x-GetUnitX(rbLocal54_dummy))
set rbLocal54_ux=GetUnitX(rbLocal54_dummy)+25.*Cos(rbLocal54_angle)
set rbLocal54_uy=GetUnitY(rbLocal54_dummy)+25.*Sin(rbLocal54_angle)
call GroupEnumUnitsInRange(rbLocal54_g,rbLocal54_ux,rbLocal54_uy,100.,null)
loop
set rbLocal54_u=FirstOfGroup(rbLocal54_g)
exitwhen rbLocal54_u==null
call GroupRemoveUnit(rbLocal54_g,rbLocal54_u)
if RBEnemy(rbLocal54_caster,rbLocal54_u) and not IsUnitType(rbLocal54_u,UNIT_TYPE_FLYING) then
set rbLocal54_dx=rbLocal54_x-GetUnitX(rbLocal54_u)
set rbLocal54_dy=rbLocal54_y-GetUnitY(rbLocal54_u)
set rbLocal54_distance=SquareRoot(rbLocal54_dx*rbLocal54_dx+rbLocal54_dy*rbLocal54_dy)
if rbLocal54_distance<850. and rbLocal54_distance>25. then
call SetUnitPosition(rbLocal54_u,GetUnitX(rbLocal54_u)+25.*rbLocal54_dx/rbLocal54_distance,GetUnitY(rbLocal54_u)+25.*rbLocal54_dy/rbLocal54_distance)
endif
endif
endloop
else
set rbLocal54_angle=rbLocal54_i*120.*bj_DEGTORAD
set rbLocal54_ux=GetUnitX(rbLocal54_dummy)+50.*Cos(rbLocal54_angle)
set rbLocal54_uy=GetUnitY(rbLocal54_dummy)+50.*Sin(rbLocal54_angle)
endif
call SetUnitX(rbLocal54_dummy,rbLocal54_ux)
call SetUnitY(rbLocal54_dummy,rbLocal54_uy)
endif
set rbLocal54_i=rbLocal54_i+1
endloop
if rbLocal54_done then
if GetWidgetLife(rbLocal54_caster)>.405 then
call RBToshiroWBurst(rbLocal54_caster,rbLocal54_x,rbLocal54_y,rbLocal54_bankai)
endif
call FlushChildHashtable(RBState,rbLocal54_k)
call DestroyTimer(rbLocal54_t)
else
call SaveReal(RBState,rbLocal54_k,3,rbLocal54_elapsed)
endif
call DestroyGroup(rbLocal54_g)
set rbLocal54_t=null
set rbLocal54_caster=null
set rbLocal54_dummy=null
set rbLocal54_u=null
set rbLocal54_g=null
endfunction
function RBToshiroW takes unit rbLocal55_caster,real rbLocal55_x,real rbLocal55_y returns nothing
local timer rbLocal55_t=CreateTimer()
local integer rbLocal55_k=GetHandleId(rbLocal55_t)
local boolean rbLocal55_bankai=GetUnitTypeId(rbLocal55_caster)!='EC12'
local integer rbLocal55_count=3
local integer rbLocal55_i=1
local unit rbLocal55_dummy
local real rbLocal55_angle
local real rbLocal55_ux
local real rbLocal55_uy
if rbLocal55_bankai then
set rbLocal55_count=18
endif
call SaveUnitHandle(RBState,rbLocal55_k,0,rbLocal55_caster)
call SaveReal(RBState,rbLocal55_k,1,rbLocal55_x)
call SaveReal(RBState,rbLocal55_k,2,rbLocal55_y)
call SaveReal(RBState,rbLocal55_k,3,0.)
call SaveBoolean(RBState,rbLocal55_k,4,rbLocal55_bankai)
loop
exitwhen rbLocal55_i>rbLocal55_count
if rbLocal55_bankai then
set rbLocal55_angle=rbLocal55_i*20.*bj_DEGTORAD
set rbLocal55_ux=rbLocal55_x+600.*Cos(rbLocal55_angle)
set rbLocal55_uy=rbLocal55_y+600.*Sin(rbLocal55_angle)
set rbLocal55_dummy=CreateUnit(GetOwningPlayer(rbLocal55_caster),'h005',rbLocal55_ux,rbLocal55_uy,0.)
call SetUnitTimeScale(rbLocal55_dummy,1.5)
else
set rbLocal55_angle=rbLocal55_i*120.*bj_DEGTORAD
set rbLocal55_ux=rbLocal55_x+90.*Cos((rbLocal55_i*120.-120.)*bj_DEGTORAD)-200.*Cos(rbLocal55_angle)
set rbLocal55_uy=rbLocal55_y+90.*Sin((rbLocal55_i*120.-120.)*bj_DEGTORAD)-200.*Sin(rbLocal55_angle)
set rbLocal55_dummy=CreateUnit(GetOwningPlayer(rbLocal55_caster),'h016',rbLocal55_ux,rbLocal55_uy,rbLocal55_i*120.)
call SetUnitTimeScale(rbLocal55_dummy,1.125)
call SetUnitScale(rbLocal55_dummy,1.2,1.2,1.2)
call SetUnitAnimation(rbLocal55_dummy,"death")
endif
call SaveUnitHandle(RBState,rbLocal55_k,10+rbLocal55_i,rbLocal55_dummy)
set rbLocal55_i=rbLocal55_i+1
endloop
call TimerStart(rbLocal55_t,.033333333,true,function RBToshiroWTick)
set rbLocal55_t=null
set rbLocal55_dummy=null
endfunction
function RBMissSyncSkill takes unit rbLocal57_hero,integer rbLocal57_learner,integer rbLocal57_active returns nothing
local integer rbLocal57_rank=GetUnitAbilityLevel(rbLocal57_hero,rbLocal57_learner)
local integer rbLocal57_current=GetUnitAbilityLevel(rbLocal57_hero,rbLocal57_active)
if rbLocal57_rank>0 then
if rbLocal57_current==0 then
call UnitAddAbility(rbLocal57_hero,rbLocal57_active)
call UnitMakeAbilityPermanent(rbLocal57_hero,true,rbLocal57_active)
endif
if rbLocal57_current<=5 and rbLocal57_current!=rbLocal57_rank then
call SetUnitAbilityLevel(rbLocal57_hero,rbLocal57_active,rbLocal57_rank)
endif
elseif rbLocal57_current>0 then
call UnitRemoveAbility(rbLocal57_hero,rbLocal57_active)
endif
endfunction
function RBMissLearn takes nothing returns nothing
if GetLearnedSkill()=='SDL0' then
if GetUnitAbilityLevel(GetTriggerUnit(),'A03S')==0 then
call UnitAddAbility(GetTriggerUnit(),'A03S')
call UnitMakeAbilityPermanent(GetTriggerUnit(),true,'A03S')
endif
call SetUnitAbilityLevel(GetTriggerUnit(),'A03S',GetUnitAbilityLevel(GetTriggerUnit(),'SDL0'))
endif
if GetLearnedSkill()=='IQL0' then
call BvOIkkakuQSync(GetTriggerUnit())
endif
if GetLearnedSkill()=='YML0' then
if GetUnitAbilityLevel(GetTriggerUnit(),'A038')==0 then
call UnitAddAbility(GetTriggerUnit(),'A038')
call UnitMakeAbilityPermanent(GetTriggerUnit(),true,'A038')
endif
call SetUnitAbilityLevel(GetTriggerUnit(),'A038',GetUnitAbilityLevel(GetTriggerUnit(),'YML0'))
endif
if GetLearnedSkill()=='RKTL' then
call RBMissSyncSkill(GetTriggerUnit(),'RKTL','A09H')
endif
if GetLearnedSkill()=='RLHW' then
call RBMissSyncSkill(GetTriggerUnit(),'RLHW','A0EH')
elseif GetLearnedSkill()=='RLBW' then
call RBMissSyncSkill(GetTriggerUnit(),'RLBW','AB0W')
endif
endfunction
// Native poison damage is reported as MODE_ATTACK by the 1.26 damage engine.
// Require an attack on this target and consume its pending impact once, even
// while no storm is active or its cooldown is running. Other damage hooks
// and the native poison itself retain their existing behavior.
function EnelConsumeAttackImpact takes nothing returns boolean
if not AYIsAttackDamage() or not LoadBoolean(AYHash,GetHandleId(Source),152) then
return false
endif
call SaveBoolean(AYHash,GetHandleId(Source),152,false)
return true
endfunction
