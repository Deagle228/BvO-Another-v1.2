if UnitHasItemOfTypeBJ(recipeHero,$49303536) then
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303536))
else
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$64657363))
endif
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303043))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303646))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl",recipeHero,"origin"))
call UnitAddItemByIdSwapped($49303544,recipeHero)
endif
if UnitHasItemOfTypeBJ(recipeHero,$49303043) and UnitHasItemOfTypeBJ(recipeHero,$49303448) and UnitHasItemOfTypeBJ(recipeHero,$4930364D) then
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303043))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303448))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$4930364D))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl",recipeHero,"origin"))
call UnitAddItemByIdSwapped($4930364C,recipeHero)
endif
if UnitHasItemOfTypeBJ(recipeHero,$49303043) and UnitHasItemOfTypeBJ(recipeHero,$49303152) and UnitHasItemOfTypeBJ(recipeHero,$49303650) then
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303043))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303152))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303650))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl",recipeHero,"origin"))
call UnitAddItemByIdSwapped($4930364E,recipeHero)
endif
if UnitHasItemOfTypeBJ(recipeHero,$49303152) and UnitHasItemOfTypeBJ(recipeHero,$49303339) and UnitHasItemOfTypeBJ(recipeHero,$49303759) then
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303152))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303339))
call RemoveItem(GetItemOfTypeFromUnitBJ(recipeHero,$49303759))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\OrbOfDeath\\OrbOfDeathMissile.mdl",recipeHero,"origin"))
call UnitAddItemByIdSwapped($49303651,recipeHero)
endif
if GetItemTypeId(GetManipulatedItem())==$49303544 or GetItemTypeId(GetManipulatedItem())==$4930364C or GetItemTypeId(GetManipulatedItem())==$4930364E then
if UnitItemCount(recipeHero,$49303544)+UnitItemCount(recipeHero,$4930364C)+UnitItemCount(recipeHero,$4930364E)>1 then
call UnitRemoveItemSwapped(GetManipulatedItem(),recipeHero)
if GetOwningPlayer(GetTriggerUnit())==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00You can only have one upgraded boots!|r")
endif
endif
endif
if GetItemTypeId(GetManipulatedItem())==$49303544 or GetItemTypeId(GetManipulatedItem())==$64657363 or GetItemTypeId(GetManipulatedItem())==$49303536 then
if UnitItemCount(recipeHero,$49303544)+UnitItemCount(recipeHero,$64657363)+UnitItemCount(recipeHero,$49303536)>1 then
call UnitRemoveItemSwapped(GetManipulatedItem(),recipeHero)
if GetOwningPlayer(recipeHero)==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00You can only have one Kuma's Unique Book or Teleportation boots!|r")
endif
endif
endif
if GetItemTypeId(GetManipulatedItem())==$49303154 and UnitItemCount(recipeHero,$49303154)>1 then
call UnitRemoveItemSwapped(GetManipulatedItem(),recipeHero)
if GetOwningPlayer(GetTriggerUnit())==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00You can only have one copy of Silver Helm!|r")
endif
endif
if GetItemTypeId(GetManipulatedItem())==$62726163 and UnitItemCount(recipeHero,$62726163)>1 then
call UnitRemoveItemSwapped(GetManipulatedItem(),recipeHero)
if GetOwningPlayer(GetTriggerUnit())==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00You can only have one copy of Shinigami's Cloak!|r")
endif
endif
set Hero=recipeHero
set recipeHero=null
endfunction
function StartActions takes nothing returns nothing
local integer index=0
loop
exitwhen index>11
call SetPlayerAbilityAvailableBJ(false,$41304556,Player(index))
call SetPlayerAbilityAvailableBJ(false,$4130454C,Player(index))
call SetPlayerAbilityAvailableBJ(false,$41304557,Player(index))
call SetPlayerAbilityAvailableBJ(false,$41304558,Player(index))
set index=index+1
endloop
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00Use the -zoom command to change the height of the camera. Range is 1500 to 3500. For example, -zoom 2200|r")
call DestroyTimer(GetExpiredTimer())
endfunction
function NamiIllusion_Actions takes nothing returns nothing
if GetUnitTypeId(GetEnteringUnit())==$45303031 and IsUnitIllusion(GetEnteringUnit()) then
call UnitRemoveAbility(GetEnteringUnit(),'A002')
call UnitRemoveAbility(GetEnteringUnit(),'A05A')
call UnitRemoveAbility(GetEnteringUnit(),'AFM1')
call UnitRemoveAbility(GetEnteringUnit(),'A05B')
set NamiIllusionSizeCount=NamiIllusionSizeCount+1
if NamiIllusionSizeCount>4 then
set NamiIllusionSizeCount=1
endif
call SetUnitScalePercent(GetEnteringUnit(),47+20*NamiIllusionSizeCount,47+20*NamiIllusionSizeCount,47+20*NamiIllusionSizeCount)
call SetUnitX(GetEnteringUnit(),GetUnitX(Hero)+(75+40*NamiIllusionSizeCount)*Cos((GetUnitFacing(Hero)-90+-180*NamiIllusionSizeCount)*bj_DEGTORAD))
call SetUnitY(GetEnteringUnit(),GetUnitY(Hero)+(75+40*NamiIllusionSizeCount)*Sin((GetUnitFacing(Hero)-90+-180*NamiIllusionSizeCount)*bj_DEGTORAD))
if GetLocalPlayer()==GetOwningPlayer(Hero) then
call SelectUnit(GetEnteringUnit(),true)
endif
endif
endfunction
function CustomTriggerInit takes nothing returns nothing
local trigger tempTrigger
local integer index=0
call BvORapierZoneInit()
set InoueTCleanupUnits=CreateGroup()
call TimerStart(CreateTimer(),.1,true,function InoueTCleanupTick)
call TimerStart(CreateTimer(),.25,true,function ShortPeriodicEffect)
call TimerStart(CreateTimer(),1,true,function SecondPeriodicEffect)
call TimerStart(CreateTimer(),2,true,function StartActions)
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(tempTrigger,Condition(function ItemAbilityControl))
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(tempTrigger,Condition(function InoueTPreventCast))
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(tempTrigger,Condition(function InoueTPreventOrder))
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(tempTrigger,Condition(function InoueTPreventAttack))
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(tempTrigger,function InoueTOnHeroDeath)
call TriggerAddAction(tempTrigger,function BvOForgetCachedUltimateTarget)
call TriggerAddAction(tempTrigger,function BvOWallDeathDropsOnDeath)
set tempTrigger=CreateTrigger()
call TriggerRegisterEnterRectSimple(tempTrigger,GetWorldBounds())
call TriggerAddAction(tempTrigger,function NamiIllusion_Actions)
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(tempTrigger,Condition(function ForceStaff_Cond))
call TriggerAddAction(tempTrigger,function ForceStaff_Actions)
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(tempTrigger,Condition(function ForceBoots_Cond))
call TriggerAddAction(tempTrigger,function ForceBoots_Actions)
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(tempTrigger,Condition(function Unbreake_Cond))
call TriggerAddAction(tempTrigger,function Unbreake_Actions)
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddAction(tempTrigger,function DuobleClickCast)
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_HERO_REVIVE_FINISH)
call TriggerAddCondition(tempTrigger,Condition(function BonecrusherReplaceItem))
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddAction(tempTrigger,function HeroBuyItem)
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddAction(tempTrigger,function HeroGetItem)
set tempTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(tempTrigger,EVENT_PLAYER_UNIT_SPELL_FINISH)
call TriggerAddCondition(tempTrigger,Condition(function AceV_Cond))
call TriggerAddAction(tempTrigger,function AceV_Actions)
call DummycasterInit()
call SetCameraFieldForPlayer(GetLocalPlayer(),CAMERA_FIELD_TARGET_DISTANCE,2250,0)
loop
exitwhen index>11
set index=index+1
endloop
set tempTrigger=null
endfunction
function MG takes unit NG,unittype OG returns boolean
return IsUnitType(NG,OG)!=null
endfunction
function PG takes location QG,real RG,real SG returns location
return Location(GetLocationX(QG)+RG*Cos(SG*bj_DEGTORAD),GetLocationY(QG)+RG*Sin(SG*bj_DEGTORAD))
endfunction
function TG takes nothing returns boolean
local real dx=GetDestructableX(GetFilterDestructable())-HG
local real dy=GetDestructableY(GetFilterDestructable())-IG
return dx*dx+dy*dy<=bj_enumDestructableRadius
endfunction
function UG takes real VG,location WG,code XG returns nothing
local rect r
if VG>=0 then
set HG=GetLocationX(WG)
set IG=GetLocationY(WG)
set bj_enumDestructableRadius=VG*VG
set r=Rect(HG-VG,IG-VG,HG+VG,IG+VG)
call EnumDestructablesInRect(r,filterEnumDestructablesInCircleBJ,XG)
call RemoveRect(r)
set r=null
endif
endfunction
function YG takes rect r,boolexpr ZG returns group
set lG=CreateGroup()
call GroupEnumUnitsInRect(lG,r,ZG)
call DestroyBoolExpr(ZG)
return lG
endfunction
function d6 takes rect r returns group
set lG=CreateGroup()
call GroupEnumUnitsInRect(lG,r,KG)
return lG
endfunction
function e6 takes real VG,location f6,boolexpr ZG returns group
set lG=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(lG,f6,VG,ZG)
return lG
endfunction
function g6 takes integer h6 returns group
set lG=CreateGroup()
call GroupEnumUnitsOfType(lG,UnitId2String(h6),KG)
return lG
endfunction
function i6 takes player j6,boolexpr ZG returns group
set lG=CreateGroup()
call GroupEnumUnitsOfPlayer(lG,j6,ZG)
call DestroyBoolExpr(ZG)
return lG
endfunction
function k6 takes player j6,integer h6 returns group
set lG=CreateGroup()
set bj_groupEnumTypeId=h6
call GroupEnumUnitsOfPlayer(lG,j6,filterGetUnitsOfPlayerAndTypeId)
return lG
endfunction
function m6 takes player j6 returns force
set JG=CreateForce()
call ForceAddPlayer(JG,j6)
return JG
endfunction
function n6 takes mapcontrol o6 returns force
local integer p6
local player q6
set JG=CreateForce()
set p6=0
loop
set q6=Player(p6)
if GetPlayerController(q6)==o6 then
call ForceAddPlayer(JG,q6)
endif
set p6=p6+1
exitwhen p6==16
endloop
return JG
endfunction
function r6 takes player j6 returns force
set JG=CreateForce()
call ForceEnumAllies(JG,j6,KG)
return JG
endfunction
function s6 takes player j6 returns force
set JG=CreateForce()
call ForceEnumEnemies(JG,j6,KG)
return JG
endfunction
function t6 takes boolexpr ZG returns force
set JG=CreateForce()
call ForceEnumPlayers(JG,ZG)
call DestroyBoolExpr(ZG)
return JG
endfunction
function u6 takes integer v6,group w6 returns group
set bj_randomSubGroupGroup=CreateGroup()
set bj_randomSubGroupWant=v6
set bj_randomSubGroupTotal=CountUnitsInGroup(w6)
if bj_randomSubGroupWant<=0 or bj_randomSubGroupTotal<=0 then
return bj_randomSubGroupGroup
endif
set bj_randomSubGroupChance=I2R(bj_randomSubGroupWant)/I2R(bj_randomSubGroupTotal)
call ForGroup(w6,function GetRandomSubGroupEnum)
return bj_randomSubGroupGroup
endfunction
function x6 takes itemtype y6,integer z6 returns nothing
local group g
set bj_stockPickedItemType=y6
set bj_stockPickedItemLevel=z6
set g=CreateGroup()
call GroupEnumUnitsOfType(g,"marketplace",KG)
call ForGroup(g,function UpdateEachStockBuildingEnum)
call DestroyGroup(g)
set g=null
endfunction
function A6 takes nothing returns nothing
local itemtype a6
local integer B6=0
local integer b6=0
local integer z6
set z6=1
loop
if bj_stockAllowedPermanent[z6] then
set b6=b6+1
if GetRandomInt(1,b6)==1 then
set a6=ITEM_TYPE_PERMANENT
set B6=z6
endif
endif
if bj_stockAllowedCharged[z6] then
set b6=b6+1
if GetRandomInt(1,b6)==1 then
set a6=ITEM_TYPE_CHARGED
set B6=z6
endif
endif
if bj_stockAllowedArtifact[z6] then
set b6=b6+1
if GetRandomInt(1,b6)==1 then
set a6=ITEM_TYPE_ARTIFACT
set B6=z6
endif
endif
set z6=z6+1
exitwhen z6>10
endloop
if b6==0 then
set a6=null
return
endif
call x6(a6,B6)
set a6=null
endfunction
function C6 takes nothing returns nothing
call A6()
call TimerStart(bj_stockUpdateTimer,bj_STOCK_RESTOCK_INTERVAL,true,function A6)
endfunction
function c6 takes nothing returns nothing
local integer z6
set z6=0
loop
set bj_stockAllowedPermanent[z6]=false
set bj_stockAllowedCharged[z6]=false
set bj_stockAllowedArtifact[z6]=false
set z6=z6+1
exitwhen z6>10
endloop
call SetAllItemTypeSlots(11)
call SetAllUnitTypeSlots(11)
set bj_stockUpdateTimer=CreateTimer()
call TimerStart(bj_stockUpdateTimer,bj_STOCK_RESTOCK_INITIAL_DELAY,false,function C6)
set bj_stockItemPurchased=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(bj_stockItemPurchased,Player(15),EVENT_PLAYER_UNIT_SELL_ITEM,null)
call TriggerAddAction(bj_stockItemPurchased,function RemovePurchasedItem)
endfunction
function D6 takes nothing returns boolean
return true
endfunction
function E6 takes nothing returns nothing
local integer F6
local integer G6
local version v
set KG=Filter(function D6)
set filterIssueHauntOrderAtLocBJ=Filter(function IssueHauntOrderAtLocBJFilter)
set filterEnumDestructablesInCircleBJ=Filter(function TG)
set filterGetUnitsInRectOfPlayer=Filter(function GetUnitsInRectOfPlayerFilter)
set filterGetUnitsOfTypeIdAll=Filter(function GetUnitsOfTypeIdAllFilter)
set filterGetUnitsOfPlayerAndTypeId=Filter(function GetUnitsOfPlayerAndTypeIdFilter)
set filterMeleeTrainedUnitIsHeroBJ=Filter(function MeleeTrainedUnitIsHeroBJFilter)
set filterLivingPlayerUnitsOfTypeId=Filter(function LivingPlayerUnitsOfTypeIdFilter)
set F6=0
loop
exitwhen F6==16
set bj_FORCE_PLAYER[F6]=CreateForce()
call ForceAddPlayer(bj_FORCE_PLAYER[F6],Player(F6))
set F6=F6+1
endloop
set bj_FORCE_ALL_PLAYERS=CreateForce()
call ForceEnumPlayers(bj_FORCE_ALL_PLAYERS,null)
set bj_cineModePriorSpeed=GetGameSpeed()
set bj_cineModePriorFogSetting=IsFogEnabled()
set bj_cineModePriorMaskSetting=IsFogMaskEnabled()
set F6=0
loop
exitwhen F6>=bj_MAX_QUEUED_TRIGGERS
set bj_queuedExecTriggers[F6]=null
set bj_queuedExecUseConds[F6]=false
set F6=F6+1
endloop
set bj_isSinglePlayer=false
set G6=0
set F6=0
loop
exitwhen F6>=12
if GetPlayerController(Player(F6))==MAP_CONTROL_USER and BvOSlotState(Player(F6))==PLAYER_SLOT_STATE_PLAYING then
set G6=G6+1
endif
set F6=F6+1
endloop
set bj_isSinglePlayer=G6==1
set bj_rescueSound=CreateSoundFromLabel("Rescue",false,false,false,10000,10000)
set bj_questDiscoveredSound=CreateSoundFromLabel("QuestNew",false,false,false,10000,10000)
set bj_questUpdatedSound=CreateSoundFromLabel("QuestUpdate",false,false,false,10000,10000)
set bj_questCompletedSound=CreateSoundFromLabel("QuestCompleted",false,false,false,10000,10000)
set bj_questFailedSound=CreateSoundFromLabel("QuestFailed",false,false,false,10000,10000)
set bj_questHintSound=CreateSoundFromLabel("Hint",false,false,false,10000,10000)
set bj_questSecretSound=CreateSoundFromLabel("SecretFound",false,false,false,10000,10000)
set bj_questItemAcquiredSound=CreateSoundFromLabel("ItemReward",false,false,false,10000,10000)
set bj_questWarningSound=CreateSoundFromLabel("Warning",false,false,false,10000,10000)
set bj_victoryDialogSound=CreateSoundFromLabel("QuestCompleted",false,false,false,10000,10000)
set bj_defeatDialogSound=CreateSoundFromLabel("QuestFailed",false,false,false,10000,10000)
call DelayedSuspendDecayCreate()
set v=VersionGet()
if v==VERSION_REIGN_OF_CHAOS then
set bj_MELEE_MAX_TWINKED_HEROES=bj_MELEE_MAX_TWINKED_HEROES_V0
else
set bj_MELEE_MAX_TWINKED_HEROES=bj_MELEE_MAX_TWINKED_HEROES_V1
endif
endfunction
