// Shop range: the shops of the two bases (Aneu cast range 2800 / activation 3000 in the object data) sell to every
// unit inside a base (the areas where the base restores hit points and mana: vo and xo), and to nobody outside.
// Any other shop keeps its old range (350). A purchase from outside is cancelled before every other shop trigger
// (this trigger is created first): the item is removed and its price comes back.
function BvOShopInBase takes real pointX,real pointY returns boolean
return RectContainsCoords(vo,pointX,pointY) or RectContainsCoords(xo,pointX,pointY)
endfunction
function BvOShopSellCheck takes nothing returns boolean
local unit shop=GetSellingUnit()
local unit buyer=GetBuyingUnit()
local item soldItem=GetSoldItem()
local integer soldType=GetItemTypeId(soldItem)
local player buyerOwner=GetOwningPlayer(buyer)
local real dx=GetUnitX(buyer)-GetUnitX(shop)
local real dy=GetUnitY(buyer)-GetUnitY(shop)
local boolean allowed=true
if shop!=null and buyer!=null and soldItem!=null and GetOwningPlayer(shop)==Player(PLAYER_NEUTRAL_PASSIVE) then
if BvOShopInBase(GetUnitX(shop),GetUnitY(shop)) then
set allowed=BvOShopInBase(GetUnitX(buyer),GetUnitY(buyer))
else
set allowed=dx*dx+dy*dy<=400.*400.
endif
if not allowed then
call RemoveItem(soldItem)
if soldType=='IP04' then
call RapierShopRestock()
endif
call SetPlayerState(buyerOwner,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(buyerOwner,PLAYER_STATE_RESOURCE_GOLD)+BvOShopGoldCost(soldType))
call SetPlayerState(buyerOwner,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(buyerOwner,PLAYER_STATE_RESOURCE_LUMBER)+BvOShopLumberCost(soldType))
if GetLocalPlayer()==buyerOwner then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00You can buy here only inside the base.|r")
endif
endif
endif
set shop=null
set buyer=null
set soldItem=null
set buyerOwner=null
return false
endfunction
function BvOShopRangeInit takes nothing returns nothing
local trigger sellTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(sellTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(sellTrigger,Condition(function BvOShopSellCheck))
set sellTrigger=null
endfunction
// ------------------------------------------------------------------ Edward Newgate - Whitebeard (HW00)
// Model, effects and voice from DreamPiece (unit H001, triggers Bai_Hu_*); the skills are written for BvO.
// Every cast runs on its own timer with its data in WBHash.
function WBDamage takes unit wbHero,unit hitUnit,real hitDamage returns nothing
call BvOHeroSpellDamage(wbHero,hitUnit,hitDamage,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endfunction
function WBPhysical takes unit wbHero,unit hitUnit,real hitDamage returns nothing
call BvOKindSpellDamage(wbHero,hitUnit,hitDamage,false,PHYSICAL)
endfunction
function WBPlay takes integer soundIndex,unit soundSource returns nothing
if WBSound[soundIndex]!=null then
call StopSound(WBSound[soundIndex],false,false)
call AttachSoundToUnit(WBSound[soundIndex],soundSource)
call StartSound(WBSound[soundIndex])
endif
endfunction
function WBKnock takes unit pushedUnit,real fromX,real fromY,real pushDistance,real pushTime returns nothing
if not IsUnitType(pushedUnit,UNIT_TYPE_STRUCTURE) then
call SKSlide(pushedUnit,Atan2(GetUnitY(pushedUnit)-fromY,GetUnitX(pushedUnit)-fromX),pushDistance,pushTime,false,"")
endif
endfunction
function WBStop takes timer spellTimer returns nothing
call FlushChildHashtable(WBHash,GetHandleId(spellTimer))
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endfunction
// ------------------------------------------------------------------ Q: Gekishin
function WBWaveTick takes nothing returns nothing
local timer waveTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(waveTimer)
local unit wbHero=LoadUnitHandle(WBHash,timerKey,0)
local unit wave=LoadUnitHandle(WBHash,timerKey,1)
local group hitUnits=LoadGroupHandle(WBHash,timerKey,2)
local integer waveTicks=LoadInteger(WBHash,timerKey,3)+1
local real waveAngle=LoadReal(WBHash,timerKey,5)
local real waveDamage=LoadReal(WBHash,timerKey,4)
local real waveX=GetUnitX(wave)
local real waveY=GetUnitY(wave)
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
call SaveInteger(WBHash,timerKey,3,waveTicks)
call GroupEnumUnitsInRange(nearbyUnits,waveX,waveY,200.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(wbHero,nearbyUnit) and not IsUnitInGroup(nearbyUnit,hitUnits) then
call GroupAddUnit(hitUnits,nearbyUnit)
call WBDamage(wbHero,nearbyUnit,waveDamage)
call SKSlide(nearbyUnit,waveAngle,300.,.35,false,"")
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(nearbyUnit),GetUnitY(nearbyUnit)))
endif
endloop
if waveTicks>=11 then
// the burst at the end of the path: half damage in 300
call SKDummy(wbHero,'hW02',waveX,waveY,waveAngle*bj_RADTODEG,1.5)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",waveX,waveY))
call GroupEnumUnitsInRange(nearbyUnits,waveX,waveY,300.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(wbHero,nearbyUnit) then
call WBDamage(wbHero,nearbyUnit,waveDamage*.5)
endif
endloop
call KillUnit(wave)
call CameraClearNoiseForPlayer(GetOwningPlayer(wbHero))
call DestroyGroup(hitUnits)
call WBStop(waveTimer)
endif
call DestroyGroup(nearbyUnits)
set waveTimer=null
set wbHero=null
set wave=null
set hitUnits=null
set nearbyUnits=null
endfunction
// the wave leaves after the 0.2 seconds of the swing (it is created only now: a hidden dummy that is shown again
// loses its Locust and can be clicked)
function WBWaveBegin takes nothing returns nothing
local timer waveTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(waveTimer)
local unit wbHero=LoadUnitHandle(WBHash,timerKey,0)
local real waveAngle=LoadReal(WBHash,timerKey,5)
local unit wave=SKDummy(wbHero,'hW01',GetUnitX(wbHero)+60.*Cos(waveAngle),GetUnitY(wbHero)+60.*Sin(waveAngle),waveAngle*bj_RADTODEG,1.5)
call SaveUnitHandle(WBHash,timerKey,1,wave)
call SKSlide(wave,waveAngle,700.,.55,true,"")
call CameraSetEQNoiseForPlayer(GetOwningPlayer(wbHero),8.)
call TimerStart(waveTimer,.05,true,function WBWaveTick)
set waveTimer=null
set wbHero=null
set wave=null
endfunction
// animations by name: an animation set by index stays on while the unit walks, so he would slide in it
function WBAnimName takes integer animIndex returns string
if animIndex==2 then
return "attack"
elseif animIndex==4 then
return "attack slam"
elseif animIndex==7 then
return "spell one"
elseif animIndex==8 then
return "spell two"
elseif animIndex==9 then
return "spell slam"
elseif animIndex==10 then
return "spell channel"
endif
return "stand"
endfunction
function WBAnimAgain takes nothing returns nothing
local timer animTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(animTimer)
call SetUnitAnimation(LoadUnitHandle(WBHash,timerKey,0),WBAnimName(LoadInteger(WBHash,timerKey,1)))
call FlushChildHashtable(WBHash,timerKey)
call DestroyTimer(animTimer)
set animTimer=null
endfunction
function WBAnim takes unit wbHero,integer animIndex returns nothing
local timer animTimer=CreateTimer()
call SetUnitTimeScale(wbHero,1.)
call SetUnitAnimation(wbHero,WBAnimName(animIndex))
call DestroyTimer(animTimer)
set animTimer=null
endfunction
function WBScaleBack takes nothing returns nothing
local timer scaleTimer=GetExpiredTimer()
call SetUnitTimeScale(LoadUnitHandle(WBHash,GetHandleId(scaleTimer),0),1.)
call FlushChildHashtable(WBHash,GetHandleId(scaleTimer))
call DestroyTimer(scaleTimer)
set scaleTimer=null
endfunction
function WBAnimFast takes unit wbHero,integer animIndex,real timeScale,real fastTime returns nothing
local timer scaleTimer=CreateTimer()
call WBAnim(wbHero,animIndex)
call SetUnitTimeScale(wbHero,timeScale)
call SaveUnitHandle(WBHash,GetHandleId(scaleTimer),0,wbHero)
call TimerStart(scaleTimer,fastTime,false,function WBScaleBack)
set scaleTimer=null
endfunction
function WBGekishin takes unit wbHero,real targetX,real targetY returns nothing
local timer waveTimer=CreateTimer()
local integer timerKey=GetHandleId(waveTimer)
local real waveAngle=Atan2(targetY-GetUnitY(wbHero),targetX-GetUnitX(wbHero))
call SetUnitFacing(wbHero,waveAngle*bj_RADTODEG)
call WBAnimFast(wbHero,8,3.,.2)
call WBPlay(1,wbHero)
call SaveUnitHandle(WBHash,timerKey,0,wbHero)
call SaveGroupHandle(WBHash,timerKey,2,CreateGroup())
call SaveInteger(WBHash,timerKey,3,0)
call SaveReal(WBHash,timerKey,4,100.*GetUnitAbilityLevel(wbHero,'WB01')+RBValue(GetUnitAbilityLevel(wbHero,'WB01'),2.5,2.75,3.,3.25,3.5,4.)*GetHeroStr(wbHero,false))
call SaveReal(WBHash,timerKey,5,waveAngle)
call TimerStart(waveTimer,.2,false,function WBWaveBegin)
set waveTimer=null
endfunction
// ------------------------------------------------------------------ W: Kaishin
function WBPunchLand takes nothing returns nothing
local timer punchTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(punchTimer)
local unit wbHero=LoadUnitHandle(WBHash,timerKey,0)
local real landX=GetUnitX(wbHero)
local real landY=GetUnitY(wbHero)
local real punchDamage=LoadReal(WBHash,timerKey,1)
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
call SetUnitPathing(wbHero,true)
call SetUnitPosition(wbHero,landX,landY)
set landX=GetUnitX(wbHero)
set landY=GetUnitY(wbHero)
call SKDummy(wbHero,'hW04',landX,landY,GetRandomReal(0.,360.),2.)
call SKDummy(wbHero,'hW07',landX,landY,GetRandomReal(0.,360.),2.)
call WBPlay(6,wbHero)
call GroupEnumUnitsInRange(nearbyUnits,landX,landY,300.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(wbHero,nearbyUnit) then
call AYStun(wbHero,nearbyUnit,2.)
call WBDamage(wbHero,nearbyUnit,punchDamage)
call WBKnock(nearbyUnit,landX,landY,200.,.3)
endif
endloop
call DestroyGroup(nearbyUnits)
call WBStop(punchTimer)
set punchTimer=null
set wbHero=null
set nearbyUnits=null
endfunction
function WBKaishin takes unit wbHero,real targetX,real targetY returns nothing
local timer punchTimer=CreateTimer()
local real jumpAngle=Atan2(targetY-GetUnitY(wbHero),targetX-GetUnitX(wbHero))
local real jumpDistance=SquareRoot((targetX-GetUnitX(wbHero))*(targetX-GetUnitX(wbHero))+(targetY-GetUnitY(wbHero))*(targetY-GetUnitY(wbHero)))
call SetUnitFacing(wbHero,jumpAngle*bj_RADTODEG)
call WBAnim(wbHero,9)
call WBPlay(2,wbHero)
call SetUnitPathing(wbHero,false)
call SKSlide(wbHero,jumpAngle,RMinBJ(jumpDistance,600.),.35,true,"")
call SaveUnitHandle(WBHash,GetHandleId(punchTimer),0,wbHero)
call SaveReal(WBHash,GetHandleId(punchTimer),1,100.*GetUnitAbilityLevel(wbHero,'WB02')+RBValue(GetUnitAbilityLevel(wbHero,'WB02'),2.5,3.,3.5,4.,4.5,4.5)*GetHeroStr(wbHero,false))
call TimerStart(punchTimer,.4,false,function WBPunchLand)
set punchTimer=null
endfunction
// ------------------------------------------------------------------ E: Kabutowari
function WBCrackTick takes nothing returns nothing
local timer crackTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(crackTimer)
local unit wbHero=LoadUnitHandle(WBHash,timerKey,0)
local group hitUnits=LoadGroupHandle(WBHash,timerKey,1)
local integer crackStep=LoadInteger(WBHash,timerKey,2)+1
local real crackAngle=LoadReal(WBHash,timerKey,3)
local real crackX=LoadReal(WBHash,timerKey,4)+150.*crackStep*Cos(crackAngle)
local real crackY=LoadReal(WBHash,timerKey,5)+150.*crackStep*Sin(crackAngle)
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
call SaveInteger(WBHash,timerKey,2,crackStep)
call SKDummy(wbHero,'hW05',crackX,crackY,crackAngle*bj_RADTODEG,2.)
call SKDummy(wbHero,'hW07',crackX,crackY,GetRandomReal(0.,360.),2.)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",crackX,crackY))
call GroupEnumUnitsInRange(nearbyUnits,crackX,crackY,200.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(wbHero,nearbyUnit) and not IsUnitInGroup(nearbyUnit,hitUnits) then
call GroupAddUnit(hitUnits,nearbyUnit)
call AYStun(wbHero,nearbyUnit,1.)
call BvOHeroSpellDamage(wbHero,nearbyUnit,LoadReal(WBHash,timerKey,6),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
endloop
call DestroyGroup(nearbyUnits)
if crackStep>=6 then
call DestroyGroup(hitUnits)
call WBStop(crackTimer)
endif
set crackTimer=null
set wbHero=null
set hitUnits=null
set nearbyUnits=null
endfunction
function WBCrackStart takes nothing returns nothing
local timer crackTimer=GetExpiredTimer()
call TimerStart(crackTimer,.06,true,function WBCrackTick)
set crackTimer=null
endfunction
function WBKabutowari takes unit wbHero,real targetX,real targetY returns nothing
local timer crackTimer=CreateTimer()
local integer timerKey=GetHandleId(crackTimer)
local real crackAngle=Atan2(targetY-GetUnitY(wbHero),targetX-GetUnitX(wbHero))
call SetUnitFacing(wbHero,crackAngle*bj_RADTODEG)
call WBAnim(wbHero,4)
call WBPlay(3,wbHero)
call SaveUnitHandle(WBHash,timerKey,0,wbHero)
call SaveGroupHandle(WBHash,timerKey,1,CreateGroup())
call SaveInteger(WBHash,timerKey,2,0)
call SaveReal(WBHash,timerKey,3,crackAngle)
call SaveReal(WBHash,timerKey,4,GetUnitX(wbHero))
call SaveReal(WBHash,timerKey,5,GetUnitY(wbHero))
call SaveReal(WBHash,timerKey,6,RBValue(GetUnitAbilityLevel(wbHero,'WB03'),500.,700.,900.,1100.,1300.,1300.)+RBValue(GetUnitAbilityLevel(wbHero,'WB03'),2.,2.25,2.5,2.75,3.,3.)*GetHeroStr(wbHero,true))
call TimerStart(crackTimer,.3,false,function WBCrackStart)
set crackTimer=null
endfunction
// ------------------------------------------------------------------ T: Air Quake
function WBMakeQuakeImpact takes unit wbHero returns sound
local sound impactSound=CreateSound("BvOAudio\\WhitebeardTImpact.wav",false,true,true,10,10,"DefaultEAXON")
call SetSoundDuration(impactSound,900)
call SetSoundVolume(impactSound,115)
call SetSoundDistances(impactSound,600.,10000.)
call AttachSoundToUnit(impactSound,wbHero)
return impactSound
endfunction
function WBQuakeTick takes nothing returns nothing
local timer quakeTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(quakeTimer)
local unit wbHero=LoadUnitHandle(WBHash,timerKey,0)
local sound impactSound=LoadSoundHandle(WBHash,timerKey,3)
local integer quakeTicks=LoadInteger(WBHash,timerKey,1)+1
local integer quakeIndex=0
local real quakeAngle
local real quakeDistance
local real quakeX
local real quakeY
local group nearbyUnits
local unit nearbyUnit
call SaveInteger(WBHash,timerKey,1,quakeTicks)
if quakeTicks>16 or GetWidgetLife(wbHero)<=.405 then
if GetWidgetLife(wbHero)<=.405 then
call StopSound(impactSound,true,false)
else
call KillSoundWhenDone(impactSound)
endif
call PauseUnit(wbHero,false)
call SetUnitTimeScale(wbHero,1.)
call SetUnitAnimation(wbHero,"stand")
call CameraClearNoiseForPlayer(GetOwningPlayer(wbHero))
call WBStop(quakeTimer)
else
if ModuloInteger(quakeTicks,4)==0 then
call StopSound(impactSound,false,false)
call AttachSoundToUnit(impactSound,wbHero)
call StartSound(impactSound)
endif
set nearbyUnits=CreateGroup()
loop
exitwhen quakeIndex>1
set quakeAngle=GetRandomReal(0.,2.*bj_PI)
set quakeDistance=GetRandomReal(100.,700.)
set quakeX=GetUnitX(wbHero)+quakeDistance*Cos(quakeAngle)
set quakeY=GetUnitY(wbHero)+quakeDistance*Sin(quakeAngle)
call SKDummy(wbHero,'hW02',quakeX,quakeY,GetRandomReal(0.,360.),1.5)
call SKDummy(wbHero,'hW06',quakeX,quakeY,GetRandomReal(0.,360.),1.5)
call GroupEnumUnitsInRange(nearbyUnits,quakeX,quakeY,220.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(wbHero,nearbyUnit) then
call WBDamage(wbHero,nearbyUnit,LoadReal(WBHash,timerKey,2))
endif
endloop
set quakeIndex=quakeIndex+1
endloop
call DestroyGroup(nearbyUnits)
endif
set impactSound=null
set quakeTimer=null
set wbHero=null
set nearbyUnits=null
endfunction
function WBAirQuake takes unit wbHero returns nothing
local timer quakeTimer=CreateTimer()
local integer timerKey=GetHandleId(quakeTimer)
call PauseUnit(wbHero,true)
call WBAnim(wbHero,7)
call SetUnitTimeScale(wbHero,.5)
call WBPlay(4,wbHero)
call CameraSetEQNoiseForPlayer(GetOwningPlayer(wbHero),6.)
call SKDummy(wbHero,'hW06',GetUnitX(wbHero),GetUnitY(wbHero),0.,2.)
call SaveUnitHandle(WBHash,timerKey,0,wbHero)
call SaveInteger(WBHash,timerKey,1,0)
call SaveReal(WBHash,timerKey,2,RBValue(GetUnitAbilityLevel(wbHero,'WB04'),500.,700.,900.,1100.,1300.,1300.)+RBValue(GetUnitAbilityLevel(wbHero,'WB04'),2.,3.,4.,5.,6.,6.)*GetHeroStr(wbHero,false))
call SaveSoundHandle(WBHash,timerKey,3,WBMakeQuakeImpact(wbHero))
call TimerStart(quakeTimer,.25,true,function WBQuakeTick)
set quakeTimer=null
endfunction
// ------------------------------------------------------------------ R: Ikki Tousen
function WBIkkiTick takes nothing returns nothing
local timer ikkiTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(ikkiTimer)
local unit wbHero=LoadUnitHandle(WBHash,timerKey,0)
local integer ikkiTicks=LoadInteger(WBHash,timerKey,1)+1
local real ikkiX=LoadReal(WBHash,timerKey,2)
local real ikkiY=LoadReal(WBHash,timerKey,3)
local group liftedUnits=LoadGroupHandle(WBHash,timerKey,4)
local group nearbyUnits
local unit nearbyUnit
call SaveInteger(WBHash,timerKey,1,ikkiTicks)
if ikkiTicks==4 then
call WBAnimFast(wbHero,2,1.5,.6)
endif
if ikkiTicks==12 then
call WBAnimFast(wbHero,4,1.5,.4)
endif
if ikkiTicks==5 then
// first hit: the enemies are thrown up and stunned
call SKDummy(wbHero,'hW04',ikkiX,ikkiY,GetRandomReal(0.,360.),2.)
call SKDummy(wbHero,'hW07',ikkiX,ikkiY,GetRandomReal(0.,360.),2.)
call WBPlay(6,wbHero)
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,ikkiX,ikkiY,LoadReal(WBHash,timerKey,7),null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(wbHero,nearbyUnit) then
call AYStun(wbHero,nearbyUnit,2.)
call WBDamage(wbHero,nearbyUnit,LoadReal(WBHash,timerKey,5))
if not IsUnitType(nearbyUnit,UNIT_TYPE_STRUCTURE) and not IsUnitType(nearbyUnit,UNIT_TYPE_FLYING) then
call GroupAddUnit(liftedUnits,nearbyUnit)
if UnitAddAbility(nearbyUnit,'Amrf') then
call UnitRemoveAbility(nearbyUnit,'Amrf')
endif
call SetUnitFlyHeight(nearbyUnit,300.,750.)
endif
endif
endloop
call DestroyGroup(nearbyUnits)
elseif ikkiTicks==10 then
call GroupClear(BvOWBTemp)
call GroupAddGroup(liftedUnits,BvOWBTemp)
loop
set nearbyUnit=FirstOfGroup(BvOWBTemp)
exitwhen nearbyUnit==null
call GroupRemoveUnit(BvOWBTemp,nearbyUnit)
call SetUnitFlyHeight(nearbyUnit,GetUnitDefaultFlyHeight(nearbyUnit),1000.)
endloop
elseif ikkiTicks==15 then
// second hit: the quake shatters them
call SKDummy(wbHero,'hW03',ikkiX,ikkiY,GetRandomReal(0.,360.),2.)
call SKDummy(wbHero,'hW02',ikkiX,ikkiY,GetRandomReal(0.,360.),2.)
call WBPlay(5,wbHero)
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,ikkiX,ikkiY,LoadReal(WBHash,timerKey,7),null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(wbHero,nearbyUnit) then
call WBDamage(wbHero,nearbyUnit,LoadReal(WBHash,timerKey,6))
endif
endloop
call DestroyGroup(nearbyUnits)
elseif ikkiTicks>=16 then
call PauseUnit(wbHero,false)
call SetUnitTimeScale(wbHero,1.)
call SetUnitAnimation(wbHero,"stand")
call DestroyGroup(liftedUnits)
call WBStop(ikkiTimer)
endif
set ikkiTimer=null
set wbHero=null
set liftedUnits=null
set nearbyUnits=null
endfunction
function WBIkkiTousen takes unit wbHero,real targetX,real targetY returns nothing
local timer ikkiTimer=CreateTimer()
local integer timerKey=GetHandleId(ikkiTimer)
local integer ikkiLevel=GetUnitAbilityLevel(wbHero,'WB05')
local real firstHitBase=200.*I2R(ikkiLevel)
if ikkiLevel>3 then
set firstHitBase=300.+100.*I2R(ikkiLevel)
endif
call SetUnitFacing(wbHero,Atan2(targetY-GetUnitY(wbHero),targetX-GetUnitX(wbHero))*bj_RADTODEG)
call PauseUnit(wbHero,true)
call WBAnimFast(wbHero,10,2.,.35)
call SaveUnitHandle(WBHash,timerKey,0,wbHero)
call SaveInteger(WBHash,timerKey,1,0)
call SaveReal(WBHash,timerKey,2,targetX)
call SaveReal(WBHash,timerKey,3,targetY)
call SaveGroupHandle(WBHash,timerKey,4,CreateGroup())
call SaveReal(WBHash,timerKey,5,firstHitBase+GetHeroStr(wbHero,true))
call SaveReal(WBHash,timerKey,6,150.+150.*ikkiLevel+2.*GetHeroStr(wbHero,true))
call SaveReal(WBHash,timerKey,7,350.+50.*ikkiLevel)
call TimerStart(ikkiTimer,.1,true,function WBIkkiTick)
set ikkiTimer=null
endfunction
// ------------------------------------------------------------------ V: Unscathed (passive)
// -10% damage from enemies; Oken unlocks -57.5% total under 25% life for 5 seconds, once per 60 seconds.
function WBShieldEnd takes nothing returns nothing
local timer shieldTimer=GetExpiredTimer()
call DestroyEffect(LoadEffectHandle(WBHash,GetHandleId(shieldTimer),0))
call FlushChildHashtable(WBHash,GetHandleId(shieldTimer))
call DestroyTimer(shieldTimer)
set shieldTimer=null
endfunction
function WBShield takes unit wbHero returns nothing
local timer shieldTimer=CreateTimer()
local texttag shieldText=CreateTextTag()
call SaveEffectHandle(WBHash,GetHandleId(shieldTimer),0,AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaShield\\ManaShieldCaster.mdl",wbHero,"origin"))
call TimerStart(shieldTimer,5.,false,function WBShieldEnd)
call SetTextTagText(shieldText,"|cffffcc00Unscathed!|r",.024)
call SetTextTagPosUnit(shieldText,wbHero,60.)
call SetTextTagVelocity(shieldText,0.,.04)
call SetTextTagPermanent(shieldText,false)
call SetTextTagLifespan(shieldText,2.)
call SetTextTagFadepoint(shieldText,1.5)
set shieldTimer=null
set shieldText=null
endfunction
// Native 1.26 passive cooldown: Exhume Corpses + disabled Meat Wagon Cargo.
// The level selects only the native cooldown duration if casting is delayed by stun.
// No forced unit orders; timestamps remain authoritative for combat effects.
function WBShieldCooldownTick takes nothing returns nothing
local timer cooldownTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(cooldownTimer)
local unit wbHero=LoadUnitHandle(WBHash,timerKey,0)
local integer heroKey=GetHandleId(wbHero)
local real timeLeft=LoadReal(WBHash,heroKey,2)-TimerGetElapsed(AYClock)
local integer displayLevel=R2I(timeLeft+.999)
if GetUnitTypeId(wbHero)!='HW00' then
call RemoveSavedHandle(WBHash,heroKey,3)
call RemoveSavedBoolean(WBHash,heroKey,4)
call WBStop(cooldownTimer)
elseif timeLeft<=0. then
call UnitRemoveAbility(wbHero,'WB08')
call UnitRemoveAbility(wbHero,'WB06')
call UnitAddAbility(wbHero,'WB06')
call UnitMakeAbilityPermanent(wbHero,true,'WB06')
call RemoveSavedHandle(WBHash,heroKey,3)
call RemoveSavedBoolean(WBHash,heroKey,4)
call WBStop(cooldownTimer)
elseif LoadBoolean(WBHash,heroKey,4) then
call UnitRemoveAbility(wbHero,'WB08')
call TimerStart(cooldownTimer,timeLeft,false,function WBShieldCooldownTick)
else
if GetWidgetLife(wbHero)>.405 then
if displayLevel>60 then
set displayLevel=60
endif
if displayLevel<1 then
set displayLevel=1
endif
if GetUnitAbilityLevel(wbHero,'WB06')!=displayLevel then
call SetUnitAbilityLevel(wbHero,'WB06',displayLevel)
endif
if GetUnitAbilityLevel(wbHero,'WB08')==0 then
call UnitAddAbility(wbHero,'WB08')
endif
else
call UnitRemoveAbility(wbHero,'WB08')
endif
call TimerStart(cooldownTimer,.1,false,function WBShieldCooldownTick)
endif
set wbHero=null
set cooldownTimer=null
endfunction
function WBShieldCooldownStart takes unit wbHero returns nothing
local integer heroKey=GetHandleId(wbHero)
local timer cooldownTimer=LoadTimerHandle(WBHash,heroKey,3)
if cooldownTimer!=null then
call WBStop(cooldownTimer)
endif
set cooldownTimer=CreateTimer()
call SaveTimerHandle(WBHash,heroKey,3,cooldownTimer)
call SaveUnitHandle(WBHash,GetHandleId(cooldownTimer),0,wbHero)
call SaveBoolean(WBHash,heroKey,4,false)
call TimerStart(cooldownTimer,.01,false,function WBShieldCooldownTick)
set cooldownTimer=null
endfunction
function WBDamageHook takes nothing returns nothing
local integer heroKey
local real now
if GhostScepterDoubling or Damage<=0. or Target==null or Source==null or GetUnitTypeId(Target)!='HW00' or IsUnitIllusion(Target) or GetUnitAbilityLevel(Target,'WB06')==0 or BvOPassivesBroken(Target) or not IsUnitEnemy(Source,GetOwningPlayer(Target)) then
return
endif
if not FSHasSceptre(Target) then
call AYPreventDamage(Target,Damage*.10)
return
endif
set heroKey=GetHandleId(Target)
set now=TimerGetElapsed(AYClock)
if now<LoadReal(WBHash,heroKey,1) then
call AYPreventDamage(Target,Damage*.575)
else
if GetWidgetLife(Target)-Damage*.90<GetUnitState(Target,UNIT_STATE_MAX_LIFE)*.25 and now>=LoadReal(WBHash,heroKey,2) then
call SaveReal(WBHash,heroKey,1,now+5.)
call SaveReal(WBHash,heroKey,2,now+60.)
call WBShieldCooldownStart(Target)
call AYPreventDamage(Target,Damage*.575)
call WBShield(Target)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl",Target,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",Target,"origin"))
else
call AYPreventDamage(Target,Damage*.10)
endif
endif
endfunction
// ------------------------------------------------------------------ dispatch
function WBOnSpell takes nothing returns boolean
local unit wbHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
if spellId=='WB06' and GetUnitTypeId(wbHero)=='HW00' then
if LoadTimerHandle(WBHash,GetHandleId(wbHero),3)!=null then
call SaveBoolean(WBHash,GetHandleId(wbHero),4,true)
endif
set wbHero=null
return false
endif
if GetUnitTypeId(wbHero)=='HW00' and SilenceConditions(wbHero) then
if spellId=='WB01' then
call WBGekishin(wbHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='WB02' then
call WBKaishin(wbHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='WB03' then
call WBKabutowari(wbHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='WB04' then
call WBAirQuake(wbHero)
elseif spellId=='WB05' then
call WBIkkiTousen(wbHero,GetSpellTargetX(),GetSpellTargetY())
endif
endif
set wbHero=null
return false
endfunction
function WBMakeSound takes string soundPath,integer soundDuration returns sound
local sound wbSound=CreateSound(soundPath,false,true,true,10,10,"DefaultEAXON")
call SetSoundDuration(wbSound,soundDuration)
call SetSoundVolume(wbSound,127)
call SetSoundDistances(wbSound,600.,10000.)
call Preload(soundPath)
return wbSound
endfunction
function WBInit takes nothing returns nothing
local trigger spellTrigger=CreateTrigger()
local unit preloadUnit
local integer preloadPlayer=0
call Preload("BvOAudio\\WhitebeardTImpact.wav")
set WBHash=InitHashtable()
loop
exitwhen preloadPlayer>=16
call SetPlayerAbilityAvailable(Player(preloadPlayer),'WB08',false)
set preloadPlayer=preloadPlayer+1
endloop
set preloadUnit=CreateUnit(Player(15),DummycasterId,0.,0.,0.)
call ShowUnit(preloadUnit,false)
call UnitAddAbility(preloadUnit,'WB06')
call SetUnitAbilityLevel(preloadUnit,'WB06',60)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaShield\\ManaShieldCaster.mdl",preloadUnit,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl",preloadUnit,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",preloadUnit,"origin"))
call RemoveUnit(preloadUnit)
set preloadUnit=null
set BvOWBTemp=CreateGroup()
set WBSound[1]=WBMakeSound("war3mapImported\\BaiHu 1.mp3",600)
set WBSound[2]=WBMakeSound("war3mapImported\\BaiHu 2.mp3",2000)
set WBSound[3]=WBMakeSound("war3mapImported\\BaiHu 3.mp3",1200)
set WBSound[4]=WBMakeSound("war3mapImported\\BaiHu 4.mp3",3000)
set WBSound[5]=WBMakeSound("war3mapImported\\BaiHu 5.mp3",5000)
set WBSound[6]=WBMakeSound("war3mapImported\\boom01.mp3",1500)
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(spellTrigger,Condition(function WBOnSpell))
set spellTrigger=null
endfunction
// ------------------------------------------------------------------ Pain (HP00)
// Model, effects, sounds and voices from GBR 11.9.19 (hero H04L, triggers shenluo/wanx/lunhuitians/dibaotianx/
// chaoshenl/yuhu); the timings follow the source triggers, the numbers are written for BvO.
// Every cast runs on its own timer with its data in PNHash.
function PNIsEnemy takes unit painHero,unit candidate returns boolean
return SKIsEnemy(painHero,candidate) and GetUnitAbilityLevel(candidate,'Avul')==0
endfunction
function PNDamage takes unit painHero,unit hitUnit,real hitDamage returns nothing
call BvOHeroSpellDamage(painHero,hitUnit,hitDamage,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endfunction
// the sounds play like PlaySoundBJ in GBR (2D): the mp3 files are stereo, the game does not play them as 3D sounds
function PNPlay takes integer soundIndex,unit soundSource returns nothing
if PNSound[soundIndex]!=null then
call StopSound(PNSound[soundIndex],false,false)
call StartSound(PNSound[soundIndex])
endif
endfunction
function PNPlayVoice takes integer soundIndex returns nothing
if PNSound[soundIndex]!=null then
call StopSound(PNSound[soundIndex],false,false)
call StartSound(PNSound[soundIndex])
endif
endfunction
function PNDummy takes unit painHero,integer dummyType,real dummyX,real dummyY,real dummyFacing,real dummyLife returns unit
set PNLastDummy=CreateUnit(GetOwningPlayer(painHero),dummyType,dummyX,dummyY,dummyFacing)
if dummyLife>0. then
call UnitApplyTimedLife(PNLastDummy,'BTLF',dummyLife)
call BvOVfxExpire(PNLastDummy,null,dummyLife+3.)
endif
return PNLastDummy
endfunction
function PNStop takes timer spellTimer returns nothing
call FlushChildHashtable(PNHash,GetHandleId(spellTimer))
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endfunction
// Pain stands still and can not be hurt while he casts (as in the source map)
function PNCopyGroup takes group sourceGroup,group targetGroup returns nothing
local group previousTarget=bj_groupAddGroupDest
set bj_groupAddGroupDest=targetGroup
call ForGroup(sourceGroup,function GroupAddGroupEnum)
set bj_groupAddGroupDest=previousTarget
set previousTarget=null
endfunction
function PNLock takes unit painHero returns nothing
call SetUnitInvulnerable(painHero,true)
call PauseUnit(painHero,true)
endfunction
function PNUnlock takes unit painHero returns nothing
call SetUnitInvulnerable(painHero,false)
call PauseUnit(painHero,false)
call SetUnitTimeScale(painHero,1.)
call SetUnitAnimation(painHero,"stand")
endfunction
// Q, E and R: Pain only stands still, he can be hurt and killed
function PNHold takes unit painHero returns nothing
call PauseUnit(painHero,true)
endfunction
function PNRelease takes unit painHero returns nothing
call PauseUnit(painHero,false)
call SetUnitTimeScale(painHero,1.)
if GetWidgetLife(painHero)>.405 then
call SetUnitAnimation(painHero,"stand")
endif
endfunction
// 1.26 can not read the invulnerable state: a do-nothing channel ability (targets: vulnerable units only) is ordered
// on the unit; the order is refused when the unit is invulnerable (Avul, divine shield, SetUnitInvulnerable...).
// The checker belongs to Neutral Passive, detects invisible units over the whole map and gets the vision of the
// checked unit for the moment of the check, so fog and invisibility do not matter.
function PNIsVulnerable takes unit painHero,unit checkedUnit returns boolean
local boolean orderTaken
call UnitShareVision(checkedUnit,Player(PLAYER_NEUTRAL_PASSIVE),true)
call SetUnitX(PNChecker,GetUnitX(checkedUnit))
call SetUnitY(PNChecker,GetUnitY(checkedUnit))
set orderTaken=IssueTargetOrder(PNChecker,"acidbomb",checkedUnit)
call IssueImmediateOrder(PNChecker,"stop")
call UnitShareVision(checkedUnit,Player(PLAYER_NEUTRAL_PASSIVE),false)
return orderTaken
endfunction
function PNAgi takes unit painHero returns real
return I2R(GetHeroAgi(painHero,true))
endfunction
function PNInt takes unit painHero returns real
return I2R(GetHeroInt(painHero,true))
endfunction
// R/T: Darkness Sphere blocks the first native zero-damage bolt and starts its normal cooldown.
// A second bolt carries the real stun. With no sphere, the spell retains its single native stun.
// Both bolts have the same duration and zero damage: they never add stun time or extra damage.
function PNStunThroughDarkness takes unit painHero,unit stunnedUnit,real stunDuration returns nothing
if stunnedUnit!=null and GetWidgetLife(stunnedUnit)>.405 then
if BvOHasDarknessShield(stunnedUnit) then
call AYStun(painHero,stunnedUnit,stunDuration)
endif
call AYStun(painHero,stunnedUnit,stunDuration)
endif
endfunction
function PNPhysical takes unit painHero,unit hitUnit,real hitDamage returns nothing
call BvOKindSpellDamage(painHero,hitUnit,hitDamage,true,PHYSICAL)
endfunction
// ------------------------------------------------------------------ Q: Shinra Tensei
// cast at once: damage, stun and the start of the push in the same moment; one timer (0.025 s) then moves all
// pushed units 400 in 0.5 s (no per-unit slide timers: FPS)
function PNShinraTick takes nothing returns nothing
local timer shinraTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(shinraTimer)
local group pushedUnits=LoadGroupHandle(PNHash,timerKey,1)
local integer shinraTicks=LoadInteger(PNHash,timerKey,2)+1
local real pushStep=(21-shinraTicks)*400./210.
local real pushAngle
local real unitX
local real unitY
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
call SaveInteger(PNHash,timerKey,2,shinraTicks)
// decelerating push: 20 steps of (21 - tick) x 400 / 210 = 400 in total, only over walkable ground
call PNCopyGroup(pushedUnits,nearbyUnits)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if GetUnitTypeId(nearbyUnit)!=0 and GetWidgetLife(nearbyUnit)>.405 then
set pushAngle=Atan2(GetUnitY(nearbyUnit)-LoadReal(PNHash,timerKey,5),GetUnitX(nearbyUnit)-LoadReal(PNHash,timerKey,4))
set unitX=GetUnitX(nearbyUnit)+pushStep*Cos(pushAngle)
set unitY=GetUnitY(nearbyUnit)+pushStep*Sin(pushAngle)
if RectContainsCoords(bj_mapInitialPlayableArea,unitX,unitY) and (IsUnitType(nearbyUnit,UNIT_TYPE_FLYING) or not IsTerrainPathable(unitX,unitY,PATHING_TYPE_WALKABILITY)) then
call SetUnitX(nearbyUnit,unitX)
call SetUnitY(nearbyUnit,unitY)
endif
endif
endloop
call DestroyGroup(nearbyUnits)
if shinraTicks>=20 then
call DestroyGroup(pushedUnits)
call PNStop(shinraTimer)
endif
set shinraTimer=null
set pushedUnits=null
set nearbyUnits=null
endfunction
function PNShinraTensei takes unit painHero returns nothing
local timer shinraTimer=CreateTimer()
local integer timerKey=GetHandleId(shinraTimer)
local real painX=GetUnitX(painHero)
local real painY=GetUnitY(painHero)
local real shinraDamage=20.+80.*GetUnitAbilityLevel(painHero,'PN01')+(2.+.1*GetUnitAbilityLevel(painHero,'PN01'))*PNInt(painHero)
local group pushedUnits=CreateGroup()
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
// Spell Three, the shock sphere and the dust wave (one of each instead of GBR's 3 + 25: FPS)
call PNPlay(1,painHero)
call SetUnitAnimationByIndex(painHero,7)
call QueueUnitAnimation(painHero,"stand")
call PNDummy(painHero,'hP01',painX,painY,GetRandomReal(0.,360.),1.)
call PNDummy(painHero,'hP02',painX,painY,GetRandomReal(0.,360.),2.)
call GroupEnumUnitsInRange(nearbyUnits,painX,painY,600.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if PNIsEnemy(painHero,nearbyUnit) then
call GroupAddUnit(pushedUnits,nearbyUnit)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(nearbyUnit),GetUnitY(nearbyUnit)))
call PNDamage(painHero,nearbyUnit,shinraDamage)
call AYStun(painHero,nearbyUnit,.5)
endif
endloop
call DestroyGroup(nearbyUnits)
call SaveGroupHandle(PNHash,timerKey,1,pushedUnits)
call SaveInteger(PNHash,timerKey,2,0)
call SaveReal(PNHash,timerKey,4,painX)
call SaveReal(PNHash,timerKey,5,painY)
call TimerStart(shinraTimer,.025,true,function PNShinraTick)
set shinraTimer=null
set pushedUnits=null
set nearbyUnits=null
endfunction
// ------------------------------------------------------------------ W: Bansho Ten'in
// Both W abilities stay on the hero so hiding a button never resets its cooldown.
// PNHash hero key70: the second W is selected.
// T has five learned ranks. The same native button temporarily selects its Oken cooldown at cast time.
function PNKitLearnT takes nothing returns boolean
local unit pnTLocalHero=GetTriggerUnit()
local integer pnTLocalRank
if GetUnitTypeId(pnTLocalHero)=='HP00' and GetLearnedSkill()=='PNTL' then
set pnTLocalRank=GetUnitAbilityLevel(pnTLocalHero,'PNTL')
if GetUnitAbilityLevel(pnTLocalHero,'PN05')==0 then
call UnitAddAbility(pnTLocalHero,'PN05')
call UnitMakeAbilityPermanent(pnTLocalHero,true,'PN05')
endif
call SetUnitAbilityLevel(pnTLocalHero,'PN05',pnTLocalRank)
endif
set pnTLocalHero=null
return false
endfunction
function PNKitCastT takes nothing returns boolean
local unit pnTLocalHero=GetTriggerUnit()
local integer pnTLocalRank=GetUnitAbilityLevel(pnTLocalHero,'PNTL')
if GetUnitTypeId(pnTLocalHero)=='HP00' and GetSpellAbilityId()=='PN05' and pnTLocalRank>0 then
if FZHasOken(pnTLocalHero) then
call SetUnitAbilityLevel(pnTLocalHero,'PN05',pnTLocalRank+5)
else
call SetUnitAbilityLevel(pnTLocalHero,'PN05',pnTLocalRank)
endif
endif
set pnTLocalHero=null
return false
endfunction
function PNKitRestoreT takes unit pnTLocalHero returns nothing
local timer pnTLocalTimer
local integer pnTLocalKey
if GetUnitAbilityLevel(pnTLocalHero,'PN05')>5 then
set pnTLocalTimer=CreateTimer()
set pnTLocalKey=GetHandleId(pnTLocalTimer)
call SaveUnitHandle(RBState,pnTLocalKey,0,pnTLocalHero)
call SaveInteger(RBState,pnTLocalKey,1,'PN05')
call SaveInteger(RBState,pnTLocalKey,2,GetUnitAbilityLevel(pnTLocalHero,'PNTL'))
call TimerStart(pnTLocalTimer,0.,false,function RBMissRestoreRank)
set pnTLocalTimer=null
endif
endfunction
function PNKitShowW takes unit pnKitHero,boolean pnKitSecond returns nothing
local player pnKitOwner=GetOwningPlayer(pnKitHero)
if GetUnitAbilityLevel(pnKitHero,'PN02')==0 then
set pnKitSecond=false
endif
if pnKitSecond and GetUnitAbilityLevel(pnKitHero,'PN07')==0 then
call SetPlayerAbilityAvailable(pnKitOwner,'PN07',false)
call UnitAddAbility(pnKitHero,'PN07')
call UnitMakeAbilityPermanent(pnKitHero,true,'PN07')
endif
if GetUnitAbilityLevel(pnKitHero,'PN07')>0 and GetUnitAbilityLevel(pnKitHero,'PN02')>0 and GetUnitAbilityLevel(pnKitHero,'PN07')!=GetUnitAbilityLevel(pnKitHero,'PN02') then
call SetUnitAbilityLevel(pnKitHero,'PN07',GetUnitAbilityLevel(pnKitHero,'PN02'))
endif
call SaveBoolean(PNHash,GetHandleId(pnKitHero),70,pnKitSecond)
call SetPlayerAbilityAvailable(pnKitOwner,'PN02',not pnKitSecond)
call SetPlayerAbilityAvailable(pnKitOwner,'PN07',pnKitSecond)
set pnKitOwner=null
endfunction
function PNKitSync takes unit pnKitHero returns nothing
local player pnKitOwner=GetOwningPlayer(pnKitHero)
local boolean pnKitOken=FZHasOken(pnKitHero)
if GetUnitAbilityLevel(pnKitHero,'PNTL')>0 and GetUnitAbilityLevel(pnKitHero,'PN05')==0 then
call UnitAddAbility(pnKitHero,'PN05')
call UnitMakeAbilityPermanent(pnKitHero,true,'PN05')
call SetUnitAbilityLevel(pnKitHero,'PN05',GetUnitAbilityLevel(pnKitHero,'PNTL'))
endif
if GetUnitAbilityLevel(pnKitHero,'PN06')==0 then
call SetPlayerAbilityAvailable(pnKitOwner,'PN06',false)
call UnitAddAbility(pnKitHero,'PN06')
call UnitMakeAbilityPermanent(pnKitHero,true,'PN06')
endif
// The native evasion is separate from the visible V button and remains with Oken.
if BvOPassivesBroken(pnKitHero) then
call UnitRemoveAbility(pnKitHero,'PN0E')
elseif GetUnitAbilityLevel(pnKitHero,'PN0E')==0 then
call UnitAddAbility(pnKitHero,'PN0E')
call UnitMakeAbilityPermanent(pnKitHero,true,'PN0E')
endif
call SetPlayerAbilityAvailable(pnKitOwner,'PN0B',not pnKitOken)
call SetPlayerAbilityAvailable(pnKitOwner,'PN06',pnKitOken)
call PNKitShowW(pnKitHero,LoadBoolean(PNHash,GetHandleId(pnKitHero),70))
set pnKitOwner=null
endfunction
function PNBanshoTick takes nothing returns nothing
local timer pullTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(pullTimer)
local unit painHero=LoadUnitHandle(PNHash,timerKey,0)
local unit pulledUnit=LoadUnitHandle(PNHash,timerKey,1)
local integer pullTicks=LoadInteger(PNHash,timerKey,2)+1
local real pullX=GetUnitX(pulledUnit)
local real pullY=GetUnitY(pulledUnit)
local real pullAngle=Atan2(GetUnitY(painHero)-pullY,GetUnitX(painHero)-pullX)
local real pullDistance=SquareRoot((GetUnitX(painHero)-pullX)*(GetUnitX(painHero)-pullX)+(GetUnitY(painHero)-pullY)*(GetUnitY(painHero)-pullY))
local boolean pullDone=pullTicks>50 or GetUnitTypeId(pulledUnit)==0 or GetWidgetLife(pulledUnit)<=.405 or pullDistance<=100. or GetWidgetLife(painHero)<=.405
call SaveInteger(PNHash,timerKey,2,pullTicks)
if not pullDone then
set pullX=pullX+RMinBJ(60.,pullDistance-100.)*Cos(pullAngle)
set pullY=pullY+RMinBJ(60.,pullDistance-100.)*Sin(pullAngle)
if IsTerrainPathable(pullX,pullY,PATHING_TYPE_WALKABILITY) and not IsUnitType(pulledUnit,UNIT_TYPE_FLYING) then
set pullDone=true
else
call SetUnitX(pulledUnit,pullX)
call SetUnitY(pulledUnit,pullY)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",pullX,pullY))
endif
endif
if pullDone then
if GetUnitTypeId(pulledUnit)!=0 then
call SetUnitPosition(pulledUnit,GetUnitX(pulledUnit),GetUnitY(pulledUnit))
// a pulled enemy takes the damage when the pull ends (not when Pain died meanwhile)
if GetWidgetLife(pulledUnit)>.405 and GetWidgetLife(painHero)>.405 and IsUnitEnemy(pulledUnit,GetOwningPlayer(painHero)) then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",pulledUnit,"origin"))
call PNDamage(painHero,pulledUnit,LoadReal(PNHash,timerKey,3))
endif
endif
call PNRelease(painHero)
call PNKitShowW(painHero,true)
call PNStop(pullTimer)
endif
set pullTimer=null
set painHero=null
set pulledUnit=null
endfunction
function PNBanshoTenin takes unit painHero,unit pulledUnit returns nothing
local timer pullTimer
if pulledUnit==null or pulledUnit==painHero or IsUnitType(pulledUnit,UNIT_TYPE_STRUCTURE) then
return
endif
set pullTimer=CreateTimer()
call PNPlay(2,painHero)
call PNHold(painHero)
call SetUnitAnimationByIndex(painHero,8)
if IsUnitEnemy(pulledUnit,GetOwningPlayer(painHero)) then
call AYStun(painHero,pulledUnit,.75+.25*GetUnitAbilityLevel(painHero,'PN02'))
endif
call SaveUnitHandle(PNHash,GetHandleId(pullTimer),0,painHero)
call SaveUnitHandle(PNHash,GetHandleId(pullTimer),1,pulledUnit)
call SaveInteger(PNHash,GetHandleId(pullTimer),2,0)
call SaveReal(PNHash,GetHandleId(pullTimer),3,75.+75.*GetUnitAbilityLevel(painHero,'PN02')+(1.8+.2*GetUnitAbilityLevel(painHero,'PN02'))*PNInt(painHero))
call TimerStart(pullTimer,.02,true,function PNBanshoTick)
set pullTimer=null
endfunction
// ------------------------------------------------------------------ E: Rinne Tensei
function PNRinneTick takes nothing returns nothing
local timer rinneTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(rinneTimer)
local unit painHero=LoadUnitHandle(PNHash,timerKey,0)
local unit statue=LoadUnitHandle(PNHash,timerKey,1)
local integer rinneTicks=LoadInteger(PNHash,timerKey,2)+1
local real healAmount=LoadReal(PNHash,timerKey,3)
local group alliedHeroes
local unit alliedHero
local integer effectIndex
call SaveInteger(PNHash,timerKey,2,rinneTicks)
if rinneTicks<30 and GetWidgetLife(painHero)<=.405 then
// Pain died during the 4 s cast: the spell is interrupted (afterwards it goes on without him)
call RemoveUnit(statue)
call PNRelease(painHero)
call PNStop(rinneTimer)
elseif rinneTicks==20 then
// "spell two": the statue stands for 1 second and then sinks; it is frozen while it still stands (0.9 s) and sinks
// only after the healing
call SetUnitAnimation(statue,"spell two")
call AYSetTimeScaleLater(statue,0.,1.7)
elseif rinneTicks==30 then
call PNRelease(painHero)
elseif rinneTicks>=40 and rinneTicks<=110 and ModuloInteger(rinneTicks,10)==0 then
// the souls heal every allied hero within 1500 of the King of Hell; three dummies at the statue send the healing
// wave to Pain while he lives (as in GBR; the heal itself is done here)
set effectIndex=0
if GetWidgetLife(painHero)<=.405 then
set effectIndex=3
endif
set alliedHeroes=CreateGroup()
call GroupEnumUnitsInRange(alliedHeroes,GetUnitX(statue),GetUnitY(statue),1500.,null)
loop
set alliedHero=FirstOfGroup(alliedHeroes)
exitwhen alliedHero==null
call GroupRemoveUnit(alliedHeroes,alliedHero)
if IsUnitType(alliedHero,UNIT_TYPE_HERO) and not IsUnitIllusion(alliedHero) and GetWidgetLife(alliedHero)>.405 and IsUnitAlly(alliedHero,GetOwningPlayer(painHero)) then
call UNHeal(alliedHero,healAmount)
// the healing wave of the statue only to the heroes it heals (one wave each, no bounces)
set PNLastDummy=CreateUnit(GetOwningPlayer(painHero),'hL02',GetUnitX(statue),GetUnitY(statue),0.)
call UnitAddAbility(PNLastDummy,'PN32')
call UnitApplyTimedLife(PNLastDummy,'BTLF',2.)
call IssueTargetOrder(PNLastDummy,"healingwave",alliedHero)
endif
endloop
call DestroyGroup(alliedHeroes)
elseif rinneTicks==120 then
call SetUnitTimeScale(statue,1.)
elseif rinneTicks>=130 then
call RemoveUnit(statue)
call PNStop(rinneTimer)
endif
set rinneTimer=null
set painHero=null
set statue=null
set alliedHeroes=null
endfunction
function PNRinneTensei takes unit painHero returns nothing
local timer rinneTimer=CreateTimer()
local integer timerKey=GetHandleId(rinneTimer)
local real statueX=GetUnitX(painHero)-256.*Cos(GetUnitFacing(painHero)*bj_DEGTORAD)
local real statueY=GetUnitY(painHero)-256.*Sin(GetUnitFacing(painHero)*bj_DEGTORAD)
local unit statue=PNDummy(painHero,'hP03',statueX,statueY,GetUnitFacing(painHero),0.)
call SetUnitAnimation(statue,"spell")
call PNDummy(painHero,'hP04',statueX,statueY,GetUnitFacing(painHero),2.)
call PNPlay(3,painHero)
call PNHold(painHero)
call SetUnitAnimationByIndex(painHero,11)
call SaveUnitHandle(PNHash,timerKey,0,painHero)
call SaveUnitHandle(PNHash,timerKey,1,statue)
call SaveInteger(PNHash,timerKey,2,0)
call SaveReal(PNHash,timerKey,3,25.+25.*GetUnitAbilityLevel(painHero,'PN03')+.5*PNAgi(painHero)+.1*GetUnitAbilityLevel(painHero,'PN03')*PNInt(painHero))
call TimerStart(rinneTimer,.1,true,function PNRinneTick)
set rinneTimer=null
set statue=null
endfunction
// ------------------------------------------------------------------ R: Chibaku Tensei
// a captured enemy is lifted to the height of the planet (1000, like the sky effects of the planet): it can not act and can not be damaged until the planet breaks
function PNChibakuRelease takes unit heldUnit returns nothing
call SaveInteger(PNHash,GetHandleId(heldUnit),7001,0)
call SetUnitInvulnerable(heldUnit,false)
call PauseUnit(heldUnit,false)
call SetUnitFlyHeight(heldUnit,GetUnitDefaultFlyHeight(heldUnit),0.)
endfunction
function PNChibakuFailsafe takes nothing returns nothing
local timer failsafeTimer=GetExpiredTimer()
local unit heldUnit=LoadUnitHandle(PNHash,GetHandleId(failsafeTimer),0)
if heldUnit!=null and GetUnitTypeId(heldUnit)!=0 and LoadInteger(PNHash,GetHandleId(heldUnit),7001)==LoadInteger(PNHash,GetHandleId(failsafeTimer),1) then
call PNChibakuRelease(heldUnit)
endif
call FlushChildHashtable(PNHash,GetHandleId(failsafeTimer))
call DestroyTimer(failsafeTimer)
set failsafeTimer=null
set heldUnit=null
endfunction
function PNChibakuHold takes unit heldUnit returns nothing
local timer failsafeTimer=CreateTimer()
set PNHoldToken=PNHoldToken+1
call SaveInteger(PNHash,GetHandleId(heldUnit),7001,PNHoldToken)
call SaveInteger(PNHash,GetHandleId(heldUnit),7003,PNHoldToken)
call SaveUnitHandle(PNHash,GetHandleId(failsafeTimer),0,heldUnit)
call SaveInteger(PNHash,GetHandleId(failsafeTimer),1,PNHoldToken)
// the planet holds at most 5.5 s: a unit still held after 7 s is let go
call TimerStart(failsafeTimer,7.,false,function PNChibakuFailsafe)
set failsafeTimer=null
call IssueImmediateOrder(heldUnit,"stop")
call PauseUnit(heldUnit,true)
call SetUnitInvulnerable(heldUnit,true)
if UnitAddAbility(heldUnit,'Amrf') then
call UnitRemoveAbility(heldUnit,'Amrf')
endif
call SetUnitFlyHeight(heldUnit,1000.,1500.)
endfunction
function PNChibakuFinishTarget takes unit painHero,unit heldUnit,real hitDamage,real centerX,real centerY returns nothing
if heldUnit!=null and GetUnitTypeId(heldUnit)!=0 then
call PNChibakuRelease(heldUnit)
if GetWidgetLife(heldUnit)>.405 then
call SetUnitPosition(heldUnit,centerX,centerY)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(heldUnit),GetUnitY(heldUnit)))
call PNPhysical(painHero,heldUnit,hitDamage)
call PNStunThroughDarkness(painHero,heldUnit,1.)
endif
endif
endfunction
function PNChibakuTick takes nothing returns nothing
local timer chibakuTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(chibakuTimer)
local unit painHero=LoadUnitHandle(PNHash,timerKey,0)
local unit sphere=LoadUnitHandle(PNHash,timerKey,1)
local group heldUnits=LoadGroupHandle(PNHash,timerKey,2)
local integer chibakuTicks=LoadInteger(PNHash,timerKey,3)+1
local real centerX=LoadReal(PNHash,timerKey,4)
local real centerY=LoadReal(PNHash,timerKey,5)
local real sphereStep=LoadReal(PNHash,timerKey,6)
local real sphereAngle=LoadReal(PNHash,timerKey,7)
local group nearbyUnits
local unit nearbyUnit
local real unitX
local real unitY
local real unitDistance
local real effectAngle
local integer effectIndex
local integer checkKey
call SaveInteger(PNHash,timerKey,3,chibakuTicks)
if chibakuTicks==50 then
call PNRelease(painHero)
call SaveBoolean(PNHash,timerKey,10,true)
endif
if chibakuTicks<100 and GetWidgetLife(painHero)<=.405 then
// killed while the sphere flies: the spell is interrupted (after the planet formed it goes on without Pain)
call RemoveUnit(sphere)
if not LoadBoolean(PNHash,timerKey,10) then
call PNRelease(painHero)
endif
call DestroyGroup(heldUnits)
call PNStop(chibakuTimer)
elseif chibakuTicks<100 then
// the black sphere rises and flies to the target point in 2 seconds
call SetUnitX(sphere,GetUnitX(sphere)+sphereStep*Cos(sphereAngle))
call SetUnitY(sphere,GetUnitY(sphere)+sphereStep*Sin(sphereAngle))
elseif chibakuTicks==100 then
call RemoveUnit(sphere)
call SaveUnitHandle(PNHash,timerKey,1,PNDummy(painHero,'hP06',centerX,centerY,sphereAngle*bj_RADTODEG,0.))
call SaveUnitHandle(PNHash,timerKey,8,PNDummy(painHero,'hP07',centerX,centerY,sphereAngle*bj_RADTODEG,0.))
call PNDummy(painHero,'hP08',centerX,centerY,GetRandomReal(0.,360.),4.)
call PNDummy(painHero,'hP09',centerX,centerY,GetRandomReal(0.,360.),4.)
set effectIndex=1
loop
// rings of quakes at 250 / 500 / 750 (2 + 4 + 6 instead of GBR's 4 + 8 + 12: FPS)
exitwhen effectIndex>12
if effectIndex<=2 then
set unitDistance=250.
set effectAngle=180.*effectIndex
elseif effectIndex<=6 then
set unitDistance=500.
set effectAngle=90.*(effectIndex-2)+45.
else
set unitDistance=750.
set effectAngle=60.*(effectIndex-6)
endif
call PNDummy(painHero,'hP10',centerX+unitDistance*Cos(effectAngle*bj_DEGTORAD),centerY+unitDistance*Sin(effectAngle*bj_DEGTORAD),GetRandomReal(0.,360.),5.)
set effectIndex=effectIndex+1
endloop
endif
if chibakuTicks>100 and chibakuTicks<=365 then
// gravity until just before the explosion: rocks fly in, enemies within 800 are drawn to the center and the ones
// there are held; invulnerable units are not touched (checked every 0.5 s per unit and at the capture)
if ModuloInteger(chibakuTicks,10)==0 then
set effectAngle=GetRandomReal(0.,2.*bj_PI)
set unitDistance=GetRandomReal(500.,750.)
set unitX=centerX+unitDistance*Cos(effectAngle)
set unitY=centerY+unitDistance*Sin(effectAngle)
call PNDummy(painHero,'hP11',unitX,unitY,GetRandomReal(0.,360.),.5)
call IssuePointOrder(PNLastDummy,"move",centerX,centerY)
call SetUnitFlyHeight(PNLastDummy,1500.,1000.)
endif
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,centerX,centerY,900.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if PNIsEnemy(painHero,nearbyUnit) and not IsUnitInGroup(nearbyUnit,heldUnits) then
set checkKey=GetHandleId(nearbyUnit)
if not HaveSavedInteger(PNHash,timerKey,checkKey) or chibakuTicks-LoadInteger(PNHash,timerKey,checkKey)/2>=25 then
if PNIsVulnerable(painHero,nearbyUnit) then
call SaveInteger(PNHash,timerKey,checkKey,chibakuTicks*2+1)
else
call SaveInteger(PNHash,timerKey,checkKey,chibakuTicks*2)
endif
endif
endif
if PNIsEnemy(painHero,nearbyUnit) and not IsUnitInGroup(nearbyUnit,heldUnits) and ModuloInteger(LoadInteger(PNHash,timerKey,GetHandleId(nearbyUnit)),2)==1 then
set unitX=GetUnitX(nearbyUnit)
set unitY=GetUnitY(nearbyUnit)
set unitDistance=SquareRoot((centerX-unitX)*(centerX-unitX)+(centerY-unitY)*(centerY-unitY))
if unitDistance<=50. then
if PNIsVulnerable(painHero,nearbyUnit) then
call GroupAddUnit(heldUnits,nearbyUnit)
call PNChibakuHold(nearbyUnit)
endif
else
// pulled only over walkable ground: a unit behind a wall, a cliff or the edge of an arena stays where it is
set effectAngle=Atan2(centerY-unitY,centerX-unitX)
set unitX=unitX+RMinBJ(12.,unitDistance)*Cos(effectAngle)
set unitY=unitY+RMinBJ(12.,unitDistance)*Sin(effectAngle)
if IsUnitType(nearbyUnit,UNIT_TYPE_FLYING) or not IsTerrainPathable(unitX,unitY,PATHING_TYPE_WALKABILITY) then
call SetUnitX(nearbyUnit,unitX)
call SetUnitY(nearbyUnit,unitY)
endif
endif
endif
endloop
call DestroyGroup(nearbyUnits)
endif
if chibakuTicks>100 and chibakuTicks<375 then
// the held enemies stay inside the rock planet
set nearbyUnits=CreateGroup()
call PNCopyGroup(heldUnits,nearbyUnits)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if GetWidgetLife(nearbyUnit)>.405 and GetUnitTypeId(nearbyUnit)!=0 then
if PNChibakuIsHeld(nearbyUnit) then
if not IsUnitPaused(nearbyUnit) then
call IssueImmediateOrder(nearbyUnit,"stop")
call PauseUnit(nearbyUnit,true)
endif
call SetUnitInvulnerable(nearbyUnit,true)
call SetUnitX(nearbyUnit,centerX)
call SetUnitY(nearbyUnit,centerY)
else
call GroupRemoveUnit(heldUnits,nearbyUnit)
endif
else
call PNChibakuRelease(nearbyUnit)
call GroupRemoveUnit(heldUnits,nearbyUnit)
endif
endloop
call DestroyGroup(nearbyUnits)
endif
if chibakuTicks==350 then
set effectIndex=0
loop
exitwhen effectIndex>1
call PNDummy(painHero,'hP12',centerX,centerY,GetRandomReal(0.,360.),3.)
call SetUnitTimeScale(PNLastDummy,.5)
set effectIndex=effectIndex+1
endloop
endif
if chibakuTicks>=375 then
// the planet breaks: the held enemies take the damage and are released
call KillUnit(LoadUnitHandle(PNHash,timerKey,1))
call BvOVfxExpire(LoadUnitHandle(PNHash,timerKey,1),null,3.)
call KillUnit(LoadUnitHandle(PNHash,timerKey,8))
call BvOVfxExpire(LoadUnitHandle(PNHash,timerKey,8),null,3.)
loop
set nearbyUnit=FirstOfGroup(heldUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(heldUnits,nearbyUnit)
call PNChibakuFinishTarget(painHero,nearbyUnit,LoadReal(PNHash,timerKey,9),centerX,centerY)
endloop
call DestroyGroup(heldUnits)
call PNStop(chibakuTimer)
endif
set chibakuTimer=null
set painHero=null
set sphere=null
set heldUnits=null
set nearbyUnits=null
endfunction
function PNChibakuTensei takes unit painHero,real targetX,real targetY returns nothing
local timer chibakuTimer=CreateTimer()
local integer timerKey=GetHandleId(chibakuTimer)
local real sphereAngle=Atan2(targetY-GetUnitY(painHero),targetX-GetUnitX(painHero))
local real sphereDistance=SquareRoot((targetX-GetUnitX(painHero))*(targetX-GetUnitX(painHero))+(targetY-GetUnitY(painHero))*(targetY-GetUnitY(painHero)))
local unit sphere=PNDummy(painHero,'hP05',GetUnitX(painHero),GetUnitY(painHero),sphereAngle*bj_RADTODEG,0.)
local integer chibakuLevel=GetUnitAbilityLevel(painHero,'PN04')
local real chibakuIntFactor=.8+.2*chibakuLevel
if chibakuLevel>=5 then
set chibakuIntFactor=2.
endif
call SetUnitFlyHeight(sphere,1000.,300.)
call PNPlay(4,painHero)
call PNHold(painHero)
call SetUnitFacing(painHero,sphereAngle*bj_RADTODEG)
call SetUnitAnimationByIndex(painHero,11)
call SetUnitTimeScale(painHero,2.)
call SaveUnitHandle(PNHash,timerKey,0,painHero)
call SaveUnitHandle(PNHash,timerKey,1,sphere)
call SaveGroupHandle(PNHash,timerKey,2,CreateGroup())
call SaveInteger(PNHash,timerKey,3,0)
call SaveReal(PNHash,timerKey,4,targetX)
call SaveReal(PNHash,timerKey,5,targetY)
call SaveReal(PNHash,timerKey,6,sphereDistance/100.)
call SaveReal(PNHash,timerKey,7,sphereAngle)
call SaveReal(PNHash,timerKey,9,50.+350.*chibakuLevel+2.*PNAgi(painHero)+chibakuIntFactor*PNInt(painHero))
call TimerStart(chibakuTimer,.02,true,function PNChibakuTick)
set chibakuTimer=null
set sphere=null
endfunction
// ------------------------------------------------------------------ T: Super Shinra Tensei
function PNSuperShinraTick takes nothing returns nothing
local timer superTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(superTimer)
local unit painHero=LoadUnitHandle(PNHash,timerKey,0)
local integer superTicks=LoadInteger(PNHash,timerKey,1)+1
local real flyStep=LoadReal(PNHash,timerKey,2)
local real flyAngle=LoadReal(PNHash,timerKey,3)
local real painX=GetUnitX(painHero)+flyStep*Cos(flyAngle)
local real painY=GetUnitY(painHero)+flyStep*Sin(flyAngle)
local group nearbyUnits
local unit nearbyUnit
local integer effectIndex=0
local real painHeight=700.
call SaveInteger(PNHash,timerKey,1,superTicks)
if superTicks<50 then
set painHeight=LoadReal(PNHash,timerKey,6)+(700.-LoadReal(PNHash,timerKey,6))*I2R(superTicks)/50.
endif
if superTicks<150 then
call SetUnitFlyHeight(painHero,painHeight,0.)
endif
if superTicks<=50 then
// Pain flies to the target point in 1 second
if RectContainsCoords(bj_mapInitialPlayableArea,painX,painY) then
call SetUnitX(painHero,painX)
call SetUnitY(painHero,painY)
endif
endif
set painX=GetUnitX(painHero)
set painY=GetUnitY(painHero)
if superTicks==100 then
call SetUnitAnimationByIndex(painHero,7)
loop
exitwhen effectIndex>4
call PNDummy(painHero,'hP13',painX,painY,GetRandomReal(0.,360.),2.)
call SetUnitTimeScale(PNLastDummy,.5)
set effectIndex=effectIndex+1
endloop
elseif superTicks==125 then
call PNPlay(6,painHero)
call PNDummy(painHero,'hP14',painX,painY,GetRandomReal(0.,360.),2.)
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,painX,painY,1000.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if PNIsEnemy(painHero,nearbyUnit) then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(nearbyUnit),GetUnitY(nearbyUnit)))
call PNStunThroughDarkness(painHero,nearbyUnit,LoadReal(PNHash,timerKey,5))
call PNDamage(painHero,nearbyUnit,LoadReal(PNHash,timerKey,4))
endif
endloop
call DestroyGroup(nearbyUnits)
elseif superTicks>=150 then
call SetUnitFlyHeight(painHero,GetUnitDefaultFlyHeight(painHero),5000.)
call SetUnitPosition(painHero,painX,painY)
call PNUnlock(painHero)
call PNStop(superTimer)
endif
set superTimer=null
set painHero=null
set nearbyUnits=null
endfunction
function PNSuperShinraTensei takes unit painHero,real targetX,real targetY returns nothing
local timer superTimer=CreateTimer()
local integer timerKey=GetHandleId(superTimer)
local integer superLevel=GetUnitAbilityLevel(painHero,'PNTL')
local real superStartHeight=GetUnitFlyHeight(painHero)
local real flyAngle=Atan2(targetY-GetUnitY(painHero),targetX-GetUnitX(painHero))
local real flyDistance=SquareRoot((targetX-GetUnitX(painHero))*(targetX-GetUnitX(painHero))+(targetY-GetUnitY(painHero))*(targetY-GetUnitY(painHero)))
call PNPlay(5,painHero)
call PNLock(painHero)
call SetUnitFacing(painHero,flyAngle*bj_RADTODEG)
call SetUnitAnimationByIndex(painHero,11)
if UnitAddAbility(painHero,'Amrf') then
call UnitRemoveAbility(painHero,'Amrf')
endif
call SetUnitFlyHeight(painHero,superStartHeight,0.)
call SaveReal(PNHash,timerKey,6,superStartHeight)
call SaveUnitHandle(PNHash,timerKey,0,painHero)
call SaveInteger(PNHash,timerKey,1,0)
call SaveReal(PNHash,timerKey,2,flyDistance/50.)
call SaveReal(PNHash,timerKey,3,flyAngle)
call SaveReal(PNHash,timerKey,4,300.+300.*superLevel+2.*GetHeroStr(painHero,true)+(1.+superLevel)*GetHeroInt(painHero,false))
call SaveReal(PNHash,timerKey,5,1.25+.25*superLevel)
call TimerStart(superTimer,.02,true,function PNSuperShinraTick)
set superTimer=null
endfunction
// ------------------------------------------------------------------ V: Rain of Amegakure
function PNRainEnd takes nothing returns nothing
local timer rainTimer=GetExpiredTimer()
local integer rainSlot=LoadInteger(PNHash,GetHandleId(rainTimer),0)
local unit painHero=LoadUnitHandle(PNHash,GetHandleId(rainTimer),1)
if PNRainWeather[rainSlot]!=null then
call EnableWeatherEffect(PNRainWeather[rainSlot],false)
call RemoveWeatherEffect(PNRainWeather[rainSlot])
set PNRainWeather[rainSlot]=null
endif
call UnitRemoveAbility(painHero,'PN34')
call StopSound(PNSound[10],false,true)
call PNStop(rainTimer)
set rainTimer=null
set painHero=null
endfunction
// rain over the map for as long as its theme plays (15.6 s); Pain sees invisible units around him like with a Gem of True Seeing
function PNRain takes unit painHero returns nothing
local timer rainTimer=CreateTimer()
local integer rainSlot=GetPlayerId(GetOwningPlayer(painHero))
if PNRainWeather[rainSlot]==null then
set PNRainWeather[rainSlot]=AddWeatherEffect(bj_mapInitialPlayableArea,'RAlr')
call EnableWeatherEffect(PNRainWeather[rainSlot],true)
endif
call UnitAddAbility(painHero,'PN34')
call PNPlay(10,painHero)
call SaveInteger(PNHash,GetHandleId(rainTimer),0,rainSlot)
call SaveUnitHandle(PNHash,GetHandleId(rainTimer),1,painHero)
call TimerStart(rainTimer,15.6,false,function PNRainEnd)
set rainTimer=null
endfunction
// ------------------------------------------------------------------ Second W: Chakra Black Rod
function PNRodTick takes nothing returns nothing
local timer rodTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(rodTimer)
local unit painHero=LoadUnitHandle(PNHash,timerKey,0)
local unit rod=LoadUnitHandle(PNHash,timerKey,1)
local integer rodTicks=LoadInteger(PNHash,timerKey,2)+1
local real rodAngle=LoadReal(PNHash,timerKey,3)
local real rodX
local real rodY
local group nearbyUnits
local unit nearbyUnit
local group hitUnits=LoadGroupHandle(PNHash,timerKey,4)
call SaveInteger(PNHash,timerKey,2,rodTicks)
if rodTicks==1 then
call PNKitShowW(painHero,false)
endif
if rodTicks<25 then
if GetWidgetLife(painHero)<=.405 then
// killed before the throw: interrupted
call PNRelease(painHero)
call DestroyGroup(hitUnits)
call PNStop(rodTimer)
endif
elseif rodTicks==25 then
call PNRelease(painHero)
set rod=PNDummy(painHero,'hP16',GetUnitX(painHero)+50.*Cos(rodAngle),GetUnitY(painHero)+50.*Sin(rodAngle),rodAngle*bj_RADTODEG,0.)
call SetUnitScale(rod,1.25,1.25,1.25)
call SaveUnitHandle(PNHash,timerKey,1,rod)
else
// 50 per0.02s (2500/s),25 steps =1250; visual and hit area share the same center.
set rodX=GetUnitX(rod)+50.*Cos(rodAngle)
set rodY=GetUnitY(rod)+50.*Sin(rodAngle)
if RectContainsCoords(bj_mapInitialPlayableArea,rodX,rodY) then
call SetUnitX(rod,rodX)
call SetUnitY(rod,rodY)
endif
if ModuloInteger(rodTicks,2)==0 then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",GetUnitX(rod),GetUnitY(rod)))
endif
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,GetUnitX(rod),GetUnitY(rod),250.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if PNIsEnemy(painHero,nearbyUnit) and not IsUnitInGroup(nearbyUnit,hitUnits) then
call GroupAddUnit(hitUnits,nearbyUnit)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl",nearbyUnit,"chest"))
call AYStun(painHero,nearbyUnit,.75)
call PNDamage(painHero,nearbyUnit,LoadReal(PNHash,timerKey,5))
endif
endloop
call DestroyGroup(nearbyUnits)
if rodTicks>=50 then
call RemoveUnit(rod)
call DestroyGroup(hitUnits)
call PNStop(rodTimer)
endif
endif
set rodTimer=null
set painHero=null
set rod=null
set nearbyUnits=null
set hitUnits=null
endfunction
function PNChakraRod takes unit painHero,real targetX,real targetY returns nothing
local timer rodTimer=CreateTimer()
local real rodAngle=Atan2(targetY-GetUnitY(painHero),targetX-GetUnitX(painHero))
call PNHold(painHero)
call SetUnitFacing(painHero,rodAngle*bj_RADTODEG)
call SetUnitAnimationByIndex(painHero,10)
call SaveUnitHandle(PNHash,GetHandleId(rodTimer),0,painHero)
call SaveInteger(PNHash,GetHandleId(rodTimer),2,0)
call SaveReal(PNHash,GetHandleId(rodTimer),3,rodAngle)
call SaveGroupHandle(PNHash,GetHandleId(rodTimer),4,CreateGroup())
call SaveReal(PNHash,GetHandleId(rodTimer),5,300.+(1.8+.2*GetUnitAbilityLevel(painHero,'PN02'))*PNInt(painHero))
call TimerStart(rodTimer,.02,true,function PNRodTick)
set rodTimer=null
endfunction
// Keep V availability and hidden native evasion in sync with inventory and passive break.
function PNOkenSync takes nothing returns nothing
local group pnKitHeroes=CreateGroup()
local unit pnKitHero
call PNCopyGroup(PNHeroes,pnKitHeroes)
loop
set pnKitHero=FirstOfGroup(pnKitHeroes)
exitwhen pnKitHero==null
call GroupRemoveUnit(pnKitHeroes,pnKitHero)
if GetUnitTypeId(pnKitHero)==0 then
call GroupRemoveUnit(PNHeroes,pnKitHero)
else
call PNKitSync(pnKitHero)
endif
endloop
call DestroyGroup(pnKitHeroes)
set pnKitHeroes=null
set pnKitHero=null
endfunction
// ------------------------------------------------------------------ voices
function PNOnEnter takes nothing returns boolean
local unit painHero=GetTriggerUnit()
if GetUnitTypeId(painHero)=='HP00' and not IsUnitIllusion(painHero) and not LoadBoolean(PNHash,GetHandleId(painHero),0) then
call SaveBoolean(PNHash,GetHandleId(painHero),0,true)
call PNPlayVoice(7)
endif
if GetUnitTypeId(painHero)=='HP00' and not IsUnitIllusion(painHero) and not IsUnitInGroup(painHero,PNHeroes) then
call GroupAddUnit(PNHeroes,painHero)
call PNOkenSync()
endif
set painHero=null
return false
endfunction
// ------------------------------------------------------------------ dispatch
function PNOnSpell takes nothing returns boolean
local unit painHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
if GetUnitTypeId(painHero)=='HP00' and SilenceConditions(painHero) then
if spellId=='PN01' then
call PNShinraTensei(painHero)
elseif spellId=='PN02' then
call PNBanshoTenin(painHero,GetSpellTargetUnit())
elseif spellId=='PN03' then
call PNRinneTensei(painHero)
elseif spellId=='PN04' then
call PNChibakuTensei(painHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='PN05' then
call PNKitRestoreT(painHero)
call PNSuperShinraTensei(painHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='PN06' and FZHasOken(painHero) then
call PNRain(painHero)
elseif spellId=='PN07' and GetUnitAbilityLevel(painHero,'PN02')>0 and LoadBoolean(PNHash,GetHandleId(painHero),70) then
call PNChakraRod(painHero,GetSpellTargetX(),GetSpellTargetY())
endif
endif
set painHero=null
return false
endfunction
function PNMakeSound takes string soundPath,integer soundDuration,boolean is3D returns sound
local sound painSound=CreateSound(soundPath,false,is3D,is3D,10,10,"")
call SetSoundDuration(painSound,soundDuration)
call SetSoundVolume(painSound,127)
if is3D then
call SetSoundDistances(painSound,600.,10000.)
endif
call Preload(soundPath)
return painSound
endfunction
function PNInit takes nothing returns nothing
local trigger spellTrigger=CreateTrigger()
local trigger enterTrigger=CreateTrigger()
local trigger pnTLocalLearn=CreateTrigger()
local trigger pnTLocalCast=CreateTrigger()
local region mapRegion=CreateRegion()
local integer preloadType
local integer pnKitSlot=0
set PNHash=InitHashtable()
loop
exitwhen pnKitSlot>=bj_MAX_PLAYER_SLOTS
call SetPlayerAbilityAvailable(Player(pnKitSlot),'PN06',false)
call SetPlayerAbilityAvailable(Player(pnKitSlot),'PN07',false)
set pnKitSlot=pnKitSlot+1
endloop
// preload the effect models and textures (the first cast loaded them and dropped the FPS)
set preloadType='hP01'
loop
exitwhen preloadType>'hP09'
call RemoveUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),preloadType,-7600.,-6800.,0.))
set preloadType=preloadType+1
endloop
set preloadType='hP10'
loop
exitwhen preloadType>'hP16'
call RemoveUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),preloadType,-7600.,-6800.,0.))
set preloadType=preloadType+1
endloop
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",-7600.,-6800.))
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",-7600.,-6800.))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",-7600.,-6800.))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl",-7600.,-6800.))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\HealingWave\\HealingWaveTarget.mdl",-7600.,-6800.))
call Preload("war3mapImported\\Pain\\Pain.mdl")
set PNHeroes=CreateGroup()
call TimerStart(CreateTimer(),.5,true,function PNOkenSync)
set PNSound[1]=PNMakeSound("war3mapImported\\Pain\\ShinraTensei.mp3",1864,false)
set PNSound[2]=PNMakeSound("war3mapImported\\Pain\\BanshoTenin.mp3",1676,false)
set PNSound[3]=PNMakeSound("war3mapImported\\Pain\\RinneTensei.mp3",3048,false)
set PNSound[4]=PNMakeSound("war3mapImported\\Pain\\ChibakuTensei.mp3",2516,false)
set PNSound[5]=PNMakeSound("war3mapImported\\Pain\\SuperShinraTensei1.mp3",1724,false)
set PNSound[6]=PNMakeSound("war3mapImported\\Pain\\SuperShinraTensei2.mp3",1992,false)
set PNSound[7]=PNMakeSound("war3mapImported\\Pain\\Pick.mp3",24550,false)
set PNSound[10]=PNMakeSound("war3mapImported\\Pain\\RainTheme.mp3",15608,false)
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(spellTrigger,Condition(function PNOnSpell))
set PNChecker=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),'hL02',0.,0.,0.)
call UnitAddAbility(PNChecker,'PN33')
call UnitAddAbility(PNChecker,'PN31')
call RegionAddRect(mapRegion,GetWorldBounds())
call TriggerRegisterEnterRegion(enterTrigger,mapRegion,null)
call TriggerAddCondition(enterTrigger,Condition(function PNOnEnter))
call TriggerRegisterAnyUnitEventBJ(pnTLocalLearn,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(pnTLocalLearn,Condition(function PNKitLearnT))
call TriggerRegisterAnyUnitEventBJ(pnTLocalCast,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(pnTLocalCast,Condition(function PNKitCastT))
set pnTLocalLearn=null
set pnTLocalCast=null
set spellTrigger=null
set enterTrigger=null
set mapRegion=null
endfunction
// ------------------------------------------------------------------ Nelliel Tu Odelschwanck (HN00)
// Model, effects and sounds of Bleach: War of Souls 0.8d (NT1_ The 3rd Espada: NT10 Swallow Energy, NT_2 Cero Double);
// the numbers follow the BvO concept. Every cast runs on its own timer with its data in NLHash; the state of a Nell is
// kept under the handle id of the hero: 10 absorption end time, 11 damage that can still be absorbed, 12 kept damage,
// 13 maximum kept, 20 Cero Double bonus, 21 Cero Double timer.
function NLIsGamuza takes unit nellHero returns boolean
return GetUnitTypeId(nellHero)=='HN01'
endfunction
// HN00 Nell, HN01 her Resurreccion (Gamuza)
function NLIsNell takes unit nellHero returns boolean
return GetUnitTypeId(nellHero)=='HN00' or GetUnitTypeId(nellHero)=='HN01'
endfunction
function NLDamage takes unit nellHero,unit hitUnit,real hitDamage returns nothing
call BvOHeroSpellDamage(nellHero,hitUnit,hitDamage,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endfunction
function NLPlay takes integer soundIndex,unit soundSource returns nothing
if NLSound[soundIndex]!=null then
call StopSound(NLSound[soundIndex],false,false)
call AttachSoundToUnit(NLSound[soundIndex],soundSource)
call StartSound(NLSound[soundIndex])
endif
endfunction
// effect dummies are removed when their time is up, like in BWOS (killing them replays their death animation)
function NLRemoveLaterEnd takes nothing returns nothing
local timer removeTimer=GetExpiredTimer()
call RemoveUnit(LoadUnitHandle(NLHash,GetHandleId(removeTimer),0))
call FlushChildHashtable(NLHash,GetHandleId(removeTimer))
call DestroyTimer(removeTimer)
set removeTimer=null
endfunction
function NLRemoveLater takes unit effectUnit,real effectLife returns nothing
local timer removeTimer=CreateTimer()
call SaveUnitHandle(NLHash,GetHandleId(removeTimer),0,effectUnit)
call TimerStart(removeTimer,effectLife,false,function NLRemoveLaterEnd)
set removeTimer=null
endfunction
function NLDummy takes unit nellHero,integer dummyType,real dummyX,real dummyY,real dummyFacing,real dummyLife returns unit
set NLLastDummy=CreateUnit(GetOwningPlayer(nellHero),dummyType,dummyX,dummyY,dummyFacing)
if dummyLife>0. then
call NLRemoveLater(NLLastDummy,dummyLife)
endif
return NLLastDummy
endfunction
function NLStop takes timer spellTimer returns nothing
call FlushChildHashtable(NLHash,GetHandleId(spellTimer))
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endfunction
function NLTimeScaleEnd takes nothing returns nothing
local timer scaleTimer=GetExpiredTimer()
call SetUnitTimeScale(LoadUnitHandle(NLHash,GetHandleId(scaleTimer),0),LoadReal(NLHash,GetHandleId(scaleTimer),1))
call FlushChildHashtable(NLHash,GetHandleId(scaleTimer))
call DestroyTimer(scaleTimer)
set scaleTimer=null
endfunction
function NLTimeScaleLater takes unit effectUnit,real delay,real timeScale returns nothing
local timer scaleTimer=CreateTimer()
call SaveUnitHandle(NLHash,GetHandleId(scaleTimer),0,effectUnit)
call SaveReal(NLHash,GetHandleId(scaleTimer),1,timeScale)
call TimerStart(scaleTimer,delay,false,function NLTimeScaleEnd)
set scaleTimer=null
endfunction
// ------------------------------------------------------------------ Q: Cero / Cero Double
// the blast of BWOS: discs of the violet beam with a white core and violet rings, it speeds up and widens; here it
// flies 800 (Gamuza 950) in 0.4 s and is 250 (Gamuza 350) wide, the damage strip is exactly the length and width of
// the beam: every enemy whose center is within half the width of the beam's path takes damage once
// Every visual carrier stays at the cast origin; the parent node in each
// model supplies its offset along the ray. Terrain under the ray is irrelevant.
function NLCeroPlaceVisual takes unit effectUnit,real effectX,real effectY,real worldHeight returns nothing
local location terrainPoint=Location(effectX,effectY)
call SetUnitPathing(effectUnit,false)
call SetUnitX(effectUnit,effectX)
call SetUnitY(effectUnit,effectY)
call SetUnitFlyHeight(effectUnit,worldHeight-GetLocationZ(terrainPoint),0.)
call RemoveLocation(terrainPoint)
set terrainPoint=null
endfunction
function NLCeroTick takes nothing returns nothing
local timer ceroTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(ceroTimer)
local unit nellHero=LoadUnitHandle(NLHash,timerKey,0)
local group hitUnits=LoadGroupHandle(NLHash,timerKey,1)
local integer ceroTicks=LoadInteger(NLHash,timerKey,2)+1
local real ceroAngle=LoadReal(NLHash,timerKey,3)
local real startX=LoadReal(NLHash,timerKey,4)
local real startY=LoadReal(NLHash,timerKey,5)
local real ceroLength=LoadReal(NLHash,timerKey,8)
local real halfWidth=LoadReal(NLHash,timerKey,9)
local real travelled=RMinBJ(ceroLength,ceroLength*(ceroTicks*ceroTicks+7*ceroTicks)/540.)
local real previous=RMinBJ(ceroLength,ceroLength*((ceroTicks-1)*(ceroTicks-1)+7*(ceroTicks-1))/540.)
local real discScale=halfWidth/43.5*(.45+.55*RMinBJ(1.,ceroTicks/7.))
local real headX
local real headY
local real stepLength
local real alongPath
local real acrossPath
local real offsetX
local real offsetY
local real visualX=startX-60.*Cos(ceroAngle)
local real visualY=startY-60.*Sin(ceroAngle)
local integer visualBase=0
local integer discIndex=0
local group nearbyUnits
local unit nearbyUnit
if halfWidth>125. then
set visualBase=128
endif
call SaveInteger(NLHash,timerKey,2,ceroTicks)
// two discs per step (the BWOS beam has one per 0.01 s)
loop
exitwhen discIndex>1
set stepLength=previous+(travelled-previous)*(discIndex+1)/2.
set headX=startX+stepLength*Cos(ceroAngle)
set headY=startY+stepLength*Sin(ceroAngle)
call NLDummy(nellHero,NLVisualType[visualBase+(ceroTicks-1)*2+discIndex],visualX,visualY,ceroAngle*bj_RADTODEG,.45)
call NLCeroPlaceVisual(NLLastDummy,visualX,visualY,LoadReal(NLHash,timerKey,10)+145.)
call SetUnitVertexColor(NLLastDummy,185,25,185,255)
call SetUnitScale(NLLastDummy,discScale,discScale,discScale)
if LoadBoolean(NLHash,timerKey,7) then
call NLDummy(nellHero,NLVisualType[visualBase+80+(ceroTicks-1)*2+discIndex],visualX,visualY,ceroAngle*bj_RADTODEG,.45)
else
call NLDummy(nellHero,NLVisualType[visualBase+40+(ceroTicks-1)*2+discIndex],visualX,visualY,ceroAngle*bj_RADTODEG,.45)
endif
call NLCeroPlaceVisual(NLLastDummy,visualX,visualY,LoadReal(NLHash,timerKey,10)+145.)
if LoadBoolean(NLHash,timerKey,7) then
call SetUnitScale(NLLastDummy,discScale*.8,discScale*.8,discScale*.8)
else
call SetUnitScale(NLLastDummy,discScale*(.7-ceroTicks*.01),discScale*(.7-ceroTicks*.01),discScale*(.7-ceroTicks*.01))
endif
set discIndex=discIndex+1
endloop
if ceroTicks==1 or R2I((ceroTicks-1)*.02/.07)>R2I((ceroTicks-2)*.02/.07) then
set discIndex=R2I((ceroTicks-1)*.02/.07)
call NLDummy(nellHero,NLVisualType[visualBase+120+discIndex],visualX,visualY,ceroAngle*bj_RADTODEG,1.25)
call NLCeroPlaceVisual(NLLastDummy,visualX,visualY,LoadReal(NLHash,timerKey,10)+140.)
call SetUnitTimeScale(NLLastDummy,4.)
call NLTimeScaleLater(NLLastDummy,.1,1.)
call SetUnitScale(NLLastDummy,.5+.41*discIndex,.5+.41*discIndex,.5+.41*discIndex)
endif
// damage: the part of the path covered in this step
set nearbyUnits=CreateGroup()
set offsetX=startX+(previous+travelled)/2.*Cos(ceroAngle)
set offsetY=startY+(previous+travelled)/2.*Sin(ceroAngle)
call GroupEnumUnitsInRange(nearbyUnits,offsetX,offsetY,(travelled-previous)/2.+halfWidth+50.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(nellHero,nearbyUnit) and GetUnitAbilityLevel(nearbyUnit,'Avul')==0 and not IsUnitInGroup(nearbyUnit,hitUnits) then
set offsetX=GetUnitX(nearbyUnit)-startX
set offsetY=GetUnitY(nearbyUnit)-startY
set alongPath=offsetX*Cos(ceroAngle)+offsetY*Sin(ceroAngle)
set acrossPath=RAbsBJ(offsetY*Cos(ceroAngle)-offsetX*Sin(ceroAngle))
if alongPath>=0. and alongPath<=travelled and acrossPath<=halfWidth then
call GroupAddUnit(hitUnits,nearbyUnit)
call NLDamage(nellHero,nearbyUnit,LoadReal(NLHash,timerKey,6))
endif
endif
endloop
call DestroyGroup(nearbyUnits)
if travelled>=ceroLength then
call DestroyGroup(hitUnits)
call NLStop(ceroTimer)
endif
set ceroTimer=null
set nellHero=null
set hitUnits=null
set nearbyUnits=null
endfunction
function NLCero takes unit nellHero,real targetX,real targetY,real bonusDamage,boolean isDouble returns nothing
local timer ceroTimer=CreateTimer()
local integer timerKey=GetHandleId(ceroTimer)
local integer ceroLevel=GetUnitAbilityLevel(nellHero,'NL01')
local real ceroAngle=Atan2(targetY-GetUnitY(nellHero),targetX-GetUnitX(nellHero))
local real ceroDamage
local location castPoint=Location(GetUnitX(nellHero),GetUnitY(nellHero))
if NLIsGamuza(nellHero) then
set ceroDamage=100.+50.*ceroLevel+2.5*GetHeroAgi(nellHero,false)+1.5*GetHeroInt(nellHero,true)
call SaveReal(NLHash,timerKey,8,950.)
call SaveReal(NLHash,timerKey,9,175.)
else
set ceroDamage=50.+25.*ceroLevel+1.5*GetHeroAgi(nellHero,false)+.5*GetHeroInt(nellHero,true)
call SaveReal(NLHash,timerKey,8,800.)
call SaveReal(NLHash,timerKey,9,125.)
endif
call SetUnitFacing(nellHero,ceroAngle*bj_RADTODEG)
call SetUnitAnimationByIndex(nellHero,9)
call QueueUnitAnimation(nellHero,"stand")
call NLPlay(2,nellHero)
call SaveReal(NLHash,timerKey,10,GetLocationZ(castPoint)+GetUnitFlyHeight(nellHero))
call RemoveLocation(castPoint)
set castPoint=null
call SaveUnitHandle(NLHash,timerKey,0,nellHero)
call SaveGroupHandle(NLHash,timerKey,1,CreateGroup())
call SaveInteger(NLHash,timerKey,2,0)
call SaveReal(NLHash,timerKey,3,ceroAngle)
call SaveReal(NLHash,timerKey,4,GetUnitX(nellHero)+60.*Cos(ceroAngle))
call SaveReal(NLHash,timerKey,5,GetUnitY(nellHero)+60.*Sin(ceroAngle))
call SaveReal(NLHash,timerKey,6,ceroDamage+bonusDamage)
call SaveBoolean(NLHash,timerKey,7,isDouble)
call TimerStart(ceroTimer,.02,true,function NLCeroTick)
set ceroTimer=null
endfunction
// Cero Double takes the place of Cero for 5 seconds after an absorption; once cast it stays on the button for its
// cooldown, then Cero comes back
function NLCeroDoubleOff takes nothing returns nothing
local timer doubleTimer=GetExpiredTimer()
local unit nellHero=LoadUnitHandle(NLHash,GetHandleId(doubleTimer),0)
call UnitRemoveAbility(nellHero,'NL11')
call SetPlayerAbilityAvailable(GetOwningPlayer(nellHero),'NL01',true)
call SaveReal(NLHash,GetHandleId(nellHero),20,0.)
call RemoveSavedHandle(NLHash,GetHandleId(nellHero),21)
call FlushChildHashtable(NLHash,GetHandleId(doubleTimer))
call DestroyTimer(doubleTimer)
set doubleTimer=null
set nellHero=null
endfunction
function NLCeroDoubleTimer takes unit nellHero,real waitTime returns nothing
local timer doubleTimer=LoadTimerHandle(NLHash,GetHandleId(nellHero),21)
if doubleTimer==null then
set doubleTimer=CreateTimer()
call SaveTimerHandle(NLHash,GetHandleId(nellHero),21,doubleTimer)
call SaveUnitHandle(NLHash,GetHandleId(doubleTimer),0,nellHero)
endif
call TimerStart(doubleTimer,waitTime,false,function NLCeroDoubleOff)
set doubleTimer=null
endfunction
function NLCeroDoubleOn takes unit nellHero,real bonusDamage returns nothing
if GetUnitAbilityLevel(nellHero,'NL01')==0 then
return
endif
call SaveReal(NLHash,GetHandleId(nellHero),20,bonusDamage)
call SetPlayerAbilityAvailable(GetOwningPlayer(nellHero),'NL01',false)
if GetUnitAbilityLevel(nellHero,'NL11')==0 then
call UnitAddAbility(nellHero,'NL11')
// kept through the form change of Gamuza
call UnitMakeAbilityPermanent(nellHero,true,'NL11')
endif
call SetUnitAbilityLevel(nellHero,'NL11',GetUnitAbilityLevel(nellHero,'NL01'))
call NLCeroDoubleTimer(nellHero,5.)
endfunction
// ------------------------------------------------------------------ W: Energy Absorption
function NLAbsorbTick takes nothing returns nothing
local timer absorbTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(absorbTimer)
local unit nellHero=LoadUnitHandle(NLHash,timerKey,0)
local integer absorbTicks=LoadInteger(NLHash,timerKey,1)+1
local integer heroKey=GetHandleId(nellHero)
local integer buffIndex=0
local real keptDamage
call SaveInteger(NLHash,timerKey,1,absorbTicks)
if GetWidgetLife(nellHero)>.405 and TimerGetElapsed(AYClock)<LoadReal(NLHash,heroKey,10) then
// immune to stuns and sleep: their buffs are taken away while the absorption lasts
loop
exitwhen buffIndex>=NLStunBuffCount
call UnitRemoveAbility(nellHero,NLStunBuff[buffIndex])
set buffIndex=buffIndex+1
endloop
if ModuloInteger(absorbTicks,8)==1 then
call NLDummy(nellHero,'hN03',GetUnitX(nellHero),GetUnitY(nellHero),GetRandomReal(0.,359.),1.4)
call SetUnitTimeScale(NLLastDummy,GetRandomReal(.5,1.))
call SetUnitVertexColor(NLLastDummy,255,255,255,145)
endif
else
call SaveReal(NLHash,heroKey,10,0.)
// she stood still while absorbing
call PauseUnit(nellHero,false)
set keptDamage=RMinBJ(LoadReal(NLHash,heroKey,12),LoadReal(NLHash,heroKey,13))
if keptDamage>0. and GetWidgetLife(nellHero)>.405 then
if NLIsGamuza(nellHero) then
call NLCeroDoubleOn(nellHero,keptDamage*.75)
else
call NLCeroDoubleOn(nellHero,keptDamage*.5)
endif
endif
call NLStop(absorbTimer)
endif
set absorbTimer=null
set nellHero=null
endfunction
function NLEnergyAbsorption takes unit nellHero returns nothing
local timer absorbTimer=CreateTimer()
local integer heroKey=GetHandleId(nellHero)
local integer absorbLevel=GetUnitAbilityLevel(nellHero,'NL02')
local real absorbLimit=100.*absorbLevel+2.5*GetHeroStr(nellHero,true)+GetHeroInt(nellHero,true)
if absorbLevel>=3 then
set absorbLimit=absorbLimit+100.
endif
call SaveReal(NLHash,heroKey,10,TimerGetElapsed(AYClock)+.75+.25*absorbLevel)
call SaveReal(NLHash,heroKey,11,absorbLimit)
call SaveReal(NLHash,heroKey,12,0.)
call SaveReal(NLHash,heroKey,13,100.*absorbLevel+3.5*GetHeroStr(nellHero,true)+2.*GetHeroInt(nellHero,true))
// BWOS Swallow Energy: Nell index 13 (spell five), Gamuza index 12 (Spell One)
if NLIsGamuza(nellHero) then
call SetUnitAnimationByIndex(nellHero,12)
else
call SetUnitAnimationByIndex(nellHero,13)
endif
call QueueUnitAnimation(nellHero,"stand")
call NLPlay(1,nellHero)
call SaveUnitHandle(NLHash,GetHandleId(absorbTimer),0,nellHero)
call SaveInteger(NLHash,GetHandleId(absorbTimer),1,0)
call PauseUnit(nellHero,true)
call TimerStart(absorbTimer,.02,true,function NLAbsorbTick)
set absorbTimer=null
endfunction
// absorption of magic spell / item damage while W lasts, then the passive Hierro
// Nell: only reserve life that would otherwise be clamped before the hit.
// The buffer is shared by all blocks until the zero-time cleanup; damage and
// W absorption accounting remain synchronous and use the original formulas.
function NLChangeLifeBuffer takes unit protectedUnit,integer amount,boolean increase returns nothing
local integer bufferAbility='NL0J'
local integer bufferLevel=2
if increase then
set bufferAbility='NL0H'
endif
loop
exitwhen amount<=0
if amount-(amount/2)*2==1 then
call UnitAddAbility(protectedUnit,bufferAbility)
call SetUnitAbilityLevel(protectedUnit,bufferAbility,bufferLevel)
call UnitRemoveAbility(protectedUnit,bufferAbility)
endif
set amount=amount/2
set bufferLevel=bufferLevel+1
endloop
endfunction
function NLLifeBufferEnd takes nothing returns nothing
local timer bufferTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(bufferTimer)
local unit protectedUnit=LoadUnitHandle(NLHash,timerKey,0)
local integer heroKey=GetHandleId(protectedUnit)
local integer bufferAmount=LoadInteger(NLHash,heroKey,90)
local real lifeAfterHit=GetWidgetLife(protectedUnit)
call RemoveSavedInteger(NLHash,heroKey,90)
call RemoveSavedHandle(NLHash,heroKey,91)
if GetUnitTypeId(protectedUnit)!=0 then
call NLChangeLifeBuffer(protectedUnit,bufferAmount,false)
if lifeAfterHit>.405 then
call SetWidgetLife(protectedUnit,lifeAfterHit)
endif
endif
call FlushChildHashtable(NLHash,timerKey)
call DestroyTimer(bufferTimer)
set bufferTimer=null
set protectedUnit=null
endfunction
function NLPreventDamage takes unit protectedUnit,real preventedAmount returns nothing
local real currentLife=GetWidgetLife(protectedUnit)
local real overflow
local integer bufferAmount
local integer heroKey=GetHandleId(protectedUnit)
local timer bufferTimer
if preventedAmount<=0. then
return
endif
if preventedAmount>Damage then
set preventedAmount=Damage
endif
set overflow=currentLife+preventedAmount-GetUnitState(protectedUnit,UNIT_STATE_MAX_LIFE)
if overflow>0. then
set bufferAmount=R2I(overflow)+1
call NLChangeLifeBuffer(protectedUnit,bufferAmount,true)
call SaveInteger(NLHash,heroKey,90,LoadInteger(NLHash,heroKey,90)+bufferAmount)
set bufferTimer=LoadTimerHandle(NLHash,heroKey,91)
if bufferTimer==null then
set bufferTimer=CreateTimer()
call SaveTimerHandle(NLHash,heroKey,91,bufferTimer)
call SaveUnitHandle(NLHash,GetHandleId(bufferTimer),0,protectedUnit)
call TimerStart(bufferTimer,0.,false,function NLLifeBufferEnd)
endif
set bufferTimer=null
endif
call SetWidgetLife(protectedUnit,currentLife+preventedAmount)
set Damage=Damage-preventedAmount
endfunction
function NLDamageHook takes nothing returns nothing
local integer heroKey
local integer hierroLevel
local real absorbed
local texttag absorbText
if GhostScepterDoubling or Damage<=0. or Target==null or Source==null or not NLIsNell(Target) or IsUnitIllusion(Target) or not IsUnitEnemy(Source,GetOwningPlayer(Target)) then
return
endif
set heroKey=GetHandleId(Target)
if DamageMode==MODE_SPELL and DamageType==MAGICAL and TimerGetElapsed(AYClock)<LoadReal(NLHash,heroKey,10) and LoadReal(NLHash,heroKey,11)>0. then
set absorbed=RMinBJ(Damage,LoadReal(NLHash,heroKey,11))
call NLPreventDamage(Target,absorbed)
call SaveReal(NLHash,heroKey,11,LoadReal(NLHash,heroKey,11)-absorbed)
call SaveReal(NLHash,heroKey,12,LoadReal(NLHash,heroKey,12)+absorbed)
set absorbText=CreateTextTag()
call SetTextTagText(absorbText,"|cffc864ff+"+I2S(R2I(absorbed))+"|r",.023)
call SetTextTagPos(absorbText,GetUnitX(Target),GetUnitY(Target),GetUnitFlyHeight(Target)+60.)
call SetTextTagVelocity(absorbText,0.,.04)
call SetTextTagPermanent(absorbText,false)
call SetTextTagLifespan(absorbText,1.5)
call SetTextTagFadepoint(absorbText,1.)
set absorbText=null
endif
set hierroLevel=GetUnitAbilityLevel(Target,'NL02')
if hierroLevel>0 and Damage>0. and not BvOPassivesBroken(Target) and (DamageMode==MODE_ATTACK or DamageType==PHYSICAL or DamageType==MAGICAL or DamageType==MIXED) then
// Hierro: 3/3/4/4/5% + 0.1 x base AGI (Gamuza: 6/6/8/8/10% + 0.1 x base AGI)
if NLIsGamuza(Target) then
call NLPreventDamage(Target,Damage*(4+2*((hierroLevel+1)/2))/100.+.1*GetHeroAgi(Target,false))
else
call NLPreventDamage(Target,Damage*(2+(hierroLevel+1)/2)/100.+.1*GetHeroAgi(Target,false))
endif
endif
endfunction
// ------------------------------------------------------------------ shared helpers of E / R / T / V
function NLInMap takes real pointX,real pointY returns boolean
return pointX>GetRectMinX(bj_mapInitialPlayableArea)+64. and pointX<GetRectMaxX(bj_mapInitialPlayableArea)-64. and pointY>GetRectMinY(bj_mapInitialPlayableArea)+64. and pointY<GetRectMaxY(bj_mapInitialPlayableArea)-64.
endfunction
function NLIsStunned takes unit nellHero returns boolean
local integer buffIndex=0
if IsUnitPaused(nellHero) then
return true
endif
loop
exitwhen buffIndex>=NLStunBuffCount
if GetUnitAbilityLevel(nellHero,NLStunBuff[buffIndex])>0 then
return true
endif
set buffIndex=buffIndex+1
endloop
return false
endfunction
// a push over the ground (stops at unwalkable ground and at the edge of the map)
function NLPushTick takes nothing returns nothing
local timer pushTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(pushTimer)
local unit pushedUnit=LoadUnitHandle(NLHash,timerKey,0)
local integer pushTicks=LoadInteger(NLHash,timerKey,1)-1
local real pushStep=LoadReal(NLHash,timerKey,2)
local real pushAngle=LoadReal(NLHash,timerKey,3)
local real pushX=GetUnitX(pushedUnit)+pushStep*Cos(pushAngle)
local real pushY=GetUnitY(pushedUnit)+pushStep*Sin(pushAngle)
call SaveInteger(NLHash,timerKey,1,pushTicks)
if GetWidgetLife(pushedUnit)>.405 and NLInMap(pushX,pushY) and not IsTerrainPathable(pushX,pushY,PATHING_TYPE_WALKABILITY) then
call SetUnitX(pushedUnit,pushX)
call SetUnitY(pushedUnit,pushY)
else
set pushTicks=0
endif
if pushTicks<=0 then
call NLStop(pushTimer)
endif
set pushTimer=null
set pushedUnit=null
endfunction
function NLPush takes unit pushedUnit,real pushDistance,real pushDuration,real pushAngle returns nothing
local timer pushTimer
local integer pushTicks=R2I(pushDuration/.03+.5)
if pushDistance<=0. or pushTicks<1 or IsUnitType(pushedUnit,UNIT_TYPE_STRUCTURE) or IsUnitType(pushedUnit,UNIT_TYPE_FLYING) then
return
endif
set pushTimer=CreateTimer()
call SaveUnitHandle(NLHash,GetHandleId(pushTimer),0,pushedUnit)
call SaveInteger(NLHash,GetHandleId(pushTimer),1,pushTicks)
call SaveReal(NLHash,GetHandleId(pushTimer),2,pushDistance/pushTicks)
call SaveReal(NLHash,GetHandleId(pushTimer),3,pushAngle)
call TimerStart(pushTimer,.03,true,function NLPushTick)
set pushTimer=null
endfunction
function NLSlow takes unit nellHero,unit slowedUnit returns nothing
local unit slowCaster=CreateUnit(GetOwningPlayer(nellHero),'hL02',GetUnitX(slowedUnit)-16.,GetUnitY(slowedUnit),0.)
call UnitAddAbility(slowCaster,'NL32')
call UnitApplyTimedLife(slowCaster,'BTLF',1.)
call IssueTargetOrder(slowCaster,"slow",slowedUnit)
set slowCaster=null
endfunction
function NLStrikeDebuffs takes unit nellHero,unit targetUnit,real pushAngle returns nothing
local real casterX=GetUnitX(targetUnit)-30.*Cos(pushAngle)
local real casterY=GetUnitY(targetUnit)-30.*Sin(pushAngle)
local unit debuffCaster=CreateUnit(GetOwningPlayer(nellHero),'hL02',casterX,casterY,pushAngle*bj_RADTODEG)
call UnitAddAbility(debuffCaster,'AY0S')
call SetUnitAbilityLevel(debuffCaster,'AY0S',2)
call UnitApplyTimedLife(debuffCaster,'BTLF',1.)
call IssueTargetOrder(debuffCaster,"thunderbolt",targetUnit)
set debuffCaster=CreateUnit(GetOwningPlayer(nellHero),'hL02',casterX,casterY,pushAngle*bj_RADTODEG)
call UnitAddAbility(debuffCaster,'NL32')
call UnitApplyTimedLife(debuffCaster,'BTLF',1.)
call IssueTargetOrder(debuffCaster,"slow",targetUnit)
set debuffCaster=null
endfunction
function NLCeroMana takes integer ceroLevel returns integer
if ceroLevel<=3 then
return 125+25*ceroLevel
endif
return 50+50*ceroLevel
endfunction
// ------------------------------------------------------------------ E: Resurreccion - Gamuza
// a form change with a duration like Ishida's T (Chemical Rage base, 0.35 s); the release wave is a purple copy of
// Ishida's T (slow wave, 100 push within 460). Hero keys: 30 base AGI bonus, 31 end time,
// 32 watch timer.
// T Lanzador Verde: the active NL15 only in Gamuza, the learnable NL05 (greyed out passive look) in the normal form
function NLLanzadorSync takes unit nellHero returns nothing
local boolean inGamuza=GetUnitTypeId(nellHero)=='HN01'
if GetUnitAbilityLevel(nellHero,'NL05')==0 then
return
endif
if GetUnitAbilityLevel(nellHero,'NL16')==0 then
call UnitAddAbility(nellHero,'NL16')
call UnitMakeAbilityPermanent(nellHero,true,'NL16')
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(nellHero),'NL05',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(nellHero),'NL16',not inGamuza)
call SetPlayerAbilityAvailable(GetOwningPlayer(nellHero),'NL15',inGamuza)
endfunction
function NLGamuzaWatch takes nothing returns nothing
local timer watchTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(watchTimer)
local unit nellHero=LoadUnitHandle(NLHash,timerKey,0)
local integer heroKey=GetHandleId(nellHero)
local integer watchTicks=LoadInteger(NLHash,timerKey,1)+1
local integer agiBonus
call SaveInteger(NLHash,timerKey,1,watchTicks)
if watchTicks==2 and GetWidgetLife(nellHero)>.405 then
call SetUnitAnimationByIndex(nellHero,2)
call QueueUnitAnimation(nellHero,"stand")
endif
if watchTicks==6 then
call SetUnitTimeScale(nellHero,1.)
endif
if watchTicks==8 then
call DestroyEffect(LoadEffectHandle(NLHash,heroKey,33))
call RemoveSavedHandle(NLHash,heroKey,33)
endif
call NLLanzadorSync(nellHero)
// the form ends by itself (the duration of the ability); the AGI bonus ends with it
if TimerGetElapsed(AYClock)>=LoadReal(NLHash,heroKey,31) or (watchTicks>=4 and GetUnitTypeId(nellHero)!='HN01') then
set agiBonus=LoadInteger(NLHash,heroKey,30)
if agiBonus>0 then
call SetHeroAgi(nellHero,GetHeroAgi(nellHero,false)-agiBonus,true)
call SaveInteger(NLHash,heroKey,30,0)
endif
// the watch stops once she is back in the normal form (T greyed out again)
if watchTicks>=4 and GetUnitTypeId(nellHero)!='HN01' then
call SetUnitTimeScale(nellHero,1.)
call RemoveSavedHandle(NLHash,heroKey,32)
call NLStop(watchTimer)
endif
endif
set watchTimer=null
set nellHero=null
endfunction
function NLGamuzaRelease takes unit nellHero,integer gamuzaLevel returns nothing
local integer heroKey=GetHandleId(nellHero)
local real nellX=GetUnitX(nellHero)
local real nellY=GetUnitY(nellHero)
local unit releaseCaster
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
local real pushAngle
local integer waveIndex=1
local integer agiBonus=5*gamuzaLevel
local real healPercent=5.*(gamuzaLevel-1)
local timer watchTimer
if gamuzaLevel==1 then
set healPercent=5.
endif
call SetUnitTimeScale(nellHero,.5)
// the slow wave of Ishida's T, purple
set releaseCaster=CreateUnit(GetOwningPlayer(nellHero),'hL02',nellX,nellY,0.)
call UnitAddAbility(releaseCaster,'NL31')
call UnitApplyTimedLife(releaseCaster,'BTLF',2.)
call IssueImmediateOrderById(releaseCaster,852096)
call GroupEnumUnitsInRange(nearbyUnits,nellX,nellY,460.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(nellHero,nearbyUnit) and GetUnitAbilityLevel(nearbyUnit,'Avul')==0 and not IsUnitType(nearbyUnit,UNIT_TYPE_FLYING) then
set pushAngle=Atan2(GetUnitY(nearbyUnit)-nellY,GetUnitX(nearbyUnit)-nellX)
call SetUnitPosition(nearbyUnit,GetUnitX(nearbyUnit)+100.*Cos(pushAngle),GetUnitY(nearbyUnit)+100.*Sin(pushAngle))
call IssueImmediateOrderById(nearbyUnit,851972)
call SetUnitFacing(nearbyUnit,pushAngle*bj_RADTODEG+180.)
endif
endloop
call DestroyGroup(nearbyUnits)
call NLDummy(nellHero,'hN21',nellX,nellY,0.,2.)
call SetUnitVertexColor(NLLastDummy,190,70,255,255)
loop
exitwhen waveIndex>3
call NLDummy(nellHero,'hN20',nellX,nellY,0.,3.)
call SetUnitTimeScale(NLLastDummy,1.5*waveIndex)
call SetUnitVertexColor(NLLastDummy,170,60,255,255)
set waveIndex=waveIndex+1
endloop
call NLDummy(nellHero,'hN22',nellX,nellY,0.,2.)
call SetUnitVertexColor(NLLastDummy,190,70,255,255)
call NLDummy(nellHero,'hN19',nellX,nellY,GetRandomReal(0.,359.),3.5)
call QueueUnitAnimation(NLLastDummy,"death")
call NLPlay(7,nellHero)
if GetWidgetLife(nellHero)>.35*GetUnitState(nellHero,UNIT_STATE_MAX_LIFE) then
call UNHeal(nellHero,GetUnitState(nellHero,UNIT_STATE_MAX_LIFE)*healPercent/100.)
endif
if LoadInteger(NLHash,heroKey,30)>0 then
call SetHeroAgi(nellHero,GetHeroAgi(nellHero,false)-LoadInteger(NLHash,heroKey,30),true)
endif
call SetHeroAgi(nellHero,GetHeroAgi(nellHero,false)+agiBonus,true)
call SaveInteger(NLHash,heroKey,30,agiBonus)
call SaveReal(NLHash,heroKey,31,TimerGetElapsed(AYClock)+20.35+5.*gamuzaLevel)
set watchTimer=LoadTimerHandle(NLHash,heroKey,32)
if watchTimer==null then
set watchTimer=CreateTimer()
call SaveTimerHandle(NLHash,heroKey,32,watchTimer)
call SaveUnitHandle(NLHash,GetHandleId(watchTimer),0,nellHero)
endif
call SaveInteger(NLHash,GetHandleId(watchTimer),1,0)
call TimerStart(watchTimer,.25,true,function NLGamuzaWatch)
set releaseCaster=null
set nearbyUnits=null
set watchTimer=null
endfunction
function NLGamuza takes unit nellHero returns nothing
local real nellFacing=GetUnitFacing(nellHero)*bj_DEGTORAD
if GetUnitTypeId(nellHero)=='HN00' then
call SetUnitAnimationByIndex(nellHero,16)
endif
// the release of BWOS in a moment: starfall, the violet flashes and the dust wave
call NLDummy(nellHero,'hN17',GetUnitX(nellHero),GetUnitY(nellHero),0.,2.)
call NLDummy(nellHero,'hN18',GetUnitX(nellHero)+50.*Cos(nellFacing),GetUnitY(nellHero)+50.*Sin(nellFacing),nellFacing*bj_RADTODEG,1.5)
call SetUnitTimeScale(NLLastDummy,.4)
call NLDummy(nellHero,'hN18',GetUnitX(nellHero)+50.*Cos(nellFacing),GetUnitY(nellHero)+50.*Sin(nellFacing),nellFacing*bj_RADTODEG,1.5)
call SetUnitTimeScale(NLLastDummy,.3)
call NLDummy(nellHero,'hN16',GetUnitX(nellHero),GetUnitY(nellHero),GetRandomReal(0.,359.),1.1)
call SetUnitScale(NLLastDummy,3.,3.,3.)
call SetUnitAnimation(NLLastDummy,"stand")
call SetUnitVertexColor(NLLastDummy,255,120,255,75)
call DestroyEffect(LoadEffectHandle(NLHash,GetHandleId(nellHero),33))
call SaveEffectHandle(NLHash,GetHandleId(nellHero),33,AddSpecialEffectTarget("war3mapImported\\Nell\\GamuzaWeapon.mdl",nellHero,"weapon"))
call NLGamuzaRelease(nellHero,GetUnitAbilityLevel(nellHero,'NL03'))
endfunction
// ------------------------------------------------------------------ R: Super Acceleration - Swift Strikes
// BWOS 0.8d Swift Hunt: after the focus Nell dashes 40 per 0.01 s from enemy to enemy (here 80 per 0.02 s, no
// invulnerability); each strike: 500 push over 0.5 s, the hit effects of BWOS, damage, 0.5 s stun, 25% slow.
// The area ring is seen by Nell's allies only.
function NLSwiftNext takes integer timerKey,unit nellHero returns unit
local group remainingUnits=LoadGroupHandle(NLHash,timerKey,1)
local group checkUnits=CreateGroup()
local unit candidate
local unit pickedUnit=null
local real pickedDistance=99999.
local real candidateDistance
local integer refill=0
loop
exitwhen pickedUnit!=null or refill>1
if refill==1 then
// every target was struck: the strikes go round again (enemies still within the area); heroes first, the other
// units only when there is no enemy hero in the area
call GroupClear(remainingUnits)
call GroupEnumUnitsInRange(checkUnits,LoadReal(NLHash,timerKey,6),LoadReal(NLHash,timerKey,7),LoadReal(NLHash,timerKey,8),null)
loop
set candidate=FirstOfGroup(checkUnits)
exitwhen candidate==null
call GroupRemoveUnit(checkUnits,candidate)
if SKIsEnemy(nellHero,candidate) and GetUnitAbilityLevel(candidate,'Avul')==0 and IsUnitVisible(candidate,GetOwningPlayer(nellHero)) then
call GroupAddUnit(remainingUnits,candidate)
endif
endloop
endif
call GroupAddGroup(remainingUnits,checkUnits)
loop
set candidate=FirstOfGroup(checkUnits)
exitwhen candidate==null
call GroupRemoveUnit(checkUnits,candidate)
if SKIsEnemy(nellHero,candidate) and GetUnitAbilityLevel(candidate,'Avul')==0 then
set candidateDistance=SquareRoot((GetUnitX(candidate)-GetUnitX(nellHero))*(GetUnitX(candidate)-GetUnitX(nellHero))+(GetUnitY(candidate)-GetUnitY(nellHero))*(GetUnitY(candidate)-GetUnitY(nellHero)))
if candidateDistance<pickedDistance then
set pickedDistance=candidateDistance
set pickedUnit=candidate
endif
else
call GroupRemoveUnit(remainingUnits,candidate)
endif
endloop
set refill=refill+1
endloop
call DestroyGroup(checkUnits)
set remainingUnits=null
set checkUnits=null
set candidate=null
return pickedUnit
endfunction
function NLSwiftEnd takes timer swiftTimer,unit nellHero returns nothing
call SetUnitVertexColor(nellHero,255,255,255,255)
call SetUnitTimeScale(nellHero,1.)
call SetUnitPosition(nellHero,GetUnitX(nellHero),GetUnitY(nellHero))
call DestroyGroup(LoadGroupHandle(NLHash,GetHandleId(swiftTimer),1))
call NLStop(swiftTimer)
endfunction
function NLSwiftTick takes nothing returns nothing
local timer swiftTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(swiftTimer)
local unit nellHero=LoadUnitHandle(NLHash,timerKey,0)
local unit targetUnit=LoadUnitHandle(NLHash,timerKey,2)
local real targetTime=LoadReal(NLHash,timerKey,4)
local real nellX=GetUnitX(nellHero)
local real nellY=GetUnitY(nellHero)
local real dashAngle
local real dashDistance
local real dashStep
local real hitX
local real hitY
if GetWidgetLife(nellHero)<=.405 or NLIsStunned(nellHero) then
call NLSwiftEnd(swiftTimer,nellHero)
else
if targetUnit==null then
set targetUnit=NLSwiftNext(timerKey,nellHero)
if targetUnit==null then
call NLSwiftEnd(swiftTimer,nellHero)
set swiftTimer=null
set nellHero=null
return
endif
call SaveUnitHandle(NLHash,timerKey,2,targetUnit)
set targetTime=0.
call SetUnitAnimation(nellHero,"attack")
call NLPlay(4,nellHero)
endif
set dashDistance=SquareRoot((GetUnitX(targetUnit)-nellX)*(GetUnitX(targetUnit)-nellX)+(GetUnitY(targetUnit)-nellY)*(GetUnitY(targetUnit)-nellY))
set dashAngle=Atan2(GetUnitY(targetUnit)-nellY,GetUnitX(targetUnit)-nellX)
if GetWidgetLife(targetUnit)<=.405 or targetTime>=1. then
// dead or out of reach: the next enemy
call RemoveSavedHandle(NLHash,timerKey,2)
call GroupRemoveUnit(LoadGroupHandle(NLHash,timerKey,1),targetUnit)
if GetWidgetLife(targetUnit)>.405 then
// not reached in 1 second: the strike is lost
call SaveInteger(NLHash,timerKey,3,LoadInteger(NLHash,timerKey,3)-1)
if LoadInteger(NLHash,timerKey,3)<=0 then
call NLSwiftEnd(swiftTimer,nellHero)
endif
endif
elseif dashDistance>110. then
if targetTime>.06 then
set dashStep=RMinBJ(80.,dashDistance-60.)
if NLInMap(nellX+dashStep*Cos(dashAngle),nellY+dashStep*Sin(dashAngle)) then
call SetUnitX(nellHero,nellX+dashStep*Cos(dashAngle))
call SetUnitY(nellHero,nellY+dashStep*Sin(dashAngle))
endif
call SetUnitFacing(nellHero,dashAngle*bj_RADTODEG)
call NLRemoveLater(NLDummy(nellHero,'hN05',nellX,nellY,dashAngle*bj_RADTODEG+90.,0.),.3)
call SetUnitTimeScale(NLLastDummy,1.25)
call SetUnitVertexColor(NLLastDummy,0,0,0,105)
endif
call SaveReal(NLHash,timerKey,4,targetTime+.02)
else
// the strike
set hitX=GetUnitX(targetUnit)
set hitY=GetUnitY(targetUnit)
call NLRemoveLater(NLDummy(nellHero,'hN06',hitX,hitY,dashAngle*bj_RADTODEG,0.),1.45)
call SetUnitTimeScale(NLLastDummy,.55)
call NLRemoveLater(NLDummy(nellHero,'hN07',hitX,hitY,dashAngle*bj_RADTODEG,0.),1.45)
call SetUnitTimeScale(NLLastDummy,.5)
call NLRemoveLater(NLDummy(nellHero,'hN08',hitX,hitY,dashAngle*bj_RADTODEG,0.),1.3)
call SetUnitTimeScale(NLLastDummy,.6)
call NLRemoveLater(NLDummy(nellHero,'hN09',hitX,hitY,dashAngle*bj_RADTODEG,0.),1.9)
call SetUnitAnimation(NLLastDummy,"death")
call SetUnitTimeScale(NLLastDummy,.15)
call NLRemoveLater(NLDummy(nellHero,'hN10',hitX,hitY,0.,0.),1.)
call SetUnitTimeScale(NLLastDummy,.4)
call BvOKindSpellDamage(nellHero,targetUnit,LoadReal(NLHash,timerKey,5),true,PHYSICAL)
call NLStrikeDebuffs(nellHero,targetUnit,dashAngle)
call NLPush(targetUnit,500.,.5,dashAngle)
call RemoveSavedHandle(NLHash,timerKey,2)
call GroupRemoveUnit(LoadGroupHandle(NLHash,timerKey,1),targetUnit)
call SaveInteger(NLHash,timerKey,3,LoadInteger(NLHash,timerKey,3)-1)
if LoadInteger(NLHash,timerKey,3)<=0 then
call NLSwiftEnd(swiftTimer,nellHero)
endif
endif
endif
set swiftTimer=null
set nellHero=null
set targetUnit=null
endfunction
function NLSwiftFocus takes unit nellHero returns nothing
local integer swiftLevel=GetUnitAbilityLevel(nellHero,'NL04')
local real ringRadius=800.+100.*swiftLevel
local integer ringAlpha=0
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(nellHero)) then
set ringAlpha=255
endif
call NLRemoveLater(NLDummy(nellHero,'hN04',GetUnitX(nellHero),GetUnitY(nellHero),GetRandomReal(0.,359.),0.),1.6)
call SetUnitScale(NLLastDummy,ringRadius/107.,ringRadius/107.,ringRadius/107.)
call SetUnitTimeScale(NLLastDummy,.75)
call SetUnitVertexColor(NLLastDummy,190,80,255,ringAlpha)
call SaveUnitHandle(NLHash,GetHandleId(nellHero),40,NLLastDummy)
call NLPlay(3,nellHero)
endfunction
function NLSwiftStrikes takes unit nellHero returns nothing
local timer swiftTimer=CreateTimer()
local integer timerKey=GetHandleId(swiftTimer)
local integer swiftLevel=GetUnitAbilityLevel(nellHero,'NL04')
local unit swiftRing=LoadUnitHandle(NLHash,GetHandleId(nellHero),40)
if swiftRing!=null then
call SetUnitAnimation(swiftRing,"death")
call NLRemoveLater(swiftRing,.75)
call RemoveSavedHandle(NLHash,GetHandleId(nellHero),40)
endif
call SaveUnitHandle(NLHash,timerKey,0,nellHero)
call SaveGroupHandle(NLHash,timerKey,1,CreateGroup())
call SaveReal(NLHash,timerKey,6,GetUnitX(nellHero))
call SaveReal(NLHash,timerKey,7,GetUnitY(nellHero))
call SaveReal(NLHash,timerKey,8,800.+100.*swiftLevel)
if NLIsGamuza(nellHero) then
call SaveInteger(NLHash,timerKey,3,4+swiftLevel)
call SaveReal(NLHash,timerKey,5,100.+100.*swiftLevel+7.*GetHeroAgi(nellHero,false)+2.*GetHeroStr(nellHero,true))
else
call SaveInteger(NLHash,timerKey,3,2+swiftLevel)
call SaveReal(NLHash,timerKey,5,50.+50.*swiftLevel+4.*GetHeroAgi(nellHero,false)+GetHeroStr(nellHero,true))
endif
call SetUnitVertexColor(nellHero,25,25,25,255)
call TimerStart(swiftTimer,.02,true,function NLSwiftTick)
set swiftTimer=null
set swiftRing=null
endfunction
// ------------------------------------------------------------------ T: Lanzador Verde
// BWOS 0.8d: the lance flies 175 per 0.03 s; every enemy within 475 is hit once (damage, stun, push in the direction
// of the throw); the push is half of BWOS: (3500 - flown) / 4 over 0.4 s
function NLLanzadorTick takes nothing returns nothing
local timer lanceTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(lanceTimer)
local unit nellHero=LoadUnitHandle(NLHash,timerKey,0)
local unit lanceUnit=LoadUnitHandle(NLHash,timerKey,1)
local real lanceAngle=LoadReal(NLHash,timerKey,3)
local real flown=LoadReal(NLHash,timerKey,4)
local real lanceRange=LoadReal(NLHash,timerKey,5)
local real lanceGrow=LoadReal(NLHash,timerKey,8)+.06
local group hitUnits=LoadGroupHandle(NLHash,timerKey,7)
local real lanceStep=RMinBJ(175.,lanceRange-flown)
local real lanceX=GetUnitX(lanceUnit)+lanceStep*Cos(lanceAngle)
local real lanceY=GetUnitY(lanceUnit)+lanceStep*Sin(lanceAngle)
local group nearbyUnits
local unit nearbyUnit
local real effectScale
if lanceStep<=0. or not NLInMap(lanceX,lanceY) then
call RemoveUnit(lanceUnit)
call RemoveUnit(LoadUnitHandle(NLHash,timerKey,2))
call DestroyGroup(hitUnits)
call NLStop(lanceTimer)
else
set flown=flown+lanceStep
call SaveReal(NLHash,timerKey,4,flown)
call SaveReal(NLHash,timerKey,8,lanceGrow)
call SetUnitX(lanceUnit,lanceX)
call SetUnitY(lanceUnit,lanceY)
call SetUnitX(LoadUnitHandle(NLHash,timerKey,2),lanceX)
call SetUnitY(LoadUnitHandle(NLHash,timerKey,2),lanceY)
call NLDummy(nellHero,'hN13',lanceX-150.*Cos(lanceAngle),lanceY-150.*Sin(lanceAngle),lanceAngle*bj_RADTODEG,.35)
call SetUnitVertexColor(NLLastDummy,255,255,255,45)
set effectScale=GetRandomReal(.5,.85)
call SetUnitScale(NLLastDummy,effectScale,effectScale,effectScale)
call SetUnitTimeScale(NLLastDummy,GetRandomReal(1.1,1.65))
call NLDummy(nellHero,'hN14',lanceX,lanceY,lanceAngle*bj_RADTODEG,.45)
set effectScale=GetRandomReal(.3,.45)+lanceGrow
call SetUnitScale(NLLastDummy,effectScale,effectScale,effectScale)
call SetUnitVertexColor(NLLastDummy,125,0,255,100)
call SetUnitTimeScale(NLLastDummy,GetRandomReal(.85,1.05))
call NLDummy(nellHero,'hN15',lanceX+150.*Cos(lanceAngle),lanceY+150.*Sin(lanceAngle),lanceAngle*bj_RADTODEG,.5)
call SetUnitVertexColor(NLLastDummy,255,255,255,45)
set effectScale=GetRandomReal(.5,.85)
call SetUnitScale(NLLastDummy,effectScale,effectScale,effectScale)
call SetUnitTimeScale(NLLastDummy,GetRandomReal(1.,1.65))
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,lanceX,lanceY,300.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(nellHero,nearbyUnit) and GetUnitAbilityLevel(nearbyUnit,'Avul')==0 and not IsUnitInGroup(nearbyUnit,hitUnits) then
call GroupAddUnit(hitUnits,nearbyUnit)
call NLDamage(nellHero,nearbyUnit,LoadReal(NLHash,timerKey,6))
call AYStun(nellHero,nearbyUnit,2.)
call NLPush(nearbyUnit,(3500.-flown)/4.,.4,lanceAngle)
endif
endloop
call DestroyGroup(nearbyUnits)
endif
set lanceTimer=null
set nellHero=null
set lanceUnit=null
set hitUnits=null
set nearbyUnits=null
endfunction
function NLLanzadorWindup takes unit nellHero,real targetX,real targetY returns nothing
local integer dustIndex=0
call SetUnitFacing(nellHero,Atan2(targetY-GetUnitY(nellHero),targetX-GetUnitX(nellHero))*bj_RADTODEG)
// BWOS Lanzador Verde: index 5 (Gamuza: Attack) at 0.85 speed until the throw
call SetUnitAnimationByIndex(nellHero,5)
call SetUnitTimeScale(nellHero,.85)
call NLPlay(5,nellHero)
loop
exitwhen dustIndex>2
call NLDummy(nellHero,'hN16',GetUnitX(nellHero),GetUnitY(nellHero),GetRandomReal(0.,359.),1.4)
call SetUnitScale(NLLastDummy,1.5+.5*dustIndex,1.5+.5*dustIndex,1.5+.5*dustIndex)
call SetUnitVertexColor(NLLastDummy,255,255,255,125)
call SetUnitTimeScale(NLLastDummy,1.1-.1*dustIndex)
set dustIndex=dustIndex+1
endloop
endfunction
function NLLanzador takes unit nellHero,real targetX,real targetY returns nothing
local timer lanceTimer=CreateTimer()
local integer timerKey=GetHandleId(lanceTimer)
local integer lanceLevel=GetUnitAbilityLevel(nellHero,'NL05')
local real lanceAngle=Atan2(targetY-GetUnitY(nellHero),targetX-GetUnitX(nellHero))
call SetUnitTimeScale(nellHero,1.)
call QueueUnitAnimation(nellHero,"stand")
call NLPlay(6,nellHero)
call SaveUnitHandle(NLHash,timerKey,0,nellHero)
call SaveUnitHandle(NLHash,timerKey,1,NLDummy(nellHero,'hN11',GetUnitX(nellHero),GetUnitY(nellHero),lanceAngle*bj_RADTODEG,0.))
call SaveUnitHandle(NLHash,timerKey,2,NLDummy(nellHero,'hN12',GetUnitX(nellHero),GetUnitY(nellHero),lanceAngle*bj_RADTODEG,0.))
call SaveReal(NLHash,timerKey,3,lanceAngle)
call SaveReal(NLHash,timerKey,4,0.)
call SaveReal(NLHash,timerKey,5,1000.+200.*lanceLevel)
call SaveReal(NLHash,timerKey,6,500.+200.*lanceLevel+7.*GetHeroAgi(nellHero,false)+2.*GetHeroStr(nellHero,true)+2.*GetHeroInt(nellHero,true))
call SaveGroupHandle(NLHash,timerKey,7,CreateGroup())
call SaveReal(NLHash,timerKey,8,.05)
call TimerStart(lanceTimer,.03,true,function NLLanzadorTick)
set lanceTimer=null
endfunction
function NLLanzadorStep takes nothing returns nothing
local timer windupTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(windupTimer)
local unit nellHero=LoadUnitHandle(NLHash,timerKey,0)
if LoadInteger(NLHash,timerKey,3)==0 then
call SaveInteger(NLHash,timerKey,3,1)
call NLLanzadorWindup(nellHero,LoadReal(NLHash,timerKey,1),LoadReal(NLHash,timerKey,2))
call PauseUnit(nellHero,true)
call TimerStart(windupTimer,.5,false,function NLLanzadorStep)
else
call PauseUnit(nellHero,false)
if GetWidgetLife(nellHero)>.405 then
call NLLanzador(nellHero,LoadReal(NLHash,timerKey,1),LoadReal(NLHash,timerKey,2))
endif
call NLStop(windupTimer)
endif
set windupTimer=null
set nellHero=null
endfunction
function NLLanzadorStart takes unit nellHero,real targetX,real targetY returns nothing
local timer windupTimer=CreateTimer()
call SaveUnitHandle(NLHash,GetHandleId(windupTimer),0,nellHero)
call SaveReal(NLHash,GetHandleId(windupTimer),1,targetX)
call SaveReal(NLHash,GetHandleId(windupTimer),2,targetY)
call SaveInteger(NLHash,GetHandleId(windupTimer),3,0)
call TimerStart(windupTimer,0.,false,function NLLanzadorStep)
set windupTimer=null
endfunction
// ------------------------------------------------------------------ V: Sonido
// a blink of up to 800 (like Yoruichi's); on an allied unit within 800 it brings that unit to Nell. Nell's own move
// is done right after the cast event (moving the caster inside the event cancelled the cooldown and the mana cost)
// how far Sonido can go along a line: it stops before unwalkable ground (walls, cliffs, the black area outside the
// arenas) and the edge of the map, so it cannot pass through walls
function NLSonidoReach takes real fromX,real fromY,real sonidoAngle,real sonidoDistance returns real
local real checked=16.
local real reached=0.
loop
exitwhen checked>sonidoDistance
if not NLInMap(fromX+checked*Cos(sonidoAngle),fromY+checked*Sin(sonidoAngle)) or IsTerrainPathable(fromX+checked*Cos(sonidoAngle),fromY+checked*Sin(sonidoAngle),PATHING_TYPE_WALKABILITY) then
return reached
endif
set reached=checked
set checked=checked+16.
endloop
if NLInMap(fromX+sonidoDistance*Cos(sonidoAngle),fromY+sonidoDistance*Sin(sonidoAngle)) and not IsTerrainPathable(fromX+sonidoDistance*Cos(sonidoAngle),fromY+sonidoDistance*Sin(sonidoAngle),PATHING_TYPE_WALKABILITY) then
return sonidoDistance
endif
return reached
endfunction
function NLSonidoRefundEnd takes nothing returns nothing
local timer refundTimer=GetExpiredTimer()
local unit nellHero=LoadUnitHandle(NLHash,GetHandleId(refundTimer),0)
if nellHero!=null and GetUnitTypeId(nellHero)!=0 then
call SetUnitState(nellHero,UNIT_STATE_MANA,GetUnitState(nellHero,UNIT_STATE_MANA)+60.)
endif
call NLStop(refundTimer)
set refundTimer=null
set nellHero=null
endfunction
function NLSonidoRefund takes unit nellHero returns nothing
local timer refundTimer=CreateTimer()
call SaveUnitHandle(NLHash,GetHandleId(refundTimer),0,nellHero)
call TimerStart(refundTimer,0.,false,function NLSonidoRefundEnd)
set refundTimer=null
endfunction
function NLSonidoMove takes nothing returns nothing
local timer sonidoTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(sonidoTimer)
local unit nellHero=LoadUnitHandle(NLHash,timerKey,0)
local real nellX=GetUnitX(nellHero)
local real nellY=GetUnitY(nellHero)
local real landX=LoadReal(NLHash,timerKey,1)
local real landY=LoadReal(NLHash,timerKey,2)
local real sonidoAngle=Atan2(landY-nellY,landX-nellX)
if nellHero!=null and NLIsNell(nellHero) and GetWidgetLife(nellHero)>.405 and HaveSavedReal(NLHash,timerKey,1) and HaveSavedReal(NLHash,timerKey,2) and LoadInteger(NLHash,timerKey,3)==LoadInteger(NLHash,GetHandleId(nellHero),54) and NLInMap(landX,landY) and FSPointWalkable(landX,landY) and (landX-nellX)*(landX-nellX)+(landY-nellY)*(landY-nellY)<=640001. then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",nellX,nellY))
call NLRemoveLater(NLDummy(nellHero,'hN05',nellX,nellY,sonidoAngle*bj_RADTODEG+90.,0.),.3)
call SetUnitTimeScale(NLLastDummy,1.25)
call SetUnitVertexColor(NLLastDummy,0,0,0,105)
// the spot was checked: walkable and reachable on foot
call SetUnitPosition(nellHero,landX,landY)
call SetUnitFacing(nellHero,sonidoAngle*bj_RADTODEG)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",GetUnitX(nellHero),GetUnitY(nellHero)))
else
// The native spell has paid, but no movement was possible.
call NLSonidoRefund(nellHero)
endif
call NLStop(sonidoTimer)
set sonidoTimer=null
set nellHero=null
endfunction
// a point target (or a non-allied unit) in the black mask, or a landing spot in it
function NLSonidoMasked takes unit nellHero,unit targetUnit,real targetX,real targetY returns boolean
local real nellX=GetUnitX(nellHero)
local real nellY=GetUnitY(nellHero)
local real sonidoAngle
local real sonidoDistance
if targetUnit!=null then
if targetUnit!=nellHero and IsUnitAlly(targetUnit,GetOwningPlayer(nellHero)) then
return false
endif
set targetX=GetUnitX(targetUnit)
set targetY=GetUnitY(targetUnit)
endif
set sonidoAngle=Atan2(targetY-nellY,targetX-nellX)
set sonidoDistance=RMaxBJ(200.,RMinBJ(800.,SquareRoot((targetX-nellX)*(targetX-nellX)+(targetY-nellY)*(targetY-nellY))))
return IsMaskedToPlayer(targetX,targetY,GetOwningPlayer(nellHero)) or IsMaskedToPlayer(nellX+sonidoDistance*Cos(sonidoAngle),nellY+sonidoDistance*Sin(sonidoAngle),GetOwningPlayer(nellHero))
endfunction
// ------------------------------------------------------------------ V: can the landing spot be reached on foot?
// A search over the walkable ground (32 x 32 cells, like the pathing map) from Nell to the landing spot inside the
// box of both points + 700. Spots that cannot be walked to (pockets behind walls around the bases, the bosses or
// the duel) are refused, like the blink of the other heroes. The search runs in batches of new threads (ExecuteFunc)
// so it never hits the operation limit; state in NLHash: -77 state, -78 queue, -79 visited cells.
function NLReachCell takes integer cellI,integer cellJ returns nothing
local integer cellKey=(cellI+2048)*4096+cellJ+2048
local real cellX
local real cellY
if cellI<LoadInteger(NLHash,-77,4) or cellI>LoadInteger(NLHash,-77,5) or cellJ<LoadInteger(NLHash,-77,6) or cellJ>LoadInteger(NLHash,-77,7) then
return
endif
if HaveSavedBoolean(NLHash,-79,cellKey) then
return
endif
call SaveBoolean(NLHash,-79,cellKey,true)
// the landing spot itself is walkable (checked exactly), its cell counts as reached
if cellI==LoadInteger(NLHash,-77,2) and cellJ==LoadInteger(NLHash,-77,3) then
call SaveBoolean(NLHash,-77,8,true)
return
endif
set cellX=LoadReal(NLHash,-77,9)+32.*cellI
set cellY=LoadReal(NLHash,-77,10)+32.*cellJ
if not NLInMap(cellX,cellY) or IsTerrainPathable(cellX,cellY,PATHING_TYPE_WALKABILITY) then
return
endif
call SaveInteger(NLHash,-78,LoadInteger(NLHash,-77,1),cellKey)
call SaveInteger(NLHash,-77,1,LoadInteger(NLHash,-77,1)+1)
endfunction
function NLReachBatch takes nothing returns nothing
local integer head=LoadInteger(NLHash,-77,0)
local integer batchEnd=head+250
local integer cellKey
local integer cellI
local integer cellJ
loop
exitwhen head>=batchEnd or head>=LoadInteger(NLHash,-77,1) or LoadBoolean(NLHash,-77,8)
set cellKey=LoadInteger(NLHash,-78,head)
set cellI=cellKey/4096-2048
set cellJ=ModuloInteger(cellKey,4096)-2048
call NLReachCell(cellI+1,cellJ)
call NLReachCell(cellI-1,cellJ)
call NLReachCell(cellI,cellJ+1)
call NLReachCell(cellI,cellJ-1)
set head=head+1
endloop
call SaveInteger(NLHash,-77,0,head)
endfunction
function NLReachable takes real fromX,real fromY,real toX,real toY returns boolean
local integer targetI=R2I(RAbsBJ(toX-fromX)/32.+.5)
local integer targetJ=R2I(RAbsBJ(toY-fromY)/32.+.5)
local integer startKey=2048*4096+2048
local boolean found
if toX<fromX then
set targetI=-targetI
endif
if toY<fromY then
set targetJ=-targetJ
endif
if targetI*targetI+targetJ*targetJ<=2 then
return true
endif
call FlushChildHashtable(NLHash,-77)
call FlushChildHashtable(NLHash,-78)
call FlushChildHashtable(NLHash,-79)
call SaveReal(NLHash,-77,9,fromX)
call SaveReal(NLHash,-77,10,fromY)
call SaveInteger(NLHash,-77,2,targetI)
call SaveInteger(NLHash,-77,3,targetJ)
call SaveInteger(NLHash,-77,4,IMinBJ(0,targetI)-22)
call SaveInteger(NLHash,-77,5,IMaxBJ(0,targetI)+22)
call SaveInteger(NLHash,-77,6,IMinBJ(0,targetJ)-22)
call SaveInteger(NLHash,-77,7,IMaxBJ(0,targetJ)+22)
// Nell's own cell is the start even if it lies on the edge of the pathing
call SaveBoolean(NLHash,-79,startKey,true)
call SaveInteger(NLHash,-78,0,startKey)
call SaveInteger(NLHash,-77,0,0)
call SaveInteger(NLHash,-77,1,1)
call SaveBoolean(NLHash,-77,8,false)
loop
exitwhen LoadBoolean(NLHash,-77,8) or LoadInteger(NLHash,-77,0)>=LoadInteger(NLHash,-77,1)
call ExecuteFunc("NLReachBatch")
endloop
set found=LoadBoolean(NLHash,-77,8)
call FlushChildHashtable(NLHash,-77)
call FlushChildHashtable(NLHash,-78)
call FlushChildHashtable(NLHash,-79)
return found
endfunction
// the landing spot of Sonido (hero keys 50 / 51): at most 800, at least 200 from Nell; on unwalkable ground the
// nearest walkable spot on the way back to Nell; false if it cannot be reached on foot
function NLSonidoPlan takes unit nellHero,real targetX,real targetY returns boolean
local real nellX=GetUnitX(nellHero)
local real nellY=GetUnitY(nellHero)
local real sonidoAngle=Atan2(targetY-nellY,targetX-nellX)
local real sonidoDistance=RMaxBJ(200.,RMinBJ(800.,SquareRoot((targetX-nellX)*(targetX-nellX)+(targetY-nellY)*(targetY-nellY))))
local real landX
local real landY
// A failed or interrupted cast must never leave an executable landing plan.
call SaveBoolean(NLHash,GetHandleId(nellHero),53,false)
call RemoveSavedReal(NLHash,GetHandleId(nellHero),50)
call RemoveSavedReal(NLHash,GetHandleId(nellHero),51)
loop
set landX=nellX+sonidoDistance*Cos(sonidoAngle)
set landY=nellY+sonidoDistance*Sin(sonidoAngle)
exitwhen sonidoDistance<=0. or (NLInMap(landX,landY) and FSPointWalkable(landX,landY))
set sonidoDistance=sonidoDistance-16.
endloop
if sonidoDistance<=0. or not NLInMap(landX,landY) or not FSPointWalkable(landX,landY) then
return false
endif
if not NLReachable(nellX,nellY,landX,landY) then
return false
endif
call SaveReal(NLHash,GetHandleId(nellHero),50,landX)
call SaveReal(NLHash,GetHandleId(nellHero),51,landY)
call SaveBoolean(NLHash,GetHandleId(nellHero),53,true)
return true
endfunction
// Sonido on an allied unit within 800 brings it to Nell
function NLSonidoAllyTarget takes unit nellHero,unit targetUnit returns boolean
local real offsetX
local real offsetY
if targetUnit==null or targetUnit==nellHero or not IsUnitAlly(targetUnit,GetOwningPlayer(nellHero)) or GetWidgetLife(targetUnit)<=.405 or IsUnitType(targetUnit,UNIT_TYPE_STRUCTURE) or GetUnitAbilityLevel(targetUnit,'Aloc')>0 then
return false
endif
set offsetX=GetUnitX(targetUnit)-GetUnitX(nellHero)
set offsetY=GetUnitY(targetUnit)-GetUnitY(nellHero)
return offsetX*offsetX+offsetY*offsetY<=640000.
endfunction
function NLSonidoPlanTarget takes unit nellHero,unit targetUnit,real targetX,real targetY returns boolean
if targetUnit!=null then
return NLSonidoPlan(nellHero,GetUnitX(targetUnit),GetUnitY(targetUnit))
endif
return NLSonidoPlan(nellHero,targetX,targetY)
endfunction
function NLSonidoSelectCooldown takes unit nellHero,unit targetUnit returns nothing
if NLSonidoAllyTarget(nellHero,targetUnit) then
call SetUnitAbilityLevel(nellHero,'NL06',2)
else
call SetUnitAbilityLevel(nellHero,'NL06',1)
endif
endfunction
function NLOnChannel takes nothing returns boolean
if GetSpellAbilityId()=='NL06' and NLIsNell(GetTriggerUnit()) then
call NLSonidoSelectCooldown(GetTriggerUnit(),GetSpellTargetUnit())
endif
return false
endfunction
function NLSonido takes unit nellHero,unit targetUnit,real targetX,real targetY returns nothing
local real nellX=GetUnitX(nellHero)
local real nellY=GetUnitY(nellHero)
local real sonidoAngle
local real sonidoDistance
local timer sonidoTimer
if targetUnit!=null then
set targetX=GetUnitX(targetUnit)
set targetY=GetUnitY(targetUnit)
endif
set sonidoDistance=SquareRoot((targetX-nellX)*(targetX-nellX)+(targetY-nellY)*(targetY-nellY))
if NLSonidoAllyTarget(nellHero,targetUnit) then
set sonidoAngle=GetUnitFacing(nellHero)*bj_DEGTORAD
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",targetX,targetY))
call SetUnitPosition(targetUnit,nellX+NLSonidoReach(nellX,nellY,sonidoAngle,100.)*Cos(sonidoAngle),nellY+NLSonidoReach(nellX,nellY,sonidoAngle,100.)*Sin(sonidoAngle))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",GetUnitX(targetUnit),GetUnitY(targetUnit)))
else
// the landing spot was planned when the cast started (NLSonidoPlan); Nell moves when the cast has ended, so the
// mana cost and the cooldown are always taken
if LoadBoolean(NLHash,GetHandleId(nellHero),53) and HaveSavedReal(NLHash,GetHandleId(nellHero),50) and HaveSavedReal(NLHash,GetHandleId(nellHero),51) then
call SaveBoolean(NLHash,GetHandleId(nellHero),52,true)
call SaveBoolean(NLHash,GetHandleId(nellHero),55,true)
else
call NLSonidoRefund(nellHero)
endif
endif
endfunction
// ------------------------------------------------------------------ dispatch
function NLOnSpell takes nothing returns boolean
local unit nellHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
local real bonusDamage
if NLIsNell(nellHero) and SilenceConditions(nellHero) then
if (spellId=='NL01' or spellId=='NL11') and NLIsGamuza(nellHero) then
// Gamuza: Cero costs 100 more mana (checked when the cast starts)
call SetUnitState(nellHero,UNIT_STATE_MANA,RMaxBJ(0.,GetUnitState(nellHero,UNIT_STATE_MANA)-100.))
endif
if spellId=='NL01' then
call NLCero(nellHero,GetSpellTargetX(),GetSpellTargetY(),0.,false)
elseif spellId=='NL11' then
set bonusDamage=LoadReal(NLHash,GetHandleId(nellHero),20)
call SaveReal(NLHash,GetHandleId(nellHero),20,0.)
call NLCero(nellHero,GetSpellTargetX(),GetSpellTargetY(),bonusDamage,true)
// Cero Double stays on the button while it cools down
call NLCeroDoubleTimer(nellHero,20.-GetUnitAbilityLevel(nellHero,'NL11'))
elseif spellId=='NL02' then
call NLEnergyAbsorption(nellHero)
elseif spellId=='NL03' and GetUnitTypeId(nellHero)=='HN00' then
call NLGamuza(nellHero)
elseif spellId=='NL04' then
call NLSwiftStrikes(nellHero)
elseif spellId=='NL15' then
if GetSpellTargetUnit()!=null then
call NLLanzadorStart(nellHero,GetUnitX(GetSpellTargetUnit()),GetUnitY(GetSpellTargetUnit()))
else
call NLLanzadorStart(nellHero,GetSpellTargetX(),GetSpellTargetY())
endif
elseif spellId=='NL06' then
call NLSonido(nellHero,GetSpellTargetUnit(),GetSpellTargetX(),GetSpellTargetY())
endif
endif
set nellHero=null
return false
endfunction
// the start of a cast: the mana of Cero in Gamuza, the focus of Swift Strikes and the windup of Lanzador Verde
function NLOnCast takes nothing returns boolean
local unit nellHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
if NLIsNell(nellHero) then
if spellId=='NL06' then
call NLSonidoSelectCooldown(nellHero,GetSpellTargetUnit())
if LoadBoolean(NLHash,GetHandleId(nellHero),55) then
call SaveBoolean(NLHash,GetHandleId(nellHero),55,false)
call NLSonidoRefund(nellHero)
endif
// Invalidate previous casts before any rejection can issue a nested stop event.
call SaveInteger(NLHash,GetHandleId(nellHero),54,LoadInteger(NLHash,GetHandleId(nellHero),54)+1)
call SaveBoolean(NLHash,GetHandleId(nellHero),52,false)
call SaveBoolean(NLHash,GetHandleId(nellHero),53,false)
call RemoveSavedReal(NLHash,GetHandleId(nellHero),50)
call RemoveSavedReal(NLHash,GetHandleId(nellHero),51)
endif
if (spellId=='NL01' or spellId=='NL11') and NLIsGamuza(nellHero) and GetUnitState(nellHero,UNIT_STATE_MANA)<NLCeroMana(GetUnitAbilityLevel(nellHero,'NL01'))+100. then
call IssueImmediateOrder(nellHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(nellHero) then
call ClearTextMessages()
call DisplayTimedTextToPlayer(GetLocalPlayer(),.52,.96,2.,"|cffffcc00Not enough mana (Cero costs 100 more in Resurreccion - Gamuza).|r")
endif
elseif spellId=='NL06' and NLSonidoMasked(nellHero,GetSpellTargetUnit(),GetSpellTargetX(),GetSpellTargetY()) then
// like the blink of Yoruichi: no Sonido into the black mask
call IssueImmediateOrder(nellHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(nellHero) then
call ClearTextMessages()
call DisplayTimedTextToPlayer(GetLocalPlayer(),.52,.96,2.,"|cffffcc00You must explore the location first.|r")
endif
elseif spellId=='NL06' and not NLSonidoAllyTarget(nellHero,GetSpellTargetUnit()) and not NLSonidoPlanTarget(nellHero,GetSpellTargetUnit(),GetSpellTargetX(),GetSpellTargetY()) then
// a spot that cannot be walked to (behind the walls of a base, a boss or the duel)
call IssueImmediateOrder(nellHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(nellHero) then
call ClearTextMessages()
call DisplayTimedTextToPlayer(GetLocalPlayer(),.52,.96,2.,"|cffffcc00Unable to target there.|r")
endif
elseif spellId=='NL04' then
call NLSwiftFocus(nellHero)
endif
endif
set nellHero=null
return false
endfunction
function NLOnEndCast takes nothing returns boolean
local timer sonidoTimer
if GetSpellAbilityId()=='NL15' and NLIsNell(GetTriggerUnit()) then
call SetUnitTimeScale(GetTriggerUnit(),1.)
endif
if GetSpellAbilityId()=='NL06' and LoadBoolean(NLHash,GetHandleId(GetTriggerUnit()),52) and LoadBoolean(NLHash,GetHandleId(GetTriggerUnit()),53) and HaveSavedReal(NLHash,GetHandleId(GetTriggerUnit()),50) and HaveSavedReal(NLHash,GetHandleId(GetTriggerUnit()),51) then
call SaveBoolean(NLHash,GetHandleId(GetTriggerUnit()),52,false)
call SaveBoolean(NLHash,GetHandleId(GetTriggerUnit()),55,false)
set sonidoTimer=CreateTimer()
call SaveUnitHandle(NLHash,GetHandleId(sonidoTimer),0,GetTriggerUnit())
// The timer owns its coordinates; another cast cannot replace its destination.
call SaveReal(NLHash,GetHandleId(sonidoTimer),1,LoadReal(NLHash,GetHandleId(GetTriggerUnit()),50))
call SaveReal(NLHash,GetHandleId(sonidoTimer),2,LoadReal(NLHash,GetHandleId(GetTriggerUnit()),51))
call SaveInteger(NLHash,GetHandleId(sonidoTimer),3,LoadInteger(NLHash,GetHandleId(GetTriggerUnit()),54))
call SaveBoolean(NLHash,GetHandleId(GetTriggerUnit()),53,false)
call RemoveSavedReal(NLHash,GetHandleId(GetTriggerUnit()),50)
call RemoveSavedReal(NLHash,GetHandleId(GetTriggerUnit()),51)
call TimerStart(sonidoTimer,0.,false,function NLSonidoMove)
set sonidoTimer=null
elseif GetSpellAbilityId()=='NL06' and LoadBoolean(NLHash,GetHandleId(GetTriggerUnit()),55) then
call SaveBoolean(NLHash,GetHandleId(GetTriggerUnit()),55,false)
call SaveBoolean(NLHash,GetHandleId(GetTriggerUnit()),52,false)
call NLSonidoRefund(GetTriggerUnit())
endif
return false
endfunction
function NLOnLearn takes nothing returns boolean
if GetLearnedSkill()=='NL05' then
if GetUnitAbilityLevel(GetTriggerUnit(),'NL15')==0 then
call UnitAddAbility(GetTriggerUnit(),'NL15')
call UnitMakeAbilityPermanent(GetTriggerUnit(),true,'NL15')
endif
call SetUnitAbilityLevel(GetTriggerUnit(),'NL15',GetUnitAbilityLevel(GetTriggerUnit(),'NL05'))
call NLLanzadorSync(GetTriggerUnit())
endif
if GetLearnedSkill()=='NL01' and GetUnitAbilityLevel(GetTriggerUnit(),'NL11')>0 then
call SetUnitAbilityLevel(GetTriggerUnit(),'NL11',GetUnitAbilityLevel(GetTriggerUnit(),'NL01'))
endif
return false
endfunction
function NLMakeSound takes string soundPath,integer soundDuration returns sound
local sound nellSound=CreateSound(soundPath,false,true,true,10,10,"DefaultEAXON")
call SetSoundDuration(nellSound,soundDuration)
call SetSoundVolume(nellSound,127)
call SetSoundDistances(nellSound,600.,10000.)
call Preload(soundPath)
return nellSound
endfunction
function NLAddStunBuff takes integer buffId returns nothing
set NLStunBuff[NLStunBuffCount]=buffId
set NLStunBuffCount=NLStunBuffCount+1
endfunction
// ================================================================ Soul-devourer Stones: levels 1-5 and Soul Wrath
// Soul Wrath (A08N, ASW2-ASW5 for the levels 2-5): the native chain lightning hits only the primary target for 0.01
// damage; once that hit lands (a spell shield blocks it, then nothing happens), the script deals 400 + level x total
// INT magic damage to it and bounces up to 11 more times with the same damage (no growth per jump).
function SDDamageOf takes unit sdCaster,integer sdLevelValue returns real
return 400.+sdLevelValue*GetHeroInt(sdCaster,true)
endfunction
function SDZ takes real sdX,real sdY,unit sdUnit returns real
call MoveLocation(SDLoc,sdX,sdY)
return GetLocationZ(SDLoc)+GetUnitFlyHeight(sdUnit)+60.
endfunction
function SDLightningEnd takes nothing returns nothing
local timer sdTimer=GetExpiredTimer()
call DestroyLightning(LoadLightningHandle(SDHash,GetHandleId(sdTimer),0))
call FlushChildHashtable(SDHash,GetHandleId(sdTimer))
call DestroyTimer(sdTimer)
set sdTimer=null
endfunction
function SDCanBounce takes unit sdCaster,unit sdUnit,group sdHit returns boolean
return sdUnit!=null and GetWidgetLife(sdUnit)>.405 and IsUnitEnemy(sdUnit,GetOwningPlayer(sdCaster)) and not IsUnitInGroup(sdUnit,sdHit) and not IsUnitType(sdUnit,UNIT_TYPE_STRUCTURE) and not IsUnitType(sdUnit,UNIT_TYPE_MAGIC_IMMUNE) and not IsUnitType(sdUnit,UNIT_TYPE_MECHANICAL) and not IsUnitType(sdUnit,UNIT_TYPE_ANCIENT) and GetUnitAbilityLevel(sdUnit,'Aloc')==0 and GetUnitAbilityLevel(sdUnit,'Avul')==0 and IsUnitVisible(sdUnit,GetOwningPlayer(sdCaster))
endfunction
function SDChainStep takes nothing returns nothing
local timer sdTimer=GetExpiredTimer()
local integer sdKey=GetHandleId(sdTimer)
local unit sdCaster=LoadUnitHandle(SDHash,sdKey,0)
local unit sdCurrent=LoadUnitHandle(SDHash,sdKey,1)
local integer sdHits=LoadInteger(SDHash,sdKey,3)
local group sdHit=LoadGroupHandle(SDHash,sdKey,4)
local real sdCurX=0.
local real sdCurY=0.
local real sdPrevX
local real sdPrevY
local real sdDist
local real sdBest=99999999.
local unit sdUnit
local unit sdNext=null
local timer sdLightTimer
if sdCurrent!=null and GetWidgetLife(sdCurrent)>.405 and sdCaster!=null then
set sdCurX=GetUnitX(sdCurrent)
set sdCurY=GetUnitY(sdCurrent)
if sdHits>0 then
set sdPrevX=LoadReal(SDHash,sdKey,6)
set sdPrevY=LoadReal(SDHash,sdKey,7)
set sdLightTimer=CreateTimer()
call SaveLightningHandle(SDHash,GetHandleId(sdLightTimer),0,AddLightningEx("AFOD",true,sdPrevX,sdPrevY,LoadReal(SDHash,sdKey,8),sdCurX,sdCurY,SDZ(sdCurX,sdCurY,sdCurrent)))
call TimerStart(sdLightTimer,.35,false,function SDLightningEnd)
set sdLightTimer=null
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",sdCurrent,"chest"))
endif
call GroupAddUnit(sdHit,sdCurrent)
call DamageUnit(sdCaster,sdCurrent,LoadReal(SDHash,sdKey,5),MAGICAL,SPELL)
set sdHits=sdHits+1
if sdHits<12 then
call GroupEnumUnitsInRange(SDEnum,sdCurX,sdCurY,4000.,null)
loop
set sdUnit=FirstOfGroup(SDEnum)
exitwhen sdUnit==null
call GroupRemoveUnit(SDEnum,sdUnit)
if SDCanBounce(sdCaster,sdUnit,sdHit) then
set sdDist=(GetUnitX(sdUnit)-sdCurX)*(GetUnitX(sdUnit)-sdCurX)+(GetUnitY(sdUnit)-sdCurY)*(GetUnitY(sdUnit)-sdCurY)
if sdDist<sdBest then
set sdBest=sdDist
set sdNext=sdUnit
endif
endif
endloop
endif
endif
if sdNext!=null then
call SaveUnitHandle(SDHash,sdKey,1,sdNext)
call SaveInteger(SDHash,sdKey,3,sdHits)
call SaveReal(SDHash,sdKey,6,sdCurX)
call SaveReal(SDHash,sdKey,7,sdCurY)
call SaveReal(SDHash,sdKey,8,SDZ(sdCurX,sdCurY,sdCurrent))
call TimerStart(sdTimer,.2,false,function SDChainStep)
else
call DestroyGroup(sdHit)
call FlushChildHashtable(SDHash,sdKey)
call DestroyTimer(sdTimer)
endif
set sdTimer=null
set sdCaster=null
set sdCurrent=null
set sdHit=null
set sdUnit=null
set sdNext=null
endfunction
function SDChainStart takes unit sdCaster,unit sdTarget,integer sdLevelValue returns nothing
local timer sdTimer=CreateTimer()
local integer sdKey=GetHandleId(sdTimer)
call SaveUnitHandle(SDHash,sdKey,0,sdCaster)
call SaveUnitHandle(SDHash,sdKey,1,sdTarget)
call SaveInteger(SDHash,sdKey,3,0)
call SaveGroupHandle(SDHash,sdKey,4,CreateGroup())
call SaveReal(SDHash,sdKey,5,SDDamageOf(sdCaster,sdLevelValue))
call TimerStart(sdTimer,0.,false,function SDChainStep)
set sdTimer=null
endfunction
// the cast and the hit of the native chain lightning can come in any order: whichever comes second starts the chain
function SDOnCast takes nothing returns boolean
local integer sdLevelValue=SDAbilLevel(GetSpellAbilityId())
local unit sdCaster
local unit sdTarget
local integer sdHandle
if sdLevelValue>0 then
set sdCaster=GetTriggerUnit()
set sdTarget=GetSpellTargetUnit()
set sdHandle=GetHandleId(sdCaster)
if LoadUnitHandle(SDHash,sdHandle,11)==sdTarget and TimerGetElapsed(AYClock)-LoadReal(SDHash,sdHandle,12)<.1 then
call RemoveSavedHandle(SDHash,sdHandle,11)
call SDChainStart(sdCaster,sdTarget,sdLevelValue)
else
call SaveUnitHandle(SDHash,sdHandle,1,sdTarget)
call SaveInteger(SDHash,sdHandle,2,sdLevelValue)
call SaveReal(SDHash,sdHandle,3,TimerGetElapsed(AYClock))
endif
set sdCaster=null
set sdTarget=null
endif
return false
endfunction
function SDDamageHook takes nothing returns nothing
local integer sdHandle
if Source==null or Target==null or Damage>=.02 or not SDHasStone(Source) then
return
endif
set sdHandle=GetHandleId(Source)
if HaveSavedHandle(SDHash,sdHandle,1) and LoadUnitHandle(SDHash,sdHandle,1)==Target and TimerGetElapsed(AYClock)-LoadReal(SDHash,sdHandle,3)<1. then
call RemoveSavedHandle(SDHash,sdHandle,1)
call SDChainStart(Source,Target,LoadInteger(SDHash,sdHandle,2))
else
call SaveUnitHandle(SDHash,sdHandle,11,Target)
call SaveReal(SDHash,sdHandle,12,TimerGetElapsed(AYClock))
endif
endfunction
// a recipe picked up while the hero carries Soul-devourer Stones below level 5 (and not the two components) upgrades them
function SDOnPickup takes nothing returns boolean
local unit sdUnit=GetManipulatingUnit()
local item sdItem=GetManipulatedItem()
if GetItemTypeId(sdItem)=='I025' and IsUnitType(sdUnit,UNIT_TYPE_HERO) and UnitHasItem(sdUnit,sdItem) and not (UnitHasItemOfTypeBJ(sdUnit,'I00Z') and UnitHasItemOfTypeBJ(sdUnit,'I016')) and SDUpgradeSlot(sdUnit)>=0 then
call SDQueueUpgrade(sdUnit,sdItem)
endif
set sdUnit=null
set sdItem=null
return false
endfunction
function SDInit takes nothing returns nothing
local trigger sdTrig=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(sdTrig,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(sdTrig,Condition(function SDOnCast))
set sdTrig=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(sdTrig,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(sdTrig,Condition(function SDOnPickup))
set sdTrig=null
endfunction
function EnelOnDeath takes nothing returns boolean
local unit enelHero=GetTriggerUnit()
if GetUnitAbilityLevel(enelHero,'A02U')>0 and LoadReal(RBState,GetHandleId(enelHero),140)>0. then
call SaveReal(RBState,GetHandleId(enelHero),140,0.)
if Dj==enelHero then
call EnableWeatherEffect(Q[2],false)
call RemoveWeatherEffect(Q[2])
set Dj=null
endif
endif
set enelHero=null
return false
endfunction
function EnelInit takes nothing returns nothing
local trigger deathTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(deathTrigger,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(deathTrigger,Condition(function EnelOnDeath))
set deathTrigger=null
endfunction
function SquallROnDeath takes nothing returns boolean
if fj and ej!=null and GetTriggerUnit()==ej then
set fj=false
call DisableTrigger(pc)
endif
return false
endfunction
function SquallRInit takes nothing returns nothing
local trigger deathTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(deathTrigger,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(deathTrigger,Condition(function SquallROnDeath))
set deathTrigger=null
endfunction
function NLInit takes nothing returns nothing
local trigger spellTrigger=CreateTrigger()
local trigger learnTrigger=CreateTrigger()
local trigger castTrigger=CreateTrigger()
local trigger endCastTrigger=CreateTrigger()
set NLHash=InitHashtable()
set NLVisualType[0]=0x6e513030
set NLVisualType[40]=0x6e513031
set NLVisualType[80]=0x6e513032
set NLVisualType[1]=0x6e513033
set NLVisualType[41]=0x6e513034
set NLVisualType[81]=0x6e513035
set NLVisualType[120]=0x6e513036
set NLVisualType[2]=0x6e513037
