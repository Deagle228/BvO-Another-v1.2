function ULQ_UlquiorraT2_Explode takes unit lanceCaster,real explosionX,real explosionY,real lanceAngle,real lanceDamage,group lanceHitGroup returns nothing
local group explosionTargets=CreateGroup()
local unit explosionTarget
local unit explosionEffect
call UnitRemoveAbility(lanceCaster,0x5A533032)
set explosionEffect=CreateUnit(GetOwningPlayer(lanceCaster),0x6D303138,explosionX,explosionY,lanceAngle*bj_RADTODEG)
call SetUnitVertexColor(explosionEffect,255,255,255,175)
call SetUnitTimeScale(explosionEffect,1.05)
call SetUnitScale(explosionEffect,.8,.8,.8)
call ULQ_MyRemoveUnit(explosionEffect,.8)
call GroupEnumUnitsInRange(explosionTargets,explosionX,explosionY,595,Condition(function ULQ_NoDecor_Filter))
loop
set explosionTarget=FirstOfGroup(explosionTargets)
exitwhen explosionTarget==null
call GroupRemoveUnit(explosionTargets,explosionTarget)
if ULQ_IsUnitInvulnerable2(explosionTarget)==false and IsUnitEnemy(explosionTarget,GetOwningPlayer(lanceCaster))and GetWidgetLife(explosionTarget)>0.405 then
if IsUnitInGroup(explosionTarget,lanceHitGroup)==false then
call GroupAddUnit(lanceHitGroup,explosionTarget)
call BvOHeroSpellDamage(lanceCaster,explosionTarget,lanceDamage,true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNKNOWN)
endif
call IssueImmediateOrder(explosionTarget,"stop")
endif
endloop
call DestroyGroup(explosionTargets)
set explosionTargets=null
set explosionTarget=null
set explosionEffect=null
endfunction
function ULQ_s__UlquiorraSpells__UlquiorraT2_Act_Loop takes nothing returns nothing
local integer this
local integer i=0
local unit lanceCaster
local unit lanceMissile
local group lanceHitGroup
local real lanceDamage
local integer lanceLevel
local real lanceAngle
local boolean lanceHitHero
local real lanceX
local real lanceY
loop
exitwhen i>LoadInteger(ULQ_HashTable,-12222,0)
set this=LoadInteger(ULQ_HashTable,-12221,i)
if LoadReal(ULQ_HashTable,-12235,this)<LoadReal(ULQ_HashTable,-12237,this)and LoadReal(ULQ_HashTable,-12232,this)<LoadReal(ULQ_HashTable,-12231,this)then
call SaveReal(ULQ_HashTable,-12235,this,LoadReal(ULQ_HashTable,-12235,this)+0.02)
call ULQ_MoveUnit(LoadUnitHandle(ULQ_HashTable,-12228,this),77.5,LoadReal(ULQ_HashTable,-12236,this))
call SaveReal(ULQ_HashTable,-12232,this,LoadReal(ULQ_HashTable,-12232,this)+(77.5))
if LoadReal(ULQ_HashTable,-12226,this)>0.05 then
call SaveReal(ULQ_HashTable,-12226,this,0)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(LoadUnitHandle(ULQ_HashTable,-12223,this)),0x6D303136,GetUnitX(LoadUnitHandle(ULQ_HashTable,-12228,this)),GetUnitY(LoadUnitHandle(ULQ_HashTable,-12228,this)),LoadReal(ULQ_HashTable,-12236,this)*bj_RADTODEG)
call SetUnitVertexColor(bj_lastCreatedUnit,255,255,255,175)
call SetUnitTimeScale(bj_lastCreatedUnit,8.5)
call ULQ_AnimDummy(bj_lastCreatedUnit,0.05,1.1)
call ULQ_MyRemoveUnit(bj_lastCreatedUnit,0.35)
else
call SaveReal(ULQ_HashTable,-12226,this,LoadReal(ULQ_HashTable,-12226,this)+(0.02))
endif
call GroupEnumUnitsInRange(ULQ_SpearLanceEnumGroup,GetUnitX(LoadUnitHandle(ULQ_HashTable,-12228,this)),GetUnitY(LoadUnitHandle(ULQ_HashTable,-12228,this)),205,Condition(function ULQ_NoDecor_Filter))
loop
call SaveUnitHandle(ULQ_HashTable,-12233,this,FirstOfGroup(ULQ_SpearLanceEnumGroup))
exitwhen LoadUnitHandle(ULQ_HashTable,-12233,this)==null
if ULQ_IsUnitInvulnerable2(LoadUnitHandle(ULQ_HashTable,-12233,this))==false and IsUnitEnemy(LoadUnitHandle(ULQ_HashTable,-12233,this),GetOwningPlayer(LoadUnitHandle(ULQ_HashTable,-12223,this)))and GetWidgetLife(LoadUnitHandle(ULQ_HashTable,-12233,this))>0.405 then
if IsUnitInGroup(LoadUnitHandle(ULQ_HashTable,-12233,this),LoadGroupHandle(ULQ_HashTable,-12230,this))==false then
call BvOHeroSpellDamage(LoadUnitHandle(ULQ_HashTable,-12223,this),LoadUnitHandle(ULQ_HashTable,-12233,this),LoadReal(ULQ_HashTable,-12234,this),true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNKNOWN)
if IsUnitType(LoadUnitHandle(ULQ_HashTable,-12233,this),UNIT_TYPE_HERO)then
if LoadReal(ULQ_HashTable,-12235,this)!=999 then
call SaveReal(ULQ_HashTable,-12901,this,GetUnitX(LoadUnitHandle(ULQ_HashTable,-12233,this)))
call SaveReal(ULQ_HashTable,-12902,this,GetUnitY(LoadUnitHandle(ULQ_HashTable,-12233,this)))
endif
call SaveReal(ULQ_HashTable,-12235,this,999)
call SaveReal(ULQ_HashTable,-12234,this,LoadReal(ULQ_HashTable,-12234,this)*0.5)
endif
call GroupAddUnit(LoadGroupHandle(ULQ_HashTable,-12230,this),LoadUnitHandle(ULQ_HashTable,-12233,this))
endif
call IssueImmediateOrder(LoadUnitHandle(ULQ_HashTable,-12233,this),"stop")
endif
call GroupRemoveUnit(ULQ_SpearLanceEnumGroup,LoadUnitHandle(ULQ_HashTable,-12233,this))
endloop
call SaveUnitHandle(ULQ_HashTable,-12233,this,null)
call GroupClear(ULQ_SpearLanceEnumGroup)
else
set lanceCaster=LoadUnitHandle(ULQ_HashTable,-12223,this)
set lanceMissile=LoadUnitHandle(ULQ_HashTable,-12228,this)
set lanceHitGroup=LoadGroupHandle(ULQ_HashTable,-12230,this)
set lanceDamage=LoadReal(ULQ_HashTable,-12234,this)
set lanceLevel=LoadInteger(ULQ_HashTable,-12229,this)
set lanceAngle=LoadReal(ULQ_HashTable,-12236,this)
set lanceHitHero=LoadReal(ULQ_HashTable,-12235,this)==999
set lanceX=GetUnitX(lanceMissile)
set lanceY=GetUnitY(lanceMissile)
if lanceHitHero then
set lanceX=LoadReal(ULQ_HashTable,-12901,this)
set lanceY=LoadReal(ULQ_HashTable,-12902,this)
endif
call SaveReal(ULQ_HashTable,-12901,this,0)
call SaveReal(ULQ_HashTable,-12902,this,0)
call SaveUnitHandle(ULQ_HashTable,-12228,this,null)
call SaveUnitHandle(ULQ_HashTable,-12233,this,null)
call SaveUnitHandle(ULQ_HashTable,-12223,this,null)
call SaveReal(ULQ_HashTable,-12235,this,0)
call SaveReal(ULQ_HashTable,-12236,this,0)
call SaveReal(ULQ_HashTable,-12226,this,0)
call SaveReal(ULQ_HashTable,-12237,this,0)
call SaveReal(ULQ_HashTable,-12224,this,0)
call SaveReal(ULQ_HashTable,-12225,this,0)
call ULQ_s__UlquiorraSpells__UlquiorraT2_Act_StopAction(this,i)
call ULQ_s__UlquiorraSpells__UlquiorraT2_Act_deallocate(this)
call ULQ_MyRemoveUnit(lanceMissile,0.01)
if lanceHitHero then
call ULQ_UlquiorraT2_Explode(lanceCaster,lanceX,lanceY,lanceAngle,lanceDamage,lanceHitGroup)
else
endif
call GroupClear(lanceHitGroup)
call DestroyGroup(lanceHitGroup)
endif
set i=i+1
endloop
set lanceCaster=null
set lanceMissile=null
set lanceHitGroup=null
endfunction
function ULQ_LanceFinish takes timer lanceTimer returns nothing
local integer lanceKey=GetHandleId(lanceTimer)
local unit lanceCaster=LoadUnitHandle(ULQ_HashTable,lanceKey,0)
local unit lanceMissile=LoadUnitHandle(ULQ_HashTable,lanceKey,1)
local group lanceHitGroup=LoadGroupHandle(ULQ_HashTable,lanceKey,2)
local real lanceAngle=LoadReal(ULQ_HashTable,lanceKey,3)
local real lanceDamage=LoadReal(ULQ_HashTable,lanceKey,8)
local integer lanceLevel=LoadInteger(ULQ_HashTable,lanceKey,9)
local boolean lanceHitHero=LoadBoolean(ULQ_HashTable,lanceKey,10)
local real lanceHitX=LoadReal(ULQ_HashTable,lanceKey,11)
local real lanceHitY=LoadReal(ULQ_HashTable,lanceKey,12)
call PauseTimer(lanceTimer)
call FlushChildHashtable(ULQ_HashTable,lanceKey)
call DestroyTimer(lanceTimer)
call ULQ_MyRemoveUnit(lanceMissile,0.01)
if lanceHitHero then
call ULQ_UlquiorraT2_Explode(lanceCaster,lanceHitX,lanceHitY,lanceAngle,lanceDamage,lanceHitGroup)
else
endif
call GroupClear(lanceHitGroup)
call DestroyGroup(lanceHitGroup)
set lanceCaster=null
set lanceMissile=null
set lanceHitGroup=null
endfunction
function ULQ_LanceTick takes nothing returns nothing
local timer lanceTimer=GetExpiredTimer()
local integer lanceKey=GetHandleId(lanceTimer)
local unit lanceCaster=LoadUnitHandle(ULQ_HashTable,lanceKey,0)
local unit lanceMissile=LoadUnitHandle(ULQ_HashTable,lanceKey,1)
local group lanceHitGroup=LoadGroupHandle(ULQ_HashTable,lanceKey,2)
local real lanceAngle=LoadReal(ULQ_HashTable,lanceKey,3)
local real lanceTraveled=LoadReal(ULQ_HashTable,lanceKey,4)
local real lanceElapsed=LoadReal(ULQ_HashTable,lanceKey,6)
local real lanceTrailCounter=LoadReal(ULQ_HashTable,lanceKey,7)
local real lanceDamage=LoadReal(ULQ_HashTable,lanceKey,8)
local unit lanceTarget
local unit lanceTrail
if LoadBoolean(ULQ_HashTable,lanceKey,10) or lanceElapsed>=0.8 or lanceTraveled>=LoadReal(ULQ_HashTable,lanceKey,5) or lanceMissile==null then
call ULQ_LanceFinish(lanceTimer)
else
set lanceElapsed=lanceElapsed+0.02
call ULQ_MoveUnit(lanceMissile,77.5,lanceAngle)
set lanceTraveled=lanceTraveled+77.5
if lanceTrailCounter>0.05 then
set lanceTrailCounter=0
set lanceTrail=CreateUnit(GetOwningPlayer(lanceCaster),0x6D303136,GetUnitX(lanceMissile),GetUnitY(lanceMissile),lanceAngle*bj_RADTODEG)
call SetUnitVertexColor(lanceTrail,255,255,255,175)
call SetUnitTimeScale(lanceTrail,8.5)
call ULQ_AnimDummy(lanceTrail,0.05,1.1)
call ULQ_MyRemoveUnit(lanceTrail,0.35)
else
set lanceTrailCounter=lanceTrailCounter+0.02
endif
call SaveReal(ULQ_HashTable,lanceKey,4,lanceTraveled)
call SaveReal(ULQ_HashTable,lanceKey,6,lanceElapsed)
call SaveReal(ULQ_HashTable,lanceKey,7,lanceTrailCounter)
call GroupEnumUnitsInRange(ULQ_SpearLanceEnumGroup,GetUnitX(lanceMissile),GetUnitY(lanceMissile),205,Condition(function ULQ_NoDecor_Filter))
loop
set lanceTarget=FirstOfGroup(ULQ_SpearLanceEnumGroup)
exitwhen lanceTarget==null
call GroupRemoveUnit(ULQ_SpearLanceEnumGroup,lanceTarget)
if ULQ_IsUnitInvulnerable2(lanceTarget)==false and IsUnitEnemy(lanceTarget,GetOwningPlayer(lanceCaster))and GetWidgetLife(lanceTarget)>0.405 then
if IsUnitInGroup(lanceTarget,lanceHitGroup)==false then
call GroupAddUnit(lanceHitGroup,lanceTarget)
call BvOHeroSpellDamage(lanceCaster,lanceTarget,lanceDamage,true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNKNOWN)
// a hit counts on heroes, Oz and bosses ('A0EM' Boss / strong creep, 'nfgl' Oz without it)
if IsUnitType(lanceTarget,UNIT_TYPE_HERO) or GetUnitAbilityLevel(lanceTarget,'A0EM')>0 or GetUnitTypeId(lanceTarget)=='nfgl' then
if not LoadBoolean(ULQ_HashTable,lanceKey,10) then
call SaveBoolean(ULQ_HashTable,lanceKey,10,true)
call SaveReal(ULQ_HashTable,lanceKey,11,GetUnitX(lanceTarget))
call SaveReal(ULQ_HashTable,lanceKey,12,GetUnitY(lanceTarget))
endif
set lanceDamage=lanceDamage*0.5
call SaveReal(ULQ_HashTable,lanceKey,8,lanceDamage)
endif
endif
call IssueImmediateOrder(lanceTarget,"stop")
endif
endloop
call GroupClear(ULQ_SpearLanceEnumGroup)
endif
set lanceTimer=null
set lanceCaster=null
set lanceMissile=null
set lanceHitGroup=null
set lanceTarget=null
set lanceTrail=null
endfunction
function ULQ_s__UlquiorraSpells__UlquiorraT2_Act_UlquiorraT2_Act_Start takes unit ulquiorraCasterUnit,real ulquiorraDestinationX,real ulquiorraDestinationY returns nothing
local timer lanceTimer=CreateTimer()
local integer lanceKey=GetHandleId(lanceTimer)
local real lanceAngle=Atan2(ulquiorraDestinationY-GetUnitY(ulquiorraCasterUnit),ulquiorraDestinationX-GetUnitX(ulquiorraCasterUnit))
local integer lanceLevel=GetUnitAbilityLevel(ulquiorraCasterUnit,0x5A5A3037)
local real lanceDamage=(GetHeroStr(ulquiorraCasterUnit,true)*3)+(GetHeroAgi(ulquiorraCasterUnit,true)*4)+(GetHeroInt(ulquiorraCasterUnit,true)*5)
local unit lanceMissile
if GetUnitTypeId(ulquiorraCasterUnit)==0x5553325F then
set lanceDamage=lanceDamage+(GetHeroStr(ulquiorraCasterUnit,true)*1.5)+(GetHeroAgi(ulquiorraCasterUnit,true)*1.5)+(GetHeroInt(ulquiorraCasterUnit,true)*1.5)
endif
set lanceMissile=CreateUnit(GetOwningPlayer(ulquiorraCasterUnit),0x6D303137,GetUnitX(ulquiorraCasterUnit)+130*Cos(lanceAngle),GetUnitY(ulquiorraCasterUnit)+130*Sin(lanceAngle),lanceAngle*bj_RADTODEG)
call SetUnitTimeScale(lanceMissile,0.3)
call SaveUnitHandle(ULQ_HashTable,lanceKey,0,ulquiorraCasterUnit)
call SaveUnitHandle(ULQ_HashTable,lanceKey,1,lanceMissile)
call SaveGroupHandle(ULQ_HashTable,lanceKey,2,CreateGroup())
call SaveReal(ULQ_HashTable,lanceKey,3,lanceAngle)
call SaveReal(ULQ_HashTable,lanceKey,4,0)
call SaveReal(ULQ_HashTable,lanceKey,5,1000+lanceLevel*200)
call SaveReal(ULQ_HashTable,lanceKey,6,0)
call SaveReal(ULQ_HashTable,lanceKey,7,2)
call SaveReal(ULQ_HashTable,lanceKey,8,lanceDamage)
call SaveInteger(ULQ_HashTable,lanceKey,9,lanceLevel)
call SaveBoolean(ULQ_HashTable,lanceKey,10,false)
call TimerStart(lanceTimer,0.02,true,function ULQ_LanceTick)
set lanceTimer=null
set lanceMissile=null
set ulquiorraCasterUnit=null
endfunction
function ULQ_s__UlquiorraSpells__UlquiorraNormalT1_StopAction takes integer ulquiorraInstanceIndex,integer ulquiorraLoopIndex returns nothing
call SaveInteger(ULQ_HashTable,-12242,ulquiorraLoopIndex,LoadInteger(ULQ_HashTable,-12242,LoadInteger(ULQ_HashTable,-12243,0)))
call SaveInteger(ULQ_HashTable,-12243,0,LoadInteger(ULQ_HashTable,-12243,0)-1)
if LoadInteger(ULQ_HashTable,-12243,0)==-1 then
call PauseTimer(LoadTimerHandle(ULQ_HashTable,-12241,0))
endif
endfunction
function ULQ_s__UlquiorraSpells__UlquiorraNormalT1_Loop takes nothing returns nothing
local integer this
local integer i=0
loop
exitwhen i>LoadInteger(ULQ_HashTable,-12243,0)
set this=LoadInteger(ULQ_HashTable,-12242,i)
if ULQ_SpellBool(LoadUnitHandle(ULQ_HashTable,-12244,this))then
call SaveReal(ULQ_HashTable,-12252,this,LoadReal(ULQ_HashTable,-12252,this)+0.01)
call IssueImmediateOrder(LoadUnitHandle(ULQ_HashTable,-12244,this),"stop")
if LoadReal(ULQ_HashTable,-12252,this)>0.38 then
if GetUnitTypeId(LoadUnitHandle(ULQ_HashTable,-12244,this))==0x5553315F then
if GetRandomInt(0,1)==0 then
call ULQ_PlayRandomVoice(LoadUnitHandle(ULQ_HashTable,-12244,this),185,185)
else
call ULQ_PlayRandomVoice(LoadUnitHandle(ULQ_HashTable,-12244,this),194,194)
endif
call ULQ_s__UlquiorraSpells__UlquiorraT2_Act_UlquiorraT2_Act_Start(LoadUnitHandle(ULQ_HashTable,-12244,this),LoadReal(ULQ_HashTable,-12245,this),LoadReal(ULQ_HashTable,-12246,this))
else
if GetRandomInt(0,1)==0 then
call ULQ_PlayRandomVoice(LoadUnitHandle(ULQ_HashTable,-12244,this),187,187)
else
call ULQ_PlayRandomVoice(LoadUnitHandle(ULQ_HashTable,-12244,this),195,195)
endif
call ULQ_s__UlquiorraSpells__UlquiorraT2_Act_UlquiorraT2_Act_Start(LoadUnitHandle(ULQ_HashTable,-12244,this),LoadReal(ULQ_HashTable,-12245,this),LoadReal(ULQ_HashTable,-12246,this))
endif
call SetUnitTimeScale(LoadUnitHandle(ULQ_HashTable,-12244,this),1)
call SaveUnitHandle(ULQ_HashTable,-12244,this,null)
call SaveReal(ULQ_HashTable,-12249,this,0)
call SaveReal(ULQ_HashTable,-12245,this,0)
call SaveSoundHandle(ULQ_HashTable,-12250,this,null)
call SaveReal(ULQ_HashTable,-12246,this,0)
call ULQ_s__UlquiorraSpells__UlquiorraNormalT1_StopAction(this,i)
call ULQ_s__UlquiorraSpells__UlquiorraNormalT1_deallocate(this)
endif
else
call SetUnitTimeScale(LoadUnitHandle(ULQ_HashTable,-12244,this),1)
call SaveUnitHandle(ULQ_HashTable,-12244,this,null)
call SaveReal(ULQ_HashTable,-12249,this,0)
call SaveReal(ULQ_HashTable,-12245,this,0)
call SaveSoundHandle(ULQ_HashTable,-12250,this,null)
call SaveReal(ULQ_HashTable,-12246,this,0)
call ULQ_s__UlquiorraSpells__UlquiorraNormalT1_StopAction(this,i)
call ULQ_s__UlquiorraSpells__UlquiorraNormalT1_deallocate(this)
endif
set i=i+1
endloop
endfunction
function ULQ_s__UlquiorraSpells__UlquiorraNormalT1_UlquiorraNormalT1_Start takes unit ulquiorraCasterUnit,real ulquiorraDestinationX,real ulquiorraDestinationY returns nothing
local integer this=ULQ_s__UlquiorraSpells__UlquiorraNormalT1__allocate()
call SaveInteger(ULQ_HashTable,-12243,0,LoadInteger(ULQ_HashTable,-12243,0)+1)
call SaveInteger(ULQ_HashTable,-12242,LoadInteger(ULQ_HashTable,-12243,0),this)
call SaveUnitHandle(ULQ_HashTable,-12244,this,ulquiorraCasterUnit)
call SaveReal(ULQ_HashTable,-12252,this,0)
call SaveReal(ULQ_HashTable,-12249,this,10)
call SaveReal(ULQ_HashTable,-12245,this,ulquiorraDestinationX)
call SaveReal(ULQ_HashTable,-12246,this,ulquiorraDestinationY)
call SaveReal(ULQ_HashTable,-12247,this,Atan2(LoadReal(ULQ_HashTable,-12246,this)-GetUnitY(LoadUnitHandle(ULQ_HashTable,-12244,this)),LoadReal(ULQ_HashTable,-12245,this)-GetUnitX(LoadUnitHandle(ULQ_HashTable,-12244,this))))
call SaveReal(ULQ_HashTable,-12248,this,0)
call SaveInteger(ULQ_HashTable,-12251,this,0)
call IssueImmediateOrder(LoadUnitHandle(ULQ_HashTable,-12244,this),"stop")
call ULQ_SetAnimIndex(LoadUnitHandle(ULQ_HashTable,-12244,this),0.01,8)
call SetUnitTimeScale(LoadUnitHandle(ULQ_HashTable,-12244,this),2.35)
call SetUnitFacing(LoadUnitHandle(ULQ_HashTable,-12244,this),LoadReal(ULQ_HashTable,-12247,this)*bj_RADTODEG)
if LoadInteger(ULQ_HashTable,-12243,0)==0 then
call TimerStart(LoadTimerHandle(ULQ_HashTable,-12241,0),0.01,true,function ULQ_s__UlquiorraSpells__UlquiorraNormalT1_Loop)
endif
set ulquiorraCasterUnit=null
endfunction
function ULQ_FOCS_Q_Resolve takes nothing returns nothing
local timer ulquiorraCastTimer=GetExpiredTimer()
local integer ulquiorraCastId=GetHandleId(ulquiorraCastTimer)
local unit ulquiorraCaster=LoadUnitHandle(ULQ_HashTable,ulquiorraCastId,0)
local unit ulquiorraTarget
local group ulquiorraTargets=CreateGroup()
local real ulquiorraOriginX=LoadReal(ULQ_HashTable,ulquiorraCastId,1)
local real ulquiorraOriginY=LoadReal(ULQ_HashTable,ulquiorraCastId,2)
local real ulquiorraDirection=LoadReal(ULQ_HashTable,ulquiorraCastId,3)
local real ulquiorraRange=LoadReal(ULQ_HashTable,ulquiorraCastId,4)
local real ulquiorraDamage=LoadReal(ULQ_HashTable,ulquiorraCastId,5)
local integer ulquiorraWaveStep=LoadInteger(ULQ_HashTable,ulquiorraCastId,6)+1
local real ulquiorraWaveDistance=ulquiorraRange*I2R(ulquiorraWaveStep)/10.
local real ulquiorraWaveX=ulquiorraOriginX+ulquiorraWaveDistance*Cos(ulquiorraDirection)
local real ulquiorraWaveY=ulquiorraOriginY+ulquiorraWaveDistance*Sin(ulquiorraDirection)
local group ulquiorraAlreadyHit=LoadGroupHandle(ULQ_HashTable,ulquiorraCastId,7)
local real ulquiorraTargetDeltaX
local real ulquiorraTargetDeltaY
local real ulquiorraTargetForward
local real ulquiorraTargetSideways
local real ulquiorraWaveWidth=200.
if ulquiorraCaster!=null then
if GetUnitTypeId(ulquiorraCaster)=='US1_' or GetUnitTypeId(ulquiorraCaster)=='US2_' then
set ulquiorraWaveWidth=220.
endif
call GroupEnumUnitsInRange(ulquiorraTargets,ulquiorraWaveX,ulquiorraWaveY,ulquiorraWaveWidth,null)
loop
set ulquiorraTarget=FirstOfGroup(ulquiorraTargets)
exitwhen ulquiorraTarget==null
call GroupRemoveUnit(ulquiorraTargets,ulquiorraTarget)
set ulquiorraTargetDeltaX=GetUnitX(ulquiorraTarget)-ulquiorraOriginX
set ulquiorraTargetDeltaY=GetUnitY(ulquiorraTarget)-ulquiorraOriginY
set ulquiorraTargetForward=ulquiorraTargetDeltaX*Cos(ulquiorraDirection)+ulquiorraTargetDeltaY*Sin(ulquiorraDirection)
set ulquiorraTargetSideways=RAbsBJ(-ulquiorraTargetDeltaX*Sin(ulquiorraDirection)+ulquiorraTargetDeltaY*Cos(ulquiorraDirection))
if ulquiorraTargetForward>=ulquiorraWaveDistance-90. and ulquiorraTargetForward<=ulquiorraWaveDistance+200. and ulquiorraTargetSideways<=ulquiorraWaveWidth and IsUnitEnemy(ulquiorraTarget,GetOwningPlayer(ulquiorraCaster)) and GetWidgetLife(ulquiorraTarget)>0.405 and not IsUnitType(ulquiorraTarget,UNIT_TYPE_STRUCTURE) and not ULQ_IsUnitInvulnerable2(ulquiorraTarget) and not IsUnitInGroup(ulquiorraTarget,ulquiorraAlreadyHit) then
call GroupAddUnit(ulquiorraAlreadyHit,ulquiorraTarget)
call BvOHeroSpellDamage(ulquiorraCaster,ulquiorraTarget,ulquiorraDamage,true,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC)
endif
endloop
endif
call DestroyGroup(ulquiorraTargets)
if ulquiorraWaveStep<10 and ulquiorraCaster!=null then
call SaveInteger(ULQ_HashTable,ulquiorraCastId,6,ulquiorraWaveStep)
else
call DestroyGroup(ulquiorraAlreadyHit)
call FlushChildHashtable(ULQ_HashTable,ulquiorraCastId)
call DestroyTimer(ulquiorraCastTimer)
endif
set ulquiorraTargets=null
set ulquiorraAlreadyHit=null
set ulquiorraTarget=null
set ulquiorraCaster=null
set ulquiorraCastTimer=null
endfunction
function ULQ_UlquiorraNormalQ_Start takes unit ulquiorraCaster,real ulquiorraDestinationX,real ulquiorraDestinationY returns nothing
local timer ulquiorraCastTimer=CreateTimer()
local integer ulquiorraCastId=GetHandleId(ulquiorraCastTimer)
local unit ulquiorraVisual
local integer ulquiorraEffectIndex=0
local integer ulquiorraLevel=GetUnitAbilityLevel(ulquiorraCaster,'ZZ00')
local real ulquiorraOriginX=GetUnitX(ulquiorraCaster)
local real ulquiorraOriginY=GetUnitY(ulquiorraCaster)
local real ulquiorraFacing=Atan2(ulquiorraDestinationY-ulquiorraOriginY,ulquiorraDestinationX-ulquiorraOriginX)
local real ulquiorraDamage
if ulquiorraLevel<1 then
set ulquiorraLevel=1
endif
set ulquiorraDamage=150.+50.*ulquiorraLevel+(0.25+0.15*ulquiorraLevel)*GetHeroAgi(ulquiorraCaster,true)+(0.45+0.15*ulquiorraLevel)*GetHeroInt(ulquiorraCaster,true)
if GetUnitTypeId(ulquiorraCaster)=='US1_' then
set ulquiorraDamage=ulquiorraDamage+0.5*(GetHeroAgi(ulquiorraCaster,true)+GetHeroInt(ulquiorraCaster,true))
endif
if GetUnitTypeId(ulquiorraCaster)=='US2_' then
set ulquiorraDamage=ulquiorraDamage+GetHeroAgi(ulquiorraCaster,true)+GetHeroInt(ulquiorraCaster,true)
endif
call SetUnitFacing(ulquiorraCaster,ulquiorraFacing*bj_RADTODEG)
call SetUnitAnimationByIndex(ulquiorraCaster,5)
if GetUnitTypeId(ulquiorraCaster)=='US00' then
if GetRandomInt(0,1)==0 then
call ULQ_PlayRandomVoice(ulquiorraCaster,181,181)
else
call ULQ_PlayRandomVoice(ulquiorraCaster,190,190)
endif
else
if GetRandomInt(0,2)==0 then
call ULQ_PlayRandomVoice(ulquiorraCaster,182,182)
elseif GetRandomInt(0,1)==0 then
call ULQ_PlayRandomVoice(ulquiorraCaster,191,191)
else
call ULQ_PlayRandomVoice(ulquiorraCaster,192,192)
endif
endif
call SaveUnitHandle(ULQ_HashTable,ulquiorraCastId,0,ulquiorraCaster)
call SaveReal(ULQ_HashTable,ulquiorraCastId,1,ulquiorraOriginX)
call SaveReal(ULQ_HashTable,ulquiorraCastId,2,ulquiorraOriginY)
call SaveReal(ULQ_HashTable,ulquiorraCastId,3,ulquiorraFacing)
call SaveReal(ULQ_HashTable,ulquiorraCastId,4,1080.)
call SaveReal(ULQ_HashTable,ulquiorraCastId,5,ulquiorraDamage)
call SaveInteger(ULQ_HashTable,ulquiorraCastId,6,0)
call SaveGroupHandle(ULQ_HashTable,ulquiorraCastId,7,CreateGroup())
if GetUnitTypeId(ulquiorraCaster)=='US1_' or GetUnitTypeId(ulquiorraCaster)=='US2_' then
if GetUnitTypeId(ulquiorraCaster)=='US1_' then
set ulquiorraVisual=CreateUnit(GetOwningPlayer(ulquiorraCaster),'e06B',ulquiorraOriginX,ulquiorraOriginY,ulquiorraFacing*bj_RADTODEG)
else
set ulquiorraVisual=CreateUnit(GetOwningPlayer(ulquiorraCaster),'e06F',ulquiorraOriginX,ulquiorraOriginY,ulquiorraFacing*bj_RADTODEG)
endif
call SetUnitPathing(ulquiorraVisual,false)
call SetUnitFacingTimed(ulquiorraVisual,ulquiorraFacing*bj_RADTODEG,0.)
call UnitApplyTimedLife(ulquiorraVisual,'BTLF',2.)
else
loop
exitwhen ulquiorraEffectIndex>=4
set ulquiorraVisual=CreateUnit(GetOwningPlayer(ulquiorraCaster),'e00O',ulquiorraOriginX,ulquiorraOriginY,ulquiorraFacing*bj_RADTODEG)
call SetUnitPathing(ulquiorraVisual,false)
call SetUnitTurnSpeed(ulquiorraVisual,0.)
call SetUnitFacingTimed(ulquiorraVisual,ulquiorraFacing*bj_RADTODEG,0.)
call SetUnitScale(ulquiorraVisual,1.8,1.8,1.8)
call SetUnitTimeScale(ulquiorraVisual,0.5)
call UnitApplyTimedLife(ulquiorraVisual,'BTLF',2.)
set ulquiorraEffectIndex=ulquiorraEffectIndex+1
endloop
endif
call TimerStart(ulquiorraCastTimer,0.04,true,function ULQ_FOCS_Q_Resolve)
set ulquiorraVisual=null
set ulquiorraCaster=null
set ulquiorraCastTimer=null
endfunction
function ULQ_W_RegenTick takes nothing returns nothing
local timer ulquiorraRegenTimer=GetExpiredTimer()
local integer ulquiorraRegenKey=GetHandleId(ulquiorraRegenTimer)
local unit ulquiorraCaster=LoadUnitHandle(ULQ_HashTable,ulquiorraRegenKey,0)
local effect ulquiorraRegenVisual=LoadEffectHandle(ULQ_HashTable,ulquiorraRegenKey,1)
local integer ulquiorraTick=LoadInteger(ULQ_HashTable,ulquiorraRegenKey,2)+1
local integer ulquiorraForm=GetUnitTypeId(ulquiorraCaster)
local real ulquiorraMorphBonus=0.
local real ulquiorraRegenAmount
if ulquiorraCaster!=null and GetWidgetLife(ulquiorraCaster)>.405 then
if ulquiorraForm=='US1_' then
set ulquiorraMorphBonus=.2
elseif ulquiorraForm=='US2_' then
set ulquiorraMorphBonus=.4
endif
if GetWidgetLife(ulquiorraCaster)>GetUnitState(ulquiorraCaster,UNIT_STATE_MAX_LIFE)*.3 then
set ulquiorraRegenAmount=(.5+ulquiorraMorphBonus)*GetHeroAgi(ulquiorraCaster,true)+(.7+ulquiorraMorphBonus)*GetHeroInt(ulquiorraCaster,true)
call SetWidgetLife(ulquiorraCaster,GetWidgetLife(ulquiorraCaster)+ulquiorraRegenAmount*.5)
endif
endif
if ulquiorraTick<10 and ulquiorraCaster!=null and GetWidgetLife(ulquiorraCaster)>.405 then
call SaveInteger(ULQ_HashTable,ulquiorraRegenKey,2,ulquiorraTick)
else
if ulquiorraRegenVisual!=null then
call DestroyEffect(ulquiorraRegenVisual)
endif
call FlushChildHashtable(ULQ_HashTable,ulquiorraRegenKey)
call DestroyTimer(ulquiorraRegenTimer)
endif
set ulquiorraCaster=null
set ulquiorraRegenVisual=null
set ulquiorraRegenTimer=null
endfunction
function ULQ_W_VisualTick takes nothing returns nothing
local timer ulquiorraVisualTimer=GetExpiredTimer()
local integer ulquiorraVisualKey=GetHandleId(ulquiorraVisualTimer)
local unit ulquiorraCaster=LoadUnitHandle(ULQ_HashTable,ulquiorraVisualKey,0)
local unit ulquiorraFirstOrbit=LoadUnitHandle(ULQ_HashTable,ulquiorraVisualKey,1)
local unit ulquiorraSecondOrbit=LoadUnitHandle(ULQ_HashTable,ulquiorraVisualKey,2)
local unit ulquiorraThirdOrbit=LoadUnitHandle(ULQ_HashTable,ulquiorraVisualKey,3)
local integer ulquiorraVisualTick=LoadInteger(ULQ_HashTable,ulquiorraVisualKey,4)+1
if ulquiorraVisualTick<=200 and ulquiorraCaster!=null and GetWidgetLife(ulquiorraCaster)>.405 then
call SetUnitX(ulquiorraFirstOrbit,GetUnitX(ulquiorraCaster))
call SetUnitY(ulquiorraFirstOrbit,GetUnitY(ulquiorraCaster))
call SetUnitFacing(ulquiorraFirstOrbit,GetUnitFacing(ulquiorraFirstOrbit)+5.)
call SetUnitX(ulquiorraSecondOrbit,GetUnitX(ulquiorraCaster))
call SetUnitY(ulquiorraSecondOrbit,GetUnitY(ulquiorraCaster))
call SetUnitFacing(ulquiorraSecondOrbit,GetUnitFacing(ulquiorraSecondOrbit)+5.)
call SetUnitX(ulquiorraThirdOrbit,GetUnitX(ulquiorraCaster))
call SetUnitY(ulquiorraThirdOrbit,GetUnitY(ulquiorraCaster))
call SetUnitFacing(ulquiorraThirdOrbit,GetUnitFacing(ulquiorraThirdOrbit)+5.)
call SetUnitFlyHeight(ulquiorraFirstOrbit,GetUnitFlyHeight(ulquiorraCaster),0.)
call SetUnitFlyHeight(ulquiorraSecondOrbit,GetUnitFlyHeight(ulquiorraCaster),0.)
call SetUnitFlyHeight(ulquiorraThirdOrbit,GetUnitFlyHeight(ulquiorraCaster),0.)
call SaveInteger(ULQ_HashTable,ulquiorraVisualKey,4,ulquiorraVisualTick)
else
call RemoveUnit(ulquiorraFirstOrbit)
call RemoveUnit(ulquiorraSecondOrbit)
call RemoveUnit(ulquiorraThirdOrbit)
call FlushChildHashtable(ULQ_HashTable,ulquiorraVisualKey)
call DestroyTimer(ulquiorraVisualTimer)
endif
set ulquiorraCaster=null
set ulquiorraFirstOrbit=null
set ulquiorraSecondOrbit=null
set ulquiorraThirdOrbit=null
set ulquiorraVisualTimer=null
endfunction
function ULQ_W_StartVisual takes unit ulquiorraCaster returns nothing
local timer ulquiorraVisualTimer=CreateTimer()
local integer ulquiorraVisualKey=GetHandleId(ulquiorraVisualTimer)
local unit ulquiorraFirstOrbit=CreateUnit(GetOwningPlayer(ulquiorraCaster),'m005',GetUnitX(ulquiorraCaster),GetUnitY(ulquiorraCaster),0.)
local unit ulquiorraSecondOrbit=CreateUnit(GetOwningPlayer(ulquiorraCaster),'m005',GetUnitX(ulquiorraCaster),GetUnitY(ulquiorraCaster),120.)
local unit ulquiorraThirdOrbit=CreateUnit(GetOwningPlayer(ulquiorraCaster),'m005',GetUnitX(ulquiorraCaster),GetUnitY(ulquiorraCaster),240.)
call SetUnitVertexColor(ulquiorraFirstOrbit,255,255,255,175)
call SetUnitVertexColor(ulquiorraSecondOrbit,255,255,255,175)
call SetUnitVertexColor(ulquiorraThirdOrbit,255,255,255,175)
call SetUnitTimeScale(ulquiorraFirstOrbit,1.95)
call SetUnitTimeScale(ulquiorraSecondOrbit,1.95)
call SetUnitTimeScale(ulquiorraThirdOrbit,1.95)
call SaveUnitHandle(ULQ_HashTable,ulquiorraVisualKey,0,ulquiorraCaster)
call SaveUnitHandle(ULQ_HashTable,ulquiorraVisualKey,1,ulquiorraFirstOrbit)
call SaveUnitHandle(ULQ_HashTable,ulquiorraVisualKey,2,ulquiorraSecondOrbit)
call SaveUnitHandle(ULQ_HashTable,ulquiorraVisualKey,3,ulquiorraThirdOrbit)
call SaveInteger(ULQ_HashTable,ulquiorraVisualKey,4,0)
call TimerStart(ulquiorraVisualTimer,.025,true,function ULQ_W_VisualTick)
set ulquiorraVisualTimer=null
set ulquiorraFirstOrbit=null
set ulquiorraSecondOrbit=null
set ulquiorraThirdOrbit=null
endfunction
function ULQ_UlquiorraNormalW_Start takes unit ulquiorraCaster returns nothing
local timer ulquiorraRegenTimer=CreateTimer()
local integer ulquiorraRegenKey=GetHandleId(ulquiorraRegenTimer)
call SaveUnitHandle(ULQ_HashTable,ulquiorraRegenKey,0,ulquiorraCaster)
call ULQ_W_StartVisual(ulquiorraCaster)
call SaveEffectHandle(ULQ_HashTable,ulquiorraRegenKey,1,null)
call SaveInteger(ULQ_HashTable,ulquiorraRegenKey,2,0)
call ULQ_PlaySoundOnUnit(LoadSoundHandle(ULQ_HashTable,-12002,189),100,ulquiorraCaster)
call TimerStart(ulquiorraRegenTimer,.5,true,function ULQ_W_RegenTick)
set ulquiorraRegenTimer=null
endfunction
function ULQ_UlquiorraNormalR_Start takes unit ulquiorraActingUnit,real ulquiorraDestinationX,real ulquiorraDestinationY returns nothing
call ULQ_s__UlquiorraSpells__UlquiorraR1_UlquiorraR1_Start(ulquiorraActingUnit,ulquiorraDestinationX,ulquiorraDestinationY)
endfunction
function ULQ_UlquiorraNormalT_Start takes unit ulquiorraActingUnit returns nothing
call ULQ_s__UlquiorraSpells__UlquiorraT_UlquiorraT_Start(ulquiorraActingUnit)
set ulquiorraActingUnit=null
endfunction
function ULQ_UlquiorraNormalT1_Start takes unit ulquiorraActingUnit,real ulquiorraDestinationX,real ulquiorraDestinationY returns nothing
local integer heroKey=GetHandleId(ulquiorraActingUnit)
// the stop of ULQ_CheckBookCast does not always cancel the cast: without Luz de la Luna or while the lance recharges
// nothing is thrown
if GetUnitAbilityLevel(ulquiorraActingUnit,'ZS02')==0 or TimerGetElapsed(AYClock)<LoadReal(ULQ_HashTable,heroKey,9301) then
call SaveBoolean(ULQ_HashTable,heroKey,9314,false)
set ulquiorraActingUnit=null
return
endif
call SaveReal(ULQ_HashTable,heroKey,9301,TimerGetElapsed(AYClock)+20.+GetUnitAbilityLevel(ulquiorraActingUnit,'ZZ07'))
call SaveBoolean(ULQ_HashTable,heroKey,9314,true)
call SaveReal(ULQ_HashTable,heroKey,9315,ulquiorraDestinationX)
call SaveReal(ULQ_HashTable,heroKey,9316,ulquiorraDestinationY)
set ulquiorraActingUnit=null
endfunction
// the end of a throw cast: the windup starts
function ULQ_LanceOnEndCast takes nothing returns boolean
local unit lanceHero=GetTriggerUnit()
local integer heroKey=GetHandleId(lanceHero)
if GetSpellAbilityId()=='ZZ07' and LoadBoolean(ULQ_HashTable,heroKey,9314) then
call SaveBoolean(ULQ_HashTable,heroKey,9314,false)
if GetWidgetLife(lanceHero)>.405 then
call ULQ_s__UlquiorraSpells__UlquiorraNormalT1_UlquiorraNormalT1_Start(lanceHero,LoadReal(ULQ_HashTable,heroKey,9315),LoadReal(ULQ_HashTable,heroKey,9316))
endif
endif
set lanceHero=null
return false
endfunction
function ULQ_LanceInit takes nothing returns nothing
local trigger endTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(endTrigger,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(endTrigger,Condition(function ULQ_LanceOnEndCast))
set endTrigger=null
endfunction
function ULQ_D_Bala_EndStun takes nothing returns nothing
local timer ulquiorraStunTimer=GetExpiredTimer()
local integer ulquiorraStunKey=GetHandleId(ulquiorraStunTimer)
local unit ulquiorraStunnedUnit=LoadUnitHandle(ULQ_HashTable,ulquiorraStunKey,0)
local effect ulquiorraStunVisual=LoadEffectHandle(ULQ_HashTable,ulquiorraStunKey,1)
if ulquiorraStunnedUnit!=null then
if not LoadBoolean(ULQ_HashTable,ulquiorraStunKey,2) then
call PauseUnit(ulquiorraStunnedUnit,false)
endif
call RemoveSavedHandle(ULQ_HashTable,GetHandleId(ulquiorraStunnedUnit),9202)
endif
if ulquiorraStunVisual!=null then
call DestroyEffect(ulquiorraStunVisual)
endif
call FlushChildHashtable(ULQ_HashTable,ulquiorraStunKey)
call DestroyTimer(ulquiorraStunTimer)
set ulquiorraStunnedUnit=null
set ulquiorraStunVisual=null
set ulquiorraStunTimer=null
endfunction
function ULQ_D_Bala_ApplyStun takes unit ulquiorraStunnedUnit returns nothing
local timer ulquiorraStunTimer=LoadTimerHandle(ULQ_HashTable,GetHandleId(ulquiorraStunnedUnit),9202)
local integer ulquiorraStunKey
if ulquiorraStunTimer==null then
set ulquiorraStunTimer=CreateTimer()
set ulquiorraStunKey=GetHandleId(ulquiorraStunTimer)
call SaveTimerHandle(ULQ_HashTable,GetHandleId(ulquiorraStunnedUnit),9202,ulquiorraStunTimer)
call SaveUnitHandle(ULQ_HashTable,ulquiorraStunKey,0,ulquiorraStunnedUnit)
call SaveBoolean(ULQ_HashTable,ulquiorraStunKey,2,IsUnitPaused(ulquiorraStunnedUnit))
call SaveEffectHandle(ULQ_HashTable,ulquiorraStunKey,1,AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapTarget.mdl",ulquiorraStunnedUnit,"overhead"))
call PauseUnit(ulquiorraStunnedUnit,true)
endif
call TimerStart(ulquiorraStunTimer,.75,false,function ULQ_D_Bala_EndStun)
set ulquiorraStunTimer=null
endfunction
function ULQ_D_Bala_RemoveImpact takes nothing returns nothing
local timer ulquiorraImpactTimer=GetExpiredTimer()
local integer ulquiorraImpactKey=GetHandleId(ulquiorraImpactTimer)
local unit ulquiorraImpactVisual=LoadUnitHandle(ULQ_HashTable,ulquiorraImpactKey,0)
if ulquiorraImpactVisual!=null then
call RemoveUnit(ulquiorraImpactVisual)
endif
call FlushChildHashtable(ULQ_HashTable,ulquiorraImpactKey)
call DestroyTimer(ulquiorraImpactTimer)
set ulquiorraImpactVisual=null
set ulquiorraImpactTimer=null
endfunction
function ULQ_D_Bala_Impact takes unit ulquiorraCaster,real ulquiorraImpactX,real ulquiorraImpactY returns nothing
local integer ulquiorraLevel=GetUnitAbilityLevel(ulquiorraCaster,'ZZ03')
local real ulquiorraDamage
local group ulquiorraTargets=CreateGroup()
local unit ulquiorraVictim
local unit ulquiorraImpactVisual
local timer ulquiorraImpactTimer
if ulquiorraLevel<1 then
set ulquiorraLevel=1
endif
set ulquiorraDamage=(50.+50.*ulquiorraLevel+0.2*GetHeroAgi(ulquiorraCaster,true)+0.3*GetHeroInt(ulquiorraCaster,true))/3.
call GroupEnumUnitsInRange(ulquiorraTargets,ulquiorraImpactX,ulquiorraImpactY,225.,null)
loop
set ulquiorraVictim=FirstOfGroup(ulquiorraTargets)
exitwhen ulquiorraVictim==null
call GroupRemoveUnit(ulquiorraTargets,ulquiorraVictim)
if IsUnitEnemy(ulquiorraVictim,GetOwningPlayer(ulquiorraCaster)) and GetWidgetLife(ulquiorraVictim)>.405 and not IsUnitType(ulquiorraVictim,UNIT_TYPE_STRUCTURE) and not ULQ_IsUnitInvulnerable2(ulquiorraVictim) then
call BvOHeroSpellDamage(ulquiorraCaster,ulquiorraVictim,ulquiorraDamage,true,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC)
if GetWidgetLife(ulquiorraVictim)>.405 then
call ULQ_D_Bala_ApplyStun(ulquiorraVictim)
endif
endif
endloop
call DestroyGroup(ulquiorraTargets)
set ulquiorraImpactVisual=CreateUnit(GetOwningPlayer(ulquiorraCaster),'m004',ulquiorraImpactX,ulquiorraImpactY,0.)
call SetUnitPathing(ulquiorraImpactVisual,false)
call SetUnitScale(ulquiorraImpactVisual,1.5,1.5,1.5)
set ulquiorraImpactTimer=CreateTimer()
call SaveUnitHandle(ULQ_HashTable,GetHandleId(ulquiorraImpactTimer),0,ulquiorraImpactVisual)
call TimerStart(ulquiorraImpactTimer,.45,false,function ULQ_D_Bala_RemoveImpact)
set ulquiorraTargets=null
set ulquiorraVictim=null
set ulquiorraImpactVisual=null
set ulquiorraImpactTimer=null
endfunction
function ULQ_D_Bala_ProjectileTick takes nothing returns nothing
local timer ulquiorraProjectileTimer=GetExpiredTimer()
local integer ulquiorraProjectileKey=GetHandleId(ulquiorraProjectileTimer)
local unit ulquiorraCaster=LoadUnitHandle(ULQ_HashTable,ulquiorraProjectileKey,0)
local unit ulquiorraTarget=LoadUnitHandle(ULQ_HashTable,ulquiorraProjectileKey,1)
local unit ulquiorraProjectile=LoadUnitHandle(ULQ_HashTable,ulquiorraProjectileKey,2)
local effect ulquiorraTrail=LoadEffectHandle(ULQ_HashTable,ulquiorraProjectileKey,3)
local integer ulquiorraTicks=LoadInteger(ULQ_HashTable,ulquiorraProjectileKey,4)+1
local real ulquiorraTargetX
local real ulquiorraTargetY
local real ulquiorraSeparation
local real ulquiorraAngle
if ulquiorraProjectile!=null and ulquiorraCaster!=null and ulquiorraTarget!=null and GetWidgetLife(ulquiorraTarget)>.405 and ulquiorraTicks<=60 then
set ulquiorraTargetX=GetUnitX(ulquiorraTarget)
set ulquiorraTargetY=GetUnitY(ulquiorraTarget)
set ulquiorraSeparation=SquareRoot((ulquiorraTargetX-GetUnitX(ulquiorraProjectile))*(ulquiorraTargetX-GetUnitX(ulquiorraProjectile))+(ulquiorraTargetY-GetUnitY(ulquiorraProjectile))*(ulquiorraTargetY-GetUnitY(ulquiorraProjectile)))
if ulquiorraSeparation>30. then
set ulquiorraAngle=Atan2(ulquiorraTargetY-GetUnitY(ulquiorraProjectile),ulquiorraTargetX-GetUnitX(ulquiorraProjectile))
call SetUnitFacing(ulquiorraProjectile,ulquiorraAngle*bj_RADTODEG)
call SetUnitX(ulquiorraProjectile,GetUnitX(ulquiorraProjectile)+45.*Cos(ulquiorraAngle))
call SetUnitY(ulquiorraProjectile,GetUnitY(ulquiorraProjectile)+45.*Sin(ulquiorraAngle))
call SaveInteger(ULQ_HashTable,ulquiorraProjectileKey,4,ulquiorraTicks)
set ulquiorraTrail=null
set ulquiorraCaster=null
set ulquiorraTarget=null
set ulquiorraProjectile=null
set ulquiorraProjectileTimer=null
return
endif
call ULQ_D_Bala_Impact(ulquiorraCaster,ulquiorraTargetX,ulquiorraTargetY)
endif
if ulquiorraTrail!=null then
call DestroyEffect(ulquiorraTrail)
endif
if ulquiorraProjectile!=null then
call RemoveUnit(ulquiorraProjectile)
endif
call FlushChildHashtable(ULQ_HashTable,ulquiorraProjectileKey)
call DestroyTimer(ulquiorraProjectileTimer)
set ulquiorraTrail=null
set ulquiorraCaster=null
set ulquiorraTarget=null
set ulquiorraProjectile=null
set ulquiorraProjectileTimer=null
endfunction
function ULQ_D_Bala_Launch takes unit ulquiorraCaster,unit ulquiorraTarget returns nothing
local real ulquiorraAngle=Atan2(GetUnitY(ulquiorraTarget)-GetUnitY(ulquiorraCaster),GetUnitX(ulquiorraTarget)-GetUnitX(ulquiorraCaster))
local real ulquiorraLaunchX=GetUnitX(ulquiorraCaster)+80.*Cos(ulquiorraAngle)
local real ulquiorraLaunchY=GetUnitY(ulquiorraCaster)+80.*Sin(ulquiorraAngle)
local unit ulquiorraProjectile=CreateUnit(GetOwningPlayer(ulquiorraCaster),'m002',ulquiorraLaunchX,ulquiorraLaunchY,ulquiorraAngle*bj_RADTODEG)
local effect ulquiorraTrail
local timer ulquiorraProjectileTimer=CreateTimer()
local integer ulquiorraProjectileKey=GetHandleId(ulquiorraProjectileTimer)
call SetUnitPathing(ulquiorraProjectile,false)
call SetUnitScale(ulquiorraProjectile,.65,.65,.65)
set ulquiorraTrail=AddSpecialEffectTarget("red-shandian-wave.mdx",ulquiorraProjectile,"origin")
call SaveUnitHandle(ULQ_HashTable,ulquiorraProjectileKey,0,ulquiorraCaster)
call SaveUnitHandle(ULQ_HashTable,ulquiorraProjectileKey,1,ulquiorraTarget)
call SaveUnitHandle(ULQ_HashTable,ulquiorraProjectileKey,2,ulquiorraProjectile)
call SaveEffectHandle(ULQ_HashTable,ulquiorraProjectileKey,3,ulquiorraTrail)
call SaveInteger(ULQ_HashTable,ulquiorraProjectileKey,4,0)
call TimerStart(ulquiorraProjectileTimer,.03,true,function ULQ_D_Bala_ProjectileTick)
set ulquiorraTrail=null
set ulquiorraProjectile=null
set ulquiorraProjectileTimer=null
endfunction
function ULQ_D_Bala_SeriesTick takes nothing returns nothing
local timer ulquiorraSeriesTimer=GetExpiredTimer()
local integer ulquiorraSeriesKey=GetHandleId(ulquiorraSeriesTimer)
local unit ulquiorraCaster=LoadUnitHandle(ULQ_HashTable,ulquiorraSeriesKey,0)
local unit ulquiorraTarget=LoadUnitHandle(ULQ_HashTable,ulquiorraSeriesKey,1)
local integer ulquiorraSeriesTick=LoadInteger(ULQ_HashTable,ulquiorraSeriesKey,2)+1
if ulquiorraCaster!=null and ulquiorraTarget!=null and GetWidgetLife(ulquiorraCaster)>.405 and GetWidgetLife(ulquiorraTarget)>.405 and ulquiorraSeriesTick<=36 then
if ulquiorraSeriesTick==4 or ulquiorraSeriesTick==20 or ulquiorraSeriesTick==36 then
call SetUnitFacing(ulquiorraCaster,Atan2(GetUnitY(ulquiorraTarget)-GetUnitY(ulquiorraCaster),GetUnitX(ulquiorraTarget)-GetUnitX(ulquiorraCaster))*bj_RADTODEG)
call SetUnitAnimationByIndex(ulquiorraCaster,5)
call ULQ_D_Bala_Launch(ulquiorraCaster,ulquiorraTarget)
endif
if ulquiorraSeriesTick<36 then
call SaveInteger(ULQ_HashTable,ulquiorraSeriesKey,2,ulquiorraSeriesTick)
set ulquiorraCaster=null
set ulquiorraTarget=null
set ulquiorraSeriesTimer=null
return
endif
endif
call FlushChildHashtable(ULQ_HashTable,ulquiorraSeriesKey)
call DestroyTimer(ulquiorraSeriesTimer)
set ulquiorraCaster=null
set ulquiorraTarget=null
set ulquiorraSeriesTimer=null
endfunction
function ULQ_UlquiorraNormalD_Start takes unit ulquiorraCaster,unit ulquiorraTarget returns nothing
local timer ulquiorraSeriesTimer
if ulquiorraTarget==null or GetWidgetLife(ulquiorraTarget)<=.405 then
return
endif
call ULQ_PlaySoundOnUnit(ULQ_D_Bala_Sound,100,ulquiorraCaster)
set ulquiorraSeriesTimer=CreateTimer()
call SaveUnitHandle(ULQ_HashTable,GetHandleId(ulquiorraSeriesTimer),0,ulquiorraCaster)
call SaveUnitHandle(ULQ_HashTable,GetHandleId(ulquiorraSeriesTimer),1,ulquiorraTarget)
call SaveInteger(ULQ_HashTable,GetHandleId(ulquiorraSeriesTimer),2,0)
call TimerStart(ulquiorraSeriesTimer,.03,true,function ULQ_D_Bala_SeriesTick)
set ulquiorraSeriesTimer=null
endfunction
function ULQ_EnableResurreccionSkills takes unit ulquiorraHero returns nothing
local integer ulquiorraHeroKey=GetHandleId(ulquiorraHero)
if LoadUnitHandle(ULQ_HashTable,ulquiorraHeroKey,9102)==null then
call SaveUnitHandle(ULQ_HashTable,ulquiorraHeroKey,9102,CreateUnit(GetOwningPlayer(ulquiorraHero),'j001',1.,1.,0.))
endif
if GetUnitAbilityLevel(ulquiorraHero,'ZS02')>0 then
endif
endfunction
function ULQ_DisableResurreccionSkills takes integer ulquiorraHeroKey returns nothing
local unit resurreccionMarker=LoadUnitHandle(ULQ_HashTable,ulquiorraHeroKey,9102)
if resurreccionMarker!=null then
call RemoveUnit(resurreccionMarker)
call RemoveSavedHandle(ULQ_HashTable,ulquiorraHeroKey,9102)
endif
set resurreccionMarker=null
endfunction
function ULQ_EndResurreccion takes unit ulquiorraHero returns nothing
if GetUnitAbilityLevel(ulquiorraHero,'ZZ04')<4 then
call SetHeroAgi(ulquiorraHero,GetHeroAgi(ulquiorraHero,false)-15,false)
else
call SetHeroAgi(ulquiorraHero,GetHeroAgi(ulquiorraHero,false)-25,false)
endif
call SetUnitAbilityLevel(ulquiorraHero,'ZZ01',1)
call SaveBoolean(ULQ_HashTable,GetHandleId(ulquiorraHero),9101,false)
call ULQ_DisableResurreccionSkills(GetHandleId(ulquiorraHero))
endfunction
function ULQ_StopResurreccionWatch takes timer formWatchTimer returns nothing
call PauseTimer(formWatchTimer)
call FlushChildHashtable(ULQ_HashTable,GetHandleId(formWatchTimer))
call DestroyTimer(formWatchTimer)
endfunction
function ULQ_ResurreccionWatchTick takes nothing returns nothing
local timer formWatchTimer=GetExpiredTimer()
local integer formWatchKey=GetHandleId(formWatchTimer)
local unit ulquiorraHero=LoadUnitHandle(ULQ_HashTable,formWatchKey,0)
local integer ulquiorraHeroKey=LoadInteger(ULQ_HashTable,formWatchKey,1)
local integer heroForm=GetUnitTypeId(ulquiorraHero)
local real elapsedSeconds=LoadReal(ULQ_HashTable,formWatchKey,3)+.1
call SaveReal(ULQ_HashTable,formWatchKey,3,elapsedSeconds)
if heroForm==0 then
call ULQ_DisableResurreccionSkills(ulquiorraHeroKey)
call RemoveSavedBoolean(ULQ_HashTable,ulquiorraHeroKey,9101)
call RemoveSavedHandle(ULQ_HashTable,ulquiorraHeroKey,9103)
call ULQ_StopResurreccionWatch(formWatchTimer)
elseif not LoadBoolean(ULQ_HashTable,ulquiorraHeroKey,9101) or LoadTimerHandle(ULQ_HashTable,ulquiorraHeroKey,9103)!=formWatchTimer then
if LoadTimerHandle(ULQ_HashTable,ulquiorraHeroKey,9103)==formWatchTimer then
call RemoveSavedHandle(ULQ_HashTable,ulquiorraHeroKey,9103)
endif
call ULQ_StopResurreccionWatch(formWatchTimer)
elseif heroForm=='US1_' or heroForm=='US2_' then
call SaveBoolean(ULQ_HashTable,formWatchKey,2,true)
elseif LoadBoolean(ULQ_HashTable,formWatchKey,2) or elapsedSeconds>=3. then
call ULQ_EndResurreccion(ulquiorraHero)
call RemoveSavedHandle(ULQ_HashTable,ulquiorraHeroKey,9103)
call ULQ_StopResurreccionWatch(formWatchTimer)
endif
set formWatchTimer=null
set ulquiorraHero=null
endfunction
function ULQ_StartResurreccionWatch takes unit ulquiorraHero returns nothing
local timer formWatchTimer=LoadTimerHandle(ULQ_HashTable,GetHandleId(ulquiorraHero),9103)
if formWatchTimer!=null then
call ULQ_StopResurreccionWatch(formWatchTimer)
endif
set formWatchTimer=CreateTimer()
call SaveTimerHandle(ULQ_HashTable,GetHandleId(ulquiorraHero),9103,formWatchTimer)
call SaveUnitHandle(ULQ_HashTable,GetHandleId(formWatchTimer),0,ulquiorraHero)
call SaveInteger(ULQ_HashTable,GetHandleId(formWatchTimer),1,GetHandleId(ulquiorraHero))
call SaveBoolean(ULQ_HashTable,GetHandleId(formWatchTimer),2,false)
call SaveReal(ULQ_HashTable,GetHandleId(formWatchTimer),3,0.)
call TimerStart(formWatchTimer,.1,true,function ULQ_ResurreccionWatchTick)
set formWatchTimer=null
endfunction
function ULQ_UlquiorraCast_Conditions takes nothing returns boolean
local real cjlocgn_00000000
if not SilenceConditions(GetSpellAbilityUnit()) then
return false
endif
if GetSpellAbilityId()==0x5A5A3030 then
call ULQ_UlquiorraNormalQ_Start(GetSpellAbilityUnit(),GetSpellTargetX(),GetSpellTargetY())
endif
if GetSpellAbilityId()==0x5A5A3032 then
call ULQ_UlquiorraNormalW_Start(GetSpellAbilityUnit())
endif
if GetSpellAbilityId()==0x5A5A3033 then
call ULQ_UlquiorraNormalD_Start(GetSpellAbilityUnit(),GetSpellTargetUnit())
endif
if (GetSpellAbilityId()==0x5A5A3035 or GetSpellAbilityId()=='ZB05') and (GetUnitTypeId(GetSpellAbilityUnit())=='US1_' or GetUnitTypeId(GetSpellAbilityUnit())=='US2_') then
call ULQ_UlquiorraNormalR_Start(GetSpellAbilityUnit(),GetSpellTargetX(),GetSpellTargetY())
endif
if GetSpellAbilityId()==0x5A5A3034 then
if not LoadBoolean(ULQ_HashTable,GetHandleId(GetSpellAbilityUnit()),9101) then
if GetUnitAbilityLevel(GetSpellAbilityUnit(),0x5A5A3034)<4 then
call SetHeroAgi(GetSpellAbilityUnit(),GetHeroAgi(GetSpellAbilityUnit(),false)+15,false)
else
call SetHeroAgi(GetSpellAbilityUnit(),GetHeroAgi(GetSpellAbilityUnit(),false)+25,false)
endif
call SaveBoolean(ULQ_HashTable,GetHandleId(GetSpellAbilityUnit()),9101,true)
call ULQ_EnableResurreccionSkills(GetSpellAbilityUnit())
call ULQ_StartResurreccionWatch(GetSpellAbilityUnit())
else
call ULQ_EndResurreccion(GetSpellAbilityUnit())
endif
endif
if (GetSpellAbilityId()==0x5A5A3036 or GetSpellAbilityId()=='ZB06') and (GetUnitTypeId(GetSpellAbilityUnit())=='US1_' or GetUnitTypeId(GetSpellAbilityUnit())=='US2_') then
call ULQ_UlquiorraNormalT_Start(GetSpellAbilityUnit())
endif
if GetSpellAbilityId()==0x5A5A3037 and GetUnitAbilityLevel(GetSpellAbilityUnit(),'ZZ07')<6 and (GetUnitTypeId(GetSpellAbilityUnit())=='US1_' or GetUnitTypeId(GetSpellAbilityUnit())=='US2_') then
call ULQ_UlquiorraNormalT1_Start(GetSpellAbilityUnit(),GetSpellTargetX(),GetSpellTargetY())
endif
if GetSpellAbilityId()==0x5A5A3034 and GetUnitTypeId(GetSpellAbilityUnit())==0x55533030 then
set cjlocgn_00000000=GetUnitState(GetSpellAbilityUnit(),UNIT_STATE_MAX_LIFE)*0.1
call SetUnitAbilityLevel(GetSpellAbilityUnit(),0x5A5A3031,2)
if GetUnitAbilityLevel(GetSpellAbilityUnit(),0x5A5A3034)>3 then
set cjlocgn_00000000=cjlocgn_00000000+(GetUnitState(GetSpellAbilityUnit(),UNIT_STATE_MAX_LIFE)*0.05)
call SetUnitAbilityLevel(GetSpellAbilityUnit(),0x5A5A3031,3)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetSpellAbilityUnit()),0x6D303139,GetUnitX(GetSpellAbilityUnit()),GetUnitY(GetSpellAbilityUnit()),0)
call SetUnitTimeScale(bj_lastCreatedUnit,0.45)
call ULQ_MUTU(GetSpellAbilityUnit(),2.35,bj_lastCreatedUnit)
call SaveInteger(ULQ_HashTable,-12006,0,0)
loop
exitwhen LoadInteger(ULQ_HashTable,-12006,0)==6
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetSpellAbilityUnit()),0x6D303139,GetUnitX(GetSpellAbilityUnit())+180*Cos(60*LoadInteger(ULQ_HashTable,-12006,0)*bj_DEGTORAD),GetUnitY(GetSpellAbilityUnit())+180*Sin(60*LoadInteger(ULQ_HashTable,-12006,0)*bj_DEGTORAD),0)
call SetUnitTimeScale(bj_lastCreatedUnit,1.45)
call SetUnitScale(bj_lastCreatedUnit,1.8,1.8,1.8)
call ULQ_MyRemoveUnit(bj_lastCreatedUnit,1.75)
call SaveInteger(ULQ_HashTable,-12006,0,LoadInteger(ULQ_HashTable,-12006,0)+1)
endloop
call SaveInteger(ULQ_HashTable,-12006,0,0)

if GetRandomInt(0,1)==0 then
call ULQ_PlayRandomVoice(GetSpellAbilityUnit(),180,180)
else
call ULQ_PlayRandomVoice(GetSpellAbilityUnit(),193,193)
endif
else
call ULQ_PlaySoundOnUnit(LoadSoundHandle(ULQ_HashTable,-12002,179),100,GetSpellAbilityUnit())
endif
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetSpellAbilityUnit()),0x6D303038,GetUnitX(GetSpellAbilityUnit()),GetUnitY(GetSpellAbilityUnit()),0)
call SetUnitTimeScale(bj_lastCreatedUnit,5.55)
call ULQ_MUTU(GetSpellAbilityUnit(),8,bj_lastCreatedUnit)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetSpellAbilityUnit()),0x6D303036,GetUnitX(GetSpellAbilityUnit()),GetUnitY(GetSpellAbilityUnit()),0)
call SetUnitTimeScale(bj_lastCreatedUnit,3.55)
call SetUnitVertexColor(bj_lastCreatedUnit,255,255,255,115)
call ULQ_MyRemoveUnit(bj_lastCreatedUnit,5)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetSpellAbilityUnit()),0x6D303037,GetUnitX(GetSpellAbilityUnit()),GetUnitY(GetSpellAbilityUnit()),0)
call SetUnitTimeScale(bj_lastCreatedUnit,3.55)
call SetUnitVertexColor(bj_lastCreatedUnit,255,255,255,115)
call ULQ_MyRemoveUnit(bj_lastCreatedUnit,5)
if GetUnitState(GetSpellAbilityUnit(),UNIT_STATE_LIFE)>(GetUnitState(GetSpellAbilityUnit(),UNIT_STATE_MAX_LIFE)*0.3)then
call ULQ_SetHpCurrent(GetSpellAbilityUnit(),cjlocgn_00000000)
endif
set bj_lastCreatedGroup=CreateGroup()
call GroupEnumUnitsInRange(bj_lastCreatedGroup,GetUnitX(GetSpellAbilityUnit()),GetUnitY(GetSpellAbilityUnit()),605,Condition(function ULQ_NoDecor_Filter))
loop
call SaveUnitHandle(ULQ_HashTable,-12004,0,FirstOfGroup(bj_lastCreatedGroup))
exitwhen LoadUnitHandle(ULQ_HashTable,-12004,0)==null
if ULQ_IsUnitInvulnerable2(LoadUnitHandle(ULQ_HashTable,-12004,0))==false and IsUnitEnemy(LoadUnitHandle(ULQ_HashTable,-12004,0),GetOwningPlayer(GetSpellAbilityUnit()))==true and GetWidgetLife(LoadUnitHandle(ULQ_HashTable,-12004,0))>0.405 then
if GetUnitAbilityLevel(GetSpellAbilityUnit(),0x5A5A3034)>3 then
call DamageUnit(GetSpellAbilityUnit(),LoadUnitHandle(ULQ_HashTable,-12004,0),200.+GetHeroAgi(GetSpellAbilityUnit(),true),CLEAN,SPELL)
else
call DamageUnit(GetSpellAbilityUnit(),LoadUnitHandle(ULQ_HashTable,-12004,0),100.+.5*GetHeroAgi(GetSpellAbilityUnit(),true),CLEAN,SPELL)
endif
call ULQ_LinearDisplacement(LoadUnitHandle(ULQ_HashTable,-12004,0),ULQ_GetUnitsAngle(GetSpellAbilityUnit(),LoadUnitHandle(ULQ_HashTable,-12004,0)),300,.2,.01,false,false,"origin","Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
endif
call GroupRemoveUnit(bj_lastCreatedGroup,LoadUnitHandle(ULQ_HashTable,-12004,0))
endloop
call SaveUnitHandle(ULQ_HashTable,-12004,0,null)
call GroupClear(bj_lastCreatedGroup)
call DestroyGroup(bj_lastCreatedGroup)
endif
return false
endfunction
function ULQ_PlaySelectionVoice takes unit ulquiorraSelectedHero returns nothing
if ulquiorraSelectedHero!=null and GetUnitTypeId(ulquiorraSelectedHero)=='US00' and GetPlayerId(GetOwningPlayer(ulquiorraSelectedHero))<11 and not LoadBoolean(ULQ_HashTable,GetHandleId(ulquiorraSelectedHero),9300) then
call SaveBoolean(ULQ_HashTable,GetHandleId(ulquiorraSelectedHero),9300,true)
call ULQ_PlayRandomVoice(ulquiorraSelectedHero,176,176)
endif
endfunction
function ULQ_OnHeroSold takes nothing returns nothing
call ULQ_PlaySelectionVoice(GetSoldUnit())
call ULQ_TrackBookHero(GetSoldUnit())
endfunction
function ULQ_OnHeroEntersMap takes nothing returns nothing
call ULQ_PlaySelectionVoice(GetEnteringUnit())
call ULQ_TrackBookHero(GetEnteringUnit())
endfunction
function ULQ_OnDeath takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer id=GetUnitTypeId(u)
if id=='US00' or id=='US1_' or id=='US2_' then
call ULQ_PlayRandomVoice(u,178,178)
endif
if (id=='US00' or id=='US1_' or id=='US2_') and LoadBoolean(ULQ_HashTable,GetHandleId(u),9101) then
call ULQ_EndResurreccion(u)
endif
set u=null
endfunction
