function RBHeroPick takes group rbLocal23_pool returns group
local group rbLocal23_copy=CreateGroup()
local group rbLocal23_heroes=CreateGroup()
local group rbLocal23_result=CreateGroup()
local unit rbLocal23_u
call GroupAddGroup(rbLocal23_pool,rbLocal23_copy)
loop
set rbLocal23_u=FirstOfGroup(rbLocal23_copy)
exitwhen rbLocal23_u==null
call GroupRemoveUnit(rbLocal23_copy,rbLocal23_u)
if IsUnitType(rbLocal23_u,UNIT_TYPE_HERO) then
call GroupAddUnit(rbLocal23_heroes,rbLocal23_u)
endif
endloop
set rbLocal23_u=GroupPickRandomUnit(rbLocal23_heroes)
if rbLocal23_u==null then
set rbLocal23_u=GroupPickRandomUnit(rbLocal23_pool)
endif
if rbLocal23_u!=null then
call GroupAddUnit(rbLocal23_result,rbLocal23_u)
endif
call DestroyGroup(rbLocal23_copy)
call DestroyGroup(rbLocal23_heroes)
set rbLocal23_u=null
set rbLocal23_copy=null
set rbLocal23_heroes=null
return rbLocal23_result
endfunction
