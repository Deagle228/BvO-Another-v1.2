call SaveUnitHandle(Hash,GetHandleId(castTimer),3,victim)
call SaveEffectHandle(Hash,GetHandleId(castTimer),4,AddSpecialEffectTarget("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile_mini.mdl",caster,"weapon"))
call SaveInteger(Hash,GetHandleId(castTimer),5,LoadInteger(Hash,GetHandleId(caster),StringHash("BvORevivalGeneration")))
set l[1+GetPlayerId(GetOwningPlayer(caster))]=true
call ResetUnitAnimation(caster)
call SetUnitTimeScale(caster,1.)
call PlaySoundAtPointBJ(Up,100,soundPoint,0)
call RemoveLocation(soundPoint)
set soundPoint=null
call TimerStart(castTimer,.01,false,function YamamotoETick)
set caster=null
set victim=null
set castTimer=null
endfunction
