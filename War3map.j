function BvOIkkakuBankai takes unit hero returns boolean
local integer ikkakuFormType=GetUnitTypeId(hero)
return ikkakuFormType=='U00T' or ikkakuFormType=='U005' or ikkakuFormType=='U006' or ikkakuFormType=='U007' or ikkakuFormType=='U008'
endfunction
function IkkakuRStrApply takes unit ikrHero,integer ikrCount returns nothing
local integer ikrBit=0
local integer ikrValue=ikrCount/4
loop
exitwhen ikrBit>5
if ModuloInteger(ikrValue,2)==1 then
if GetUnitAbilityLevel(ikrHero,'XS00'+ikrBit)==0 then
call UnitAddAbility(ikrHero,'XS00'+ikrBit)
call UnitMakeAbilityPermanent(ikrHero,true,'XS00'+ikrBit)
endif
elseif GetUnitAbilityLevel(ikrHero,'XS00'+ikrBit)>0 then
call UnitRemoveAbility(ikrHero,'XS00'+ikrBit)
endif
set ikrValue=ikrValue/2
set ikrBit=ikrBit+1
endloop
endfunction
function BvOIkkakuREnd takes unit hero returns nothing
local integer key=GetHandleId(hero)
local integer accumulated=LoadInteger(RBState,key,124)
call IkkakuRStrApply(hero,0)
call SaveInteger(RBState,key,124,0)
call SaveInteger(RBState,key,125,0)
call SaveReal(RBState,key,122,0.)
call SaveReal(RBState,key,123,0.)
call SaveBoolean(RBState,key,StringHash("IkkakuRBankai"),false)
call DestroyEffect(LoadEffectHandle(RBState,key,215))
call DestroyEffect(LoadEffectHandle(RBState,key,216))
call RemoveSavedHandle(RBState,key,215)
call RemoveSavedHandle(RBState,key,216)
call SaveBoolean(RBState,key,217,false)
endfunction
function BvOIkkakuQSync takes unit hero returns nothing
local integer wanted=GetUnitAbilityLevel(hero,'IQL0')
if wanted>0 then
if BvOIkkakuBankai(hero) then
set wanted=wanted+6
endif
if GetUnitAbilityLevel(hero,'A091')==0 then
call UnitAddAbility(hero,'A091')
call UnitMakeAbilityPermanent(hero,true,'A091')
endif
if GetUnitAbilityLevel(hero,'A091')!=wanted then
call SetUnitAbilityLevel(hero,'A091',wanted)
endif
endif
endfunction
