function InoeW_Actions takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit target=null
local real blockAmount=(RBValue(GetUnitAbilityLevel(caster,'A0EH'),50.0,75.0,100.0,125.0,150.0,150.0)+5.0*GetHeroInt(caster,false)+10.0*GetHeroStr(caster,true))
local group targetGroup=CreateGroup()
local unit enumUnit
call GroupEnumUnitsInRange(targetGroup,GetSpellTargetX(),GetSpellTargetY(),175,null)
loop
set enumUnit=FirstOfGroup(targetGroup)
exitwhen enumUnit==null or target!=null
if GetWidgetLife(enumUnit)>.405 and not IsUnitType(enumUnit,UNIT_TYPE_STRUCTURE) and IsUnitAlly(enumUnit,GetOwningPlayer(caster)) and IsUnitType(enumUnit,UNIT_TYPE_HERO) then
set target=enumUnit
endif
call GroupRemoveUnit(targetGroup,enumUnit)
endloop
if target!=null then
call CastToTarget(caster,target,$41304447,GetUnitAbilityLevel(caster,'A0EH'),"innerfire")
call SaveReal(Hash,GetHandleId(target),StringHash("InoeW_Shield"),blockAmount)
else
if GetOwningPlayer(caster)==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00Valid target not found!|r")
endif
endif
set caster=null
set target=null
set enumUnit=null
endfunction
