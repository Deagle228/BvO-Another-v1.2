local timer renjiWatchTimer=GetExpiredTimer()
local unit renjiWatchCaster=LoadUnitHandle(RBState,GetHandleId(renjiWatchTimer),0)
local unit renjiWatchTarget=LoadUnitHandle(RBState,GetHandleId(renjiWatchTimer),1)
if LoadInteger(RBState,GetHandleId(renjiWatchCaster),7302)==GetHandleId(renjiWatchTimer) and LoadBoolean(RBState,GetHandleId(renjiWatchCaster),191) then
call SaveBoolean(RBState,GetHandleId(renjiWatchCaster),191,false)
call DisableTrigger(SB)
call DisableTrigger(TB)
call PauseUnit(renjiWatchCaster,false)
call SetUnitTimeScalePercent(renjiWatchCaster,100.)
call SetUnitInvulnerable(renjiWatchCaster,false)
call PauseUnit(renjiWatchTarget,false)
call SetUnitPathing(renjiWatchTarget,true)
call SetUnitInvulnerable(renjiWatchTarget,false)
set l[1+GetPlayerId(GetOwningPlayer(renjiWatchCaster))]=false
set l[1+GetPlayerId(GetOwningPlayer(renjiWatchTarget))]=false
endif
call FlushChildHashtable(RBState,GetHandleId(renjiWatchTimer))
call DestroyTimer(renjiWatchTimer)
set renjiWatchTimer=null
set renjiWatchCaster=null
set renjiWatchTarget=null
endfunction
