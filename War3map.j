function BvOSlotState takes player bvoSlotPlayer returns playerslotstate
if IsPlayerObserver(bvoSlotPlayer) or GetPlayerId(bvoSlotPlayer)==5 or GetPlayerId(bvoSlotPlayer)==11 then
return PLAYER_SLOT_STATE_EMPTY
endif
return GetPlayerSlotState(bvoSlotPlayer)
endfunction

function BvOSusanoType takes integer unitType returns boolean
return unitType=='O005' or unitType=='SR02' or unitType=='SR03' or unitType=='SR04' or unitType=='SR05'
endfunction

function BvOHasDarknessShield takes unit holder returns boolean
return UnitHasItemOfTypeBJ(holder,'I007') or UnitHasItemOfTypeBJ(holder,'I01T')
endfunction
function PNChibakuIsHeld takes unit heldUnit returns boolean
return heldUnit!=null and PNHash!=null and LoadInteger(PNHash,GetHandleId(heldUnit),7001)>0
endfunction
// Only explicitly registered temporary visual/cast units enter this cleanup group.
// A native timed life kills a unit; this later pass also releases its effect handle and removes the corpse.
function BvOVfxCleanupOne takes nothing returns nothing
local unit visualUnit=GetEnumUnit()
local integer visualKey=GetHandleId(visualUnit)
local effect visualEffect
if GetUnitTypeId(visualUnit)==0 or TimerGetElapsed(AYClock)>=LoadReal(BvOVfxHash,visualKey,0) then
set visualEffect=LoadEffectHandle(BvOVfxHash,visualKey,1)
call GroupRemoveUnit(BvOVfxUnits,visualUnit)
call FlushChildHashtable(BvOVfxHash,visualKey)
call DestroyEffect(visualEffect)
call RemoveUnit(visualUnit)
set visualEffect=null
endif
set visualUnit=null
endfunction
function BvOVfxCleanupTick takes nothing returns nothing
call ForGroup(BvOVfxUnits,function BvOVfxCleanupOne)
if FirstOfGroup(BvOVfxUnits)==null then
call PauseTimer(BvOVfxCleanupTimer)
endif
endfunction
function BvOVfxExpire takes unit visualUnit,effect visualEffect,real visualLife returns nothing
local integer visualKey=GetHandleId(visualUnit)
if visualUnit==null then
call DestroyEffect(visualEffect)
return
endif
if FirstOfGroup(BvOVfxUnits)==null then
call TimerStart(BvOVfxCleanupTimer,.05,true,function BvOVfxCleanupTick)
endif
call GroupAddUnit(BvOVfxUnits,visualUnit)
call SaveReal(BvOVfxHash,visualKey,0,TimerGetElapsed(AYClock)+visualLife)
if visualEffect!=null then
call SaveEffectHandle(BvOVfxHash,visualKey,1,visualEffect)
endif
endfunction
// Soul-devourer Stones levels 1-5: I01K, ISD2, ISD3, ISD4, ISD5 (Soul Wrath A08N, ASW2-ASW5)
function SDLevel takes integer sdItemType returns integer
if sdItemType=='I01K' then
return 1
elseif sdItemType=='ISD2' then
return 2
elseif sdItemType=='ISD3' then
return 3
elseif sdItemType=='ISD4' then
return 4
elseif sdItemType=='ISD5' then
return 5
endif
return 0
endfunction
function SDStoneId takes integer sdLevelValue returns integer
if sdLevelValue==2 then
return 'ISD2'
elseif sdLevelValue==3 then
return 'ISD3'
elseif sdLevelValue==4 then
return 'ISD4'
elseif sdLevelValue==5 then
return 'ISD5'
endif
return 'I01K'
endfunction
function SDAbilLevel takes integer sdAbilityId returns integer
if sdAbilityId=='A08N' then
return 1
elseif sdAbilityId=='ASW2' then
return 2
elseif sdAbilityId=='ASW3' then
return 3
elseif sdAbilityId=='ASW4' then
return 4
elseif sdAbilityId=='ASW5' then
return 5
endif
return 0
endfunction
function SDStone takes unit sdUnit returns item
local integer sdSlot=0
loop
exitwhen sdSlot>5
if SDLevel(GetItemTypeId(UnitItemInSlot(sdUnit,sdSlot)))>0 then
return UnitItemInSlot(sdUnit,sdSlot)
endif
set sdSlot=sdSlot+1
endloop
return null
endfunction
function SDHasStone takes unit sdUnit returns boolean
return SDStone(sdUnit)!=null
endfunction
// the slot of the lowest-level stones that can still be upgraded (-1: none)
function SDUpgradeSlot takes unit sdUnit returns integer
local integer sdSlot=0
local integer sdSlotFound=-1
local integer sdBest=5
local integer sdLvl
loop
exitwhen sdSlot>5
set sdLvl=SDLevel(GetItemTypeId(UnitItemInSlot(sdUnit,sdSlot)))
if sdLvl>0 and sdLvl<sdBest then
set sdBest=sdLvl
set sdSlotFound=sdSlot
endif
set sdSlot=sdSlot+1
endloop
return sdSlotFound
endfunction
function SDUpgradeDeferred takes nothing returns nothing
local timer sdTimer=GetExpiredTimer()
local integer sdKey=GetHandleId(sdTimer)
local unit sdUnit=LoadUnitHandle(SDHash,sdKey,20)
local item sdOld=LoadItemHandle(SDHash,sdKey,21)
local item sdRecipe=LoadItemHandle(SDHash,sdKey,22)
local integer sdSlot=LoadInteger(SDHash,sdKey,23)
local integer sdLevelValue=LoadInteger(SDHash,sdKey,24)
local boolean sdFromPickup=LoadBoolean(SDHash,sdKey,25)
if sdUnit!=null and UnitItemInSlot(sdUnit,sdSlot)==sdOld and SDLevel(GetItemTypeId(sdOld))==sdLevelValue then
if not sdFromPickup or (GetItemTypeId(sdRecipe)=='I025' and UnitHasItem(sdUnit,sdRecipe)) then
if sdFromPickup then
call RemoveItem(sdRecipe)
endif
call RemoveItem(sdOld)
call UnitAddItemToSlotById(sdUnit,SDStoneId(sdLevelValue+1),sdSlot)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",sdUnit,"origin"))
endif
elseif not sdFromPickup and sdUnit!=null then
// A purchased upgrade cannot consume gold without yielding an item.
call UnitAddItemById(sdUnit,'I025')
endif
call RemoveSavedBoolean(SDHash,GetHandleId(sdUnit),26)
call FlushChildHashtable(SDHash,sdKey)
call DestroyTimer(sdTimer)
set sdTimer=null
set sdUnit=null
set sdOld=null
set sdRecipe=null
endfunction
function SDQueueUpgrade takes unit sdUnit,item sdRecipe returns boolean
local integer sdSlot=SDUpgradeSlot(sdUnit)
local timer sdTimer
local integer sdKey
if sdSlot<0 or LoadBoolean(SDHash,GetHandleId(sdUnit),26) then
return false
endif
set sdTimer=CreateTimer()
set sdKey=GetHandleId(sdTimer)
call SaveBoolean(SDHash,GetHandleId(sdUnit),26,true)
call SaveUnitHandle(SDHash,sdKey,20,sdUnit)
call SaveItemHandle(SDHash,sdKey,21,UnitItemInSlot(sdUnit,sdSlot))
call SaveItemHandle(SDHash,sdKey,22,sdRecipe)
call SaveInteger(SDHash,sdKey,23,sdSlot)
call SaveInteger(SDHash,sdKey,24,SDLevel(GetItemTypeId(UnitItemInSlot(sdUnit,sdSlot))))
call SaveBoolean(SDHash,sdKey,25,sdRecipe!=null)
call TimerStart(sdTimer,0.,false,function SDUpgradeDeferred)
set sdTimer=null
return true
endfunction
function RBValue takes integer rbLocal0_level,real rbLocal0_a,real rbLocal0_b,real rbLocal0_c,real rbLocal0_d,real rbLocal0_e,real rbLocal0_f returns real
if rbLocal0_level<=1 then
return rbLocal0_a
elseif rbLocal0_level==2 then
return rbLocal0_b
elseif rbLocal0_level==3 then
return rbLocal0_c
elseif rbLocal0_level==4 then
return rbLocal0_d
elseif rbLocal0_level==5 then
return rbLocal0_e
endif
return rbLocal0_f
endfunction

// Onmitsukido Blade: true while the unit's passive abilities are disabled ("broken")
function BvOPassivesBroken takes unit whichUnit returns boolean
return LoadInteger(OnmitsuHash,GetHandleId(whichUnit),3)>0
endfunction
function S_U takes integer parentKey,string strhash,unit saveu returns nothing
call SaveUnitHandle(Hash,parentKey,StringHash(strhash),saveu)
endfunction
function S_G takes integer parentKey,string strhash,group saveg returns nothing
call SaveGroupHandle(Hash,parentKey,StringHash(strhash),saveg)
endfunction
function S_I takes integer parentKey,string strhash,integer savei returns nothing
call SaveInteger(Hash,parentKey,StringHash(strhash),savei)
endfunction
function S_S takes integer parentKey,string strhash,string saves returns nothing
call SaveStr(Hash,parentKey,StringHash(strhash),saves)
endfunction
function S_R takes integer parentKey,string strhash,real saver returns nothing
call SaveReal(Hash,parentKey,StringHash(strhash),saver)
endfunction
function S_T takes integer parentKey,string strhash,timer savet returns nothing
call SaveTimerHandle(Hash,parentKey,StringHash(strhash),savet)
endfunction
function L_U takes integer parentKey,string strhash returns unit
return LoadUnitHandle(Hash,parentKey,StringHash(strhash))
endfunction
function L_G takes integer parentKey,string strhash returns group
return LoadGroupHandle(Hash,parentKey,StringHash(strhash))
endfunction
function L_I takes integer parentKey,string strhash returns integer
return LoadInteger(Hash,parentKey,StringHash(strhash))
endfunction
function L_S takes integer parentKey,string strhash returns string
return LoadStr(Hash,parentKey,StringHash(strhash))
endfunction
function L_R takes integer parentKey,string strhash returns real
return LoadReal(Hash,parentKey,StringHash(strhash))
endfunction
function L_T takes integer parentKey,string strhash returns timer
return LoadTimerHandle(Hash,parentKey,StringHash(strhash))
endfunction
function InoueTContainsTarget takes unit inoueTarget returns boolean
local integer inoueFieldIndex=1
local integer inoueFieldId
local unit inoueCaster
local real inoueDeltaX
local real inoueDeltaY
if inoueTarget==null or GetWidgetLife(inoueTarget)<=.405 or GetUnitAbilityLevel(inoueTarget,'Aloc')>0 or IsUnitType(inoueTarget,UNIT_TYPE_STRUCTURE) then
return false
endif
loop
exitwhen inoueFieldIndex>InoueTFieldCount
set inoueFieldId=GetHandleId(InoueTFieldTimers[inoueFieldIndex])
set inoueCaster=L_U(inoueFieldId,"caster")
if inoueCaster!=null and IsUnitEnemy(inoueTarget,GetOwningPlayer(inoueCaster)) then
set inoueDeltaX=GetUnitX(inoueTarget)-L_R(inoueFieldId,"fieldX")
set inoueDeltaY=GetUnitY(inoueTarget)-L_R(inoueFieldId,"fieldY")
if inoueDeltaX*inoueDeltaX+inoueDeltaY*inoueDeltaY<=372100. or IsUnitInGroup(inoueTarget,L_G(inoueFieldId,"enemies")) then
set inoueCaster=null
return true
endif
endif
set inoueFieldIndex=inoueFieldIndex+1
endloop
set inoueCaster=null
return false
endfunction
function InoueTWakeSleepingTarget takes unit inoueSleepingTarget returns nothing
if InoueTContainsTarget(inoueSleepingTarget) and (IsUnitType(inoueSleepingTarget,UNIT_TYPE_SLEEPING) or GetUnitAbilityLevel(inoueSleepingTarget,'BUsl')>0 or GetUnitAbilityLevel(inoueSleepingTarget,'BUsp')>0) then
call UnitRemoveAbility(inoueSleepingTarget,'BUsl')
call UnitRemoveAbility(inoueSleepingTarget,'BUsp')
endif
endfunction
function InoueTPreventCast takes nothing returns boolean
local unit inoueCastingTarget=GetTriggerUnit()
if InoueTContainsTarget(inoueCastingTarget) then
call IssueImmediateOrder(inoueCastingTarget,"stop")
endif
set inoueCastingTarget=null
return false
endfunction
function InoueTRestoreAnimation takes unit inoueAnimatedTarget returns nothing
if LoadBoolean(Hash,GetHandleId(inoueAnimatedTarget),StringHash("InoueTFrozeAnimation")) then
call SetUnitTimeScale(inoueAnimatedTarget,1.)
if GetWidgetLife(inoueAnimatedTarget)>.405 and not IsUnitHidden(inoueAnimatedTarget) then
call SetUnitAnimation(inoueAnimatedTarget,"stand")
endif
call RemoveSavedBoolean(Hash,GetHandleId(inoueAnimatedTarget),StringHash("InoueTFrozeAnimation"))
endif
endfunction
function InoueTDisableAttack takes unit inoueControlledTarget returns nothing
if GetUnitAbilityLevel(inoueControlledTarget,'Abun')==0 then
if UnitAddAbility(inoueControlledTarget,'Abun') then
call SaveBoolean(Hash,GetHandleId(inoueControlledTarget),StringHash("InoueTAddedAttackBlock"),true)
endif
endif
if GetWidgetLife(inoueControlledTarget)>.405 and not IsUnitHidden(inoueControlledTarget) then
if not LoadBoolean(Hash,GetHandleId(inoueControlledTarget),StringHash("InoueTLockedFacing")) then
call SaveReal(Hash,GetHandleId(inoueControlledTarget),StringHash("InoueTOriginalTurnSpeed"),GetUnitTurnSpeed(inoueControlledTarget))
call SaveReal(Hash,GetHandleId(inoueControlledTarget),StringHash("InoueTFacing"),GetUnitFacing(inoueControlledTarget))
call SaveBoolean(Hash,GetHandleId(inoueControlledTarget),StringHash("InoueTLockedFacing"),true)
endif
call SetUnitFacingTimed(inoueControlledTarget,LoadReal(Hash,GetHandleId(inoueControlledTarget),StringHash("InoueTFacing")),0.)
call SetUnitTurnSpeed(inoueControlledTarget,0.)
call SetUnitAnimation(inoueControlledTarget,"stand")
call SetUnitTimeScale(inoueControlledTarget,0.)
call SaveBoolean(Hash,GetHandleId(inoueControlledTarget),StringHash("InoueTFrozeAnimation"),true)
endif
endfunction
function InoueTReleaseControl takes unit inoueReleasedTarget returns nothing
if not InoueTContainsTarget(inoueReleasedTarget) then
if LoadBoolean(Hash,GetHandleId(inoueReleasedTarget),StringHash("InoueTLockedFacing")) then
call SetUnitTurnSpeed(inoueReleasedTarget,LoadReal(Hash,GetHandleId(inoueReleasedTarget),StringHash("InoueTOriginalTurnSpeed")))
call RemoveSavedReal(Hash,GetHandleId(inoueReleasedTarget),StringHash("InoueTOriginalTurnSpeed"))
call RemoveSavedReal(Hash,GetHandleId(inoueReleasedTarget),StringHash("InoueTFacing"))
call RemoveSavedBoolean(Hash,GetHandleId(inoueReleasedTarget),StringHash("InoueTLockedFacing"))
endif
call InoueTRestoreAnimation(inoueReleasedTarget)
call UnitRemoveAbility(inoueReleasedTarget,'B02Y')
if LoadBoolean(Hash,GetHandleId(inoueReleasedTarget),StringHash("InoueTAddedAttackBlock")) then
call UnitRemoveAbility(inoueReleasedTarget,'Abun')
call RemoveSavedBoolean(Hash,GetHandleId(inoueReleasedTarget),StringHash("InoueTAddedAttackBlock"))
endif
endif
endfunction
function InoueTPreventOrder takes nothing returns boolean
local unit inoueOrderedTarget=GetTriggerUnit()
if GetIssuedOrderId()!=851972 and InoueTContainsTarget(inoueOrderedTarget) then
call InoueTDisableAttack(inoueOrderedTarget)
call IssueImmediateOrder(inoueOrderedTarget,"stop")
endif
set inoueOrderedTarget=null
return false
endfunction
function InoueTPreventAttack takes nothing returns boolean
local unit inoueAttackingTarget=GetAttacker()
if InoueTContainsTarget(inoueAttackingTarget) then
call InoueTDisableAttack(inoueAttackingTarget)
call IssueImmediateOrder(inoueAttackingTarget,"stop")
endif
set inoueAttackingTarget=null
return false
endfunction
function InoueTCleanupTarget takes nothing returns nothing
local unit inoueCleanupTarget=GetEnumUnit()
if GetUnitTypeId(inoueCleanupTarget)==0 then
call InoueTReleaseControl(inoueCleanupTarget)
call GroupRemoveUnit(InoueTCleanupUnits,inoueCleanupTarget)
elseif GetWidgetLife(inoueCleanupTarget)<=.405 or not InoueTContainsTarget(inoueCleanupTarget) then
if GetWidgetLife(inoueCleanupTarget)<=.405 then
call InoueTRestoreAnimation(inoueCleanupTarget)
endif
call UnitRemoveAbility(inoueCleanupTarget,'B02Y')
call InoueTReleaseControl(inoueCleanupTarget)
if GetWidgetLife(inoueCleanupTarget)>.405 and not InoueTContainsTarget(inoueCleanupTarget) and not IsUnitType(inoueCleanupTarget,UNIT_TYPE_POLYMORPHED) and not IsUnitType(inoueCleanupTarget,UNIT_TYPE_SLEEPING) then
call GroupRemoveUnit(InoueTCleanupUnits,inoueCleanupTarget)
endif
endif
set inoueCleanupTarget=null
endfunction
function InoueTCleanupTick takes nothing returns nothing
call ForGroup(InoueTCleanupUnits,function InoueTCleanupTarget)
endfunction
function InoueTRemoveField takes timer inoueFieldTimer returns nothing
local integer inoueFieldIndex=1
loop
exitwhen inoueFieldIndex>InoueTFieldCount
if InoueTFieldTimers[inoueFieldIndex]==inoueFieldTimer then
set InoueTFieldTimers[inoueFieldIndex]=InoueTFieldTimers[InoueTFieldCount]
set InoueTFieldTimers[InoueTFieldCount]=null
set InoueTFieldCount=InoueTFieldCount-1
return
endif
set inoueFieldIndex=inoueFieldIndex+1
endloop
endfunction
function BvOTrackUltimatePair takes unit ultimateCaster,unit ultimateTarget,string ultimateKey returns nothing
call SaveUnitHandle(Hash,0,StringHash(ultimateKey+"Caster"),ultimateCaster)
call SaveUnitHandle(Hash,0,StringHash(ultimateKey+"Target"),ultimateTarget)
call SaveInteger(Hash,0,StringHash(ultimateKey+"CasterLife"),LoadInteger(Hash,GetHandleId(ultimateCaster),StringHash("BvORevivalGeneration")))
call SaveInteger(Hash,0,StringHash(ultimateKey+"TargetLife"),LoadInteger(Hash,GetHandleId(ultimateTarget),StringHash("BvORevivalGeneration")))
endfunction
function BvOUltimatePairCurrent takes unit ultimateCaster,unit ultimateTarget,string ultimateKey returns boolean
return ultimateCaster!=null and ultimateTarget!=null and ultimateCaster==LoadUnitHandle(Hash,0,StringHash(ultimateKey+"Caster")) and ultimateTarget==LoadUnitHandle(Hash,0,StringHash(ultimateKey+"Target")) and LoadInteger(Hash,GetHandleId(ultimateCaster),StringHash("BvORevivalGeneration"))==LoadInteger(Hash,0,StringHash(ultimateKey+"CasterLife")) and LoadInteger(Hash,GetHandleId(ultimateTarget),StringHash("BvORevivalGeneration"))==LoadInteger(Hash,0,StringHash(ultimateKey+"TargetLife"))
endfunction
function BvOUltimatePairAlive takes unit ultimateCaster,unit ultimateTarget,string ultimateKey returns boolean
return BvOUltimatePairCurrent(ultimateCaster,ultimateTarget,ultimateKey) and GetWidgetLife(ultimateCaster)>.405 and GetWidgetLife(ultimateTarget)>.405
endfunction
function BvOForgetCachedUltimateTarget takes nothing returns nothing
local unit ultimateDyingTarget=GetDyingUnit()
if IsUnitType(ultimateDyingTarget,UNIT_TYPE_HERO) then
if G[4]!=null then
call GroupRemoveUnit(G[4],ultimateDyingTarget)
endif
if mh!=null then
call GroupRemoveUnit(mh,ultimateDyingTarget)
endif
if em!=null then
call GroupRemoveUnit(em,ultimateDyingTarget)
endif
if fm!=null then
call GroupRemoveUnit(fm,ultimateDyingTarget)
endif
endif
set ultimateDyingTarget=null
endfunction
function InoueTForgetTarget takes unit inoueDepartingTarget returns nothing
local integer inoueFieldIndex=1
local integer inoueFieldId
local integer inoueTargetId=GetHandleId(inoueDepartingTarget)
loop
exitwhen inoueFieldIndex>InoueTFieldCount
set inoueFieldId=GetHandleId(InoueTFieldTimers[inoueFieldIndex])
call GroupRemoveUnit(L_G(inoueFieldId,"enemies"),inoueDepartingTarget)
call RemoveSavedReal(Hash,inoueFieldId,StringHash("lockX"+I2S(inoueTargetId)))
call RemoveSavedReal(Hash,inoueFieldId,StringHash("lockY"+I2S(inoueTargetId)))
set inoueFieldIndex=inoueFieldIndex+1
endloop
call GroupRemoveUnit(InoueTCleanupUnits,inoueDepartingTarget)
endfunction
function InoueTOnHeroDeath takes nothing returns nothing
local unit inoueDyingHero=GetDyingUnit()
if IsUnitType(inoueDyingHero,UNIT_TYPE_HERO) and GetUnitAbilityLevel(inoueDyingHero,'A0A9')==0 then
call InoueTForgetTarget(inoueDyingHero)
call InoueTReleaseControl(inoueDyingHero)
endif
set inoueDyingHero=null
endfunction
function BvORenjiRestoreWeapon takes unit renjiHero returns nothing
local group renjiRequirementUnits
local unit renjiRequirementUnit
local unit renjiNewRequirement
local boolean renjiHasWeaponRequirement=false
if GetUnitTypeId(renjiHero)!='H01Q' or IsUnitIllusion(renjiHero) then
return
endif
call UnitRemoveAbility(renjiHero,'A0BM')
call UnitAddAbility(renjiHero,'A0BM')
set zk=false
set renjiRequirementUnits=CreateGroup()
call GroupEnumUnitsOfPlayer(renjiRequirementUnits,GetOwningPlayer(renjiHero),null)
loop
set renjiRequirementUnit=FirstOfGroup(renjiRequirementUnits)
exitwhen renjiRequirementUnit==null
call GroupRemoveUnit(renjiRequirementUnits,renjiRequirementUnit)
if GetUnitTypeId(renjiRequirementUnit)=='edoc' and GetWidgetLife(renjiRequirementUnit)>.405 then
set renjiHasWeaponRequirement=true
endif
endloop
call DestroyGroup(renjiRequirementUnits)
if not renjiHasWeaponRequirement then
set renjiNewRequirement=CreateUnit(GetOwningPlayer(renjiHero),'edoc',GetRectCenterX(to),GetRectCenterY(to),bj_UNIT_FACING)
endif
set renjiRequirementUnits=null
set renjiRequirementUnit=null
set renjiNewRequirement=null
endfunction
function BvORenjiECastCurrent takes unit renjiCastHero,integer renjiCastGeneration returns boolean
return renjiCastHero!=null and GetUnitTypeId(renjiCastHero)=='H01Q' and GetWidgetLife(renjiCastHero)>.405 and sk[10]==renjiCastHero and LoadInteger(Hash,GetHandleId(renjiCastHero),StringHash("RenjiECastGeneration"))==renjiCastGeneration
endfunction
function BvORenjiCancelEOnDeath takes unit renjiDeadHero returns nothing
local integer renjiSegmentIndex=19
call SaveInteger(Hash,GetHandleId(renjiDeadHero),StringHash("RenjiECastGeneration"),LoadInteger(Hash,GetHandleId(renjiDeadHero),StringHash("RenjiECastGeneration"))+1)
if sk[10]==renjiDeadHero then
call DisableTrigger(MB)
loop
exitwhen renjiSegmentIndex>26
if GetUnitTypeId(tk[renjiSegmentIndex])=='h01S' or GetUnitTypeId(tk[renjiSegmentIndex])=='h01T' then
call RemoveUnit(tk[renjiSegmentIndex])
endif
set tk[renjiSegmentIndex]=null
set renjiSegmentIndex=renjiSegmentIndex+1
endloop
set sk[10]=null
set sk[11]=null
set xk[10]=0
set vk[10]=0.
if uk[10]!=null then
call RemoveLocation(uk[10])
set uk[10]=null
endif
if uk[11]!=null then
call RemoveLocation(uk[11])
set uk[11]=null
endif
endif
endfunction
function BvOReviveHeroAtTeamBase takes unit heroToRevive,boolean showRevivalEffect returns nothing
local player revivalOwner=GetOwningPlayer(heroToRevive)
local rect revivalBase
local real revivalX
local real revivalY
if IsPlayerInForce(revivalOwner,e) then
set revivalBase=uo
elseif IsPlayerInForce(revivalOwner,f) then
set revivalBase=wo
elseif GetPlayerId(revivalOwner)<6 then
set revivalBase=uo
else
set revivalBase=wo
endif
set revivalX=GetRectCenterX(revivalBase)
set revivalY=GetRectCenterY(revivalBase)
call SaveInteger(Hash,GetHandleId(heroToRevive),StringHash("BvORevivalGeneration"),LoadInteger(Hash,GetHandleId(heroToRevive),StringHash("BvORevivalGeneration"))+1)
call InoueTForgetTarget(heroToRevive)
call ReviveHero(heroToRevive,revivalX,revivalY,showRevivalEffect)
call SetUnitPosition(heroToRevive,revivalX,revivalY)
call InoueTReleaseControl(heroToRevive)
call BvORenjiRestoreWeapon(heroToRevive)
call PauseUnit(heroToRevive,false)
call SetUnitInvulnerable(heroToRevive,false)
call SetUnitPathing(heroToRevive,true)
call SetUnitFlyHeight(heroToRevive,GetUnitDefaultFlyHeight(heroToRevive),0.)
call SetUnitTimeScale(heroToRevive,1.)
call ResetUnitLookAt(heroToRevive)
call ResetUnitAnimation(heroToRevive)
set revivalOwner=null
set revivalBase=null
endfunction
function BvOIsProtectedDeathDrop takes item deathDropItem returns boolean
local integer deathDropType=GetItemTypeId(deathDropItem)
return deathDropType=='I00R' or deathDropType=='I00I' or deathDropType=='I001' or deathDropType=='ofro'
endfunction
function BvORecordWallDropPoint takes unit wallDropVictim returns nothing
local integer wallDropVictimId=GetHandleId(wallDropVictim)
local real wallDropX=GetUnitX(wallDropVictim)
local real wallDropY=GetUnitY(wallDropVictim)
if LoadBoolean(Hash,wallDropVictimId,StringHash("WallDropTracking")) and GetWidgetLife(wallDropVictim)>.405 and not IsTerrainPathable(wallDropX,wallDropY,PATHING_TYPE_WALKABILITY) then
call S_R(wallDropVictimId,"WallDropSafeX",wallDropX)
call S_R(wallDropVictimId,"WallDropSafeY",wallDropY)
endif
endfunction
function BvOTrackWallDeathDrops takes unit wallDropCaster,unit wallDropVictim returns nothing
local integer wallDropVictimId=GetHandleId(wallDropVictim)
local integer wallDropSlot=0
local item wallDropItem
call SaveBoolean(Hash,wallDropVictimId,StringHash("WallDropTracking"),true)
call S_R(wallDropVictimId,"WallDropSafeX",GetUnitX(wallDropVictim))
call S_R(wallDropVictimId,"WallDropSafeY",GetUnitY(wallDropVictim))
call S_R(wallDropVictimId,"WallDropBackupX",GetUnitX(wallDropCaster))
call S_R(wallDropVictimId,"WallDropBackupY",GetUnitY(wallDropCaster))
loop
exitwhen wallDropSlot>=6
set wallDropItem=UnitItemInSlot(wallDropVictim,wallDropSlot)
if BvOIsProtectedDeathDrop(wallDropItem) then
call SaveItemHandle(Hash,wallDropVictimId,StringHash("WallDropItem"+I2S(wallDropSlot)),wallDropItem)
else
call RemoveSavedHandle(Hash,wallDropVictimId,StringHash("WallDropItem"+I2S(wallDropSlot)))
endif
set wallDropSlot=wallDropSlot+1
endloop
set wallDropItem=null
endfunction
function BvOReleaseWallDeathDrops takes unit wallDropVictim returns nothing
local integer wallDropVictimId=GetHandleId(wallDropVictim)
local integer wallDropSlot=0
call RemoveSavedBoolean(Hash,wallDropVictimId,StringHash("WallDropTracking"))
loop
exitwhen wallDropSlot>=6
call RemoveSavedHandle(Hash,wallDropVictimId,StringHash("WallDropItem"+I2S(wallDropSlot)))
set wallDropSlot=wallDropSlot+1
endloop
call RemoveSavedReal(Hash,wallDropVictimId,StringHash("WallDropSafeX"))
call RemoveSavedReal(Hash,wallDropVictimId,StringHash("WallDropSafeY"))
call RemoveSavedReal(Hash,wallDropVictimId,StringHash("WallDropBackupX"))
call RemoveSavedReal(Hash,wallDropVictimId,StringHash("WallDropBackupY"))
endfunction
function BvOWallDeathDropsTick takes nothing returns nothing
local timer wallDropTimer=GetExpiredTimer()
local integer wallDropTimerId=GetHandleId(wallDropTimer)
local integer wallDropTick=L_I(wallDropTimerId,"tick")+1
local integer wallDropSlot=0
local integer wallDropRing=1
local integer wallDropAngleStep
local real wallDropDeathX=L_R(wallDropTimerId,"deathX")
local real wallDropDeathY=L_R(wallDropTimerId,"deathY")
local real wallDropX=wallDropDeathX
local real wallDropY=wallDropDeathY
local real wallDropCandidateX
local real wallDropCandidateY
local boolean wallDropSafe=wallDropX>GetRectMinX(bj_mapInitialPlayableArea)+16. and wallDropX<GetRectMaxX(bj_mapInitialPlayableArea)-16. and wallDropY>GetRectMinY(bj_mapInitialPlayableArea)+16. and wallDropY<GetRectMaxY(bj_mapInitialPlayableArea)-16. and not IsTerrainPathable(wallDropX,wallDropY,PATHING_TYPE_WALKABILITY)
local item wallDropItem
loop
exitwhen wallDropSafe or wallDropRing>48
set wallDropAngleStep=0
loop
exitwhen wallDropSafe or wallDropAngleStep>=24
set wallDropCandidateX=wallDropDeathX+16.*wallDropRing*Cos(15.*wallDropAngleStep*bj_DEGTORAD)
set wallDropCandidateY=wallDropDeathY+16.*wallDropRing*Sin(15.*wallDropAngleStep*bj_DEGTORAD)
if wallDropCandidateX>GetRectMinX(bj_mapInitialPlayableArea)+16. and wallDropCandidateX<GetRectMaxX(bj_mapInitialPlayableArea)-16. and wallDropCandidateY>GetRectMinY(bj_mapInitialPlayableArea)+16. and wallDropCandidateY<GetRectMaxY(bj_mapInitialPlayableArea)-16. and not IsTerrainPathable(wallDropCandidateX,wallDropCandidateY,PATHING_TYPE_WALKABILITY) then
set wallDropX=wallDropCandidateX
set wallDropY=wallDropCandidateY
set wallDropSafe=true
endif
set wallDropAngleStep=wallDropAngleStep+1
endloop
set wallDropRing=wallDropRing+1
endloop
if not wallDropSafe then
set wallDropX=L_R(wallDropTimerId,"safeX")
set wallDropY=L_R(wallDropTimerId,"safeY")
set wallDropSafe=not IsTerrainPathable(wallDropX,wallDropY,PATHING_TYPE_WALKABILITY)
endif
if not wallDropSafe then
set wallDropX=L_R(wallDropTimerId,"backupX")
set wallDropY=L_R(wallDropTimerId,"backupY")
set wallDropSafe=not IsTerrainPathable(wallDropX,wallDropY,PATHING_TYPE_WALKABILITY)
endif
if wallDropSafe then
loop
exitwhen wallDropSlot>=6
set wallDropItem=LoadItemHandle(Hash,wallDropTimerId,StringHash("item"+I2S(wallDropSlot)))
if BvOIsProtectedDeathDrop(wallDropItem) and not IsItemOwned(wallDropItem) then
call SetItemVisible(wallDropItem,true)
call SetItemPosition(wallDropItem,wallDropX,wallDropY)
endif
set wallDropSlot=wallDropSlot+1
endloop
endif
if wallDropTick<3 then
call S_I(wallDropTimerId,"tick",wallDropTick)
else
call PauseTimer(wallDropTimer)
call FlushChildHashtable(Hash,wallDropTimerId)
call DestroyTimer(wallDropTimer)
endif
set wallDropItem=null
set wallDropTimer=null
endfunction
function BvOWallDeathDropsOnDeath takes nothing returns nothing
local unit wallDropVictim=GetDyingUnit()
local integer wallDropVictimId=GetHandleId(wallDropVictim)
local timer wallDropTimer
local integer wallDropTimerId
local integer wallDropSlot=0
if LoadBoolean(Hash,wallDropVictimId,StringHash("WallDropTracking")) then
set wallDropTimer=CreateTimer()
set wallDropTimerId=GetHandleId(wallDropTimer)
call S_R(wallDropTimerId,"deathX",GetUnitX(wallDropVictim))
call S_R(wallDropTimerId,"deathY",GetUnitY(wallDropVictim))
call S_R(wallDropTimerId,"safeX",L_R(wallDropVictimId,"WallDropSafeX"))
call S_R(wallDropTimerId,"safeY",L_R(wallDropVictimId,"WallDropSafeY"))
call S_R(wallDropTimerId,"backupX",L_R(wallDropVictimId,"WallDropBackupX"))
call S_R(wallDropTimerId,"backupY",L_R(wallDropVictimId,"WallDropBackupY"))
call S_I(wallDropTimerId,"tick",0)
loop
exitwhen wallDropSlot>=6
call SaveItemHandle(Hash,wallDropTimerId,StringHash("item"+I2S(wallDropSlot)),LoadItemHandle(Hash,wallDropVictimId,StringHash("WallDropItem"+I2S(wallDropSlot))))
set wallDropSlot=wallDropSlot+1
endloop
call TimerStart(wallDropTimer,.05,true,function BvOWallDeathDropsTick)
endif
set wallDropVictim=null
set wallDropTimer=null
endfunction
function BvOHasCurrentPlayerHero takes player heroOwner returns boolean
local integer heroPlayerSlot=1+GetPlayerId(heroOwner)
local unit currentPlayerHero=m[heroPlayerSlot]
local boolean currentHeroValid=heroOwner!=null and heroPlayerSlot>=1 and heroPlayerSlot<=12 and currentPlayerHero!=null and GetUnitTypeId(currentPlayerHero)!=0 and GetOwningPlayer(currentPlayerHero)==heroOwner and IsUnitType(currentPlayerHero,UNIT_TYPE_HERO) and not IsUnitIllusion(currentPlayerHero) and GetUnitAbilityLevel(currentPlayerHero,'A01Q')==0 and GetUnitAbilityLevel(currentPlayerHero,'Aloc')==0
set currentPlayerHero=null
return currentHeroValid
endfunction
