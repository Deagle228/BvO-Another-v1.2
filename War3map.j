call DamageUnit(rbLocal36_caster,rbLocal36_victim,LoadReal(RBState,rbLocal36_k,3),MAGICAL,SPELL)
call RBAceStartStunBurn(rbLocal36_caster,rbLocal36_victim)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",rbLocal36_victim,"origin"))
endif
call RemoveUnit(rbLocal36_fly)
call FlushChildHashtable(RBState,rbLocal36_k)
call DestroyTimer(rbLocal36_t)
else
call SetUnitX(rbLocal36_fly,GetUnitX(rbLocal36_fly)+25.*rbLocal36_dx/rbLocal36_d)
call SetUnitY(rbLocal36_fly,GetUnitY(rbLocal36_fly)+25.*rbLocal36_dy/rbLocal36_d)
endif
set rbLocal36_caster=null
set rbLocal36_victim=null
set rbLocal36_fly=null
set rbLocal36_t=null
endfunction
