set this=LoadInteger(ULQ_HashTable,-12187,i)
if LoadReal(ULQ_HashTable,-12195,this)<LoadReal(ULQ_HashTable,-12190,this)and ULQ_SpellBool(LoadUnitHandle(ULQ_HashTable,-12189,this))and GetUnitAbilityLevel(LoadUnitHandle(ULQ_HashTable,-12189,this),0x5A533032)>0 then
call SaveReal(ULQ_HashTable,-12195,this,LoadReal(ULQ_HashTable,-12195,this)+(0.025))
