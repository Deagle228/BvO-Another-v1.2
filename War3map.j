// Brook R (Polka: Remise): the arrow keys of the rhythm game would scroll the camera, so the camera of the owner is
// held where it was when the spell was cast (position and distance) and left there at the end
function BrookCameraHoldTick takes nothing returns nothing
if BrookCameraHeld then
call PanCameraToTimed(BrookCameraX,BrookCameraY,0.)
call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE,BrookCameraDistance,0.)
endif
endfunction
function BrookCameraHold takes player brookOwner,unit brookCameraHero returns nothing
if GetLocalPlayer()==brookOwner then
set BrookCameraX=GetUnitX(brookCameraHero)
set BrookCameraY=GetUnitY(brookCameraHero)
set BrookCameraDistance=GetCameraField(CAMERA_FIELD_TARGET_DISTANCE)
set BrookCameraHeld=true
endif
if BrookCameraTimer==null then
set BrookCameraTimer=CreateTimer()
endif
call TimerStart(BrookCameraTimer,.01,true,function BrookCameraHoldTick)
endfunction
function BrookCameraRelease takes nothing returns nothing
call BrookCameraHoldTick()
set BrookCameraHeld=false
if BrookCameraTimer!=null then
call PauseTimer(BrookCameraTimer)
endif
endfunction
// ------------------------------------------------------------------ Brook R (Polka: Remise): a rhythm duel
// Brook and his target both play: 7 rounds, every round each of them gets an arrow key to press while a marker runs
// over a bar (each player sees only his own bar, over his own hero, and his own key). Brook's hit deals
// 7 x base Agility of Brook to the target, the target's hit deals 7 x its base main attribute to Brook
// (BAD 40%, GOOD 65%, PERFECT 100%, a wrong key or no key is a miss). Both stay paused and invulnerable for anyone
// else during the duel; only the duel's own hits get through. The duel ends after 7 rounds, or when one of them dies,
// is removed or the two are more than 400 apart.
function BvOHeroMainStat takes unit hero returns integer
local integer heroType=GetUnitTypeId(hero)
local integer strength=GetHeroStr(hero,false)
local integer agility=GetHeroAgi(hero,false)
local integer intelligence=GetHeroInt(hero,false)
if heroType=='HP00' or heroType=='HA00' or heroType=='HE00' or heroType=='N00X' or heroType=='E004' or heroType=='E000' or heroType=='E002' or heroType=='E001' or heroType=='N00S' or heroType=='HU00' or heroType=='Nngs' then
return bj_HEROSTAT_INT
elseif heroType=='HN00' or heroType=='HN01' or heroType=='HK00' or heroType=='U009' or heroType=='O004' or BvOSusanoType(heroType) or heroType=='U00A' or heroType=='O001' or heroType=='EC08' or heroType=='EC12' or heroType=='E003' or heroType=='OC10' or heroType=='O000' or heroType=='O002' or heroType=='O003' or heroType=='NC03' or heroType=='UC13' or heroType=='N002' or heroType=='N00C' or heroType=='N007' or heroType=='N004' or heroType=='N000' or heroType=='N006' or heroType=='N00W' or heroType=='N00T' or heroType=='HZ00' or heroType=='HS00' or heroType=='US00' or heroType=='US1_' or heroType=='US2_' or heroType=='Nbrn' then
return bj_HEROSTAT_AGI
elseif heroType=='HT00' or heroType=='HW00' or heroType=='HL00' or heroType=='HD00' or heroType=='N00U' or heroType=='H01Q' or heroType=='N009' or heroType=='N00R' or heroType=='U00S' or heroType=='U00T' or heroType=='U005' or heroType=='U006' or heroType=='U007' or heroType=='U008' or heroType=='H004' or heroType=='H00U' or heroType=='H003' or heroType=='H00E' or heroType=='H01B' or heroType=='H01C' or heroType=='H01D' or heroType=='H01E' or heroType=='H01F' or heroType=='H00I' or heroType=='H00J' or heroType=='UC11' or heroType=='U004' or heroType=='N003' or heroType=='N008' or heroType=='N005' or heroType=='Nbst' or heroType=='Npbm' or heroType=='Nplh' then
return bj_HEROSTAT_STR
endif
if agility>=strength and agility>=intelligence then
return bj_HEROSTAT_AGI
elseif intelligence>=strength then
return bj_HEROSTAT_INT
endif
return bj_HEROSTAT_STR
endfunction
function BrookPolkaUnit takes integer side returns unit
if side==0 then
return BrookPolkaBrook
endif
return BrookPolkaTarget
endfunction
// the bar: 15 marks, the hit zone in green in the middle (PERFECT in the darkest), the running marker in red
function BrookPolkaBarText takes integer mark returns string
local string text=""
local integer position=1
local string piece
loop
exitwhen position>15
if position==mark-1 then
set piece="|c00ff2020I|r"
elseif position==8 then
set piece="|c00008442I|r"
elseif position==7 or position==9 then
set piece="|c0000C161I|r"
elseif position>=5 and position<=11 then
set piece="|c0006FF83I|r"
else
set piece="I"
endif
set text=text+piece
set position=position+1
endloop
return text
endfunction
function BrookPolkaKeyName takes integer key returns string
if key==1 then
return "LEFT"
elseif key==2 then
return "RIGHT"
elseif key==3 then
return "UP"
endif
return "DOWN"
endfunction
// a text only one player sees, over his own hero
function BrookPolkaPrivateTag takes string text,unit hero,real height,real size,player viewer returns texttag
local texttag tag=CreateTextTag()
call SetTextTagText(tag,text,size*.023/10.)
call SetTextTagPosUnit(tag,hero,height)
call SetTextTagColor(tag,255,255,255,255)
call SetTextTagPermanent(tag,true)
call SetTextTagVisibility(tag,GetLocalPlayer()==viewer)
set bj_lastCreatedTextTag=tag
set tag=null
return bj_lastCreatedTextTag
endfunction
function BrookPolkaClearSide takes integer side returns nothing
if BrookPolkaBar[side]!=null then
call DestroyTextTag(BrookPolkaBar[side])
set BrookPolkaBar[side]=null
endif
if BrookPolkaPrompt[side]!=null then
call DestroyTextTag(BrookPolkaPrompt[side])
set BrookPolkaPrompt[side]=null
endif
endfunction
function BrookPolkaEnd takes nothing returns nothing
local unit brook=BrookPolkaBrook
local unit target=BrookPolkaTarget
set BrookPolkaActive=false
call PauseTimer(BrookPolkaTimer)
call BrookPolkaClearSide(0)
call BrookPolkaClearSide(1)
if brook!=null then
call PauseUnit(brook,false)
call SetUnitInvulnerable(brook,false)
call SetUnitTimeScalePercent(brook,100.)
call SelectUnitForPlayerSingle(brook,GetOwningPlayer(brook))
endif
if target!=null then
call PauseUnit(target,false)
call SetUnitInvulnerable(target,false)
set l[1+GetPlayerId(GetOwningPlayer(target))]=false
endif
call BrookCameraRelease()
set BrookPolkaBrook=null
set BrookPolkaTarget=null
set A[1006]=null
set a[1006]=null
set brook=null
set target=null
endfunction
function BrookPolkaBroken takes nothing returns boolean
local unit brook=BrookPolkaBrook
local unit target=BrookPolkaTarget
local real dx=GetUnitX(brook)-GetUnitX(target)
local real dy=GetUnitY(brook)-GetUnitY(target)
local boolean broken=GetUnitTypeId(brook)==0 or GetUnitTypeId(target)==0 or GetWidgetLife(brook)<=.405 or GetWidgetLife(target)<=.405 or IsUnitType(brook,UNIT_TYPE_DEAD) or IsUnitType(target,UNIT_TYPE_DEAD) or dx*dx+dy*dy>400.*400.
set brook=null
set target=null
return broken
endfunction
// Show each side's timing grade over the hero who made that attempt.
// Configure the result immediately on its own handle. Damage/death triggers
// can create other floating text and overwrite bj_lastCreatedTextTag.
function BrookPolkaShowResult takes string text,unit attacker returns nothing
local texttag resultTag=CreateTextTag()
call SetTextTagText(resultTag,text,12.*.023/10.)
call SetTextTagPosUnit(resultTag,attacker,0.)
call SetTextTagColor(resultTag,255,255,255,255)
call SetTextTagPermanent(resultTag,false)
call SetTextTagLifespan(resultTag,1.5)
call SetTextTagFadepoint(resultTag,1.)
call SetTextTagVelocityBJ(resultTag,100.,90.)
set resultTag=null
endfunction
function BrookPolkaHit takes integer side returns nothing
local unit attacker=BrookPolkaUnit(side)
local unit victim=BrookPolkaUnit(1-side)
local integer mark=BrookPolkaMark[side]
local real damage
local string grade
if not BrookPolkaPressed[side] or mark<6 or mark>12 then
call BrookPolkaShowResult("|c00FFFF80MISS!!|r",attacker)
else
if side==0 then
set damage=5.*GetHeroAgi(attacker,true)+8.*GetHeroStr(attacker,true)
else
set damage=5.*GetHeroAgi(attacker,true)+8.*GetHeroStr(attacker,true)
endif
if mark==9 then
set grade="|c000080FFPERFECT|r"
call SetUnitAnimation(attacker,"spell slam")
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",victim,"origin"))
elseif mark==8 or mark==10 then
set grade="|c0080FF80GOOD|r"
set damage=damage*.65
call SetUnitAnimation(attacker,"attack")
else
set grade="|c0080FF80BAD|r"
set damage=damage*.4
call SetUnitAnimation(attacker,"attack")
endif
call BrookPolkaShowResult(grade,attacker)
// only the duel's own hit gets through the invulnerability
call SetUnitInvulnerable(victim,false)
call DamageUnit(attacker,victim,damage,PHYSICAL,SPELL)
if GetWidgetLife(victim)>.405 then
call SetUnitInvulnerable(victim,true)
endif
endif
set attacker=null
set victim=null
endfunction
function BrookPolkaStartRound takes nothing returns nothing
local integer side=0
loop
exitwhen side>1
call BrookPolkaClearSide(side)
set BrookPolkaMark[side]=0
set BrookPolkaPressed[side]=false
set BrookPolkaDone[side]=false
set BrookPolkaKey[side]=GetRandomInt(1,4)
set BrookPolkaPrompt[side]=BrookPolkaPrivateTag("|c007DFFBEpress "+BrookPolkaKeyName(BrookPolkaKey[side])+"|r",BrookPolkaUnit(side),650.,12.,GetOwningPlayer(BrookPolkaUnit(side)))
set BrookPolkaBar[side]=BrookPolkaPrivateTag(BrookPolkaBarText(0),BrookPolkaUnit(side),900.,10.,GetOwningPlayer(BrookPolkaUnit(side)))
set side=side+1
endloop
set BrookPolkaRunning=true
endfunction
function BrookPolkaTick takes nothing returns nothing
local integer side=0
if not BrookPolkaActive then
return
endif
if BrookPolkaBroken() then
call BrookPolkaEnd()
return
endif
if BrookPolkaPause>0. then
set BrookPolkaPause=BrookPolkaPause-.05
if BrookPolkaPause<=0. then
call BrookPolkaStartRound()
endif
return
endif
if not BrookPolkaRunning then
return
endif
loop
exitwhen side>1
if not BrookPolkaDone[side] then
set BrookPolkaMark[side]=BrookPolkaMark[side]+1
if BrookPolkaMark[side]>=17 then
set BrookPolkaDone[side]=true
call SetTextTagText(BrookPolkaBar[side],BrookPolkaBarText(0),.023)
else
call SetTextTagText(BrookPolkaBar[side],BrookPolkaBarText(BrookPolkaMark[side]),.023)
endif
endif
set side=side+1
endloop
if BrookPolkaDone[0] and BrookPolkaDone[1] then
set BrookPolkaRunning=false
call BrookPolkaClearSide(0)
call BrookPolkaClearSide(1)
call BrookPolkaHit(0)
if BrookPolkaBroken() then
call BrookPolkaEnd()
return
endif
call BrookPolkaHit(1)
if BrookPolkaBroken() then
call BrookPolkaEnd()
return
endif
set BrookPolkaRound=BrookPolkaRound+1
if BrookPolkaRound>7 then
call BrookPolkaEnd()
else
set BrookPolkaPause=.3
endif
endif
endfunction
// an arrow key of one of the two players: the marker stops where it is (a wrong key is a miss)
function BrookPolkaPress takes integer key returns nothing
local integer side=-1
if not BrookPolkaActive or not BrookPolkaRunning then
return
endif
if GetTriggerPlayer()==GetOwningPlayer(BrookPolkaBrook) then
set side=0
elseif GetTriggerPlayer()==GetOwningPlayer(BrookPolkaTarget) then
set side=1
endif
if side<0 or BrookPolkaDone[side] or BrookPolkaMark[side]<1 then
return
endif
set BrookPolkaDone[side]=true
set BrookPolkaPressed[side]=BrookPolkaKey[side]==key
if not BrookPolkaPressed[side] then
call SetTextTagText(BrookPolkaBar[side],"|c00FFFF80MISS|r "+BrookPolkaBarText(BrookPolkaMark[side]),.023)
endif
endfunction
function BrookPolkaPressLeft takes nothing returns boolean
call BrookPolkaPress(1)
return false
endfunction
function BrookPolkaPressRight takes nothing returns boolean
call BrookPolkaPress(2)
return false
endfunction
function BrookPolkaPressUp takes nothing returns boolean
call BrookPolkaPress(3)
return false
endfunction
function BrookPolkaPressDown takes nothing returns boolean
call BrookPolkaPress(4)
return false
endfunction
function BrookPolkaInit takes nothing returns nothing
local trigger leftKey=CreateTrigger()
local trigger rightKey=CreateTrigger()
local trigger upKey=CreateTrigger()
local trigger downKey=CreateTrigger()
local integer playerIndex=0
loop
exitwhen playerIndex>11
call TriggerRegisterPlayerKeyEventBJ(leftKey,Player(playerIndex),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_LEFT)
call TriggerRegisterPlayerKeyEventBJ(rightKey,Player(playerIndex),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_RIGHT)
call TriggerRegisterPlayerKeyEventBJ(upKey,Player(playerIndex),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_UP)
call TriggerRegisterPlayerKeyEventBJ(downKey,Player(playerIndex),bj_KEYEVENTTYPE_DEPRESS,bj_KEYEVENTKEY_DOWN)
set playerIndex=playerIndex+1
endloop
call TriggerAddCondition(leftKey,Condition(function BrookPolkaPressLeft))
call TriggerAddCondition(rightKey,Condition(function BrookPolkaPressRight))
call TriggerAddCondition(upKey,Condition(function BrookPolkaPressUp))
call TriggerAddCondition(downKey,Condition(function BrookPolkaPressDown))
set BrookPolkaTimer=CreateTimer()
set leftKey=null
set rightKey=null
set upKey=null
set downKey=null
endfunction
// the cast (UD, Brook's SPELL_EFFECT of A0AD)
function BrookPolkaStart takes unit brook,unit target returns nothing
if BrookPolkaActive then
call BrookPolkaEnd()
endif
set BrookPolkaBrook=brook
set BrookPolkaTarget=target
set A[1006]=brook
set a[1006]=target
set BrookPolkaActive=true
set BrookPolkaRunning=false
set BrookPolkaRound=1
set BrookPolkaPause=.75
set l[1+GetPlayerId(GetOwningPlayer(target))]=true
call SetUnitFacing(brook,bj_RADTODEG*Atan2(GetUnitY(target)-GetUnitY(brook),GetUnitX(target)-GetUnitX(brook)))
call PauseUnit(brook,true)
call PauseUnit(target,true)
call SetUnitInvulnerable(brook,true)
call SetUnitInvulnerable(target,true)
call SetUnitTimeScalePercent(brook,200.)
call CreateTextTagUnitBJ("Polka: Remise",brook,0,10.,100,100.,100.,0)
call SetTextTagPermanent(bj_lastCreatedTextTag,false)
call SetTextTagLifespan(bj_lastCreatedTextTag,1.5)
call SetTextTagFadepoint(bj_lastCreatedTextTag,1.)
call BrookCameraHold(GetOwningPlayer(brook),brook)
call BrookCameraHold(GetOwningPlayer(target),target)
call PlaySoundOnUnitBJ(nr,100,brook)
call TimerStart(BrookPolkaTimer,.05,true,function BrookPolkaTick)
endfunction
