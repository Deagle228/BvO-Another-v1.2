function Bonecrucher_Attack takes nothing returns nothing
local unit crusher=Source
if UnitHasItemOfTypeBJ(crusher,$4930304B) and not IsUnitIllusion(crusher) and not UnitHasBuffBJ(crusher,$42303330) then
call DamageUnit(crusher,Target,100+Damage*.5,PHYSICAL,UNKNOWN)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\darkblast.mdx",Target,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\NightElf\\NightElfBlood\\NightElfBloodChimaera.mdl",Target,"chest"))
if GetWidgetLife(crusher)>.405 then
call RemoveItem(GetItemOfTypeFromUnitBJ(crusher,$4930304B))
call UnitAddItemByIdSwapped($49303535,crusher)
call UnitUseItem(crusher,bj_lastCreatedItem)
if GetWidgetLife(Target)>.405 then
call IssueTargetOrder(crusher,"attack",Target)
endif
call TriggerSleepAction(6)
if GetWidgetLife(crusher)>.405 and not UnitHasItemOfTypeBJ(crusher,$4930304B) and UnitHasItemOfTypeBJ(crusher,$49303535) then
call RemoveItem(GetItemOfTypeFromUnitBJ(crusher,$49303535))
call UnitAddItemByIdSwapped($4930304B,crusher)
endif
endif
endif
set crusher=null
endfunction
function Manaburn_Attack takes unit source,unit target,real amount returns nothing
local real currentMana=GetUnitState(target,UNIT_STATE_MANA)
if currentMana>0 then
if currentMana>amount then
call SetUnitState(target,UNIT_STATE_MANA,currentMana-amount)
call DamageUnit(source,target,amount,PHYSICAL,UNKNOWN)
else
call SetUnitState(target,UNIT_STATE_MANA,0)
call DamageUnit(source,target,currentMana,PHYSICAL,UNKNOWN)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl",target,"origin"))
endif
endfunction
function Manasteal takes unit source,unit target,real percent returns nothing
local real amount=GetUnitState(target,UNIT_STATE_MAX_MANA)*percent
local real currentMana=GetUnitState(target,UNIT_STATE_MANA)
if currentMana>0 then
if currentMana>amount then
call SetUnitState(target,UNIT_STATE_MANA,currentMana-amount)
call SetUnitState(source,UNIT_STATE_MANA,GetUnitState(source,UNIT_STATE_MANA)+amount)
else
call SetUnitState(target,UNIT_STATE_MANA,0)
call SetUnitState(source,UNIT_STATE_MANA,GetUnitState(source,UNIT_STATE_MANA)+currentMana)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DevourMagic\\DevourMagicBirthMissile.mdl",target,"head"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\SpellSteal\\SpellStealTarget.mdl",source,"chest"))
endif
endfunction
function ItemPassiv_Spell takes nothing returns nothing
if UnitHasItemOfTypeBJ(Source,$49303537) and GetWidgetLife(Source)<GetUnitState(Source,UNIT_STATE_MAX_LIFE) then
if IsUnitType(Target,UNIT_TYPE_HERO) then
call SetWidgetLife(Source,GetWidgetLife(Source)+Damage*.1)
else
call SetWidgetLife(Source,GetWidgetLife(Source)+Damage*.01)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\ProcMissile\\ProcMissile.mdl",Source,"chest"))
endif
if UnitHasItemOfTypeBJ(Source,'IR01') and GetWidgetLife(Source)<GetUnitState(Source,UNIT_STATE_MAX_LIFE) then
if IsUnitType(Target,UNIT_TYPE_HERO) then
call SetWidgetLife(Source,GetWidgetLife(Source)+Damage*.2)
else
call SetWidgetLife(Source,GetWidgetLife(Source)+Damage*.01)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\ProcMissile\\ProcMissile.mdl",Source,"chest"))
endif
if UnitHasItemOfTypeBJ(Source,$4930344B) and GetWidgetLife(Source)<GetUnitState(Source,UNIT_STATE_MAX_LIFE) then
if IsUnitType(Target,UNIT_TYPE_HERO) then
call SetWidgetLife(Source,GetWidgetLife(Source)+Damage*.15)
else
call SetWidgetLife(Source,GetWidgetLife(Source)+Damage*.03)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\ProcMissile\\ProcMissile.mdl",Source,"chest"))
endif
if GetUnitAbilityLevel(Source,$42303253)>0 then
if GetWidgetLife(Target)>0 then
call DamageUnit(Source,Target,Damage*.33,CLEAN,UNKNOWN)
if GetOwningPlayer(Source)==GetLocalPlayer() then
call CreateTextTagUnitBJ("+"+I2S(R2I(Damage*.33)),Target,0,12.,100,0,100,0)
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,125.,90)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,1.1)
call SetTextTagFadepointBJ(bj_lastCreatedTextTag,.75)
endif
endif
endif
endfunction
function ItemPassiv_Attack takes nothing returns nothing
local real bvoFMClock
if UnitHasItemOfTypeBJ(Source,'I00I') and GetWidgetLife(Target)>.405 and not IsUnitIllusion(Source) and IsUnitEnemy(Target,GetOwningPlayer(Source)) and not IsUnitType(Target,UNIT_TYPE_STRUCTURE) then
set bvoFMClock=TimerGetElapsed(AYClock)
if GetUnitAbilityLevel(Target,'BFMA')==0 or bvoFMClock-LoadReal(Hash,GetHandleId(Target),StringHash("FrostmourneArmor"))>=3. then
call SaveReal(Hash,GetHandleId(Target),StringHash("FrostmourneArmor"),bvoFMClock)
call CastToTarget(Source,Target,'AFMA',1,"faeriefire")
endif
endif
if GetWidgetLife(Target)>.405 and GetUnitTypeId(Target)!=null then
if GetUnitAbilityLevel(Target,$42303255)>0 then
if IsUnitType(Source,UNIT_TYPE_MELEE_ATTACKER) then
call DamageUnit(Target,Source,150,CLEAN,UNKNOWN)
endif
endif
if UnitHasItemOfTypeBJ(Source,$49303337) then
if IsUnitIllusion(Source) then
call Manaburn_Attack(Source,Target,25)
else
call Manaburn_Attack(Source,Target,80)
call Manasteal(Source,Target,.01)
endif
else
if UnitHasItemOfTypeBJ(Source,$49303233) then
if IsUnitIllusion(Source) then
call Manaburn_Attack(Source,Target,10)
else
call Manaburn_Attack(Source,Target,25)
endif
endif
endif
if UnitHasItemOfTypeBJ(Source,$4930314E) then
if IsUnitIllusion(Source) then
if GetRandomInt(0,100)<=8 then
call CastCasterToTargetEx(Source,Target,$41303753,1,"chainlightning")
endif
else
if GetRandomInt(0,100)<=20 then
call CastCasterToTargetEx(Source,Target,$41303753,1,"chainlightning")
endif
endif
endif
if UnitHasItemOfTypeBJ(Source,$49303252) then
if IsUnitIllusion(Source) then
if GetRandomInt(0,100)<=10 then
call CastCasterToTargetEx(Source,Target,$41303833,1,"chainlightning")
endif
else
if GetRandomInt(0,100)<=25 then
call CastCasterToTargetEx(Source,Target,$41303833,1,"chainlightning")
endif
endif
endif
if UnitHasItemOfTypeBJ(Source,$49303034) or UnitHasItemOfTypeBJ(Source,$49303038) and GetUnitAbilityLevel(Target,$42303252)==0 then
if IsUnitType(Source,UNIT_TYPE_MELEE_ATTACKER) then
call CastToTarget(Source,Target,'AMS1',1,"shadowstrike")
else
call CastToTarget(Source,Target,'AMS2',1,"shadowstrike")
endif
endif
endif
if UnitHasItemOfTypeBJ(Source,$4930304E) then
if IsUnitType(Source,UNIT_TYPE_MELEE_ATTACKER) then
call SortEnemiesInRange(Source,GetUnitX(Source)+225*Cos(GetUnitFacing(Source)*bj_DEGTORAD),GetUnitY(Source)+225*Sin(GetUnitFacing(Source)*bj_DEGTORAD),450)
else
call SortEnemiesInRange(Source,GetUnitX(Target),GetUnitY(Target),350)
endif
call DamageAndPlayEffectOnGroup(Source,.2*Damage,CLEAN,UNKNOWN,"chest","Abilities\\Spells\\Other\\Cleave\\CleaveDamageTarget.mdl")
endif
endfunction
function SoiFonT_HomonkaAttack takes nothing returns nothing
local real damage
if (UnitHasBuffBJ(Source,$4230324F) and GetUnitAbilityLevel(Target,$4130454D)==0) or ForcedHomonkaAttack and IsUnitEnemy(Target,GetOwningPlayer(Source)) then
call UnitRemoveBuffBJ($4230324F,Source)
set ForcedHomonkaAttack=false
if UnitHasBuffBJ(Target,$42303148) then
call SaveInteger(Hash,GetHandleId(Target),StringHash("HomonkaAttackCount"),1+LoadInteger(Hash,GetHandleId(Target),StringHash("HomonkaAttackCount")))
else
call SaveInteger(Hash,GetHandleId(Target),StringHash("HomonkaAttackCount"),0)
endif
set damage=(GetHeroAgi(Source,true)-GetHeroAgi(Target,true))*(3+1.5*LoadInteger(Hash,GetHandleId(Target),StringHash("HomonkaAttackCount")))
if damage>0 then
set nd[4]=GetUnitLoc(Target)
call CreateNUnitsAtLoc(1,$75303032,GetOwningPlayer(Source),nd[4],bj_UNIT_FACING)
set g9=bj_lastCreatedUnit
call UnitAddAbility(g9,$41303937)
call IssueTargetOrder(g9,"lightningshield",Target)
call UnitApplyTimedLifeBJ(1.,$42544C46,g9)
call RemoveLocation(nd[4])
set nd[4]=null
call DamageUnit(Source,Target,damage,CLEAN,UNKNOWN)
call CreateTextTagUnitBJ("+"+I2S(R2I(damage))+"!",Target,0,15.,100,0.,0.,0)
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,175.,90)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,1.25)
else
call CreateTextTagUnitBJ("MISS",Target,0,15.,100,0.,0.,0)
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,175.,90)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,1.25)
endif
endif
endfunction
function InoeW_Block takes nothing returns nothing
call ExecuteFunc("RBShieldHook")
endfunction
function InoeV_Attack takes nothing returns nothing
local integer targetCount=0
if GetUnitAbilityLevel(TrueSource,$4130374C)>0 and not BvOPassivesBroken(TrueSource) then
call GroupClear(TempGroup)
call GroupEnumUnitsInRange(TempGroup,GetUnitX(Target),GetUnitY(Target),600,null)
set STarget=null
loop
set SUnit=FirstOfGroup(TempGroup)
exitwhen SUnit==null
if GetWidgetLife(SUnit)>.405 and IsUnitEnemy(SUnit,GetOwningPlayer(Source)) and not IsUnitType(SUnit,UNIT_TYPE_STRUCTURE) and SUnit!=Target and GetUnitAbilityLevel(SUnit,$416C6F63)==0 then
set targetCount=targetCount+1
if GetRandomInt(1,targetCount)==1 then
set STarget=SUnit
endif
endif
call GroupRemoveUnit(TempGroup,SUnit)
endloop
if STarget!=null then
set SReal=AngleBetween(GetUnitX(Target),GetUnitY(Target),GetUnitX(STarget),GetUnitY(STarget))
call CreateDummyMissile(Source,$75303047,GetUnitX(Target),GetUnitY(Target),40,SReal)
call SetDummyMissileMoveSettings(LastCreatedDummyMissile,1600,3000)
call SetDummyMissileTarget(LastCreatedDummyMissile,STarget)
call SetDummyMissileCollisionActions(LastCreatedDummyMissile,"InoeV_DummyCollision")
call S_I(GetHandleId(LastCreatedDummyMissile),"attackCount",3)
call S_R(GetHandleId(LastCreatedDummyMissile),"damage",GetHeroInt(Source,true)*.4)
call S_G(GetHandleId(LastCreatedDummyMissile),"attackGroup",CreateGroup())
call GroupAddUnit(L_G(GetHandleId(LastCreatedDummyMissile),"attackGroup"),Target)
call GroupAddUnit(L_G(GetHandleId(LastCreatedDummyMissile),"attackGroup"),STarget)
endif
endif
endfunction
function InoeV_DummyCollision takes nothing returns nothing
local integer targetCount=0
if DummyMissileTarget!=null and DummyMissileCaster!=null and DummyMissile!=null then
if GetWidgetLife(DummyMissileTarget)>.405 then
call DamageUnit(DummyMissileCaster,DummyMissileTarget,L_R(GetHandleId(DummyMissile),"damage"),CLEAN,UNKNOWN)
endif
if L_I(GetHandleId(DummyMissile),"attackCount")>0 then
call GroupClear(TempGroup)
call GroupEnumUnitsInRange(TempGroup,GetUnitX(DummyMissileTarget),GetUnitY(DummyMissileTarget),600,null)
set STarget=null
loop
set SUnit=FirstOfGroup(TempGroup)
exitwhen SUnit==null
if GetWidgetLife(SUnit)>.405 and not IsUnitInGroup(SUnit,L_G(GetHandleId(DummyMissile),"attackGroup")) and IsUnitEnemy(SUnit,GetOwningPlayer(DummyMissileCaster)) and not IsUnitType(SUnit,UNIT_TYPE_STRUCTURE) and SUnit!=DummyMissileTarget and GetUnitAbilityLevel(SUnit,$416C6F63)==0 then
set targetCount=targetCount+1
if GetRandomInt(1,targetCount)==1 then
set STarget=SUnit
endif
endif
call GroupRemoveUnit(TempGroup,SUnit)
endloop
if STarget!=null then
set SReal=AngleBetween(GetUnitX(DummyMissileTarget),GetUnitY(DummyMissileTarget),GetUnitX(STarget),GetUnitY(STarget))
call CreateDummyMissile(DummyMissileCaster,$75303047,GetUnitX(DummyMissileTarget),GetUnitY(DummyMissileTarget),40,SReal)
call SetDummyMissileMoveSettings(LastCreatedDummyMissile,1600,3000)
call SetDummyMissileTarget(LastCreatedDummyMissile,STarget)
call SetDummyMissileCollisionActions(LastCreatedDummyMissile,"InoeV_DummyCollision")
call S_I(GetHandleId(LastCreatedDummyMissile),"attackCount",L_I(GetHandleId(DummyMissile),"attackCount")-1)
call S_R(GetHandleId(LastCreatedDummyMissile),"damage",L_R(GetHandleId(DummyMissile),"damage"))
call S_G(GetHandleId(LastCreatedDummyMissile),"attackGroup",L_G(GetHandleId(DummyMissile),"attackGroup"))
call GroupAddUnit(L_G(GetHandleId(LastCreatedDummyMissile),"attackGroup"),STarget)
else
call DestroyGroup(L_G(GetHandleId(DummyMissile),"attackGroup"))
endif
else
call DestroyGroup(L_G(GetHandleId(DummyMissile),"attackGroup"))
endif
endif
endfunction
