// ghost form: physical damage is prevented, magic spell damage is doubled
function GhostFormActive takes unit ghostUnit returns boolean
return LoadInteger(GhostScepterHash,GetHandleId(ghostUnit),0)>0
endfunction
function GhostFormEnd takes nothing returns nothing
local timer ghostTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(ghostTimer)
local unit ghostUnit=LoadUnitHandle(GhostScepterHash,timerKey,0)
if LoadInteger(GhostScepterHash,GetHandleId(ghostUnit),0)==timerKey then
call RemoveSavedInteger(GhostScepterHash,GetHandleId(ghostUnit),0)
endif
call FlushChildHashtable(GhostScepterHash,timerKey)
call DestroyTimer(ghostTimer)
set ghostTimer=null
set ghostUnit=null
endfunction
// the astral (ethereal) state itself comes from a Banish cast on the bearer: it cannot attack and has the original ethereal look
function GhostScepterOnUse takes nothing returns boolean
local unit ghostUnit=GetManipulatingUnit()
local unit banishCaster
local timer ghostTimer
if GetItemTypeId(GetManipulatedItem())==GHOST_SCEPTER_ITEM then
set banishCaster=CreateUnit(GetOwningPlayer(ghostUnit),'u002',GetUnitX(ghostUnit),GetUnitY(ghostUnit),0.)
call UnitAddAbility(banishCaster,GHOST_SCEPTER_BANISH)
call IssueTargetOrder(banishCaster,"banish",ghostUnit)
call UnitApplyTimedLife(banishCaster,'BTLF',1.)
set ghostTimer=CreateTimer()
call SaveInteger(GhostScepterHash,GetHandleId(ghostUnit),0,GetHandleId(ghostTimer))
call SaveUnitHandle(GhostScepterHash,GetHandleId(ghostTimer),0,ghostUnit)
call TimerStart(ghostTimer,GHOST_SCEPTER_DURATION,false,function GhostFormEnd)
set ghostTimer=null
set banishCaster=null
endif
set ghostUnit=null
return false
endfunction
// adds bonusAmount of pure damage from Source to Target without disturbing the damage event that is being processed
function BvOAddBonusDamage takes real bonusAmount returns nothing
local unit savedSource=Source
local unit savedTrueSource=TrueSource
local unit savedTarget=Target
local real savedDamage=Damage
local real savedPrimaryDamage=PrimaryDamage
local integer savedDamageMode=DamageMode
local integer savedDamageType=DamageType
local integer savedSystemMode=DamageSystem_DamageMode
set GhostScepterDoubling=true
call DamageUnit(savedSource,savedTarget,bonusAmount,CLEAN,UNKNOWN)
set GhostScepterDoubling=false
set Source=savedSource
set TrueSource=savedTrueSource
set Target=savedTarget
set Damage=savedDamage
set PrimaryDamage=savedPrimaryDamage
set DamageMode=savedDamageMode
set DamageType=savedDamageType
set DamageSystem_DamageMode=savedSystemMode
set savedSource=null
set savedTrueSource=null
set savedTarget=null
endfunction
function GhostScepterDamageHook takes nothing returns nothing
if GhostScepterDoubling or Damage<=0. or not GhostFormActive(Target) then
return
endif
if AYIsAttackDamage() or (DamageMode==MODE_SPELL and DamageType==PHYSICAL) then
call AYPreventDamage(Target,Damage)
elseif DamageMode==MODE_SPELL and DamageType==MAGICAL and Source!=null then
// an ethereal unit already takes x1.66 magic damage from the game, the rest up to x2 is added here
if GetUnitAbilityLevel(Target,'BHbn')>0 then
call BvOAddBonusDamage(Damage*(2./GHOST_SCEPTER_ETHEREAL_FACTOR-1.))
else
call BvOAddBonusDamage(Damage)
endif
endif
endfunction
// Kido Grimoire: +5% damage of all abilities, Hakuda Gauntlets and Kido Cleaver: +10% (the bigger one applies)
function KidoGrimoireDamageHook takes nothing returns nothing
if GhostScepterDoubling or Damage<=0. or DamageMode!=MODE_SPELL or Source==null or Source==Target then
return
endif
if IsUnitIllusion(Source) then
return
endif
if UnitHasItemOfTypeBJ(Source,HAKUDA_ITEM) or UnitHasItemOfTypeBJ(Source,KIDO_CLEAVER_ITEM) then
call BvOAddBonusDamage(Damage*HAKUDA_BONUS)
elseif UnitHasItemOfTypeBJ(Source,KIDO_GRIMOIRE_ITEM) then
call BvOAddBonusDamage(Damage*KIDO_GRIMOIRE_BONUS)
endif
endfunction
function KidoGrimoireHasParts takes unit buyer returns boolean
return UnitHasItemOfTypeBJ(buyer,'ciri') and UnitHasItemOfTypeBJ(buyer,$4930305A)
endfunction
