endif
set ulquiorraMoveDistance=0
set ulquiorraFacingAngleRadians=0
endfunction
function ULQ_SpellBool takes unit ulquiorraActingUnit returns boolean
return GetWidgetLife(ulquiorraActingUnit)>0.405 and IsUnitPaused(ulquiorraActingUnit)==false and IsUnitType(ulquiorraActingUnit,UNIT_TYPE_DEAD)==false
endfunction
function ULQ_NoDecor_Filter takes nothing returns boolean
return GetWidgetLife(GetFilterUnit())>0.405 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),0x416C6F63)==0
endfunction
function ULQ_StunUnit takes unit ulquiorraCasterUnit,unit ulquiorraStunnedUnit,integer ulquiorraStunLevel returns nothing
local integer i=GetPlayerId(GetOwningPlayer(ulquiorraCasterUnit))
if GetUnitAbilityLevel(ulquiorraStunnedUnit,0x41303041)==0 and GetUnitAbilityLevel(ulquiorraStunnedUnit,0x4F495F31)==0 and GetUnitAbilityLevel(ulquiorraStunnedUnit,0x41303653)==0 and GetUnitAbilityLevel(ulquiorraStunnedUnit,0x41303657)==0 then
call SetUnitX(ULQ_GetDummy(i),GetUnitX(ulquiorraStunnedUnit))
call SetUnitY(ULQ_GetDummy(i),GetUnitY(ulquiorraStunnedUnit))
