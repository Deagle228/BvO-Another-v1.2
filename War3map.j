call SaveReal(ULQ_HashTable,-12215,this,Atan2(LoadReal(ULQ_HashTable,-12204,this)-GetUnitY(LoadUnitHandle(ULQ_HashTable,-12202,this)),LoadReal(ULQ_HashTable,-12203,this)-GetUnitX(LoadUnitHandle(ULQ_HashTable,-12202,this))))
call SaveReal(ULQ_HashTable,-12216,this,0.8)
call SaveUnitHandle(ULQ_HashTable,-12207,this,CreateUnit(GetOwningPlayer(LoadUnitHandle(ULQ_HashTable,-12202,this)),0x6D303135,GetUnitX(LoadUnitHandle(ULQ_HashTable,-12202,this))+130*Cos(LoadReal(ULQ_HashTable,-12215,this)),GetUnitY(LoadUnitHandle(ULQ_HashTable,-12202,this))+130*Sin(LoadReal(ULQ_HashTable,-12215,this)),LoadReal(ULQ_HashTable,-12215,this)*bj_RADTODEG))
