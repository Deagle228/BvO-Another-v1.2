function ULQ_WBlockDamage takes nothing returns nothing
local integer level=GetUnitAbilityLevel(Target,'ZZ02')
local integer form=GetUnitTypeId(Target)
local real flat
local real fraction
local real blocked
if level<=0 or Damage<=0. or not IsUnitEnemy(Source,GetOwningPlayer(Target)) or (form!='US00' and form!='US1_' and form!='US2_') then
return
endif
set flat=I2R(GetHeroInt(Target,true))*.2
set fraction=.03+I2R(level)*.01
if form=='US1_' then
set flat=flat+I2R(GetHeroInt(Target,true))*.1
set fraction=fraction+.01
elseif form=='US2_' then
set flat=flat+I2R(GetHeroInt(Target,true))*.2
set fraction=fraction+.02
endif
set blocked=Damage*fraction+flat
if blocked>Damage*.9 then
set blocked=Damage*.9
endif
call SetWidgetLife(Target,GetWidgetLife(Target)+blocked)
set Damage=Damage-blocked
endfunction

// Trafalgar Law, ported from FOCS Another 10.1 (LowQ01/LowW01/LowE01/LowR01/LowC01/LowV01).
// Isolated from FOCS shared systems; ability levels come from the learned hero abilities.
function TLLawInRoom takes unit lawHero returns boolean
local group roomScan
local unit roomDummy
local boolean lawIsInside=false
local real roomDeltaX
local real roomDeltaY
if lawHero==null or TLRooms==null then
return false
endif
set roomScan=CreateGroup()
call GroupAddGroup(TLRooms,roomScan)
loop
set roomDummy=FirstOfGroup(roomScan)
exitwhen roomDummy==null
call GroupRemoveUnit(roomScan,roomDummy)
if GetUnitTypeId(roomDummy)!=0 and GetWidgetLife(roomDummy)>.405 and GetOwningPlayer(roomDummy)==GetOwningPlayer(lawHero) then
set roomDeltaX=GetUnitX(lawHero)-GetUnitX(roomDummy)
set roomDeltaY=GetUnitY(lawHero)-GetUnitY(roomDummy)
if roomDeltaX*roomDeltaX+roomDeltaY*roomDeltaY<=1080.*1080. then
set lawIsInside=true
endif
endif
endloop
call DestroyGroup(roomScan)
set roomScan=null
set roomDummy=null
return lawIsInside
endfunction
function TLCreateEffect takes player effectOwner,real effectX,real effectY,real effectFacing,string effectModel,real effectScale,real effectTimeScale,real effectLife,integer effectRed,integer effectGreen,integer effectBlue,integer effectAlpha returns unit
local unit effectCarrier=CreateUnit(effectOwner,'hL04',effectX,effectY,effectFacing)
call UnitApplyTimedLife(effectCarrier,'BTLF',effectLife)
call AddSpecialEffectTarget(effectModel,effectCarrier,"origin")
call SetUnitScale(effectCarrier,effectScale,effectScale,effectScale)
call SetUnitTimeScale(effectCarrier,effectTimeScale)
call SetUnitFlyHeight(effectCarrier,1.,1000000000.)
call SetUnitVertexColor(effectCarrier,effectRed,effectGreen,effectBlue,effectAlpha)
call SetUnitAnimationByIndex(effectCarrier,90)
set TLLastEffect=effectCarrier
set effectCarrier=null
return TLLastEffect
endfunction
function TLDestroyEffectTick takes nothing returns nothing
local timer effectTimer=GetExpiredTimer()
call DestroyEffect(LoadEffectHandle(TLHash,GetHandleId(effectTimer),StringHash("effect")))
call FlushChildHashtable(TLHash,GetHandleId(effectTimer))
call DestroyTimer(effectTimer)
set effectTimer=null
endfunction
function TLDestroyEffectLater takes effect delayedEffect,real effectDelay returns nothing
local timer effectTimer=CreateTimer()
call SaveEffectHandle(TLHash,GetHandleId(effectTimer),StringHash("effect"),delayedEffect)
call TimerStart(effectTimer,effectDelay,false,function TLDestroyEffectTick)
set effectTimer=null
endfunction
function TLStun takes unit lawHero,unit stunTarget,integer stunLevel returns nothing
local unit stunCaster
if stunTarget==null or GetWidgetLife(stunTarget)<=.405 then
return
endif
set stunCaster=CreateUnit(GetOwningPlayer(lawHero),'hL02',GetUnitX(stunTarget)-16.,GetUnitY(stunTarget),0.)
call UnitAddAbility(stunCaster,'AL0S')
call SetUnitAbilityLevel(stunCaster,'AL0S',stunLevel)
call UnitApplyTimedLife(stunCaster,'BTLF',1.)
call IssueTargetOrder(stunCaster,"thunderbolt",stunTarget)
set stunCaster=null
endfunction
function TLDamageArea takes unit lawHero,real areaX,real areaY,real areaRadius,real areaDamage,integer stunLevel,integer damageKind returns nothing
local group areaTargets=CreateGroup()
local unit areaTarget
call GroupEnumUnitsInRange(areaTargets,areaX,areaY,areaRadius,null)
loop
set areaTarget=FirstOfGroup(areaTargets)
exitwhen areaTarget==null
call GroupRemoveUnit(areaTargets,areaTarget)
if IsUnitEnemy(areaTarget,GetOwningPlayer(lawHero)) and GetWidgetLife(areaTarget)>.405 then
if areaDamage>0. then
if damageKind==MAGICAL then
call BvOHeroSpellDamage(lawHero,areaTarget,areaDamage,true,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC)
else
call BvOKindSpellDamage(lawHero,areaTarget,areaDamage,true,damageKind)
endif
endif
if stunLevel>0 then
call TLStun(lawHero,areaTarget,stunLevel)
endif
endif
endloop
call DestroyGroup(areaTargets)
set areaTargets=null
set areaTarget=null
endfunction
function TLSlideTick takes nothing returns nothing
local timer slideTimer=GetExpiredTimer()
local integer slideKey=GetHandleId(slideTimer)
local unit slidingUnit=LoadUnitHandle(TLHash,slideKey,StringHash("unit"))
local real slideRemaining=LoadReal(TLHash,slideKey,StringHash("remaining"))
local real slideStep=LoadReal(TLHash,slideKey,StringHash("step"))
local real slideAngle=LoadReal(TLHash,slideKey,StringHash("angle"))
if slideRemaining<=0. or GetUnitTypeId(slidingUnit)==0 then
call FlushChildHashtable(TLHash,slideKey)
call PauseTimer(slideTimer)
call DestroyTimer(slideTimer)
else
call SetUnitPosition(slidingUnit,GetUnitX(slidingUnit)+slideStep*Cos(slideAngle),GetUnitY(slidingUnit)+slideStep*Sin(slideAngle))
call SaveReal(TLHash,slideKey,StringHash("remaining"),slideRemaining-slideStep)
endif
set slideTimer=null
set slidingUnit=null
endfunction
function TLSlide takes unit slidingUnit,real slideTargetX,real slideTargetY,real slideDuration,real slideInterval returns nothing
local timer slideTimer=CreateTimer()
local integer slideKey=GetHandleId(slideTimer)
local real slideDeltaX=slideTargetX-GetUnitX(slidingUnit)
local real slideDeltaY=slideTargetY-GetUnitY(slidingUnit)
local real slideDistance=SquareRoot(slideDeltaX*slideDeltaX+slideDeltaY*slideDeltaY)
call SaveUnitHandle(TLHash,slideKey,StringHash("unit"),slidingUnit)
call SaveReal(TLHash,slideKey,StringHash("remaining"),slideDistance)
call SaveReal(TLHash,slideKey,StringHash("step"),slideDistance/(slideDuration/slideInterval))
call SaveReal(TLHash,slideKey,StringHash("angle"),Atan2(slideDeltaY,slideDeltaX))
call TimerStart(slideTimer,slideInterval,true,function TLSlideTick)
set slideTimer=null
endfunction
function TLShakeEnd takes nothing returns nothing
local timer shakeTimer=GetExpiredTimer()
call CameraClearNoiseForPlayer(LoadPlayerHandle(TLHash,GetHandleId(shakeTimer),StringHash("player")))
call FlushChildHashtable(TLHash,GetHandleId(shakeTimer))
call DestroyTimer(shakeTimer)
set shakeTimer=null
endfunction
function TLShakeCamera takes player shakePlayer,real shakeMagnitude,real shakeDuration returns nothing
local timer shakeTimer=CreateTimer()
call CameraSetEQNoiseForPlayer(shakePlayer,shakeMagnitude)
call SavePlayerHandle(TLHash,GetHandleId(shakeTimer),StringHash("player"),shakePlayer)
call TimerStart(shakeTimer,shakeDuration,false,function TLShakeEnd)
set shakeTimer=null
endfunction
function TLStopTimer takes timer spellTimer returns nothing
call FlushChildHashtable(TLHash,GetHandleId(spellTimer))
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endfunction
// ------------------------------------------------------------------ Q: Counter Shock
// Trafalgar Law balance (15.10): values per level
function TLCounterShockInner takes integer spellLevel returns real
if spellLevel>=6 then
return 500.
endif
return 30.+70.*I2R(spellLevel)
endfunction
function TLGammaKnifePulseBase takes integer spellLevel returns real
if spellLevel<=1 then
return 1000.
elseif spellLevel==2 then
return 1200.
elseif spellLevel==3 then
return 1500.
elseif spellLevel==4 then
return 1700.
endif
return 2000.
endfunction
function TLGammaKnifeFinish takes integer spellLevel returns real
return 200.*spellLevel
endfunction
function TLAmputateLength takes integer spellLevel returns real
if spellLevel>=5 then
return 2000.
endif
return 1400.+100.*I2R(spellLevel)
endfunction
// R: AL04 is the learned skill (hidden), AL07 the button: levels 1-5, or 6-10 (shorter cooldown) with Oken
function TLSyncAmputate takes unit lawHero returns nothing
local integer learnedLevel=GetUnitAbilityLevel(lawHero,'AL04')
local integer wantedLevel=learnedLevel
if learnedLevel>0 and FSHasSceptre(lawHero) then
set wantedLevel=learnedLevel+5
endif
if wantedLevel==0 then
if GetUnitAbilityLevel(lawHero,'AL07')>0 then
call UnitRemoveAbility(lawHero,'AL07')
endif
else
if GetUnitAbilityLevel(lawHero,'AL07')==0 then
call UnitAddAbility(lawHero,'AL07')
call UnitMakeAbilityPermanent(lawHero,true,'AL07')
endif
if GetUnitAbilityLevel(lawHero,'AL07')!=wantedLevel then
call SetUnitAbilityLevel(lawHero,'AL07',wantedLevel)
endif
endif
endfunction
function TLCounterShockTick takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit lawHero=LoadUnitHandle(TLHash,spellKey,StringHash("caster"))
local integer spellTick=LoadInteger(TLHash,spellKey,StringHash("tick"))+1
local integer spellLevel=LoadInteger(TLHash,spellKey,StringHash("level"))
local real centerX=LoadReal(TLHash,spellKey,StringHash("x"))
local real centerY=LoadReal(TLHash,spellKey,StringHash("y"))
local real spellFacing=LoadReal(TLHash,spellKey,StringHash("facing"))
local player lawOwner=GetOwningPlayer(lawHero)
call SaveInteger(TLHash,spellKey,StringHash("tick"),spellTick)
if spellTick==1 then
call PauseUnit(lawHero,false)
call TLCreateEffect(lawOwner,centerX,centerY,spellFacing,"Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",8.,3.,1.,255,1,1,255)
call TimerStart(spellTimer,.2,false,function TLCounterShockTick)
else
call TLCreateEffect(lawOwner,centerX,centerY,spellFacing,"Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",2.,1.,1.,255,255,255,255)
call TLCreateEffect(lawOwner,centerX,centerY,spellFacing,"Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",5.,1.,1.,255,1,1,255)
if GetUnitTypeId(lawHero)!=0 then
call TLDamageArea(lawHero,centerX,centerY,430.,200.*I2R(spellLevel)+GetHeroStr(lawHero,true)*.5,4,PHYSICAL)
call TLDamageArea(lawHero,centerX,centerY,280.,TLCounterShockInner(spellLevel),0,PHYSICAL)
endif
call TLStopTimer(spellTimer)
endif
set spellTimer=null
set lawHero=null
set lawOwner=null
endfunction
function TLCounterShock takes unit lawHero returns nothing
local timer spellTimer=CreateTimer()
local integer spellKey=GetHandleId(spellTimer)
local real spellFacing=GetUnitFacing(lawHero)
call StartSound(TLSoundQ)
call PauseUnit(lawHero,true)
call TLCreateEffect(GetOwningPlayer(lawHero),GetUnitX(lawHero),GetUnitY(lawHero),spellFacing,"war3mapImported\\Wake.mdl",.7,10.,1.,255,255,255,255)
call SaveUnitHandle(TLHash,spellKey,StringHash("caster"),lawHero)
call SaveInteger(TLHash,spellKey,StringHash("level"),GetUnitAbilityLevel(lawHero,'AL01'))
call SaveReal(TLHash,spellKey,StringHash("x"),GetUnitX(lawHero))
call SaveReal(TLHash,spellKey,StringHash("y"),GetUnitY(lawHero))
call SaveReal(TLHash,spellKey,StringHash("facing"),spellFacing)
call SaveInteger(TLHash,spellKey,StringHash("tick"),0)
call TimerStart(spellTimer,.3,false,function TLCounterShockTick)
set spellTimer=null
endfunction
// ------------------------------------------------------------------ W: Takt
function TLTaktTick takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit lawHero=LoadUnitHandle(TLHash,spellKey,StringHash("caster"))
local integer spellTick=LoadInteger(TLHash,spellKey,StringHash("tick"))+1
local integer spellLevel=LoadInteger(TLHash,spellKey,StringHash("level"))
local real casterX=LoadReal(TLHash,spellKey,StringHash("casterX"))
local real casterY=LoadReal(TLHash,spellKey,StringHash("casterY"))
local real targetX=LoadReal(TLHash,spellKey,StringHash("targetX"))
local real targetY=LoadReal(TLHash,spellKey,StringHash("targetY"))
local player lawOwner=LoadPlayerHandle(TLHash,spellKey,StringHash("owner"))
local integer rockIndex=1
local integer rockRequiredLevel
local unit rock
local unit rockDebris
local real rockAngle
local real rockDistance
local real rockX
local real rockY
call SaveInteger(TLHash,spellKey,StringHash("tick"),spellTick)
if spellTick==42 then
call StartSound(TLSoundW)
endif
loop
exitwhen rockIndex>6
if rockIndex<=2 then
set rockRequiredLevel=1
else
set rockRequiredLevel=rockIndex-1
endif
if spellLevel>=rockRequiredLevel then
if spellTick==1+5*(rockIndex-1) then
set rockAngle=GetRandomReal(0.,360.)*bj_DEGTORAD
set rockDistance=GetRandomReal(100.,200.)
set rockX=casterX+rockDistance*Cos(rockAngle)
set rockY=casterY+rockDistance*Sin(rockAngle)
set rock=CreateUnit(lawOwner,'hL03',rockX,rockY,GetRandomReal(0.,360.))
if rockIndex<=2 then
call UnitApplyTimedLife(rock,'BTLF',2.5)
else
call UnitApplyTimedLife(rock,'BTLF',3.)
endif
call AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",rock,"origin")
call SetUnitScale(rock,GetRandomReal(.6,.8),GetRandomReal(.6,.8),GetRandomReal(.6,.8))
call SetUnitFlyHeight(rock,GetRandomReal(400.,600.),2000.)
call SetUnitVertexColor(rock,255,110,50,255)
call SetUnitAnimationByIndex(rock,90)
call SaveUnitHandle(TLHash,spellKey,rockIndex,rock)
set rockDebris=CreateUnit(lawOwner,'hL03',rockX,rockY,GetRandomReal(0.,360.))
call UnitApplyTimedLife(rockDebris,'BTLF',5.1)
call KillUnit(rockDebris)
call SetUnitScale(rockDebris,GetRandomReal(.8,1.2),GetRandomReal(.8,1.2),GetRandomReal(.8,1.2))
call SetUnitTimeScale(rockDebris,.5)
call SetUnitFlyHeight(rockDebris,1.,10000000.)
call SetUnitVertexColor(rockDebris,255,110,50,255)
call SetUnitAnimationByIndex(rockDebris,90)
endif
if spellTick==51+5*(rockIndex-1) then
set rock=LoadUnitHandle(TLHash,spellKey,rockIndex)
set rockAngle=GetRandomReal(0.,360.)*bj_DEGTORAD
if ModuloInteger(rockIndex,2)==1 then
set rockDistance=GetRandomReal(125.,250.)
else
set rockDistance=GetRandomReal(50.,175.)
endif
if GetUnitTypeId(rock)!=0 then
call TLSlide(rock,targetX+rockDistance*Cos(rockAngle),targetY+rockDistance*Sin(rockAngle),.15,.01)
call SetUnitFlyHeight(rock,0.,3000.)
endif
endif
if spellTick==60+5*(rockIndex-1) then
set rock=LoadUnitHandle(TLHash,spellKey,rockIndex)
if GetUnitTypeId(rock)!=0 then
set rockX=GetUnitX(rock)
set rockY=GetUnitY(rock)
call TLCreateEffect(lawOwner,rockX,rockY,GetRandomReal(0.,360.),"war3mapImported\\GroundSlamEX.mdl",.5,10.,3.,255,255,255,255)
call TLCreateEffect(lawOwner,rockX,rockY,GetRandomReal(0.,360.),"WarStompCaster.mdl",1.3,10.,3.,255,255,255,255)
if GetUnitTypeId(lawHero)!=0 then
call TLDamageArea(lawHero,rockX,rockY,300.,125.*I2R(spellLevel)+GetHeroStr(lawHero,true),2,PHYSICAL)
endif
call KillUnit(rock)
endif
endif
endif
set rockIndex=rockIndex+1
endloop
if spellTick>=100 then
call TLStopTimer(spellTimer)
endif
set spellTimer=null
set lawHero=null
set lawOwner=null
set rock=null
set rockDebris=null
endfunction
function TLTakt takes unit lawHero,real targetX,real targetY returns nothing
local timer spellTimer=CreateTimer()
local integer spellKey=GetHandleId(spellTimer)
call StartSound(TLSoundWCast)
call SaveUnitHandle(TLHash,spellKey,StringHash("caster"),lawHero)
call SavePlayerHandle(TLHash,spellKey,StringHash("owner"),GetOwningPlayer(lawHero))
call SaveInteger(TLHash,spellKey,StringHash("level"),GetUnitAbilityLevel(lawHero,'AL02'))
call SaveReal(TLHash,spellKey,StringHash("casterX"),GetUnitX(lawHero))
call SaveReal(TLHash,spellKey,StringHash("casterY"),GetUnitY(lawHero))
call SaveReal(TLHash,spellKey,StringHash("targetX"),targetX)
call SaveReal(TLHash,spellKey,StringHash("targetY"),targetY)
call SaveInteger(TLHash,spellKey,StringHash("tick"),0)
call TimerStart(spellTimer,.02,true,function TLTaktTick)
set spellTimer=null
endfunction
// ------------------------------------------------------------------ E: Gamma Knife
function TLGammaKnifeTick takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit lawHero=LoadUnitHandle(TLHash,spellKey,StringHash("caster"))
local integer spellTick=LoadInteger(TLHash,spellKey,StringHash("tick"))+1
local integer spellLevel=LoadInteger(TLHash,spellKey,StringHash("level"))
local real casterX=LoadReal(TLHash,spellKey,StringHash("casterX"))
local real casterY=LoadReal(TLHash,spellKey,StringHash("casterY"))
local real targetX=LoadReal(TLHash,spellKey,StringHash("targetX"))
local real targetY=LoadReal(TLHash,spellKey,StringHash("targetY"))
local real spellFacing=LoadReal(TLHash,spellKey,StringHash("facing"))
local player lawOwner=GetOwningPlayer(lawHero)
local real finishDamage
call SaveInteger(TLHash,spellKey,StringHash("tick"),spellTick)
if GetUnitTypeId(lawHero)==0 then
call TLStopTimer(spellTimer)
set spellTimer=null
return
endif
if spellTick==20 then
call ShowUnit(lawHero,false)
call SetUnitPosition(lawHero,targetX,targetY)
call TLCreateEffect(lawOwner,casterX,casterY,spellFacing,"canying.mdl",1.,10.,.3,255,255,255,255)
call TLCreateEffect(lawOwner,casterX,casterY,spellFacing,"az_firering1a.mdl",1.5,10.,1.,255,255,255,255)
call SetUnitScale(TLLastEffect,1.5,1.5,.1)
endif
if spellTick>=30 and spellTick<=60 and ModuloInteger(spellTick,4)==0 then
call TLCreateEffect(lawOwner,targetX,targetY,spellFacing,"File000004912.mdl",2.,5.,3.,255,255,255,255)
if GetRandomInt(1,100)<=50 then
call TLCreateEffect(lawOwner,targetX,targetY,spellFacing,"Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",5.,1.,1.,200,200,50,255)
else
call TLCreateEffect(lawOwner,targetX,targetY,spellFacing,"Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",5.,1.,1.,10,180,50,255)
endif
call TLCreateEffect(lawOwner,targetX,targetY,spellFacing,"Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",5.,.2,1.,200,200,50,0)
// the pulses follow the finish: 12.5% and 14.6% of it
call TLDamageArea(lawHero,targetX,targetY,400.,R2I(TLGammaKnifePulseBase(spellLevel)*.125+.5),0,MIXED)
call TLDamageArea(lawHero,targetX,targetY,225.,R2I(TLGammaKnifePulseBase(spellLevel)*.146+.5),0,MIXED)
endif
if spellTick==70 then
call TLCreateEffect(lawOwner,targetX,targetY,spellFacing,"Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",5.,.2,1.,200,200,50,255)
endif
if spellTick==75 then
call TLCreateEffect(lawOwner,targetX,targetY,spellFacing,"effect_by_wood_leitingyiji.mdl",2.2,.5,3.,10,100,50,255)
call TLCreateEffect(lawOwner,targetX,targetY,spellFacing,"Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",2.5,1.,1.,50,8,50,255)
set finishDamage=TLGammaKnifeFinish(spellLevel)
if TLLawInRoom(lawHero) then
set finishDamage=finishDamage+2.*GetHeroStr(lawHero,true)
endif
call TLDamageArea(lawHero,targetX,targetY,380.,finishDamage,0,MIXED)
endif
if spellTick>=80 then
call PauseUnit(lawHero,false)
call SetUnitInvulnerable(lawHero,false)
call ShowUnit(lawHero,true)
if GetLocalPlayer()==lawOwner then
call ClearSelection()
call SelectUnit(lawHero,true)
endif
call TLStopTimer(spellTimer)
endif
set spellTimer=null
set lawHero=null
set lawOwner=null
endfunction
function TLGammaKnife takes unit lawHero,real targetX,real targetY returns nothing
local timer spellTimer=CreateTimer()
local integer spellKey=GetHandleId(spellTimer)
call StartSound(TLSoundE)
call PauseUnit(lawHero,true)
call SetUnitInvulnerable(lawHero,true)
call SetUnitAnimationByIndex(lawHero,4)
call SaveUnitHandle(TLHash,spellKey,StringHash("caster"),lawHero)
call SaveInteger(TLHash,spellKey,StringHash("level"),GetUnitAbilityLevel(lawHero,'AL03'))
call SaveReal(TLHash,spellKey,StringHash("casterX"),GetUnitX(lawHero))
call SaveReal(TLHash,spellKey,StringHash("casterY"),GetUnitY(lawHero))
call SaveReal(TLHash,spellKey,StringHash("targetX"),targetX)
call SaveReal(TLHash,spellKey,StringHash("targetY"),targetY)
call SaveReal(TLHash,spellKey,StringHash("facing"),Atan2(targetY-GetUnitY(lawHero),targetX-GetUnitX(lawHero))*bj_RADTODEG)
call SaveInteger(TLHash,spellKey,StringHash("tick"),0)
call TimerStart(spellTimer,.02,true,function TLGammaKnifeTick)
set spellTimer=null
endfunction
// ------------------------------------------------------------------ R: Amputate
function TLAmputateTick takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit lawHero=LoadUnitHandle(TLHash,spellKey,StringHash("caster"))
local integer spellTick=LoadInteger(TLHash,spellKey,StringHash("tick"))+1
local integer spellLevel=LoadInteger(TLHash,spellKey,StringHash("level"))
local real casterX=LoadReal(TLHash,spellKey,StringHash("casterX"))
local real casterY=LoadReal(TLHash,spellKey,StringHash("casterY"))
local real spellAngle=LoadReal(TLHash,spellKey,StringHash("angle"))
local group cutTargets=LoadGroupHandle(TLHash,spellKey,StringHash("targets"))
local player lawOwner=LoadPlayerHandle(TLHash,spellKey,StringHash("owner"))
local group waveScan
local unit cutTarget
local unit waveCarrier
local real waveX
local real waveY
call SaveInteger(TLHash,spellKey,StringHash("tick"),spellTick)
if spellTick==1 then
set waveCarrier=TLCreateEffect(lawOwner,casterX,casterY,spellAngle*bj_RADTODEG,"!getsuga1!.mdl",.1,10.,.7,255,255,255,255)
call TLSlide(waveCarrier,casterX+TLAmputateLength(spellLevel)*Cos(spellAngle),casterY+TLAmputateLength(spellLevel)*Sin(spellAngle),.2,.01)
endif
if spellTick<25 then
set waveX=casterX+TLAmputateLength(spellLevel)/25.*I2R(spellTick)*Cos(spellAngle)
set waveY=casterY+TLAmputateLength(spellLevel)/25.*I2R(spellTick)*Sin(spellAngle)
set waveCarrier=TLCreateEffect(lawOwner,waveX,waveY,spellAngle*bj_RADTODEG,"!getsuga1!.mdl",.3*I2R(spellTick),10.,.5,150,150,255,255)
call TLSlide(waveCarrier,casterX+TLAmputateLength(spellLevel)*Cos(spellAngle),casterY+TLAmputateLength(spellLevel)*Sin(spellAngle),.2,.01)
call TLCreateEffect(lawOwner,waveX,waveY,spellAngle*bj_RADTODEG,"war3mapImported\\az_firering1a.mdl",3.,10.,.7,255,255,255,255)
if GetUnitTypeId(lawHero)!=0 then
set waveScan=CreateGroup()
call GroupEnumUnitsInRange(waveScan,waveX,waveY,400.,null)
loop
set cutTarget=FirstOfGroup(waveScan)
exitwhen cutTarget==null
call GroupRemoveUnit(waveScan,cutTarget)
if IsUnitEnemy(cutTarget,lawOwner) and GetWidgetLife(cutTarget)>.405 and not IsUnitInGroup(cutTarget,cutTargets) then
call TLStun(lawHero,cutTarget,3)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",cutTarget,"origin"))
call GroupAddUnit(cutTargets,cutTarget)
endif
endloop
call DestroyGroup(waveScan)
endif
endif
if spellTick==65 then
loop
set cutTarget=FirstOfGroup(cutTargets)
exitwhen cutTarget==null
call GroupRemoveUnit(cutTargets,cutTarget)
if GetUnitTypeId(lawHero)!=0 and IsUnitEnemy(cutTarget,lawOwner) and GetWidgetLife(cutTarget)>.405 then
call BvOHeroSpellDamage(lawHero,cutTarget,500.*I2R(spellLevel)+1000.+2.*GetHeroInt(lawHero,true)+2.*GetHeroStr(lawHero,false),true,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\SlashCRIT.mdl",cutTarget,"origin"))
endif
endloop
endif
if spellTick>=70 then
call DestroyGroup(cutTargets)
call TLStopTimer(spellTimer)
endif
set spellTimer=null
set lawHero=null
set lawOwner=null
set cutTargets=null
set waveScan=null
set cutTarget=null
set waveCarrier=null
endfunction
function TLAmputate takes unit lawHero,real targetX,real targetY returns nothing
local timer spellTimer=CreateTimer()
local integer spellKey=GetHandleId(spellTimer)
call StartSound(TLSoundR)
call SetUnitAnimationByIndex(lawHero,0)
call TLShakeCamera(GetOwningPlayer(lawHero),15.,1.1)
call SaveUnitHandle(TLHash,spellKey,StringHash("caster"),lawHero)
call SavePlayerHandle(TLHash,spellKey,StringHash("owner"),GetOwningPlayer(lawHero))
call SaveInteger(TLHash,spellKey,StringHash("level"),GetUnitAbilityLevel(lawHero,'AL04'))
call SaveReal(TLHash,spellKey,StringHash("casterX"),GetUnitX(lawHero))
call SaveReal(TLHash,spellKey,StringHash("casterY"),GetUnitY(lawHero))
call SaveReal(TLHash,spellKey,StringHash("angle"),Atan2(targetY-GetUnitY(lawHero),targetX-GetUnitX(lawHero)))
call SaveGroupHandle(TLHash,spellKey,StringHash("targets"),CreateGroup())
call SaveInteger(TLHash,spellKey,StringHash("tick"),0)
call TimerStart(spellTimer,.02,true,function TLAmputateTick)
set spellTimer=null
endfunction
// ------------------------------------------------------------------ T: Room
function TLRoomGrowTick takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit roomDummy=LoadUnitHandle(TLHash,spellKey,StringHash("room"))
local integer spellTick=LoadInteger(TLHash,spellKey,StringHash("tick"))+1
call SaveInteger(TLHash,spellKey,StringHash("tick"),spellTick)
if GetUnitTypeId(roomDummy)!=0 then
call SetUnitScale(roomDummy,1.+.05*I2R(spellTick+1),1.+.05*I2R(spellTick+1),1.+.05*I2R(spellTick+1))
endif
if spellTick>=39 then
call TLStopTimer(spellTimer)
endif
set spellTimer=null
set roomDummy=null
endfunction
function TLRoom takes unit lawHero returns nothing
local timer spellTimer=CreateTimer()
local unit roomDummy
call StartSound(TLSoundRoom)
set roomDummy=TLCreateEffect(GetOwningPlayer(lawHero),GetUnitX(lawHero),GetUnitY(lawHero),GetUnitFacing(lawHero),"Room.mdl",1.01,10.,20.,1,25,50,75)
call UnitAddAbility(roomDummy,'AL0A')
call GroupAddUnit(TLRooms,roomDummy)
call SaveUnitHandle(TLHash,GetHandleId(spellTimer),StringHash("room"),roomDummy)
call SaveInteger(TLHash,GetHandleId(spellTimer),StringHash("tick"),0)
call TimerStart(spellTimer,.02,true,function TLRoomGrowTick)
set spellTimer=null
set roomDummy=null
endfunction
function TLRoomHealTick takes nothing returns nothing
local group roomScan=CreateGroup()
local group healScan=CreateGroup()
local group healedHeroes=CreateGroup()
local unit roomDummy
local unit healedHero
call GroupAddGroup(TLRooms,roomScan)
loop
set roomDummy=FirstOfGroup(roomScan)
exitwhen roomDummy==null
call GroupRemoveUnit(roomScan,roomDummy)
if GetUnitTypeId(roomDummy)==0 or GetWidgetLife(roomDummy)<=.405 then
call GroupRemoveUnit(TLRooms,roomDummy)
else
call GroupEnumUnitsInRange(healScan,GetUnitX(roomDummy),GetUnitY(roomDummy),1080.,null)
loop
set healedHero=FirstOfGroup(healScan)
exitwhen healedHero==null
call GroupRemoveUnit(healScan,healedHero)
if IsUnitType(healedHero,UNIT_TYPE_HERO) and GetWidgetLife(healedHero)>.405 and IsUnitAlly(healedHero,GetOwningPlayer(roomDummy)) and not IsUnitInGroup(healedHero,healedHeroes) then
call GroupAddUnit(healedHeroes,healedHero)
call SetWidgetLife(healedHero,GetWidgetLife(healedHero)+1.+GetUnitState(healedHero,UNIT_STATE_MAX_LIFE)*.013)
endif
endloop
endif
endloop
call DestroyGroup(roomScan)
call DestroyGroup(healScan)
call DestroyGroup(healedHeroes)
set roomScan=null
set healScan=null
set healedHeroes=null
set roomDummy=null
set healedHero=null
endfunction
function TLShamblesLevelTick takes nothing returns nothing
local group heroScan=CreateGroup()
local unit lawHero
local integer wantedLevel
call GroupAddGroup(TLHeroes,heroScan)
loop
set lawHero=FirstOfGroup(heroScan)
exitwhen lawHero==null
call GroupRemoveUnit(heroScan,lawHero)
if GetUnitTypeId(lawHero)!='HL00' then
call GroupRemoveUnit(TLHeroes,lawHero)
else
call TLSyncAmputate(lawHero)
endif
if GetUnitTypeId(lawHero)=='HL00' and GetUnitAbilityLevel(lawHero,'AL06')>0 then
set wantedLevel=1
if TLLawInRoom(lawHero) then
set wantedLevel=2
endif
if GetUnitAbilityLevel(lawHero,'AL06')!=wantedLevel then
call SetUnitAbilityLevel(lawHero,'AL06',wantedLevel)
endif
endif
endloop
call DestroyGroup(heroScan)
set heroScan=null
set lawHero=null
endfunction
// ------------------------------------------------------------------ V: Shambles
function TLShamblesSwap takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit lawHero=LoadUnitHandle(TLHash,spellKey,StringHash("caster"))
local unit swapTarget=LoadUnitHandle(TLHash,spellKey,StringHash("target"))
local real casterX=LoadReal(TLHash,spellKey,StringHash("casterX"))
local real casterY=LoadReal(TLHash,spellKey,StringHash("casterY"))
local real pointX=LoadReal(TLHash,spellKey,StringHash("pointX"))
local real pointY=LoadReal(TLHash,spellKey,StringHash("pointY"))
local real lawX
local real lawY
if GetUnitTypeId(lawHero)!=0 and GetWidgetLife(lawHero)>.405 then
call StartSound(TLSoundV)
call TLDestroyEffectLater(AddSpecialEffectTarget("war3mapImported\\kaizokusfxbyvalk3.mdl",lawHero,"origin"),1.)
set lawX=GetUnitX(lawHero)
set lawY=GetUnitY(lawHero)
if swapTarget!=null and GetUnitTypeId(swapTarget)!=0 and GetWidgetLife(swapTarget)>.405 then
call TLDestroyEffectLater(AddSpecialEffectTarget("war3mapImported\\kaizokusfxbyvalk3.mdl",swapTarget,"origin"),1.)
call SetUnitPosition(lawHero,GetUnitX(swapTarget),GetUnitY(swapTarget))
call SetUnitPosition(swapTarget,lawX,lawY)
elseif swapTarget==null then
call DestroyEffect(AddSpecialEffect("canying.mdl",lawX,lawY))
call SetUnitPosition(lawHero,pointX,pointY)
endif
endif
call SetUnitPathing(lawHero,true)
call TLStopTimer(spellTimer)
set spellTimer=null
set lawHero=null
set swapTarget=null
endfunction
function TLShambles takes unit lawHero,unit swapTarget,real pointX,real pointY returns nothing
local timer spellTimer=CreateTimer()
local integer spellKey=GetHandleId(spellTimer)
call SetUnitPathing(lawHero,false)
if swapTarget!=null and IsUnitEnemy(swapTarget,GetOwningPlayer(lawHero)) then
call TLStun(lawHero,swapTarget,1)
endif
call SaveUnitHandle(TLHash,spellKey,StringHash("caster"),lawHero)
call SaveUnitHandle(TLHash,spellKey,StringHash("target"),swapTarget)
call SaveReal(TLHash,spellKey,StringHash("casterX"),GetUnitX(lawHero))
call SaveReal(TLHash,spellKey,StringHash("casterY"),GetUnitY(lawHero))
call SaveReal(TLHash,spellKey,StringHash("pointX"),pointX)
call SaveReal(TLHash,spellKey,StringHash("pointY"),pointY)
if swapTarget!=null and IsUnitType(swapTarget,UNIT_TYPE_HERO) then
call TimerStart(spellTimer,.15,false,function TLShamblesSwap)
else
call TimerStart(spellTimer,.01,false,function TLShamblesSwap)
endif
set spellTimer=null
endfunction
// ------------------------------------------------------------------ events
function TLRemoveMarker takes nothing returns nothing
local timer markerTimer=GetExpiredTimer()
call DestroyEffect(LoadEffectHandle(TLHash,GetHandleId(markerTimer),StringHash("effect")))
call TLStopTimer(markerTimer)
set markerTimer=null
endfunction
function TLCheckCast takes nothing returns boolean
local unit lawHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
local unit spellTarget
local timer markerTimer
if GetUnitTypeId(lawHero)=='HL00' then
if spellId=='AL02' and not TLLawInRoom(lawHero) then
call IssueImmediateOrder(lawHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(lawHero) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00Takt can be used only inside Room!|r")
endif
elseif spellId=='AL06' then
set spellTarget=GetSpellTargetUnit()
if spellTarget==null and not TLLawInRoom(lawHero) then
call IssueImmediateOrder(lawHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(lawHero) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00Shambles needs a target outside Room!|r")
endif
elseif spellTarget!=null and (IsUnitPaused(spellTarget) or IsUnitType(spellTarget,UNIT_TYPE_STRUCTURE)) then
call IssueImmediateOrder(lawHero,"stop")
if GetLocalPlayer()==GetOwningPlayer(lawHero) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00You cannot cast on this target now!|r")
endif
elseif spellTarget!=null and IsUnitType(spellTarget,UNIT_TYPE_HERO) then
set markerTimer=CreateTimer()
call SaveEffectHandle(TLHash,GetHandleId(markerTimer),StringHash("effect"),AddSpecialEffectTarget("Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl",spellTarget,"overhead"))
call TimerStart(markerTimer,.4,false,function TLRemoveMarker)
endif
endif
endif
set lawHero=null
set spellTarget=null
set markerTimer=null
return false
endfunction
function TLOnSpell takes nothing returns boolean
local unit lawHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
if GetUnitTypeId(lawHero)=='HL00' and SilenceConditions(lawHero) then
call GroupAddUnit(TLHeroes,lawHero)
if spellId=='AL01' then
call TLCounterShock(lawHero)
elseif spellId=='AL02' then
call TLTakt(lawHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AL03' then
call TLGammaKnife(lawHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AL04' or spellId=='AL07' then
call TLAmputate(lawHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AL05' then
call TLRoom(lawHero)
elseif spellId=='AL06' then
call TLShambles(lawHero,GetSpellTargetUnit(),GetSpellTargetX(),GetSpellTargetY())
endif
endif
set lawHero=null
return false
endfunction
function TLOnLearn takes nothing returns boolean
if GetUnitTypeId(GetTriggerUnit())=='HL00' then
call GroupAddUnit(TLHeroes,GetTriggerUnit())
endif
return false
endfunction
function TLCreateSound takes string soundPath,integer soundDuration,integer soundVolume returns sound
local sound lawSound=CreateSound(soundPath,false,false,false,10,10,"DefaultEAXON")
call SetSoundDuration(lawSound,soundDuration)
call SetSoundChannel(lawSound,0)
call SetSoundVolume(lawSound,soundVolume)
call SetSoundPitch(lawSound,1.)
set TLLastSound=lawSound
set lawSound=null
return TLLastSound
endfunction
function TLInit takes nothing returns nothing
local trigger castCheckTrigger=CreateTrigger()
local trigger spellTrigger=CreateTrigger()
local trigger learnTrigger=CreateTrigger()
set TLHash=InitHashtable()
set TLRooms=CreateGroup()
set TLHeroes=CreateGroup()
set TLSoundQ=TLCreateSound("war3mapImported\\low Q01.mp3",2717,95)
set TLSoundW=TLCreateSound("war3mapImported\\low W01.mp3",1907,95)
set TLSoundWCast=TLCreateSound("war3mapImported\\low W03.wav",933,95)
set TLSoundE=TLCreateSound("war3mapImported\\low E01.wav",993,115)
set TLSoundR=TLCreateSound("war3mapImported\\low R01.wav",2660,85)
set TLSoundRoom=TLCreateSound("war3mapImported\\low C.mp3",3109,115)
set TLSoundV=TLCreateSound("war3mapImported\\low V01.mp3",1672,115)
call TriggerRegisterAnyUnitEventBJ(castCheckTrigger,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(castCheckTrigger,Condition(function TLCheckCast))
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(spellTrigger,Condition(function TLOnSpell))
call TriggerRegisterAnyUnitEventBJ(learnTrigger,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(learnTrigger,Condition(function TLOnLearn))
call TimerStart(CreateTimer(),1.,true,function TLRoomHealTick)
call TimerStart(CreateTimer(),.1,true,function TLShamblesLevelTick)
set castCheckTrigger=null
set spellTrigger=null
set learnTrigger=null
endfunction
// Donquixote Doflamingo, ported from DreamOnePiece 4.7.2 (Joker_1, Joker_1_1, Joker_1_2, Joker_2, Joker_2_2,
// Joker_3, Joker_4, Joker_5). The GUI globals of the original are replaced by timers with hashtable data,
// so several Doflamingos and several casts can run at the same time.
function DFIsEnemy takes unit candidate,player ownerPlayer returns boolean
return candidate!=null and GetWidgetLife(candidate)>.405 and IsUnitEnemy(candidate,ownerPlayer)
endfunction
function DFInsideMap takes real pointX,real pointY returns boolean
return pointX>GetRectMinX(bj_mapInitialPlayableArea)+32. and pointX<GetRectMaxX(bj_mapInitialPlayableArea)-32. and pointY>GetRectMinY(bj_mapInitialPlayableArea)+32. and pointY<GetRectMaxY(bj_mapInitialPlayableArea)-32.
endfunction
function DFVisualRemoveTick takes nothing returns nothing
local timer visualTimer=GetExpiredTimer()
local unit visualUnit=LoadUnitHandle(DFHash,GetHandleId(visualTimer),0)
call RemoveUnit(visualUnit)
call FlushChildHashtable(DFHash,GetHandleId(visualTimer))
call PauseTimer(visualTimer)
call DestroyTimer(visualTimer)
set visualUnit=null
set visualTimer=null
endfunction
function DFVisualRemoveLater takes unit visualUnit,real visualDuration returns nothing
local timer visualTimer=CreateTimer()
call SaveUnitHandle(DFHash,GetHandleId(visualTimer),0,visualUnit)
call TimerStart(visualTimer,visualDuration,false,function DFVisualRemoveTick)
set visualTimer=null
endfunction
function DFCreateDummy takes player dummyOwner,integer dummyType,real dummyX,real dummyY,real dummyFacing,real dummyLife returns unit
set DFLastDummy=CreateUnit(dummyOwner,dummyType,dummyX,dummyY,dummyFacing)
call UnitApplyTimedLife(DFLastDummy,'BTLF',dummyLife)
return DFLastDummy
endfunction
function DFStopTimer takes timer spellTimer returns nothing
call FlushChildHashtable(DFHash,GetHandleId(spellTimer))
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endfunction
function DFDestroyEffectTick takes nothing returns nothing
local timer effectTimer=GetExpiredTimer()
call DestroyEffect(LoadEffectHandle(DFHash,GetHandleId(effectTimer),0))
call DFStopTimer(effectTimer)
set effectTimer=null
endfunction
function DFDestroyEffectLater takes effect delayedEffect,real effectDelay returns nothing
local timer effectTimer=CreateTimer()
call SaveEffectHandle(DFHash,GetHandleId(effectTimer),0,delayedEffect)
call TimerStart(effectTimer,effectDelay,false,function DFDestroyEffectTick)
set effectTimer=null
endfunction
function DFDamageArea takes unit doflamingo,real areaX,real areaY,real areaRadius,real areaDamage,group alreadyHit,string hitEffect,integer damageKind returns integer
local group areaTargets=CreateGroup()
local unit areaTarget
local player doflamingoOwner=GetOwningPlayer(doflamingo)
local integer hitCount=0
call GroupEnumUnitsInRange(areaTargets,areaX,areaY,areaRadius,null)
loop
set areaTarget=FirstOfGroup(areaTargets)
exitwhen areaTarget==null
call GroupRemoveUnit(areaTargets,areaTarget)
if DFIsEnemy(areaTarget,doflamingoOwner) and (alreadyHit==null or not IsUnitInGroup(areaTarget,alreadyHit)) then
if alreadyHit!=null then
call GroupAddUnit(alreadyHit,areaTarget)
endif
if damageKind==MAGICAL then
call BvOHeroSpellDamage(doflamingo,areaTarget,areaDamage,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
else
call BvOKindSpellDamage(doflamingo,areaTarget,areaDamage,true,damageKind)
endif
if hitEffect!="" then
call DFDestroyEffectLater(AddSpecialEffect(hitEffect,GetUnitX(areaTarget),GetUnitY(areaTarget)),0.5)
endif
set hitCount=hitCount+1
endif
endloop
call DestroyGroup(areaTargets)
set areaTargets=null
set areaTarget=null
set doflamingoOwner=null
return hitCount
endfunction
function DFHasEnemyNear takes player doflamingoOwner,real centerX,real centerY,real searchRadius returns boolean
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
local boolean enemyFound=false
call GroupEnumUnitsInRange(nearbyUnits,centerX,centerY,searchRadius,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null or enemyFound
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
set enemyFound=DFIsEnemy(nearbyUnit,doflamingoOwner)
endloop
call DestroyGroup(nearbyUnits)
set nearbyUnits=null
set nearbyUnit=null
return enemyFound
endfunction
// Tamaito explodes only on an enemy hero: creeps (golems, dragons, big creeps) are cut by the line damage and the
// bullet flies on to the end of its flight
function DFHasEnemyHeroNear takes player doflamingoOwner,real centerX,real centerY,real searchRadius returns boolean
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
local boolean heroFound=false
call GroupEnumUnitsInRange(nearbyUnits,centerX,centerY,searchRadius,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null or heroFound
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
set heroFound=DFIsEnemy(nearbyUnit,doflamingoOwner) and IsUnitType(nearbyUnit,UNIT_TYPE_HERO)
endloop
call DestroyGroup(nearbyUnits)
set nearbyUnits=null
set nearbyUnit=null
return heroFound
endfunction
// Slides a unit in a straight line, fast at first and slowing down to a stop like YDWETimerPatternRushSlide.
// Path mode 0 flies over everything, 1 stops at cliffs and water like the original,
// 2 also stops in front of trees and buildings (used for Doflamingo himself and for knocked back units).
function DFSlideStop takes timer slideTimer returns nothing
if LoadBoolean(DFHash,GetHandleId(slideTimer),7) then
call DestroyEffect(LoadEffectHandle(DFHash,GetHandleId(slideTimer),6))
endif
call DFStopTimer(slideTimer)
endfunction
function DFSlideTick takes nothing returns nothing
local timer slideTimer=GetExpiredTimer()
local integer slideKey=GetHandleId(slideTimer)
local unit slidingUnit=LoadUnitHandle(DFHash,slideKey,0)
local integer stepsLeft=LoadInteger(DFHash,slideKey,1)
local real stepLength=LoadReal(DFHash,slideKey,2)*I2R(stepsLeft)
local real slideAngle=LoadReal(DFHash,slideKey,3)
local integer pathMode=LoadInteger(DFHash,slideKey,4)
local string trailEffect=LoadStr(DFHash,slideKey,5)
local real dfxNextX
local real dfxNextY
local boolean blocked
if stepsLeft<=0 or GetUnitTypeId(slidingUnit)==0 or GetWidgetLife(slidingUnit)<=0.405 then
call DFSlideStop(slideTimer)
else
set dfxNextX=GetUnitX(slidingUnit)+stepLength*Cos(slideAngle)
set dfxNextY=GetUnitY(slidingUnit)+stepLength*Sin(slideAngle)
set blocked=not DFInsideMap(dfxNextX,dfxNextY)
if not blocked and pathMode==1 then
set blocked=IsTerrainPathable(dfxNextX,dfxNextY,PATHING_TYPE_WALKABILITY)
elseif not blocked and pathMode==2 then
set blocked=not FSPointWalkable(dfxNextX,dfxNextY)
endif
if blocked then
call DFSlideStop(slideTimer)
else
call SetUnitX(slidingUnit,dfxNextX)
call SetUnitY(slidingUnit,dfxNextY)
if trailEffect!=null and trailEffect!="" and ModuloInteger(stepsLeft,2)==0 and GetUnitFlyHeight(slidingUnit)<5. then
call DestroyEffect(AddSpecialEffect(trailEffect,dfxNextX,dfxNextY))
endif
call SaveInteger(DFHash,slideKey,1,stepsLeft-1)
if stepsLeft==1 then
call DFSlideStop(slideTimer)
endif
endif
endif
set slideTimer=null
set slidingUnit=null
endfunction
function DFSlide takes unit slidingUnit,real slideAngle,real slideDistance,real slideDuration,integer pathMode,string trailEffect returns nothing
local timer slideTimer
local integer slideKey
local integer slideSteps=R2I(slideDuration/0.02+0.5)
if slideSteps<1 or slideDistance<=0. then
return
endif
set slideTimer=CreateTimer()
set slideKey=GetHandleId(slideTimer)
call SaveUnitHandle(DFHash,slideKey,0,slidingUnit)
call SaveInteger(DFHash,slideKey,1,slideSteps)
// step k has length (steps-k)*unit, the lengths add up to slideDistance
call SaveReal(DFHash,slideKey,2,2.*slideDistance/I2R(slideSteps*(slideSteps+1)))
call SaveReal(DFHash,slideKey,3,slideAngle)
call SaveInteger(DFHash,slideKey,4,pathMode)
if trailEffect=="DF_W_Back" then
call SaveEffectHandle(DFHash,slideKey,6,AddSpecialEffectTarget("DofFX\\WBackTrail.mdx",slidingUnit,"chest"))
call SaveBoolean(DFHash,slideKey,7,true)
call SaveStr(DFHash,slideKey,5,"")
else
call SaveStr(DFHash,slideKey,5,trailEffect)
endif
call TimerStart(slideTimer,0.02,true,function DFSlideTick)
set slideTimer=null
endfunction
function DFShakeEnd takes nothing returns nothing
local timer shakeTimer=GetExpiredTimer()
call CameraClearNoiseForPlayer(LoadPlayerHandle(DFHash,GetHandleId(shakeTimer),0))
call DFStopTimer(shakeTimer)
set shakeTimer=null
endfunction
function DFShakeCamera takes player shakePlayer,real shakeMagnitude,real shakeDuration returns nothing
local timer shakeTimer=CreateTimer()
call CameraSetEQNoiseForPlayer(shakePlayer,shakeMagnitude)
call SavePlayerHandle(DFHash,GetHandleId(shakeTimer),0,shakePlayer)
call TimerStart(shakeTimer,shakeDuration,false,function DFShakeEnd)
set shakeTimer=null
endfunction
function DFStringHandEffects takes unit stringUser returns nothing
call DFDestroyEffectLater(AddSpecialEffectTarget("DofFX\\HandThreads.mdx",stringUser,"hand right"),0.5)
call DFDestroyEffectLater(AddSpecialEffectTarget("DofFX\\HandThreads.mdx",stringUser,"hand left"),0.5)
endfunction
// ------------------------------------------------------------------ Q: Tamaito (parasite string)
// Doflamingo balance (15.10): values per level
function DFTamaitoBlast takes integer spellLevel returns real
if spellLevel<=1 then
return 150.
elseif spellLevel==2 then
return 250.
endif
return 200.*I2R(spellLevel)-200.
endfunction
function DFTamaitoRange takes integer spellLevel returns real
return 900.+100.*I2R(spellLevel/2)
endfunction
function DFCloneChance takes unit doflamingo,integer spellLevel returns real
if FSHasSceptre(doflamingo) then
return 30.+5.*I2R(spellLevel)
endif
return 15.+5.*I2R(spellLevel)
endfunction
function DFOverheatDamage takes integer spellLevel returns real
if spellLevel<=1 then
return 400.
elseif spellLevel==2 then
return 700.
elseif spellLevel==3 then
return 1000.
elseif spellLevel==4 then
return 1200.
endif
return 1500.
endfunction
// T (Birdcage): AD04 is the learned skill (hidden), AD08 the button: levels 1-5, or 6-10 (shorter cooldown) with Oken
// R (Wave of White Lines): AD05 is the learned skill (hidden), AD06 the button (levels 1-5)
function DFSyncWave takes unit doflamingo returns nothing
local integer learnedLevel=GetUnitAbilityLevel(doflamingo,'AD05')
local integer wantedLevel=learnedLevel
set learnedLevel=GetUnitAbilityLevel(doflamingo,'AD04')
set wantedLevel=learnedLevel
if learnedLevel>0 and FSHasSceptre(doflamingo) then
set wantedLevel=learnedLevel+5
endif
if wantedLevel==0 then
if GetUnitAbilityLevel(doflamingo,'AD08')>0 then
call UnitRemoveAbility(doflamingo,'AD08')
endif
else
if GetUnitAbilityLevel(doflamingo,'AD08')==0 then
call UnitAddAbility(doflamingo,'AD08')
call UnitMakeAbilityPermanent(doflamingo,true,'AD08')
endif
if GetUnitAbilityLevel(doflamingo,'AD08')!=wantedLevel then
call SetUnitAbilityLevel(doflamingo,'AD08',wantedLevel)
endif
endif
set learnedLevel=GetUnitAbilityLevel(doflamingo,'AD05')
set wantedLevel=learnedLevel
if wantedLevel==0 then
if GetUnitAbilityLevel(doflamingo,'AD06')>0 then
call UnitRemoveAbility(doflamingo,'AD06')
endif
else
if GetUnitAbilityLevel(doflamingo,'AD06')==0 then
call UnitAddAbility(doflamingo,'AD06')
call UnitMakeAbilityPermanent(doflamingo,true,'AD06')
endif
if GetUnitAbilityLevel(doflamingo,'AD06')!=wantedLevel then
call SetUnitAbilityLevel(doflamingo,'AD06',wantedLevel)
endif
endif
endfunction
function DFSyncEnum takes nothing returns nothing
if GetUnitTypeId(GetEnumUnit())!='HD00' then
call GroupRemoveUnit(DFHeroes,GetEnumUnit())
else
call DFSyncWave(GetEnumUnit())
endif
endfunction
function DFSyncTick takes nothing returns nothing
call ForGroup(DFHeroes,function DFSyncEnum)
endfunction
function DFTrackHero takes nothing returns boolean
if GetUnitTypeId(GetTriggerUnit())=='HD00' and not IsUnitIllusion(GetTriggerUnit()) then
call GroupAddUnit(DFHeroes,GetTriggerUnit())
call DFSyncWave(GetTriggerUnit())
endif
return false
endfunction
function DFTamaitoExplode takes unit doflamingo,unit stringBullet,integer spellLevel returns nothing
local real blastX=GetUnitX(stringBullet)
local real blastY=GetUnitY(stringBullet)
local unit parasiteCaster=DFCreateDummy(GetOwningPlayer(doflamingo),'hD03',blastX,blastY,0.,1.)
call IssuePointOrder(parasiteCaster,"silence",blastX,blastY)
call DFDestroyEffectLater(AddSpecialEffect("DofFX\\StringBurst.mdx",blastX,blastY),0.5)
call DFDamageArea(doflamingo,blastX,blastY,350.,DFTamaitoBlast(spellLevel)+0.5*I2R(GetHeroStr(doflamingo,true)),null,"",MAGICAL)
call RemoveUnit(stringBullet)
set parasiteCaster=null
endfunction
function DFTamaitoTick takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit doflamingo=LoadUnitHandle(DFHash,spellKey,0)
local unit stringBullet=LoadUnitHandle(DFHash,spellKey,1)
local group alreadyHit=LoadGroupHandle(DFHash,spellKey,2)
local integer spellLevel=LoadInteger(DFHash,spellKey,3)
local integer spellTick=LoadInteger(DFHash,spellKey,4)+1
local real bulletX
local real bulletY
call SaveInteger(DFHash,spellKey,4,spellTick)
if GetUnitTypeId(stringBullet)==0 or GetUnitTypeId(doflamingo)==0 then
call DestroyGroup(alreadyHit)
call DFStopTimer(spellTimer)
else
set bulletX=GetUnitX(stringBullet)
set bulletY=GetUnitY(stringBullet)
call DFDamageArea(doflamingo,bulletX,bulletY,256.,100.*I2R(spellLevel)+0.4*I2R(GetHeroStr(doflamingo,true)),alreadyHit,"",MAGICAL)
if spellTick>=8 or DFHasEnemyHeroNear(GetOwningPlayer(doflamingo),bulletX,bulletY,150.) then
call DFTamaitoExplode(doflamingo,stringBullet,spellLevel)
call DestroyGroup(alreadyHit)
call DFStopTimer(spellTimer)
endif
endif
set spellTimer=null
set doflamingo=null
set stringBullet=null
set alreadyHit=null
endfunction
function DFTamaito takes unit doflamingo,real targetX,real targetY returns nothing
local timer spellTimer=CreateTimer()
local integer spellKey=GetHandleId(spellTimer)
local real casterX=GetUnitX(doflamingo)
local real casterY=GetUnitY(doflamingo)
local real spellAngle=Atan2(targetY-casterY,targetX-casterX)
local player doflamingoOwner=GetOwningPlayer(doflamingo)
call StartSound(DFSoundQ)
call DFCreateDummy(doflamingoOwner,'hD02',casterX,casterY,spellAngle*bj_RADTODEG,1.)
call DFCreateDummy(doflamingoOwner,'hD01',casterX,casterY,spellAngle*bj_RADTODEG,1.)
call SetUnitAnimationByIndex(DFLastDummy,3)
call DFSlide(DFLastDummy,spellAngle,DFTamaitoRange(GetUnitAbilityLevel(doflamingo,'AD01')),0.4,1,"")
call SaveUnitHandle(DFHash,spellKey,0,doflamingo)
call SaveUnitHandle(DFHash,spellKey,1,DFLastDummy)
call SaveGroupHandle(DFHash,spellKey,2,CreateGroup())
call SaveInteger(DFHash,spellKey,3,GetUnitAbilityLevel(doflamingo,'AD01'))
call SaveInteger(DFHash,spellKey,4,0)
call TimerStart(spellTimer,0.05,true,function DFTamaitoTick)
set spellTimer=null
set doflamingoOwner=null
endfunction
// Enemies with the parasite string walk where Doflamingo orders (Joker_1_2).
function DFPuppetOrder takes nothing returns boolean
local unit doflamingo=GetTriggerUnit()
local group puppetScan
local unit puppet
local player doflamingoOwner
local real orderX
local real orderY
if GetUnitTypeId(doflamingo)!='HD00' or GetUnitAbilityLevel(doflamingo,'AD01')<1 then
set doflamingo=null
return false
endif
set doflamingoOwner=GetOwningPlayer(doflamingo)
set orderX=GetOrderPointX()
set orderY=GetOrderPointY()
set puppetScan=CreateGroup()
call GroupEnumUnitsInRange(puppetScan,GetUnitX(doflamingo),GetUnitY(doflamingo),1000.,null)
loop
set puppet=FirstOfGroup(puppetScan)
exitwhen puppet==null
call GroupRemoveUnit(puppetScan,puppet)
if DFIsEnemy(puppet,doflamingoOwner) and GetUnitAbilityLevel(puppet,'BD01')>0 and GetOwningPlayer(puppet)!=Player(PLAYER_NEUTRAL_AGGRESSIVE) and not IsUnitType(puppet,UNIT_TYPE_STRUCTURE) then
call IssuePointOrder(puppet,"move",orderX,orderY)
endif
endloop
call DestroyGroup(puppetScan)
set puppetScan=null
set doflamingo=null
set doflamingoOwner=null
return false
endfunction
// ------------------------------------------------------------------ W: Goshikito and the shadow puppet
function DFGoshikitoSlash takes unit doflamingo,unit slasher,real damageAmount returns nothing
local real slashFacing=GetUnitFacing(slasher)*bj_DEGTORAD
local integer visualStringIndex=0
loop
exitwhen visualStringIndex>=5
call DFCreateDummy(GetOwningPlayer(doflamingo),'hDVW',GetUnitX(slasher)+100.*Cos(slashFacing)-I2R(visualStringIndex-2)*22.*Sin(slashFacing),GetUnitY(slasher)+100.*Sin(slashFacing)+I2R(visualStringIndex-2)*22.*Cos(slashFacing),GetUnitFacing(slasher)+I2R(visualStringIndex-2)*8.,0.6)
call SetUnitAnimationByIndex(DFLastDummy,3)
call SetUnitScale(DFLastDummy,0.55,0.55,0.55)
call DFVisualRemoveLater(DFLastDummy,0.3)
set visualStringIndex=visualStringIndex+1
endloop
call DFDamageArea(doflamingo,GetUnitX(slasher)+180.*Cos(slashFacing),GetUnitY(slasher)+180.*Sin(slashFacing),380.,damageAmount,null,"",PHYSICAL)
endfunction
function DFCloneAlive takes unit doflamingo returns boolean
local unit shadowClone=LoadUnitHandle(DFHash,GetHandleId(doflamingo),StringHash("clone"))
local boolean cloneIsAlive=shadowClone!=null and GetUnitTypeId(shadowClone)=='hD0C' and GetWidgetLife(shadowClone)>0.405
set shadowClone=null
return cloneIsAlive
endfunction
function DFGoshikitoHit takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit doflamingo=LoadUnitHandle(DFHash,spellKey,0)
local integer spellLevel=LoadInteger(DFHash,spellKey,1)
local unit shadowClone
local real cloneX
local real cloneY
local real cloneAngle
if GetUnitTypeId(doflamingo)!=0 and GetWidgetLife(doflamingo)>0.405 then
call DFCreateDummy(GetOwningPlayer(doflamingo),'hD02',GetUnitX(doflamingo),GetUnitY(doflamingo),GetUnitFacing(doflamingo),1.)
call DFGoshikitoSlash(doflamingo,doflamingo,150.+100.*I2R(spellLevel)+0.9*I2R(GetHeroStr(doflamingo,true)))
if GetRandomReal(0.,100.)<DFCloneChance(doflamingo,spellLevel) and not DFCloneAlive(doflamingo) then
set cloneAngle=(GetUnitFacing(doflamingo)+90.)*bj_DEGTORAD
set cloneX=GetUnitX(doflamingo)+160.*Cos(cloneAngle)
set cloneY=GetUnitY(doflamingo)+160.*Sin(cloneAngle)
if not DFInsideMap(cloneX,cloneY) or not FSPointWalkable(cloneX,cloneY) then
set cloneX=GetUnitX(doflamingo)-160.*Cos(cloneAngle)
set cloneY=GetUnitY(doflamingo)-160.*Sin(cloneAngle)
endif
if not DFInsideMap(cloneX,cloneY) or not FSPointWalkable(cloneX,cloneY) then
set cloneX=GetUnitX(doflamingo)
set cloneY=GetUnitY(doflamingo)
endif
set shadowClone=CreateUnit(GetOwningPlayer(doflamingo),'hD0C',cloneX,cloneY,GetUnitFacing(doflamingo))
call ShowUnit(shadowClone,true)
call SetUnitTimeScale(shadowClone,1.)
call SetUnitAnimation(shadowClone,"stand")
call UnitApplyTimedLife(shadowClone,'BFig',10.)
call DFDestroyEffectLater(AddSpecialEffect("DofFX\\CloneWeave.mdx",GetUnitX(shadowClone),GetUnitY(shadowClone)),0.5)
call SetUnitVertexColor(shadowClone,255,255,255,230)
call SaveUnitHandle(DFHash,GetHandleId(doflamingo),StringHash("clone"),shadowClone)
call SaveUnitHandle(DFHash,GetHandleId(shadowClone),StringHash("owner"),doflamingo)
endif
endif
call DFStopTimer(spellTimer)
set spellTimer=null
set doflamingo=null
set shadowClone=null
endfunction
function DFGoshikito takes unit doflamingo,real targetX,real targetY returns nothing
local timer spellTimer=CreateTimer()
local integer spellKey=GetHandleId(spellTimer)
local real casterX=GetUnitX(doflamingo)
local real casterY=GetUnitY(doflamingo)
local real spellAngle=Atan2(targetY-casterY,targetX-casterX)
local real dashDistance=SquareRoot((targetX-casterX)*(targetX-casterX)+(targetY-casterY)*(targetY-casterY))-128.
call StartSound(DFSoundW)
call SetUnitAnimationByIndex(doflamingo,2)
call DFStringHandEffects(doflamingo)
call DFCreateDummy(GetOwningPlayer(doflamingo),'hD04',casterX,casterY,spellAngle*bj_RADTODEG,1.)
call SetUnitFacing(doflamingo,spellAngle*bj_RADTODEG)
call DFSlide(doflamingo,spellAngle,dashDistance,0.2,2,"DF_W_Back")
call SaveUnitHandle(DFHash,spellKey,0,doflamingo)
call SaveInteger(DFHash,spellKey,1,GetUnitAbilityLevel(doflamingo,'AD02'))
call TimerStart(spellTimer,0.18,false,function DFGoshikitoHit)
set spellTimer=null
endfunction
function DFCloneAttack takes nothing returns boolean
local unit shadowClone=GetAttacker()
local unit attackedUnit
local unit doflamingo
local integer spellLevel
if GetUnitTypeId(shadowClone)!='hD0C' then
set shadowClone=null
return false
endif
set doflamingo=LoadUnitHandle(DFHash,GetHandleId(shadowClone),StringHash("owner"))
set attackedUnit=GetTriggerUnit()
if GetUnitTypeId(doflamingo)!=0 and DFIsEnemy(attackedUnit,GetOwningPlayer(doflamingo)) then
set spellLevel=GetUnitAbilityLevel(doflamingo,'AD02')
call BvOHeroSpellDamage(doflamingo,attackedUnit,30.*I2R(spellLevel)+I2R(GetHeroInt(doflamingo,true)),true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
if GetRandomReal(0.,100.)<55. then
call SetUnitAnimationByIndex(shadowClone,2)
call DFStringHandEffects(shadowClone)
call DFGoshikitoSlash(doflamingo,shadowClone,100.*I2R(spellLevel)+0.3*I2R(GetHeroStr(doflamingo,true)))
endif
endif
set shadowClone=null
set attackedUnit=null
set doflamingo=null
return false
endfunction
// ------------------------------------------------------------------ E: Overheat
function DFOverheatHit takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit doflamingo=LoadUnitHandle(DFHash,spellKey,0)
local unit whipTarget=LoadUnitHandle(DFHash,spellKey,1)
local unit whipWave=LoadUnitHandle(DFHash,spellKey,2)
local integer spellLevel=LoadInteger(DFHash,spellKey,3)
local real knockAngle=LoadReal(DFHash,spellKey,4)
local real hitX
local real hitY
if GetUnitTypeId(doflamingo)!=0 then
if GetUnitTypeId(whipWave)!=0 then
set hitX=GetUnitX(whipWave)
set hitY=GetUnitY(whipWave)
else
set hitX=GetUnitX(whipTarget)
set hitY=GetUnitY(whipTarget)
endif
if GetWidgetLife(whipTarget)>0.405 then
call SetUnitAnimation(whipTarget,"death")
endif
call DFDestroyEffectLater(AddSpecialEffect("DofFX\\HeatBurst.mdx",hitX,hitY),0.5)
call DFDamageArea(doflamingo,hitX,hitY,320.,DFOverheatDamage(spellLevel)+I2R(GetHeroStr(doflamingo,true)),null,"",MIXED)
if GetWidgetLife(whipTarget)>0.405 and not IsUnitType(whipTarget,UNIT_TYPE_STRUCTURE) then
call DFSlide(whipTarget,knockAngle,280.,0.5,2,"DofFX\\HeatBurst.mdx")
endif
call DFShakeCamera(GetOwningPlayer(doflamingo),15.,0.5)
endif
call RemoveUnit(whipWave)
call DFStopTimer(spellTimer)
set spellTimer=null
set doflamingo=null
set whipTarget=null
set whipWave=null
endfunction
function DFOverheat takes unit doflamingo,unit whipTarget returns nothing
local timer spellTimer
local integer spellKey
local real casterX=GetUnitX(doflamingo)
local real casterY=GetUnitY(doflamingo)
local real targetDeltaX
local real targetDeltaY
local real spellAngle
local real flightDistance
local player doflamingoOwner=GetOwningPlayer(doflamingo)
local integer rippleIndex=1
local unit stunCaster
if whipTarget==null then
set doflamingoOwner=null
return
endif
set targetDeltaX=GetUnitX(whipTarget)-casterX
set targetDeltaY=GetUnitY(whipTarget)-casterY
set spellAngle=Atan2(targetDeltaY,targetDeltaX)
set flightDistance=SquareRoot(targetDeltaX*targetDeltaX+targetDeltaY*targetDeltaY)+220.
call StartSound(DFSoundE)
loop
exitwhen rippleIndex>2
call DFCreateDummy(doflamingoOwner,'hD05',casterX,casterY,spellAngle*bj_RADTODEG,1.)
call SetUnitScale(DFLastDummy,0.8*I2R(rippleIndex),0.8*I2R(rippleIndex),0.8*I2R(rippleIndex))
call DFCreateDummy(doflamingoOwner,'hD02',casterX,casterY,spellAngle*bj_RADTODEG,1.)
call SetUnitScale(DFLastDummy,0.9*I2R(rippleIndex),0.9*I2R(rippleIndex),0.9*I2R(rippleIndex))
set rippleIndex=rippleIndex+1
endloop
call DFCreateDummy(doflamingoOwner,'hD06',casterX,casterY,spellAngle*bj_RADTODEG,1.)
call DFSlide(DFLastDummy,spellAngle,flightDistance,0.2,0,"")
call DFCreateDummy(doflamingoOwner,'hD07',casterX,casterY,spellAngle*bj_RADTODEG,1.)
call DFSlide(DFLastDummy,spellAngle,flightDistance,0.2,0,"")
if IsUnitEnemy(whipTarget,doflamingoOwner) then
set stunCaster=DFCreateDummy(doflamingoOwner,'hL02',GetUnitX(whipTarget)-16.,GetUnitY(whipTarget),0.,1.)
call UnitAddAbility(stunCaster,'AD0S')
call IssueTargetOrder(stunCaster,"thunderbolt",whipTarget)
endif
set spellTimer=CreateTimer()
set spellKey=GetHandleId(spellTimer)
call SaveUnitHandle(DFHash,spellKey,0,doflamingo)
call SaveUnitHandle(DFHash,spellKey,1,whipTarget)
call SaveUnitHandle(DFHash,spellKey,2,DFLastDummy)
call SaveInteger(DFHash,spellKey,3,GetUnitAbilityLevel(doflamingo,'AD03'))
call SaveReal(DFHash,spellKey,4,spellAngle)
call TimerStart(spellTimer,0.18,false,function DFOverheatHit)
set spellTimer=null
set doflamingoOwner=null
set stunCaster=null
endfunction
// ------------------------------------------------------------------ R: Birdcage
function DFBirdcageVisualTick takes nothing returns nothing
local timer visualTimer=GetExpiredTimer()
local integer visualKey=GetHandleId(visualTimer)
local unit cage=LoadUnitHandle(DFHash,visualKey,0)
local integer dfxFrame=LoadInteger(DFHash,visualKey,1)+1
local real dfxElapsed=0.02*I2R(dfxFrame)
local real dfxRadius
local real dfxFinish
if GetUnitTypeId(cage)==0 or dfxElapsed>=2.03 then
call RemoveUnit(cage)
call DFStopTimer(visualTimer)
else
set dfxRadius=RMaxBJ(0.,1300.*(1.-dfxElapsed/2.))
call SetUnitScale(cage,dfxRadius/1480.,dfxRadius/1480.,dfxRadius/1480.)
call SaveInteger(DFHash,visualKey,1,dfxFrame)
endif
set visualTimer=null
set cage=null
endfunction
function DFBirdcageVisualStart takes unit cage returns nothing
local timer visualTimer=CreateTimer()
call SaveUnitHandle(DFHash,GetHandleId(visualTimer),0,cage)
call SaveInteger(DFHash,GetHandleId(visualTimer),1,0)
call TimerStart(visualTimer,0.02,true,function DFBirdcageVisualTick)
set visualTimer=null
endfunction
function DFBirdcagePullTick takes nothing returns nothing
local timer pullTimer=GetExpiredTimer()
local integer pullKey=GetHandleId(pullTimer)
local unit dfxCaster=LoadUnitHandle(DFHash,pullKey,0)
local group dfxCaught=LoadGroupHandle(DFHash,pullKey,1)
local group dfxScan=CreateGroup()
local unit dfxVictim
local real centerX=LoadReal(DFHash,pullKey,2)
local real centerY=LoadReal(DFHash,pullKey,3)
local integer dfxFrame=LoadInteger(DFHash,pullKey,4)+1
local integer victimKey
local real dfxElapsed=0.02*I2R(dfxFrame)
local real dfxRadius
local real dfxFinish
local real dfxDx
local real dfxDy
local real dfxDistance
local real dfxStep
local real dfxNextX
local real dfxNextY
if GetUnitTypeId(dfxCaster)==0 or dfxElapsed>=2.03 then
call DestroyGroup(dfxCaught)
call DestroyGroup(dfxScan)
call DFStopTimer(pullTimer)
else
set dfxRadius=RMaxBJ(0.,1300.*(1.-dfxElapsed/2.))
call GroupEnumUnitsInRange(dfxScan,centerX,centerY,dfxRadius,null)
loop
set dfxVictim=FirstOfGroup(dfxScan)
exitwhen dfxVictim==null
call GroupRemoveUnit(dfxScan,dfxVictim)
if DFIsEnemy(dfxVictim,GetOwningPlayer(dfxCaster)) and not IsUnitType(dfxVictim,UNIT_TYPE_STRUCTURE) and GetUnitAbilityLevel(dfxVictim,'Aloc')==0 then
set victimKey=GetHandleId(dfxVictim)
if not HaveSavedInteger(DFHash,pullKey,victimKey) then
call SaveInteger(DFHash,pullKey,victimKey,LoadInteger(Hash,victimKey,StringHash("BvORevivalGeneration")))
endif
if LoadInteger(DFHash,pullKey,victimKey)==LoadInteger(Hash,victimKey,StringHash("BvORevivalGeneration")) then
call GroupAddUnit(dfxCaught,dfxVictim)
endif
endif
endloop
loop
set dfxVictim=FirstOfGroup(dfxCaught)
exitwhen dfxVictim==null
call GroupRemoveUnit(dfxCaught,dfxVictim)
set victimKey=GetHandleId(dfxVictim)
if GetUnitTypeId(dfxVictim)!=0 and GetWidgetLife(dfxVictim)>0.405 and LoadInteger(DFHash,pullKey,victimKey)==LoadInteger(Hash,victimKey,StringHash("BvORevivalGeneration")) then
set dfxDx=centerX-GetUnitX(dfxVictim)
set dfxDy=centerY-GetUnitY(dfxVictim)
set dfxDistance=SquareRoot(dfxDx*dfxDx+dfxDy*dfxDy)
if dfxDistance>dfxRadius and dfxDistance>0.01 then
set dfxStep=dfxDistance-dfxRadius
set dfxNextX=GetUnitX(dfxVictim)+dfxStep*dfxDx/dfxDistance
set dfxNextY=GetUnitY(dfxVictim)+dfxStep*dfxDy/dfxDistance
if DFInsideMap(dfxNextX,dfxNextY) and not IsTerrainPathable(dfxNextX,dfxNextY,PATHING_TYPE_WALKABILITY) then
call SetUnitX(dfxVictim,dfxNextX)
call SetUnitY(dfxVictim,dfxNextY)
endif
endif
call GroupAddUnit(dfxScan,dfxVictim)
endif
endloop
call DestroyGroup(dfxCaught)
call SaveGroupHandle(DFHash,pullKey,1,dfxScan)
call SaveInteger(DFHash,pullKey,4,dfxFrame)
endif
set pullTimer=null
set dfxCaster=null
set dfxVictim=null
set dfxCaught=null
set dfxScan=null
endfunction
function DFBirdcagePullStart takes unit dfxCaster,real dfxX,real dfxY returns nothing
local timer pullTimer=CreateTimer()
call SaveUnitHandle(DFHash,GetHandleId(pullTimer),0,dfxCaster)
call SaveGroupHandle(DFHash,GetHandleId(pullTimer),1,CreateGroup())
call SaveReal(DFHash,GetHandleId(pullTimer),2,dfxX)
call SaveReal(DFHash,GetHandleId(pullTimer),3,dfxY)
call SaveInteger(DFHash,GetHandleId(pullTimer),4,0)
call TimerStart(pullTimer,0.02,true,function DFBirdcagePullTick)
set pullTimer=null
endfunction
function DFBirdcageTick takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit doflamingo=LoadUnitHandle(DFHash,spellKey,0)
local integer spellTick=LoadInteger(DFHash,spellKey,1)+1
local integer spellLevel=LoadInteger(DFHash,spellKey,2)
local real cageX=LoadReal(DFHash,spellKey,3)
local real cageY=LoadReal(DFHash,spellKey,4)
local string dfxDamageEffect=""
call SaveInteger(DFHash,spellKey,1,spellTick)
if spellTick==1 then
call DFCreateDummy(GetOwningPlayer(doflamingo),'hD09',cageX,cageY,GetRandomReal(0.,360.),2.3)
call SetUnitScale(DFLastDummy,1300./1480.,1300./1480.,1300./1480.)
call SetUnitAnimationByIndex(DFLastDummy,0)
call SetUnitTimeScale(DFLastDummy,0.)
call DFBirdcageVisualStart(DFLastDummy)
call DFBirdcagePullStart(doflamingo,cageX,cageY)
call SaveUnitHandle(DFHash,spellKey,5,DFLastDummy)
call TimerStart(spellTimer,0.05,true,function DFBirdcageTick)
elseif spellTick<=41 and GetUnitTypeId(doflamingo)!=0 then
if ModuloInteger(spellTick-2,8)==0 then
set dfxDamageEffect="DofFX\\StringBurst.mdx"
endif
call DFDamageArea(doflamingo,cageX,cageY,RMaxBJ(40.,1300.*(1.-0.05*I2R(spellTick-1)/2.)+12.),(200.*I2R(spellLevel)+0.5*I2R(GetHeroStr(doflamingo,true)))/8.,null,dfxDamageEffect,CLEAN)
else
call DFStopTimer(spellTimer)
endif
set spellTimer=null
set doflamingo=null
endfunction
function DFBirdcage takes unit doflamingo returns nothing
local timer spellTimer=CreateTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit shadowClone=LoadUnitHandle(DFHash,GetHandleId(doflamingo),StringHash("clone"))
call StartSound(DFSoundR)
if shadowClone!=null and GetUnitTypeId(shadowClone)=='hD0C' then
call DFDestroyEffectLater(AddSpecialEffect("DofFX\\CloneWeave.mdx",GetUnitX(shadowClone),GetUnitY(shadowClone)),0.4)
call FlushChildHashtable(DFHash,GetHandleId(shadowClone))
call RemoveUnit(shadowClone)
call RemoveSavedHandle(DFHash,GetHandleId(doflamingo),StringHash("clone"))
endif
call SaveUnitHandle(DFHash,spellKey,0,doflamingo)
call SaveInteger(DFHash,spellKey,1,0)
call SaveInteger(DFHash,spellKey,2,GetUnitAbilityLevel(doflamingo,'AD04'))
call SaveReal(DFHash,spellKey,3,GetUnitX(doflamingo))
call SaveReal(DFHash,spellKey,4,GetUnitY(doflamingo))
call TimerStart(spellTimer,0.5,false,function DFBirdcageTick)
set spellTimer=null
set shadowClone=null
endfunction
// ------------------------------------------------------------------ T: Wave of White Lines
function DFTGroundZ takes real dfxX,real dfxY returns real
local location dfxPoint=Location(dfxX,dfxY)
local real dfxHeight=GetLocationZ(dfxPoint)
call RemoveLocation(dfxPoint)
set dfxPoint=null
return dfxHeight+30.
endfunction
function DFTTargetRingTick takes nothing returns nothing
local timer ringTimer=GetExpiredTimer()
local integer ringKey=GetHandleId(ringTimer)
local integer dfxFrame=LoadInteger(DFHash,ringKey,0)+1
local integer dfxDrawn=LoadInteger(DFHash,ringKey,1)
local integer dfxDesired=R2I(I2R(dfxFrame)*64./120.)
local real centerX=LoadReal(DFHash,ringKey,2)
local real centerY=LoadReal(DFHash,ringKey,3)
local real angle0
local real angle1
local real dfxX0
local real dfxY0
local real dfxX1
local real dfxY1
local lightning dfxStrand
if dfxFrame>=128 then
loop
exitwhen dfxDrawn<=0
call DestroyLightning(LoadLightningHandle(DFHash,ringKey,100+dfxDrawn))
set dfxDrawn=dfxDrawn-1
endloop
call DFStopTimer(ringTimer)
else
if dfxDesired>64 then
set dfxDesired=64
endif
loop
exitwhen dfxDrawn>=dfxDesired
set angle0=2.*bj_PI*I2R(dfxDrawn)/64.
set angle1=2.*bj_PI*I2R(dfxDrawn+1)/64.
set dfxX0=centerX+700.*Cos(angle0)
set dfxY0=centerY+700.*Sin(angle0)
set dfxX1=centerX+700.*Cos(angle1)
set dfxY1=centerY+700.*Sin(angle1)
set dfxStrand=AddLightningEx("CLPB",false,dfxX0,dfxY0,DFTGroundZ(dfxX0,dfxY0),dfxX1,dfxY1,DFTGroundZ(dfxX1,dfxY1))
call SetLightningColor(dfxStrand,0.65,0.12,1.,1.)
set dfxDrawn=dfxDrawn+1
call SaveLightningHandle(DFHash,ringKey,100+dfxDrawn,dfxStrand)
endloop
call SaveInteger(DFHash,ringKey,0,dfxFrame)
call SaveInteger(DFHash,ringKey,1,dfxDrawn)
endif
set dfxStrand=null
set ringTimer=null
endfunction
function DFTTargetRingStart takes real dfxX,real dfxY returns nothing
local timer ringTimer=CreateTimer()
call SaveInteger(DFHash,GetHandleId(ringTimer),0,0)
call SaveInteger(DFHash,GetHandleId(ringTimer),1,0)
call SaveReal(DFHash,GetHandleId(ringTimer),2,dfxX)
call SaveReal(DFHash,GetHandleId(ringTimer),3,dfxY)
call TimerStart(ringTimer,0.01,true,function DFTTargetRingTick)
set ringTimer=null
endfunction
function DFTSpawnVisualWave takes player dfxOwner,real dfxX,real dfxY,integer dfxWave,real duration returns nothing
local integer dfxIndex=1
local real angle
loop
exitwhen dfxIndex>32
set angle=11.25*I2R(dfxIndex)+3.75*I2R(dfxWave)
call DFCreateDummy(dfxOwner,'hD08',dfxX+700.*Cos(angle*bj_DEGTORAD),dfxY+700.*Sin(angle*bj_DEGTORAD),angle+180.,2.)
call SetUnitScale(DFLastDummy,1.,1.,1.)
call SetUnitVertexColor(DFLastDummy,255,255,255,255)
call SetUnitFlyHeight(DFLastDummy,90.,0.)
call SetUnitAnimationByIndex(DFLastDummy,0)
call DFVisualRemoveLater(DFLastDummy,duration+0.02)
call DFSlide(DFLastDummy,(angle+180.)*bj_DEGTORAD,700.,duration,0,"")
set dfxIndex=dfxIndex+1
endloop
endfunction
function DFTNextVisualWave takes nothing returns nothing
local timer waveTimer=GetExpiredTimer()
local integer waveKey=GetHandleId(waveTimer)
local integer dfxWave=LoadInteger(DFHash,waveKey,0)+1
local player dfxOwner=LoadPlayerHandle(DFHash,waveKey,1)
local real dfxX=LoadReal(DFHash,waveKey,2)
local real dfxY=LoadReal(DFHash,waveKey,3)
call DFTSpawnVisualWave(dfxOwner,dfxX,dfxY,dfxWave,1.2-0.3*I2R(dfxWave))
if dfxWave>=2 then
call DFStopTimer(waveTimer)
else
call SaveInteger(DFHash,waveKey,0,dfxWave)
endif
set dfxOwner=null
set waveTimer=null
endfunction
function DFTNativeSpiralRender takes timer dfxSpiralTimer,real dfxSpiralElapsed,boolean dfxSpiralCreate returns nothing
local integer dfxSpiralKey=GetHandleId(dfxSpiralTimer)
local real dfxSpiralX=LoadReal(DFHash,dfxSpiralKey,0)
local real dfxSpiralY=LoadReal(DFHash,dfxSpiralKey,1)
local real dfxSpiralZ=LoadReal(DFHash,dfxSpiralKey,3)
local integer dfxSpiralArm=0
local integer dfxSpiralPart
local integer dfxSpiralSlot
local real dfxSpiralT0
local real dfxSpiralT1
local real dfxSpiralA0
local real dfxSpiralA1
local real dfxSpiralR0
local real dfxSpiralR1
local real dfxSpiralX0
local real dfxSpiralY0
local real dfxSpiralX1
local real dfxSpiralY1
local lightning dfxSpiralLine
loop
exitwhen dfxSpiralArm>=3
set dfxSpiralPart=0
loop
exitwhen dfxSpiralPart>=32
set dfxSpiralT0=I2R(dfxSpiralPart)/32.
set dfxSpiralT1=I2R(dfxSpiralPart+1)/32.
set dfxSpiralA0=2.*bj_PI*I2R(dfxSpiralArm)/3.+3.*bj_PI*dfxSpiralT0+0.7*dfxSpiralElapsed
set dfxSpiralA1=2.*bj_PI*I2R(dfxSpiralArm)/3.+3.*bj_PI*dfxSpiralT1+0.7*dfxSpiralElapsed
set dfxSpiralR0=40.+490.*dfxSpiralT0
set dfxSpiralR1=40.+490.*dfxSpiralT1
set dfxSpiralX0=dfxSpiralX+dfxSpiralR0*Cos(dfxSpiralA0)
set dfxSpiralY0=dfxSpiralY+dfxSpiralR0*Sin(dfxSpiralA0)
set dfxSpiralX1=dfxSpiralX+dfxSpiralR1*Cos(dfxSpiralA1)
set dfxSpiralY1=dfxSpiralY+dfxSpiralR1*Sin(dfxSpiralA1)
set dfxSpiralSlot=100+dfxSpiralArm*32+dfxSpiralPart
if dfxSpiralCreate then
set dfxSpiralLine=AddLightningEx("CLPB",false,dfxSpiralX0,dfxSpiralY0,dfxSpiralZ,dfxSpiralX1,dfxSpiralY1,dfxSpiralZ)
call SetLightningColor(dfxSpiralLine,1.,0.12,0.62,1.)
call SaveLightningHandle(DFHash,dfxSpiralKey,dfxSpiralSlot,dfxSpiralLine)
else
set dfxSpiralLine=LoadLightningHandle(DFHash,dfxSpiralKey,dfxSpiralSlot)
call MoveLightningEx(dfxSpiralLine,false,dfxSpiralX0,dfxSpiralY0,dfxSpiralZ,dfxSpiralX1,dfxSpiralY1,dfxSpiralZ)
endif
set dfxSpiralPart=dfxSpiralPart+1
endloop
set dfxSpiralArm=dfxSpiralArm+1
endloop
set dfxSpiralLine=null
endfunction
function DFTNativeSpiralTick takes nothing returns nothing
local timer dfxSpiralTimer=GetExpiredTimer()
local integer dfxSpiralKey=GetHandleId(dfxSpiralTimer)
local integer dfxSpiralFrame=LoadInteger(DFHash,dfxSpiralKey,2)+1
local integer dfxSpiralSlot=100
if dfxSpiralFrame>=40 then
loop
exitwhen dfxSpiralSlot>=196
call DestroyLightning(LoadLightningHandle(DFHash,dfxSpiralKey,dfxSpiralSlot))
set dfxSpiralSlot=dfxSpiralSlot+1
endloop
call DFStopTimer(dfxSpiralTimer)
else
call SaveInteger(DFHash,dfxSpiralKey,2,dfxSpiralFrame)
call DFTNativeSpiralRender(dfxSpiralTimer,0.05*I2R(dfxSpiralFrame),false)
endif
set dfxSpiralTimer=null
endfunction
function DFTNativeSpiralStart takes real dfxSpiralX,real dfxSpiralY returns nothing
local timer dfxSpiralTimer=CreateTimer()
local integer dfxSpiralKey=GetHandleId(dfxSpiralTimer)
call SaveReal(DFHash,dfxSpiralKey,0,dfxSpiralX)
call SaveReal(DFHash,dfxSpiralKey,1,dfxSpiralY)
call SaveInteger(DFHash,dfxSpiralKey,2,0)
call SaveReal(DFHash,dfxSpiralKey,3,DFTGroundZ(dfxSpiralX,dfxSpiralY)+40.)
call DFTNativeSpiralRender(dfxSpiralTimer,0.,true)
call TimerStart(dfxSpiralTimer,0.05,true,function DFTNativeSpiralTick)
set dfxSpiralTimer=null
endfunction
function DFWhiteWaveHit takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit doflamingo=LoadUnitHandle(DFHash,spellKey,0)
local integer spellLevel=LoadInteger(DFHash,spellKey,1)
local real waveX=LoadReal(DFHash,spellKey,2)
local real waveY=LoadReal(DFHash,spellKey,3)
local integer clapIndex=1
local unit parasiteCaster
call DFTNativeSpiralStart(waveX,waveY)
if GetUnitTypeId(doflamingo)!=0 then
set parasiteCaster=DFCreateDummy(GetOwningPlayer(doflamingo),'hDTP',waveX,waveY,0.,1.)
call IssuePointOrder(parasiteCaster,"silence",waveX,waveY)
call DFDamageArea(doflamingo,waveX,waveY,700.,RBValue(spellLevel,600.,1000.,1400.,1600.,2000.,2000.)+2.*I2R(GetHeroStr(doflamingo,false)),null,"",MAGICAL)
endif
call DFStopTimer(spellTimer)
set spellTimer=null
set doflamingo=null
set parasiteCaster=null
endfunction
function DFWhiteWave takes unit doflamingo,real waveX,real waveY returns nothing
local timer spellTimer=CreateTimer()
local integer spellKey=GetHandleId(spellTimer)
local timer waveTimer=CreateTimer()
local integer waveKey=GetHandleId(waveTimer)
call DFTTargetRingStart(waveX,waveY)
call DFTSpawnVisualWave(GetOwningPlayer(doflamingo),waveX,waveY,0,1.2)
call SaveInteger(DFHash,waveKey,0,0)
call SavePlayerHandle(DFHash,waveKey,1,GetOwningPlayer(doflamingo))
call SaveReal(DFHash,waveKey,2,waveX)
call SaveReal(DFHash,waveKey,3,waveY)
call TimerStart(waveTimer,0.3,true,function DFTNextVisualWave)
set waveTimer=null
call SaveUnitHandle(DFHash,spellKey,0,doflamingo)
call SaveInteger(DFHash,spellKey,1,GetUnitAbilityLevel(doflamingo,'AD05'))
call SaveReal(DFHash,spellKey,2,waveX)
call SaveReal(DFHash,spellKey,3,waveY)
call TimerStart(spellTimer,1.2,false,function DFWhiteWaveHit)
set spellTimer=null
endfunction
// ------------------------------------------------------------------ V: Sora no Michi (Sky Road), from Bleach vs One Piece 1.3
// Doflamingo flies on his strings to the target point in 1 second (25 steps of 0.04): paused, invulnerable and 300
// high, the Spell Three animation of his model plays once over the flight. No damage.
// timer keys: 0 hero, 1 target x, 2 target y, 3 step, 4 left hand effect, 5 right hand effect, 6 step length, 7 angle
function DFSkyRoadLand takes timer spellTimer,unit doflamingo returns nothing
local integer spellKey=GetHandleId(spellTimer)
call DestroyEffect(LoadEffectHandle(DFHash,spellKey,4))
call DestroyEffect(LoadEffectHandle(DFHash,spellKey,5))
if GetUnitTypeId(doflamingo)!=0 then
call SetUnitFlyHeight(doflamingo,0.,900.)
call PauseUnit(doflamingo,false)
call SetUnitInvulnerable(doflamingo,false)
call SetUnitPathing(doflamingo,true)
call SetUnitTimeScale(doflamingo,1.)
call SetUnitAnimation(doflamingo,"stand")
endif
call DFStopTimer(spellTimer)
endfunction
function DFSkyRoadTick takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer spellKey=GetHandleId(spellTimer)
local unit doflamingo=LoadUnitHandle(DFHash,spellKey,0)
local integer spellStep=LoadInteger(DFHash,spellKey,3)+1
local real stepLength=LoadReal(DFHash,spellKey,6)
local real flightAngle=LoadReal(DFHash,spellKey,7)
local real nextX
local real nextY
call SaveInteger(DFHash,spellKey,3,spellStep)
if GetUnitTypeId(doflamingo)==0 then
call DFSkyRoadLand(spellTimer,doflamingo)
else
set nextX=GetUnitX(doflamingo)+stepLength*Cos(flightAngle)
set nextY=GetUnitY(doflamingo)+stepLength*Sin(flightAngle)
if DFInsideMap(nextX,nextY) and FSPointWalkable(nextX,nextY) then
call SetUnitX(doflamingo,nextX)
call SetUnitY(doflamingo,nextY)
endif
if spellStep>=25 then
call DFSkyRoadLand(spellTimer,doflamingo)
endif
endif
set spellTimer=null
set doflamingo=null
endfunction
function DFSkyRoad takes unit doflamingo,real targetX,real targetY returns nothing
local timer spellTimer=CreateTimer()
local integer spellKey=GetHandleId(spellTimer)
local real casterX=GetUnitX(doflamingo)
local real casterY=GetUnitY(doflamingo)
local real flightAngle=Atan2(targetY-casterY,targetX-casterX)
call SaveUnitHandle(DFHash,spellKey,0,doflamingo)
call SaveReal(DFHash,spellKey,1,targetX)
call SaveReal(DFHash,spellKey,2,targetY)
call SaveInteger(DFHash,spellKey,3,0)
call SaveReal(DFHash,spellKey,6,SquareRoot((targetX-casterX)*(targetX-casterX)+(targetY-casterY)*(targetY-casterY))/25.)
call SaveReal(DFHash,spellKey,7,flightAngle)
call SaveEffectHandle(DFHash,spellKey,4,AddSpecialEffectTarget("Abilities\\Weapons\\ZigguratMissile\\ZigguratMissile.mdl",doflamingo,"hand left"))
call SaveEffectHandle(DFHash,spellKey,5,AddSpecialEffectTarget("Abilities\\Weapons\\ZigguratMissile\\ZigguratMissile.mdl",doflamingo,"hand right"))
call SetUnitFacing(doflamingo,flightAngle*bj_RADTODEG)
call PauseUnit(doflamingo,true)
call SetUnitInvulnerable(doflamingo,true)
call SetUnitPathing(doflamingo,false)
if UnitAddAbility(doflamingo,'Amrf') then
call UnitRemoveAbility(doflamingo,'Amrf')
endif
call SetUnitFlyHeight(doflamingo,300.,1575.)
// the Spell Three of this model lasts 1 second: the whole flight
call SetUnitAnimation(doflamingo,"spell three")
call SetUnitTimeScale(doflamingo,1.75)
call CreateTextTagUnitBJ("Sora no Michi",doflamingo,0,10.,100,100.,100.,0)
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,100.,90)
call SetTextTagPermanent(bj_lastCreatedTextTag,false)
call SetTextTagLifespan(bj_lastCreatedTextTag,2.)
call SetTextTagFadepoint(bj_lastCreatedTextTag,1.5)
call TimerStart(spellTimer,.022857143,true,function DFSkyRoadTick)
set spellTimer=null
endfunction
// ------------------------------------------------------------------ events
function DFOnSpell takes nothing returns boolean
local unit doflamingo=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
if GetUnitTypeId(doflamingo)=='HD00' and SilenceConditions(doflamingo) then
if spellId=='AD01' then
call DFTamaito(doflamingo,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AD02' then
call DFGoshikito(doflamingo,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AD03' then
call DFOverheat(doflamingo,GetSpellTargetUnit())
elseif spellId=='AD04' or spellId=='AD08' then
call DFBirdcage(doflamingo)
elseif spellId=='AD05' or spellId=='AD06' then
call DFWhiteWave(doflamingo,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AD07' then
call DFSkyRoad(doflamingo,GetSpellTargetX(),GetSpellTargetY())
endif
endif
set doflamingo=null
return false
endfunction
function DFCreateSound takes string soundPath,integer soundDuration returns sound
local sound doflamingoSound=CreateSound(soundPath,false,false,false,10,10,"DefaultEAXON")
call SetSoundDuration(doflamingoSound,soundDuration)
call SetSoundChannel(doflamingoSound,0)
call SetSoundVolume(doflamingoSound,127)
call SetSoundPitch(doflamingoSound,1.)
set DFLastSound=doflamingoSound
set doflamingoSound=null
return DFLastSound
endfunction
function DFInit takes nothing returns nothing
local trigger spellTrigger=CreateTrigger()
local trigger puppetTrigger=CreateTrigger()
local trigger cloneTrigger=CreateTrigger()
set DFHash=InitHashtable()
set DFSoundQ=DFCreateSound("war3mapImported\\Joker 1.mp3",1450)
set DFSoundW=DFCreateSound("war3mapImported\\Joker 2.mp3",1459)
set DFSoundE=DFCreateSound("war3mapImported\\Joker 3.mp3",1325)
set DFSoundR=DFCreateSound("war3mapImported\\Joker 5.mp3",2638)
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(spellTrigger,Condition(function DFOnSpell))
call TriggerRegisterAnyUnitEventBJ(puppetTrigger,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerAddCondition(puppetTrigger,Condition(function DFPuppetOrder))
call TriggerRegisterAnyUnitEventBJ(cloneTrigger,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(cloneTrigger,Condition(function DFCloneAttack))
set spellTrigger=CreateTrigger()
set DFHeroes=CreateGroup()
call TriggerRegisterEnterRectSimple(spellTrigger,bj_mapInitialPlayableArea)
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(spellTrigger,Condition(function DFTrackHero))
call TimerStart(CreateTimer(),.2,true,function DFSyncTick)
set spellTrigger=null
set puppetTrigger=null
set cloneTrigger=null
endfunction
function AYFlat takes unit aizenHero,integer abilityId,real maxLevelValue,integer maxLevel returns real
return maxLevelValue*I2R(GetUnitAbilityLevel(aizenHero,abilityId))/I2R(maxLevel)
endfunction
function AYCanAct takes unit aizenHero returns boolean
return GetWidgetLife(aizenHero)>.405 and not IsUnitPaused(aizenHero) and GetUnitAbilityLevel(aizenHero,'BPSE')==0 and GetUnitAbilityLevel(aizenHero,'BSTN')==0
endfunction
function AYIsEnemyTarget takes unit aizenHero,unit candidate returns boolean
return candidate!=null and GetWidgetLife(candidate)>.405 and not IsUnitType(candidate,UNIT_TYPE_DEAD) and GetUnitAbilityLevel(candidate,'Aloc')==0 and GetUnitAbilityLevel(candidate,'Avul')==0 and IsUnitEnemy(candidate,GetOwningPlayer(aizenHero))
endfunction
function AYMagicDamage takes unit aizenHero,unit damagedUnit,real damageAmount returns nothing
call BvOHeroSpellDamage(aizenHero,damagedUnit,damageAmount,true,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC)
endfunction
function AYPhysicalDamage takes unit aizenHero,unit damagedUnit,real damageAmount returns nothing
call BvOHeroSpellDamage(aizenHero,damagedUnit,damageAmount,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
endfunction
function AYGetSound takes string soundPath returns sound
return LoadSoundHandle(AYHash,1,StringHash(soundPath))
endfunction
function AYPlaySound takes string soundPath,unit soundSource,integer soundVolume returns nothing
local sound aizenSound=AYGetSound(soundPath)
if aizenSound!=null then
call StopSound(aizenSound,false,false)
call SetSoundVolume(aizenSound,soundVolume)
call SetSoundPosition(aizenSound,GetUnitX(soundSource),GetUnitY(soundSource),0.)
call StartSound(aizenSound)
endif
set aizenSound=null
endfunction
function AYPreloadSound takes string soundPath,integer soundDuration returns nothing
local sound aizenSound=CreateSound(soundPath,false,true,true,10,10,"DefaultEAXON")
call SetSoundChannel(aizenSound,0)
call SetSoundDistances(aizenSound,2000.,10000.)
call SetSoundDistanceCutoff(aizenSound,3000.)
call SetSoundDuration(aizenSound,soundDuration)
call SetSoundPitch(aizenSound,1.)
call SetSoundVolume(aizenSound,0)
call SetSoundPosition(aizenSound,0.,0.,0.)
call SaveSoundHandle(AYHash,1,StringHash(soundPath),aizenSound)
call Preload(soundPath)
call StartSound(aizenSound)
set aizenSound=null
endfunction
function AYRemoveUnitTick takes nothing returns nothing
local timer removeTimer=GetExpiredTimer()
call RemoveUnit(LoadUnitHandle(AYHash,GetHandleId(removeTimer),0))
call FlushChildHashtable(AYHash,GetHandleId(removeTimer))
call DestroyTimer(removeTimer)
set removeTimer=null
endfunction
function AYRemoveUnitLater takes unit removedUnit,real removeDelay returns nothing
local timer removeTimer=CreateTimer()
call SaveUnitHandle(AYHash,GetHandleId(removeTimer),0,removedUnit)
call TimerStart(removeTimer,removeDelay,false,function AYRemoveUnitTick)
set removeTimer=null
endfunction
function AYEffect takes unit aizenHero,integer effectUnitId,real effectX,real effectY,real effectFacing,real effectScale,real effectTimeScale,real effectLife returns unit
set AYLastEffect=CreateUnit(GetOwningPlayer(aizenHero),effectUnitId,effectX,effectY,effectFacing)
if effectScale>0. then
call SetUnitScale(AYLastEffect,effectScale,effectScale,effectScale)
endif
call SetUnitTimeScale(AYLastEffect,effectTimeScale)
if effectLife>0. then
call AYRemoveUnitLater(AYLastEffect,effectLife)
endif
return AYLastEffect
endfunction
function AYAnimationTick takes nothing returns nothing
local timer animationTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(animationTimer)
local unit animatedUnit=LoadUnitHandle(AYHash,timerKey,0)
if HaveSavedString(AYHash,timerKey,2) then
call SetUnitAnimation(animatedUnit,LoadStr(AYHash,timerKey,2))
elseif HaveSavedReal(AYHash,timerKey,3) then
call SetUnitTimeScale(animatedUnit,LoadReal(AYHash,timerKey,3))
else
call SetUnitAnimationByIndex(animatedUnit,LoadInteger(AYHash,timerKey,1))
endif
call FlushChildHashtable(AYHash,timerKey)
call DestroyTimer(animationTimer)
set animationTimer=null
set animatedUnit=null
endfunction
function AYPlayAnimationIndex takes unit animatedUnit,integer animationIndex,real animationDelay returns nothing
local timer animationTimer=CreateTimer()
call SaveUnitHandle(AYHash,GetHandleId(animationTimer),0,animatedUnit)
call SaveInteger(AYHash,GetHandleId(animationTimer),1,animationIndex)
call TimerStart(animationTimer,animationDelay,false,function AYAnimationTick)
set animationTimer=null
endfunction
function AYPlayAnimationName takes unit animatedUnit,string animationName,real animationDelay returns nothing
local timer animationTimer=CreateTimer()
call SaveUnitHandle(AYHash,GetHandleId(animationTimer),0,animatedUnit)
call SaveStr(AYHash,GetHandleId(animationTimer),2,animationName)
call TimerStart(animationTimer,animationDelay,false,function AYAnimationTick)
set animationTimer=null
endfunction
function AYSetTimeScaleLater takes unit animatedUnit,real newTimeScale,real scaleDelay returns nothing
local timer animationTimer=CreateTimer()
call SaveUnitHandle(AYHash,GetHandleId(animationTimer),0,animatedUnit)
call SaveReal(AYHash,GetHandleId(animationTimer),3,newTimeScale)
call TimerStart(animationTimer,scaleDelay,false,function AYAnimationTick)
set animationTimer=null
endfunction
function AYFadeTick takes nothing returns nothing
local timer fadeTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(fadeTimer)
local unit fadingUnit=LoadUnitHandle(AYHash,timerKey,0)
local real fadeElapsed=LoadReal(AYHash,timerKey,1)+.03
local real fadeDuration=LoadReal(AYHash,timerKey,2)
if fadeElapsed>=fadeDuration or GetUnitTypeId(fadingUnit)==0 then
call RemoveUnit(fadingUnit)
call FlushChildHashtable(AYHash,timerKey)
call DestroyTimer(fadeTimer)
else
call SaveReal(AYHash,timerKey,1,fadeElapsed)
call SetUnitVertexColor(fadingUnit,LoadInteger(AYHash,timerKey,3),LoadInteger(AYHash,timerKey,4),LoadInteger(AYHash,timerKey,5),R2I(255.*(1.-fadeElapsed/fadeDuration)))
endif
set fadeTimer=null
set fadingUnit=null
endfunction
function AYFadeOut takes unit fadingUnit,integer fadeRed,integer fadeGreen,integer fadeBlue,real fadeDuration returns nothing
local timer fadeTimer=CreateTimer()
local integer timerKey=GetHandleId(fadeTimer)
call SaveUnitHandle(AYHash,timerKey,0,fadingUnit)
call SaveReal(AYHash,timerKey,1,0.)
call SaveReal(AYHash,timerKey,2,fadeDuration)
call SaveInteger(AYHash,timerKey,3,fadeRed)
call SaveInteger(AYHash,timerKey,4,fadeGreen)
call SaveInteger(AYHash,timerKey,5,fadeBlue)
call SetUnitVertexColor(fadingUnit,fadeRed,fadeGreen,fadeBlue,255)
call TimerStart(fadeTimer,.03,true,function AYFadeTick)
set fadeTimer=null
endfunction
function AYFollowTick takes nothing returns nothing
local timer followTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(followTimer)
local unit followingUnit=LoadUnitHandle(AYHash,timerKey,0)
local unit followedUnit=LoadUnitHandle(AYHash,timerKey,1)
local real followLeft=LoadReal(AYHash,timerKey,2)-.02
if followLeft<=0. or GetUnitTypeId(followingUnit)==0 then
call RemoveUnit(followingUnit)
call FlushChildHashtable(AYHash,timerKey)
call DestroyTimer(followTimer)
else
call SaveReal(AYHash,timerKey,2,followLeft)
call SetUnitX(followingUnit,GetUnitX(followedUnit))
call SetUnitY(followingUnit,GetUnitY(followedUnit))
endif
set followTimer=null
set followingUnit=null
set followedUnit=null
endfunction
function AYFollow takes unit followingUnit,unit followedUnit,real followDuration,real followHeight returns nothing
local timer followTimer=CreateTimer()
call SaveUnitHandle(AYHash,GetHandleId(followTimer),0,followingUnit)
call SaveUnitHandle(AYHash,GetHandleId(followTimer),1,followedUnit)
call SaveReal(AYHash,GetHandleId(followTimer),2,followDuration)
call SetUnitFlyHeight(followingUnit,followHeight,0.)
call TimerStart(followTimer,.02,true,function AYFollowTick)
set followTimer=null
endfunction
function AYStun takes unit aizenHero,unit stunnedUnit,real stunDuration returns nothing
local integer stunLevel=R2I(stunDuration*4.+.5)
local unit stunCaster
if stunnedUnit==null or GetWidgetLife(stunnedUnit)<=.405 or stunLevel<1 then
return
endif
if stunLevel>12 then
set stunLevel=12
endif
set stunCaster=CreateUnit(GetOwningPlayer(aizenHero),'hL02',GetUnitX(stunnedUnit)-16.,GetUnitY(stunnedUnit),0.)
call UnitAddAbility(stunCaster,'AY0S')
call SetUnitAbilityLevel(stunCaster,'AY0S',stunLevel)
call UnitApplyTimedLife(stunCaster,'BTLF',1.)
call IssueTargetOrder(stunCaster,"thunderbolt",stunnedUnit)
set stunCaster=null
endfunction
function AYRoot takes unit aizenHero,unit rootedUnit returns nothing
local unit rootCaster=CreateUnit(GetOwningPlayer(aizenHero),'hL02',GetUnitX(rootedUnit)-16.,GetUnitY(rootedUnit),0.)
call UnitAddAbility(rootCaster,'AY0R')
call UnitApplyTimedLife(rootCaster,'BTLF',1.)
call IssueTargetOrder(rootCaster,"entanglingroots",rootedUnit)
set rootCaster=null
endfunction
function AYShunpoEffect takes unit aizenHero,real effectFacing returns nothing
call AYEffect(aizenHero,'hY23',GetUnitX(aizenHero),GetUnitY(aizenHero),effectFacing,0.,2.,.3)
call SetUnitFlyHeight(AYLastEffect,GetUnitFlyHeight(aizenHero),0.)
endfunction
function AYShunpoMove takes unit aizenHero,real targetX,real targetY returns nothing
local real moveAngle=Atan2(targetY-GetUnitY(aizenHero),targetX-GetUnitX(aizenHero))*bj_RADTODEG
call AYShunpoEffect(aizenHero,moveAngle)
call SetUnitPosition(aizenHero,targetX,targetY)
call AYShunpoEffect(aizenHero,moveAngle)
endfunction
function AYOnAttacked takes nothing returns boolean
// One pending impact for each native attack. DoT damage cannot re-use it.
call SaveBoolean(AYHash,GetHandleId(GetAttacker()),152,true)
call SaveUnitHandle(AYHash,GetHandleId(GetAttacker()),150,GetTriggerUnit())
call SaveReal(AYHash,GetHandleId(GetAttacker()),151,TimerGetElapsed(AYClock))
return false
endfunction
function AYIsAttackDamage takes nothing returns boolean
if DamageMode==MODE_MELEE_ATTACK_EMULATION or DamageMode==MODE_RANGE_ATTACK_EMULATION then
return true
endif
if DamageMode!=MODE_ATTACK or Source==null or GetUnitAbilityLevel(Source,'Aloc')>0 then
return false
endif
return LoadUnitHandle(AYHash,GetHandleId(Source),150)==Target and TimerGetElapsed(AYClock)-LoadReal(AYHash,GetHandleId(Source),151)<3.
endfunction
function AYPreventDamageEnd takes nothing returns nothing
local timer preventTimer=GetExpiredTimer()
local unit protectedUnit=LoadUnitHandle(AYHash,GetHandleId(preventTimer),0)
local real lifeAfterHit=GetWidgetLife(protectedUnit)
call UnitRemoveAbility(protectedUnit,'AY0H')
if lifeAfterHit>.405 then
call SetWidgetLife(protectedUnit,lifeAfterHit)
endif
call FlushChildHashtable(AYHash,GetHandleId(preventTimer))
call DestroyTimer(preventTimer)
set preventTimer=null
set protectedUnit=null
endfunction
function AYPreventDamage takes unit protectedUnit,real preventedAmount returns nothing
local real currentLife=GetWidgetLife(protectedUnit)
local timer preventTimer
if preventedAmount<=0. then
return
endif
if preventedAmount>Damage then
set preventedAmount=Damage
endif
if currentLife+preventedAmount>GetUnitState(protectedUnit,UNIT_STATE_MAX_LIFE)-1. then
call UnitAddAbility(protectedUnit,'AY0H')
set preventTimer=CreateTimer()
call SaveUnitHandle(AYHash,GetHandleId(preventTimer),0,protectedUnit)
call TimerStart(preventTimer,0.,false,function AYPreventDamageEnd)
set preventTimer=null
endif
call SetWidgetLife(protectedUnit,currentLife+preventedAmount)
set Damage=Damage-preventedAmount
endfunction
// Fire Skin (V) of Ace: 50% of every damage taken while the buff B031 lasts is blocked (also at full life, through
// AYPreventDamage) and taken back over 4 seconds after it. Only ATTACKS of enemies within 240 range are burnt back for
// 4% of the attacker's max life - before, every damage instance burnt back (spell ticks, auras, damage over time), and
// melee heroes were burnt from any distance, so a ticking spell (Crocodile R) killed its own caster.
function AceV_FireSkinHook takes nothing returns nothing
endfunction
// ---------------------------------------------------------------- Q: Hado #63 Raikoho
function AYDankuActive takes unit aizenHero returns boolean
return LoadBoolean(AYHash,GetHandleId(aizenHero),100) or LoadBoolean(AYHash,GetHandleId(aizenHero),102)
endfunction
function AYRaikohoHitArea takes integer timerKey,real hitX,real hitY,real hitRadius returns nothing
local unit aizenHero=LoadUnitHandle(AYHash,timerKey,0)
local group hitUnits=LoadGroupHandle(AYHash,timerKey,6)
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
call GroupEnumUnitsInRange(nearbyUnits,hitX,hitY,hitRadius,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if AYIsEnemyTarget(aizenHero,nearbyUnit) and GetUnitFlyHeight(nearbyUnit)<150. and not IsUnitInGroup(nearbyUnit,hitUnits) then
call GroupAddUnit(hitUnits,nearbyUnit)
call AYStun(aizenHero,nearbyUnit,LoadReal(AYHash,timerKey,7))
call AYMagicDamage(aizenHero,nearbyUnit,LoadReal(AYHash,timerKey,5))
endif
endloop
call DestroyGroup(nearbyUnits)
set nearbyUnits=null
set hitUnits=null
set aizenHero=null
endfunction
function AYRaikohoBoltTick takes nothing returns nothing
local timer boltTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(boltTimer)
local unit aizenHero=LoadUnitHandle(AYHash,timerKey,0)
local real boltX=LoadReal(AYHash,timerKey,1)
local real boltY=LoadReal(AYHash,timerKey,2)
local real boltAngle=LoadReal(AYHash,timerKey,3)
local integer boltStep=LoadInteger(AYHash,timerKey,4)+1
local real boltStepLength=LoadReal(AYHash,timerKey,8)
local real nextX=boltX+boltStepLength*Cos(boltAngle)
local real nextY=boltY+boltStepLength*Sin(boltAngle)
if boltStep<=15 and RectContainsCoords(bj_mapInitialPlayableArea,nextX,nextY) then
set boltX=nextX
set boltY=nextY
call SaveReal(AYHash,timerKey,1,boltX)
call SaveReal(AYHash,timerKey,2,boltY)
call SaveInteger(AYHash,timerKey,4,boltStep)
if ModuloInteger(boltStep,3)==0 then
call AYEffect(aizenHero,'hY03',boltX+40.*Cos(boltAngle),boltY+40.*Sin(boltAngle),boltAngle*bj_RADTODEG,0.,1.5,1.)
call AYEffect(aizenHero,'hY04',boltX,boltY,boltAngle*bj_RADTODEG,1.85,2.,.8)
endif
call AYRaikohoHitArea(timerKey,boltX,boltY,325.)
else
call AYEffect(aizenHero,'hY05',boltX,boltY,boltAngle*bj_RADTODEG,.965,2.,1.6)
call AYEffect(aizenHero,'hY06',boltX,boltY,boltAngle*bj_RADTODEG,2.1,.85,1.35)
call AYRaikohoHitArea(timerKey,boltX,boltY,302.)
call DestroyGroup(LoadGroupHandle(AYHash,timerKey,6))
call FlushChildHashtable(AYHash,timerKey)
call DestroyTimer(boltTimer)
endif
set boltTimer=null
set aizenHero=null
endfunction
function AYRaikohoBase takes integer abilityLevel returns real
return 100.+100.*abilityLevel
endfunction
function AYRaikohoLaunch takes unit aizenHero,real boltAngle,boolean dankuActive returns nothing
local timer boltTimer=CreateTimer()
local integer timerKey=GetHandleId(boltTimer)
local real startX=GetUnitX(aizenHero)+130.*Cos(boltAngle)
local real startY=GetUnitY(aizenHero)+130.*Sin(boltAngle)
call SaveUnitHandle(AYHash,timerKey,0,aizenHero)
call SaveReal(AYHash,timerKey,1,startX)
call SaveReal(AYHash,timerKey,2,startY)
call SaveReal(AYHash,timerKey,3,boltAngle)
call SaveInteger(AYHash,timerKey,4,0)
call SaveReal(AYHash,timerKey,5,AYRaikohoBase(GetUnitAbilityLevel(aizenHero,'AY01'))+(1.5+.25*GetUnitAbilityLevel(aizenHero,'AY01'))*GetHeroInt(aizenHero,false))
call SaveGroupHandle(AYHash,timerKey,6,CreateGroup())
call SaveReal(AYHash,timerKey,7,1.)
call SaveReal(AYHash,timerKey,8,(700.+50.*GetUnitAbilityLevel(aizenHero,'AY01')-130.)/15.)
call AYEffect(aizenHero,'hY01',startX,startY,boltAngle*bj_RADTODEG,.75,2.,1.)
call AYEffect(aizenHero,'hY02',startX,startY,boltAngle*bj_RADTODEG,1.5,1.25,1.2)
call AYEffect(aizenHero,'hY02',startX,startY,boltAngle*bj_RADTODEG,1.5,1.25,1.2)
call AYPlaySound("war3mapImported\\Aizen\\Ichigo3 Q.wav",aizenHero,127)
call TimerStart(boltTimer,.01,true,function AYRaikohoBoltTick)
set boltTimer=null
endfunction
// Raikoho is charged during the casting time of AY01 (0.5 seconds): the stop order, a stun or a silence cancel it
// before it costs mana or starts the cooldown. The charge: when Aizen starts casting
function AYRaikoho takes unit aizenHero,real targetX,real targetY returns nothing
local real boltAngle=Atan2(targetY-GetUnitY(aizenHero),targetX-GetUnitX(aizenHero))
call SaveBoolean(AYHash,GetHandleId(aizenHero),160,true)
call SetUnitFacing(aizenHero,boltAngle*bj_RADTODEG)
call AYPlaySound("war3mapImported\\Aizen\\Aizen1 R.wav",aizenHero,127)
call SetUnitTimeScale(aizenHero,1.)
call AYPlayAnimationIndex(aizenHero,8,.01)
call AYSetTimeScaleLater(aizenHero,0.,.34)
endfunction
// the bolt: when the casting time is over
function AYRaikohoFire takes unit aizenHero,real targetX,real targetY returns nothing
call SaveBoolean(AYHash,GetHandleId(aizenHero),160,false)
call SetUnitTimeScale(aizenHero,1.)
call AYSetTimeScaleLater(aizenHero,1.,.01)
call AYRaikohoLaunch(aizenHero,Atan2(targetY-GetUnitY(aizenHero),targetX-GetUnitX(aizenHero)),AYDankuActive(aizenHero))
endfunction
// ---------------------------------------------------------------- W: Bakudo #81 Danku
function AYDankuShieldValue takes unit aizenHero returns real
return 100.+100.*GetUnitAbilityLevel(aizenHero,'AY02')+3.*GetHeroInt(aizenHero,true)
endfunction
function AYDankuReadyEnd takes nothing returns nothing
local timer readyTimer=GetExpiredTimer()
local unit aizenHero=LoadUnitHandle(AYHash,GetHandleId(readyTimer),0)
if LoadInteger(AYHash,GetHandleId(aizenHero),103)==LoadInteger(AYHash,GetHandleId(readyTimer),1) and LoadBoolean(AYHash,GetHandleId(aizenHero),100) then
call SaveBoolean(AYHash,GetHandleId(aizenHero),100,false)
call DestroyEffect(LoadEffectHandle(AYHash,GetHandleId(aizenHero),101))
endif
call FlushChildHashtable(AYHash,GetHandleId(readyTimer))
call DestroyTimer(readyTimer)
set readyTimer=null
set aizenHero=null
endfunction
function AYDanku takes unit aizenHero returns nothing
local timer readyTimer=CreateTimer()
local integer castCount=LoadInteger(AYHash,GetHandleId(aizenHero),103)+1
call SaveInteger(AYHash,GetHandleId(aizenHero),103,castCount)
if LoadBoolean(AYHash,GetHandleId(aizenHero),100) then
call DestroyEffect(LoadEffectHandle(AYHash,GetHandleId(aizenHero),101))
endif
call SaveBoolean(AYHash,GetHandleId(aizenHero),100,true)
call SaveEffectHandle(AYHash,GetHandleId(aizenHero),101,AddSpecialEffectTarget("AZ_DD029.mdl",aizenHero,"origin"))
call AYPlayAnimationIndex(aizenHero,8,.01)
call SaveUnitHandle(AYHash,GetHandleId(readyTimer),0,aizenHero)
call SaveInteger(AYHash,GetHandleId(readyTimer),1,castCount)
call TimerStart(readyTimer,5.,false,function AYDankuReadyEnd)
set readyTimer=null
endfunction
function AYDankuWallTick takes nothing returns nothing
local timer wallTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(wallTimer)
local unit aizenHero=LoadUnitHandle(AYHash,timerKey,0)
local unit wallUnit=LoadUnitHandle(AYHash,timerKey,1)
local group shieldedUnits=LoadGroupHandle(AYHash,timerKey,2)
local real wallElapsed=LoadReal(AYHash,timerKey,3)+.02
local real pushWait=LoadReal(AYHash,timerKey,4)+.02
local real wallX=GetUnitX(wallUnit)
local real wallY=GetUnitY(wallUnit)
local group nearbyUnits
local unit nearbyUnit
local real nearbyDistance
local real pushAngle
if wallElapsed<5. then
call SaveReal(AYHash,timerKey,3,wallElapsed)
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,wallX,wallY,510.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if GetWidgetLife(nearbyUnit)>.405 and GetUnitAbilityLevel(nearbyUnit,'Aloc')==0 and not IsUnitEnemy(nearbyUnit,GetOwningPlayer(aizenHero)) then
if not IsUnitInGroup(nearbyUnit,shieldedUnits) then
call GroupAddUnit(shieldedUnits,nearbyUnit)
if LoadReal(AYHash,GetHandleId(nearbyUnit),110)<=0. then
call SaveReal(AYHash,GetHandleId(nearbyUnit),110,AYDankuShieldValue(aizenHero))
endif
endif
call SaveBoolean(AYHash,GetHandleId(nearbyUnit),111,true)
endif
endloop
call GroupClear(nearbyUnits)
call GroupAddGroup(shieldedUnits,nearbyUnits)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
set nearbyDistance=SquareRoot((GetUnitX(nearbyUnit)-wallX)*(GetUnitX(nearbyUnit)-wallX)+(GetUnitY(nearbyUnit)-wallY)*(GetUnitY(nearbyUnit)-wallY))
if nearbyDistance>510. then
call SaveBoolean(AYHash,GetHandleId(nearbyUnit),111,false)
call SaveReal(AYHash,GetHandleId(nearbyUnit),110,0.)
endif
endloop
if pushWait>1.48 then
set pushWait=0.
call GroupEnumUnitsInRange(nearbyUnits,wallX,wallY,510.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if AYIsEnemyTarget(aizenHero,nearbyUnit) and GetUnitFlyHeight(nearbyUnit)<700. and not IsUnitType(nearbyUnit,UNIT_TYPE_STRUCTURE) then
set pushAngle=Atan2(GetUnitY(nearbyUnit)-wallY,GetUnitX(nearbyUnit)-wallX)
call TLSlide(nearbyUnit,wallX+625.*Cos(pushAngle),wallY+625.*Sin(pushAngle),.4,.02)
endif
endloop
endif
call SaveReal(AYHash,timerKey,4,pushWait)
call DestroyGroup(nearbyUnits)
set nearbyUnits=null
else
call SetUnitTimeScale(wallUnit,1.75)
call SetUnitAnimation(wallUnit,"death")
call AYRemoveUnitLater(wallUnit,.3)
loop
set nearbyUnit=FirstOfGroup(shieldedUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(shieldedUnits,nearbyUnit)
call SaveBoolean(AYHash,GetHandleId(nearbyUnit),111,false)
call SaveReal(AYHash,GetHandleId(nearbyUnit),110,0.)
endloop
call DestroyGroup(shieldedUnits)
call SaveBoolean(AYHash,GetHandleId(aizenHero),102,false)
call FlushChildHashtable(AYHash,timerKey)
call DestroyTimer(wallTimer)
endif
set wallTimer=null
set aizenHero=null
set wallUnit=null
set shieldedUnits=null
set nearbyUnit=null
endfunction
function AYDankuRaiseWall takes unit aizenHero,real remainingShield returns nothing
local timer wallTimer=CreateTimer()
local integer timerKey=GetHandleId(wallTimer)
local real wallFacing=GetUnitFacing(aizenHero)+180.
local unit wallUnit=CreateUnit(GetOwningPlayer(aizenHero),'hY15',GetUnitX(aizenHero),GetUnitY(aizenHero),wallFacing)
local group shieldedUnits=CreateGroup()
call SaveBoolean(AYHash,GetHandleId(aizenHero),100,false)
call DestroyEffect(LoadEffectHandle(AYHash,GetHandleId(aizenHero),101))
call SaveBoolean(AYHash,GetHandleId(aizenHero),102,true)
call SetUnitAnimation(wallUnit,"birth")
call AYEffect(aizenHero,'hY16',GetUnitX(aizenHero),GetUnitY(aizenHero),wallFacing,0.,0.,5.)
call AYPlaySound("war3mapImported\\Aizen\\Aizen1 T2.wav",aizenHero,127)
call GroupAddUnit(shieldedUnits,aizenHero)
call SaveReal(AYHash,GetHandleId(aizenHero),110,remainingShield)
call SaveBoolean(AYHash,GetHandleId(aizenHero),111,true)
call SaveUnitHandle(AYHash,timerKey,0,aizenHero)
call SaveUnitHandle(AYHash,timerKey,1,wallUnit)
call SaveGroupHandle(AYHash,timerKey,2,shieldedUnits)
call SaveReal(AYHash,timerKey,3,0.)
call SaveReal(AYHash,timerKey,4,999.)
call TimerStart(wallTimer,.02,true,function AYDankuWallTick)
set wallTimer=null
set wallUnit=null
set shieldedUnits=null
endfunction
function AYDankuOnDamage takes nothing returns nothing
local real hitFactor=1.
local real effectiveDamage
local real shieldValue
if Damage<1. then
return
endif
if not IsUnitType(Source,UNIT_TYPE_HERO) then
set hitFactor=.5
endif
set effectiveDamage=Damage*hitFactor
// Danku triggers only on a single hit of more than 150 damage (attacks included)
if LoadBoolean(AYHash,GetHandleId(Target),100) then
if Damage<=150. then
return
endif
set shieldValue=AYDankuShieldValue(Target)
if effectiveDamage>shieldValue then
call AYPreventDamage(Target,Damage-(effectiveDamage-shieldValue))
call SaveBoolean(AYHash,GetHandleId(Target),100,false)
call DestroyEffect(LoadEffectHandle(AYHash,GetHandleId(Target),101))
call DisplayTimedTextToPlayer(GetOwningPlayer(Target),0.,0.,1.,"|c00468CF7Shield was destroyed|r")
else
call AYPreventDamage(Target,Damage)
call DisplayTimedTextToPlayer(GetOwningPlayer(Target),0.,0.,.85,"|c00468CF7Shield protect count: "+I2S(R2I(shieldValue-effectiveDamage))+"|r")
call IssueImmediateOrderById(Source,851972)
call AYDankuRaiseWall(Target,shieldValue-effectiveDamage)
endif
elseif LoadBoolean(AYHash,GetHandleId(Target),111) and LoadReal(AYHash,GetHandleId(Target),110)>0. and not AYIsAttackDamage() then
set shieldValue=LoadReal(AYHash,GetHandleId(Target),110)
if effectiveDamage>=shieldValue then
call AYPreventDamage(Target,Damage-(effectiveDamage-shieldValue))
call SaveReal(AYHash,GetHandleId(Target),110,0.)
call SaveBoolean(AYHash,GetHandleId(Target),111,false)
else
call AYPreventDamage(Target,Damage)
call SaveReal(AYHash,GetHandleId(Target),110,shieldValue-effectiveDamage)
call DisplayTimedTextToPlayer(GetOwningPlayer(Target),0.,0.,.85,"|c00468CF7Danku Protect: "+I2S(R2I(shieldValue-effectiveDamage))+"|r")
endif
endif
endfunction
// ---------------------------------------------------------------- E: Instant Swipe <-> Kyoka Suigetsu

function AYShowSecondE takes unit aizenHero returns nothing
local player aizenOwner=GetOwningPlayer(aizenHero)
call SetPlayerAbilityAvailable(aizenOwner,'AY03',false)
if GetUnitAbilityLevel(aizenHero,'AY04')==0 then
call UnitAddAbility(aizenHero,'AY04')
call UnitMakeAbilityPermanent(aizenHero,true,'AY04')
endif
call SetUnitAbilityLevel(aizenHero,'AY04',GetUnitAbilityLevel(aizenHero,'AY03'))
call SetPlayerAbilityAvailable(aizenOwner,'AY04',true)
set aizenOwner=null
endfunction
function AYShowFirstE takes unit aizenHero returns nothing
call SetPlayerAbilityAvailable(GetOwningPlayer(aizenHero),'AY04',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(aizenHero),'AY03',true)
endfunction
function AYSwipeTick takes nothing returns nothing
local timer swipeTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(swipeTimer)
local unit aizenHero=LoadUnitHandle(AYHash,timerKey,0)
local real targetX=LoadReal(AYHash,timerKey,1)
local real targetY=LoadReal(AYHash,timerKey,2)
local real swipeAngle=LoadReal(AYHash,timerKey,3)
local integer swipeTicks=LoadInteger(AYHash,timerKey,4)+1
local integer ringIndex
local group nearbyUnits
local unit nearbyUnit
local boolean swipeDone=false
if not AYCanAct(aizenHero) then
set swipeDone=true
else
call SaveInteger(AYHash,timerKey,4,swipeTicks)
call SetUnitFacing(aizenHero,swipeAngle*bj_RADTODEG)
if swipeTicks==1 then
call AYShunpoMove(aizenHero,targetX-130.*Cos(swipeAngle),targetY-130.*Sin(swipeAngle))
call SetUnitPathing(aizenHero,false)
call AYPlayAnimationIndex(aizenHero,1,.01)
call SetUnitTimeScale(aizenHero,.5)
elseif swipeTicks==50 then
call AYPlaySound("war3mapImported\\Aizen\\sword (4).wav",aizenHero,127)
call AYEffect(aizenHero,'hY17',GetUnitX(aizenHero),GetUnitY(aizenHero),GetRandomReal(0.,359.),.75,1.1,2.5)
call AYEffect(aizenHero,'hY17',GetUnitX(aizenHero),GetUnitY(aizenHero),GetRandomReal(0.,359.),.75,1.1,2.5)
set ringIndex=0
loop
exitwhen ringIndex==6
call AYEffect(aizenHero,'hY18',GetUnitX(aizenHero)+165.*Cos(ringIndex*60.*bj_DEGTORAD),GetUnitY(aizenHero)+210.*Sin(ringIndex*60.*bj_DEGTORAD),ringIndex*60.,.87,2.,1.45)
set ringIndex=ringIndex+1
endloop
call AYEffect(aizenHero,'hY19',GetUnitX(aizenHero),GetUnitY(aizenHero),GetRandomReal(0.,359.),.9,2.25,.8)
call SetUnitVertexColor(AYLastEffect,255,255,255,140)
call AYPlayAnimationName(AYLastEffect,"death",.45)
call AYEffect(aizenHero,'hY20',GetUnitX(aizenHero),GetUnitY(aizenHero),GetRandomReal(0.,359.),1.11,2.25,.8)
call SetUnitVertexColor(AYLastEffect,255,255,255,180)
call AYPlayAnimationName(AYLastEffect,"death",.45)
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,targetX,targetY,300.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if AYIsEnemyTarget(aizenHero,nearbyUnit) and GetUnitFlyHeight(nearbyUnit)<150. then
call AYPhysicalDamage(aizenHero,nearbyUnit,LoadReal(AYHash,timerKey,5))
endif
endloop
call DestroyGroup(nearbyUnits)
set nearbyUnits=null
set swipeDone=true
endif
endif
if swipeDone then
call SetUnitPathing(aizenHero,true)
call SetUnitTimeScale(aizenHero,1.)
call FlushChildHashtable(AYHash,timerKey)
call DestroyTimer(swipeTimer)
endif
set swipeTimer=null
set aizenHero=null
endfunction
function AYInstantSwipe takes unit aizenHero,real targetX,real targetY returns nothing
local timer swipeTimer=CreateTimer()
local integer timerKey=GetHandleId(swipeTimer)
local real swipeAngle=Atan2(targetY-GetUnitY(aizenHero),targetX-GetUnitX(aizenHero))
call AYShowSecondE(aizenHero)
call SaveUnitHandle(AYHash,timerKey,0,aizenHero)
call SaveReal(AYHash,timerKey,1,targetX)
call SaveReal(AYHash,timerKey,2,targetY)
call SaveReal(AYHash,timerKey,3,swipeAngle)
call SaveInteger(AYHash,timerKey,4,0)
call SaveReal(AYHash,timerKey,5,300.+200.*GetUnitAbilityLevel(aizenHero,'AY03')+5.*GetHeroAgi(aizenHero,true))
call AYPlaySound("war3mapImported\\Aizen\\Aizen3 Q.wav",aizenHero,127)
call SetUnitFacing(aizenHero,swipeAngle*bj_RADTODEG)
call SetUnitTimeScale(aizenHero,2.)
call TimerStart(swipeTimer,.01,true,function AYSwipeTick)
set swipeTimer=null
endfunction
function AYSwipeGuardReady takes nothing returns nothing
local timer guardTimer=GetExpiredTimer()
call SaveBoolean(AYHash,GetHandleId(LoadUnitHandle(AYHash,GetHandleId(guardTimer),0)),130,false)
call FlushChildHashtable(AYHash,GetHandleId(guardTimer))
call DestroyTimer(guardTimer)
set guardTimer=null
endfunction
function AYSwipeGuardOnDamage takes nothing returns nothing
local timer guardTimer
local real pushAngle
// removed (29.10): no more blocked attack
return
if Damage<=0. or not AYIsAttackDamage() or GetUnitAbilityLevel(Target,'AY03')==0 or IsUnitIllusion(Target) or LoadBoolean(AYHash,GetHandleId(Target),130) or not IsUnitEnemy(Source,GetOwningPlayer(Target)) then
return
endif
call SaveBoolean(AYHash,GetHandleId(Target),130,true)
call AYPreventDamage(Target,Damage)
call AYPlaySound("war3mapImported\\Aizen\\Aizen Shield.wav",Target,127)
if not IsUnitType(Source,UNIT_TYPE_STRUCTURE) then
set pushAngle=Atan2(GetUnitY(Source)-GetUnitY(Target),GetUnitX(Source)-GetUnitX(Target))
call TLSlide(Source,GetUnitX(Source)+200.*Cos(pushAngle),GetUnitY(Source)+200.*Sin(pushAngle),.3,.02)
endif
set guardTimer=CreateTimer()
call SaveUnitHandle(AYHash,GetHandleId(guardTimer),0,Target)
call TimerStart(guardTimer,30.,false,function AYSwipeGuardReady)
set guardTimer=null
endfunction
function AYKyokaEnd takes unit aizenHero returns nothing
call UnitRemoveAbility(aizenHero,'AYEW')
if GetUnitAbilityLevel(aizenHero,'AYRW')==0 then
call UnitRemoveAbility(aizenHero,'BOwk')
endif
call UnitRemoveAbility(aizenHero,'BYE0')
call UnitRemoveAbility(aizenHero,'AY0A')
call UnitRemoveAbility(aizenHero,'AY0M')
call SaveBoolean(AYHash,GetHandleId(aizenHero),140,false)
endfunction
function AYKyokaTimeout takes nothing returns nothing
local timer kyokaTimer=GetExpiredTimer()
local unit aizenHero=LoadUnitHandle(AYHash,GetHandleId(kyokaTimer),0)
if LoadInteger(AYHash,GetHandleId(aizenHero),141)==LoadInteger(AYHash,GetHandleId(kyokaTimer),1) then
call AYKyokaEnd(aizenHero)
endif
call FlushChildHashtable(AYHash,GetHandleId(kyokaTimer))
call DestroyTimer(kyokaTimer)
set kyokaTimer=null
set aizenHero=null
endfunction
function AYKyokaTagClone takes unit aizenHero,unit clone returns nothing
if clone!=null and IsUnitIllusion(clone) and GetUnitTypeId(clone)=='HA00' and GetOwningPlayer(clone)==GetOwningPlayer(aizenHero) then
call SaveUnitHandle(AYHash,GetHandleId(clone),143,aizenHero)
call SaveUnitHandle(AYHash,GetHandleId(aizenHero),144,clone)
endif
endfunction
function AYKyokaOnSummon takes nothing returns boolean
local unit summoner=GetSummoningUnit()
local unit aizenHero=LoadUnitHandle(AYHash,GetHandleId(summoner),142)
if aizenHero!=null then
call AYKyokaTagClone(aizenHero,GetSummonedUnit())
endif
set summoner=null
set aizenHero=null
return false
endfunction
function AYKyokaFindClone takes nothing returns nothing
local timer scan=GetExpiredTimer()
local integer key=GetHandleId(scan)
local unit aizenHero=LoadUnitHandle(AYHash,key,0)
local group oldClones=LoadGroupHandle(AYHash,key,2)
local group candidates=CreateGroup()
local unit candidate
local integer ticks=LoadInteger(AYHash,key,3)+1
call GroupEnumUnitsInRange(candidates,LoadReal(AYHash,key,4),LoadReal(AYHash,key,5),200.,null)
loop
set candidate=FirstOfGroup(candidates)
exitwhen candidate==null
call GroupRemoveUnit(candidates,candidate)
if not IsUnitInGroup(candidate,oldClones) and LoadUnitHandle(AYHash,GetHandleId(aizenHero),144)==null and LoadBoolean(AYHash,GetHandleId(aizenHero),140) and GetWidgetLife(candidate)>.405 then
call AYKyokaTagClone(aizenHero,candidate)
endif
endloop
call DestroyGroup(candidates)
if ticks>=10 or LoadUnitHandle(AYHash,GetHandleId(aizenHero),144)!=null or not LoadBoolean(AYHash,GetHandleId(aizenHero),140) then
call RemoveSavedHandle(AYHash,GetHandleId(LoadUnitHandle(AYHash,key,6)),142)
call DestroyGroup(oldClones)
call FlushChildHashtable(AYHash,key)
call DestroyTimer(scan)
else
call SaveInteger(AYHash,key,3,ticks)
endif
set scan=null
set aizenHero=null
set oldClones=null
set candidates=null
set candidate=null
endfunction
function AYKyokaWalk takes nothing returns nothing
local timer kyokaWalkTimer=GetExpiredTimer()
local unit kyokaWalker=LoadUnitHandle(AYHash,GetHandleId(kyokaWalkTimer),0)
if kyokaWalker!=null and GetWidgetLife(kyokaWalker)>.405 and LoadInteger(AYHash,GetHandleId(kyokaWalker),141)==LoadInteger(AYHash,GetHandleId(kyokaWalkTimer),1) and GetUnitAbilityLevel(kyokaWalker,'AYEW')>0 then
call IssueImmediateOrder(kyokaWalker,"windwalk")
endif
call FlushChildHashtable(AYHash,GetHandleId(kyokaWalkTimer))
call DestroyTimer(kyokaWalkTimer)
set kyokaWalkTimer=null
set kyokaWalker=null
endfunction
function AYKyokaSuigetsu takes unit aizenHero returns nothing
local unit illusionCaster=CreateUnit(GetOwningPlayer(aizenHero),'hL02',GetUnitX(aizenHero),GetUnitY(aizenHero),0.)
local timer kyokaTimer=CreateTimer()
local integer castCount=LoadInteger(AYHash,GetHandleId(aizenHero),141)+1
local timer scan=CreateTimer()
local group oldClones=CreateGroup()
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
local real pushAngle=GetUnitFacing(aizenHero)*bj_DEGTORAD
call AYShowFirstE(aizenHero)
call GroupEnumUnitsInRange(oldClones,GetUnitX(aizenHero),GetUnitY(aizenHero),200.,null)
call SaveUnitHandle(AYHash,GetHandleId(aizenHero),144,null)
call SaveUnitHandle(AYHash,GetHandleId(illusionCaster),142,aizenHero)
call SaveUnitHandle(AYHash,GetHandleId(scan),0,aizenHero)
call SaveGroupHandle(AYHash,GetHandleId(scan),2,oldClones)
call SaveReal(AYHash,GetHandleId(scan),4,GetUnitX(aizenHero))
call SaveReal(AYHash,GetHandleId(scan),5,GetUnitY(aizenHero))
call SaveUnitHandle(AYHash,GetHandleId(scan),6,illusionCaster)
call TimerStart(scan,.02,true,function AYKyokaFindClone)
set scan=null
set oldClones=null
call UnitAddAbility(illusionCaster,'AY0I')
call UnitApplyTimedLife(illusionCaster,'BTLF',1.)
call IssueTargetOrderById(illusionCaster,852274,aizenHero)
call AYPlaySound("war3mapImported\\Aizen\\Aizen3 Q2.wav",aizenHero,127)
call UnitRemoveAbility(aizenHero,'AYEW')
call UnitAddAbility(aizenHero,'AYEW')
call UnitAddAbility(aizenHero,'AY0A')
call UnitAddAbility(aizenHero,'AY0M')
call SaveBoolean(AYHash,GetHandleId(aizenHero),140,true)
call CastToTarget(aizenHero,aizenHero,'AYES',1,"innerfire")
call SaveInteger(AYHash,GetHandleId(aizenHero),141,castCount)
set scan=CreateTimer()
call SaveUnitHandle(AYHash,GetHandleId(scan),0,aizenHero)
call SaveInteger(AYHash,GetHandleId(scan),1,castCount)
call TimerStart(scan,0.,false,function AYKyokaWalk)
set scan=null
call TLSlide(aizenHero,GetUnitX(aizenHero)+400.*Cos(pushAngle),GetUnitY(aizenHero)+400.*Sin(pushAngle),.15,.02)
call GroupEnumUnitsInRange(nearbyUnits,GetUnitX(aizenHero),GetUnitY(aizenHero),1000.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if AYIsEnemyTarget(aizenHero,nearbyUnit) and not IsUnitIllusion(nearbyUnit) then
call GroupAddUnit(AYHypnotized,nearbyUnit)
endif
endloop
call DestroyGroup(nearbyUnits)
call SaveUnitHandle(AYHash,GetHandleId(kyokaTimer),0,aizenHero)
call SaveInteger(AYHash,GetHandleId(kyokaTimer),1,castCount)
call TimerStart(kyokaTimer,3.,false,function AYKyokaTimeout)
set kyokaTimer=null
set illusionCaster=null
set nearbyUnits=null
endfunction
function AYKyokaCutTick takes nothing returns nothing
local timer cutTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(cutTimer)
local unit aizenHero=LoadUnitHandle(AYHash,timerKey,0)
local unit cutTarget=LoadUnitHandle(AYHash,timerKey,1)
local unit markUnit=LoadUnitHandle(AYHash,timerKey,2)
local integer cutTicks=LoadInteger(AYHash,timerKey,3)+1
local real cutAngle=Atan2(GetUnitY(cutTarget)-GetUnitY(aizenHero),GetUnitX(cutTarget)-GetUnitX(aizenHero))
local real cutDistance
local boolean cutDone=false
if GetWidgetLife(aizenHero)<=.405 or cutTicks>165 or GetWidgetLife(cutTarget)<=.405 then
set cutDone=true
else
call SaveInteger(AYHash,timerKey,3,cutTicks)
call SetUnitFacing(aizenHero,cutAngle*bj_RADTODEG)
call SetUnitX(markUnit,GetUnitX(cutTarget))
call SetUnitY(markUnit,GetUnitY(cutTarget))
if cutTicks==19 then
call SetUnitTimeScale(aizenHero,.55)
call AYPlayAnimationIndex(aizenHero,1,.01)
endif
if cutTicks>50 then
set cutDistance=SquareRoot((GetUnitX(cutTarget)-GetUnitX(aizenHero))*(GetUnitX(cutTarget)-GetUnitX(aizenHero))+(GetUnitY(cutTarget)-GetUnitY(aizenHero))*(GetUnitY(cutTarget)-GetUnitY(aizenHero)))
if cutDistance>60. then
call SetUnitX(aizenHero,GetUnitX(aizenHero)+21.*Cos(cutAngle))
call SetUnitY(aizenHero,GetUnitY(aizenHero)+21.*Sin(cutAngle))
else
call AYStun(aizenHero,cutTarget,.5)
call AYPhysicalDamage(aizenHero,cutTarget,LoadReal(AYHash,timerKey,4))
call AYPlaySound("war3mapImported\\Aizen\\Nel2 W2.wav",aizenHero,127)
call AYEffect(aizenHero,'hY12',GetUnitX(cutTarget),GetUnitY(cutTarget),cutAngle*bj_RADTODEG,1.75,2.1,1.65)
call SetUnitFlyHeight(AYLastEffect,70.,0.)
call AYEffect(aizenHero,'hY22',GetUnitX(cutTarget),GetUnitY(cutTarget),cutAngle*bj_RADTODEG,3.,1.4,1.5)
call SetUnitFlyHeight(AYLastEffect,100.,0.)
set cutDone=true
endif
endif
endif
if cutDone then
call SetUnitTimeScale(markUnit,1.)
call SetUnitAnimation(markUnit,"death")
call AYRemoveUnitLater(markUnit,1.1)
call SetUnitPathing(aizenHero,true)
call SetUnitTimeScale(aizenHero,1.)
call FlushChildHashtable(AYHash,timerKey)
call DestroyTimer(cutTimer)
endif
set cutTimer=null
set aizenHero=null
set cutTarget=null
set markUnit=null
endfunction
// Kyoka Suigetsu cut: instant. Aizen leaves the invisibility, appears behind the enemy, stuns him for 1 second and
// deals 100 + 50 x level + 1.5 x base AGI + 2 x base INT physical damage
function AYKyokaCut takes unit aizenHero,unit cutTarget returns nothing
local real cutAngle=Atan2(GetUnitY(cutTarget)-GetUnitY(aizenHero),GetUnitX(cutTarget)-GetUnitX(aizenHero))
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
local integer cutLevel=GetUnitAbilityLevel(aizenHero,'AY04')
if cutLevel<1 then
set cutLevel=GetUnitAbilityLevel(aizenHero,'AY03')
endif
if cutLevel<1 then
set cutLevel=1
endif
call AYKyokaEnd(aizenHero)
call AYShowFirstE(aizenHero)
set nearbyUnit=LoadUnitHandle(AYHash,GetHandleId(aizenHero),144)
call SaveUnitHandle(AYHash,GetHandleId(aizenHero),144,null)
if nearbyUnit!=null then
call RemoveSavedHandle(AYHash,GetHandleId(nearbyUnit),143)
if GetWidgetLife(nearbyUnit)>.405 then
call KillUnit(nearbyUnit)
endif
endif
call DestroyGroup(nearbyUnits)
set nearbyUnits=null
set nearbyUnit=null
call AYPlaySound("war3mapImported\\Aizen\\Aizen3 Q3.wav",aizenHero,127)
call AYShunpoMove(aizenHero,GetUnitX(cutTarget)+70.*Cos(cutAngle),GetUnitY(cutTarget)+70.*Sin(cutAngle))
call SetUnitFacing(aizenHero,cutAngle*bj_RADTODEG+180.)
call AYPlayAnimationIndex(aizenHero,1,.01)
call AYStun(aizenHero,cutTarget,1.)
call AYPhysicalDamage(aizenHero,cutTarget,100.+50.*cutLevel+1.5*GetHeroAgi(aizenHero,false)+2.*GetHeroInt(aizenHero,false))
call AYPlaySound("war3mapImported\\Aizen\\Nel2 W2.wav",aizenHero,127)
call AYEffect(aizenHero,'hY12',GetUnitX(cutTarget),GetUnitY(cutTarget),cutAngle*bj_RADTODEG,1.75,2.1,1.65)
call SetUnitFlyHeight(AYLastEffect,70.,0.)
call AYEffect(aizenHero,'hY22',GetUnitX(cutTarget),GetUnitY(cutTarget),cutAngle*bj_RADTODEG,3.,1.4,1.5)
call SetUnitFlyHeight(AYLastEffect,100.,0.)
endfunction
function AYKyokaOnDamage takes nothing returns nothing
if Damage>0. and GetUnitTypeId(Source)=='HA00' and AYIsAttackDamage() and not IsUnitIllusion(Source) and LoadBoolean(AYHash,GetHandleId(Source),140) and AYIsEnemyTarget(Source,Target) then
call AYKyokaCut(Source,Target)
endif
endfunction
function AYKyokaOnDeath takes nothing returns boolean
local unit clone=GetTriggerUnit()
local unit aizenHero=LoadUnitHandle(AYHash,GetHandleId(clone),143)
local unit killer=GetKillingUnit()
if aizenHero!=null then
call RemoveSavedHandle(AYHash,GetHandleId(clone),143)
if LoadUnitHandle(AYHash,GetHandleId(aizenHero),144)==clone then
call SaveUnitHandle(AYHash,GetHandleId(aizenHero),144,null)
if LoadBoolean(AYHash,GetHandleId(aizenHero),140) and GetWidgetLife(aizenHero)>.405 and AYIsEnemyTarget(aizenHero,killer) then
call AYKyokaCut(aizenHero,killer)
endif
endif
endif
set clone=null
set aizenHero=null
set killer=null
return false
endfunction
// ---------------------------------------------------------------- R: Kanzen Saimin
function AYKanzenPickTarget takes unit aizenHero,boolean heroesOnly returns integer
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
local integer foundCount=0
local real farthestDistance=-1.
local real candidateDistance
call GroupEnumUnitsInRange(nearbyUnits,GetUnitX(aizenHero),GetUnitY(aizenHero),1305.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if IsUnitInGroup(nearbyUnit,AYHypnotized) and AYIsEnemyTarget(aizenHero,nearbyUnit) and (IsUnitType(nearbyUnit,UNIT_TYPE_HERO) or not heroesOnly) then
set foundCount=foundCount+1
set candidateDistance=SquareRoot((GetUnitX(nearbyUnit)-GetUnitX(aizenHero))*(GetUnitX(nearbyUnit)-GetUnitX(aizenHero))+(GetUnitY(nearbyUnit)-GetUnitY(aizenHero))*(GetUnitY(nearbyUnit)-GetUnitY(aizenHero)))
if farthestDistance<0. or candidateDistance<farthestDistance then
set farthestDistance=candidateDistance
call SaveUnitHandle(AYHash,GetHandleId(aizenHero),122,nearbyUnit)
endif
endif
endloop
call DestroyGroup(nearbyUnits)
set nearbyUnits=null
return foundCount
endfunction
function AYInvulnerableEnd takes nothing returns nothing
local timer invulnerableTimer=GetExpiredTimer()
call UnitRemoveAbility(LoadUnitHandle(AYHash,GetHandleId(invulnerableTimer),0),'Avul')
call FlushChildHashtable(AYHash,GetHandleId(invulnerableTimer))
call DestroyTimer(invulnerableTimer)
set invulnerableTimer=null
endfunction
function AYKanzenTargetEffects takes unit aizenHero,unit hypnotizedUnit returns nothing
call AYEffect(aizenHero,'hY12',GetUnitX(hypnotizedUnit),GetUnitY(hypnotizedUnit),GetRandomReal(0.,359.),0.,2.,0.)
call AYFollow(AYLastEffect,hypnotizedUnit,1.5,45.)
call AYEffect(aizenHero,'hY13',GetUnitX(hypnotizedUnit),GetUnitY(hypnotizedUnit),GetRandomReal(0.,359.),1.85,1.75,0.)
call AYFollow(AYLastEffect,hypnotizedUnit,1.5,85.)
call AYEffect(aizenHero,'hY14',GetUnitX(hypnotizedUnit),GetUnitY(hypnotizedUnit),GetRandomReal(0.,359.),0.,1.05,0.)
call AYFollow(AYLastEffect,hypnotizedUnit,1.,45.)
endfunction
function AYKanzenVanishEnd takes nothing returns nothing
local timer vanishTimer=GetExpiredTimer()
local unit aizenHero=LoadUnitHandle(AYHash,GetHandleId(vanishTimer),0)
if LoadInteger(AYHash,GetHandleId(aizenHero),166)==LoadInteger(AYHash,GetHandleId(vanishTimer),1) then
call UnitRemoveAbility(aizenHero,'AYRW')
call UnitRemoveAbility(aizenHero,'BOwk')
endif
call FlushChildHashtable(AYHash,GetHandleId(vanishTimer))
call DestroyTimer(vanishTimer)
set vanishTimer=null
set aizenHero=null
endfunction
function AYKanzenVanish takes unit aizenHero returns nothing
local timer vanishTimer=CreateTimer()
local integer castCount=LoadInteger(AYHash,GetHandleId(aizenHero),166)+1
call SaveInteger(AYHash,GetHandleId(aizenHero),166,castCount)
call UnitAddAbility(aizenHero,'AYRW')
call SetUnitAbilityLevel(aizenHero,'AYRW',GetUnitAbilityLevel(aizenHero,'AY05'))
call IssueImmediateOrder(aizenHero,"windwalk")
call SaveUnitHandle(AYHash,GetHandleId(vanishTimer),0,aizenHero)
call SaveInteger(AYHash,GetHandleId(vanishTimer),1,castCount)
call TimerStart(vanishTimer,1.05+GetUnitAbilityLevel(aizenHero,'AY05'),false,function AYKanzenVanishEnd)
set vanishTimer=null
endfunction
function AYKanzenFinish takes integer timerKey returns nothing
local unit aizenHero=LoadUnitHandle(AYHash,timerKey,0)
local real accumulatedDamage=LoadReal(AYHash,GetHandleId(aizenHero),121)
local real maxDamage=LoadReal(AYHash,timerKey,5)
local real castLife=LoadReal(AYHash,timerKey,6)
local real castX=LoadReal(AYHash,timerKey,7)
local real castY=LoadReal(AYHash,timerKey,8)
local integer hypnotizedCount
local integer totalCount
local unit hypnotizedUnit=null
local real swapX
local real swapY
local timer invulnerableTimer
local unit illusionCaster
call UnitRemoveAbility(aizenHero,'AYRV')
call UnitRemoveAbility(aizenHero,'AYRW')
call UnitRemoveAbility(aizenHero,'BOwk')
call UnitRemoveAbility(aizenHero,'BYR0')
if GetWidgetLife(aizenHero)>.405 then
// an illusion of Aizen with his current life stays at the cast point
set illusionCaster=CreateUnit(GetOwningPlayer(aizenHero),'hL02',GetUnitX(aizenHero),GetUnitY(aizenHero),0.)
call UnitAddAbility(illusionCaster,'AYRI')
call SetUnitAbilityLevel(illusionCaster,'AYRI',GetUnitAbilityLevel(aizenHero,'AY05'))
call UnitApplyTimedLife(illusionCaster,'BTLF',1.)
call IssueTargetOrderById(illusionCaster,852274,aizenHero)
endif
if accumulatedDamage>0. and GetWidgetLife(aizenHero)>.405 then
call SaveUnitHandle(AYHash,GetHandleId(aizenHero),122,null)
set totalCount=AYKanzenPickTarget(aizenHero,false)
set hypnotizedCount=AYKanzenPickTarget(aizenHero,true)
if hypnotizedCount==0 then
set hypnotizedCount=AYKanzenPickTarget(aizenHero,false)
endif
if hypnotizedCount>0 then
set hypnotizedUnit=LoadUnitHandle(AYHash,GetHandleId(aizenHero),122)
endif
if accumulatedDamage>maxDamage then
set accumulatedDamage=maxDamage
endif
call AYPlaySound("war3mapImported\\Aizen\\Aizen1 Moph2.wav",aizenHero,127)
call AYPlaySound("war3mapImported\\Aizen\\Aizen2 T.wav",aizenHero,127)
if totalCount==1 and hypnotizedUnit!=null then
set swapX=GetUnitX(hypnotizedUnit)
set swapY=GetUnitY(hypnotizedUnit)
call SetUnitPosition(hypnotizedUnit,GetUnitX(aizenHero),GetUnitY(aizenHero))
call AYEffect(aizenHero,'hY11',GetUnitX(hypnotizedUnit),GetUnitY(hypnotizedUnit),GetRandomReal(0.,359.),4.,1.,1.5)
call AYEffect(aizenHero,'hY11',GetUnitX(hypnotizedUnit),GetUnitY(hypnotizedUnit),GetRandomReal(0.,359.),5.,1.,1.5)
call AYKanzenTargetEffects(aizenHero,hypnotizedUnit)
call AYMagicDamage(aizenHero,hypnotizedUnit,accumulatedDamage)
call AYShunpoMove(aizenHero,swapX,swapY)
else
if hypnotizedUnit!=null then
call AYKanzenTargetEffects(aizenHero,hypnotizedUnit)
call AYMagicDamage(aizenHero,hypnotizedUnit,accumulatedDamage)
endif
call AYEffect(aizenHero,'hY11',GetUnitX(aizenHero),GetUnitY(aizenHero),GetRandomReal(0.,359.),4.,.5,5.)
call AYEffect(aizenHero,'hY11',GetUnitX(aizenHero),GetUnitY(aizenHero),GetRandomReal(0.,359.),5.,.5,5.)
call AYShunpoMove(aizenHero,castX,castY)
endif
if castLife>GetWidgetLife(aizenHero) then
call SetWidgetLife(aizenHero,castLife)
endif
call UnitAddAbility(aizenHero,'Avul')
set invulnerableTimer=CreateTimer()
call SaveUnitHandle(AYHash,GetHandleId(invulnerableTimer),0,aizenHero)
call TimerStart(invulnerableTimer,1.,false,function AYInvulnerableEnd)
set invulnerableTimer=null
endif
call SaveBoolean(AYHash,GetHandleId(aizenHero),120,false)
call SaveBoolean(AYHash,GetHandleId(aizenHero),123,false)
call SaveReal(AYHash,GetHandleId(aizenHero),121,0.)
if GetWidgetLife(aizenHero)>.405 then
call AYKanzenVanish(aizenHero)
endif
set illusionCaster=null
set aizenHero=null
set hypnotizedUnit=null
endfunction
function AYKanzenTick takes nothing returns nothing
local timer kanzenTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(kanzenTimer)
local unit aizenHero=LoadUnitHandle(AYHash,timerKey,0)
local real kanzenElapsed=LoadReal(AYHash,timerKey,1)+.02
local real kanzenDuration=LoadReal(AYHash,timerKey,2)
local real messageWait=LoadReal(AYHash,timerKey,3)+.02
if kanzenElapsed<kanzenDuration and GetWidgetLife(aizenHero)>.405 and LoadBoolean(AYHash,GetHandleId(aizenHero),120) then
call SaveReal(AYHash,timerKey,1,kanzenElapsed)
if messageWait>.48 then
set messageWait=0.
call DisplayTimedTextToPlayer(GetOwningPlayer(aizenHero),0.,0.,.4,"|c00FF0000Kanzen Saimin Time: "+R2SW(kanzenDuration-kanzenElapsed,1,1)+" sec|r")
endif
call SaveReal(AYHash,timerKey,3,messageWait)
else
call AYKanzenFinish(timerKey)
call FlushChildHashtable(AYHash,timerKey)
call DestroyTimer(kanzenTimer)
endif
set kanzenTimer=null
set aizenHero=null
endfunction
function AYKanzenSaimin takes unit aizenHero returns nothing
local timer kanzenTimer=CreateTimer()
local integer timerKey=GetHandleId(kanzenTimer)
call SaveUnitHandle(AYHash,timerKey,0,aizenHero)
call SaveReal(AYHash,timerKey,1,0.)
call SaveReal(AYHash,timerKey,2,1.+GetUnitAbilityLevel(aizenHero,'AY05'))
call SaveReal(AYHash,timerKey,3,999.)
call SaveReal(AYHash,timerKey,5,200.+100.*GetUnitAbilityLevel(aizenHero,'AY05')+5.*(GetHeroStr(aizenHero,false)+GetHeroAgi(aizenHero,false)+GetHeroInt(aizenHero,false)))
call SaveReal(AYHash,timerKey,6,GetWidgetLife(aizenHero))
call SaveReal(AYHash,timerKey,7,GetUnitX(aizenHero))
call SaveReal(AYHash,timerKey,8,GetUnitY(aizenHero))
call SaveBoolean(AYHash,GetHandleId(aizenHero),120,true)
call SaveReal(AYHash,GetHandleId(aizenHero),121,0.)
call AYPlayAnimationIndex(aizenHero,7,.01)
call TimerStart(kanzenTimer,.02,true,function AYKanzenTick)
set kanzenTimer=null
endfunction
function AYKanzenOnDamage takes nothing returns nothing
local real floorLife
if Damage>0. and LoadBoolean(AYHash,GetHandleId(Target),123) then
call AYPreventDamage(Target,Damage)
return
endif
if Damage<=0. or not LoadBoolean(AYHash,GetHandleId(Target),120) then
return
endif
set floorLife=1.
if GetWidgetLife(Target)-Damage<=floorLife then
call SaveBoolean(AYHash,GetHandleId(Target),123,true)
call SaveReal(AYHash,GetHandleId(Target),121,LoadReal(AYHash,GetHandleId(Target),121)+Damage)
call AYPreventDamage(Target,Damage-(GetWidgetLife(Target)-floorLife))
call SaveBoolean(AYHash,GetHandleId(Target),120,false)
else
call SaveReal(AYHash,GetHandleId(Target),121,LoadReal(AYHash,GetHandleId(Target),121)+Damage)
endif
endfunction
// ---------------------------------------------------------------- T: Hado #90 Kurohitsugi
function AYCoffinDamage takes integer abilityLevel returns real
return 750.+250.*abilityLevel
endfunction
function AYCoffinCastEnd takes unit aizenHero returns nothing
call PauseUnit(aizenHero,false)
call SetUnitInvulnerable(aizenHero,false)
call SetUnitTimeScale(aizenHero,1.)
endfunction
function AYKurohitsugiTick takes nothing returns nothing
local timer coffinTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(coffinTimer)
local unit aizenHero=LoadUnitHandle(AYHash,timerKey,0)
local real coffinX=LoadReal(AYHash,timerKey,1)
local real coffinY=LoadReal(AYHash,timerKey,2)
local integer coffinTicks=LoadInteger(AYHash,timerKey,4)+1
local group nearbyUnits
local unit nearbyUnit
if GetWidgetLife(aizenHero)<=.405 or coffinTicks>81 then
if coffinTicks<=75 then
call AYCoffinCastEnd(aizenHero)
endif
call FlushChildHashtable(AYHash,timerKey)
call DestroyTimer(coffinTimer)
set coffinTimer=null
set aizenHero=null
return
endif
call SaveInteger(AYHash,timerKey,4,coffinTicks)
if coffinTicks==25 then
call AYEffect(aizenHero,'hY09',coffinX,coffinY,90.,.8,1.85,1.5)
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,coffinX,coffinY,505.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if AYIsEnemyTarget(aizenHero,nearbyUnit) and GetUnitFlyHeight(nearbyUnit)<750. then
call AYRoot(aizenHero,nearbyUnit)
endif
endloop
call DestroyGroup(nearbyUnits)
endif
if coffinTicks>40 and ModuloInteger(coffinTicks-40,12)==1 then
call AYEffect(aizenHero,'hY10',coffinX,coffinY,GetRandomReal(0.,359.),1.92,GetRandomReal(1.45,2.15),1.15)
endif
if coffinTicks==60 or coffinTicks==65 or coffinTicks==70 or coffinTicks==75 then
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,coffinX,coffinY,505.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if AYIsEnemyTarget(aizenHero,nearbyUnit) and GetUnitFlyHeight(nearbyUnit)<1050. then
call AYMagicDamage(aizenHero,nearbyUnit,LoadReal(AYHash,timerKey,5))
if coffinTicks==75 then
call AYStun(aizenHero,nearbyUnit,1.)
endif
endif
endloop
call DestroyGroup(nearbyUnits)
endif
// the 1.5 second cast ends with the final hit
if coffinTicks==75 then
call AYCoffinCastEnd(aizenHero)
endif
set nearbyUnits=null
set coffinTimer=null
set aizenHero=null
endfunction
function AYKurohitsugi takes unit aizenHero,real targetX,real targetY returns nothing
local timer coffinTimer=CreateTimer()
local integer timerKey=GetHandleId(coffinTimer)
local real castAngle=Atan2(targetY-GetUnitY(aizenHero),targetX-GetUnitX(aizenHero))
call SaveUnitHandle(AYHash,timerKey,0,aizenHero)
call SaveReal(AYHash,timerKey,1,targetX)
call SaveReal(AYHash,timerKey,2,targetY)
call SaveInteger(AYHash,timerKey,4,0)
call SaveReal(AYHash,timerKey,5,(AYCoffinDamage(GetUnitAbilityLevel(aizenHero,'AY06'))+(5.+GetUnitAbilityLevel(aizenHero,'AY06'))*GetHeroInt(aizenHero,true))/4.)
// cast time 1.5 seconds: Aizen cannot be interrupted, stunned, rooted or targeted
call PauseUnit(aizenHero,true)
call SetUnitInvulnerable(aizenHero,true)
call AYPlaySound("war3mapImported\\Aizen\\Aizen2 R.wav",aizenHero,127)
call SetUnitFacing(aizenHero,castAngle*bj_RADTODEG)
call SetUnitTimeScale(aizenHero,1.)
call AYPlayAnimationIndex(aizenHero,9,.01)
call AYEffect(aizenHero,'hY07',GetUnitX(aizenHero)+100.*Cos(castAngle),GetUnitY(aizenHero)+100.*Sin(castAngle),90.,0.,1.25,1.)
call AYEffect(aizenHero,'hY08',targetX,targetY,GetRandomReal(0.,359.),8.5,.75,0.)
call AYFadeOut(AYLastEffect,105,0,255,1.)
call TimerStart(coffinTimer,.02,true,function AYKurohitsugiTick)
set coffinTimer=null
endfunction
// ---------------------------------------------------------------- dispatch
function AYDamageHook takes nothing returns nothing
call AYKyokaOnDamage()
if GetUnitTypeId(Target)=='HA00' and not IsUnitIllusion(Target) then
call AYSwipeGuardOnDamage()
endif
call AYDankuOnDamage()
if GetUnitTypeId(Target)=='HA00' and not IsUnitIllusion(Target) then
call AYKanzenOnDamage()
endif
endfunction
function AYOnSpell takes nothing returns boolean
local unit aizenHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
if GetUnitTypeId(aizenHero)=='HA00' and SilenceConditions(aizenHero) then
if spellId=='AY01' then
call AYRaikohoFire(aizenHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AY02' then
call AYDanku(aizenHero)
elseif spellId=='AY03' then
call AYInstantSwipe(aizenHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AY04' then
call AYKyokaSuigetsu(aizenHero)
elseif spellId=='AY05' then
call AYKanzenSaimin(aizenHero)
elseif spellId=='AY06' then
call AYKurohitsugi(aizenHero,GetSpellTargetX(),GetSpellTargetY())
endif
endif
set aizenHero=null
return false
endfunction
function AYOnEndCast takes nothing returns boolean
if GetSpellAbilityId()=='AY01' and LoadBoolean(AYHash,GetHandleId(GetTriggerUnit()),160) then
// cancelled while charging: the frozen animation must not stay
call SaveBoolean(AYHash,GetHandleId(GetTriggerUnit()),160,false)
call SetUnitTimeScale(GetTriggerUnit(),1.)
call AYSetTimeScaleLater(GetTriggerUnit(),1.,.36)
endif
return false
endfunction
function AYOnChannel takes nothing returns boolean
if GetSpellAbilityId()=='AY01' and GetUnitTypeId(GetTriggerUnit())=='HA00' then
call AYRaikoho(GetTriggerUnit(),GetSpellTargetX(),GetSpellTargetY())
endif
return false
endfunction
function AYOnLearn takes nothing returns boolean
local unit aizenHero=GetTriggerUnit()
if GetLearnedSkill()=='AY03' then
if GetUnitAbilityLevel(aizenHero,'AY04')>0 then
call SetUnitAbilityLevel(aizenHero,'AY04',GetUnitAbilityLevel(aizenHero,'AY03'))
else
call SetPlayerAbilityAvailable(GetOwningPlayer(aizenHero),'AY03',true)
endif
endif
set aizenHero=null
return false
endfunction
function AYInit takes nothing returns nothing
local trigger spellTrigger=CreateTrigger()
local trigger learnTrigger=CreateTrigger()
local trigger attackTrigger=CreateTrigger()
local trigger endCastTrigger=CreateTrigger()
local trigger cloneDeathTrigger=CreateTrigger()
local trigger cloneSummonTrigger=CreateTrigger()
set AYHash=InitHashtable()
set AYClock=CreateTimer()
call TimerStart(AYClock,1000000.,false,null)
set AYHypnotized=CreateGroup()
call AYPreloadSound("war3mapImported\\Aizen\\Aizen1 R.wav",1153)
call AYPreloadSound("war3mapImported\\Aizen\\Ichigo3 Q.wav",2031)
call AYPreloadSound("war3mapImported\\Aizen\\Aizen1 T2.wav",2593)
call AYPreloadSound("war3mapImported\\Aizen\\Aizen3 Q.wav",504)
call AYPreloadSound("war3mapImported\\Aizen\\sword (4).wav",576)
call AYPreloadSound("war3mapImported\\Aizen\\Aizen Shield.wav",1284)
call AYPreloadSound("war3mapImported\\Aizen\\Aizen3 Q2.wav",2700)
call AYPreloadSound("war3mapImported\\Aizen\\Aizen3 Q3.wav",1812)
call AYPreloadSound("war3mapImported\\Aizen\\Nel2 W2.wav",3030)
call AYPreloadSound("war3mapImported\\Aizen\\Aizen1 Moph2.wav",3266)
call AYPreloadSound("war3mapImported\\Aizen\\Aizen2 T.wav",1124)
call AYPreloadSound("war3mapImported\\Aizen\\Aizen2 R.wav",4650)
call TriggerRegisterAnyUnitEventBJ(cloneDeathTrigger,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(cloneDeathTrigger,Condition(function AYKyokaOnDeath))
call TriggerRegisterAnyUnitEventBJ(cloneSummonTrigger,EVENT_PLAYER_UNIT_SUMMON)
call TriggerAddCondition(cloneSummonTrigger,Condition(function AYKyokaOnSummon))
set cloneDeathTrigger=null
set cloneSummonTrigger=null
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(spellTrigger,Condition(function AYOnSpell))
call TriggerRegisterAnyUnitEventBJ(learnTrigger,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(learnTrigger,Condition(function AYOnLearn))
call TriggerRegisterAnyUnitEventBJ(attackTrigger,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(attackTrigger,Condition(function AYOnAttacked))
call TriggerRegisterAnyUnitEventBJ(endCastTrigger,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(endCastTrigger,Condition(function AYOnEndCast))
set endCastTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(endCastTrigger,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(endCastTrigger,Condition(function AYOnChannel))
set spellTrigger=null
set learnTrigger=null
set attackTrigger=null
set endCastTrigger=null
endfunction
// Shanks, ported from U9 DreamPiece 3.0 (Redhair_1, Redhair_1_1, Redhair_2, Redhair_3, Redhair_3_3, Redhair_3_4,
// Redhair_4). The GUI globals of the original are replaced by timers with hashtable data, so several casts can run
// at the same time; damage numbers are scaled to BvO.
function SKIsEnemy takes unit shanksHero,unit candidate returns boolean
return candidate!=null and GetWidgetLife(candidate)>.405 and not IsUnitType(candidate,UNIT_TYPE_DEAD) and IsUnitEnemy(candidate,GetOwningPlayer(shanksHero)) and not IsUnitType(candidate,UNIT_TYPE_STRUCTURE) and GetUnitAbilityLevel(candidate,'Aloc')==0
endfunction
function SKDamage takes unit shanksHero,unit damagedUnit,real damageAmount returns nothing
call BvOHeroSpellDamage(shanksHero,damagedUnit,damageAmount,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endfunction
// E Exposed Haki: pure, R Haoshoku Haki: physical
function SKKindDamage takes unit shanksHero,unit damagedUnit,real damageAmount,integer damageKind returns nothing
call BvOKindSpellDamage(shanksHero,damagedUnit,damageAmount,true,damageKind)
endfunction
function SKFlashEffect takes string effectPath,real effectX,real effectY returns nothing
call DestroyEffect(AddSpecialEffect(effectPath,effectX,effectY))
endfunction
function SKDummy takes unit shanksHero,integer dummyType,real dummyX,real dummyY,real dummyFacing,real dummyLife returns unit
set SKLastDummy=CreateUnit(GetOwningPlayer(shanksHero),dummyType,dummyX,dummyY,dummyFacing)
call UnitApplyTimedLife(SKLastDummy,'BTLF',dummyLife)
return SKLastDummy
endfunction
function SKStopTimer takes timer spellTimer returns nothing
call FlushChildHashtable(SKHash,GetHandleId(spellTimer))
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endfunction
// decelerating slide of the YDWE "RushSlide" pattern: the first step is 2 x distance x interval / time and it shrinks
// linearly to zero, so the whole distance is covered in the given time
function SKSlideTick takes nothing returns nothing
local timer slideTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(slideTimer)
local unit slidingUnit=LoadUnitHandle(SKHash,timerKey,0)
local real slideAngle=LoadReal(SKHash,timerKey,1)
local real slideStep=LoadReal(SKHash,timerKey,2)
local real nextX=GetUnitX(slidingUnit)+slideStep*Cos(slideAngle)
local real nextY=GetUnitY(slidingUnit)+slideStep*Sin(slideAngle)
local integer slideTicks=LoadInteger(SKHash,timerKey,5)+1
local boolean slideDone=false
if GetUnitTypeId(slidingUnit)==0 or slideStep<=0. or not RectContainsCoords(bj_mapInitialPlayableArea,nextX,nextY) then
set slideDone=true
elseif not LoadBoolean(SKHash,timerKey,4) and IsTerrainPathable(nextX,nextY,PATHING_TYPE_WALKABILITY) then
set slideDone=true
else
call SetUnitX(slidingUnit,nextX)
call SetUnitY(slidingUnit,nextY)
if HaveSavedString(SKHash,timerKey,6) and ModuloInteger(slideTicks,2)==0 and GetUnitFlyHeight(slidingUnit)<5. then
call SKFlashEffect(LoadStr(SKHash,timerKey,6),nextX,nextY)
endif
call SaveReal(SKHash,timerKey,2,slideStep-LoadReal(SKHash,timerKey,3))
call SaveInteger(SKHash,timerKey,5,slideTicks)
endif
if slideDone then
call SKStopTimer(slideTimer)
endif
set slideTimer=null
set slidingUnit=null
endfunction
function SKSlide takes unit slidingUnit,real slideAngle,real slideDistance,real slideTime,boolean ignorePathing,string groundEffect returns nothing
local timer slideTimer=CreateTimer()
local integer timerKey=GetHandleId(slideTimer)
local real firstStep=2.*slideDistance*.01/slideTime
call SaveUnitHandle(SKHash,timerKey,0,slidingUnit)
call SaveReal(SKHash,timerKey,1,slideAngle)
call SaveReal(SKHash,timerKey,2,firstStep)
call SaveReal(SKHash,timerKey,3,firstStep*.01/slideTime)
call SaveBoolean(SKHash,timerKey,4,ignorePathing)
call SaveInteger(SKHash,timerKey,5,0)
if groundEffect!="" then
call SaveStr(SKHash,timerKey,6,groundEffect)
endif
call TimerStart(slideTimer,.01,true,function SKSlideTick)
set slideTimer=null
endfunction
// ---------------------------------------------------------------- Q: Strike for the New World
function SKStrikeTick takes nothing returns nothing
local timer strikeTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(strikeTimer)
local unit shanksHero=LoadUnitHandle(SKHash,timerKey,0)
local unit strikeWave=LoadUnitHandle(SKHash,timerKey,1)
local group hitUnits=LoadGroupHandle(SKHash,timerKey,2)
local integer strikeTicks=LoadInteger(SKHash,timerKey,3)+1
local real waveX=LoadReal(SKHash,timerKey,5)
local real waveY=LoadReal(SKHash,timerKey,6)
local group nearbyUnits
local unit nearbyUnit
if GetUnitTypeId(strikeWave)!=0 and GetWidgetLife(strikeWave)>.405 then
set waveX=GetUnitX(strikeWave)
set waveY=GetUnitY(strikeWave)
call SaveReal(SKHash,timerKey,5,waveX)
call SaveReal(SKHash,timerKey,6,waveY)
endif
call SaveInteger(SKHash,timerKey,3,strikeTicks)
call SKDummy(shanksHero,'hK02',waveX,waveY,LoadReal(SKHash,timerKey,7),.5)
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,waveX,waveY,300.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(shanksHero,nearbyUnit) and not IsUnitInGroup(nearbyUnit,hitUnits) then
call GroupAddUnit(hitUnits,nearbyUnit)
call SKDamage(shanksHero,nearbyUnit,LoadReal(SKHash,timerKey,4)*(1.+GetRandomReal(.3,.6)))
call SKFlashEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",GetUnitX(nearbyUnit),GetUnitY(nearbyUnit))
endif
endloop
call DestroyGroup(nearbyUnits)
if strikeTicks>=10 then
call DestroyGroup(hitUnits)
call SKStopTimer(strikeTimer)
endif
set strikeTimer=null
set shanksHero=null
set strikeWave=null
set hitUnits=null
set nearbyUnits=null
endfunction
function SKStrike takes unit shanksHero,real targetX,real targetY returns nothing
local timer strikeTimer=CreateTimer()
local integer timerKey=GetHandleId(strikeTimer)
local real strikeAngle=Atan2(targetY-GetUnitY(shanksHero),targetX-GetUnitX(shanksHero))
local unit strikeWave=SKDummy(shanksHero,'hK01',GetUnitX(shanksHero),GetUnitY(shanksHero),strikeAngle*bj_RADTODEG,.5)
call StartSound(SKSoundStrike)
call SKSlide(strikeWave,strikeAngle,700.+50.*GetUnitAbilityLevel(shanksHero,'AK01'),.8,true,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call SaveUnitHandle(SKHash,timerKey,0,shanksHero)
call SaveUnitHandle(SKHash,timerKey,1,strikeWave)
call SaveGroupHandle(SKHash,timerKey,2,CreateGroup())
call SaveInteger(SKHash,timerKey,3,0)
call SaveReal(SKHash,timerKey,4,100.+100.*GetUnitAbilityLevel(shanksHero,'AK01')+GetHeroAgi(shanksHero,true))
call SaveReal(SKHash,timerKey,5,GetUnitX(shanksHero))
call SaveReal(SKHash,timerKey,6,GetUnitY(shanksHero))
call SaveReal(SKHash,timerKey,7,strikeAngle*bj_RADTODEG)
call TimerStart(strikeTimer,.08,true,function SKStrikeTick)
set strikeTimer=null
set strikeWave=null
endfunction
// ---------------------------------------------------------------- W: Threat for the New World
function SKThreat takes unit shanksHero returns nothing
local integer burstIndex=1
local unit slowCaster
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
local real threatDamage=80.*GetUnitAbilityLevel(shanksHero,'AK02')+(.5+.3*GetUnitAbilityLevel(shanksHero,'AK02'))*GetHeroAgi(shanksHero,true)
local boolean hakiExposed=LoadBoolean(SKHash,GetHandleId(shanksHero),1)
call StartSound(SKSoundThreat)
call SKDummy(shanksHero,'hK03',GetUnitX(shanksHero),GetUnitY(shanksHero),GetRandomReal(0.,360.),1.)
call SetUnitTimeScale(SKLastDummy,.8)
call SetUnitScale(SKLastDummy,1.2,1.2,1.2)
loop
exitwhen burstIndex>5
call SKDummy(shanksHero,'hK04',GetUnitX(shanksHero),GetUnitY(shanksHero),GetRandomReal(0.,360.),1.)
call SetUnitTimeScale(SKLastDummy,.9-burstIndex*.1)
set burstIndex=burstIndex+1
endloop
set slowCaster=CreateUnit(GetOwningPlayer(shanksHero),'hL02',GetUnitX(shanksHero),GetUnitY(shanksHero),0.)
call UnitAddAbility(slowCaster,'AK0C')
call UnitApplyTimedLife(slowCaster,'BTLF',1.)
call IssueImmediateOrder(slowCaster,"thunderclap")
call GroupEnumUnitsInRange(nearbyUnits,GetUnitX(shanksHero),GetUnitY(shanksHero),360.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(shanksHero,nearbyUnit) then
call SKSlide(nearbyUnit,Atan2(GetUnitY(nearbyUnit)-GetUnitY(shanksHero),GetUnitX(nearbyUnit)-GetUnitX(shanksHero)),350.,.5,false,"")
if hakiExposed then
call SKDamage(shanksHero,nearbyUnit,threatDamage*(1.+GetRandomReal(.5,.8)))
else
call SKDamage(shanksHero,nearbyUnit,threatDamage*(1.+GetRandomReal(.2,.4)))
endif
call SKFlashEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(nearbyUnit),GetUnitY(nearbyUnit))
endif
endloop
call DestroyGroup(nearbyUnits)
set nearbyUnits=null
set slowCaster=null
endfunction
// ---------------------------------------------------------------- E: Exposed Haki
// Exposed Haki armor: AK0D (5/5/10/10/15) + 0.1 x AGI through the bit abilities AKA0..AKA9 (1, 2, 4 .. 512)
function SKSetAgiArmor takes unit shanksHero,integer armorValue returns nothing
local integer bitIndex=0
local integer bitValue=1
local integer abilityId
if armorValue>1023 then
set armorValue=1023
endif
loop
exitwhen bitIndex>9
set abilityId='AKA0'+bitIndex
if ModuloInteger(armorValue/bitValue,2)==1 then
if GetUnitAbilityLevel(shanksHero,abilityId)==0 then
call UnitAddAbility(shanksHero,abilityId)
endif
elseif GetUnitAbilityLevel(shanksHero,abilityId)>0 then
call UnitRemoveAbility(shanksHero,abilityId)
endif
set bitValue=bitValue*2
set bitIndex=bitIndex+1
endloop
endfunction
function SKHakiTick takes nothing returns nothing
local timer hakiTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(hakiTimer)
local unit shanksHero=LoadUnitHandle(SKHash,timerKey,0)
local integer hakiTicks=LoadInteger(SKHash,timerKey,2)+1
local real remaining=LoadReal(SKHash,timerKey,3)-TimerGetElapsed(AYClock)
local group nearbyUnits
local unit nearbyUnit
if LoadInteger(SKHash,GetHandleId(shanksHero),2)!=LoadInteger(SKHash,timerKey,1) then
call SKStopTimer(hakiTimer)
elseif remaining<=.00001 or GetWidgetLife(shanksHero)<=.405 then
call SaveBoolean(SKHash,GetHandleId(shanksHero),1,false)
call UnitRemoveAbility(shanksHero,'AK0D')
call SKSetAgiArmor(shanksHero,0)
call DestroyEffect(LoadEffectHandle(SKHash,GetHandleId(shanksHero),3))
call SKStopTimer(hakiTimer)
else
call SaveInteger(SKHash,timerKey,2,hakiTicks)
call SKSetAgiArmor(shanksHero,R2I(.1*GetHeroAgi(shanksHero,true)))
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,GetUnitX(shanksHero),GetUnitY(shanksHero),350.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(shanksHero,nearbyUnit) then
call SKKindDamage(shanksHero,nearbyUnit,10.*GetUnitAbilityLevel(shanksHero,'AK03')+.1*GetHeroAgi(shanksHero,true),CLEAN)
call SKFlashEffect("war3mapImported\\Shanks\\t_punishment_missle.mdl",GetUnitX(nearbyUnit),GetUnitY(nearbyUnit))
endif
endloop
call DestroyGroup(nearbyUnits)
call TimerStart(hakiTimer,RMinBJ(.4,remaining),false,function SKHakiTick)
endif
set hakiTimer=null
set shanksHero=null
set nearbyUnits=null
endfunction
function SKExposedHaki takes unit shanksHero returns nothing
local timer hakiTimer=CreateTimer()
local integer castCount=LoadInteger(SKHash,GetHandleId(shanksHero),2)+1
call SaveInteger(SKHash,GetHandleId(shanksHero),2,castCount)
if LoadBoolean(SKHash,GetHandleId(shanksHero),1) then
call DestroyEffect(LoadEffectHandle(SKHash,GetHandleId(shanksHero),3))
endif
call SaveBoolean(SKHash,GetHandleId(shanksHero),1,true)
call SaveEffectHandle(SKHash,GetHandleId(shanksHero),3,AddSpecialEffectTarget("war3mapImported\\Shanks\\[Effect]390.mdl",shanksHero,"origin"))
if GetUnitAbilityLevel(shanksHero,'AK0D')==0 then
call UnitAddAbility(shanksHero,'AK0D')
endif
call SetUnitAbilityLevel(shanksHero,'AK0D',GetUnitAbilityLevel(shanksHero,'AK03'))
call SKSetAgiArmor(shanksHero,R2I(.1*GetHeroAgi(shanksHero,true)))
call SaveUnitHandle(SKHash,GetHandleId(hakiTimer),0,shanksHero)
call SaveInteger(SKHash,GetHandleId(hakiTimer),1,castCount)
call SaveInteger(SKHash,GetHandleId(hakiTimer),2,0)
call SaveReal(SKHash,GetHandleId(hakiTimer),3,TimerGetElapsed(AYClock)+5.+GetUnitAbilityLevel(shanksHero,'AK03'))
call TimerStart(hakiTimer,.4,false,function SKHakiTick)
set hakiTimer=null
endfunction
function SKOnAttacked takes nothing returns boolean
local unit shanksHero=GetAttacker()
local unit attackedUnit=GetTriggerUnit()
if GetUnitTypeId(shanksHero)=='HK00' and LoadBoolean(SKHash,GetHandleId(shanksHero),1) and SKIsEnemy(shanksHero,attackedUnit) and GetRandomReal(0.,100.)<15. then
call SKKindDamage(shanksHero,attackedUnit,100.*GetUnitAbilityLevel(shanksHero,'AK03')+1.4*GetHeroAgi(shanksHero,true),CLEAN)
call SKFlashEffect("war3mapImported\\Shanks\\shadowassault.mdl",GetUnitX(attackedUnit),GetUnitY(attackedUnit))
endif
set shanksHero=null
set attackedUnit=null
return false
endfunction
// ---------------------------------------------------------------- R: Haoshoku Haki
function SKShakeEnd takes nothing returns nothing
local timer shakeTimer=GetExpiredTimer()
call CameraClearNoiseForPlayer(LoadPlayerHandle(SKHash,GetHandleId(shakeTimer),0))
call SKStopTimer(shakeTimer)
set shakeTimer=null
endfunction
function SKRArmorSet takes unit target,integer steps returns nothing
local integer bitIndex=0
local integer bitValue=1
local integer abilityId
loop
exitwhen bitIndex>=26
set abilityId='KR00'+bitIndex
if ModuloInteger(steps/bitValue,2)==1 then
if GetUnitAbilityLevel(target,abilityId)==0 then
call UnitAddAbility(target,abilityId)
call UnitMakeAbilityPermanent(target,true,abilityId)
endif
else
call UnitRemoveAbility(target,abilityId)
endif
set bitValue=bitValue*2
set bitIndex=bitIndex+1
endloop
endfunction
function SKRArmorEnd takes nothing returns nothing
local timer armorTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(armorTimer)
local unit target=LoadUnitHandle(SKHash,timerKey,0)
if GetUnitTypeId(target)==0 or GetWidgetLife(target)<=.405 or TimerGetElapsed(AYClock)>=LoadReal(SKHash,timerKey,1) then
call SKRArmorSet(target,0)
call DestroyEffect(LoadEffectHandle(SKHash,timerKey,2))
call RemoveSavedHandle(SKHash,GetHandleId(target),StringHash("SKRArmorTimer"))
call SKStopTimer(armorTimer)
endif
set target=null
set armorTimer=null
endfunction
function SKRArmorApply takes unit shanksHero,unit target returns nothing
local integer steps=(GetHeroAgi(shanksHero,false)-GetHeroAgi(target,false))/50
local timer armorTimer
local integer timerKey
if steps<=0 or GetWidgetLife(target)<=.405 then
return
endif
set armorTimer=LoadTimerHandle(SKHash,GetHandleId(target),StringHash("SKRArmorTimer"))
if armorTimer==null then
set armorTimer=CreateTimer()
set timerKey=GetHandleId(armorTimer)
call SaveTimerHandle(SKHash,GetHandleId(target),StringHash("SKRArmorTimer"),armorTimer)
call SaveUnitHandle(SKHash,timerKey,0,target)
call SaveEffectHandle(SKHash,timerKey,2,AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\FaerieFire\\FaerieFireTarget.mdl",target,"chest"))
call TimerStart(armorTimer,.02,true,function SKRArmorEnd)
endif
set timerKey=GetHandleId(armorTimer)
call SaveReal(SKHash,timerKey,1,TimerGetElapsed(AYClock)+2.)
call SKRArmorSet(target,steps)
set armorTimer=null
endfunction
function SKHaoshokuHaki takes unit shanksHero returns nothing
local timer shakeTimer=CreateTimer()
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
local real hakiDamage=300.*GetUnitAbilityLevel(shanksHero,'AK04')+3.*GetHeroStr(shanksHero,true)
call StartSound(SKSoundHaki)
call CameraSetEQNoiseForPlayer(GetOwningPlayer(shanksHero),15.)
call SavePlayerHandle(SKHash,GetHandleId(shakeTimer),0,GetOwningPlayer(shanksHero))
call TimerStart(shakeTimer,1.,false,function SKShakeEnd)
call SKDummy(shanksHero,'hK05',GetUnitX(shanksHero),GetUnitY(shanksHero),GetRandomReal(0.,360.),1.)
call SKDummy(shanksHero,'hK06',GetUnitX(shanksHero),GetUnitY(shanksHero),GetRandomReal(0.,360.),1.)
call GroupEnumUnitsInRange(nearbyUnits,GetUnitX(shanksHero),GetUnitY(shanksHero),600.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(shanksHero,nearbyUnit) then
call AYStun(shanksHero,nearbyUnit,2.)
call SKKindDamage(shanksHero,nearbyUnit,hakiDamage,PHYSICAL)
call SKRArmorApply(shanksHero,nearbyUnit)
call SKFlashEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(nearbyUnit),GetUnitY(nearbyUnit))
endif
endloop
call DestroyGroup(nearbyUnits)
set nearbyUnits=null
set shakeTimer=null
endfunction
// ---------------------------------------------------------------- T: Pinnacle of the Pirates (DreamOnePiece Shanks_5)
function SKPinnacleTick takes nothing returns nothing
local timer pinnacleTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(pinnacleTimer)
local unit shanksHero=LoadUnitHandle(SKHash,timerKey,0)
local integer pinnacleTicks=LoadInteger(SKHash,timerKey,1)+1
local real castX=LoadReal(SKHash,timerKey,2)
local real castY=LoadReal(SKHash,timerKey,3)
local unit slashUnit=LoadUnitHandle(SKHash,timerKey,4)
local group hitUnits=LoadGroupHandle(SKHash,timerKey,5)
local group nearbyUnits
local unit nearbyUnit
local real strikeAngle
local real strikeX
local real strikeY
local real slashDamage
call SaveInteger(SKHash,timerKey,1,pinnacleTicks)
if pinnacleTicks<=20 then
if ModuloInteger(pinnacleTicks,2)==0 then
set strikeAngle=GetRandomReal(0.,2.*bj_PI)
set strikeX=castX+GetRandomReal(50.,700.)*Cos(strikeAngle)
set strikeY=castY+GetRandomReal(50.,700.)*Sin(strikeAngle)
call SKDummy(shanksHero,'hK09',strikeX,strikeY,GetRandomReal(0.,360.),1.)
call SKFlashEffect("war3mapImported\\fuzzystomp.mdx",strikeX,strikeY)
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,strikeX,strikeY,250.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(shanksHero,nearbyUnit) then
call SKDamage(shanksHero,nearbyUnit,40.*GetUnitAbilityLevel(shanksHero,'AK05')+.4*GetHeroInt(shanksHero,true))
endif
endloop
call DestroyGroup(nearbyUnits)
endif
if pinnacleTicks==20 then
call CameraClearNoiseForPlayer(GetOwningPlayer(shanksHero))
call PauseUnit(shanksHero,false)
call SetUnitAnimation(shanksHero,"spell four")
call SKDummy(shanksHero,'hK10',GetUnitX(shanksHero),GetUnitY(shanksHero),GetUnitFacing(shanksHero)+180.,1.)
call SetUnitScale(SKLastDummy,2.5,2.5,2.5)
set slashUnit=SKDummy(shanksHero,'hK11',GetUnitX(shanksHero),GetUnitY(shanksHero),GetUnitFacing(shanksHero),1.)
call SKSlide(slashUnit,GetUnitFacing(shanksHero)*bj_DEGTORAD,1000.,.5,true,"")
call SaveUnitHandle(SKHash,timerKey,4,slashUnit)
endif
else
set strikeX=GetUnitX(slashUnit)
set strikeY=GetUnitY(slashUnit)
set strikeAngle=GetRandomReal(0.,2.*bj_PI)
call SKFlashEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",strikeX,strikeY)
call SKFlashEffect("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",strikeX+GetRandomReal(100.,320.)*Cos(strikeAngle),strikeY+GetRandomReal(100.,320.)*Sin(strikeAngle))
set slashDamage=600.+200.*GetUnitAbilityLevel(shanksHero,'AK05')+4.*GetHeroAgi(shanksHero,true)
if LoadBoolean(SKHash,GetHandleId(shanksHero),1) then
set slashDamage=slashDamage*1.1
endif
set nearbyUnits=CreateGroup()
call GroupEnumUnitsInRange(nearbyUnits,strikeX,strikeY,350.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(shanksHero,nearbyUnit) and not IsUnitInGroup(nearbyUnit,hitUnits) then
call GroupAddUnit(hitUnits,nearbyUnit)
call SKDamage(shanksHero,nearbyUnit,slashDamage)
endif
endloop
call DestroyGroup(nearbyUnits)
if pinnacleTicks>=30 then
call RemoveUnit(slashUnit)
call DestroyGroup(hitUnits)
call SKStopTimer(pinnacleTimer)
endif
endif
set pinnacleTimer=null
set shanksHero=null
set slashUnit=null
set hitUnits=null
set nearbyUnits=null
endfunction
function SKPinnacle takes unit shanksHero returns nothing
local timer pinnacleTimer=CreateTimer()
local integer timerKey=GetHandleId(pinnacleTimer)
local group nearbyUnits=CreateGroup()
local unit nearbyUnit
call PauseUnit(shanksHero,true)
call IssueImmediateOrder(shanksHero,"stop")
call SetUnitAnimation(shanksHero,"spell five")
call SKDummy(shanksHero,'hK07',GetUnitX(shanksHero),GetUnitY(shanksHero),GetRandomReal(0.,360.),1.)
call SetUnitTimeScale(SKLastDummy,.6)
call SKFlashEffect("Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl",GetUnitX(shanksHero),GetUnitY(shanksHero))
call SKDummy(shanksHero,'hK08',GetUnitX(shanksHero),GetUnitY(shanksHero),GetRandomReal(0.,360.),1.)
call SetUnitScale(SKLastDummy,3.,3.,3.)
call CameraSetEQNoiseForPlayer(GetOwningPlayer(shanksHero),20.)
call GroupEnumUnitsInRange(nearbyUnits,GetUnitX(shanksHero),GetUnitY(shanksHero),650.,null)
loop
set nearbyUnit=FirstOfGroup(nearbyUnits)
exitwhen nearbyUnit==null
call GroupRemoveUnit(nearbyUnits,nearbyUnit)
if SKIsEnemy(shanksHero,nearbyUnit) then
call AYStun(shanksHero,nearbyUnit,2.)
endif
endloop
call DestroyGroup(nearbyUnits)
call SaveUnitHandle(SKHash,timerKey,0,shanksHero)
call SaveInteger(SKHash,timerKey,1,0)
call SaveReal(SKHash,timerKey,2,GetUnitX(shanksHero))
call SaveReal(SKHash,timerKey,3,GetUnitY(shanksHero))
call SaveGroupHandle(SKHash,timerKey,5,CreateGroup())
call TimerStart(pinnacleTimer,.05,true,function SKPinnacleTick)
set pinnacleTimer=null
set nearbyUnits=null
endfunction
function SKPinnacleReady takes unit shanksHero returns boolean
return BvOFreeSpellsAppliesTo(shanksHero) or TimerGetElapsed(AYClock)>=LoadReal(SKHash,GetHandleId(shanksHero),StringHash("SKPinnacleReady"))
endfunction
function SKPinnacleChannel takes nothing returns boolean
local unit shanksHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
if GetUnitTypeId(shanksHero)=='HK00' and (spellId=='AK05' or spellId=='AK06') and not SKPinnacleReady(shanksHero) then
// Reject before mana payment and before a second cast can start.
call IssueImmediateOrder(shanksHero,"stop")
endif
set shanksHero=null
return false
endfunction
function SKPinnacleStart takes nothing returns nothing
local timer startTimer=GetExpiredTimer()
local unit shanksHero=LoadUnitHandle(SKHash,GetHandleId(startTimer),0)
call FlushChildHashtable(SKHash,GetHandleId(startTimer))
call DestroyTimer(startTimer)
// Pause/stop only after the native cast has committed its mana cost and cooldown.
if shanksHero!=null and GetUnitTypeId(shanksHero)=='HK00' and GetWidgetLife(shanksHero)>.405 and not IsUnitType(shanksHero,UNIT_TYPE_DEAD) then
call SKPinnacle(shanksHero)
endif
set startTimer=null
set shanksHero=null
endfunction
function SKPinnacleQueue takes unit shanksHero,integer spellId returns nothing
local integer buttonLevel=GetUnitAbilityLevel(shanksHero,spellId)
local real cooldown=120.
local timer startTimer
if not SKPinnacleReady(shanksHero) then
return
endif
if buttonLevel<=5 then
set cooldown=115.+5.*I2R(buttonLevel)
endif
// Record the actual button's cooldown before any timer or damage callback.
// One deadline survives Oken/level changes, removal/readdition and death.
call SaveReal(SKHash,GetHandleId(shanksHero),StringHash("SKPinnacleReady"),TimerGetElapsed(AYClock)+cooldown)
set startTimer=CreateTimer()
call SaveUnitHandle(SKHash,GetHandleId(startTimer),0,shanksHero)
call TimerStart(startTimer,.05,false,function SKPinnacleStart)
set startTimer=null
endfunction
// T: AK05 is the learned skill (hidden), AK06 the button: levels 1-5, or 6-10 (cooldown 120) with Oken
function SKSyncPinnacle takes unit shanksHero returns nothing
local integer learnedLevel=GetUnitAbilityLevel(shanksHero,'AK05')
local integer wantedLevel=learnedLevel
if learnedLevel>0 and FSHasSceptre(shanksHero) then
set wantedLevel=learnedLevel+5
endif
if wantedLevel==0 then
if GetUnitAbilityLevel(shanksHero,'AK06')>0 then
call UnitRemoveAbility(shanksHero,'AK06')
endif
else
if GetUnitAbilityLevel(shanksHero,'AK06')==0 then
call UnitAddAbility(shanksHero,'AK06')
call UnitMakeAbilityPermanent(shanksHero,true,'AK06')
endif
if GetUnitAbilityLevel(shanksHero,'AK06')!=wantedLevel and SKPinnacleReady(shanksHero) then
call SetUnitAbilityLevel(shanksHero,'AK06',wantedLevel)
endif
endif
endfunction
function SKSyncEnum takes nothing returns nothing
if GetUnitTypeId(GetEnumUnit())!='HK00' then
call GroupRemoveUnit(SKHeroes,GetEnumUnit())
else
call SKSyncPinnacle(GetEnumUnit())
endif
endfunction
function SKSyncTick takes nothing returns nothing
call ForGroup(SKHeroes,function SKSyncEnum)
endfunction
function SKTrackHero takes nothing returns boolean
if GetUnitTypeId(GetTriggerUnit())=='HK00' and not IsUnitIllusion(GetTriggerUnit()) then
call GroupAddUnit(SKHeroes,GetTriggerUnit())
call SKSyncPinnacle(GetTriggerUnit())
endif
return false
endfunction
// ---------------------------------------------------------------- dispatch
function SKOnSpell takes nothing returns boolean
local unit shanksHero=GetTriggerUnit()
local integer spellId=GetSpellAbilityId()
if GetUnitTypeId(shanksHero)=='HK00' and SilenceConditions(shanksHero) then
if spellId=='AK01' then
call SKStrike(shanksHero,GetSpellTargetX(),GetSpellTargetY())
elseif spellId=='AK02' then
call SKThreat(shanksHero)
elseif spellId=='AK03' then
call SKExposedHaki(shanksHero)
elseif spellId=='AK04' then
call SKHaoshokuHaki(shanksHero)
elseif spellId=='AK05' or spellId=='AK06' then
call SKPinnacleQueue(shanksHero,spellId)
elseif spellId=='AK0B' then
// Soru: the same floating text as Lucci's Soru
call I9x()
endif
endif
set shanksHero=null
return false
endfunction
function SKCreateSound takes string soundPath,integer soundDuration returns sound
local sound shanksSound=CreateSound(soundPath,false,false,false,10,10,"")
call SetSoundDuration(shanksSound,soundDuration)
call SetSoundChannel(shanksSound,0)
call SetSoundVolume(shanksSound,127)
call SetSoundPitch(shanksSound,1.)
set SKLastSound=shanksSound
set shanksSound=null
return SKLastSound
endfunction
function SKInit takes nothing returns nothing
local trigger spellTrigger=CreateTrigger()
local trigger channelTrigger=CreateTrigger()
local trigger attackTrigger=CreateTrigger()
set SKHash=InitHashtable()
set SKSoundStrike=SKCreateSound("war3mapImported\\Shanks\\hf1.mp3",1254)
set SKSoundThreat=SKCreateSound("war3mapImported\\Shanks\\hf2.mp3",966)
set SKSoundHaki=SKCreateSound("war3mapImported\\Shanks\\haki.mp3",3318)
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(spellTrigger,Condition(function SKOnSpell))
call TriggerRegisterAnyUnitEventBJ(channelTrigger,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(channelTrigger,Condition(function SKPinnacleChannel))
set channelTrigger=null
call TriggerRegisterAnyUnitEventBJ(attackTrigger,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(attackTrigger,Condition(function SKOnAttacked))
set SKHeroes=CreateGroup()
set spellTrigger=CreateTrigger()
call TriggerRegisterEnterRectSimple(spellTrigger,bj_mapInitialPlayableArea)
call TriggerRegisterAnyUnitEventBJ(spellTrigger,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(spellTrigger,Condition(function SKTrackHero))
call TimerStart(CreateTimer(),.2,true,function SKSyncTick)
set spellTrigger=null
set attackTrigger=null
endfunction
// ------------------------------------------------------------------ Kuzan: Ice Age (T) can be used once per cooldown
function KuzanIceAgeCooldownLeft takes unit kuzanHero returns real
local integer heroKey=GetHandleId(kuzanHero)
if not HaveSavedReal(KuzanHash,heroKey,0) then
return 0.
endif
return LoadReal(KuzanHash,heroKey,0)+LoadReal(KuzanHash,heroKey,1)-TimerGetElapsed(KuzanClock)
endfunction
function KuzanIceAgeOnCast takes nothing returns boolean
local unit kuzanHero=GetTriggerUnit()
local real cooldownLeft
local integer rank=GetUnitAbilityLevel(kuzanHero,'RKTL')
if GetSpellAbilityId()==$41303948 and not BvOFreeSpellsAppliesTo(kuzanHero) then
set cooldownLeft=KuzanIceAgeCooldownLeft(kuzanHero)
if cooldownLeft>.5 then
call IssueImmediateOrderById(kuzanHero,851972)
if GetLocalPlayer()==GetOwningPlayer(kuzanHero) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"                                                          |cffffcc00Ice Age is not ready ("+I2S(R2I(cooldownLeft+.99))+" s)|r")
endif
endif
endif
if GetSpellAbilityId()=='A09H' and rank>0 then
if FZHasOken(kuzanHero) then
call SetUnitAbilityLevel(kuzanHero,'A09H',rank+5)
else
call SetUnitAbilityLevel(kuzanHero,'A09H',rank)
endif
endif
set kuzanHero=null
return false
endfunction
function KuzanIceAgeOnEffect takes nothing returns boolean
local timer t
local integer restore13_KuzanIceAgeOnEffect_k
local integer rank=GetUnitAbilityLevel(GetTriggerUnit(),'RKTL')
if GetSpellAbilityId()==$41303948 then
call SaveReal(KuzanHash,GetHandleId(GetTriggerUnit()),0,TimerGetElapsed(KuzanClock))
if FZHasOken(GetTriggerUnit()) then
call SaveReal(KuzanHash,GetHandleId(GetTriggerUnit()),1,RBValue(rank,160.,150.,140.,130.,120.,120.))
else
call SaveReal(KuzanHash,GetHandleId(GetTriggerUnit()),1,RBValue(rank,200.,190.,180.,170.,160.,160.))
endif
if GetUnitAbilityLevel(GetTriggerUnit(),'A09H')>5 then
set t=CreateTimer()
set restore13_KuzanIceAgeOnEffect_k=GetHandleId(t)
call SaveUnitHandle(RBState,restore13_KuzanIceAgeOnEffect_k,0,GetTriggerUnit())
call SaveInteger(RBState,restore13_KuzanIceAgeOnEffect_k,1,'A09H')
call SaveInteger(RBState,restore13_KuzanIceAgeOnEffect_k,2,rank)
call TimerStart(t,0.,false,function RBMissRestoreRank)
set t=null
endif
endif
return false
endfunction
function KuzanFixesInit takes nothing returns nothing
local trigger castTrigger=CreateTrigger()
local trigger effectTrigger=CreateTrigger()
set KuzanHash=InitHashtable()
set KuzanClock=CreateTimer()
call TimerStart(KuzanClock,1000000.,false,null)
call TriggerRegisterAnyUnitEventBJ(castTrigger,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(castTrigger,Condition(function KuzanIceAgeOnCast))
call TriggerRegisterAnyUnitEventBJ(effectTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(effectTrigger,Condition(function KuzanIceAgeOnEffect))
set castTrigger=null
set effectTrigger=null
endfunction
// ------------------------------------------------------------------ Haoshoku Crusher (The Red Butterfly + Bonecrusher)
function HaoshokuHasCrusher takes unit buyer returns boolean
return UnitHasItemOfTypeBJ(buyer,$4930304B) or UnitHasItemOfTypeBJ(buyer,$49303535)
endfunction
function HaoshokuRemoveCrusher takes unit buyer returns nothing
if UnitHasItemOfTypeBJ(buyer,$4930304B) then
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$4930304B))
else
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303535))
endif
endfunction
function HaoshokuAssemble takes unit buyer returns nothing
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303156))
call HaoshokuRemoveCrusher(buyer)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",buyer,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",buyer,"origin"))
call UnitAddItemByIdSwapped(HAOSHOKU_ITEM,buyer)
endfunction
function HaoshokuOnSell takes nothing returns boolean
local unit buyer=GetBuyingUnit()
if GetItemTypeId(GetSoldItem())==HAOSHOKU_SHOP_ITEM and IsUnitType(buyer,UNIT_TYPE_HERO) then
if UnitHasItemOfTypeBJ(buyer,$49303156) and HaoshokuHasCrusher(buyer) then
call HaoshokuAssemble(buyer)
else
call UnitAddItemByIdSwapped(HAOSHOKU_RECIPE,buyer)
endif
endif
set buyer=null
return false
endfunction
function HaoshokuReadyEffectOff takes unit holder returns nothing
local integer key=GetHandleId(holder)
local integer rightKey=StringHash("HaoshokuReadyRight")
local integer leftKey=StringHash("HaoshokuReadyLeft")
if HaveSavedHandle(HaoshokuHash,key,rightKey) then
call DestroyEffect(LoadEffectHandle(HaoshokuHash,key,rightKey))
call RemoveSavedHandle(HaoshokuHash,key,rightKey)
endif
if HaveSavedHandle(HaoshokuHash,key,leftKey) then
call DestroyEffect(LoadEffectHandle(HaoshokuHash,key,leftKey))
call RemoveSavedHandle(HaoshokuHash,key,leftKey)
endif
endfunction
function HaoshokuReadyEffectSync takes unit holder returns nothing
local integer key=GetHandleId(holder)
if GetWidgetLife(holder)>.405 and not IsUnitIllusion(holder) and UnitHasItemOfTypeBJ(holder,HAOSHOKU_ITEM) then
if not HaveSavedHandle(HaoshokuHash,key,StringHash("HaoshokuReadyRight")) then
call SaveEffectHandle(HaoshokuHash,key,StringHash("HaoshokuReadyRight"),AddSpecialEffectTarget("Abilities\\Weapons\\VoidWalkerMissile\\VoidWalkerMissile.mdl",holder,"hand right"))
call SaveEffectHandle(HaoshokuHash,key,StringHash("HaoshokuReadyLeft"),AddSpecialEffectTarget("Abilities\\Weapons\\VoidWalkerMissile\\VoidWalkerMissile.mdl",holder,"hand left"))
endif
else
call HaoshokuReadyEffectOff(holder)
endif
endfunction
function HaoshokuOnDeath takes nothing returns boolean
call HaoshokuReadyEffectOff(GetTriggerUnit())
return false
endfunction
function HaoshokuEvasionCheck takes nothing returns nothing
local timer checkTimer=GetExpiredTimer()
local unit holder=LoadUnitHandle(HaoshokuHash,GetHandleId(checkTimer),0)
local boolean holds=UnitHasItemOfTypeBJ(holder,HAOSHOKU_ITEM) or UnitHasItemOfTypeBJ(holder,HAOSHOKU_COOLDOWN_ITEM)
if holds and GetUnitAbilityLevel(holder,HAOSHOKU_EVASION)==0 then
call UnitAddAbility(holder,HAOSHOKU_EVASION)
call UnitMakeAbilityPermanent(holder,true,HAOSHOKU_EVASION)
elseif not holds and GetUnitAbilityLevel(holder,HAOSHOKU_EVASION)>0 then
call UnitRemoveAbility(holder,HAOSHOKU_EVASION)
endif
call HaoshokuReadyEffectSync(holder)
call FlushChildHashtable(HaoshokuHash,GetHandleId(checkTimer))
call DestroyTimer(checkTimer)
set checkTimer=null
set holder=null
endfunction
function HaoshokuQueueEvasionCheck takes unit holder returns nothing
local timer checkTimer=CreateTimer()
call SaveUnitHandle(HaoshokuHash,GetHandleId(checkTimer),0,holder)
call TimerStart(checkTimer,0.,false,function HaoshokuEvasionCheck)
set checkTimer=null
endfunction
function HaoshokuOnPickup takes nothing returns boolean
local unit holder=GetManipulatingUnit()
local integer itemType=GetItemTypeId(GetManipulatedItem())
if itemType==HAOSHOKU_ITEM and (GetNumberOfItemsId(holder,HAOSHOKU_ITEM)>1 or UnitHasItemOfTypeBJ(holder,HAOSHOKU_COOLDOWN_ITEM)) then
call UnitRemoveItemSwapped(GetManipulatedItem(),holder)
if GetOwningPlayer(holder)==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffc3dbffYou can only have one copy of this item.|r")
endif
elseif IsUnitType(holder,UNIT_TYPE_HERO) and UnitHasItemOfTypeBJ(holder,HAOSHOKU_RECIPE) and UnitHasItemOfTypeBJ(holder,$49303156) and HaoshokuHasCrusher(holder) then
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,HAOSHOKU_RECIPE))
call HaoshokuAssemble(holder)
endif
if itemType==HAOSHOKU_ITEM or itemType==HAOSHOKU_COOLDOWN_ITEM then
call HaoshokuQueueEvasionCheck(holder)
endif
set holder=null
return false
endfunction
function HaoshokuOnDrop takes nothing returns boolean
local integer itemType=GetItemTypeId(GetManipulatedItem())
if itemType==HAOSHOKU_ITEM or itemType==HAOSHOKU_COOLDOWN_ITEM then
call HaoshokuQueueEvasionCheck(GetManipulatingUnit())
endif
return false
endfunction
function HaoshokuCooldownEnd takes nothing returns nothing
local timer cooldownTimer=GetExpiredTimer()
local unit crusher=LoadUnitHandle(HaoshokuHash,GetHandleId(cooldownTimer),0)
if GetWidgetLife(crusher)>.405 and not UnitHasItemOfTypeBJ(crusher,HAOSHOKU_ITEM) and UnitHasItemOfTypeBJ(crusher,HAOSHOKU_COOLDOWN_ITEM) then
call RemoveItem(GetItemOfTypeFromUnitBJ(crusher,HAOSHOKU_COOLDOWN_ITEM))
call UnitAddItemByIdSwapped(HAOSHOKU_ITEM,crusher)
endif
call HaoshokuReadyEffectSync(crusher)
call FlushChildHashtable(HaoshokuHash,GetHandleId(cooldownTimer))
call DestroyTimer(cooldownTimer)
set cooldownTimer=null
set crusher=null
endfunction
function HaoshokuCrusher_Attack takes nothing returns nothing
local unit crusher=Source
local unit victim=Target
local timer cooldownTimer
if UnitHasItemOfTypeBJ(crusher,HAOSHOKU_ITEM) and not IsUnitIllusion(crusher) and not UnitHasBuffBJ(crusher,$42303330) then
call HaoshokuReadyEffectOff(crusher)
call DamageUnit(crusher,victim,100+Damage*.5,PHYSICAL,UNKNOWN)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\darkblast.mdx",victim,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\NightElf\\NightElfBlood\\NightElfBloodChimaera.mdl",victim,"chest"))
if GetWidgetLife(crusher)>.405 then
call RemoveItem(GetItemOfTypeFromUnitBJ(crusher,HAOSHOKU_ITEM))
call UnitAddItemByIdSwapped(HAOSHOKU_COOLDOWN_ITEM,crusher)
call UnitUseItem(crusher,bj_lastCreatedItem)
if GetWidgetLife(victim)>.405 then
call IssueTargetOrder(crusher,"attack",victim)
endif
set cooldownTimer=CreateTimer()
call SaveUnitHandle(HaoshokuHash,GetHandleId(cooldownTimer),0,crusher)
call TimerStart(cooldownTimer,HAOSHOKU_COOLDOWN,false,function HaoshokuCooldownEnd)
set cooldownTimer=null
endif
endif
set crusher=null
set victim=null
endfunction
function HaoshokuOnRevive takes nothing returns boolean
if UnitHasItemOfTypeBJ(GetTriggerUnit(),HAOSHOKU_COOLDOWN_ITEM) then
call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),HAOSHOKU_COOLDOWN_ITEM))
call UnitAddItemByIdSwapped(HAOSHOKU_ITEM,GetTriggerUnit())
endif
call HaoshokuReadyEffectSync(GetTriggerUnit())
return false
endfunction
function HaoshokuInit takes nothing returns nothing
local trigger sellTrigger=CreateTrigger()
local trigger pickupTrigger=CreateTrigger()
local trigger dropTrigger=CreateTrigger()
local trigger reviveTrigger=CreateTrigger()
local trigger deathTrigger=CreateTrigger()
set HaoshokuHash=InitHashtable()
call TriggerRegisterAnyUnitEventBJ(sellTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(sellTrigger,Condition(function HaoshokuOnSell))
call TriggerRegisterAnyUnitEventBJ(pickupTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(pickupTrigger,Condition(function HaoshokuOnPickup))
call TriggerRegisterAnyUnitEventBJ(dropTrigger,EVENT_PLAYER_UNIT_DROP_ITEM)
call TriggerAddCondition(dropTrigger,Condition(function HaoshokuOnDrop))
call TriggerRegisterAnyUnitEventBJ(reviveTrigger,EVENT_PLAYER_HERO_REVIVE_FINISH)
call TriggerAddCondition(reviveTrigger,Condition(function HaoshokuOnRevive))
call TriggerRegisterAnyUnitEventBJ(deathTrigger,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(deathTrigger,Condition(function HaoshokuOnDeath))
set deathTrigger=null
set sellTrigger=null
set pickupTrigger=null
set dropTrigger=null
set reviveTrigger=null
endfunction
// ------------------------------------------------------------------ Jakuho Raikoben (The Red Butterfly + Sokyoku)
function JakuhoAssemble takes unit buyer returns nothing
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303156))
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303143))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",buyer,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",buyer,"origin"))
call UnitAddItemByIdSwapped(JAKUHO_ITEM,buyer)
endfunction
function JakuhoHasParts takes unit buyer returns boolean
return UnitHasItemOfTypeBJ(buyer,$49303156) and UnitHasItemOfTypeBJ(buyer,$49303143)
endfunction
function JakuhoOnSell takes nothing returns boolean
local unit buyer=GetBuyingUnit()
if GetItemTypeId(GetSoldItem())==JAKUHO_SHOP_ITEM and IsUnitType(buyer,UNIT_TYPE_HERO) then
if JakuhoHasParts(buyer) then
call JakuhoAssemble(buyer)
else
call UnitAddItemByIdSwapped(JAKUHO_RECIPE,buyer)
endif
endif
set buyer=null
return false
endfunction
function JakuhoEvasionCheck takes nothing returns nothing
local timer checkTimer=GetExpiredTimer()
local unit holder=LoadUnitHandle(JakuhoHash,GetHandleId(checkTimer),0)
local boolean holds=UnitHasItemOfTypeBJ(holder,JAKUHO_ITEM)
if holds and GetUnitAbilityLevel(holder,JAKUHO_EVASION)==0 then
call UnitAddAbility(holder,JAKUHO_EVASION)
call UnitMakeAbilityPermanent(holder,true,JAKUHO_EVASION)
elseif not holds and GetUnitAbilityLevel(holder,JAKUHO_EVASION)>0 then
call UnitRemoveAbility(holder,JAKUHO_EVASION)
endif
call FlushChildHashtable(JakuhoHash,GetHandleId(checkTimer))
call DestroyTimer(checkTimer)
set checkTimer=null
set holder=null
endfunction
function JakuhoQueueEvasionCheck takes unit holder returns nothing
local timer checkTimer=CreateTimer()
call SaveUnitHandle(JakuhoHash,GetHandleId(checkTimer),0,holder)
call TimerStart(checkTimer,0.,false,function JakuhoEvasionCheck)
set checkTimer=null
endfunction
function JakuhoOnPickup takes nothing returns boolean
local unit holder=GetManipulatingUnit()
if IsUnitType(holder,UNIT_TYPE_HERO) and UnitHasItemOfTypeBJ(holder,JAKUHO_RECIPE) and JakuhoHasParts(holder) then
call RemoveItem(GetItemOfTypeFromUnitBJ(holder,JAKUHO_RECIPE))
call JakuhoAssemble(holder)
endif
if GetItemTypeId(GetManipulatedItem())==JAKUHO_ITEM then
call JakuhoQueueEvasionCheck(holder)
endif
set holder=null
return false
endfunction
function JakuhoOnDrop takes nothing returns boolean
if GetItemTypeId(GetManipulatedItem())==JAKUHO_ITEM then
call JakuhoQueueEvasionCheck(GetManipulatingUnit())
endif
return false
endfunction
function JakuhoInit takes nothing returns nothing
local trigger sellTrigger=CreateTrigger()
local trigger pickupTrigger=CreateTrigger()
local trigger dropTrigger=CreateTrigger()
set JakuhoHash=InitHashtable()
call TriggerRegisterAnyUnitEventBJ(sellTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(sellTrigger,Condition(function JakuhoOnSell))
call TriggerRegisterAnyUnitEventBJ(pickupTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(pickupTrigger,Condition(function JakuhoOnPickup))
call TriggerRegisterAnyUnitEventBJ(dropTrigger,EVENT_PLAYER_UNIT_DROP_ITEM)
call TriggerAddCondition(dropTrigger,Condition(function JakuhoOnDrop))
set sellTrigger=null
set pickupTrigger=null
set dropTrigger=null
endfunction
// ------------------------------------------------------------------ Kenbunshoku Edge (The Red Butterfly + Killer Axe)
function KenbunshokuAssemble takes unit buyer returns nothing
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303156))
call RemoveItem(GetItemOfTypeFromUnitBJ(buyer,$49303146))
