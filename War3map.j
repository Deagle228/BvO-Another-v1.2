call SaveReal(ULQ_HashTable,-12178,this,10)
call SaveInteger(ULQ_HashTable,-12181,this,0)
call SaveReal(ULQ_HashTable,-12173,this,150+(50*GetUnitAbilityLevel(LoadUnitHandle(ULQ_HashTable,-12170,this),0x5A5A3035))+(0.4*GetHeroStr(LoadUnitHandle(ULQ_HashTable,-12170,this),true))+(0.6*GetHeroAgi(LoadUnitHandle(ULQ_HashTable,-12170,this),true)))
if GetUnitTypeId(LoadUnitHandle(ULQ_HashTable,-12170,this))==0x5553315F then
call SaveReal(ULQ_HashTable,-12173,this,LoadReal(ULQ_HashTable,-12173,this)+.5*(GetHeroStr(LoadUnitHandle(ULQ_HashTable,-12170,this),true)+GetHeroAgi(LoadUnitHandle(ULQ_HashTable,-12170,this),true)))
elseif GetUnitTypeId(LoadUnitHandle(ULQ_HashTable,-12170,this))==0x5553325F then
call SaveReal(ULQ_HashTable,-12173,this,LoadReal(ULQ_HashTable,-12173,this)+GetHeroStr(LoadUnitHandle(ULQ_HashTable,-12170,this),true)+GetHeroAgi(LoadUnitHandle(ULQ_HashTable,-12170,this),true))
call SaveReal(ULQ_HashTable,-12177,this,67)
endif
call ULQ_PlaySoundOnUnit(LoadSoundHandle(ULQ_HashTable,-12002,183),100,LoadUnitHandle(ULQ_HashTable,-12170,this))
