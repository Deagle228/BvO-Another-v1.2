function RBVastoSlow takes unit rbLocal19_caster returns nothing
local group rbLocal19_g=CreateGroup()
local unit rbLocal19_u
call GroupEnumUnitsInRange(rbLocal19_g,GetUnitX(rbLocal19_caster),GetUnitY(rbLocal19_caster),1000.,null)
loop
set rbLocal19_u=FirstOfGroup(rbLocal19_g)
exitwhen rbLocal19_u==null
call GroupRemoveUnit(rbLocal19_g,rbLocal19_u)
if RBEnemy(rbLocal19_caster,rbLocal19_u) then
call CastToTarget(rbLocal19_caster,rbLocal19_u,'RX01',1,"cripple")
endif
endloop
call DestroyGroup(rbLocal19_g)
set rbLocal19_g=null
set rbLocal19_u=null
endfunction
