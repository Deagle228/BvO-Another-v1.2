call SetUnitVertexColor(bj_lastCreatedUnit,255,255,255,255)
call ULQ_ColorDummy3(bj_lastCreatedUnit,0,255,255,255,0.9)
call SaveReal(ULQ_HashTable,-12179,this,0)
else
