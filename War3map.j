set BvOPickName[29]="Enel"
set BvOPickLines[29]=8
set BvOPickText[464]="Enel rules Skypiea as a self-proclaimed god. His"
set BvOPickText[465]="logia-type devil fruit lets him create, control"
set BvOPickText[466]="and become electricity. His long earlobes, loose"
set BvOPickText[467]="trousers and back-mounted drums resemble Raijin,"
set BvOPickText[468]="the Japanese thunder god, reflecting his belief"
set BvOPickText[469]="in his own divinity."
