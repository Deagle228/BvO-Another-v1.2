function BvOClearHeroSwapRequests takes integer swapPlayerSlot returns nothing
local integer swapOtherSlot=1
set k8[swapPlayerSlot]=false
set m8[swapPlayerSlot]=false
set v8[swapPlayerSlot]=false
set w8[swapPlayerSlot]=false
set n8[swapPlayerSlot]=false
set o8[swapPlayerSlot]=false
set p8[swapPlayerSlot]=false
set q8[swapPlayerSlot]=false
set r8[swapPlayerSlot]=false
set s8[swapPlayerSlot]=false
set t8[swapPlayerSlot]=false
set u8[swapPlayerSlot]=false
loop
exitwhen swapOtherSlot>12
if swapPlayerSlot==1 then
set k8[swapOtherSlot]=false
endif
if swapPlayerSlot==2 then
set m8[swapOtherSlot]=false
endif
if swapPlayerSlot==3 then
set v8[swapOtherSlot]=false
endif
if swapPlayerSlot==4 then
set w8[swapOtherSlot]=false
endif
if swapPlayerSlot==5 then
set n8[swapOtherSlot]=false
endif
