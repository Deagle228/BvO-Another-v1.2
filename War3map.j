endif
call ULQ_PlaySoundOnUnit(LoadSoundHandle(ULQ_HashTable,-12002,186),100,LoadUnitHandle(ULQ_HashTable,-12189,this))
endif
if GetUnitAbilityLevel(LoadUnitHandle(ULQ_HashTable,-12189,this),0x5A5A3037)>=6 then
call SaveInteger(ULQ_HashTable,GetHandleId(LoadUnitHandle(ULQ_HashTable,-12189,this)),9313,GetUnitAbilityLevel(LoadUnitHandle(ULQ_HashTable,-12189,this),0x5A5A3036))
else
call SetUnitAbilityLevel(LoadUnitHandle(ULQ_HashTable,-12189,this),0x5A5A3037,GetUnitAbilityLevel(LoadUnitHandle(ULQ_HashTable,-12189,this),0x5A5A3036))
