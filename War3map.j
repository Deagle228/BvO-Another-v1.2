call SetHeroStr(rbLocal60_u,GetHeroStr(rbLocal60_u,false)-rbLocal60_count,true)
call SaveInteger(RBState,GetHandleId(rbLocal60_u),121,0)
call SaveReal(RBState,GetHandleId(rbLocal60_u),120,0.)
endif
set rbLocal60_count=LoadInteger(RBState,GetHandleId(rbLocal60_u),124)
if LoadReal(RBState,GetHandleId(rbLocal60_u),122)>0. then
if BvOIkkakuBankai(rbLocal60_u) then
call SaveBoolean(RBState,GetHandleId(rbLocal60_u),StringHash("IkkakuRBankai"),true)
endif
if rbLocal60_now>LoadReal(RBState,GetHandleId(rbLocal60_u),122)+.05 or GetWidgetLife(rbLocal60_u)<=.405 or (LoadBoolean(RBState,GetHandleId(rbLocal60_u),StringHash("IkkakuRBankai")) and not BvOIkkakuBankai(rbLocal60_u)) then
call BvOIkkakuREnd(rbLocal60_u)
else
if rbLocal60_now>=LoadReal(RBState,GetHandleId(rbLocal60_u),123) and LoadReal(RBState,GetHandleId(rbLocal60_u),123)<=LoadReal(RBState,GetHandleId(rbLocal60_u),122) and rbLocal60_count<180 and GetWidgetLife(rbLocal60_u)>.405 then
set rbLocal60_count=rbLocal60_count+4
call IkkakuRStrApply(rbLocal60_u,rbLocal60_count)
call SaveInteger(RBState,GetHandleId(rbLocal60_u),124,rbLocal60_count)
call SaveReal(RBState,GetHandleId(rbLocal60_u),123,LoadReal(RBState,GetHandleId(rbLocal60_u),123)+1.)
endif
endif
endif
if GetUnitAbilityLevel(rbLocal60_u,'IQL0')>0 then
call BvOIkkakuQSync(rbLocal60_u)
endif
if GetUnitAbilityLevel(rbLocal60_u,'A08Y')>0 then
call BvOIkkakuAttackSync(rbLocal60_u)
endif
if GetUnitTypeId(rbLocal60_u)=='H00U' and GetWidgetLife(rbLocal60_u)>.405 then
if GetUnitAbilityLevel(rbLocal60_u,'BCD1')==0 then
call CastToTarget(rbLocal60_u,rbLocal60_u,'RCD1',GetUnitAbilityLevel(rbLocal60_u,'A08J'),"innerfire")
endif
elseif GetUnitAbilityLevel(rbLocal60_u,'BCD1')>0 then
call UnitRemoveAbility(rbLocal60_u,'BCD1')
endif
if GetUnitTypeId(rbLocal60_u)=='O000' then
call UnitAddAbility(rbLocal60_u,'RYAR')
call SetUnitAbilityLevel(rbLocal60_u,'RYAR',GetUnitAbilityLevel(rbLocal60_u,'A02C'))
elseif GetUnitAbilityLevel(rbLocal60_u,'RYAR')>0 then
call UnitRemoveAbility(rbLocal60_u,'RYAR')
endif
if GetUnitAbilityLevel(rbLocal60_u,'RIAS')>0 and (rbLocal60_u!=A[98] or GetWidgetLife(rbLocal60_u)<=.405) then
call UnitRemoveAbility(rbLocal60_u,'RIAS')
endif
if GetUnitAbilityLevel(rbLocal60_u,'RIAS')>0 and (rbLocal60_u!=A[98] or GetWidgetLife(rbLocal60_u)<=.405) then
call UnitRemoveAbility(rbLocal60_u,'RIAS')
endif
if GetUnitTypeId(rbLocal60_u)=='N005' then
call UnitRemoveAbility(rbLocal60_u,'A0EP')
if GetUnitAbilityLevel(rbLocal60_u,'RAVC')==0 then
call UnitAddAbility(rbLocal60_u,'RAVP')
endif
endif
if GetWidgetLife(rbLocal60_u)<=.405 then
call UnitRemoveAbility(rbLocal60_u,'RRAR')
call SaveBoolean(RBState,GetHandleId(rbLocal60_u),190,false)
call SaveBoolean(RBState,GetHandleId(rbLocal60_u),191,false)
endif
set rbLocal60_count=0
if GetUnitTypeId(rbLocal60_u)=='N00R' then
set rbLocal60_count=R2I((RBValue(GetUnitAbilityLevel(rbLocal60_u,'A09C'),0.3,0.35,0.4,0.45,0.5,0.5)*GetHeroStr(rbLocal60_u,false)))
endif
if rbLocal60_count!=LoadInteger(RBState,GetHandleId(rbLocal60_u),192) then
call RBKuzanDamage(rbLocal60_u,rbLocal60_count)
call SaveInteger(RBState,GetHandleId(rbLocal60_u),192,rbLocal60_count)
endif
if rbLocal60_u==A[94] and IsTriggerEnabled(Nb) and B[62]!=null and GetWidgetLife(rbLocal60_u)>.405 and ModuloInteger(R2I(rbLocal60_now*10.+.5),5)==0 then
call RBYamamotoRingSlow(rbLocal60_u)
endif
if GetUnitTypeId(rbLocal60_u)=='N008' and rbLocal60_now>=LoadReal(RBState,GetHandleId(rbLocal60_u),202) then
call UnitRemoveAbility(rbLocal60_u,'B010')
call SaveInteger(RBState,GetHandleId(rbLocal60_u),203,0)
endif
if LoadBoolean(RBState,GetHandleId(rbLocal60_u),217) and (rbLocal60_now>=LoadReal(RBState,GetHandleId(rbLocal60_u),122) or GetWidgetLife(rbLocal60_u)<=.405) then
call DestroyEffect(LoadEffectHandle(RBState,GetHandleId(rbLocal60_u),215))
call DestroyEffect(LoadEffectHandle(RBState,GetHandleId(rbLocal60_u),216))
call RemoveSavedHandle(RBState,GetHandleId(rbLocal60_u),215)
call RemoveSavedHandle(RBState,GetHandleId(rbLocal60_u),216)
call SaveBoolean(RBState,GetHandleId(rbLocal60_u),217,false)
endif
if uf!=null and GetWidgetLife(uf)>.405 and LoadUnitHandle(RBState,GetHandleId(uf),212)==rbLocal60_u and rbLocal60_now>=LoadReal(RBState,GetHandleId(uf),213) then
call RBKuzanMineCheck(rbLocal60_u)
endif
// Gear 2 keeps the same Bazooka button (A00M), so its cooldown on the icon is the real one in both forms
if GetUnitTypeId(rbLocal60_u)=='N00C' or GetUnitTypeId(rbLocal60_u)=='N002' then
call SetPlayerAbilityAvailable(GetOwningPlayer(rbLocal60_u),'A00M',true)
call UnitRemoveAbility(rbLocal60_u,'RLWG')
endif
if GetUnitTypeId(rbLocal60_u)=='E004' then
call RBMissSyncSkill(rbLocal60_u,'RLHW','A0EH')
elseif GetUnitTypeId(rbLocal60_u)=='UC13' then
call RBMissSyncSkill(rbLocal60_u,'RLBW','AB0W')
endif
if not ck and Ck!=null and GetOwningPlayer(Ck)==Player(15) and GetWidgetLife(rbLocal60_u)>.405 then
if GetUnitTypeId(rbLocal60_u)=='H003' or GetUnitTypeId(rbLocal60_u)=='H00E' or GetUnitTypeId(rbLocal60_u)=='H01B' or GetUnitTypeId(rbLocal60_u)=='H01C' or GetUnitTypeId(rbLocal60_u)=='H01D' or GetUnitTypeId(rbLocal60_u)=='H01E' then
call RBIchigoStoreItems(Ck,GetPlayerId(GetOwningPlayer(rbLocal60_u)))
endif
endif
if RBIchigoPendingCount>0 and GetWidgetLife(rbLocal60_u)>.405 then
call RBIchigoRestoreItems(rbLocal60_u)
endif
if GetUnitTypeId(rbLocal60_u)=='N009' or GetUnitTypeId(rbLocal60_u)=='N00R' then
call RBMissSyncSkill(rbLocal60_u,'RKTL','A09H')
if GetUnitAbilityLevel(rbLocal60_u,'A09H')>5 then
call SetUnitAbilityLevel(rbLocal60_u,'A09H',GetUnitAbilityLevel(rbLocal60_u,'RKTL'))
endif
endif
endif
set rbLocal60_p=rbLocal60_p+1
endloop
set rbLocal60_u=null
endfunction
function RBInit takes nothing returns nothing
local trigger rbLocal64_t=CreateTrigger()
local trigger rbLocal64_c=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(rbLocal64_t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(rbLocal64_t,function RBOnSpell)
call TriggerRegisterAnyUnitEventBJ(rbLocal64_c,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddAction(rbLocal64_c,function RBOnCast)
set rbLocal64_t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(rbLocal64_t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddAction(rbLocal64_t,function RBMissLearn)
call TimerStart(CreateTimer(),.1,true,function RBTick)
set rbLocal64_t=null
set rbLocal64_c=null
endfunction
// ------------------------------------------------------------------ Sasuke: Susanoo attacks cut healing (with Oken)
// Every attack of Sasuke in Susanoo (O005) while he holds Oken cuts the target's health restoration (regeneration,
// heals, lifesteal) by 2/4/6/8/10% (Susanoo level) for 3 seconds; every hit refreshes the 3 seconds. It works on top of
// the Onmitsukido Blade lifesteal cut. The status icon (buff BSHR, Susanoo icon) is put on by a 0-effect Cripple.
function SHRTick takes nothing returns nothing
local group cutUnits=CreateGroup()
local unit cutUnit
local integer cutKey
local real life
local real lastLife
local real now=TimerGetElapsed(AYClock)
call GroupAddGroup(SHRGroup,cutUnits)
loop
set cutUnit=FirstOfGroup(cutUnits)
exitwhen cutUnit==null
call GroupRemoveUnit(cutUnits,cutUnit)
set cutKey=GetHandleId(cutUnit)
set life=GetWidgetLife(cutUnit)
if life<=.405 or GetUnitTypeId(cutUnit)==0 or now>=LoadReal(SHRHash,cutKey,1) then
call GroupRemoveUnit(SHRGroup,cutUnit)
call UnitRemoveAbility(cutUnit,'BSHR')
call FlushChildHashtable(SHRHash,cutKey)
else
set lastLife=LoadReal(SHRHash,cutKey,2)
if life>lastLife then
set life=life-(life-lastLife)*LoadReal(SHRHash,cutKey,0)
call SetWidgetLife(cutUnit,life)
endif
call SaveReal(SHRHash,cutKey,2,life)
endif
endloop
call DestroyGroup(cutUnits)
set cutUnits=null
endfunction
function SHRDamageHook takes nothing returns nothing
local integer cutKey
local real cutPart
if Damage<=0. or Source==null or Target==null or not BvOSusanoType(GetUnitTypeId(Source)) or IsUnitIllusion(Source) then
return
endif
if not IsUnitEnemy(Target,GetOwningPlayer(Source)) or IsUnitType(Target,UNIT_TYPE_STRUCTURE) then
return
endif
if GetUnitAbilityLevel(Source,'A09A')==0 or not MVReady(Source) or not SC38HasOken(Source) then
return
endif
set cutKey=GetHandleId(Target)
set cutPart=.02*I2R(GetUnitAbilityLevel(Source,'A09A'))
if not IsUnitInGroup(Target,SHRGroup) then
call GroupAddUnit(SHRGroup,Target)
call SaveReal(SHRHash,cutKey,2,GetWidgetLife(Target))
call SaveReal(SHRHash,cutKey,0,cutPart)
elseif cutPart>LoadReal(SHRHash,cutKey,0) then
call SaveReal(SHRHash,cutKey,0,cutPart)
endif
call SaveReal(SHRHash,cutKey,1,TimerGetElapsed(AYClock)+3.)
call CastToTarget(Source,Target,'ASHR',1,"cripple")
endfunction
function SHRInit takes nothing returns nothing
set SHRHash=InitHashtable()
set SHRGroup=CreateGroup()
call TimerStart(CreateTimer(),.03,true,function SHRTick)
endfunction
function FSWFinish takes timer castTimer returns nothing
local integer key=GetHandleId(castTimer)
local unit caster=LoadUnitHandle(FSWHash,key,0)
call DestroyEffect(LoadEffectHandle(FSWHash,key,3))
call DestroyEffect(LoadEffectHandle(FSWHash,key,4))
if caster!=null and LoadTimerHandle(FSWHash,GetHandleId(caster),0)==castTimer then
call RemoveSavedHandle(FSWHash,GetHandleId(caster),0)
call SetUnitTimeScale(caster,1.)
if GetWidgetLife(caster)>.405 and not IsUnitHidden(caster) and GetUnitCurrentOrder(caster)==0 and LoadInteger(FSWHash,key,7)==LoadInteger(Hash,GetHandleId(caster),StringHash("BvORevivalGeneration")) then
call ResetUnitAnimation(caster)
endif
endif
call PauseTimer(castTimer)
call FlushChildHashtable(FSWHash,key)
call DestroyTimer(castTimer)
set caster=null
endfunction
// W damage: 300/550/800/1050/1300 + (0.5/0.7/0.9/1.2/1.5 x total AGI)
function FSWDamage takes unit caster,integer level returns real
local real agility=I2R(GetHeroAgi(caster,true))
if level<=1 then
return 300.+.5*agility
elseif level==2 then
return 450.+.7*agility
elseif level==3 then
return 600.+.9*agility
elseif level==4 then
return 750.+1.2*agility
endif
return 900.+1.5*agility
endfunction
function FSWImpact takes timer castTimer returns nothing
local integer key=GetHandleId(castTimer)
local unit caster=LoadUnitHandle(FSWHash,key,0)
local unit target=LoadUnitHandle(FSWHash,key,1)
local unit dummy
local real tx=GetUnitX(target)
local real ty=GetUnitY(target)
local real dx=tx-GetUnitX(caster)
local real dy=ty-GetUnitY(caster)
local real facing=Atan2(dy,dx)*bj_RADTODEG
local real angle
local real radius
local integer i=1
local integer ring=1
call StartSound(FSWVoice)
call DestroyEffect(LoadEffectHandle(FSWHash,key,3))
call DestroyEffect(LoadEffectHandle(FSWHash,key,4))
call RemoveSavedHandle(FSWHash,key,3)
call RemoveSavedHandle(FSWHash,key,4)
if target!=null and GetWidgetLife(target)>.405 and not IsUnitHidden(target) and dx*dx+dy*dy<4000000. then
call SetUnitPosition(caster,tx,ty)
call SetUnitFacing(caster,facing)
// Identical to the donor's two rings: 8 angles, radii 100 and 50,
// with one Monsoon bolt and one Thunder Clap visual at each point.
loop
exitwhen ring>2
if ring==1 then
set radius=100.
else
set radius=50.
endif
set i=1
loop
exitwhen i>8
set angle=I2R(i)*45.*bj_DEGTORAD
set dummy=CreateUnit(GetOwningPlayer(caster),'uSW3',tx+radius*Cos(angle),ty+radius*Sin(angle),bj_UNIT_FACING)
call UnitApplyTimedLife(dummy,'BTLF',4.)
set dummy=CreateUnit(GetOwningPlayer(caster),'uSW4',tx+radius*Cos(angle),ty+radius*Sin(angle),bj_UNIT_FACING)
call UnitApplyTimedLife(dummy,'BTLF',3.)
set i=i+1
endloop
set ring=ring+1
endloop
// The donor deals its 300/600/900/1200/1500 magical damage and 2-second
// stun through a native Storm Bolt dummy. Keep that same delivery.
set dummy=CreateUnit(GetOwningPlayer(caster),'uSW1',tx,ty,bj_UNIT_FACING)
call SetUnitAbilityLevel(dummy,'ASW1',LoadInteger(FSWHash,key,8))
call IssueTargetOrder(dummy,"thunderbolt",target)
call UnitApplyTimedLife(dummy,'BTLF',2.)
call BvOHeroSpellDamage(caster,target,FSWDamage(caster,LoadInteger(FSWHash,key,8)),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
call SetUnitAnimationByIndex(caster,6)
call SetUnitTimeScale(caster,2.)
call QueueUnitAnimation(caster,"stand")
call SaveInteger(FSWHash,key,5,2)
call SaveInteger(FSWHash,key,6,50)
set caster=null
set target=null
set dummy=null
endfunction
function FSWTick takes nothing returns nothing
local timer castTimer=GetExpiredTimer()
local integer key=GetHandleId(castTimer)
local unit caster=LoadUnitHandle(FSWHash,key,0)
local integer phase=LoadInteger(FSWHash,key,5)
local integer ticks=LoadInteger(FSWHash,key,6)-1
if caster==null or GetUnitTypeId(caster)==0 or GetWidgetLife(caster)<=.405 or IsUnitHidden(caster) or LoadInteger(FSWHash,key,7)!=LoadInteger(Hash,GetHandleId(caster),StringHash("BvORevivalGeneration")) then
call FSWFinish(castTimer)
elseif ticks<=0 then
if phase==1 then
call FSWImpact(castTimer)
else
call FSWFinish(castTimer)
endif
else
call SaveInteger(FSWHash,key,6,ticks)
endif
set castTimer=null
set caster=null
endfunction
function FSWIsCast takes nothing returns boolean
return GetSpellAbilityId()=='A09I' and (GetUnitTypeId(GetTriggerUnit())=='O004' or BvOSusanoType(GetUnitTypeId(GetTriggerUnit()))) and SilenceConditions(GetTriggerUnit())
endfunction
function FSWChannel takes nothing returns nothing
local unit caster=GetTriggerUnit()
local timer castTimer=LoadTimerHandle(FSWHash,GetHandleId(caster),0)
local integer key
if castTimer!=null then
call FSWFinish(castTimer)
endif
set castTimer=CreateTimer()
set key=GetHandleId(castTimer)
call SetUnitTimeScale(caster,1.)
call SetUnitAnimationByIndex(caster,7)
call SaveTimerHandle(FSWHash,GetHandleId(caster),0,castTimer)
call SaveUnitHandle(FSWHash,key,0,caster)
call SaveUnitHandle(FSWHash,key,1,GetSpellTargetUnit())
call SaveEffectHandle(FSWHash,key,3,AddSpecialEffectTarget("Abilities\\Weapons\\ZigguratMissile\\ZigguratMissile.mdl",caster,"hand right"))
call SaveEffectHandle(FSWHash,key,4,AddSpecialEffectTarget("Abilities\\Weapons\\ZigguratMissile\\ZigguratMissile.mdl",caster,"hand left"))
call SaveInteger(FSWHash,key,5,0)
call SaveInteger(FSWHash,key,6,300)
call SaveInteger(FSWHash,key,7,LoadInteger(Hash,GetHandleId(caster),StringHash("BvORevivalGeneration")))
call SaveInteger(FSWHash,key,8,GetUnitAbilityLevel(caster,'A09I'))
call TimerStart(castTimer,.01,true,function FSWTick)
set caster=null
set castTimer=null
endfunction
function FSWEffect takes nothing returns nothing
local timer castTimer=LoadTimerHandle(FSWHash,GetHandleId(GetTriggerUnit()),0)
if castTimer!=null then
call SaveInteger(FSWHash,GetHandleId(castTimer),5,1)
call SaveInteger(FSWHash,GetHandleId(castTimer),6,15)
endif
set castTimer=null
endfunction
function FSWEndcast takes nothing returns nothing
local timer castTimer
if GetSpellAbilityId()=='A09I' then
set castTimer=LoadTimerHandle(FSWHash,GetHandleId(GetTriggerUnit()),0)
if castTimer!=null and LoadInteger(FSWHash,GetHandleId(castTimer),5)==0 then
call FSWFinish(castTimer)
endif
endif
set castTimer=null
endfunction
function FSWOrder takes nothing returns nothing
local timer castTimer=LoadTimerHandle(FSWHash,GetHandleId(GetTriggerUnit()),0)
if castTimer!=null and LoadInteger(FSWHash,GetHandleId(castTimer),5)==2 then
call FSWFinish(castTimer)
endif
set castTimer=null
endfunction
function FSWInit takes nothing returns nothing
local trigger channelTrigger=CreateTrigger()
local trigger effectTrigger=CreateTrigger()
local trigger endTrigger=CreateTrigger()
local trigger orderTrigger=CreateTrigger()
set FSWHash=InitHashtable()
set FSWVoice=CreateSound("war3mapImported\\FSW\\SasukeW1.mp3",false,false,false,10,10,"")
call SetSoundDuration(FSWVoice,1567)
call SetSoundChannel(FSWVoice,0)
call SetSoundVolume(FSWVoice,127)
call SetSoundPitch(FSWVoice,1.)
call TriggerRegisterAnyUnitEventBJ(channelTrigger,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(channelTrigger,Condition(function FSWIsCast))
call TriggerAddAction(channelTrigger,function FSWChannel)
call TriggerRegisterAnyUnitEventBJ(effectTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(effectTrigger,Condition(function FSWIsCast))
call TriggerAddAction(effectTrigger,function FSWEffect)
call TriggerRegisterAnyUnitEventBJ(endTrigger,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call TriggerAddAction(endTrigger,function FSWEndcast)
call TriggerRegisterAnyUnitEventBJ(orderTrigger,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call TriggerRegisterAnyUnitEventBJ(orderTrigger,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterAnyUnitEventBJ(orderTrigger,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddAction(orderTrigger,function FSWOrder)
set channelTrigger=null
set effectTrigger=null
set endTrigger=null
set orderTrigger=null
endfunction

// Warm the short-lived block/cooldown helpers before player control starts.
// Life-buffer abilities are added only at level 1 (zero HP delta); never visit their large stat levels here.
// The isolated, hidden, invulnerable Locust dummy is removed without a death event or player reward.
function BvOBlockHelpersPreload takes nothing returns nothing
local unit warmDummy
if LoadBoolean(RBState,7304,StringHash("BlockHelpersPreloaded")) then
return
endif
call SaveBoolean(RBState,7304,StringHash("BlockHelpersPreloaded"),true)
call Preload("ReplaceableTextures\\PassiveButtons\\PASBTNChadW.blp")
call Preload("ReplaceableTextures\\CommandButtonsDisabled\\DISPASBTNChadW.blp")
set warmDummy=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),'u002',GetRectCenterX(io),GetRectCenterY(io),0.)
call ShowUnit(warmDummy,false)
call UnitRemoveAbility(warmDummy,'ACmi')
// Cache both directions of the shared, exact-size life buffer without applying a nonzero stat value.
call UnitAddAbility(warmDummy,'NL0H')
call UnitRemoveAbility(warmDummy,'NL0H')
call UnitAddAbility(warmDummy,'NL0J')
call UnitRemoveAbility(warmDummy,'NL0J')
// Also warm Chad's Q helper and Hollow Shield's native block used in the reported Enel fight.
call UnitAddAbility(warmDummy,'A03M')
call UnitRemoveAbility(warmDummy,'A03M')
call UnitAddAbility(warmDummy,'A06Y')
call UnitRemoveAbility(warmDummy,'A06Y')
// Cache the zero-stat passive countdown; there is no spell or status to cast.
call UnitAddAbility(warmDummy,'SDC0')
call SetUnitAbilityLevel(warmDummy,'SDC0',30)
call UnitRemoveAbility(warmDummy,'SDC0')
call RemoveUnit(warmDummy)
set warmDummy=null
endfunction
// ------------------------------------------------------------------ Assembly with a full inventory (28.10)
// A hero with a full inventory who buys a shop button gets the item on the ground. Then the script puts one of the hero's
// items aside (hidden), gives the bought item to the hero (so every assembly trigger sees it): if it was used in an
// assembly, the item put aside comes back into the freed slot; otherwise the bought item goes back on the ground, the
// other item comes back to its slot and the next slot is tried (slots 6 to 1).
function FCFinish takes timer fcTimer returns nothing
call FlushChildHashtable(FCHash,GetHandleId(fcTimer))
call DestroyTimer(fcTimer)
endfunction
function FCReturnAside takes unit fcHero,item fcAside,integer fcSlot returns nothing
call SetItemVisible(fcAside,true)
if fcHero!=null and GetWidgetLife(fcHero)>.405 and UnitAddItem(fcHero,fcAside) then
if UnitItemInSlot(fcHero,fcSlot)==null then
call UnitDropItemSlot(fcHero,fcAside,fcSlot)
endif
elseif fcHero!=null then
call SetItemPosition(fcAside,GetUnitX(fcHero),GetUnitY(fcHero))
endif
endfunction
// all the tries are made at once, inside one script call, so nothing blinks on the screen
function FCTryAll takes unit fcHero,item fcSold returns nothing
local integer fcSlot=UnitInventorySizeBJ(fcHero)-1
local item fcAside
local real fcX=GetItemX(fcSold)
local real fcY=GetItemY(fcSold)
loop
exitwhen fcSlot<0
set fcAside=UnitItemInSlot(fcHero,fcSlot)
if fcAside!=null then
call UnitRemoveItem(fcHero,fcAside)
call SetItemVisible(fcAside,false)
call UnitAddItem(fcHero,fcSold)
if GetItemTypeId(fcSold)==0 or not UnitHasItem(fcHero,fcSold) then
call FCReturnAside(fcHero,fcAside,fcSlot)
set fcSlot=-1
else
call UnitRemoveItem(fcHero,fcSold)
call SetItemPosition(fcSold,fcX,fcY)
call FCReturnAside(fcHero,fcAside,fcSlot)
endif
endif
set fcSlot=fcSlot-1
endloop
set fcAside=null
endfunction
function FCStep takes nothing returns nothing
local timer fcTimer=GetExpiredTimer()
local integer fcKey=GetHandleId(fcTimer)
local unit fcHero=LoadUnitHandle(FCHash,fcKey,0)
local item fcSold=LoadItemHandle(FCHash,fcKey,1)
if LoadBoolean(FCHash,fcKey,6) then
// a shop button (power-up) was bought: the item given by the shop triggers is the last created item
set fcSold=bj_lastCreatedItem
if fcSold!=null and (IsItemOwned(fcSold) or (GetItemX(fcSold)-GetUnitX(fcHero))*(GetItemX(fcSold)-GetUnitX(fcHero))+(GetItemY(fcSold)-GetUnitY(fcHero))*(GetItemY(fcSold)-GetUnitY(fcHero))>100.*100.) then
set fcSold=null
endif
endif
if fcHero!=null and fcSold!=null and GetWidgetLife(fcHero)>.405 and GetItemTypeId(fcSold)!=0 and not IsItemOwned(fcSold) and UnitInventoryCount(fcHero)>=UnitInventorySizeBJ(fcHero) then
call FCTryAll(fcHero,fcSold)
endif
call FCFinish(fcTimer)
set fcTimer=null
set fcHero=null
set fcSold=null
endfunction
function FCStart takes unit fcHero,item fcSold,boolean fcButton returns nothing
local timer fcTimer=CreateTimer()
call SaveUnitHandle(FCHash,GetHandleId(fcTimer),0,fcHero)
call SaveItemHandle(FCHash,GetHandleId(fcTimer),1,fcSold)
call SaveInteger(FCHash,GetHandleId(fcTimer),2,UnitInventorySizeBJ(fcHero)-1)
call SaveBoolean(FCHash,GetHandleId(fcTimer),6,fcButton)
call TimerStart(fcTimer,0.,false,function FCStep)
set fcTimer=null
endfunction
// Ironwood Branch is sold as a button (QB01), so a full inventory does not block the purchase
function FCOnSell takes nothing returns boolean
local unit fcBuyer=GetBuyingUnit()
local integer fcReal=LoadInteger(FCHash,0,GetItemTypeId(GetSoldItem()))
local item fcItem
if GetItemTypeId(GetSoldItem())!=0 and fcReal!=0 then
call RemoveItem(GetSoldItem())
set fcItem=CreateItem(fcReal,GetUnitX(fcBuyer),GetUnitY(fcBuyer))
if not UnitAddItem(fcBuyer,fcItem) and IsUnitType(fcBuyer,UNIT_TYPE_HERO) and not IsUnitIllusion(fcBuyer) then
call FCStart(fcBuyer,fcItem,false)
endif
elseif IsUnitType(fcBuyer,UNIT_TYPE_HERO) and not IsUnitIllusion(fcBuyer) and GetItemTypeId(GetSoldItem())!=0 and UnitInventoryCount(fcBuyer)>=UnitInventorySizeBJ(fcBuyer) then
call FCStart(fcBuyer,GetSoldItem(),IsItemPowerup(GetSoldItem()))
endif
set fcBuyer=null
set fcItem=null
return false
endfunction
function FCInit takes nothing returns nothing
local trigger fcTrigger=CreateTrigger()
set FCHash=InitHashtable()
call SaveInteger(FCHash,0,'QB01','iwbr')
call TriggerRegisterAnyUnitEventBJ(fcTrigger,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(fcTrigger,Condition(function FCOnSell))
set fcTrigger=null
endfunction
// ------------------------------------------------------------------ Ikkaku W from BBR (29.10; 31.10: STR scales 0.3-0.7 / 2.2-3)
// AIW0 (hero ability, Normal): Thrust Attack - 10 thrusts in 1 second (one every 0.1 s, animation "Attack" at 500%
// speed, afterimages hIKA), each hits the enemies within 150 of the point 150 in front of Ikkaku.
// AIW1 (Bankai): Ghost Lantern Spin Strike - 5 seconds of spinning (animation "Attack Walk Stand Spin", dust wave
// hIKD), every 0.5 s the enemies within 700 take damage and are pushed back 100. Any order of the player ends it.
// In Bankai AIW0 is hidden and AIW1 (same level) takes its place; the forms share the hero level of W.
function IKWSound takes string ikwPath,unit ikwUnit returns nothing
local sound ikwSound=CreateSound(ikwPath,false,true,true,10,10,"DefaultEAXON")
call SetSoundVolume(ikwSound,127)
call SetSoundDistances(ikwSound,600.,10000.)
call AttachSoundToUnit(ikwSound,ikwUnit)
call StartSound(ikwSound)
call KillSoundWhenDone(ikwSound)
set ikwSound=null
endfunction
function IKWRelease takes unit ikwHero returns nothing
if ikwHero!=null and not l[1+GetPlayerId(GetOwningPlayer(ikwHero))] then
call PauseUnit(ikwHero,false)
endif
call SetUnitTimeScale(ikwHero,1.)
call ResetUnitAnimation(ikwHero)
endfunction
function IKWHitEffects takes unit ikwTarget returns nothing
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",ikwTarget,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Silence\\SilenceAreaBirth.mdl",ikwTarget,"origin"))
endfunction
function IKWThrustTick takes nothing returns nothing
local timer ikwTimer=GetExpiredTimer()
local integer ikwKey=GetHandleId(ikwTimer)
local unit ikwHero=LoadUnitHandle(IKWHash,ikwKey,0)
local integer ikwCount=LoadInteger(IKWHash,ikwKey,1)
local integer ikwLevel=LoadInteger(IKWHash,ikwKey,2)
local real ikwFacing
local real ikwX
local real ikwY
local unit ikwUnit
local unit ikwImage
local boolean ikwHit=false
local texttag ikwTag
if LoadUnitHandle(IKWHash,ikwKey,3)!=null then
call RemoveUnit(LoadUnitHandle(IKWHash,ikwKey,3))
call RemoveSavedHandle(IKWHash,ikwKey,3)
endif
if ikwHero==null or GetWidgetLife(ikwHero)<=.405 or ikwCount>=10 then
call IKWRelease(ikwHero)
call FlushChildHashtable(IKWHash,ikwKey)
call DestroyTimer(ikwTimer)
else
if ikwCount==0 then
// paused only now, after the cast event, so the cooldown and the mana are taken normally
call PauseUnit(ikwHero,true)
call SetUnitTimeScale(ikwHero,5.)
call IKWSound("war3mapImported\\yj03.mp3",ikwHero)
endif
set ikwFacing=GetUnitFacing(ikwHero)*bj_DEGTORAD
set ikwX=GetUnitX(ikwHero)+150.*Cos(ikwFacing)
set ikwY=GetUnitY(ikwHero)+150.*Sin(ikwFacing)
call SetUnitAnimationByIndex(ikwHero,7)
call GroupEnumUnitsInRange(IKWGroup,ikwX,ikwY,150.,null)
loop
set ikwUnit=FirstOfGroup(IKWGroup)
exitwhen ikwUnit==null
call GroupRemoveUnit(IKWGroup,ikwUnit)
if RBEnemy(ikwHero,ikwUnit) then
call DamageUnit(ikwHero,ikwUnit,10.+15.*ikwLevel+(.2+.1*ikwLevel)*GetHeroStr(ikwHero,true),PHYSICAL,SPELL)
call IKWHitEffects(ikwUnit)
set ikwHit=true
endif
endloop
if ikwHit then
set ikwTag=CreateTextTag()
call SetTextTagText(ikwTag,I2S(ikwCount+1)+" Hit!",.023)
call SetTextTagPosUnit(ikwTag,ikwHero,12.)
call SetTextTagColor(ikwTag,255,0,0,255)
call SetTextTagVelocity(ikwTag,0.,.0355)
call SetTextTagPermanent(ikwTag,false)
call SetTextTagLifespan(ikwTag,1.)
call SetTextTagFadepoint(ikwTag,.5)
set ikwTag=null
endif
set ikwImage=CreateUnit(GetOwningPlayer(ikwHero),'hIKA',GetUnitX(ikwHero),GetUnitY(ikwHero),GetUnitFacing(ikwHero))
call SetUnitVertexColor(ikwImage,255,255,255,128)
call SetUnitTimeScale(ikwImage,5.)
call SetUnitAnimationByIndex(ikwImage,7)
call SaveUnitHandle(IKWHash,ikwKey,3,ikwImage)
call SaveInteger(IKWHash,ikwKey,1,ikwCount+1)
call TimerStart(ikwTimer,.1,false,function IKWThrustTick)
set ikwImage=null
endif
set ikwTimer=null
set ikwHero=null
set ikwUnit=null
endfunction
function IKWSpinEnd takes timer ikwTimer returns nothing
local integer ikwKey=GetHandleId(ikwTimer)
local unit ikwHero=LoadUnitHandle(IKWHash,ikwKey,0)
call RemoveUnit(LoadUnitHandle(IKWHash,ikwKey,3))
call RemoveUnit(LoadUnitHandle(IKWHash,ikwKey,5))
if ikwHero!=null then
call SetUnitVertexColor(ikwHero,255,255,255,255)
call UnitRemoveAbility(ikwHero,'Abun')
call SetUnitTimeScale(ikwHero,1.)
call ResetUnitAnimation(ikwHero)
if LoadTimerHandle(IKWHash,GetHandleId(ikwHero),10)==ikwTimer then
call RemoveSavedHandle(IKWHash,GetHandleId(ikwHero),10)
call RemoveSavedBoolean(IKWHash,GetHandleId(ikwHero),11)
endif
endif
call FlushChildHashtable(IKWHash,ikwKey)
call DestroyTimer(ikwTimer)
set ikwHero=null
endfunction
function IKWGraceEnd takes nothing returns nothing
local timer ikwGrace=GetExpiredTimer()
call RemoveSavedBoolean(IKWHash,GetHandleId(LoadUnitHandle(IKWHash,GetHandleId(ikwGrace),0)),11)
call FlushChildHashtable(IKWHash,GetHandleId(ikwGrace))
call DestroyTimer(ikwGrace)
set ikwGrace=null
endfunction
function IKWGraceStop takes nothing returns nothing
local timer ikwGrace=GetExpiredTimer()
local unit ikwHero=LoadUnitHandle(IKWHash,GetHandleId(ikwGrace),0)
if ikwHero!=null and HaveSavedHandle(IKWHash,GetHandleId(ikwHero),10) then
set IKWIgnoreOrders=true
call IssueImmediateOrder(ikwHero,"stop")
set IKWIgnoreOrders=false
endif
call FlushChildHashtable(IKWHash,GetHandleId(ikwGrace))
call DestroyTimer(ikwGrace)
set ikwGrace=null
set ikwHero=null
endfunction
// 31.10: in the first 0.5 s of the spin the orders that the game gives by itself after the cast (the previous order of the
// hero comes back: move, attack, smart...) do not end it: they are cancelled with "stop" instead
function IKWOnOrder takes nothing returns boolean
local timer ikwTimer
if not IKWIgnoreOrders and HaveSavedHandle(IKWHash,GetHandleId(GetTriggerUnit()),10) and LoadBoolean(IKWHash,GetHandleId(GetTriggerUnit()),11) then
set ikwTimer=CreateTimer()
call SaveUnitHandle(IKWHash,GetHandleId(ikwTimer),0,GetTriggerUnit())
call TimerStart(ikwTimer,0.,false,function IKWGraceStop)
set ikwTimer=null
return false
endif
if not IKWIgnoreOrders and HaveSavedHandle(IKWHash,GetHandleId(GetTriggerUnit()),10) then
set ikwTimer=LoadTimerHandle(IKWHash,GetHandleId(GetTriggerUnit()),10)
if ikwTimer!=null then
call IKWSpinEnd(ikwTimer)
endif
set ikwTimer=null
endif
return false
endfunction
function IKWSpinTick takes nothing returns nothing
local timer ikwTimer=GetExpiredTimer()
local integer ikwKey=GetHandleId(ikwTimer)
local unit ikwHero=LoadUnitHandle(IKWHash,ikwKey,0)
local integer ikwCount=LoadInteger(IKWHash,ikwKey,1)
local integer ikwLevel=LoadInteger(IKWHash,ikwKey,2)
local real ikwAngle
local real ikwX
local real ikwY
local unit ikwUnit
local timer ikwGrace
if ikwHero==null or GetWidgetLife(ikwHero)<=.405 or ikwCount>=10 then
call IKWSpinEnd(ikwTimer)
else
if ikwCount==0 then
// not paused: any order of the player (click, S, a spell...) ends the spin; the hero can not attack meanwhile
set IKWIgnoreOrders=true
call IssueImmediateOrder(ikwHero,"stop")
set IKWIgnoreOrders=false
call UnitAddAbility(ikwHero,'Abun')
call SaveTimerHandle(IKWHash,GetHandleId(ikwHero),10,ikwTimer)
call SaveBoolean(IKWHash,GetHandleId(ikwHero),11,true)
set ikwGrace=CreateTimer()
call SaveUnitHandle(IKWHash,GetHandleId(ikwGrace),0,ikwHero)
call TimerStart(ikwGrace,.5,false,function IKWGraceEnd)
set ikwGrace=null
call IKWSound("war3mapImported\\yj01.mp3",ikwHero)
call SaveUnitHandle(IKWHash,ikwKey,3,CreateUnit(GetOwningPlayer(ikwHero),'hIKD',GetUnitX(ikwHero),GetUnitY(ikwHero),0.))
call SetUnitTimeScale(LoadUnitHandle(IKWHash,ikwKey,3),2.)
// BBR's spin is the animation "Spell 5" of its Bankai model: a double with that model replaces the hero (hidden)
call SaveUnitHandle(IKWHash,ikwKey,5,CreateUnit(GetOwningPlayer(ikwHero),'hIKB',GetUnitX(ikwHero),GetUnitY(ikwHero),GetUnitFacing(ikwHero)))
call SetUnitVertexColor(ikwHero,255,255,255,0)
endif
call SetUnitX(LoadUnitHandle(IKWHash,ikwKey,5),GetUnitX(ikwHero))
call SetUnitY(LoadUnitHandle(IKWHash,ikwKey,5),GetUnitY(ikwHero))
call SetUnitAnimationByIndex(LoadUnitHandle(IKWHash,ikwKey,5),10)
call SetUnitTimeScale(LoadUnitHandle(IKWHash,ikwKey,5),2.+.4*ikwCount)
call SetUnitX(LoadUnitHandle(IKWHash,ikwKey,3),GetUnitX(ikwHero))
call SetUnitY(LoadUnitHandle(IKWHash,ikwKey,3),GetUnitY(ikwHero))
call GroupEnumUnitsInRange(IKWGroup,GetUnitX(ikwHero),GetUnitY(ikwHero),700.,null)
loop
set ikwUnit=FirstOfGroup(IKWGroup)
exitwhen ikwUnit==null
call GroupRemoveUnit(IKWGroup,ikwUnit)
if RBEnemy(ikwHero,ikwUnit) then
set ikwAngle=Atan2(GetUnitY(ikwUnit)-GetUnitY(ikwHero),GetUnitX(ikwUnit)-GetUnitX(ikwHero))
set ikwX=GetUnitX(ikwUnit)+100.*Cos(ikwAngle)
set ikwY=GetUnitY(ikwUnit)+100.*Sin(ikwAngle)
if not IsUnitType(ikwUnit,UNIT_TYPE_HERO) or not IsUnitPaused(ikwUnit) then
if not IsTerrainPathable(ikwX,ikwY,PATHING_TYPE_WALKABILITY) then
call SetUnitX(ikwUnit,ikwX)
call SetUnitY(ikwUnit,ikwY)
endif
endif
call DamageUnit(ikwHero,ikwUnit,25.+25.*ikwLevel+(2.+.2*ikwLevel)*GetHeroStr(ikwHero,true),PHYSICAL,SPELL)
call IKWHitEffects(ikwUnit)
endif
endloop
call SaveInteger(IKWHash,ikwKey,1,ikwCount+1)
call TimerStart(ikwTimer,.5,false,function IKWSpinTick)
endif
set ikwTimer=null
set ikwHero=null
set ikwUnit=null
endfunction
function IKWOnSpell takes nothing returns boolean
local unit ikwHero=GetTriggerUnit()
local timer ikwTimer
if GetSpellAbilityId()=='AIW0' or GetSpellAbilityId()=='AIW1' then
set ikwTimer=CreateTimer()
call SaveUnitHandle(IKWHash,GetHandleId(ikwTimer),0,ikwHero)
call SaveInteger(IKWHash,GetHandleId(ikwTimer),1,0)
call SaveInteger(IKWHash,GetHandleId(ikwTimer),2,GetUnitAbilityLevel(ikwHero,GetSpellAbilityId()))
if GetSpellAbilityId()=='AIW0' then
call TimerStart(ikwTimer,0.,false,function IKWThrustTick)
else
call TimerStart(ikwTimer,0.,false,function IKWSpinTick)
endif
set ikwTimer=null
endif
set ikwHero=null
return false
endfunction
// Bankai: AIW1 with the level of AIW0 instead of AIW0
function IKWSync takes nothing returns nothing
local integer ikwPlayer=1
local unit ikwHero
local integer ikwLevel
loop
exitwhen ikwPlayer>12
set ikwHero=m[ikwPlayer]
if ikwHero!=null and GetUnitAbilityLevel(ikwHero,'AIW0')>0 then
set ikwLevel=GetUnitAbilityLevel(ikwHero,'AIW0')
if BvOIkkakuBankai(ikwHero) and GetWidgetLife(ikwHero)>.405 then
if GetUnitAbilityLevel(ikwHero,'AIW1')==0 then
call UnitAddAbility(ikwHero,'AIW1')
call UnitMakeAbilityPermanent(ikwHero,true,'AIW1')
call SetPlayerAbilityAvailable(GetOwningPlayer(ikwHero),'AIW0',false)
endif
if GetUnitAbilityLevel(ikwHero,'AIW1')!=ikwLevel then
call SetUnitAbilityLevel(ikwHero,'AIW1',ikwLevel)
endif
elseif GetUnitAbilityLevel(ikwHero,'AIW1')>0 then
call UnitRemoveAbility(ikwHero,'AIW1')
call SetPlayerAbilityAvailable(GetOwningPlayer(ikwHero),'AIW0',true)
endif
endif
set ikwPlayer=ikwPlayer+1
endloop
set ikwHero=null
endfunction
function IKWInit takes nothing returns nothing
local trigger ikwTrigger=CreateTrigger()
set IKWHash=InitHashtable()
set IKWGroup=CreateGroup()
call TriggerRegisterAnyUnitEventBJ(ikwTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(ikwTrigger,Condition(function IKWOnSpell))
call TimerStart(CreateTimer(),.1,true,function IKWSync)
set ikwTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(ikwTrigger,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call TriggerRegisterAnyUnitEventBJ(ikwTrigger,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterAnyUnitEventBJ(ikwTrigger,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(ikwTrigger,Condition(function IKWOnOrder))
set ikwTrigger=null
endfunction
// ------------------------------------------------------------------ Whitebeard death (29.10): the death animation of his model
// is a standing pose, so the body dissolves over 2 seconds instead of vanishing at once; back on revival
function WBFadeTick takes nothing returns nothing
local timer wbFadeTimer=GetExpiredTimer()
local unit wbFadeHero=LoadUnitHandle(WBHash,GetHandleId(wbFadeTimer),0)
local integer wbFadeStep=LoadInteger(WBHash,GetHandleId(wbFadeTimer),1)+1
if wbFadeHero==null or GetWidgetLife(wbFadeHero)>.405 or wbFadeStep>40 then
if wbFadeHero!=null and GetWidgetLife(wbFadeHero)>.405 then
call SetUnitVertexColor(wbFadeHero,255,255,255,255)
endif
call FlushChildHashtable(WBHash,GetHandleId(wbFadeTimer))
call DestroyTimer(wbFadeTimer)
else
call SaveInteger(WBHash,GetHandleId(wbFadeTimer),1,wbFadeStep)
call SetUnitVertexColor(wbFadeHero,255,255,255,255-R2I(255.*wbFadeStep/40.))
endif
set wbFadeTimer=null
set wbFadeHero=null
endfunction
function WBFadeOnDeath takes nothing returns boolean
local timer wbFadeTimer
if GetUnitTypeId(GetTriggerUnit())=='HW00' and not IsUnitIllusion(GetTriggerUnit()) then
set wbFadeTimer=CreateTimer()
call SaveUnitHandle(WBHash,GetHandleId(wbFadeTimer),0,GetTriggerUnit())
call SaveInteger(WBHash,GetHandleId(wbFadeTimer),1,0)
call TimerStart(wbFadeTimer,.05,true,function WBFadeTick)
set wbFadeTimer=null
endif
return false
endfunction
function WBFadeOnRevive takes nothing returns boolean
if GetUnitTypeId(GetTriggerUnit())=='HW00' then
call SetUnitVertexColor(GetTriggerUnit(),255,255,255,255)
endif
return false
endfunction
function WBFadeInit takes nothing returns nothing
local trigger wbFadeTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(wbFadeTrigger,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(wbFadeTrigger,Condition(function WBFadeOnDeath))
set wbFadeTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(wbFadeTrigger,EVENT_PLAYER_HERO_REVIVE_FINISH)
call TriggerAddCondition(wbFadeTrigger,Condition(function WBFadeOnRevive))
set wbFadeTrigger=null
endfunction
// ------------------------------------------------------------------ spectators (29.10): players 6 and 12 (Player(5) and Player(11))
// are the two "Observers" slots of the lobby (slots 11 and 12): they see the whole map, own no units and can not pick
// heroes or use the hero commands; for the script they are empty slots
function BvOSpectatorChat takes nothing returns boolean
return GetPlayerId(GetTriggerPlayer())!=5 and GetPlayerId(GetTriggerPlayer())!=11
endfunction
function BvOSpectatorClean takes nothing returns nothing
local integer specIndex=5
local group specUnits=CreateGroup()
local unit specUnit
loop
call GroupEnumUnitsOfPlayer(specUnits,Player(specIndex),null)
loop
set specUnit=FirstOfGroup(specUnits)
exitwhen specUnit==null
call GroupRemoveUnit(specUnits,specUnit)
call RemoveUnit(specUnit)
endloop
exitwhen specIndex==11
set specIndex=11
endloop
call DestroyGroup(specUnits)
set specUnits=null
endfunction
function BvOSpectatorInit takes nothing returns nothing
local integer specIndex=5
local integer otherIndex
loop
call FogModifierStart(CreateFogModifierRect(Player(specIndex),FOG_OF_WAR_VISIBLE,bj_mapInitialPlayableArea,true,false))
set otherIndex=0
loop
exitwhen otherIndex>15
if otherIndex!=specIndex then
call SetPlayerAlliance(Player(otherIndex),Player(specIndex),ALLIANCE_PASSIVE,true)
call SetPlayerAlliance(Player(specIndex),Player(otherIndex),ALLIANCE_PASSIVE,true)
endif
set otherIndex=otherIndex+1
endloop
exitwhen specIndex==11
set specIndex=11
endloop
call TriggerAddCondition(pF,Condition(function BvOSpectatorChat))
call TriggerAddCondition(qF,Condition(function BvOSpectatorChat))
call TriggerAddCondition(rF,Condition(function BvOSpectatorChat))
call TriggerAddCondition(sF,Condition(function BvOSpectatorChat))
call TriggerAddCondition(tF,Condition(function BvOSpectatorChat))
call TriggerAddCondition(uF,Condition(function BvOSpectatorChat))
call TriggerAddCondition(DF,Condition(function BvOSpectatorChat))
call TriggerAddCondition(EF,Condition(function BvOSpectatorChat))
call BvOSpectatorClean()
call TimerStart(CreateTimer(),1.,true,function BvOSpectatorClean)
endfunction
// ------------------------------------------------------------------ Hood of Kairoseki / Silver Helm magic resistance (30.10):
// a hero may carry two Hoods now; the resistance comes from the hero, not from the items, and never stacks: Silver Helm
// 25% (SHMR) if he carries one, otherwise Hood of Kairoseki 15% (A06X)
function BvOMRSync takes unit mrHero returns nothing
local integer mrWanted=0
if UnitHasItemOfTypeBJ(mrHero,'I01T') then
set mrWanted='SHMR'
elseif UnitHasItemOfTypeBJ(mrHero,'I01Q') then
set mrWanted='A06X'
endif
if mrWanted!='SHMR' and GetUnitAbilityLevel(mrHero,'SHMR')>0 then
call UnitRemoveAbility(mrHero,'SHMR')
endif
if mrWanted!='A06X' and GetUnitAbilityLevel(mrHero,'A06X')>0 then
call UnitRemoveAbility(mrHero,'A06X')
endif
if mrWanted!=0 and GetUnitAbilityLevel(mrHero,mrWanted)==0 then
call UnitAddAbility(mrHero,mrWanted)
call UnitMakeAbilityPermanent(mrHero,true,mrWanted)
endif
endfunction
function BvOMRTick takes nothing returns nothing
local timer mrTimer=GetExpiredTimer()
call BvOMRSync(LoadUnitHandle(BvOCastGuardHash,GetHandleId(mrTimer),0))
call FlushChildHashtable(BvOCastGuardHash,GetHandleId(mrTimer))
call DestroyTimer(mrTimer)
set mrTimer=null
endfunction
function BvOMROnItem takes nothing returns boolean
local timer mrTimer
local integer mrType=GetItemTypeId(GetManipulatedItem())
if mrType=='I01Q' or mrType=='I01T' then
set mrTimer=CreateTimer()
call SaveUnitHandle(BvOCastGuardHash,GetHandleId(mrTimer),0,GetManipulatingUnit())
call TimerStart(mrTimer,0.,false,function BvOMRTick)
set mrTimer=null
endif
return false
endfunction
function BvOMRInit takes nothing returns nothing
local trigger mrTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(mrTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerRegisterAnyUnitEventBJ(mrTrigger,EVENT_PLAYER_UNIT_DROP_ITEM)
call TriggerAddCondition(mrTrigger,Condition(function BvOMROnItem))
set mrTrigger=null
endfunction
// ------------------------------------------------------------------ Yoruichi (30.10): no Hankisosai (W) during Flash Strike (E)
function YoruichiWBlock takes nothing returns boolean
local integer ichigoBankaiType=GetUnitTypeId(GetTriggerUnit())
// Ichigo E (A03J, Bankai): can not be cast again while Bankai is still on (it only spent the cooldown)
if GetSpellAbilityId()=='A03J' and (ichigoBankaiType=='H00E' or ichigoBankaiType=='H01B' or ichigoBankaiType=='H01C' or ichigoBankaiType=='H01D' or ichigoBankaiType=='H01E') then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
if GetOwningPlayer(GetTriggerUnit())==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00Bankai is already active.|r")
endif
return false
endif
if GetSpellAbilityId()=='A07W' and ((A[64]!=null and GetTriggerUnit()==A[64]) or BvOYoruichiEOn(GetTriggerUnit())) then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
if GetOwningPlayer(GetTriggerUnit())==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00Hankisosai can not be used during Flash Strike.|r")
endif
endif
return false
endfunction
function YoruichiWBlockInit takes nothing returns nothing
local trigger yoruichiTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(yoruichiTrigger,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(yoruichiTrigger,Condition(function YoruichiWBlock))
set yoruichiTrigger=null
endfunction
// ------------------------------------------------------------------ Crocodile E (30.10): an enemy the quicksand has started
// to pull (BvOCrocPitG) can not use items until the pit ends or he dies: the item order (useslot 1-6) is cancelled at once,
// an item spell that still starts is stopped in its cast event (no cooldown is spent)
function BvOCrocItemBlocked takes unit crocItemUser returns boolean
return BvOCrocPitOn and IsUnitInGroup(crocItemUser,BvOCrocPitG) and GetWidgetLife(crocItemUser)>.405
endfunction
function BvOCrocItemMsg takes unit crocItemUser returns nothing
if GetOwningPlayer(crocItemUser)==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffffcc00Items can not be used in the quicksand.|r")
endif
endfunction
function BvOCrocItemOrder takes nothing returns boolean
local integer crocItemOrderId=GetIssuedOrderId()
local unit crocItemUser
if crocItemOrderId>=852008 and crocItemOrderId<=852013 and BvOCrocItemBlocked(GetTriggerUnit()) then
set crocItemUser=GetTriggerUnit()
if IsUnitPaused(crocItemUser) then
call IssueImmediateOrder(crocItemUser,"stop")
else
call PauseUnit(crocItemUser,true)
call IssueImmediateOrder(crocItemUser,"stop")
call PauseUnit(crocItemUser,false)
endif
call BvOCrocItemMsg(crocItemUser)
set crocItemUser=null
endif
return false
endfunction
function BvOCrocItemCast takes nothing returns boolean
if RBItemAbility(GetSpellAbilityId()) and BvOCrocItemBlocked(GetTriggerUnit()) then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
call BvOCrocItemMsg(GetTriggerUnit())
endif
return false
endfunction
function BvOCrocItemInit takes nothing returns nothing
local trigger crocItemTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(crocItemTrigger,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call TriggerRegisterAnyUnitEventBJ(crocItemTrigger,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterAnyUnitEventBJ(crocItemTrigger,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(crocItemTrigger,Condition(function BvOCrocItemOrder))
set crocItemTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(crocItemTrigger,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(crocItemTrigger,Condition(function BvOCrocItemCast))
set crocItemTrigger=null
endfunction
// ------------------------------------------------------------------ spectators (30.10): the gold and the medals (lumber) at the
// top of a spectator's screen are those of the owner of the unit he selected last (copied every 0.1 s)
function BvOSpecResCopy takes nothing returns nothing
local integer specResIndex=5
local integer specResWatched
loop
set specResWatched=BvOSpecWatch[specResIndex]
if specResWatched>0 then
call SetPlayerState(Player(specResIndex),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(specResWatched-1),PLAYER_STATE_RESOURCE_GOLD))
call SetPlayerState(Player(specResIndex),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(specResWatched-1),PLAYER_STATE_RESOURCE_LUMBER))
endif
exitwhen specResIndex==11
set specResIndex=11
endloop
endfunction
function BvOSpecResPick takes nothing returns boolean
local integer specResOwner=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
if specResOwner<12 and specResOwner!=5 and specResOwner!=11 then
set BvOSpecWatch[GetPlayerId(GetTriggerPlayer())]=specResOwner+1
call BvOSpecResCopy()
endif
return false
endfunction
function BvOSpecResInit takes nothing returns nothing
local trigger specResTrigger=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(specResTrigger,Player(5),EVENT_PLAYER_UNIT_SELECTED,null)
call TriggerRegisterPlayerUnitEvent(specResTrigger,Player(11),EVENT_PLAYER_UNIT_SELECTED,null)
call TriggerAddCondition(specResTrigger,Condition(function BvOSpecResPick))
call TimerStart(CreateTimer(),.1,true,function BvOSpecResCopy)
set specResTrigger=null
endfunction
// ------------------------------------------------------------------ Ichigo (30.10): his stats per level are given by the script
// (H003 and its forms - Bankai H00E, H01B-H01E, True Hollow Form H01F - have no stat gain of their own): every level the
// player's Ichigo reaches for the first time, in any form, gives 4 STR, 3.75 AGI and 3 INT (fractions are kept), so levels
// gained in Bankai or in the T form are never lost or counted twice when the forms are swapped
function BvOIchigoType takes integer ichType returns boolean
return ichType=='H003' or ichType=='H00E' or ichType=='H01B' or ichType=='H01C' or ichType=='H01D' or ichType=='H01E' or ichType=='H01F'
endfunction
function BvOIchigoLevel takes nothing returns boolean
local unit ichLvUnit=GetTriggerUnit()
local integer ichLvType=GetUnitTypeId(ichLvUnit)
local integer ichLvPid=GetPlayerId(GetOwningPlayer(ichLvUnit))
local integer ichLvNew
local integer ichLvGain
local real ichLvAcc
if BvOIchigoType(ichLvType) and ichLvPid<12 then
if ichLvType!='H01F' and BvOIchigoMain[ichLvPid]!=ichLvUnit then
set BvOIchigoMain[ichLvPid]=ichLvUnit
set BvOIchigoDone[ichLvPid]=1
set BvOIchigoAcc[ichLvPid*3]=0.
set BvOIchigoAcc[ichLvPid*3+1]=0.
set BvOIchigoAcc[ichLvPid*3+2]=0.
endif
if BvOIchigoDone[ichLvPid]<1 then
set BvOIchigoDone[ichLvPid]=1
endif
set ichLvNew=GetHeroLevel(ichLvUnit)-BvOIchigoDone[ichLvPid]
if ichLvNew>0 then
set BvOIchigoDone[ichLvPid]=GetHeroLevel(ichLvUnit)
set ichLvAcc=BvOIchigoAcc[ichLvPid*3]+4.*ichLvNew
set ichLvGain=R2I(ichLvAcc)
set BvOIchigoAcc[ichLvPid*3]=ichLvAcc-ichLvGain
call SetHeroStr(ichLvUnit,GetHeroStr(ichLvUnit,false)+ichLvGain,true)
set ichLvAcc=BvOIchigoAcc[ichLvPid*3+1]+3.75*ichLvNew
set ichLvGain=R2I(ichLvAcc)
set BvOIchigoAcc[ichLvPid*3+1]=ichLvAcc-ichLvGain
call SetHeroAgi(ichLvUnit,GetHeroAgi(ichLvUnit,false)+ichLvGain,true)
set ichLvAcc=BvOIchigoAcc[ichLvPid*3+2]+3.*ichLvNew
set ichLvGain=R2I(ichLvAcc)
set BvOIchigoAcc[ichLvPid*3+2]=ichLvAcc-ichLvGain
call SetHeroInt(ichLvUnit,GetHeroInt(ichLvUnit,false)+ichLvGain,true)
endif
endif
set ichLvUnit=null
return false
endfunction
// guard: if Ichigo's own unit changes its form (Bankai on / off) without a level change, its base stats must not change;
// if the engine changed them, they are put back
function BvOIchigoGuard takes nothing returns nothing
local integer ichGPid=0
local unit ichGUnit
loop
exitwhen ichGPid>11
set ichGUnit=m[1+ichGPid]
if ichGUnit!=null and GetUnitTypeId(ichGUnit)!='H01F' and BvOIchigoType(GetUnitTypeId(ichGUnit)) and GetWidgetLife(ichGUnit)>.405 then
if ichGUnit==BvOIchigoLastU[ichGPid] and GetUnitTypeId(ichGUnit)!=BvOIchigoLastT[ichGPid] and GetHeroLevel(ichGUnit)==BvOIchigoLastL[ichGPid] then
if GetHeroStr(ichGUnit,false)!=BvOIchigoLastS[ichGPid*3] then
call SetHeroStr(ichGUnit,BvOIchigoLastS[ichGPid*3],true)
endif
if GetHeroAgi(ichGUnit,false)!=BvOIchigoLastS[ichGPid*3+1] then
call SetHeroAgi(ichGUnit,BvOIchigoLastS[ichGPid*3+1],true)
endif
if GetHeroInt(ichGUnit,false)!=BvOIchigoLastS[ichGPid*3+2] then
call SetHeroInt(ichGUnit,BvOIchigoLastS[ichGPid*3+2],true)
endif
endif
set BvOIchigoLastU[ichGPid]=ichGUnit
set BvOIchigoLastT[ichGPid]=GetUnitTypeId(ichGUnit)
set BvOIchigoLastL[ichGPid]=GetHeroLevel(ichGUnit)
set BvOIchigoLastS[ichGPid*3]=GetHeroStr(ichGUnit,false)
set BvOIchigoLastS[ichGPid*3+1]=GetHeroAgi(ichGUnit,false)
set BvOIchigoLastS[ichGPid*3+2]=GetHeroInt(ichGUnit,false)
else
set BvOIchigoLastU[ichGPid]=null
endif
set ichGPid=ichGPid+1
endloop
set ichGUnit=null
endfunction
function BvOIchigoStatInit takes nothing returns nothing
local trigger ichLvTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(ichLvTrigger,EVENT_PLAYER_HERO_LEVEL)
call TriggerAddCondition(ichLvTrigger,Condition(function BvOIchigoLevel))
call TimerStart(CreateTimer(),.1,true,function BvOIchigoGuard)
set ichLvTrigger=null
endfunction
function YoruichiWWatch takes nothing returns nothing
if Ce and Be!=null and not IsUnitPaused(Be) and GetUnitCurrentOrder(Be)!=852183 then
call DisableTrigger(Xb)
call DisableTrigger(WYuruDetectTrigger)
call DisableTrigger(Yb)
set Ce=false
set De=0.
set Ge=0.
set Ee=0.
call DestroyEffect(He[1])
call DestroyEffect(He[2])
call DestroyEffect(He[3])
call DestroyEffect(He[4])
call DestroyEffect(He[5])
call RemoveLocation(Fe[1])
set Fe[1]=null
endif
endfunction
function YoruichiWWatchInit takes nothing returns nothing
call TimerStart(CreateTimer(),.05,true,function YoruichiWWatch)
endfunction
// ------------------------------------------------------------------ Ishida T (A04X, Sprenger, after BWOS IU21): channel 1.5 s,
// point. As in BWOS, Ishida dashes 5 times around the point (circle of radius 900, an afterimage stays behind) and from every
// point shoots a Seele Schneider (Selechneider) with the BWOS trail (KuoSan_1 + blue-texiao-buff2) through the center; the 5
// blades stick into the ground at the corners of a pentagon of radius 700 and form the trap for 7 seconds (the pentagram is drawn
// while Ishida shoots). The first enemy
// inside closes it: a pentagram, the BWOS light (bluestolb), root 2 s and slow 75% until the 7 seconds end, and the damage
// 600 + 4 x INT + 1 x AGI (magic) in 14 parts every 0.1 s in an area growing from 350 to 700.
function BvOSPZ takes real spX,real spY returns real
call MoveLocation(BvOSPLoc,spX,spY)
return GetLocationZ(BvOSPLoc)
endfunction
function BvOSPFx takes unit spCaster,integer spType,real spX,real spY,real spFace,real spScale,real spSpeed,real spLife returns unit
local unit spFx=CreateUnit(GetOwningPlayer(spCaster),spType,spX,spY,spFace)
call SetUnitScale(spFx,spScale,spScale,spScale)
call SetUnitTimeScale(spFx,spSpeed)
call SetUnitFlyHeight(spFx,0.,0.)
if spLife>0. then
call UnitApplyTimedLife(spFx,'BTLF',spLife)
endif
set bj_lastCreatedUnit=spFx
set spFx=null
return bj_lastCreatedUnit
endfunction
// the trail of a blade disappears when the blade lands (as in the BWOS video: the effects only while the blades fly)
function BvOSPTrailClear takes integer spKey,integer spIndex returns nothing
local group spTrail=LoadGroupHandle(BvOSPHash,spKey,70+spIndex)
local unit spFx
if spTrail!=null then
loop
set spFx=FirstOfGroup(spTrail)
exitwhen spFx==null
call GroupRemoveUnit(spTrail,spFx)
call RemoveUnit(spFx)
endloop
call DestroyGroup(spTrail)
call RemoveSavedHandle(BvOSPHash,spKey,70+spIndex)
endif
set spTrail=null
set spFx=null
endfunction
// the BWOS sounds of Sprenger: 1 = cast ("Ishida4 W2 1"), 2 = the trap closes ("Ishida4 W2 2", on Ishida), 3 = the trap closes
// ("Ishida4 W Alt Exp", in the center)
function BvOSPMakeSound takes integer spSlot,string spPath,integer spDuration returns nothing
local sound spSound=CreateSound(spPath,false,true,true,10,10,"DefaultEAXON")
call SetSoundDuration(spSound,spDuration)
call SetSoundChannel(spSound,0)
call SetSoundVolume(spSound,127)
call SetSoundPitch(spSound,1.)
call SetSoundDistances(spSound,2000.,10000.)
call SetSoundDistanceCutoff(spSound,3000.)
call SetSoundConeAngles(spSound,0.,0.,127)
call SetSoundConeOrientation(spSound,0.,0.,0.)
call SaveSoundHandle(BvOSPHash,0,spSlot,spSound)
set spSound=null
endfunction
function BvOSPPlay takes integer spSlot,unit spSource,real spX,real spY returns nothing
local sound spSound=LoadSoundHandle(BvOSPHash,0,spSlot)
call StopSound(spSound,false,false)
if spSource!=null then
call AttachSoundToUnit(spSound,spSource)
else
call SetSoundPosition(spSound,spX,spY,0.)
endif
call StartSound(spSound)
set spSound=null
endfunction
function BvOSPCleanup takes timer spTimer,boolean spExploded returns nothing
local integer spKey=GetHandleId(spTimer)
local unit spCaster=LoadUnitHandle(BvOSPHash,spKey,0)
local integer spIndex=0
local unit spPillar
loop
exitwhen spIndex>4
set spPillar=LoadUnitHandle(BvOSPHash,spKey,10+spIndex)
if spPillar!=null then
call FlushChildHashtable(BvOSPHash,GetHandleId(spPillar))
call KillUnit(spPillar)
endif
call BvOSPTrailClear(spKey,spIndex)
set spPillar=LoadUnitHandle(BvOSPHash,spKey,40+spIndex)
if spPillar!=null then
call KillUnit(spPillar)
endif

set spIndex=spIndex+1
endloop
set spIndex=0
loop
exitwhen spIndex>9
if HaveSavedHandle(BvOSPHash,spKey,30+spIndex) then
call DestroyLightning(LoadLightningHandle(BvOSPHash,spKey,30+spIndex))
endif
set spIndex=spIndex+1
endloop
if LoadInteger(BvOSPHash,spKey,7)<5 and spCaster!=null then
call SetUnitTimeScale(spCaster,1.)
call SetUnitPathing(spCaster,true)
call SetUnitPosition(spCaster,GetUnitX(spCaster),GetUnitY(spCaster))
endif
if HaveSavedHandle(BvOSPHash,spKey,60) then
call RemoveUnit(LoadUnitHandle(BvOSPHash,spKey,60))
endif
if HaveSavedHandle(BvOSPHash,spKey,61) then
call RemoveUnit(LoadUnitHandle(BvOSPHash,spKey,61))
endif
call FlushChildHashtable(BvOSPHash,spKey)
call PauseTimer(spTimer)
call DestroyTimer(spTimer)
set spCaster=null
set spPillar=null
endfunction
function BvOSPCatch takes timer spTimer returns nothing
local integer spKey=GetHandleId(spTimer)
local unit spCaster=LoadUnitHandle(BvOSPHash,spKey,0)
local real spX=LoadReal(BvOSPHash,spKey,1)
local real spY=LoadReal(BvOSPHash,spKey,2)
local real spLeft=LoadReal(BvOSPHash,spKey,5)+7.-LoadReal(BvOSPHash,spKey,4)
local group spGroup=CreateGroup()
local unit spVictim
local unit spDummy
local integer spIndex=0
local unit spPillar
local unit spOther
local lightning spLight
call SaveBoolean(BvOSPHash,spKey,6,true)
call BvOSPPlay(2,spCaster,0.,0.)
call BvOSPPlay(3,null,spX,spY)
// the light (BWOS): two bluestolb pillars of light in the center
call SaveUnitHandle(BvOSPHash,spKey,60,BvOSPFx(spCaster,'hISB',spX,spY,0.,.5,.5,0.))
call SaveUnitHandle(BvOSPHash,spKey,61,BvOSPFx(spCaster,'hISB',spX,spY,0.,.5,.5,0.))
if spLeft<1. then
set spLeft=1.
endif
call GroupEnumUnitsInRange(spGroup,spX,spY,700.,null)
loop
set spVictim=FirstOfGroup(spGroup)
exitwhen spVictim==null
call GroupRemoveUnit(spGroup,spVictim)
if RBEnemy(spCaster,spVictim) and GetUnitAbilityLevel(spVictim,'Avul')==0 then
set spDummy=CreateUnit(GetOwningPlayer(spCaster),'hL02',GetUnitX(spVictim)-16.,GetUnitY(spVictim),0.)
call UnitAddAbility(spDummy,'AISR')
call UnitApplyTimedLife(spDummy,'BTLF',1.)
call IssueTargetOrder(spDummy,"entanglingroots",spVictim)
set spDummy=CreateUnit(GetOwningPlayer(spCaster),'hL02',GetUnitX(spVictim)-16.,GetUnitY(spVictim),0.)
call UnitAddAbility(spDummy,'AIS7')
call SetUnitAbilityLevel(spDummy,'AIS7',IMinBJ(7,IMaxBJ(1,R2I(spLeft+.5))))
call UnitApplyTimedLife(spDummy,'BTLF',1.)
call IssueTargetOrder(spDummy,"slow",spVictim)
endif
endloop
call DestroyGroup(spGroup)
// BWOS: the damage, 600 + 4 x INT + 1 x AGI, is dealt in 14 parts every 0.1 s in an area growing from 350 to 700
call SaveReal(BvOSPHash,spKey,63,(RBValue(GetUnitAbilityLevel(spCaster,'A04X'),500.,600.,700.,800.,1000.,1000.)+10.*GetHeroInt(spCaster,true))/14.)
call SaveReal(BvOSPHash,spKey,65,RBValue(GetUnitAbilityLevel(spCaster,'A04X'),6.,7.,8.,9.,10.,10.)*GetHeroAgi(spCaster,false)/14.)
set spGroup=null
set spCaster=null
set spDummy=null
set spPillar=null
set spOther=null
set spLight=null
endfunction
function BvOSPAnimEnd takes nothing returns nothing
local timer spTimer=GetExpiredTimer()
local unit spFx=LoadUnitHandle(BvOSPHash,GetHandleId(spTimer),0)
if spFx!=null and GetUnitTypeId(spFx)!=0 then
call SetUnitAnimation(spFx,"death")
endif
call FlushChildHashtable(BvOSPHash,GetHandleId(spTimer))
call DestroyTimer(spTimer)
set spTimer=null
set spFx=null
endfunction
// a BWOS trail piece: plays its "death" animation after spDelay seconds
function BvOSPTrail takes unit spCaster,integer spType,real spX,real spY,real spFace,real spScale,real spSpeed,real spLife,real spHeight,real spDelay returns nothing
local timer spTimer=CreateTimer()
local unit spFx=BvOSPFx(spCaster,spType,spX,spY,spFace,spScale,spSpeed,spLife)
call SetUnitFlyHeight(spFx,spHeight,0.)
call SaveUnitHandle(BvOSPHash,GetHandleId(spTimer),0,spFx)
call TimerStart(spTimer,spDelay,false,function BvOSPAnimEnd)
set spTimer=null
set spFx=null
endfunction
// the pentagram (BWOS MBSS lightnings) is drawn while Ishida shoots: a ray from every blade to the center as the blade lands,
// and the side between two neighbouring blades when both of them are in the ground (start times in 80+ / 85+)
function BvOSPStarLine takes integer spKey,integer spSlot,real spX,real spY,real spTime returns nothing
local lightning spLight=AddLightningEx("MBSS",true,spX,spY,BvOSPZ(spX,spY)+10.,spX,spY,BvOSPZ(spX,spY)+10.)
call SetLightningColor(spLight,.3,.8,1.,0.)
call SaveLightningHandle(BvOSPHash,spKey,spSlot,spLight)
call SaveReal(BvOSPHash,spKey,spSlot+50,spTime)
set spLight=null
endfunction
function BvOSPStar takes integer spKey,integer spIndex,real spTime returns nothing
local integer spPrev=ModuloInteger(spIndex+4,5)
local integer spNext=ModuloInteger(spIndex+1,5)
call BvOSPStarLine(spKey,30+spIndex,LoadReal(BvOSPHash,spKey,15+spIndex),LoadReal(BvOSPHash,spKey,20+spIndex),spTime)
if LoadBoolean(BvOSPHash,spKey,25+spNext) then
call BvOSPStarLine(spKey,35+spIndex,LoadReal(BvOSPHash,spKey,15+spIndex),LoadReal(BvOSPHash,spKey,20+spIndex),spTime)
endif
if LoadBoolean(BvOSPHash,spKey,25+spPrev) then
call BvOSPStarLine(spKey,35+spPrev,LoadReal(BvOSPHash,spKey,15+spPrev),LoadReal(BvOSPHash,spKey,20+spPrev),spTime)
endif
endfunction
function BvOSPTick takes nothing returns nothing
local timer spTimer=GetExpiredTimer()
local integer spKey=GetHandleId(spTimer)
local unit spCaster=LoadUnitHandle(BvOSPHash,spKey,0)
local real spX=LoadReal(BvOSPHash,spKey,1)
local real spY=LoadReal(BvOSPHash,spKey,2)
local integer spStage=LoadInteger(BvOSPHash,spKey,3)
local integer spFired=LoadInteger(BvOSPHash,spKey,7)
local real spTime=LoadReal(BvOSPHash,spKey,4)+.02
local integer spIndex=0
local integer spArrived=0
local unit spArrow
local real spTX
local real spTY
local real spDX
local real spDY
local real spDist
local real spAngle
local real spCatch
local group spGroup
local unit spVictim
local unit spRooter
call SaveReal(BvOSPHash,spKey,4,spTime)
if spFired<5 and (spCaster==null or GetWidgetLife(spCaster)<=.405 or GetUnitCurrentOrder(spCaster)!=OrderId("doom")) then
call BvOSPCleanup(spTimer,false)
set spTimer=null
set spCaster=null
return
endif
// casting (as in BWOS): every 0.2 s Ishida dashes to the next point of a circle of radius 900 around the center, leaving an
// afterimage, turns to the center and 0.14 s later shoots a Seele Schneider through the center to the far corner of the trap
if spStage<5 and spTime>=.2*spStage then
set spAngle=(25.+72.*spStage)*bj_DEGTORAD
set spTX=spX+900.*Cos(spAngle)
set spTY=spY+900.*Sin(spAngle)
// the BWOS shunpo blink where Ishida leaves and where he appears
call BvOSPFx(spCaster,'hISA',GetUnitX(spCaster),GetUnitY(spCaster),bj_RADTODEG*Atan2(spTY-GetUnitY(spCaster),spTX-GetUnitX(spCaster)),2.,2.,.3)
call SetUnitPathing(spCaster,false)
if FSPointWalkable(spTX,spTY) and FSPathClear(GetUnitX(spCaster),GetUnitY(spCaster),spTX,spTY) then
call SetUnitX(spCaster,spTX)
call SetUnitY(spCaster,spTY)
endif
call BvOSPFx(spCaster,'hISA',GetUnitX(spCaster),GetUnitY(spCaster),GetUnitFacing(spCaster),2.,2.,.3)
call SetUnitFacing(spCaster,bj_RADTODEG*Atan2(spY-GetUnitY(spCaster),spX-GetUnitX(spCaster)))
call SetUnitAnimation(spCaster,"attack")
call SetUnitTimeScale(spCaster,2.25)
call SaveReal(BvOSPHash,spKey,55+spStage,spAngle)
set spStage=spStage+1
call SaveInteger(BvOSPHash,spKey,3,spStage)
endif
if spFired<spStage and spTime>=.2*spFired+.14 then
set spAngle=LoadReal(BvOSPHash,spKey,55+spFired)
set spTX=spX-700.*Cos(spAngle)
set spTY=spY-700.*Sin(spAngle)
set spArrow=BvOSPFx(spCaster,'hISP',GetUnitX(spCaster),GetUnitY(spCaster),bj_RADTODEG*Atan2(spTY-GetUnitY(spCaster),spTX-GetUnitX(spCaster)),2.5,5.,0.)
call SetUnitFlyHeight(spArrow,125.,0.)
call SaveUnitHandle(BvOSPHash,spKey,10+spFired,spArrow)
call SaveReal(BvOSPHash,spKey,15+spFired,spTX)
call SaveReal(BvOSPHash,spKey,20+spFired,spTY)
set spFired=spFired+1
call SaveInteger(BvOSPHash,spKey,7,spFired)
if spFired==5 then
call SetUnitTimeScale(spCaster,1.)
call SetUnitPathing(spCaster,true)
call SetUnitPosition(spCaster,GetUnitX(spCaster),GetUnitY(spCaster))
endif
endif
// the Seele Schneiders fly (5000 per second) with the BWOS trail and become the pillars of the trap
loop
exitwhen spIndex>=spFired
set spArrow=LoadUnitHandle(BvOSPHash,spKey,10+spIndex)
if LoadBoolean(BvOSPHash,spKey,25+spIndex) then
set spArrived=spArrived+1
else
set spTX=LoadReal(BvOSPHash,spKey,15+spIndex)
set spTY=LoadReal(BvOSPHash,spKey,20+spIndex)
set spDX=spTX-GetUnitX(spArrow)
set spDY=spTY-GetUnitY(spArrow)
set spDist=SquareRoot(spDX*spDX+spDY*spDY)
if spDist<=100. then
call SaveBoolean(BvOSPHash,spKey,25+spIndex,true)
call BvOSPTrailClear(spKey,spIndex)
call FlushChildHashtable(BvOSPHash,GetHandleId(spArrow))
call RemoveUnit(spArrow)
set spArrow=BvOSPFx(spCaster,'hISS',spTX,spTY,bj_RADTODEG*Atan2(spY-spTY,spX-spTX),2.,1.,0.)
call SaveUnitHandle(BvOSPHash,spKey,10+spIndex,spArrow)
call BvOSPStar(spKey,spIndex,spTime)
set spArrived=spArrived+1
else
set spAngle=Atan2(spDY,spDX)
call SetUnitX(spArrow,GetUnitX(spArrow)+100.*Cos(spAngle))
call SetUnitY(spArrow,GetUnitY(spArrow)+100.*Sin(spAngle))
// the blade roots (2 s) every enemy on the ground it passes (BWOS: 225 around the point 145 ahead), once per blade
set spGroup=CreateGroup()
call GroupEnumUnitsInRange(spGroup,GetUnitX(spArrow)+145.*Cos(spAngle),GetUnitY(spArrow)+145.*Sin(spAngle),225.,null)
loop
set spVictim=FirstOfGroup(spGroup)
exitwhen spVictim==null
call GroupRemoveUnit(spGroup,spVictim)
if RBEnemy(spCaster,spVictim) and GetUnitAbilityLevel(spVictim,'Avul')==0 and GetUnitFlyHeight(spVictim)<150. and not LoadBoolean(BvOSPHash,GetHandleId(spArrow),GetHandleId(spVictim)) then
call SaveBoolean(BvOSPHash,GetHandleId(spArrow),GetHandleId(spVictim),true)
set spRooter=CreateUnit(GetOwningPlayer(spCaster),'hL02',GetUnitX(spVictim)-16.,GetUnitY(spVictim),0.)
call UnitAddAbility(spRooter,'AISR')
call UnitApplyTimedLife(spRooter,'BTLF',1.)
call IssueTargetOrder(spRooter,"entanglingroots",spVictim)
endif
endloop
call DestroyGroup(spGroup)
set spGroup=null
if LoadGroupHandle(BvOSPHash,spKey,70+spIndex)==null then
call SaveGroupHandle(BvOSPHash,spKey,70+spIndex,CreateGroup())
endif
call BvOSPTrail(spCaster,'hISK',GetUnitX(spArrow)+75.*Cos(spAngle),GetUnitY(spArrow)+75.*Sin(spAngle),spAngle*bj_RADTODEG+180.,.95,1.25,1.4,110.,.5)
call GroupAddUnit(LoadGroupHandle(BvOSPHash,spKey,70+spIndex),bj_lastCreatedUnit)
call BvOSPTrail(spCaster,'hISF',GetUnitX(spArrow)+75.*Cos(spAngle),GetUnitY(spArrow)+75.*Sin(spAngle),spAngle*bj_RADTODEG,4.,1.2,.5,140.,.15)
call GroupAddUnit(LoadGroupHandle(BvOSPHash,spKey,70+spIndex),bj_lastCreatedUnit)
endif
endif
set spIndex=spIndex+1
endloop
// every line of the pentagram grows in 0.4 s and fades in in 0.5 s from its start; at the end of the damage it fades out with
// the blades (rays 30+i: blade i -> center, sides 35+i: blade i -> blade i+1)
set spCatch=LoadReal(BvOSPHash,spKey,62)
set spIndex=0
loop
exitwhen spIndex>9
if HaveSavedHandle(BvOSPHash,spKey,30+spIndex) then
set spDist=RMinBJ(1.,(spTime-LoadReal(BvOSPHash,spKey,80+spIndex))/.4)
set spAngle=RMinBJ(1.,(spTime-LoadReal(BvOSPHash,spKey,80+spIndex))/.5)
if LoadInteger(BvOSPHash,spKey,64)>=14 then
set spAngle=RMaxBJ(0.,1.-(spTime-spCatch-1.4)/.5)
endif
set spArrow=LoadUnitHandle(BvOSPHash,spKey,10+ModuloInteger(spIndex,5))
if spIndex<5 then
set spTX=spX
set spTY=spY
else
set spTX=LoadReal(BvOSPHash,spKey,15+ModuloInteger(spIndex+1,5))
set spTY=LoadReal(BvOSPHash,spKey,20+ModuloInteger(spIndex+1,5))
endif
set spDX=GetUnitX(spArrow)+(spTX-GetUnitX(spArrow))*spDist
set spDY=GetUnitY(spArrow)+(spTY-GetUnitY(spArrow))*spDist
call MoveLightningEx(LoadLightningHandle(BvOSPHash,spKey,30+spIndex),true,GetUnitX(spArrow),GetUnitY(spArrow),BvOSPZ(GetUnitX(spArrow),GetUnitY(spArrow))+10.,spDX,spDY,BvOSPZ(spDX,spDY)+10.)
call SetLightningColor(LoadLightningHandle(BvOSPHash,spKey,30+spIndex),.3,.8,1.,spAngle)
if spIndex<5 and LoadInteger(BvOSPHash,spKey,64)>=14 then
call SetUnitVertexColor(spArrow,255,255,255,R2I(255.*spAngle))
endif
endif
set spIndex=spIndex+1
endloop
// the light of the catch (BWOS): two pillars of light grow from 0.5 to 8.95 in 1 second and fade out after 1.75 seconds
set spCatch=LoadReal(BvOSPHash,spKey,62)
if spCatch>0. and spTime-spCatch<=2.3 then
set spIndex=0
loop
exitwhen spIndex>1
set spArrow=LoadUnitHandle(BvOSPHash,spKey,60+spIndex)
if spArrow!=null then
set spDist=.5+8.45*RMinBJ(1.,(spTime-spCatch))
call SetUnitScale(spArrow,spDist,spDist,spDist)
if spTime-spCatch>1.75 then
call SetUnitVertexColor(spArrow,255,255,255,R2I(255.*RMaxBJ(0.,1.-(spTime-spCatch-1.75)/.5)))
endif
if spTime-spCatch>2.25 then
call RemoveUnit(spArrow)
call RemoveSavedHandle(BvOSPHash,spKey,60+spIndex)
endif
endif
set spIndex=spIndex+1
endloop
endif
if spArrived==5 then
if LoadReal(BvOSPHash,spKey,5)<=0. then
call SaveReal(BvOSPHash,spKey,5,spTime)
endif
if LoadBoolean(BvOSPHash,spKey,6) then
if LoadInteger(BvOSPHash,spKey,64)>=14 then
if spTime>=LoadReal(BvOSPHash,spKey,62)+2.3 then
call BvOSPCleanup(spTimer,true)
endif
elseif spTime>=LoadReal(BvOSPHash,spKey,62)+.1*(LoadInteger(BvOSPHash,spKey,64)+1)-.001 then
call SaveInteger(BvOSPHash,spKey,64,LoadInteger(BvOSPHash,spKey,64)+1)
set spDist=RMinBJ(700.,350.+450.*(spTime-LoadReal(BvOSPHash,spKey,62)))
set spGroup=CreateGroup()
call GroupEnumUnitsInRange(spGroup,spX,spY,spDist,null)
loop
set spVictim=FirstOfGroup(spGroup)
exitwhen spVictim==null
call GroupRemoveUnit(spGroup,spVictim)
if RBEnemy(spCaster,spVictim) and GetUnitAbilityLevel(spVictim,'Avul')==0 then
call DamageUnit(spCaster,spVictim,LoadReal(BvOSPHash,spKey,63),MAGICAL,SPELL)
call DamageUnit(spCaster,spVictim,LoadReal(BvOSPHash,spKey,65),CLEAN,SPELL)
endif
endloop
call DestroyGroup(spGroup)
set spGroup=null

endif
elseif spTime>=LoadReal(BvOSPHash,spKey,5)+7. then
call BvOSPCleanup(spTimer,false)
elseif not LoadBoolean(BvOSPHash,spKey,6) and ModuloInteger(R2I(spTime*50.+.5),5)==0 then
set spGroup=CreateGroup()
call GroupEnumUnitsInRange(spGroup,spX,spY,700.,null)
loop
set spVictim=FirstOfGroup(spGroup)
exitwhen spVictim==null
call GroupRemoveUnit(spGroup,spVictim)
if RBEnemy(spCaster,spVictim) and GetUnitAbilityLevel(spVictim,'Avul')==0 and not LoadBoolean(BvOSPHash,spKey,6) then
call BvOSPCatch(spTimer)
call SaveReal(BvOSPHash,spKey,62,spTime)
endif
endloop
call DestroyGroup(spGroup)
set spGroup=null
endif
endif
set spTimer=null
set spCaster=null
set spArrow=null
set spVictim=null
set spRooter=null
endfunction
function BvOSPOnSpell takes nothing returns boolean
local unit spCaster=GetTriggerUnit()
local timer spTimer
local integer spKey
local unit spTarget
if GetSpellAbilityId()=='A04X' or GetSpellAbilityId()=='AIT3' then
set spTimer=CreateTimer()
set spKey=GetHandleId(spTimer)
set spTarget=GetSpellTargetUnit()
call SaveUnitHandle(BvOSPHash,spKey,0,spCaster)
if spTarget!=null then
call SaveReal(BvOSPHash,spKey,1,GetUnitX(spTarget))
call SaveReal(BvOSPHash,spKey,2,GetUnitY(spTarget))
else
call SaveReal(BvOSPHash,spKey,1,GetSpellTargetX())
call SaveReal(BvOSPHash,spKey,2,GetSpellTargetY())
endif
call BvOSPPlay(1,spCaster,0.,0.)
call TimerStart(spTimer,.02,true,function BvOSPTick)
set spTimer=null
set spTarget=null
endif
set spCaster=null
return false
endfunction
function BvOSPSync takes nothing returns nothing
local integer spPlayer=1
local unit spHero
local integer spWanted
loop
exitwhen spPlayer>12
set spHero=m[spPlayer]
if spHero!=null then
set spWanted=GetUnitAbilityLevel(spHero,'A04X')
if spWanted>0 and FSHasSceptre(spHero) then
set spWanted=spWanted+5
endif
if spWanted==0 then
if GetUnitAbilityLevel(spHero,'AIT3')>0 then
call UnitRemoveAbility(spHero,'AIT3')
endif
else
if GetUnitAbilityLevel(spHero,'AIT3')==0 then
call UnitAddAbility(spHero,'AIT3')
call UnitMakeAbilityPermanent(spHero,true,'AIT3')
endif
if GetUnitAbilityLevel(spHero,'AIT3')!=spWanted then
call SetUnitAbilityLevel(spHero,'AIT3',spWanted)
endif
endif
endif
set spPlayer=spPlayer+1
endloop
set spHero=null
endfunction
function BvOSprengerInit takes nothing returns nothing
local trigger spTrigger=CreateTrigger()
call TimerStart(CreateTimer(),.1,true,function BvOSPSync)
set BvOSPHash=InitHashtable()
set BvOSPLoc=Location(0.,0.)
call BvOSPMakeSound(1,"Ishida4 W2 1.wav",4883)
call BvOSPMakeSound(2,"Ishida4 W2 2.wav",1882)
call BvOSPMakeSound(3,"Ishida4 W Alt Exp.wav",2062)
call TriggerRegisterAnyUnitEventBJ(spTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(spTrigger,Condition(function BvOSPOnSpell))
set spTrigger=null
endfunction
