function BvONewHeroIcon takes integer heroType returns string
if heroType=='HZ00' then
return "ReplaceableTextures\\CommandButtons\\BTNZoroFOCS.blp"
elseif heroType=='HS00' then
return "ReplaceableTextures\\CommandButtons\\BTNShikiFOCS.blp"
elseif heroType=='US00' then
return "ReplaceableTextures\\CommandButtons\\BTNUlq1Main.blp"
elseif heroType=='US1_' then
return "ReplaceableTextures\\CommandButtons\\BTNUlq2Main.blp"
elseif heroType=='US2_' then
return "ReplaceableTextures\\CommandButtons\\BTNUlq3Main.blp"
elseif heroType=='HL00' then
return "ReplaceableTextures\\CommandButtons\\BTNlaw face.blp"
elseif heroType=='HD00' then
return "war3mapImported\\BTNDoflamingo.blp"
elseif heroType=='HA00' then
return "ReplaceableTextures\\CommandButtons\\BTNAizenCaptain_icone.blp"
elseif heroType=='HK00' then
return "ReplaceableTextures\\CommandButtons\\BTNShanks.blp"
elseif heroType=='HE00' then
return "ReplaceableTextures\\CommandButtons\\BTNBvOEdward_HE00.blp"
elseif heroType=='HT00' then
return "ReplaceableTextures\\CommandButtons\\BTNTsukishima_icone.blp"
elseif heroType=='HU00' then
return "ReplaceableTextures\\CommandButtons\\BTNUnohana1_Icone.blp"
elseif heroType=='HW00' then
return "war3mapImported\\BTNWhitebeard.blp"
elseif heroType=='HP00' then
return "ReplaceableTextures\\CommandButtons\\BTNPainPortrait.blp"
elseif heroType=='HN00' then
return "ReplaceableTextures\\CommandButtons\\BTNNell.blp"
elseif heroType=='HN01' then
return "ReplaceableTextures\\CommandButtons\\BTNNellResurreccion.blp"
endif
return ""
endfunction
function BvOMultiboardNewHeroIcon takes nothing returns nothing
local integer playerIndex=GetPlayerId(GetEnumPlayer())
local string heroIcon=BvONewHeroIcon(GetUnitTypeId(m[1+playerIndex]))
if heroIcon=="" then
return
endif
if nev() then
call MultiboardSetItemIconBJ(X,1,2+(1+playerIndex),heroIcon)
elseif aHv() then
call MultiboardSetItemIconBJ(X,1,3+(1+playerIndex),heroIcon)
endif
endfunction
