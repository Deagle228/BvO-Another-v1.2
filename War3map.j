function YamamotoEEnd takes timer castTimer returns nothing
local integer key=GetHandleId(castTimer)
local unit caster=LoadUnitHandle(Hash,key,0)
if caster!=null and LoadTimerHandle(Hash,GetHandleId(caster),StringHash("YamamotoETimer"))==castTimer then
call RemoveSavedHandle(Hash,GetHandleId(caster),StringHash("YamamotoETimer"))
set l[1+GetPlayerId(GetOwningPlayer(caster))]=false
// E never owns a pause. Do not release a counter, stun, arena or another spell's hold.
if GetWidgetLife(caster)>.405 and not IsUnitPaused(caster) and not IsUnitInGroup(caster,C4) and not PNChibakuIsHeld(caster) then
call SetUnitTimeScale(caster,1.)
call SetUnitVertexColor(caster,255,255,255,255)
call ResetUnitAnimation(caster)
call SelectUnitAddForPlayer(caster,GetOwningPlayer(caster))
endif
endif
call DestroyEffect(LoadEffectHandle(Hash,key,4))
call FlushChildHashtable(Hash,key)
call PauseTimer(castTimer)
call DestroyTimer(castTimer)
set caster=null
endfunction
function YamamotoECancel takes unit caster returns nothing
local timer castTimer=LoadTimerHandle(Hash,GetHandleId(caster),StringHash("YamamotoETimer"))
if castTimer!=null then
call YamamotoEEnd(castTimer)
endif
set castTimer=null
endfunction
function YamamotoEHit takes timer castTimer,unit caster,unit victim returns nothing
local real angle=GetRandomReal(0.,360.)*bj_DEGTORAD
local real offset=GetRandomReal(10.,50.)
local group victims=CreateGroup()
local unit nearby
local real hitDamage=(1.5+.5*GetUnitAbilityLevel(caster,'A04J'))*GetHeroStr(caster,false)
call SetUnitPosition(caster,GetUnitX(victim)+offset*Cos(angle),GetUnitY(victim)+offset*Sin(angle))
call SetUnitFacing(caster,Atan2(GetUnitY(victim)-GetUnitY(caster),GetUnitX(victim)-GetUnitX(caster))*bj_RADTODEG)
call SetUnitTimeScale(caster,1.)
call SetUnitAnimation(caster,"attack")
call DestroyEffect(AddSpecialEffectTarget("!Shunpo!.mdx",caster,"origin"))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",GetUnitX(victim),GetUnitY(victim)))
call GroupEnumUnitsInRange(victims,GetUnitX(victim),GetUnitY(victim),220.,null)
loop
set nearby=FirstOfGroup(victims)
exitwhen nearby==null or LoadTimerHandle(Hash,GetHandleId(caster),StringHash("YamamotoETimer"))!=castTimer
call GroupRemoveUnit(victims,nearby)
if GetWidgetLife(nearby)>.405 and IsUnitEnemy(nearby,GetOwningPlayer(caster)) and not IsUnitType(nearby,UNIT_TYPE_STRUCTURE) and not IsUnitType(nearby,UNIT_TYPE_MECHANICAL) and not IsUnitType(nearby,UNIT_TYPE_MAGIC_IMMUNE) then
call DamageUnit(caster,nearby,hitDamage,PHYSICAL,SPELL)
endif
endloop
call DestroyGroup(victims)
set nearby=null
set victims=null
endfunction
function YamamotoETick takes nothing returns nothing
local timer castTimer=GetExpiredTimer()
local integer key=GetHandleId(castTimer)
local unit caster=LoadUnitHandle(Hash,key,0)
local unit victim=null
local group candidates
local integer tick=LoadInteger(Hash,key,1)
if caster==null then
call YamamotoEEnd(castTimer)
elseif LoadTimerHandle(Hash,GetHandleId(caster),StringHash("YamamotoETimer"))!=castTimer then
call YamamotoEEnd(castTimer)
elseif GetWidgetLife(caster)<=.405 or IsUnitType(caster,UNIT_TYPE_DEAD) or IsUnitPaused(caster) or IsUnitInGroup(caster,C4) or PNChibakuIsHeld(caster) or not l[1+GetPlayerId(GetOwningPlayer(caster))] or LoadInteger(Hash,key,5)!=LoadInteger(Hash,GetHandleId(caster),StringHash("BvORevivalGeneration")) then
call YamamotoEEnd(castTimer)
else
if GetUnitAbilityLevel(caster,'B00R')>0 then
call UnitRemoveAbility(caster,'B00R')
endif
if tick==0 then
set victim=LoadUnitHandle(Hash,key,3)
else
// Keep the original random living, visible ground target within 600.
set candidates=CreateGroup()
call GroupEnumUnitsInRange(candidates,GetUnitX(caster),GetUnitY(caster),600.,null)
set victim=null
call SaveInteger(Hash,key,6,0)
loop
set victim=FirstOfGroup(candidates)
exitwhen victim==null
call GroupRemoveUnit(candidates,victim)
if IsUnitEnemy(victim,GetOwningPlayer(caster)) and GetWidgetLife(victim)>.405 and not IsUnitType(victim,UNIT_TYPE_DEAD) and not IsUnitType(victim,UNIT_TYPE_STRUCTURE) and not IsUnitType(victim,UNIT_TYPE_FLYING) and GetUnitAbilityLevel(victim,'A01Q')==0 and not IsUnitHidden(victim) and IsUnitVisible(victim,GetOwningPlayer(caster)) then
call SaveInteger(Hash,key,6,LoadInteger(Hash,key,6)+1)
if GetRandomInt(1,LoadInteger(Hash,key,6))==1 then
call SaveUnitHandle(Hash,key,7,victim)
endif
endif
endloop
if LoadInteger(Hash,key,6)>0 then
set victim=LoadUnitHandle(Hash,key,7)
endif
call DestroyGroup(candidates)
set candidates=null
endif
if victim!=null and GetWidgetLife(victim)>.405 and not IsUnitType(victim,UNIT_TYPE_DEAD) and (tick==0 or YamamotoECanStrike(caster)) then
call YamamotoEHit(castTimer,caster,victim)
endif
// Damage callbacks may cancel E or kill the caster. Never touch a replaced cast.
if LoadTimerHandle(Hash,GetHandleId(caster),StringHash("YamamotoETimer"))==castTimer then
if tick>=LoadInteger(Hash,key,2) then
call YamamotoEEnd(castTimer)
else
call SaveInteger(Hash,key,1,tick+1)
call TimerStart(castTimer,.3,false,function YamamotoETick)
endif
endif
endif
set caster=null
set victim=null
set castTimer=null
endfunction
