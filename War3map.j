function BvOSwapCurrentHeroes takes integer swapFirstSlot,integer swapSecondSlot returns nothing
local unit swapFirstHero=m[swapFirstSlot]
local unit swapSecondHero=m[swapSecondSlot]
local player swapFirstOwner=Player(swapFirstSlot-1)
local player swapSecondOwner=Player(swapSecondSlot-1)
if BvOHasCurrentPlayerHero(swapFirstOwner) and BvOHasCurrentPlayerHero(swapSecondOwner) and swapFirstHero!=swapSecondHero then
call SetUnitOwner(swapFirstHero,swapSecondOwner,true)
call SetUnitOwner(swapSecondHero,swapFirstOwner,true)
set m[swapFirstSlot]=swapSecondHero
set m[swapSecondSlot]=swapFirstHero
if GetUnitTypeId(swapFirstHero)=='NC03' and A[99]!=null then
call SetUnitOwner(A[99],swapSecondOwner,true)
endif
if GetUnitTypeId(swapSecondHero)=='NC03' and A[99]!=null then
call SetUnitOwner(A[99],swapFirstOwner,true)
endif
if GetUnitTypeId(swapFirstHero)=='E001' and Sf!=null then
call SetUnitOwner(Sf,swapSecondOwner,true)
endif
if GetUnitTypeId(swapSecondHero)=='E001' and Sf!=null then
call SetUnitOwner(Sf,swapFirstOwner,true)
endif
call BvOClearHeroSwapRequests(swapFirstSlot)
call BvOClearHeroSwapRequests(swapSecondSlot)
endif
set swapFirstHero=null
set swapSecondHero=null
set swapFirstOwner=null
set swapSecondOwner=null
endfunction
// Super Creep: only the first spawn uses the original creep-wave lottery.
// Once killed, the next miniboss waits for a completed duel.
function BvOSCSpawn takes nothing returns nothing
local integer creepType='nano'
local real spawnX
local real spawnY
if not v4 or w4!=null or N4 then
return
endif
set x4=GetRandomInt(1,6)
if x4==2 then
set creepType='ncnk'
elseif x4==3 then
set creepType='nftk'
elseif x4==4 then
set creepType='nfra'
elseif x4==5 then
set creepType='nsbm'
elseif x4==6 then
set creepType='nmgd'
endif
set spawnX=GetRandomReal(GetRectMinX(sn),GetRectMaxX(sn))
set spawnY=GetRandomReal(GetRectMinY(sn),GetRectMaxY(sn))
set w4=CreateUnit(Player(12),creepType,spawnX,spawnY,GetRandomReal(0.,360.))
call SetUnitManaPercentBJ(w4,100.)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl",w4,"origin"))
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,GetUnitName(w4)+" has entered the Arena!")
endfunction
function BvOSCAfterDuel takes nothing returns nothing
if v4 and BvOSCRespawnPending and w4==null and not N4 then
set BvOSCRespawnPending=false
call BvOSCSpawn()
endif
endfunction
function BvODuelHeroGroup takes player duelHeroOwner returns group
local group duelHeroGroup=CreateGroup()
if BvOHasCurrentPlayerHero(duelHeroOwner) then
call GroupAddUnit(duelHeroGroup,m[1+GetPlayerId(duelHeroOwner)])
endif
return duelHeroGroup
endfunction
// duels (all but 5 vs 5): a player who went to a duel is not chosen again until every other player of his team that
// can go has gone too; then the round starts over
function BvODuelFreshFilter takes nothing returns nothing
if not BvODuelWent[GetPlayerId(GetEnumPlayer())] then
call ForceAddPlayer(BvODuelFresh,GetEnumPlayer())
endif
endfunction
function BvODuelResetEnum takes nothing returns nothing
set BvODuelWent[GetPlayerId(GetEnumPlayer())]=false
endfunction
function BvODuelFairPick takes force candidates returns player
local player picked
if BvODuelFresh==null then
set BvODuelFresh=CreateForce()
endif
call ForceClear(BvODuelFresh)
call ForForce(candidates,function BvODuelFreshFilter)
if CountPlayersInForceBJ(BvODuelFresh)==0 then
call ForForce(candidates,function BvODuelResetEnum)
set picked=ForcePickRandomPlayer(candidates)
else
set picked=ForcePickRandomPlayer(BvODuelFresh)
endif
if picked!=null then
set BvODuelWent[GetPlayerId(picked)]=true
endif
call DestroyForce(candidates)
return picked
endfunction
function BvODuelPick5 takes force candidates returns player
local player picked
if BvOTeamDuel5<5 then
return BvODuelFairPick(candidates)
endif
set picked=ForcePickRandomPlayer(candidates)
call DestroyForce(candidates)
return picked
endfunction
// 3 vs 3 event: 2 vs 2 or 3 vs 3 (3 vs 3 needs 3 players with heroes in each team). 2 vs 2 is fought in the 1 vs 1
// arena: the rects of the 3 vs 3 arena are pointed at the 1 vs 1 arena until the event ends
function BvOTeamDuelCount takes integer teamIndex returns integer
local integer playerIndex=0
local integer heroCount=0
loop
exitwhen playerIndex>11
if BvOSlotState(Player(playerIndex))==PLAYER_SLOT_STATE_PLAYING and BvOHasCurrentPlayerHero(Player(playerIndex)) and ((teamIndex==1 and IsPlayerInForce(Player(playerIndex),e)) or (teamIndex==2 and IsPlayerInForce(Player(playerIndex),f))) then
set heroCount=heroCount+1
endif
set playerIndex=playerIndex+1
endloop
return heroCount
endfunction
function BvOTeamDuelRestoreArena takes nothing returns nothing
if BvODuelSmallArena then
set BvODuelSmallArena=false
set so=BvODuelSaveSo
set Do=BvODuelSaveDo
set Ao=BvODuelSaveAo
set ao=BvODuelSaveao
set Bo=BvODuelSaveBo
set bo=BvODuelSavebo
set Co=BvODuelSaveCo
set co=BvODuelSaveco
endif
endfunction
function BvOTeamDuelSetup3 takes nothing returns nothing
local integer teamSize=IMinBJ(BvOTeamDuelCount(1),BvOTeamDuelCount(2))
call BvOTeamDuelRestoreArena()
if teamSize>=3 then
set BvOTeamDuel3=GetRandomInt(2,3)
else
set BvOTeamDuel3=2
endif
if BvOTeamDuel3==2 then
set BvODuelSmallArena=true
set BvODuelSaveSo=so
set BvODuelSaveDo=Do
set BvODuelSaveAo=Ao
set BvODuelSaveao=ao
set BvODuelSaveBo=Bo
set BvODuelSavebo=bo
set BvODuelSaveCo=Co
set BvODuelSaveco=co
set so=An
set Do=An
set Ao=Rect(-6208.,6320.,-6144.,6384.)
set ao=Rect(-6208.,5808.,-6144.,5872.)
set Bo=Rect(-6208.,6064.,-6144.,6128.)
set bo=Rect(-5664.,6320.,-5600.,6384.)
set Co=Rect(-5664.,5808.,-5600.,5872.)
set co=Rect(-5664.,6064.,-5600.,6128.)
endif
endfunction
// 5 vs 5 event: 4 vs 4 or 5 vs 5 (5 vs 5 needs 5 players with heroes in each team), in the same arena
function BvOTeamDuelSetup5 takes nothing returns nothing
local integer teamSize=IMinBJ(BvOTeamDuelCount(1),BvOTeamDuelCount(2))
call BvOTeamDuelRestoreArena()
if teamSize>=5 then
set BvOTeamDuel5=GetRandomInt(4,5)
else
set BvOTeamDuel5=4
endif
endfunction
function BvODetachRepickedHero takes unit repickedOldHero returns nothing
local integer repickDuelIndex=1
call InoueTForgetTarget(repickedOldHero)
if G[4]!=null then
call GroupRemoveUnit(G[4],repickedOldHero)
endif
if mh!=null then
call GroupRemoveUnit(mh,repickedOldHero)
endif
if em!=null then
call GroupRemoveUnit(em,repickedOldHero)
endif
if fm!=null then
call GroupRemoveUnit(fm,repickedOldHero)
endif
if x==repickedOldHero then
set x=null
endif
if y==repickedOldHero then
set y=null
endif
loop
exitwhen repickDuelIndex>5
if Y[repickDuelIndex]==repickedOldHero then
set Y[repickDuelIndex]=null
endif
if Z[repickDuelIndex]==repickedOldHero then
set Z[repickDuelIndex]=null
endif
if O7[repickDuelIndex]==repickedOldHero then
set O7[repickDuelIndex]=null
endif
if P7[repickDuelIndex]==repickedOldHero then
set P7[repickDuelIndex]=null
endif
set repickDuelIndex=repickDuelIndex+1
endloop
endfunction
function BvOJumpIgnoresPortal takes unit portalJumpHero returns boolean
return LoadBoolean(Hash,GetHandleId(portalJumpHero),StringHash("JumpPortalLanding"))
endfunction
function BvOJumpApplyPortalLevelReturn takes unit portalLandingHero returns boolean
local rect portalReturnRect=null
local integer portalRequiredLevel=0
local real portalReturnX
local real portalReturnY
if not IsUnitType(portalLandingHero,UNIT_TYPE_HERO) or GetWidgetLife(portalLandingHero)<=.405 then
return false
endif
if LoadInteger(Hash,GetHandleId(portalLandingHero),StringHash("JumpPortalGateLevel"))==20 and GetHeroLevel(portalLandingHero)<20 then
set portalReturnRect=Vn
set portalRequiredLevel=20
elseif LoadInteger(Hash,GetHandleId(portalLandingHero),StringHash("JumpPortalGateLevel"))==40 and GetHeroLevel(portalLandingHero)<40 then
set portalReturnRect=Zn
set portalRequiredLevel=40
endif
if portalReturnRect==null then
return false
endif
set portalReturnX=GetRectCenterX(portalReturnRect)
set portalReturnY=GetRectCenterY(portalReturnRect)
call IssueImmediateOrderById(portalLandingHero,851972)
call SetUnitPosition(portalLandingHero,portalReturnX,portalReturnY)
call SetUnitFacing(portalLandingHero,Atan2(GetUnitY(mG)-portalReturnY,GetUnitX(mG)-portalReturnX)*bj_RADTODEG)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl",portalLandingHero,"origin"))
call PanCameraToTimedForPlayer(GetOwningPlayer(portalLandingHero),GetUnitX(portalLandingHero),GetUnitY(portalLandingHero),0.)
if n4[1+GetPlayerId(GetOwningPlayer(portalLandingHero))] then
call SetCameraTargetControllerNoZForPlayer(GetOwningPlayer(portalLandingHero),portalLandingHero,0.,0.,false)
endif
call DisplayTimedTextToPlayer(GetOwningPlayer(portalLandingHero),0.,0.,4.,"|cffffcc00Area for hero above level "+I2S(portalRequiredLevel)+"|r")
set portalReturnRect=null
return true
endfunction
function BvOJumpPortalLandingTick takes nothing returns nothing
local timer portalLandingTimer=GetExpiredTimer()
local integer portalLandingTimerId=GetHandleId(portalLandingTimer)
local unit portalLandingHero=LoadUnitHandle(Hash,portalLandingTimerId,StringHash("hero"))
local real portalLandingX=LoadReal(Hash,portalLandingTimerId,StringHash("landingX"))
local real portalLandingY=LoadReal(Hash,portalLandingTimerId,StringHash("landingY"))
local group portalLandingGates=LoadGroupHandle(Hash,portalLandingTimerId,StringHash("gates"))
local group portalLandingScan
local unit portalLandingGate
local real portalLandingDeltaX
local real portalLandingDeltaY
local boolean portalLandingStop=false
local integer portalLandingTicks=LoadInteger(Hash,portalLandingTimerId,StringHash("ticks"))+1
if portalLandingHero==null or GetUnitTypeId(portalLandingHero)==0 or GetWidgetLife(portalLandingHero)<=.405 or LoadInteger(Hash,GetHandleId(portalLandingHero),StringHash("BvORevivalGeneration"))!=LoadInteger(Hash,portalLandingTimerId,StringHash("life")) then
set portalLandingStop=true
elseif portalLandingTicks>=3 and LoadBoolean(Hash,GetHandleId(portalLandingHero),StringHash("JumpPortalFinished")) and BvOJumpApplyPortalLevelReturn(portalLandingHero) then
set portalLandingStop=true
elseif portalLandingTicks>=3 and GetUnitCurrentOrder(portalLandingHero)!=0 and GetUnitCurrentOrder(portalLandingHero)!=851972 then
set portalLandingStop=true
else
set portalLandingDeltaX=GetUnitX(portalLandingHero)-portalLandingX
set portalLandingDeltaY=GetUnitY(portalLandingHero)-portalLandingY
if portalLandingDeltaX*portalLandingDeltaX+portalLandingDeltaY*portalLandingDeltaY>14400. then
set portalLandingScan=CreateGroup()
call GroupAddGroup(portalLandingGates,portalLandingScan)
loop
set portalLandingGate=FirstOfGroup(portalLandingScan)
exitwhen portalLandingGate==null
call GroupRemoveUnit(portalLandingScan,portalLandingGate)
set portalLandingDeltaX=GetUnitX(portalLandingHero)-WaygateGetDestinationX(portalLandingGate)
set portalLandingDeltaY=GetUnitY(portalLandingHero)-WaygateGetDestinationY(portalLandingGate)
if WaygateIsActive(portalLandingGate) and portalLandingDeltaX*portalLandingDeltaX+portalLandingDeltaY*portalLandingDeltaY<=65536. then
call SetUnitX(portalLandingHero,portalLandingX)
call SetUnitY(portalLandingHero,portalLandingY)
call IssueImmediateOrderById(portalLandingHero,851972)
exitwhen true
endif
endloop
if portalLandingGate==null then
set portalLandingStop=true
endif
call DestroyGroup(portalLandingScan)
endif
endif
if portalLandingStop or portalLandingTicks>=20 then
call RemoveSavedBoolean(Hash,GetHandleId(portalLandingHero),StringHash("JumpPortalLanding"))
call RemoveSavedBoolean(Hash,GetHandleId(portalLandingHero),StringHash("JumpPortalFinished"))
call RemoveSavedInteger(Hash,GetHandleId(portalLandingHero),StringHash("JumpPortalGateLevel"))
call PauseTimer(portalLandingTimer)
call DestroyGroup(portalLandingGates)
call FlushChildHashtable(Hash,portalLandingTimerId)
call DestroyTimer(portalLandingTimer)
else
call SaveInteger(Hash,portalLandingTimerId,StringHash("ticks"),portalLandingTicks)
endif
set portalLandingTimer=null
set portalLandingHero=null
set portalLandingGates=null
set portalLandingScan=null
set portalLandingGate=null
endfunction
function BvOJumpPreparePortalLanding takes unit portalJumpHero,location portalJumpLanding returns nothing
local timer portalLandingTimer=CreateTimer()
local integer portalLandingTimerId=GetHandleId(portalLandingTimer)
local group portalNearbyUnits=CreateGroup()
local group portalNearbyGates=CreateGroup()
local unit portalCandidateGate
local real portalGateDeltaX
local real portalGateDeltaY
call SaveBoolean(Hash,GetHandleId(portalJumpHero),StringHash("JumpPortalLanding"),true)
call SaveInteger(Hash,GetHandleId(portalJumpHero),StringHash("JumpPortalGateLevel"),0)
set portalGateDeltaX=GetLocationX(portalJumpLanding)-GetUnitX(pG)
set portalGateDeltaY=GetLocationY(portalJumpLanding)-GetUnitY(pG)
if pG!=null and portalGateDeltaX*portalGateDeltaX+portalGateDeltaY*portalGateDeltaY<=90000. then
call SaveInteger(Hash,GetHandleId(portalJumpHero),StringHash("JumpPortalGateLevel"),20)
else
set portalGateDeltaX=GetLocationX(portalJumpLanding)-GetUnitX(nG)
set portalGateDeltaY=GetLocationY(portalJumpLanding)-GetUnitY(nG)
if nG!=null and portalGateDeltaX*portalGateDeltaX+portalGateDeltaY*portalGateDeltaY<=160000. then
call SaveInteger(Hash,GetHandleId(portalJumpHero),StringHash("JumpPortalGateLevel"),40)
endif
endif
call GroupEnumUnitsInRange(portalNearbyUnits,GetLocationX(portalJumpLanding),GetLocationY(portalJumpLanding),400.,null)
loop
set portalCandidateGate=FirstOfGroup(portalNearbyUnits)
exitwhen portalCandidateGate==null
call GroupRemoveUnit(portalNearbyUnits,portalCandidateGate)
if WaygateIsActive(portalCandidateGate) then
call GroupAddUnit(portalNearbyGates,portalCandidateGate)
endif
endloop
call DestroyGroup(portalNearbyUnits)
call SaveUnitHandle(Hash,portalLandingTimerId,StringHash("hero"),portalJumpHero)
call SaveReal(Hash,portalLandingTimerId,StringHash("landingX"),GetLocationX(portalJumpLanding))
call SaveReal(Hash,portalLandingTimerId,StringHash("landingY"),GetLocationY(portalJumpLanding))
call SaveGroupHandle(Hash,portalLandingTimerId,StringHash("gates"),portalNearbyGates)
call SaveInteger(Hash,portalLandingTimerId,StringHash("life"),LoadInteger(Hash,GetHandleId(portalJumpHero),StringHash("BvORevivalGeneration")))
call SaveInteger(Hash,portalLandingTimerId,StringHash("ticks"),0)
call TimerStart(portalLandingTimer,.05,true,function BvOJumpPortalLandingTick)
set portalLandingTimer=null
set portalNearbyUnits=null
set portalNearbyGates=null
set portalCandidateGate=null
endfunction
function CreateDummy takes nothing returns nothing
set Dummycaster=CreateUnit(DummycasterOwner,DummycasterId,0,0,0)
endfunction
function DebugDummy takes nothing returns nothing
if Dummycaster==null then
call CreateDummy()
endif
if IsUnitPaused(Dummycaster) then
call PauseUnit(Dummycaster,false)
endif
endfunction
function DummycasterInit takes nothing returns nothing
call CreateDummy()
endfunction
function CastToTarget takes unit caster,unit target,integer abilityId,integer abilityLevel,string abilityOrder returns nothing
local boolean isVisible=false
local unit castDummy
if target==null or caster==null then
return
endif
set castDummy=CreateUnit(GetOwningPlayer(caster),DummycasterId,GetUnitX(target),GetUnitY(target),0.)
call UnitApplyTimedLife(castDummy,'BTLF',2.)
call BvOVfxExpire(castDummy,null,5.)
call UnitAddAbility(castDummy,abilityId)
call SetUnitAbilityLevel(castDummy,abilityId,abilityLevel)
if not IsUnitVisible(target,GetOwningPlayer(caster)) then
call UnitShareVision(target,GetOwningPlayer(caster),true)
set isVisible=true
endif
call IssueTargetOrder(castDummy,abilityOrder,target)
if isVisible then
call UnitShareVision(target,GetOwningPlayer(caster),false)
endif
set castDummy=null
endfunction
function CastCasterToTargetEx takes unit caster,unit target,integer abilityId,integer abilityLevel,string abilityOrder returns nothing
local boolean isVisible=false
local unit dummycaster=CreateUnit(GetOwningPlayer(caster),DummycasterId,GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
call UnitApplyTimedLife(dummycaster,0,3)
call BvOVfxExpire(dummycaster,null,6.)
call UnitAddAbility(dummycaster,abilityId)
call SetUnitAbilityLevel(dummycaster,abilityId,abilityLevel)
if not IsUnitVisible(target,GetOwningPlayer(caster)) then
call UnitShareVision(target,GetOwningPlayer(caster),true)
set isVisible=true
endif
call IssueTargetOrder(dummycaster,abilityOrder,target)
if isVisible then
call UnitShareVision(target,GetOwningPlayer(caster),false)
endif
set dummycaster=null
endfunction
function ModifyDamage takes unit whichUnit,widget target,real amount,attacktype attackType,damagetype damageType returns boolean
local real damage=amount
if 1==1 then
endif
return UnitDamageTarget(whichUnit,target,damage,false,false,attackType,damageType,null)
endfunction
function BvOCastGuardTick takes nothing returns nothing
set BvOCastGuardExpired=GetExpiredTimer()
call TriggerEvaluate(BvOCastGuardTrigger)
call FlushChildHashtable(BvOCastGuardHash,GetHandleId(BvOCastGuardExpired))
call DestroyTimer(BvOCastGuardExpired)
set BvOCastGuardExpired=null
endfunction
function DamageUnit takes unit source,unit target,real damage,integer damageType,integer damageMode returns nothing
local timer bvoGuardTimer
if damage>0. and target!=null and target==BvOCastGuardUnit and TimerGetElapsed(AYClock)==BvOCastGuardTime then
set bvoGuardTimer=CreateTimer()
call SaveUnitHandle(BvOCastGuardHash,GetHandleId(bvoGuardTimer),0,source)
call SaveUnitHandle(BvOCastGuardHash,GetHandleId(bvoGuardTimer),1,target)
call SaveReal(BvOCastGuardHash,GetHandleId(bvoGuardTimer),2,damage)
call SaveInteger(BvOCastGuardHash,GetHandleId(bvoGuardTimer),3,damageType)
call SaveInteger(BvOCastGuardHash,GetHandleId(bvoGuardTimer),4,damageMode)
call TimerStart(bvoGuardTimer,0.,false,function BvOCastGuardTick)
set bvoGuardTimer=null
return
endif
if damage>0. then
call InoueTWakeSleepingTarget(target)
endif
set DamageSystem_DamageMode=damageMode
set PrimaryDamage=damage
if damageType==PHYSICAL then
set DamageType=PHYSICAL
call ModifyDamage(source,target,damage,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
elseif damageType==MAGICAL then
set DamageType=MAGICAL
call ModifyDamage(source,target,damage,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC)
elseif damageType==MIXED then
set DamageType=MIXED
call ModifyDamage(source,target,damage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
elseif damageType==CLEAN then
set DamageType=CLEAN
call ModifyDamage(source,target,damage,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
else
set DamageType=UNKNOWN
call ModifyDamage(source,target,damage,null,null)
endif
set DamageSystem_DamageMode=-1
endfunction
function BvOCastGuardDamage takes nothing returns boolean
local integer bvoGuardKey=GetHandleId(BvOCastGuardExpired)
call DamageUnit(LoadUnitHandle(BvOCastGuardHash,bvoGuardKey,0),LoadUnitHandle(BvOCastGuardHash,bvoGuardKey,1),LoadReal(BvOCastGuardHash,bvoGuardKey,2),LoadInteger(BvOCastGuardHash,bvoGuardKey,3),LoadInteger(BvOCastGuardHash,bvoGuardKey,4))
return false
endfunction
function BvOCastGuardOnSpell takes nothing returns boolean
set BvOCastGuardUnit=GetTriggerUnit()
set BvOCastGuardTime=TimerGetElapsed(AYClock)
return false
endfunction
function BvOCastGuardInit takes nothing returns nothing
local trigger bvoGuardSpell=CreateTrigger()
call TriggerAddCondition(BvOCastGuardTrigger,Condition(function BvOCastGuardDamage))
call TriggerRegisterAnyUnitEventBJ(bvoGuardSpell,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(bvoGuardSpell,Condition(function BvOCastGuardOnSpell))
set bvoGuardSpell=null
endfunction
function FindCallIndex takes string funcName,integer damageMode returns integer
local integer index=0
loop
set index=index+1
exitwhen index>Count
if FuncName[index]==funcName and Mode[index]==damageMode then
return index
endif
endloop
return 0
endfunction
function UnitTakesDamageSystemAddCall takes string funcName,integer damageMode returns boolean
if FindCallIndex(funcName,damageMode)==0 then
if damageMode!=-1 then
set Count=Count+1
set FuncName[Count]=funcName
set Mode[Count]=damageMode
return true
endif
endif
return false
endfunction
function UnitEventTakesDamage_Actions takes nothing returns nothing
local integer i=0
set Source=GetEventDamageSource()
set TrueSource=Source
set Target=GetTriggerUnit()
set Damage=GetEventDamage()
call ExecuteFunc("ULQ_WBlockDamage")
if GetUnitAbilityLevel(Source,$416C6F63)==1 or GetUnitAbilityLevel(Source,$41304551)==1 and DamageMode==MODE_ATTACK then
set DamageMode=MODE_SPELL
set Source=m[1+GetPlayerId(GetOwningPlayer(Source))]
endif
call ExecuteFunc("RBReplaceDummyDamage")
if Damage<=0. then
return
endif
call ExecuteFunc("AYDamageHook")
call ExecuteFunc("GhostScepterDamageHook")
call ExecuteFunc("KidoGrimoireDamageHook")
call ExecuteFunc("OnmitsuDamageHook")
call ExecuteFunc("TSDamageHook")
call ExecuteFunc("UNDamageHook")
call ExecuteFunc("WBDamageHook")
call ExecuteFunc("NLDamageHook")
call ExecuteFunc("SDDamageHook")
call ExecuteFunc("RBDamageHook")
loop
set i=i+1
exitwhen i>Count
if Mode[i]==DamageMode then
call ExecuteFunc(FuncName[i])
endif
endloop
endfunction
function UnitTakesDamage_Conditions takes nothing returns boolean
if GetEventDamage()>0 then
call InoueTWakeSleepingTarget(GetTriggerUnit())
if DamageSystem_DamageMode==SPELL then
set DamageMode=MODE_SPELL
elseif DamageSystem_DamageMode==ATTACK then
set DamageMode=MODE_MELEE_ATTACK_EMULATION
elseif DamageSystem_DamageMode==RANGE then
set DamageMode=MODE_RANGE_ATTACK_EMULATION
elseif DamageSystem_DamageMode==UNKNOWN then
set DamageMode=MODE_UNKNOWN_UNMODIFIED
else
set DamageMode=MODE_ATTACK
endif
if DamageSystem_DamageMode!=UNKNOWN then
call UnitEventTakesDamage_Actions()
endif
endif
return false
endfunction
function GroupTakingDamageFilter takes nothing returns boolean
if not IsUnitInGroup(GetFilterUnit(),GroupTakingDamage) and GetUnitAbilityLevel(GetFilterUnit(),$416C6F63)==0 and not IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE) then
call GroupAddUnit(GroupTakingDamage,GetFilterUnit())
call TriggerRegisterUnitEvent(TriggerUnitTakesDamage,GetFilterUnit(),EVENT_UNIT_DAMAGED)
if IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and not IsUnitInGroup(GetFilterUnit(),HeroesGroup) then
call GroupAddUnit(HeroesGroup,GetFilterUnit())
endif
endif
return false
endfunction
function RemoveUnitFromGroupTakingDamage takes nothing returns boolean
if not IsUnitType(GetDecayingUnit(),UNIT_TYPE_HERO) and IsUnitInGroup(GetDecayingUnit(),GroupTakingDamage) then
call GroupRemoveUnit(GroupTakingDamage,GetDecayingUnit())
endif
return false
endfunction
function DamageEventInitCall takes nothing returns nothing
call UnitTakesDamageSystemAddCall("AttackDamageTrigger",MODE_ATTACK)
call UnitTakesDamageSystemAddCall("SpellDamageTrigger",MODE_SPELL)
call UnitTakesDamageSystemAddCall("UnknownDamageTrigger",MODE_UNKNOWN_UNMODIFIED)
endfunction
function AttackDamageTrigger takes nothing returns nothing
// Sasuke R with Oken: the healing cut is applied on every attack hit (the same attack hits as the item passives)
call ExecuteFunc("SHRDamageHook")
call ExecuteFunc("RBAttackHook")
call ExecuteFunc("Bladebane_Reflect")
call ExecuteFunc("Bonecrucher_Attack")
call ExecuteFunc("HaoshokuCrusher_Attack")
call ExecuteFunc("ItemPassiv_Attack")
call ExecuteFunc("InoeV_Attack")
call ExecuteFunc("SadoV_Attack")
call ExecuteFunc("SoiFonT_HomonkaAttack")
call ExecuteFunc("SoiFonQ_Attack")
call ExecuteFunc("YamamotoQ_Attack")
call ExecuteFunc("MihawkQ_Attack")
call ExecuteFunc("KumaW_Reflect")
call ExecuteFunc("LucciE_DamageBlock")
call ExecuteFunc("InoeW_Block")
call ExecuteFunc("OrbOfAbs_Attack")
call ExecuteFunc("AceV_BlockDamage")
endfunction
function SpellDamageTrigger takes nothing returns nothing
call ExecuteFunc("Bladebane_Reflect")
call ExecuteFunc("ItemPassiv_Spell")
call ExecuteFunc("InoeV_DummyAttack")
call ExecuteFunc("KumaW_Reflect")
call ExecuteFunc("LucciE_DamageBlock")
call ExecuteFunc("InoeW_Block")
call ExecuteFunc("InoeR_BonusDamage")
call ExecuteFunc("AceV_BlockDamage")
call ExecuteFunc("OrbOfAbs_Attack")
endfunction
function UnknownDamageTrigger takes nothing returns nothing
call ExecuteFunc("LucciE_DamageBlock")
call ExecuteFunc("InoeW_Block")
call ExecuteFunc("AceV_BlockDamage")
call ExecuteFunc("OrbOfAbs_Attack")
endfunction
function StartSortingUnitsInTheMap takes nothing returns nothing
local region mapRegion=CreateRegion()
local integer index=0
call TriggerAddCondition(TriggerUnitTakesDamage,Condition(function UnitTakesDamage_Conditions))
call RegionAddRect(mapRegion,bj_mapInitialPlayableArea)
call GroupEnumUnitsInRect(GroupTakingDamage,bj_mapInitialPlayableArea,Filter(function GroupTakingDamageFilter))
call TriggerRegisterEnterRegion(TriggerUnitEntersTheMap,mapRegion,Filter(function GroupTakingDamageFilter))
loop
call TriggerRegisterPlayerUnitEvent(TriggerUnitDecay,Player(index),EVENT_PLAYER_UNIT_DECAY,Filter(function RemoveUnitFromGroupTakingDamage))
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call DamageEventInitCall()
call DestroyTimer(GetExpiredTimer())
set mapRegion=null
endfunction
function DamageAndPlayEffectOnUnits takes nothing returns nothing
call DamageUnit(TempSource,GetEnumUnit(),TempDamage,TempDamageType,TempDamageMode)
call DestroyEffect(AddSpecialEffectTarget(TempEffectPath,GetEnumUnit(),TempAttachPoint))
endfunction
function DamageAndPlayEffectOnGroup takes unit whichUnit,real amount,integer damageType,integer damageMode,string attachPoint,string effectPath returns nothing
set TempSource=whichUnit
set TempDamage=amount
set TempDamageType=damageType
set TempDamageMode=damageMode
set TempAttachPoint=attachPoint
set TempEffectPath=effectPath
call ForGroup(TempGroup,function DamageAndPlayEffectOnUnits)
endfunction
function DamageGroupUnits takes nothing returns nothing
call DamageUnit(TempSource,GetEnumUnit(),TempDamage,TempDamageType,TempDamageMode)
endfunction
function DamageGroup takes unit whichUnit,real amount,integer damageType,integer damageMode returns nothing
set TempSource=whichUnit
set TempDamage=amount
set TempDamageType=damageType
set TempDamageMode=damageMode
call ForGroup(TempGroup,function DamageGroupUnits)
endfunction
function CastToForEach takes nothing returns nothing
call CastToTarget(TempSource,GetEnumUnit(),TempAbilityId,TempAbilityLevel,TempString)
endfunction
function CastToGroup takes unit caster,integer abilityId,integer abilityLevel,string abilityOrder returns nothing
set TempSource=caster
set TempAbilityId=abilityId
set TempAbilityLevel=abilityLevel
set TempString=abilityOrder
call ForGroup(TempGroup,function CastToForEach)
endfunction
function BASE_SPELL_FILTER_COND takes nothing returns boolean
set FilterUnit=GetFilterUnit()
return GetWidgetLife(FilterUnit)>.405 and not IsUnitType(FilterUnit,UNIT_TYPE_STRUCTURE) and IsUnitEnemy(FilterUnit,GetOwningPlayer(TempSource))
endfunction
function BaseFilter takes unit caster returns boolexpr
set TempSource=caster
return Filter(function BASE_SPELL_FILTER_COND)
endfunction
function SortEnemiesInRange takes unit caster,real targetX,real targetY,real radius returns nothing
call GroupClear(TempGroup)
call GroupEnumUnitsInRange(TempGroup,targetX,targetY,radius,BaseFilter(caster))
endfunction
function SetUnitCustomPropertyValue takes unit target,string property,real value returns nothing
call SaveReal(Hash,GetHandleId(target),StringHash(property),value)
endfunction
function GetUnitCustomPropertyValue takes unit target,string property returns real
return LoadReal(Hash,GetHandleId(target),StringHash(property))
endfunction
function BvORapierZoneSilenced takes unit rapierZoneHero returns boolean
return rapierZoneHero!=null and oo!=null and GetWidgetLife(rapierZoneHero)>.405 and IsUnitType(rapierZoneHero,UNIT_TYPE_HERO) and RectContainsUnit(oo,rapierZoneHero)
endfunction
function BvORapierZoneCancelRestoration takes unit rapierZoneHero returns nothing
if Bh==rapierZoneHero then
call DestroyEffect(P[410])
set P[410]=null
set Bh=null
endif
if Mk==rapierZoneHero then
call DestroyEffect(Nk)
set Nk=null
set Mk=null
endif
endfunction
function BvORapierZoneRelease takes unit rapierZoneHero returns nothing
if BvORapierZoneHeroes!=null then
call GroupRemoveUnit(BvORapierZoneHeroes,rapierZoneHero)
endif
call UnitRemoveAbility(rapierZoneHero,'B02N')
endfunction
function BvORapierZoneEnforce takes unit rapierZoneHero returns nothing
local unit rapierSilenceDummy
if not BvORapierZoneSilenced(rapierZoneHero) then
return
endif
call BvORapierZoneCancelRestoration(rapierZoneHero)
if BvORapierZoneHeroes!=null then
call GroupAddUnit(BvORapierZoneHeroes,rapierZoneHero)
endif
if GetUnitAbilityLevel(rapierZoneHero,'B02N')==0 then
set rapierSilenceDummy=CreateUnit(Player(12),'u002',GetUnitX(rapierZoneHero),GetUnitY(rapierZoneHero),0.)
call UnitAddAbility(rapierSilenceDummy,'A0D1')
call IssueTargetOrderById(rapierSilenceDummy,852592,rapierZoneHero)
call UnitApplyTimedLife(rapierSilenceDummy,'BTLF',1.)
endif
set rapierSilenceDummy=null
endfunction
function BvORapierZoneTick takes nothing returns nothing
local group rapierZoneScan=CreateGroup()
local unit rapierZoneHero
call GroupAddGroup(BvORapierZoneHeroes,rapierZoneScan)
loop
set rapierZoneHero=FirstOfGroup(rapierZoneScan)
exitwhen rapierZoneHero==null
call GroupRemoveUnit(rapierZoneScan,rapierZoneHero)
if not BvORapierZoneSilenced(rapierZoneHero) then
call BvORapierZoneRelease(rapierZoneHero)
endif
endloop
call GroupEnumUnitsInRect(rapierZoneScan,oo,null)
loop
set rapierZoneHero=FirstOfGroup(rapierZoneScan)
exitwhen rapierZoneHero==null
call GroupRemoveUnit(rapierZoneScan,rapierZoneHero)
if BvORapierZoneSilenced(rapierZoneHero) then
call BvORapierZoneEnforce(rapierZoneHero)
endif
endloop
call DestroyGroup(rapierZoneScan)
set rapierZoneScan=null
set rapierZoneHero=null
endfunction
function BvORapierZoneOnDeath takes nothing returns nothing
local unit rapierDyingHero=GetDyingUnit()
if IsUnitType(rapierDyingHero,UNIT_TYPE_HERO) then
call BvORapierZoneCancelRestoration(rapierDyingHero)
call BvORapierZoneRelease(rapierDyingHero)
endif
set rapierDyingHero=null
endfunction
function BvORapierZoneInit takes nothing returns nothing
local trigger rapierZoneDeathTrigger
if BvORapierZoneHeroes!=null then
return
endif
set BvORapierZoneHeroes=CreateGroup()
call TimerStart(CreateTimer(),.25,true,function BvORapierZoneTick)
set rapierZoneDeathTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(rapierZoneDeathTrigger,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(rapierZoneDeathTrigger,function BvORapierZoneOnDeath)
set rapierZoneDeathTrigger=null
endfunction
function SilenceConditions takes unit caster returns boolean
return not PNChibakuIsHeld(caster) and not BvORapierZoneSilenced(caster) and not InoueTContainsTarget(caster) and GetUnitAbilityLevel(caster,$42303259)==0 and GetUnitAbilityLevel(caster,$4230325A)==0
endfunction
function FilterDestruct takes nothing returns nothing
call KillDestructable(GetEnumDestructable())
endfunction
function DestroyDestructable takes real VG,location WG returns nothing
local rect r
if VG>=0 then
set HG=GetLocationX(WG)
set IG=GetLocationY(WG)
set bj_enumDestructableRadius=VG*VG
set r=Rect(HG-VG,IG-VG,HG+VG,IG+VG)
call EnumDestructablesInRect(r,filterEnumDestructablesInCircleBJ,function FilterDestruct)
call RemoveRect(r)
set r=null
endif
call RemoveLocation(WG)
endfunction
function DwSH takes string property returns integer
return StringHash(I2S(CurrentDummywave)+property)
endfunction
function DwSH_EX takes string property returns integer
return StringHash(I2S(DummywaveCount)+property)
endfunction
function RemoveDummywave takes integer currentDummywave returns nothing
local integer timerId=GetHandleId(DummywaveTimer)
if LoadStr(Hash,timerId,DwSH("finishEffect"))!="" then
call DestroyEffect(AddSpecialEffect(LoadStr(Hash,timerId,DwSH("finishEffect")),GetUnitX(LoadUnitHandle(Hash,timerId,DwSH("dummywave"))),GetUnitY(LoadUnitHandle(Hash,timerId,DwSH("dummywave")))))
endif
if LoadBoolean(Hash,timerId,DwSH("removeFlag")) then
call RemoveUnit(LoadUnitHandle(Hash,timerId,DwSH("dummywave")))
else
call KillUnit(LoadUnitHandle(Hash,timerId,DwSH("dummywave")))
endif
call DestroyGroup(LoadGroupHandle(Hash,timerId,DwSH("damagedGroup")))
if DummywaveCount-1==0 then
call FlushChildHashtable(Hash,timerId)
call PauseTimer(DummywaveTimer)
else
call SaveUnitHandle(Hash,timerId,DwSH("dummywave"),LoadUnitHandle(Hash,timerId,DwSH_EX("dummywave")))
call SaveUnitHandle(Hash,timerId,DwSH("caster"),LoadUnitHandle(Hash,timerId,DwSH_EX("caster")))
call SaveReal(Hash,timerId,DwSH("speed"),LoadReal(Hash,timerId,DwSH_EX("speed")))
call SaveReal(Hash,timerId,DwSH("maxDistance"),LoadReal(Hash,timerId,DwSH_EX("maxDistance")))
call SaveReal(Hash,timerId,DwSH("angle"),LoadReal(Hash,timerId,DwSH_EX("angle")))
call SaveReal(Hash,timerId,DwSH("damage"),LoadReal(Hash,timerId,DwSH_EX("damage")))
call SaveInteger(Hash,timerId,DwSH("damageType"),LoadInteger(Hash,timerId,DwSH_EX("damageType")))
call SaveInteger(Hash,timerId,DwSH("damageMode"),LoadInteger(Hash,timerId,DwSH_EX("damageMode")))
call SaveReal(Hash,timerId,DwSH("damageAoE"),LoadReal(Hash,timerId,DwSH_EX("damageAoE")))
call SaveGroupHandle(Hash,timerId,DwSH("damagedGroup"),LoadGroupHandle(Hash,timerId,DwSH_EX("damagedGroup")))
call SaveBoolean(Hash,timerId,DwSH("destoyDestrFlag"),LoadBoolean(Hash,timerId,DwSH_EX("destoyDestrFlag")))
call SaveStr(Hash,timerId,DwSH("moveEffect"),LoadStr(Hash,timerId,DwSH_EX("moveEffect")))
call SaveStr(Hash,timerId,DwSH("damageEffect"),LoadStr(Hash,timerId,DwSH_EX("damageEffect")))
call SaveStr(Hash,timerId,DwSH("finishEffect"),LoadStr(Hash,timerId,DwSH_EX("finishEffect")))
call SaveStr(Hash,timerId,DwSH("damageActionFuncName"),LoadStr(Hash,timerId,DwSH_EX("damageActionFuncName")))
call SaveBoolean(Hash,timerId,DwSH("removeFlag"),LoadBoolean(Hash,timerId,DwSH_EX("removeFlag")))
endif
set DummywaveCount=DummywaveCount-1
endfunction
function DummywaveActions takes nothing returns nothing
local integer timerId=GetHandleId(DummywaveTimer)
local unit dummywave
local unit caster
local real damage
local real damageAoE
local real speed
local real angle
local real maxDistance
local group damagedGroup
local integer damageType
local integer damageMode
local unit actionUnit
local group actionGroup
local real newX
local real newY
local integer index=0
loop
set index=index+1
exitwhen index>DummywaveCount or DummywaveCount==0
set CurrentDummywave=index
set dummywave=LoadUnitHandle(Hash,timerId,DwSH("dummywave"))
set caster=LoadUnitHandle(Hash,timerId,DwSH("caster"))
set damage=LoadReal(Hash,timerId,DwSH("damage"))
set damageAoE=LoadReal(Hash,timerId,DwSH("damageAoE"))
set speed=LoadReal(Hash,timerId,DwSH("speed"))*.03
set angle=LoadReal(Hash,timerId,DwSH("angle"))
set maxDistance=LoadReal(Hash,timerId,DwSH("maxDistance"))-speed
set damagedGroup=LoadGroupHandle(Hash,timerId,DwSH("damagedGroup"))
set damageType=LoadInteger(Hash,timerId,DwSH("damageType"))
set damageMode=LoadInteger(Hash,timerId,DwSH("damageMode"))
set newX=GetUnitX(dummywave)+speed*Cos(angle*bj_DEGTORAD)
set newY=GetUnitY(dummywave)+speed*Sin(angle*bj_DEGTORAD)
if GetWidgetLife(dummywave)>.405 and maxDistance>0 and not IsTerrainPathable(newX,newY,PATHING_TYPE_FLYABILITY) then
call SetUnitX(dummywave,newX)
call SetUnitY(dummywave,newY)
call SaveReal(Hash,timerId,DwSH("maxDistance"),maxDistance)
if LoadStr(Hash,timerId,DwSH("moveEffect"))!="" then
call DestroyEffect(AddSpecialEffect(LoadStr(Hash,timerId,DwSH("moveEffect")),newX,newY))
endif
if damage>0 and damageAoE>0 then
set actionGroup=CreateGroup()
call GroupEnumUnitsInRange(actionGroup,newX,newY,damageAoE,null)
loop
set actionUnit=FirstOfGroup(actionGroup)
exitwhen actionUnit==null
if not IsUnitInGroup(actionUnit,damagedGroup) and GetWidgetLife(actionUnit)>.405 and not IsUnitType(actionUnit,UNIT_TYPE_STRUCTURE) and IsUnitEnemy(actionUnit,GetOwningPlayer(caster)) then
call DamageUnit(caster,actionUnit,damage,damageType,damageMode)
if LoadStr(Hash,timerId,DwSH("damageEffect"))!="" then
call DestroyEffect(AddSpecialEffectTarget(LoadStr(Hash,timerId,DwSH("damageEffect")),actionUnit,"chest"))
endif
if LoadStr(Hash,timerId,DwSH("damageActionFuncName"))!="" then
set Target=actionUnit
set Source=caster
set Damage=damage
call ExecuteFunc(LoadStr(Hash,timerId,DwSH("damageActionFuncName")))
endif
endif
call GroupAddUnit(damagedGroup,actionUnit)
call GroupRemoveUnit(actionGroup,actionUnit)
endloop
call DestroyGroup(actionGroup)
if LoadBoolean(Hash,timerId,DwSH("destoyDestrFlag")) then
call DestroyDestructable(damageAoE,Location(newX,newY))
endif
endif
else
call RemoveDummywave(CurrentDummywave)
set index=index-1
endif
endloop
set dummywave=null
set damagedGroup=null
set actionUnit=null
set actionGroup=null
endfunction
function SetDummywaveVertexColor takes integer dummywave,real colRed,real colGreen,real colBlue,real transp returns nothing
set CurrentDummywave=dummywave
call SetUnitVertexColorBJ(LoadUnitHandle(Hash,GetHandleId(DummywaveTimer),DwSH("dummywave")),colRed,colGreen,colBlue,transp)
endfunction
function SetDummywaveSize takes integer dummywave,real size returns nothing
set CurrentDummywave=dummywave
call SetUnitScalePercent(LoadUnitHandle(Hash,GetHandleId(DummywaveTimer),DwSH("dummywave")),size,size,size)
endfunction
function SetDummywaveMoveSettings takes integer dummywave,real speed,real maxDistance,real angle returns nothing
set CurrentDummywave=dummywave
call SaveReal(Hash,GetHandleId(DummywaveTimer),DwSH("speed"),speed)
call SaveReal(Hash,GetHandleId(DummywaveTimer),DwSH("maxDistance"),maxDistance)
call SaveReal(Hash,GetHandleId(DummywaveTimer),DwSH("angle"),angle)
endfunction
function SetDummywaveRemove takes integer dummywave,boolean removeFlag returns nothing
set CurrentDummywave=dummywave
call SaveBoolean(Hash,GetHandleId(DummywaveTimer),DwSH("removeFlag"),removeFlag)
endfunction
function SetDummywaveDamage takes integer dummywave,real damage,real damageAoE,integer damageType,integer damageMode,boolean destoyDestrFlag returns nothing
set CurrentDummywave=dummywave
call SaveReal(Hash,GetHandleId(DummywaveTimer),DwSH("damage"),damage)
call SaveInteger(Hash,GetHandleId(DummywaveTimer),DwSH("damageType"),damageType)
call SaveInteger(Hash,GetHandleId(DummywaveTimer),DwSH("damageMode"),damageMode)
call SaveReal(Hash,GetHandleId(DummywaveTimer),DwSH("damageAoE"),damageAoE)
call SaveGroupHandle(Hash,GetHandleId(DummywaveTimer),DwSH("damagedGroup"),CreateGroup())
call SaveBoolean(Hash,GetHandleId(DummywaveTimer),DwSH("destoyDestrFlag"),destoyDestrFlag)
endfunction
function SetDummywaveEffect takes integer dummywave,string moveEffect,string damageEffect,string finishEffect returns nothing
set CurrentDummywave=dummywave
call SaveStr(Hash,GetHandleId(DummywaveTimer),DwSH("moveEffect"),moveEffect)
call SaveStr(Hash,GetHandleId(DummywaveTimer),DwSH("damageEffect"),damageEffect)
call SaveStr(Hash,GetHandleId(DummywaveTimer),DwSH("finishEffect"),finishEffect)
endfunction
function SetDummywaveAdditionalFunctionAfterDamage takes integer dummywave,string funcName returns nothing
set CurrentDummywave=dummywave
call SaveStr(Hash,GetHandleId(DummywaveTimer),DwSH("damageActionFuncName"),funcName)
endfunction
function GetDummywave takes integer dummywave returns unit
set CurrentDummywave=dummywave
return LoadUnitHandle(Hash,GetHandleId(DummywaveTimer),DwSH("dummywave"))
endfunction
function Dummywave takes unit caster,integer dummyId,real dummyX,real dummyY,real dummyZ,real angle returns nothing
local integer timerId=GetHandleId(DummywaveTimer)
local unit dummywave=CreateUnit(GetOwningPlayer(caster),dummyId,dummyX,dummyY,angle)
set DummywaveCount=DummywaveCount+1
set CurrentDummywave=DummywaveCount
call SaveUnitHandle(Hash,timerId,DwSH("dummywave"),dummywave)
call SaveUnitHandle(Hash,timerId,DwSH("caster"),caster)
call SaveBoolean(Hash,timerId,DwSH("removeFlag"),false)
call SaveStr(Hash,timerId,DwSH("damageActionFuncName"),"")
call SetUnitFlyHeight(dummywave,dummyZ,0)
call SetUnitPathing(dummywave,false)
call SetDummywaveEffect(CurrentDummywave,"","","")
if DummywaveCount==1 then
call TimerStart(DummywaveTimer,.03,true,function DummywaveActions)
endif
set LastCreatedDummywave=CurrentDummywave
set dummywave=null
endfunction
function AngleBetween takes real x0,real y0,real x1,real y1 returns real
return bj_RADTODEG*Atan2(y1-y0,x1-x0)
endfunction
function DistanceBetween takes real x0,real y0,real x1,real y1 returns real
return SquareRoot((x0-x1)*(x0-x1)+(y0-y1)*(y0-y1))
endfunction
function GetCastAngle takes unit caster,real targetX,real targetY returns real
if GetUnitX(caster)==targetX and GetUnitY(caster)==targetY then
return GetUnitFacing(caster)
endif
return AngleBetween(GetUnitX(caster),GetUnitY(caster),targetX,targetY)
endfunction
function GetPolarOffsetX takes real targetX,real distance,real angle returns real
return targetX+distance*Cos(angle*bj_DEGTORAD)
endfunction
function GetPolarOffsetY takes real targetY,real distance,real angle returns real
return targetY+distance*Sin(angle*bj_DEGTORAD)
endfunction
function DummyMissileTargetActions takes nothing returns nothing
local timer spellTimer=GetExpiredTimer()
local integer timerId=GetHandleId(spellTimer)
local unit dummyMissile=L_U(timerId,"dummyMissile")
local real speed=L_R(timerId,"speed")
local real collisionDistance=L_R(timerId,"collisionDistance")
local real breakingDistance=L_R(timerId,"breakingDistance")
local unit target=L_U(timerId,"target")
local real angle
local real newX
local real newY
local real distance=DistanceBetween(GetUnitX(dummyMissile),GetUnitY(dummyMissile),GetUnitX(target),GetUnitY(target))
if target!=null and GetUnitTypeId(target)>0 and GetWidgetLife(dummyMissile)>.405 and distance<breakingDistance then
set angle=AngleBetween(GetUnitX(dummyMissile),GetUnitY(dummyMissile),GetUnitX(target),GetUnitY(target))
set newX=GetUnitX(dummyMissile)+speed*Cos(angle*bj_DEGTORAD)
set newY=GetUnitY(dummyMissile)+speed*Sin(angle*bj_DEGTORAD)
call SetUnitX(dummyMissile,newX)
call SetUnitY(dummyMissile,newY)
call SetUnitFacing(dummyMissile,angle)
set distance=DistanceBetween(GetUnitX(dummyMissile),GetUnitY(dummyMissile),GetUnitX(target),GetUnitY(target))
if distance<=collisionDistance then
if L_S(timerId,"funcName")!="" then
set DummyMissile=dummyMissile
set DummyMissileTarget=target
set DummyMissileCaster=L_U(timerId,"caster")
call ExecuteFunc(L_S(timerId,"funcName"))
else
set DummyMissileCaster=null
set DummyMissile=null
set DummyMissileTarget=null
endif
call FlushChildHashtable(Hash,timerId)
call FlushChildHashtable(Hash,GetHandleId(dummyMissile))
call KillUnit(dummyMissile)
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endif
else
call FlushChildHashtable(Hash,timerId)
call FlushChildHashtable(Hash,GetHandleId(dummyMissile))
call KillUnit(dummyMissile)
call PauseTimer(spellTimer)
call DestroyTimer(spellTimer)
endif
set spellTimer=null
set dummyMissile=null
endfunction
function SetDummyMissileTarget takes unit dummyMissile,unit target returns nothing
call S_U(GetHandleId(L_T(GetHandleId(dummyMissile),"spellTimer")),"target",target)
call PauseTimer(L_T(GetHandleId(dummyMissile),"spellTimer"))
call TimerStart(L_T(GetHandleId(dummyMissile),"spellTimer"),.02,true,function DummyMissileTargetActions)
endfunction
function SetDummyMissileCollisionActions takes unit dummyMissile,string funcName returns nothing
call S_S(GetHandleId(L_T(GetHandleId(dummyMissile),"spellTimer")),"funcName",funcName)
endfunction
function SetDummyMissileMoveSettings takes unit dummyMissile,real speed,real breakingDistance returns nothing
call S_R(GetHandleId(L_T(GetHandleId(dummyMissile),"spellTimer")),"speed",speed*.02)
call S_R(GetHandleId(L_T(GetHandleId(dummyMissile),"spellTimer")),"collisionDistance",speed*.02*1.5)
call S_R(GetHandleId(L_T(GetHandleId(dummyMissile),"spellTimer")),"breakingDistance",breakingDistance)
endfunction
function CreateDummyMissile takes unit caster,integer dummyId,real dummyX,real dummyY,real dummyZ,real angle returns nothing
local timer spellTimer=CreateTimer()
set LastCreatedDummyMissile=CreateUnit(GetOwningPlayer(caster),dummyId,dummyX,dummyY,angle)
call SetUnitFlyHeight(LastCreatedDummyMissile,dummyZ,0)
call S_T(GetHandleId(LastCreatedDummyMissile),"spellTimer",spellTimer)
call S_U(GetHandleId(L_T(GetHandleId(LastCreatedDummyMissile),"spellTimer")),"dummyMissile",LastCreatedDummyMissile)
call S_U(GetHandleId(L_T(GetHandleId(LastCreatedDummyMissile),"spellTimer")),"caster",caster)
call SetDummyMissileCollisionActions(LastCreatedDummyMissile,"")
set spellTimer=null
endfunction
function RBCleanupTimer takes nothing returns nothing
local timer rbLocal1_t=GetExpiredTimer()
local unit rbLocal1_u=LoadUnitHandle(RBDummyReg,GetHandleId(rbLocal1_t),0)
call FlushChildHashtable(RBDummyReg,GetHandleId(rbLocal1_u))
call FlushChildHashtable(RBDummyReg,GetHandleId(rbLocal1_t))
call DestroyTimer(rbLocal1_t)
set rbLocal1_u=null
set rbLocal1_t=null
endfunction
function RBRegisterDummy takes unit rbLocal2_dummy,unit rbLocal2_hero,real rbLocal2_amount,integer rbLocal2_kind returns nothing
local timer rbLocal2_t=CreateTimer()
call SaveUnitHandle(RBDummyReg,GetHandleId(rbLocal2_dummy),0,rbLocal2_hero)
call SaveReal(RBDummyReg,GetHandleId(rbLocal2_dummy),1,rbLocal2_amount)
call SaveInteger(RBDummyReg,GetHandleId(rbLocal2_dummy),2,rbLocal2_kind)
call SaveInteger(RBDummyReg,GetHandleId(rbLocal2_dummy),3,GetPlayerId(GetOwningPlayer(rbLocal2_dummy))+1)
call SaveInteger(RBDummyReg,GetHandleId(rbLocal2_dummy),4,GetUnitTypeId(rbLocal2_dummy))
call SaveUnitHandle(RBDummyReg,GetHandleId(rbLocal2_t),0,rbLocal2_dummy)
call TimerStart(rbLocal2_t,10.,false,function RBCleanupTimer)
set rbLocal2_t=null
endfunction
function RBEnemy takes unit rbLocal3_caster,unit rbLocal3_target returns boolean
return rbLocal3_target!=null and GetWidgetLife(rbLocal3_target)>.405 and IsUnitEnemy(rbLocal3_target,GetOwningPlayer(rbLocal3_caster)) and not IsUnitType(rbLocal3_target,UNIT_TYPE_STRUCTURE) and GetUnitAbilityLevel(rbLocal3_target,'Aloc')==0
endfunction
function RBAreaDamage takes unit rbLocal4_caster,real rbLocal4_x,real rbLocal4_y,real rbLocal4_radius,real rbLocal4_amount,integer rbLocal4_kind returns nothing
local group rbLocal4_g=CreateGroup()
local unit rbLocal4_u
call GroupEnumUnitsInRange(rbLocal4_g,rbLocal4_x,rbLocal4_y,rbLocal4_radius,null)
loop
set rbLocal4_u=FirstOfGroup(rbLocal4_g)
exitwhen rbLocal4_u==null
call GroupRemoveUnit(rbLocal4_g,rbLocal4_u)
if RBEnemy(rbLocal4_caster,rbLocal4_u) then
call DamageUnit(rbLocal4_caster,rbLocal4_u,rbLocal4_amount,rbLocal4_kind,SPELL)
endif
endloop
call DestroyGroup(rbLocal4_g)
set rbLocal4_g=null
set rbLocal4_u=null
endfunction
function RBDoTTick takes nothing returns nothing
local timer rbLocal5_t=GetExpiredTimer()
local integer rbLocal5_k=GetHandleId(rbLocal5_t)
local unit rbLocal5_caster=LoadUnitHandle(RBState,rbLocal5_k,0)
local unit rbLocal5_target=LoadUnitHandle(RBState,rbLocal5_k,1)
local integer rbLocal5_left=LoadInteger(RBState,rbLocal5_k,2)
if GetWidgetLife(rbLocal5_target)>.405 and GetUnitTypeId(rbLocal5_caster)!=0 then
call DamageUnit(rbLocal5_caster,rbLocal5_target,LoadReal(RBState,rbLocal5_k,3),LoadInteger(RBState,rbLocal5_k,4),SPELL)
endif
set rbLocal5_left=rbLocal5_left-1
if rbLocal5_left<=0 or GetWidgetLife(rbLocal5_target)<=.405 or GetUnitTypeId(rbLocal5_caster)==0 then
if HaveSavedHandle(RBState,rbLocal5_k,5) then
call DestroyEffect(LoadEffectHandle(RBState,rbLocal5_k,5))
endif
call FlushChildHashtable(RBState,rbLocal5_k)
call DestroyTimer(rbLocal5_t)
else
call SaveInteger(RBState,rbLocal5_k,2,rbLocal5_left)
endif
set rbLocal5_caster=null
set rbLocal5_target=null
set rbLocal5_t=null
endfunction
function RBDoT takes unit rbLocal6_caster,unit rbLocal6_target,real rbLocal6_damage,integer rbLocal6_kind,real rbLocal6_interval,integer rbLocal6_count returns nothing
local timer rbLocal6_t=CreateTimer()
local integer rbLocal6_k=GetHandleId(rbLocal6_t)
call SaveUnitHandle(RBState,rbLocal6_k,0,rbLocal6_caster)
call SaveUnitHandle(RBState,rbLocal6_k,1,rbLocal6_target)
call SaveInteger(RBState,rbLocal6_k,2,rbLocal6_count)
call SaveReal(RBState,rbLocal6_k,3,rbLocal6_damage)
call SaveInteger(RBState,rbLocal6_k,4,rbLocal6_kind)
call TimerStart(rbLocal6_t,rbLocal6_interval,true,function RBDoTTick)
set rbLocal6_t=null
endfunction
// the same damage over time with a burning effect on the target for its whole duration (Ace Q and V)
function RBDoTBurn takes unit burnCaster,unit burnTarget,real burnDamage,integer burnKind,real burnInterval,integer burnCount returns nothing
local timer burnTimer=CreateTimer()
local integer burnKey=GetHandleId(burnTimer)
call SaveUnitHandle(RBState,burnKey,0,burnCaster)
call SaveUnitHandle(RBState,burnKey,1,burnTarget)
call SaveInteger(RBState,burnKey,2,burnCount)
call SaveReal(RBState,burnKey,3,burnDamage)
call SaveInteger(RBState,burnKey,4,burnKind)
call SaveEffectHandle(RBState,burnKey,5,AddSpecialEffectTarget("Abilities\\Spells\\Other\\BreathOfFire\\BreathOfFireDamage.mdl",burnTarget,"chest"))
call TimerStart(burnTimer,burnInterval,true,function RBDoTTick)
set burnTimer=null
endfunction
function AceVCooldownIcon takes integer left returns integer
if left==1 then
return 'RAV1'
elseif left==2 then
return 'RAV2'
elseif left==3 then
return 'RAV3'
elseif left==4 then
return 'RAV4'
elseif left==5 then
return 'RAV5'
elseif left==6 then
return 'RAV6'
elseif left==7 then
return 'RAV7'
endif
return 'RAV8'
endfunction
// Fire Skin (V) of Ace: a visible cooldown. The passive button is replaced by a darkened copy with the seconds left
// (RAV8 ... RAV1, one per second), then the normal button comes back.
function AceVCooldownTick takes nothing returns nothing
local timer cdTimer=GetExpiredTimer()
local unit aceUnit=LoadUnitHandle(RBState,GetHandleId(cdTimer),0)
// the cooldown is over: the clickable copy goes away and the passive button comes back (like Bone Crusher)
call UnitRemoveAbility(aceUnit,'RAVC')
if GetUnitTypeId(aceUnit)=='N005' then
call UnitAddAbility(aceUnit,'RAVP')
endif
call FlushChildHashtable(RBState,GetHandleId(cdTimer))
call DestroyTimer(cdTimer)
set cdTimer=null
set aceUnit=null
endfunction
function AceVShowCooldown takes unit aceUnit returns nothing
local timer cdTimer=CreateTimer()
// Fire Skin is a passive (RAVP). When it fires, the button is swapped for RAVC (an empty Berserk) that is cast at
// once, so the normal cooldown of the game is shown; it exists only while it is recharging and can not be used
call UnitRemoveAbility(aceUnit,'RAVP')
call UnitAddAbility(aceUnit,'RAVC')
call SaveReal(RBState,GetHandleId(aceUnit),183,TimerGetElapsed(AYClock)+.5)
call IssueImmediateOrder(aceUnit,"berserk")
call SaveUnitHandle(RBState,GetHandleId(cdTimer),0,aceUnit)
call TimerStart(cdTimer,7.95,false,function AceVCooldownTick)
set cdTimer=null
endfunction
// Passives with an inner cooldown (Sado W block, Yamamoto Q): while the inner cooldown runs the passive button is hidden
// and a copy (Divine Shield base with zero effect, cast at once) shows the normal cooldown of the game on the icon
function BvOPassiveCdEnd takes nothing returns nothing
local timer pcdTimer=GetExpiredTimer()
local integer pcdKey=GetHandleId(pcdTimer)
local unit pcdUnit=LoadUnitHandle(RBState,pcdKey,0)
call UnitRemoveAbility(pcdUnit,LoadInteger(RBState,pcdKey,2))
if not BvOPassivesBroken(pcdUnit) then
call SetPlayerAbilityAvailable(GetOwningPlayer(pcdUnit),LoadInteger(RBState,pcdKey,1),true)
endif
call FlushChildHashtable(RBState,pcdKey)
call DestroyTimer(pcdTimer)
set pcdTimer=null
set pcdUnit=null
endfunction
// Chad W: its separate learner SDL0 remains available while the runtime passive is hidden.
// UI casts run after damage processing and wait for real spell casts/morphs to end.
// Preserve player movement/attack orders through cooldown UI updates and Ichigo's form swap.
function BvOKeepOrder takes integer orderId returns boolean
return orderId==OrderId("move") or orderId==OrderId("attack") or orderId==OrderId("smart") or orderId==OrderId("patrol") or orderId==OrderId("holdposition") or orderId==OrderId("stop") or orderId==OrderId("attackground")
endfunction
function BvOOrderTrack takes nothing returns boolean
local unit hero=GetOrderedUnit()
local integer key=GetHandleId(hero)
local integer ownerId=GetPlayerId(GetOwningPlayer(hero))
local integer orderId=GetIssuedOrderId()
local integer kind=0
if ownerId<12 and hero==m[ownerId+1] and not LoadBoolean(RBState,key,StringHash("InternalOrder")) and BvOKeepOrder(orderId) then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER then
set kind=2
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER then
set kind=1
endif
call SaveInteger(RBState,key,StringHash("SavedOrder"),orderId)
call SaveInteger(RBState,key,StringHash("SavedOrderKind"),kind)
call SaveReal(RBState,key,StringHash("SavedOrderX"),GetOrderPointX())
call SaveReal(RBState,key,StringHash("SavedOrderY"),GetOrderPointY())
call SaveUnitHandle(RBState,key,StringHash("SavedOrderUnit"),GetOrderTargetUnit())
call SaveItemHandle(RBState,key,StringHash("SavedOrderItem"),GetOrderTargetItem())
call SaveDestructableHandle(RBState,key,StringHash("SavedOrderDest"),GetOrderTargetDestructable())
endif
set hero=null
return false
endfunction
function BvOCopyOrder takes unit hero,integer key returns nothing
local integer sourceKey=GetHandleId(hero)
local integer orderId=GetUnitCurrentOrder(hero)
call SaveInteger(RBState,key,StringHash("SavedOrder"),0)
if BvOKeepOrder(orderId) and LoadInteger(RBState,sourceKey,StringHash("SavedOrder"))==orderId then
call SaveInteger(RBState,key,StringHash("SavedOrder"),orderId)
call SaveInteger(RBState,key,StringHash("SavedOrderKind"),LoadInteger(RBState,sourceKey,StringHash("SavedOrderKind")))
call SaveReal(RBState,key,StringHash("SavedOrderX"),LoadReal(RBState,sourceKey,StringHash("SavedOrderX")))
call SaveReal(RBState,key,StringHash("SavedOrderY"),LoadReal(RBState,sourceKey,StringHash("SavedOrderY")))
call SaveUnitHandle(RBState,key,StringHash("SavedOrderUnit"),LoadUnitHandle(RBState,sourceKey,StringHash("SavedOrderUnit")))
call SaveItemHandle(RBState,key,StringHash("SavedOrderItem"),LoadItemHandle(RBState,sourceKey,StringHash("SavedOrderItem")))
call SaveDestructableHandle(RBState,key,StringHash("SavedOrderDest"),LoadDestructableHandle(RBState,sourceKey,StringHash("SavedOrderDest")))
endif
endfunction
function BvOReplayOrder takes unit hero,integer key returns nothing
local integer orderId=LoadInteger(RBState,key,StringHash("SavedOrder"))
local integer kind=LoadInteger(RBState,key,StringHash("SavedOrderKind"))
local unit targetUnit=LoadUnitHandle(RBState,key,StringHash("SavedOrderUnit"))
local item targetItem=LoadItemHandle(RBState,key,StringHash("SavedOrderItem"))
local destructable targetDest=LoadDestructableHandle(RBState,key,StringHash("SavedOrderDest"))
if orderId!=0 and GetUnitTypeId(hero)!=0 and GetWidgetLife(hero)>.405 and not IsUnitPaused(hero) then
if kind==2 then
if targetUnit!=null and GetUnitTypeId(targetUnit)!=0 then
call IssueTargetOrderById(hero,orderId,targetUnit)
elseif targetItem!=null and GetItemTypeId(targetItem)!=0 then
call IssueTargetOrderById(hero,orderId,targetItem)
elseif targetDest!=null then
call IssueTargetOrderById(hero,orderId,targetDest)
endif
elseif kind==1 then
call IssuePointOrderById(hero,orderId,LoadReal(RBState,key,StringHash("SavedOrderX")),LoadReal(RBState,key,StringHash("SavedOrderY")))
else
call IssueImmediateOrderById(hero,orderId)
endif
endif
set targetUnit=null
set targetItem=null
set targetDest=null
endfunction
function BvOTransferOrderTick takes nothing returns nothing
local timer orderTimer=GetExpiredTimer()
local integer key=GetHandleId(orderTimer)
local unit hero=LoadUnitHandle(RBState,key,0)
if GetUnitCurrentOrder(hero)==0 or GetUnitCurrentOrder(hero)==OrderId("stop") then
call SaveBoolean(RBState,GetHandleId(hero),StringHash("InternalOrder"),true)
call BvOReplayOrder(hero,key)
call SaveBoolean(RBState,GetHandleId(hero),StringHash("InternalOrder"),false)
endif
call FlushChildHashtable(RBState,key)
call DestroyTimer(orderTimer)
set orderTimer=null
set hero=null
endfunction
function BvOTransferOrder takes unit oldHero,unit newHero returns nothing
local timer orderTimer=CreateTimer()
call BvOCopyOrder(oldHero,GetHandleId(orderTimer))
call SaveUnitHandle(RBState,GetHandleId(orderTimer),0,newHero)
call TimerStart(orderTimer,0.,false,function BvOTransferOrderTick)
set orderTimer=null
endfunction

// Shield Arm uses a passive countdown only: no orders, spell casts, buffs or command restoration.
function BvOSadoWCooldownTick takes nothing returns nothing
local timer cdTimer=GetExpiredTimer()
local integer timerKey=GetHandleId(cdTimer)
local unit hero=LoadUnitHandle(RBState,timerKey,0)
local integer heroKey=GetHandleId(hero)
local integer rank=GetUnitAbilityLevel(hero,'A03S')
local real remaining=LoadReal(RBState,heroKey,110)-TimerGetElapsed(AYClock)
local integer iconLevel
if GetUnitTypeId(hero)==0 or GetWidgetLife(hero)<=.405 or rank==0 or remaining<=0. then
call UnitRemoveAbility(hero,'SDC0')
if GetUnitTypeId(hero)!=0 and not BvOPassivesBroken(hero) then
call SetPlayerAbilityAvailable(GetOwningPlayer(hero),'A03S',true)
endif
call RemoveSavedHandle(RBState,heroKey,StringHash("SadoWCooldownTimer"))
call FlushChildHashtable(RBState,timerKey)
call PauseTimer(cdTimer)
call DestroyTimer(cdTimer)
else
set iconLevel=R2I(remaining/.05+.999)
if iconLevel<1 then
set iconLevel=1
elseif iconLevel>30 then
set iconLevel=30
endif
if GetUnitAbilityLevel(hero,'SDC0')==0 then
call UnitAddAbility(hero,'SDC0')
call UnitMakeAbilityPermanent(hero,true,'SDC0')
endif
if GetUnitAbilityLevel(hero,'SDC0')!=iconLevel then
call SetUnitAbilityLevel(hero,'SDC0',iconLevel)
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(hero),'A03S',false)
call TimerStart(cdTimer,.05,false,function BvOSadoWCooldownTick)
endif
set hero=null
set cdTimer=null
endfunction
function BvOSadoWCooldownQueue takes unit hero returns nothing
local timer cdTimer
local integer heroKey=GetHandleId(hero)
if LoadTimerHandle(RBState,heroKey,StringHash("SadoWCooldownTimer"))!=null then
return
endif
set cdTimer=CreateTimer()
call SaveTimerHandle(RBState,heroKey,StringHash("SadoWCooldownTimer"),cdTimer)
call SaveUnitHandle(RBState,GetHandleId(cdTimer),0,hero)
call TimerStart(cdTimer,0.,false,function BvOSadoWCooldownTick)
set cdTimer=null
endfunction

function BvOSadoWUiInit takes nothing returns nothing
local trigger orderState=CreateTrigger()
// This tracker is retained for Ichigo's form-return command transfer, not for Chad's passive.
call TriggerRegisterAnyUnitEventBJ(orderState,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call TriggerRegisterAnyUnitEventBJ(orderState,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterAnyUnitEventBJ(orderState,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(orderState,Condition(function BvOOrderTrack))
set orderState=null
endfunction
function BvOPassiveCdStart takes unit pcdUnit,integer passiveId,integer copyId,real cooldown returns nothing
local timer pcdTimer
if copyId=='SDC0' then
call BvOSadoWCooldownQueue(pcdUnit)
return
endif
if GetUnitAbilityLevel(pcdUnit,copyId)>0 or IsUnitIllusion(pcdUnit) or GetWidgetLife(pcdUnit)<=.405 then
return
endif
set pcdTimer=CreateTimer()
call SetPlayerAbilityAvailable(GetOwningPlayer(pcdUnit),passiveId,false)
call UnitAddAbility(pcdUnit,copyId)
call SetUnitAbilityLevel(pcdUnit,copyId,GetUnitAbilityLevel(pcdUnit,passiveId))
call IssueImmediateOrder(pcdUnit,"divineshield")
// only the cooldown icon is wanted: the shield (and its invulnerability) is taken away at once
call UnitRemoveAbility(pcdUnit,'BAVC')
call UnitRemoveAbility(pcdUnit,'BHds')
call SaveUnitHandle(RBState,GetHandleId(pcdTimer),0,pcdUnit)
call SaveInteger(RBState,GetHandleId(pcdTimer),1,passiveId)
call SaveInteger(RBState,GetHandleId(pcdTimer),2,copyId)
call TimerStart(pcdTimer,cooldown-.05,false,function BvOPassiveCdEnd)
set pcdTimer=null
endfunction
function RBMissReady takes nothing returns nothing
local timer rbLocal7_t=GetExpiredTimer()
local integer rbLocal7_k=GetHandleId(rbLocal7_t)
local unit rbLocal7_caster=LoadUnitHandle(RBState,rbLocal7_k,0)
local integer rbLocal7_aid=LoadInteger(RBState,rbLocal7_k,1)
local integer rbLocal7_level=GetUnitAbilityLevel(rbLocal7_caster,rbLocal7_aid)
if GetUnitTypeId(rbLocal7_caster)!=0 and rbLocal7_level>0 then
call UnitRemoveAbility(rbLocal7_caster,rbLocal7_aid)
call UnitAddAbility(rbLocal7_caster,rbLocal7_aid)
call SetUnitAbilityLevel(rbLocal7_caster,rbLocal7_aid,rbLocal7_level)
endif
call FlushChildHashtable(RBState,rbLocal7_k)
call DestroyTimer(rbLocal7_t)
set rbLocal7_caster=null
set rbLocal7_t=null
endfunction
function RBMissRestoreRank takes nothing returns nothing
local timer rbLocal8_t=GetExpiredTimer()
local integer rbLocal8_k=GetHandleId(rbLocal8_t)
local unit rbLocal8_caster=LoadUnitHandle(RBState,rbLocal8_k,0)
local integer rbLocal8_aid=LoadInteger(RBState,rbLocal8_k,1)
local integer rbLocal8_rank=LoadInteger(RBState,rbLocal8_k,2)
if GetUnitTypeId(rbLocal8_caster)!=0 and GetUnitAbilityLevel(rbLocal8_caster,rbLocal8_aid)==rbLocal8_rank+5 then
call SetUnitAbilityLevel(rbLocal8_caster,rbLocal8_aid,rbLocal8_rank)
endif
call FlushChildHashtable(RBState,rbLocal8_k)
call DestroyTimer(rbLocal8_t)
set rbLocal8_caster=null
set rbLocal8_t=null
endfunction
function RBMiss takes unit rbLocal9_caster,integer rbLocal9_aid,real rbLocal9_delay,real rbLocal9_refund returns nothing
local timer rbLocal9_t=CreateTimer()
local integer rbLocal9_k=GetHandleId(rbLocal9_t)
local integer rbLocal9_rank=GetUnitAbilityLevel(rbLocal9_caster,rbLocal9_aid)
call SetUnitState(rbLocal9_caster,UNIT_STATE_MANA,GetUnitState(rbLocal9_caster,UNIT_STATE_MANA)+rbLocal9_refund)
call SaveUnitHandle(RBState,rbLocal9_k,0,rbLocal9_caster)
call SaveInteger(RBState,rbLocal9_k,1,rbLocal9_aid)
if (rbLocal9_aid=='A0EH' or rbLocal9_aid=='AB0W') and rbLocal9_rank>=1 and rbLocal9_rank<=5 then
call SaveInteger(RBState,rbLocal9_k,2,rbLocal9_rank)
call SetUnitAbilityLevel(rbLocal9_caster,rbLocal9_aid,rbLocal9_rank+5)
call TimerStart(rbLocal9_t,0.,false,function RBMissRestoreRank)
else
call TimerStart(rbLocal9_t,rbLocal9_delay,false,function RBMissReady)
endif
set rbLocal9_t=null
endfunction
function RBChadQ takes unit rbLocal10_u returns real
if GetUnitTypeId(rbLocal10_u)=='H004' then
return (RBValue(GetUnitAbilityLevel(rbLocal10_u,'A03R'),150.0,150.0,175.0,175.0,200.0,200.0)+1.25*GetHeroStr(rbLocal10_u,false)+0.5*GetHeroInt(rbLocal10_u,true))
endif
return (RBValue(GetUnitAbilityLevel(rbLocal10_u,'A03R'),225.0,225.0,250.0,250.0,275.0,275.0)+2.25*GetHeroStr(rbLocal10_u,false)+1.0*GetHeroInt(rbLocal10_u,true))
endfunction
function RBZangQ takes unit rbLocal11_u returns real
if GetUnitTypeId(rbLocal11_u)=='H00I' then
return RBValue(GetUnitAbilityLevel(rbLocal11_u,'A05T'),100.,125.,150.,175.,200.,250.)+1.5*GetHeroStr(rbLocal11_u,false)+GetHeroInt(rbLocal11_u,true)
endif
return (RBValue(GetUnitAbilityLevel(rbLocal11_u,'A05T'),250.,300.,350.,400.,450.,500.)+3.0*GetHeroStr(rbLocal11_u,false)+2.0*GetHeroInt(rbLocal11_u,true))
endfunction
function RBDelayedSlowTick takes nothing returns nothing
local timer rbLocal14_t=GetExpiredTimer()
local integer rbLocal14_k=GetHandleId(rbLocal14_t)
local unit rbLocal14_u=LoadUnitHandle(RBState,rbLocal14_k,0)
local unit rbLocal14_v=LoadUnitHandle(RBState,rbLocal14_k,1)
if GetWidgetLife(rbLocal14_v)>.405 then
call CastToTarget(rbLocal14_u,rbLocal14_v,LoadInteger(RBState,rbLocal14_k,2),1,"cripple")
endif
call FlushChildHashtable(RBState,rbLocal14_k)
call DestroyTimer(rbLocal14_t)
set rbLocal14_t=null
set rbLocal14_u=null
set rbLocal14_v=null
endfunction
function RBDelayedSlow takes unit rbLocal15_u,unit rbLocal15_v,integer rbLocal15_aid,real rbLocal15_delay returns nothing
local timer rbLocal15_t=CreateTimer()
local integer rbLocal15_k=GetHandleId(rbLocal15_t)
call SaveUnitHandle(RBState,rbLocal15_k,0,rbLocal15_u)
call SaveUnitHandle(RBState,rbLocal15_k,1,rbLocal15_v)
call SaveInteger(RBState,rbLocal15_k,2,rbLocal15_aid)
call TimerStart(rbLocal15_t,rbLocal15_delay,false,function RBDelayedSlowTick)
set rbLocal15_t=null
endfunction
function RBSecondGetsuga takes nothing returns nothing
local timer rbLocal16_t=GetExpiredTimer()
local integer rbLocal16_k=GetHandleId(rbLocal16_t)
local unit rbLocal16_u=LoadUnitHandle(RBState,rbLocal16_k,0)
local real rbLocal16_angle=LoadReal(RBState,rbLocal16_k,1)
local real rbLocal16_damage=LoadReal(RBState,rbLocal16_k,2)
local real rbLocal16_x=LoadReal(RBState,rbLocal16_k,3)
local real rbLocal16_y=LoadReal(RBState,rbLocal16_k,4)
local boolean rbLocal16_bankai=LoadBoolean(RBState,rbLocal16_k,5)
local integer rbLocal16_model='u00E'
local real rbLocal16_speed=1500.
local real rbLocal16_distance=800.
if rbLocal16_bankai then
set rbLocal16_model='u00F'
set rbLocal16_speed=1950.
set rbLocal16_distance=1040.
endif
if GetUnitTypeId(rbLocal16_u)!=0 then
call Dummywave(rbLocal16_u,rbLocal16_model,rbLocal16_x,rbLocal16_y,15.,rbLocal16_angle)
call SetDummywaveSize(LastCreatedDummywave,200.)
call SetDummywaveMoveSettings(LastCreatedDummywave,rbLocal16_speed,rbLocal16_distance,rbLocal16_angle)
call SetDummywaveDamage(LastCreatedDummywave,rbLocal16_damage,165.,MAGICAL,SPELL,true)
endif
call FlushChildHashtable(RBState,rbLocal16_k)
call DestroyTimer(rbLocal16_t)
set rbLocal16_t=null
set rbLocal16_u=null
endfunction
function RBQueueGetsuga takes unit rbLocal17_u,real rbLocal17_angle,real rbLocal17_damage,real rbLocal17_x,real rbLocal17_y returns nothing
local timer rbLocal17_t=CreateTimer()
local integer rbLocal17_k=GetHandleId(rbLocal17_t)
call SaveUnitHandle(RBState,rbLocal17_k,0,rbLocal17_u)
call SaveReal(RBState,rbLocal17_k,1,rbLocal17_angle)
call SaveReal(RBState,rbLocal17_k,2,rbLocal17_damage)
call SaveReal(RBState,rbLocal17_k,3,rbLocal17_x)
call SaveReal(RBState,rbLocal17_k,4,rbLocal17_y)
call SaveBoolean(RBState,rbLocal17_k,5,GetUnitTypeId(rbLocal17_u)!='H003')
call TimerStart(rbLocal17_t,.2,false,function RBSecondGetsuga)
set rbLocal17_t=null
endfunction
