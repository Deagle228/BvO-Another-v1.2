call DestroyTrigger(F3)
call DestroyTrigger(G3)
call DestroyTrigger(H3)
call DestroyTrigger(I3)
call DestroyTrigger(l3)
call DestroyTrigger(J3)
call DestroyTrigger(K3)
call DestroyTrigger(L3)
call DestroyTrigger(M3)
call DestroyTrigger(N3)
call DestroyTrigger(O3)
