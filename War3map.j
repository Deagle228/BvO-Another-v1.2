call SaveEffectHandle(BusoshokuHash,GetHandleId(reflectTimer),1,AddSpecialEffectTarget("Abilities\\Spells\\Orc\\SpikeBarrier\\SpikeBarrier.mdl",itemCaster,"origin"))
call TimerStart(reflectTimer,5.,false,function BusoshokuReflectEnd)
set reflectTimer=null
endif
set itemCaster=null
return false
