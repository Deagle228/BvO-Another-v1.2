function BvOOrbFireDamage takes unit orbLocalCaster,real orbLocalX,real orbLocalY,boolean orbLocalLanding returns nothing
local group orbLocalVictims=CreateGroup()
local unit orbLocalVictim
local real orbLocalAmount=3.*GetHeroInt(orbLocalCaster,true)+3.*GetHeroAgi(orbLocalCaster,true)+3.*GetHeroStr(orbLocalCaster,true)
if orbLocalLanding then
set orbLocalAmount=10.*GetHeroInt(orbLocalCaster,true)
endif
call GroupEnumUnitsInRange(orbLocalVictims,orbLocalX,orbLocalY,390.,null)
loop
set orbLocalVictim=FirstOfGroup(orbLocalVictims)
exitwhen orbLocalVictim==null
call GroupRemoveUnit(orbLocalVictims,orbLocalVictim)
if GetWidgetLife(orbLocalVictim)>.405 and not IsUnitType(orbLocalVictim,UNIT_TYPE_DEAD) and IsUnitEnemy(orbLocalVictim,GetOwningPlayer(orbLocalCaster)) and not IsUnitType(orbLocalVictim,UNIT_TYPE_FLYING) and not IsUnitType(orbLocalVictim,UNIT_TYPE_MECHANICAL) and not IsUnitType(orbLocalVictim,UNIT_TYPE_MAGIC_IMMUNE) and GetUnitAbilityLevel(orbLocalVictim,'A01Q')==0 then
// Keep the Orb's original chaos/normal damage pair and target restrictions.
call UnitDamageTargetBJ(orbLocalCaster,orbLocalVictim,orbLocalAmount,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
call DestroyEffect(AddSpecialEffectTarget("Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl",orbLocalVictim,"origin"))
endif
endloop
call DestroyGroup(orbLocalVictims)
set orbLocalVictims=null
set orbLocalVictim=null
endfunction
function BvOOrbFireStop takes timer orbLocalMeteorTimer returns nothing
local unit orbLocalVisual=LoadUnitHandle(Hash,GetHandleId(orbLocalMeteorTimer),1)
call ShowUnit(orbLocalVisual,false)
call RemoveUnit(orbLocalVisual)
call FlushChildHashtable(Hash,GetHandleId(orbLocalMeteorTimer))
call PauseTimer(orbLocalMeteorTimer)
call DestroyTimer(orbLocalMeteorTimer)
set orbLocalVisual=null
endfunction
function BvOOrbFireTick takes nothing returns nothing
local timer orbLocalMeteorTimer=GetExpiredTimer()
local integer orbLocalKey=GetHandleId(orbLocalMeteorTimer)
local unit orbLocalCaster=LoadUnitHandle(Hash,orbLocalKey,0)
local unit orbLocalVisual=LoadUnitHandle(Hash,orbLocalKey,1)
local real orbLocalX=LoadReal(Hash,orbLocalKey,3)
local real orbLocalY=LoadReal(Hash,orbLocalKey,4)
local real orbLocalAngle=LoadReal(Hash,orbLocalKey,5)
local integer orbLocalTicks=LoadInteger(Hash,orbLocalKey,6)
local integer orbLocalPhase=LoadInteger(Hash,orbLocalKey,2)
if orbLocalCaster==null or GetUnitTypeId(orbLocalCaster)==0 then
call BvOOrbFireStop(orbLocalMeteorTimer)
elseif orbLocalPhase==1 then
// Transition at ground contact, skipping the trailing impact animation.
call ShowUnit(orbLocalVisual,false)
call RemoveUnit(orbLocalVisual)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",orbLocalX,orbLocalY))
call BvOOrbFireDamage(orbLocalCaster,orbLocalX,orbLocalY,true)
set orbLocalVisual=CreateUnit(GetOwningPlayer(orbLocalCaster),'h00R',orbLocalX,orbLocalY,orbLocalAngle*bj_RADTODEG)
call SetUnitPathing(orbLocalVisual,false)
call SetUnitX(orbLocalVisual,orbLocalX)
call SetUnitY(orbLocalVisual,orbLocalY)
call SetUnitAnimationByIndex(orbLocalVisual,0)
call SetUnitTimeScale(orbLocalVisual,1.3)
call SaveUnitHandle(Hash,orbLocalKey,1,orbLocalVisual)
call SaveInteger(Hash,orbLocalKey,2,2)
call TimerStart(orbLocalMeteorTimer,.025,true,function BvOOrbFireTick)
else
set orbLocalTicks=orbLocalTicks+1
set orbLocalX=orbLocalX+390.*.025*Cos(orbLocalAngle)
set orbLocalY=orbLocalY+390.*.025*Sin(orbLocalAngle)
if not RectContainsCoords(bj_mapInitialPlayableArea,orbLocalX,orbLocalY) then
call BvOOrbFireStop(orbLocalMeteorTimer)
else
call SetUnitX(orbLocalVisual,orbLocalX)
call SetUnitY(orbLocalVisual,orbLocalY)
call SetUnitTimeScale(orbLocalVisual,1.3)
call SaveReal(Hash,orbLocalKey,3,orbLocalX)
call SaveReal(Hash,orbLocalKey,4,orbLocalY)
call SaveInteger(Hash,orbLocalKey,6,orbLocalTicks)
if ModuloInteger(orbLocalTicks,10)==0 then
call BvOOrbFireDamage(orbLocalCaster,orbLocalX,orbLocalY,false)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",orbLocalX,orbLocalY))
call DestroyDestructable(390.,Location(orbLocalX,orbLocalY))
endif
if orbLocalTicks>=90 then
call BvOOrbFireStop(orbLocalMeteorTimer)
endif
endif
endif
set orbLocalCaster=null
set orbLocalVisual=null
set orbLocalMeteorTimer=null
endfunction
function BvOOrbFireStart takes nothing returns nothing
local unit orbLocalCaster=GetTriggerUnit()
local real orbLocalX=GetSpellTargetX()
local real orbLocalY=GetSpellTargetY()
local real orbLocalAngle=Atan2(orbLocalY-GetUnitY(orbLocalCaster),orbLocalX-GetUnitX(orbLocalCaster))
local timer orbLocalMeteorTimer=CreateTimer()
local integer orbLocalKey=GetHandleId(orbLocalMeteorTimer)
local unit orbLocalVisual
if (orbLocalX-GetUnitX(orbLocalCaster))*(orbLocalX-GetUnitX(orbLocalCaster))+(orbLocalY-GetUnitY(orbLocalCaster))*(orbLocalY-GetUnitY(orbLocalCaster))<1. then
set orbLocalAngle=GetUnitFacing(orbLocalCaster)*bj_DEGTORAD
endif
set orbLocalVisual=CreateUnit(GetOwningPlayer(orbLocalCaster),'h00Q',orbLocalX,orbLocalY,orbLocalAngle*bj_RADTODEG)
call SetUnitPathing(orbLocalVisual,false)
call SetUnitX(orbLocalVisual,orbLocalX)
call SetUnitY(orbLocalVisual,orbLocalY)
call SetUnitTimeScale(orbLocalVisual,1.3)
call SaveUnitHandle(Hash,orbLocalKey,0,orbLocalCaster)
call SaveUnitHandle(Hash,orbLocalKey,1,orbLocalVisual)
call SaveInteger(Hash,orbLocalKey,2,1)
call SaveReal(Hash,orbLocalKey,3,orbLocalX)
call SaveReal(Hash,orbLocalKey,4,orbLocalY)
call SaveReal(Hash,orbLocalKey,5,orbLocalAngle)
call SaveInteger(Hash,orbLocalKey,6,0)
call TimerStart(orbLocalMeteorTimer,.75,false,function BvOOrbFireTick)
set orbLocalCaster=null
set orbLocalVisual=null
set orbLocalMeteorTimer=null
endfunction
