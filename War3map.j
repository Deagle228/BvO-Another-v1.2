function BvORenjiTPointClear takes real renjiPointX,real renjiPointY returns boolean
local integer renjiProbeIndex=0
local real renjiProbeX
local real renjiProbeY
if renjiPointX<=GetRectMinX(bj_mapInitialPlayableArea)+32. or renjiPointX>=GetRectMaxX(bj_mapInitialPlayableArea)-32. or renjiPointY<=GetRectMinY(bj_mapInitialPlayableArea)+32. or renjiPointY>=GetRectMaxY(bj_mapInitialPlayableArea)-32. or IsTerrainPathable(renjiPointX,renjiPointY,PATHING_TYPE_WALKABILITY) then
return false
endif
loop
exitwhen renjiProbeIndex>=8
set renjiProbeX=renjiPointX+32.*Cos(45.*I2R(renjiProbeIndex)*bj_DEGTORAD)
set renjiProbeY=renjiPointY+32.*Sin(45.*I2R(renjiProbeIndex)*bj_DEGTORAD)
if IsTerrainPathable(renjiProbeX,renjiProbeY,PATHING_TYPE_WALKABILITY) then
return false
endif
set renjiProbeIndex=renjiProbeIndex+1
endloop
return true
endfunction
function BvORenjiTClipLocation takes real renjiStartX,real renjiStartY,location renjiDestination returns location
local real renjiDeltaX=GetLocationX(renjiDestination)-renjiStartX
local real renjiDeltaY=GetLocationY(renjiDestination)-renjiStartY
local real renjiDistance=SquareRoot(renjiDeltaX*renjiDeltaX+renjiDeltaY*renjiDeltaY)
local integer renjiStepCount=R2I(renjiDistance/8.)+1
local integer renjiStepIndex=1
local real renjiSafeX=renjiStartX
local real renjiSafeY=renjiStartY
local real renjiStepX
local real renjiStepY
loop
exitwhen renjiStepIndex>renjiStepCount
set renjiStepX=renjiStartX+renjiDeltaX*I2R(renjiStepIndex)/I2R(renjiStepCount)
set renjiStepY=renjiStartY+renjiDeltaY*I2R(renjiStepIndex)/I2R(renjiStepCount)
exitwhen not BvORenjiTPointClear(renjiStepX,renjiStepY)
set renjiSafeX=renjiStepX
set renjiSafeY=renjiStepY
set renjiStepIndex=renjiStepIndex+1
endloop
call MoveLocation(renjiDestination,renjiSafeX,renjiSafeY)
return renjiDestination
endfunction
function BvORenjiTMoveUnit takes unit renjiMovingUnit,location renjiDestination returns nothing
if renjiMovingUnit!=null and GetUnitTypeId(renjiMovingUnit)!=0 then
call BvORenjiTClipLocation(GetUnitX(renjiMovingUnit),GetUnitY(renjiMovingUnit),renjiDestination)
call SetUnitX(renjiMovingUnit,GetLocationX(renjiDestination))
call SetUnitY(renjiMovingUnit,GetLocationY(renjiDestination))
endif
endfunction
// Renji T watchdog: 14 seconds after the cast Renji and the target are always released, even if the cast thread died
