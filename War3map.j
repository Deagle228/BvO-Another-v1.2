set MihawkTEffectPoint=PG(GetUnitLoc(MihawkTCaster),-9.,MihawkTDirection)
call SetUnitPositionLoc(MihawkTCaster,MihawkTEffectPoint)
call RemoveLocation(MihawkTEffectPoint)
