call TriggerRegisterUnitEvent(H3,cm,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(l3,cm,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(K3,cm,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(M3,cm,EVENT_UNIT_SPELL_EFFECT)
