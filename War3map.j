function DEx takes nothing returns nothing
local integer mihawkTCreateIndex
local integer mihawkTCleanupIndex
set MihawkTCaster=GetTriggerUnit()
set MihawkTTarget=GetSpellTargetUnit()
call BvOTrackUltimatePair(MihawkTCaster,MihawkTTarget,"MihawkT")
set MihawkTTargetPoint=GetUnitLoc(MihawkTTarget)
set MihawkTDirection=AngleBetweenPoints(GetUnitLoc(MihawkTCaster),MihawkTTargetPoint)
set MihawkTLandingPoint=PG(MihawkTTargetPoint,200.,MihawkTDirection)
set l[1+GetPlayerId(GetOwningPlayer(MihawkTTarget))]=true
set MihawkTAfterimageAngle=0.
set MihawkTTravelAngle=0.
set MihawkTFadeStep=0
call SetUnitPathing(MihawkTCaster,false)
call SetUnitAnimation(MihawkTCaster,"spell")
call SetUnitTimeScalePercent(MihawkTCaster,30.)
call PauseUnit(MihawkTCaster,true)
if BvOUltimatePairAlive(MihawkTCaster,MihawkTTarget,"MihawkT") then
call PauseUnit(MihawkTTarget,true)
endif
call SetUnitInvulnerable(MihawkTCaster,true)
if BvOUltimatePairAlive(MihawkTCaster,MihawkTTarget,"MihawkT") then
call SetUnitInvulnerable(MihawkTTarget,true)
endif
set Km[99]=GetUnitLoc(MihawkTCaster)
call PlaySoundAtPointBJ(gr,100,Km[99],0)
call RemoveLocation(Km[99])
set Km[99]=null
call EnableTrigger(c3)
call TriggerSleepAction(.2)
call DisableTrigger(c3)
call ShowUnitHide(MihawkTCaster)
set mihawkTCreateIndex=1
loop
exitwhen mihawkTCreateIndex>5
set MihawkTAfterimageAngle=MihawkTAfterimageAngle+72.
set MihawkTAfterimages[mihawkTCreateIndex]=CreateUnit(GetOwningPlayer(MihawkTCaster),'h00G',GetLocationX(MihawkTTargetPoint),GetLocationY(MihawkTTargetPoint),MihawkTAfterimageAngle)
call AddSpecialEffectTargetUnitBJ("hand right",MihawkTAfterimages[mihawkTCreateIndex],"Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile_mini.mdl")
call SetUnitPathing(MihawkTAfterimages[mihawkTCreateIndex],false)
call SetUnitTimeScalePercent(MihawkTAfterimages[mihawkTCreateIndex],50.)
call SetUnitAnimation(MihawkTAfterimages[mihawkTCreateIndex],"spell")
call SetUnitVertexColorBJ(MihawkTAfterimages[mihawkTCreateIndex],100,100,100,50.)
set mihawkTCreateIndex=mihawkTCreateIndex+1
endloop
call TriggerSleepAction(.01)
call EnableTrigger(D3)
call TriggerSleepAction(.5)
call SetUnitInvulnerable(MihawkTTarget,false)
call TriggerSleepAction(.01)
call DisableTrigger(D3)
set mihawkTCleanupIndex=1
loop
exitwhen mihawkTCleanupIndex>5
set MihawkTEffectPoint=GetUnitLoc(MihawkTAfterimages[mihawkTCleanupIndex])
call AddSpecialEffectLocBJ(MihawkTEffectPoint,"Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl")
call DestroyEffect(bj_lastCreatedEffect)
if GetUnitTypeId(MihawkTAfterimages[mihawkTCleanupIndex])=='h00G' and not IsUnitType(MihawkTAfterimages[mihawkTCleanupIndex],UNIT_TYPE_HERO) then
call RemoveUnit(MihawkTAfterimages[mihawkTCleanupIndex])
endif
set MihawkTAfterimages[mihawkTCleanupIndex]=null
call RemoveLocation(MihawkTEffectPoint)
set MihawkTEffectPoint=null
set mihawkTCleanupIndex=mihawkTCleanupIndex+1
endloop
call PauseUnit(MihawkTTarget,false)
set MihawkTDamage=(RBValue(GetUnitAbilityLevel(MihawkTCaster,'A04Y'),1000.0,1250.0,1500.0,2000.0,2500.0,2500.0)+RBValue(GetUnitAbilityLevel(MihawkTCaster,'A04Y'),11.0,22.0,33.0,44.0,55.0,55.0)*GetHeroStr(MihawkTCaster,false)+RBValue(GetUnitAbilityLevel(MihawkTCaster,'A04Y'),10.0,15.0,20.0,25.0,30.0,30.0)*GetHeroAgi(MihawkTCaster,true))
if BvOUltimatePairAlive(MihawkTCaster,MihawkTTarget,"MihawkT") then
call DamageUnit(MihawkTCaster,MihawkTTarget,MihawkTDamage,PHYSICAL,SPELL)
endif
set MihawkTEffectPoint=GetUnitLoc(MihawkTCaster)
if Dix() then
call UG(220.,MihawkTLandingPoint,function Dox)
call ShowUnitShow(MihawkTCaster)
call SetUnitVertexColorBJ(MihawkTCaster,100,100,100,0.)
if BvOUltimatePairCurrent(MihawkTCaster,MihawkTTarget,"MihawkT") and GetWidgetLife(MihawkTCaster)>.405 then
call SetUnitPositionLocFacingBJ(MihawkTCaster,MihawkTLandingPoint,MihawkTDirection)
endif
call AddSpecialEffectLocBJ(MihawkTEffectPoint,"Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl")
call DestroyEffect(bj_lastCreatedEffect)
else
call ShowUnitShow(MihawkTCaster)
call SetUnitVertexColorBJ(MihawkTCaster,100,100,100,0.)
if BvOUltimatePairCurrent(MihawkTCaster,MihawkTTarget,"MihawkT") and GetWidgetLife(MihawkTCaster)>.405 then
call SetUnitPositionLocFacingBJ(MihawkTCaster,MihawkTTargetPoint,MihawkTDirection)
endif
call AddSpecialEffectLocBJ(MihawkTEffectPoint,"Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl")
call DestroyEffect(bj_lastCreatedEffect)
endif
call RemoveLocation(MihawkTEffectPoint)
set MihawkTEffectPoint=null
set MihawkTEffectPoint=GetUnitLoc(MihawkTTarget)
call AddSpecialEffectLocBJ(MihawkTEffectPoint,"Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl")
call DestroyEffect(bj_lastCreatedEffect)
call RemoveLocation(MihawkTEffectPoint)
set MihawkTEffectPoint=null
call AddSpecialEffectTargetUnitBJ("origin",MihawkTTarget,"Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl")
call DestroyEffect(bj_lastCreatedEffect)
call AddSpecialEffectTargetUnitBJ("origin",MihawkTTarget,"Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl")
call DestroyEffect(bj_lastCreatedEffect)
call CreateTextTagUnitBJ(I2S(R2I(MihawkTDamage))+"!",MihawkTTarget,0,12.,100,0.,0.,0)
call SetTextTagVelocityBJ(bj_lastCreatedTextTag,100.,90)
call SetTextTagPermanentBJ(bj_lastCreatedTextTag,false)
call SetTextTagLifespanBJ(bj_lastCreatedTextTag,2.)
call TriggerSleepAction(.2)
call AddSpecialEffectTargetUnitBJ("origin",MihawkTTarget,"Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl")
call DestroyEffect(bj_lastCreatedEffect)
set l[1+GetPlayerId(GetOwningPlayer(MihawkTTarget))]=false
call TriggerSleepAction(.5)
call PauseUnit(MihawkTCaster,false)
call SetUnitInvulnerable(MihawkTCaster,false)
call SetUnitPathing(MihawkTCaster,true)
call SetUnitTimeScalePercent(MihawkTCaster,100.)
call SetUnitAnimation(MihawkTCaster,"stand ready")
call SelectUnitForPlayerSingle(MihawkTCaster,GetOwningPlayer(MihawkTCaster))
if Dnx() then
call PauseUnit(MihawkTCaster,true)
endif
set MihawkTCaster=null
set MihawkTTarget=null
set MihawkTDirection=0.
set MihawkTAfterimageAngle=0.
set MihawkTFadeStep=0
set MihawkTTravelAngle=0.
call RemoveLocation(MihawkTTargetPoint)
call RemoveLocation(MihawkTLandingPoint)
set MihawkTTargetPoint=null
set MihawkTLandingPoint=null
set eg[60]=null
endfunction
