function SasukeKirinDamage takes unit caster returns real
local integer level=GetUnitAbilityLevel(caster,'A09D')
local real physicalPart=RBValue(level,1500.,2000.,2500.,3000.,3500.,3500.)
local real magicPart=RBValue(level,3.,3.5,4.,4.5,5.,5.)*GetHeroAgi(caster,true)
call SaveReal(Hash,GetHandleId(caster),StringHash("KirinPhysical"),physicalPart)
call SaveReal(Hash,GetHandleId(caster),StringHash("KirinMagic"),magicPart)
return physicalPart+magicPart
endfunction
