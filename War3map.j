// Byakuya W (AB0W): binds an enemy hero or boss ('A0EM' Boss / strong creep), not Oz, alive, visible, not magic immune
function ByakuyaWIsOz takes integer unitType returns boolean
return unitType=='n00E' or unitType=='n00F' or unitType=='n00G' or unitType=='n00H' or unitType=='n00I' or unitType=='n00J' or unitType=='n00K' or unitType=='n00L' or unitType=='n010' or unitType=='nfgl'
endfunction
function ByakuyaWCanBind takes unit byakuya,unit bindTarget returns boolean
if bindTarget==null or GetWidgetLife(bindTarget)<=.405 or not IsUnitEnemy(bindTarget,GetOwningPlayer(byakuya)) then
return false
endif
if IsUnitType(bindTarget,UNIT_TYPE_MAGIC_IMMUNE) or not IsUnitVisible(bindTarget,GetOwningPlayer(byakuya)) or ByakuyaWIsOz(GetUnitTypeId(bindTarget)) then
return false
endif
return IsUnitType(bindTarget,UNIT_TYPE_HERO) or GetUnitAbilityLevel(bindTarget,'A0EM')>0
endfunction
function ByakuyaWCheckCast takes nothing returns boolean
// Ace V (Fire Skin) is a passive: its button (RAVC) only shows the cooldown. A click by the player is cancelled
// (pause, stop, unpause: no cooldown starts); only the cast ordered by the passive itself (marked for 0.5 s) goes on
if GetSpellAbilityId()=='RAVC' and TimerGetElapsed(AYClock)>LoadReal(RBState,GetHandleId(GetTriggerUnit()),183) then
call PauseUnit(GetTriggerUnit(),true)
call IssueImmediateOrder(GetTriggerUnit(),"stop")
call PauseUnit(GetTriggerUnit(),false)
endif
return false
endfunction
function ByakuyaWInit takes nothing returns nothing
local trigger castCheckTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(castCheckTrigger,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(castCheckTrigger,Condition(function ByakuyaWCheckCast))
set castCheckTrigger=null
endfunction
