function Djx takes nothing returns nothing
set bj_wantDestroyGroup=true
call GroupClear(qf)
set jf[1]=GetTriggerUnit()
set kf[1]=GetUnitLoc(jf[1])
set kf[2]=GetSpellTargetLoc()
set mf[1]=AngleBetweenPoints(kf[1],kf[2])
set pf[1]=(RBValue(GetUnitAbilityLevel(jf[1],'A09K'),125.0,175.0,225.0,275.0,325.0,375.0)+RBValue(GetUnitAbilityLevel(jf[1],'A09K'),0.75,1.0,1.25,1.5,1.75,2.0)*GetHeroStr(jf[1],false))
set pf[2]=0.
set of[2]=0
set vf=false
call PlaySoundAtPointBJ(vIv,100,kf[1],0)
call EnableTrigger(I3)
call TriggerSleepAction(.165)
call DisableTrigger(I3)
set vf=true
set of[2]=0
call EnableTrigger(I3)
call TriggerSleepAction(.33)
set jf[1]=null
set mf[1]=0.
set pf[1]=0.
set pf[2]=0.
set of[2]=0
set vf=false
call DisableTrigger(I3)
call RemoveLocation(kf[1])
set kf[1]=null
call RemoveLocation(kf[2])
set kf[2]=null
set bj_wantDestroyGroup=true
call GroupClear(qf)
endfunction
