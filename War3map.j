set mihawkTTravelIndex=mihawkTTravelIndex+1
endloop
if BvOUltimatePairCurrent(MihawkTCaster,MihawkTTarget,"MihawkT") and GetWidgetLife(MihawkTTarget)>.405 then
call SetUnitPositionLoc(MihawkTTarget,MihawkTTargetPoint)
endif
set MihawkTTravelAngle=0.
