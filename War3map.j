endfunction
function SadoV_Attack takes nothing returns nothing
if UnitHasBuffBJ(Source,$42303330) then
call UnitRemoveBuffBJ($42303330,Source)
call SortEnemiesInRange(Source,GetUnitX(Target),GetUnitY(Target),165)
call DamageGroup(Source,1.5*GetHeroStr(Source,true),PHYSICAL,UNKNOWN)
call CastToGroup(Source,$41303047,1,"thunderbolt")
call DestroyEffect(AddSpecialEffect("war3mapImported\\explosion.mdx",GetUnitX(Target),GetUnitY(Target)))
