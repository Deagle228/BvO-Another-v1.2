function Pxx takes nothing returns nothing
local unit scDead=GetDyingUnit()
local player scKiller=GetOwningPlayer(GetKillingUnit())
local integer scKillerIndex=GetPlayerId(scKiller)
local integer scAllyIndex=0
local player scAlly
local boolean scDrop=false
set w4=null
set x4=0
set BvOSCDeaths=BvOSCDeaths+1
set BvOSCRespawnPending=true
if scKillerIndex>=0 and scKillerIndex<12 and (IsPlayerInForce(scKiller,e) or IsPlayerInForce(scKiller,f)) then
call AdjustPlayerStateBJ(5000,scKiller,PLAYER_STATE_RESOURCE_GOLD)
loop
exitwhen scAllyIndex>11
set scAlly=Player(scAllyIndex)
if scAllyIndex!=scKillerIndex and BvOSlotState(scAlly)==PLAYER_SLOT_STATE_PLAYING and ((IsPlayerInForce(scKiller,e) and IsPlayerInForce(scAlly,e)) or (IsPlayerInForce(scKiller,f) and IsPlayerInForce(scAlly,f))) then
call AdjustPlayerStateBJ(1000,scAlly,PLAYER_STATE_RESOURCE_GOLD)
endif
set scAllyIndex=scAllyIndex+1
endloop
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,GetUnitName(scDead)+" (level 30) has been slain by "+E[1+scKillerIndex]+". Killer: +5000 gold; teammates: +1000 gold each.")
else
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,GetUnitName(scDead)+" (level 30) has been slain.")
endif
if BvOSCDeaths==5 then
set scDrop=true
elseif BvOSCDeaths>5 then
set scDrop=GetRandomInt(1,100)<=30
endif
if scDrop then
call CreateItem('I00A',GetUnitX(scDead),GetUnitY(scDead))
endif
set scDead=null
set scKiller=null
set scAlly=null
endfunction
