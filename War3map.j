endfunction
function BvOStringHas takes string haystack,string needle returns boolean
local integer index=0
local integer needleLength=StringLength(needle)
loop
exitwhen index+needleLength>StringLength(haystack)
if SubString(haystack,index,index+needleLength)==needle then
return true
endif
set index=index+1
endloop
return false
endfunction
function BvOModeTrigger takes string modeCode returns trigger
if modeCode=="ar" then
return Q3
endif
if modeCode=="np" then
return R3
endif
if modeCode=="hs" then
return S3
endif
if modeCode=="ds" then
return T3
endif
if modeCode=="nd" then
return U3
endif
if modeCode=="n3" then
return V3
endif
if modeCode=="n5" then
return W3
endif
if modeCode=="ne" then
return X3
endif
if modeCode=="ns" then
return Y3
endif
if modeCode=="nr" then
return Z3
endif
if modeCode=="fh" then
return dF
endif
if modeCode=="sh" then
return eF
endif
if modeCode=="nh" then
return fF
endif
if modeCode=="sc" then
return gF
endif
if modeCode=="bh" then
return hF
endif
if modeCode=="nf" then
return iF
endif
if modeCode=="nw" then
return jF
endif
if modeCode=="bo" then
return kF
endif
if modeCode=="oo" then
return mF
endif
if modeCode=="so" then
return nF
endif
return null
endfunction
// game modes: "-" and two letter codes. Each code is applied in the order it was typed; a mode that conflicts with
// one typed before it is already switched off by that one, so the first typed wins
function BvOModesInOrder takes nothing returns nothing
local string chatText=GetEventPlayerChatString()
local string applied="|"
local string modeCode
local integer position=1
local trigger modeTrigger
loop
exitwhen position+2>StringLength(chatText)
if SubString(chatText,position,position+1)==" " then
set position=position+1
else
set modeCode=StringCase(SubString(chatText,position,position+2),false)
set modeTrigger=BvOModeTrigger(modeCode)
if modeTrigger!=null and IsTriggerEnabled(modeTrigger) and not BvOStringHas(applied,"|"+modeCode+"|") then
set applied=applied+modeCode+"|"
call TriggerExecute(modeTrigger)
call DisableTrigger(modeTrigger)
endif
set position=position+2
endif
endloop
set modeTrigger=null
endfunction
function GPx takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call BvOModesInOrder()
if BvOFreeSpellsRequested(GetEventPlayerChatString()) then
call BvOFreeSpellsEnable()
endif
call DisableTrigger(Q3)
call DisableTrigger(R3)
call DisableTrigger(S3)
call DisableTrigger(T3)
call DisableTrigger(U3)
call DisableTrigger(V3)
call DisableTrigger(W3)
call DisableTrigger(X3)
call DisableTrigger(Z3)
call DisableTrigger(dF)
call DisableTrigger(eF)
call DisableTrigger(fF)
call DisableTrigger(gF)
call DisableTrigger(hF)
call DisableTrigger(iF)
call DisableTrigger(Y3)
call DisableTrigger(jF)
call DisableTrigger(kF)
call DisableTrigger(mF)
call DisableTrigger(nF)
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,E[1+GetPlayerId(GetTriggerPlayer())]+(" has selected"+H7))
set N[799]=8
// the modes are typed: without All Random the heroes can be picked right away (no need to wait for the 15 seconds)
if not k4 then
call ExecuteFunc("BvOPickModesTyped")
endif
if Gpx() then
call ForGroupBJ(d6(bj_mapInitialPlayableArea),function GMx)
endif
call DestroyTrigger(Q3)
call DestroyTrigger(R3)
call DestroyTrigger(S3)
call DestroyTrigger(T3)
call DestroyTrigger(U3)
call DestroyTrigger(V3)
call DestroyTrigger(W3)
call DestroyTrigger(X3)
call DestroyTrigger(Y3)
call DestroyTrigger(Z3)
call DestroyTrigger(dF)
call DestroyTrigger(eF)
call DestroyTrigger(fF)
call DestroyTrigger(gF)
call DestroyTrigger(hF)
call DestroyTrigger(iF)
call DestroyTrigger(jF)
call DestroyTrigger(kF)
call DestroyTrigger(mF)
call DestroyTrigger(nF)
call DestroyTrigger(oF)
// the modes are typed once, in one line: the mode window closes now instead of waiting for 15 seconds
if not BvOModeWindowDone then
call TriggerExecute(As)
endif
endfunction
