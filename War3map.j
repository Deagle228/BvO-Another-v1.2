function FZHasOken takes unit hero returns boolean
return UnitHasItemOfTypeBJ(hero,'I03D') or UnitHasItemOfTypeBJ(hero,'I03B') or UnitHasItemOfTypeBJ(hero,'I054') or GetUnitAbilityLevel(hero,OKEN_BLESSING_MARKER)>0
endfunction
function FZMiniDamage takes unit caster, unit target, real amount returns nothing
local integer mode=DamageSystem_DamageMode
local integer dtype=DamageType
local real previous=PrimaryDamage
set DamageSystem_DamageMode=SPELL
set DamageType=MAGICAL
set PrimaryDamage=amount
call UnitDamageTarget(caster,target,amount,false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,null)
set DamageSystem_DamageMode=mode
set DamageType=dtype
set PrimaryDamage=previous
endfunction
// physical spell damage (like DamageUnit ... PHYSICAL): DAMAGE_TYPE_NORMAL is the only damage type reduced by armor,
// so armor reduction (Corrupted Desolator) makes it stronger and armor makes it weaker
function FZMiniPhysicalDamage takes unit caster,unit target,real amount returns nothing
local integer mode=DamageSystem_DamageMode
local integer dtype=DamageType
local real previous=PrimaryDamage
set DamageSystem_DamageMode=SPELL
set DamageType=PHYSICAL
set PrimaryDamage=amount
call UnitDamageTarget(caster,target,amount,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
set DamageSystem_DamageMode=mode
set DamageType=dtype
set PrimaryDamage=previous
endfunction
// spell damage of a given map damage kind (DamageType): PHYSICAL hero/normal (reduced by armor), MIXED normal/normal,
// CLEAN chaos/universal (pure), MAGICAL magic/magic
function BvOKindSpellDamage takes unit damageSource,widget damageTarget,real damageAmount,boolean countsAsAttack,integer damageKind returns boolean
local integer previousMode=DamageSystem_DamageMode
local integer previousType=DamageType
local real previousPrimary=PrimaryDamage
local boolean damageDealt
local attacktype kindAttackType=ATTACK_TYPE_MAGIC
local damagetype kindDamageType=DAMAGE_TYPE_MAGIC
if damageKind==PHYSICAL then
set kindAttackType=ATTACK_TYPE_HERO
set kindDamageType=DAMAGE_TYPE_NORMAL
elseif damageKind==MIXED then
set kindAttackType=ATTACK_TYPE_NORMAL
set kindDamageType=DAMAGE_TYPE_NORMAL
elseif damageKind==CLEAN then
set kindAttackType=ATTACK_TYPE_CHAOS
set kindDamageType=DAMAGE_TYPE_UNIVERSAL
endif
set DamageSystem_DamageMode=SPELL
set DamageType=damageKind
set PrimaryDamage=damageAmount
set damageDealt=UnitDamageTarget(damageSource,damageTarget,damageAmount,countsAsAttack,false,kindAttackType,kindDamageType,WEAPON_TYPE_WHOKNOWS)
set DamageSystem_DamageMode=previousMode
set DamageType=previousType
set PrimaryDamage=previousPrimary
set kindAttackType=null
set kindDamageType=null
return damageDealt
endfunction
function BvOHeroSpellDamage takes unit damageSource,widget damageTarget,real damageAmount,boolean countsAsAttack,boolean countsAsRanged,attacktype damageAttackType,damagetype damageDamageType returns boolean
local integer previousMode=DamageSystem_DamageMode
local integer previousType=DamageType
local real previousPrimary=PrimaryDamage
local boolean damageDealt
set DamageSystem_DamageMode=SPELL
set DamageType=MAGICAL
set PrimaryDamage=damageAmount
set damageDealt=UnitDamageTarget(damageSource,damageTarget,damageAmount,countsAsAttack,countsAsRanged,damageAttackType,damageDamageType,WEAPON_TYPE_WHOKNOWS)
set DamageSystem_DamageMode=previousMode
set DamageType=previousType
set PrimaryDamage=previousPrimary
return damageDealt
endfunction

function FZMiniDummy takes player owner, integer kind, real dummyX, real dummyY, real facing returns unit
local unit u=CreateUnit(owner,kind,dummyX,dummyY,facing)
local real lifetime=1.2
call UnitAddAbility(u,'Aloc')
call SetUnitPathing(u,false)
call SetUnitX(u,dummyX)
call SetUnitY(u,dummyY)
if kind=='zZ0C' then
set lifetime=5.2
elseif kind=='zZ0E' then
set lifetime=1.4
endif
call UnitApplyTimedLife(u,'BTLF',lifetime)
return u
endfunction


function FZMiniSummon takes nothing returns nothing
local unit u=GetSummonedUnit()
if u!=null and GetUnitTypeId(u)=='zZ03' then
call SetUnitVertexColor(u,255,255,255,0)
call UnitApplyTimedLife(u,'BTLF',0.75)
endif
set u=null
endfunction

function FZMiniQMove takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(FZMiniTable,id,0)
local timer impact=LoadTimerHandle(FZMiniTable,id,1)
local location p=Location(LoadReal(FZMiniTable,id,8),LoadReal(FZMiniTable,id,9))
if LoadTimerHandle(FZMiniTable,GetHandleId(caster),20)==impact then
call SetUnitPositionLoc(caster,p)
endif
call RemoveLocation(p)
call FlushChildHashtable(FZMiniTable,id)
call DestroyTimer(t)
set p=null
set caster=null
set impact=null
set t=null
endfunction

function FZMiniQVisual takes player owner, integer kind, location p, real lifetime returns nothing
call CreateNUnitsAtLoc(1,kind,owner,p,GetRandomDirectionDeg())
call UnitAddAbility(bj_lastCreatedUnit,'Aloc')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',lifetime)
endfunction

function FZMiniQFinish takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(FZMiniTable,id,0)
local player owner=GetOwningPlayer(caster)
local location p=Location(LoadReal(FZMiniTable,id,8),LoadReal(FZMiniTable,id,9))
local group g=GetUnitsInRangeOfLocAll(350.,p)
local unit victim
local integer i=0
loop
set victim=FirstOfGroup(g)
exitwhen victim==null
call GroupRemoveUnit(g,victim)
if IsPlayerEnemy(GetOwningPlayer(victim),owner) then
call FZMiniPhysicalDamage(caster,victim,50.+100.*I2R(GetUnitAbilityLevel(caster,'AZ07')))
call BvOKindSpellDamage(caster,victim,1.5*I2R(GetHeroAgi(caster,true)),false,MAGICAL)
endif
endloop
call DestroyGroup(g)
loop
exitwhen i>=3
call FZMiniQVisual(owner,'zZ07',p,1.2)
call FZMiniQVisual(owner,'zZ08',p,1.2)
set i=i+1
endloop
call FZMiniQVisual(owner,'zZ09',p,1.2)
set i=0
loop
exitwhen i>=3
call FZMiniQVisual(owner,'zZ0A',p,0.8)
set i=i+1
endloop
call FZMiniQVisual(owner,'zZ0B',p,0.8)
call SetUnitPathing(caster,true)
if LoadTimerHandle(FZMiniTable,GetHandleId(caster),20)==t then
call RemoveSavedHandle(FZMiniTable,GetHandleId(caster),20)
endif
call RemoveLocation(p)
call FlushChildHashtable(FZMiniTable,id)
call DestroyTimer(t)
set victim=null
set g=null
set p=null
set owner=null
set caster=null
set t=null
endfunction

function FZMiniFinishT takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(FZMiniTable,id,0)
local group g=LoadGroupHandle(FZMiniTable,id,7)
local unit target
local real amount=800.+700.*I2R(GetUnitAbilityLevel(caster,'AZ06'))+I2R(GetHeroInt(caster,true))+I2R(GetHeroAgi(caster,true))
loop
set target=FirstOfGroup(g)
exitwhen target==null
call GroupRemoveUnit(g,target)
if GetWidgetLife(target)>0.405 then
call FZMiniDamage(caster,target,amount)
call DestroyEffect(AddSpecialEffectTarget("FOCSZoro\\asset042.mdx",target,"chest"))
endif
endloop
call DestroyGroup(g)
call FlushChildHashtable(FZMiniTable,id)
call DestroyTimer(t)
set g=null
set target=null
set caster=null
set t=null
endfunction

function FZMiniMoveTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(FZMiniTable,id,0)
local player owner=GetOwningPlayer(caster)
local integer tick=LoadInteger(FZMiniTable,id,1)+1
local integer count=LoadInteger(FZMiniTable,id,2)
local integer mode=LoadInteger(FZMiniTable,id,3)
local real x=LoadReal(FZMiniTable,id,4)
local real y=LoadReal(FZMiniTable,id,5)
local real tx=LoadReal(FZMiniTable,id,8)
local real ty=LoadReal(FZMiniTable,id,9)
local real nx
local real ny
local group nearby
local group hit
local unit victim
local unit waveFx
local unit stunDummy
local location wavePoint
set nx=x+(tx-x)*I2R(tick)/I2R(count)
set ny=y+(ty-y)*I2R(tick)/I2R(count)
set wavePoint=Location(nx,ny)
call SetUnitPositionLoc(caster,wavePoint)
call RemoveLocation(wavePoint)
if mode==1 then
call SetUnitFacing(caster,LoadReal(FZMiniTable,id,10))
set wavePoint=Location(nx,ny)
set waveFx=CreateUnitAtLoc(owner,'zZ12',wavePoint,LoadReal(FZMiniTable,id,10))
call UnitApplyTimedLife(waveFx,'BTLF',0.55)
call RemoveLocation(wavePoint)
set hit=LoadGroupHandle(FZMiniTable,id,7)
set nearby=CreateGroup()
call GroupEnumUnitsInRange(nearby,nx,ny,375.,null)
loop
set victim=FirstOfGroup(nearby)
exitwhen victim==null
call GroupRemoveUnit(nearby,victim)
if (IsUnitEnemy(victim,owner) or GetPlayerId(GetOwningPlayer(victim))==PLAYER_NEUTRAL_AGGRESSIVE) and GetWidgetLife(victim)>0.405 and GetUnitAbilityLevel(victim,'Aloc')==0 and not IsUnitInGroup(victim,hit) then
call GroupAddUnit(hit,victim)
set wavePoint=GetUnitLoc(victim)
set stunDummy=CreateUnitAtLoc(owner,'zZ01',wavePoint,0.)
call UnitAddAbility(stunDummy,'Aloc')
call UnitAddAbility(stunDummy,'AZ04')
call SetUnitAbilityLevel(stunDummy,'AZ04',2)
call IssueTargetOrderById(stunDummy,852095,victim)
call UnitApplyTimedLife(stunDummy,'BTLF',0.8)
call RemoveLocation(wavePoint)
endif
endloop
call DestroyGroup(nearby)
endif
if tick>=count or GetWidgetLife(caster)<=0.405 then
call SetUnitPathing(caster,true)
if mode==1 then
call SetUnitInvulnerable(caster,false)
call TimerStart(t,1.4,false,function FZMiniFinishT)
else
call FZMiniDummy(owner,'zZ05',tx,ty,0.)
call FZMiniDummy(owner,'zZ04',tx,ty,0.)
call FlushChildHashtable(FZMiniTable,id)
call DestroyTimer(t)
endif
else
call SaveInteger(FZMiniTable,id,1,tick)
endif
set caster=null
set owner=null
set victim=null
set nearby=null
set hit=null
set waveFx=null
set stunDummy=null
set wavePoint=null
set t=null
endfunction


function FZVKnockBackS takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit moveUnit=LoadUnitHandle(FZVTable,GetHandleId(t),StringHash("Unit"))
local real distance=LoadReal(FZVTable,GetHandleId(t),StringHash("Distance"))
local real step=LoadReal(FZVTable,GetHandleId(t),StringHash("Sum Distance"))
local real angle=LoadReal(FZVTable,GetHandleId(t),StringHash("Angle"))
local location current=GetUnitLoc(moveUnit)
local location next=PolarProjectionBJ(current,step,angle)
if distance<=0 then
call FlushChildHashtable(FZVTable,GetHandleId(t))
call DestroyTimer(t)
else
call SetUnitPositionLoc(moveUnit,next)
call SaveReal(FZVTable,GetHandleId(t),StringHash("Distance"),distance-step)
endif
call RemoveLocation(current)
call RemoveLocation(next)
set t=null
set moveUnit=null
set current=null
set next=null
endfunction

function FZVKnockBack takes unit caster,location destination,real duration,real interval returns nothing
local timer t=CreateTimer()
local location start=GetUnitLoc(caster)
local real angle=AngleBetweenPoints(start,destination)
local real distance=DistanceBetweenPoints(start,destination)
local real step=distance/(duration/interval)
call SaveReal(FZVTable,GetHandleId(t),StringHash("Angle"),angle)
call SaveReal(FZVTable,GetHandleId(t),StringHash("Distance"),distance)
call SaveUnitHandle(FZVTable,GetHandleId(t),StringHash("Unit"),caster)
call SaveReal(FZVTable,GetHandleId(t),StringHash("Sum Distance"),step)
call TimerStart(t,interval,true,function FZVKnockBackS)
call RemoveLocation(start)
set t=null
set start=null
endfunction

function FZVSourceAction takes nothing returns nothing
local unit caster=GetTriggerUnit()
local unit target=GetSpellTargetUnit()
local player owner
local location start
local location impact
local location destination
local location landing
local real distance
local timer q
if not SilenceConditions(caster) then
set caster=null
set target=null
return
endif
if GetSpellAbilityId()!='AZ0A' or target==null then
set caster=null
set target=null
return
endif
set start=GetUnitLoc(caster)
set impact=GetUnitLoc(target)
set distance=DistanceBetweenPoints(start,impact)
set owner=GetOwningPlayer(caster)
set q=LoadTimerHandle(FZMiniTable,GetHandleId(caster),20)
if q!=null then
call FlushChildHashtable(FZMiniTable,GetHandleId(q))
call DestroyTimer(q)
call RemoveSavedHandle(FZMiniTable,GetHandleId(caster),20)
endif
call DisableTrigger(GetTriggeringTrigger())
call PlaySoundBJ(FZVSound)
if FZHasOken(caster) then
call FZMiniPhysicalDamage(caster,target,I2R(GetHeroAgi(caster,true)))
else
call FZMiniPhysicalDamage(caster,target,0.35*I2R(GetHeroAgi(caster,true)))
endif
if distance<=750. then
set destination=PolarProjectionBJ(impact,100.,AngleBetweenPoints(start,impact))
call SetUnitPathing(caster,false)
call CreateNUnitsAtLoc(1,'zZ06',owner,start,GetRandomDirectionDeg())
call UnitAddAbility(bj_lastCreatedUnit,'Aloc')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.12)
call FZVKnockBack(caster,destination,0.10,0.01)
call TriggerSleepAction(0.10)
call CreateNUnitsAtLoc(1,'zZ05',owner,impact,GetRandomDirectionDeg())
call UnitAddAbility(bj_lastCreatedUnit,'Aloc')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',1.2)
set landing=GetUnitLoc(caster)
call CreateNUnitsAtLoc(1,'zZ04',owner,landing,GetRandomDirectionDeg())
call UnitAddAbility(bj_lastCreatedUnit,'Aloc')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',2.2)
call RemoveLocation(landing)
call SetUnitPathing(caster,true)
call RemoveLocation(destination)
endif
call EnableTrigger(GetTriggeringTrigger())
call RemoveLocation(start)
call RemoveLocation(impact)
set caster=null
set target=null
set owner=null
set start=null
set impact=null
set destination=null
set landing=null
set q=null
endfunction

function FZVSourceInit takes nothing returns nothing
local trigger t=CreateTrigger()
set FZVSound=CreateSound("FOCSZoro\\asset046.mp3",false,false,false,10,10,"")
call SetSoundDuration(FZVSound,822)
call SetSoundChannel(FZVSound,0)
call SetSoundVolume(FZVSound,127)
call SetSoundPitch(FZVSound,1.)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(t,function FZVSourceAction)
set t=null
endfunction

function FZWVisual takes player owner, integer kind, location p, real facing, real timescale returns nothing
call CreateNUnitsAtLoc(1,kind,owner,p,facing)
call UnitAddAbility(bj_lastCreatedUnit,'Aloc')
call SetUnitTimeScalePercent(bj_lastCreatedUnit,timescale)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',4.)
endfunction

function FZWNoiseEnd takes nothing returns nothing
local timer t=GetExpiredTimer()
local player p=LoadPlayerHandle(FZMiniTable,GetHandleId(t),0)
local integer id=GetPlayerId(p)+500
if LoadTimerHandle(FZMiniTable,id,0)==t then
call CameraClearNoiseForPlayer(p)
call RemoveSavedHandle(FZMiniTable,id,0)
endif
call FlushChildHashtable(FZMiniTable,GetHandleId(t))
call DestroyTimer(t)
set p=null
set t=null
endfunction

function FZWNoise takes real duration returns nothing
local integer i=0
local player p
local timer t
local timer old
loop
exitwhen i>=8
set p=Player(i)
set old=LoadTimerHandle(FZMiniTable,i+500,0)
if old!=null then
call CameraClearNoiseForPlayer(p)
call FlushChildHashtable(FZMiniTable,GetHandleId(old))
call DestroyTimer(old)
endif
call CameraSetEQNoiseForPlayer(p,4.)
set t=CreateTimer()
call SavePlayerHandle(FZMiniTable,GetHandleId(t),0,p)
call SaveTimerHandle(FZMiniTable,i+500,0,t)
call TimerStart(t,duration,false,function FZWNoiseEnd)
set i=i+1
endloop
set old=null
set p=null
set t=null
endfunction

// W damage: every enemy whose distance along the wave is in this step's part of the 800 long path and whose distance
// from the wave line is within the wave radius (100 at the start, 300 at the end) takes 300 x level physical damage once
function FZWHit takes unit caster,real waveX,real waveY,real waveAngle,real fromDistance,real toDistance,group alreadyHit returns nothing
local real waveLength=650.+100.*I2R(GetUnitAbilityLevel(caster,'AZ08'))
local group nearby=CreateGroup()
local unit victim
local real alongWave
local real acrossWave
local real offsetX
local real offsetY
call GroupEnumUnitsInRange(nearby,waveX+(toDistance*.5)*Cos(waveAngle),waveY+(toDistance*.5)*Sin(waveAngle),toDistance*.5+350.,null)
loop
set victim=FirstOfGroup(nearby)
exitwhen victim==null
call GroupRemoveUnit(nearby,victim)
set offsetX=GetUnitX(victim)-waveX
set offsetY=GetUnitY(victim)-waveY
set alongWave=offsetX*Cos(waveAngle)+offsetY*Sin(waveAngle)
set acrossWave=RAbsBJ(offsetY*Cos(waveAngle)-offsetX*Sin(waveAngle))
if (alongWave>fromDistance or (fromDistance<=0. and alongWave>-48.)) and alongWave<=toDistance and acrossWave<=150.+150.*RMinBJ(alongWave,waveLength)/waveLength+48. and alongWave>-48. and not IsUnitInGroup(victim,alreadyHit) and IsUnitEnemy(victim,GetOwningPlayer(caster)) and GetWidgetLife(victim)>.405 and not IsUnitType(victim,UNIT_TYPE_STRUCTURE) then
call GroupAddUnit(alreadyHit,victim)
call BvOKindSpellDamage(caster,victim,300.*I2R(GetUnitAbilityLevel(caster,'AZ08')),false,PHYSICAL)
call BvOKindSpellDamage(caster,victim,I2R(GetHeroStr(caster,true)),false,MAGICAL)
endif
endloop
call DestroyGroup(nearby)
set nearby=null
set victim=null
endfunction
function FZWStep takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer step=LoadInteger(FZMiniTable,id,1)+1
local unit caster=LoadUnitHandle(FZMiniTable,id,0)
local location start=Location(LoadReal(FZMiniTable,id,3),LoadReal(FZMiniTable,id,4))
local real facing=LoadReal(FZMiniTable,id,2)
local real waveLength=650.+100.*I2R(GetUnitAbilityLevel(caster,'AZ08'))
local location p=PolarProjectionBJ(start,waveLength/6.*I2R(step)+waveLength/48.,facing)
local player owner=GetOwningPlayer(caster)
local unit slash=LoadUnitHandle(FZMiniTable,id,7)
call FZWVisual(owner,'zZ0D',p,facing,100.)
call FZWVisual(owner,'zZ0E',p,facing,150.)
// the damage follows exactly the drawn wave: the part of the path covered in this step, 150-300 wide
if step==6 then
call FZWHit(caster,LoadReal(FZMiniTable,id,3),LoadReal(FZMiniTable,id,4),facing*bj_DEGTORAD,waveLength/6.*I2R(step-1),waveLength,LoadGroupHandle(FZMiniTable,id,6))
else
call FZWHit(caster,LoadReal(FZMiniTable,id,3),LoadReal(FZMiniTable,id,4),facing*bj_DEGTORAD,waveLength/6.*I2R(step-1),waveLength/6.*I2R(step)+waveLength/48.,LoadGroupHandle(FZMiniTable,id,6))
endif
if slash!=null then
call SetUnitX(slash,GetLocationX(p))
call SetUnitY(slash,GetLocationY(p))
endif
call RemoveLocation(start)
call RemoveLocation(p)
if step<6 then
call SaveInteger(FZMiniTable,id,1,step)
call TimerStart(t,0.03,false,function FZWStep)
else
call RemoveUnit(slash)
call DestroyGroup(LoadGroupHandle(FZMiniTable,id,6))
call FlushChildHashtable(FZMiniTable,id)
call DestroyTimer(t)
endif
set slash=null
set owner=null
set p=null
set start=null
set caster=null
set t=null
endfunction

function FZWStart takes unit caster, real waveX, real waveY returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local location start=GetUnitLoc(caster)
local location target=Location(waveX,waveY)
local player owner=GetOwningPlayer(caster)
local integer i=0
call FZWNoise(0.4)
call PlaySoundBJ(FZWSound)
call SaveUnitHandle(FZMiniTable,id,0,caster)
call SaveInteger(FZMiniTable,id,1,0)
call SaveReal(FZMiniTable,id,3,GetUnitX(caster))
call SaveReal(FZMiniTable,id,4,GetUnitY(caster))
if (waveX-GetUnitX(caster))*(waveX-GetUnitX(caster))+(waveY-GetUnitY(caster))*(waveY-GetUnitY(caster))<1. then
call SaveReal(FZMiniTable,id,5,GetUnitFacing(caster)*bj_DEGTORAD)
else
call SaveReal(FZMiniTable,id,5,Atan2(waveY-GetUnitY(caster),waveX-GetUnitX(caster)))
endif
call SaveReal(FZMiniTable,id,2,LoadReal(FZMiniTable,id,5)*bj_RADTODEG)
loop
exitwhen i>=3
set bj_lastCreatedUnit=CreateUnit(owner,'zZ0A',GetUnitX(caster),GetUnitY(caster),LoadReal(FZMiniTable,id,2))
call UnitAddAbility(bj_lastCreatedUnit,'Aloc')
call UnitApplyTimedLife(bj_lastCreatedUnit,'BTLF',0.8)
set i=i+1
endloop
// the slash unit (zZ01) is moved by FZWStep along the drawn wave (the shared dummy wave could go another way)
call SaveUnitHandle(FZMiniTable,id,7,CreateUnit(owner,'zZ01',GetUnitX(caster),GetUnitY(caster),LoadReal(FZMiniTable,id,2)))
call SetUnitPathing(LoadUnitHandle(FZMiniTable,id,7),false)
call UnitAddAbility(LoadUnitHandle(FZMiniTable,id,7),'Aloc')
call SaveGroupHandle(FZMiniTable,id,6,CreateGroup())
call SaveReal(FZMiniTable,id,8,waveX)
call SaveReal(FZMiniTable,id,9,waveY)
call TimerStart(t,0.01,false,function FZWStep)
call RemoveLocation(start)
call RemoveLocation(target)
set owner=null
set target=null
set start=null
set t=null
endfunction

function FZEDamage takes unit caster returns nothing
local group fzeGroup=CreateGroup()
local unit fzeVictim
local real fzeAmount=300.+200.*I2R(GetUnitAbilityLevel(caster,'AZ09'))+1.5*I2R(GetHeroAgi(caster,false))+.5*I2R(GetHeroInt(caster,true))+.5*I2R(GetHeroStr(caster,true))
call GroupEnumUnitsInRange(fzeGroup,GetUnitX(caster),GetUnitY(caster),350.,null)
loop
set fzeVictim=FirstOfGroup(fzeGroup)
exitwhen fzeVictim==null
call GroupRemoveUnit(fzeGroup,fzeVictim)
if IsUnitEnemy(fzeVictim,GetOwningPlayer(caster)) and GetWidgetLife(fzeVictim)>.405 and not IsUnitType(fzeVictim,UNIT_TYPE_STRUCTURE) and not IsUnitType(fzeVictim,UNIT_TYPE_FLYING) and not IsUnitType(fzeVictim,UNIT_TYPE_MAGIC_IMMUNE) and GetUnitAbilityLevel(fzeVictim,'Avul')==0 then
call BvOKindSpellDamage(caster,fzeVictim,fzeAmount,false,MAGICAL)
endif
endloop
call DestroyGroup(fzeGroup)
set fzeGroup=null
set fzeVictim=null
endfunction
function FZEStart takes unit caster returns nothing
local location p=GetUnitLoc(caster)
local player owner=GetOwningPlayer(caster)
local integer i=0
call FZWNoise(1.5)
call PlaySoundBJ(FZESound)
call FZEDamage(caster)
call FZMiniQVisual(owner,'zZ0C',p,3.)
call FZMiniQVisual(owner,'zZ0E',p,4.)
loop
exitwhen i>=2
call FZMiniQVisual(owner,'zZ07',p,3.)
call FZMiniQVisual(owner,'zZ08',p,3.)
set i=i+1
endloop
call RemoveLocation(p)
set p=null
set owner=null
endfunction



function FZRDamage takes unit zoro returns real
local integer level=GetUnitAbilityLevel(zoro,'AZ01')
local real damage=600.+600.*I2R(level)
if level>=5 then
set damage=4000.
endif
if FZHasOken(zoro) then
set damage=damage+I2R(GetHeroStr(zoro,true))+I2R(GetHeroAgi(zoro,true))
endif
return damage
endfunction
function FZRs takes unit zoroHero, unit v returns nothing
local player o=GetOwningPlayer(zoroHero)
local group g=CreateGroup()
local unit d
local location p
local real angle
local real landingX
local real landingY
local integer i=0
call PlaySoundBJ(FZRSound)
call PauseUnit(zoroHero,true)
call PauseUnit(v,true)
call SetUnitInvulnerable(zoroHero,true)
call SetUnitInvulnerable(v,true)
loop
exitwhen i>=15 or GetWidgetLife(v)<=0.405
set p=GetUnitLoc(zoroHero)
set d=CreateUnitAtLoc(o,'zZ13',p,GetUnitFacing(zoroHero))
call RemoveLocation(p)
call UnitApplyTimedLife(d,'BTLF',0.65)
call GroupAddUnit(g,d)
call SetUnitAnimation(d,"attack")
call SetUnitAnimation(zoroHero,"attack")
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",v,"chest"))
set p=GetUnitLoc(zoroHero)
call FZMiniQVisual(o,'zZ0F',p,0.65)
call FZMiniQVisual(o,'zZ10',p,0.65)
call RemoveLocation(p)
call TriggerSleepAction(0.1)
set i=i+1
endloop
set p=GetUnitLoc(v)
call FZMiniQVisual(o,'zZ0A',p,0.8)
call RemoveLocation(p)
set angle=Atan2(GetUnitY(v)-GetUnitY(zoroHero),GetUnitX(v)-GetUnitX(zoroHero))
set landingX=GetUnitX(v)+200.*Cos(angle)
set landingY=GetUnitY(v)+200.*Sin(angle)
call SetUnitInvulnerable(v,false)
if GetWidgetLife(v)>0.405 then
call BvOKindSpellDamage(zoroHero,v,FZRDamage(zoroHero),false,CLEAN)
call DestroyEffect(AddSpecialEffectTarget("Units\\Undead\\Abomination\\AbominationExplosion.mdl",v,"chest"))
endif
set p=Location(landingX,landingY)
call SetUnitPositionLoc(zoroHero,p)
call RemoveLocation(p)
call TriggerSleepAction(0.75)
loop
set d=FirstOfGroup(g)
exitwhen d==null
call GroupRemoveUnit(g,d)
call RemoveUnit(d)
endloop
call DestroyGroup(g)
call SetUnitInvulnerable(zoroHero,false)
call PauseUnit(zoroHero,false)
call PauseUnit(v,false)
call SetUnitAnimation(zoroHero,"stand")
set d=null
set p=null
set g=null
set o=null
set zoroHero=null
set v=null
endfunction

function FZGateTick takes nothing returns nothing
local integer i=1
local integer j
local unit hero
local unit gate
local real dx
local real dy
loop
exitwhen i>12
if FZGateWait[i]>0 then
set FZGateWait[i]=FZGateWait[i]-1
endif
set hero=m[i]
if hero!=null and GetUnitTypeId(hero)=='HZ00' and GetWidgetLife(hero)>0.405 and FZGateWait[i]==0 and not LoadBoolean(FZMiniTable,GetHandleId(hero),40) then
set j=1
loop
exitwhen j>FZGateCount
set gate=FZGate[j]
if gate!=null and WaygateIsActive(gate) then
set dx=GetUnitX(hero)-GetUnitX(gate)
set dy=GetUnitY(hero)-GetUnitY(gate)
if dx*dx+dy*dy<=14400. then
call SetUnitPosition(hero,WaygateGetDestinationX(gate),WaygateGetDestinationY(gate))
set FZGateWait[i]=16
exitwhen true
endif
endif
set j=j+1
endloop
endif
set i=i+1
endloop
set hero=null
set gate=null
endfunction

function FZGateInit takes nothing returns nothing
local group gates=CreateGroup()
local unit gate
local trigger ticker=CreateTrigger()
call GroupEnumUnitsOfType(gates,"nwgt",null)
loop
set gate=FirstOfGroup(gates)
exitwhen gate==null
call GroupRemoveUnit(gates,gate)
set FZGateCount=FZGateCount+1
set FZGate[FZGateCount]=gate
endloop
call DestroyGroup(gates)
call TriggerRegisterTimerEventPeriodic(ticker,0.15)
call TriggerAddAction(ticker,function FZGateTick)
set gates=null
set gate=null
set ticker=null
endfunction

function FZTKillTree takes nothing returns nothing
if GetWidgetLife(GetEnumDestructable())>.405 then
call KillDestructable(GetEnumDestructable())
endif
endfunction
function FZTMoveTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(FZMiniTable,id,0)
local player o=GetOwningPlayer(c)
local location origin=LoadLocationHandle(FZMiniTable,id,4)
local real heading=LoadReal(FZMiniTable,id,10)
local integer tick=LoadInteger(FZMiniTable,id,1)+1
local real dashStep=(800.+100.*I2R(GetUnitAbilityLevel(c,'AZ06')))/10.
local location stepPoint=PolarProjectionBJ(origin,dashStep*I2R(tick),heading)
local location targetPoint
local unit visual
local unit stunDummy
local unit victim
local group nearby=CreateGroup()
local group hit=LoadGroupHandle(FZMiniTable,id,7)
local rect bounds=GetWorldBounds()
local real px=GetLocationX(stepPoint)
local real py=GetLocationY(stepPoint)
local boolean inside=true
local integer substep=1
local real sampleX
local real sampleY
loop
exitwhen substep>5
set sampleX=GetLocationX(origin)+(dashStep*I2R(tick-1)+dashStep/5.*I2R(substep))*Cos(heading*bj_DEGTORAD)
set sampleY=GetLocationY(origin)+(dashStep*I2R(tick-1)+dashStep/5.*I2R(substep))*Sin(heading*bj_DEGTORAD)
if sampleX<GetRectMinX(bounds)+96. or sampleX>GetRectMaxX(bounds)-96. or sampleY<GetRectMinY(bounds)+96. or sampleY>GetRectMaxY(bounds)-96. or IsTerrainPathable(sampleX,sampleY,PATHING_TYPE_WALKABILITY) then
set inside=false
exitwhen true
endif
set substep=substep+1
endloop
if inside then
call SetUnitPositionLocFacingBJ(c,stepPoint,heading)
set bounds=Rect(px-200.,py-200.,px+200.,py+200.)
call EnumDestructablesInRect(bounds,null,function FZTKillTree)
call RemoveRect(bounds)
set visual=CreateUnitAtLoc(o,'zZ12',stepPoint,heading)
call UnitAddAbility(visual,'Aloc')
call UnitApplyTimedLife(visual,'BTLF',0.55)
call GroupEnumUnitsInRange(nearby,GetLocationX(stepPoint),GetLocationY(stepPoint),375.,null)
loop
set victim=FirstOfGroup(nearby)
exitwhen victim==null
call GroupRemoveUnit(nearby,victim)
if (IsUnitEnemy(victim,o) or GetPlayerId(GetOwningPlayer(victim))==PLAYER_NEUTRAL_AGGRESSIVE) and GetWidgetLife(victim)>0.405 and GetUnitAbilityLevel(victim,'Aloc')==0 and not IsUnitInGroup(victim,hit) then
call GroupAddUnit(hit,victim)
set targetPoint=GetUnitLoc(victim)
set stunDummy=CreateUnitAtLoc(o,'zZ01',targetPoint,0.)
call UnitAddAbility(stunDummy,'Aloc')
call UnitAddAbility(stunDummy,'AZ04')
call SetUnitAbilityLevel(stunDummy,'AZ04',1)
call IssueTargetOrderById(stunDummy,852095,victim)
call UnitApplyTimedLife(stunDummy,'BTLF',0.8)
call RemoveLocation(targetPoint)
endif
endloop
endif
call DestroyGroup(nearby)
call RemoveLocation(stepPoint)
if not inside or tick>=10 or GetWidgetLife(c)<=0.405 then
call SetUnitPathing(c,true)
call SetUnitInvulnerable(c,false)
call RemoveSavedBoolean(FZMiniTable,GetHandleId(c),40)
call RemoveLocation(origin)
call TimerStart(t,1.4,false,function FZMiniFinishT)
else
call SaveInteger(FZMiniTable,id,1,tick)
endif
set c=null
set o=null
set origin=null
set stepPoint=null
set targetPoint=null
set visual=null
set stunDummy=null
set victim=null
set nearby=null
set hit=null
set bounds=null
set t=null
endfunction

function FZTStartMove takes unit zoroHero, real heading returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(FZMiniTable,id,0,zoroHero)
call SaveInteger(FZMiniTable,id,1,0)
call SaveLocationHandle(FZMiniTable,id,4,GetUnitLoc(zoroHero))
call SaveReal(FZMiniTable,id,10,heading)
call SaveGroupHandle(FZMiniTable,id,7,CreateGroup())
call SetUnitFacing(zoroHero,heading)
call SetUnitPathing(zoroHero,false)
call SetUnitInvulnerable(zoroHero,true)
call SaveBoolean(FZMiniTable,GetHandleId(zoroHero),40,true)
call TimerStart(t,0.02,true,function FZTMoveTick)
set t=null
set zoroHero=null
endfunction

function FZTRecordOrder takes nothing returns nothing
local unit u=GetOrderedUnit()
local integer id=GetHandleId(u)
if GetUnitTypeId(u)=='HZ00' and GetIssuedOrderId()==OrderId("carrionswarm") then
if GetOrderTargetUnit()!=null then
call SaveUnitHandle(FZMiniTable,id,44,GetOrderTargetUnit())
call RemoveSavedBoolean(FZMiniTable,id,43)
elseif GetOrderTarget()!=null then
call SaveReal(FZMiniTable,id,41,GetWidgetX(GetOrderTarget()))
call SaveReal(FZMiniTable,id,42,GetWidgetY(GetOrderTarget()))
call SaveBoolean(FZMiniTable,id,43,true)
call RemoveSavedHandle(FZMiniTable,id,44)
else
call SaveReal(FZMiniTable,id,41,GetOrderPointX())
call SaveReal(FZMiniTable,id,42,GetOrderPointY())
call SaveBoolean(FZMiniTable,id,43,true)
call RemoveSavedHandle(FZMiniTable,id,44)
endif
endif
if GetUnitTypeId(u)=='HZ00' and GetIssuedOrderId()==OrderId("shockwave") and GetOrderTargetUnit()==null then
call SaveReal(FZMiniTable,id,31,GetOrderPointX())
call SaveReal(FZMiniTable,id,32,GetOrderPointY())
call SaveReal(FZMiniTable,id,34,Atan2(GetOrderPointY()-GetUnitY(u),GetOrderPointX()-GetUnitX(u)))
call SaveBoolean(FZMiniTable,id,33,true)
endif
set u=null
endfunction

function FZMiniSpell takes nothing returns nothing
local integer spell=GetSpellAbilityId()
local unit caster=GetTriggerUnit()
local unit target=GetSpellTargetUnit()
local location point=GetSpellTargetLoc()
local location waveTarget
local unit dummy
local player owner=GetOwningPlayer(caster)
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real tx=x+500.*Cos(GetUnitFacing(caster)*bj_DEGTORAD)
local real ty=y+500.*Sin(GetUnitFacing(caster)*bj_DEGTORAD)
local real dx
local real dy
local real angle
local real distance
local integer i
local group clones
local group hit
local group nearby
local unit victim
local timer q
local timer qmove
if not SilenceConditions(caster) then
set caster=null
set target=null
call RemoveLocation(point)
set point=null
set owner=null
return
endif
if point!=null then
set tx=GetLocationX(point)
set ty=GetLocationY(point)
call RemoveLocation(point)
set point=null
endif
if target!=null then
set tx=GetUnitX(target)
set ty=GetUnitY(target)
endif
if spell=='AZ07' then
set q=CreateTimer()
call SaveUnitHandle(FZMiniTable,GetHandleId(q),0,caster)
call SaveReal(FZMiniTable,GetHandleId(q),8,tx)
call SaveReal(FZMiniTable,GetHandleId(q),9,ty)
call SaveTimerHandle(FZMiniTable,GetHandleId(caster),20,q)
call SetUnitPathing(caster,false)
call PlaySoundBJ(FZQSound)
set qmove=CreateTimer()
call SaveUnitHandle(FZMiniTable,GetHandleId(qmove),0,caster)
call SaveTimerHandle(FZMiniTable,GetHandleId(qmove),1,q)
call SaveReal(FZMiniTable,GetHandleId(qmove),8,tx)
call SaveReal(FZMiniTable,GetHandleId(qmove),9,ty)
call TimerStart(qmove,0.05,false,function FZMiniQMove)
call TimerStart(q,0.20,false,function FZMiniQFinish)
set qmove=null
elseif spell=='AZ08' then
if LoadUnitHandle(FZMiniTable,GetHandleId(caster),44)!=null then
set tx=GetUnitX(LoadUnitHandle(FZMiniTable,GetHandleId(caster),44))
set ty=GetUnitY(LoadUnitHandle(FZMiniTable,GetHandleId(caster),44))
elseif LoadBoolean(FZMiniTable,GetHandleId(caster),43) then
set tx=LoadReal(FZMiniTable,GetHandleId(caster),41)
set ty=LoadReal(FZMiniTable,GetHandleId(caster),42)
endif
call FZWStart(caster,tx,ty)
elseif spell=='AZ09' then
call FZEStart(caster)
elseif spell=='AZ06' then
call PlaySoundBJ(FZTSound)
if LoadBoolean(FZMiniTable,GetHandleId(caster),33) then
set angle=LoadReal(FZMiniTable,GetHandleId(caster),34)
call RemoveSavedBoolean(FZMiniTable,GetHandleId(caster),33)
else
set angle=Atan2(ty-y,tx-x)
if (tx-x)*(tx-x)+(ty-y)*(ty-y)<1. then
set angle=GetUnitFacing(caster)*bj_DEGTORAD
endif
endif
set point=Location(x,y)
set dummy=CreateUnitAtLoc(owner,'zZ02',point,0.)
call UnitApplyTimedLife(dummy,'BTLF',2.)
set dx=x+30.*Cos(angle)
set dy=y+30.*Sin(angle)
set waveTarget=PolarProjectionBJ(point,30.,angle*bj_RADTODEG)
call RemoveLocation(point)
call IssuePointOrderLocBJ(dummy,"shockwave",waveTarget)
call RemoveLocation(waveTarget)
set point=null
set waveTarget=null
call FZTStartMove(caster,angle*bj_RADTODEG)
elseif spell=='AZ01' and target!=null then
call FZRs(caster,target)
endif
set owner=null
set caster=null
set target=null
set dummy=null
set victim=null
set nearby=null
set point=null
set q=null
set qmove=null
endfunction

function FZStatsOnLevel takes nothing returns nothing
local unit hero=GetLevelingUnit()
local integer level
local integer strength
local integer agility
local integer intelligence
if GetUnitTypeId(hero)=='HZ00' then
set level=GetHeroLevel(hero)-1
set strength=30+R2I(3.25*I2R(level)+0.5)
set agility=40+R2I(3.25*I2R(level)+0.5)
set intelligence=20+R2I(2.5*I2R(level)+0.5)
if GetHeroStr(hero,false)<strength then
call SetHeroStr(hero,strength,true)
endif
if GetHeroAgi(hero,false)<agility then
call SetHeroAgi(hero,agility,true)
endif
if GetHeroInt(hero,false)<intelligence then
call SetHeroInt(hero,intelligence,true)
endif
endif
set hero=null
endfunction



function FZStatsInit takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_HERO_LEVEL)
call TriggerAddAction(t,function FZStatsOnLevel)
set t=null
endfunction

function FZMiniInit takes nothing returns nothing
local trigger t=CreateTrigger()
local trigger orderTrigger=CreateTrigger()
local trigger s=CreateTrigger()
set FZMiniTable=InitHashtable()
set FZQSound=CreateSound("FOCSZoro\\asset044.mp3",false,false,false,10,10,"")
call SetSoundDuration(FZQSound,2499)
call SetSoundChannel(FZQSound,0)
call SetSoundVolume(FZQSound,127)
call SetSoundPitch(FZQSound,1.)
set FZWSound=CreateSound("FOCSZoro\\asset047.mp3",false,false,false,10,10,"")
call SetSoundDuration(FZWSound,4002)
call SetSoundChannel(FZWSound,0)
call SetSoundVolume(FZWSound,127)
call SetSoundPitch(FZWSound,1.)
set FZESound=CreateSound("FOCSZoro\\asset043.mp3",false,false,false,10,10,"")
call SetSoundDuration(FZESound,5086)
call SetSoundChannel(FZESound,0)
call SetSoundVolume(FZESound,127)
call SetSoundPitch(FZESound,1.)
set FZRSound=CreateSound("FOCSZoro\\asset048.mp3",false,false,false,10,10,"")
call SetSoundDuration(FZRSound,747)
call SetSoundChannel(FZRSound,0)
call SetSoundVolume(FZRSound,127)
call SetSoundPitch(FZRSound,1.)
set FZTSound=CreateSound("FOCSZoro\\asset045.mp3",false,false,false,10,10,"")
call SetSoundDuration(FZTSound,4539)
call SetSoundChannel(FZTSound,0)
call SetSoundVolume(FZTSound,127)
call SetSoundPitch(FZTSound,1.)
set FZVTable=InitHashtable()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
