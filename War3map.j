return IsUnitDeadBJ(tf[2])==false
endfunction
function Frx takes nothing returns nothing
set tf[2]=GetEnumUnit()
call GroupAddUnit(Bf,tf[2])
// Ice Age as in 1.1A: 2000 + 20/40/60/80/100 x hero level damage, frozen for 4 seconds
call DamageUnit(jf[17],tf[2],RBValue(GetUnitAbilityLevel(jf[17],'A09H'),6.,7.,8.,9.,10.,10.)*GetHeroStr(jf[17],false),MAGICAL,SPELL)
call DamageUnit(jf[17],tf[2],1000.+RBValue(GetUnitAbilityLevel(jf[17],'A09H'),1.,2.,3.,4.,5.,5.)*GetHeroAgi(jf[17],true)+GetHeroInt(jf[17],true),PHYSICAL,SPELL)
if Fox() then
call CreateNUnitsAtLoc(1,$75303032,GetOwningPlayer(jf[17]),kf[11],bj_UNIT_FACING)
set jf[18]=bj_lastCreatedUnit
call UnitAddAbility(jf[18],'RKT2')
call SetUnitAbilityLevel(jf[18],'RKT2',GetUnitAbilityLevel(jf[17],'A09H'))
call IssueTargetOrderById(jf[18],852095,tf[2])
call UnitApplyTimedLifeBJ(1.,$42544C46,jf[18])
set jf[18]=null
endif
call AddSpecialEffectTargetUnitBJ("origin",tf[2],"Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl")
call DestroyEffect(bj_lastCreatedEffect)
set tf[2]=null
endfunction
function Fix takes nothing returns boolean
return of[5]<8
endfunction
function Fax takes nothing returns nothing
if Fix() then
set of[5]=of[5]+1
set rf[2]=1
loop
exitwhen rf[2]>8*of[5]
set of[6]=of[6]+360/(8*of[5])
set kf[11]=PG(kf[10],175.*I2R(of[5]),I2R(of[6]))
call CreateNUnitsAtLoc(1,$68303134,GetOwningPlayer(jf[17]),kf[11],GetRandomReal(0,360))
set af=bj_lastCreatedUnit
if f1x() then
call SetUnitScalePercent(af,100.,100.,100.)
else
call SetUnitScalePercent(af,25.*I2R(of[5]),25.*I2R(of[5]),25.*I2R(of[5]))
endif
call UnitApplyTimedLifeBJ(.5,$42544C46,af)
set af=null
call AddSpecialEffectLocBJ(kf[11],"Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathMissile.mdl")
call DestroyEffect(bj_lastCreatedEffect)
call AddSpecialEffectLocBJ(kf[11],"Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl")
call DestroyEffect(bj_lastCreatedEffect)
set Af=e6(300.,kf[11],Condition(function Fxx))
call ForGroupBJ(Af,function Frx)
call DestroyGroup(Af)
set Af=null
call RemoveLocation(kf[11])
set kf[11]=null
set rf[2]=rf[2]+1
endloop
call SetTerrainTypeBJ(kf[10],$57736E77,-1,3+of[5],0)
set of[6]=0
else
call DisableTrigger(GetTriggeringTrigger())
endif
endfunction
function Fnx takes nothing returns nothing
set P3=CreateTrigger()
call DisableTrigger(P3)
call TriggerRegisterTimerEventPeriodic(P3,.08)
call TriggerAddAction(P3,function Fax)
endfunction
