function ULQ_PreloadSpearModels takes nothing returns nothing
local integer ulquiorraDummyTypeIndex=0
local integer array ulquiorraDummyTypes
local unit ulquiorraPreloadDummy
set ulquiorraDummyTypes[0]=0x6D303135
set ulquiorraDummyTypes[1]=0x6D303136
set ulquiorraDummyTypes[2]=0x6D303137
set ulquiorraDummyTypes[3]=0x6D303138
loop
exitwhen ulquiorraDummyTypeIndex>3
set ulquiorraPreloadDummy=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),ulquiorraDummyTypes[ulquiorraDummyTypeIndex],-7600.,-6800.,0)
call RemoveUnit(ulquiorraPreloadDummy)
set ulquiorraDummyTypeIndex=ulquiorraDummyTypeIndex+1
endloop
set ulquiorraPreloadDummy=null
endfunction
