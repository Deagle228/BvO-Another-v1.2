function GetNumberOfItemsId takes unit whichUnit,integer itemId returns integer
local integer index
local item indexItem
local integer count=0
set index=0
loop
set indexItem=UnitItemInSlot(whichUnit,index)
if indexItem!=null and GetItemTypeId(indexItem)==itemId then
set count=count+1
endif
set index=index+1
exitwhen index>=bj_MAX_INVENTORY
endloop
return count
endfunction
function BonecrusherLimit_Cond takes nothing returns boolean
return GetItemTypeId(GetManipulatedItem())==$4930304B
endfunction
function BonecrusherLimit takes nothing returns nothing
if GetNumberOfItemsId(GetTriggerUnit(),$4930304B)>1 or (GetNumberOfItemsId(GetTriggerUnit(),$4930304B)==1 and UnitHasItemOfTypeBJ(GetTriggerUnit(),$49303535)) then
call UnitRemoveItemSwapped(GetManipulatedItem(),GetTriggerUnit())
if GetOwningPlayer(GetTriggerUnit())==GetLocalPlayer() then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"|cffc3dbffYou can only have one copy of this item.|r")
endif
endif
endfunction
function KumaBookReplace_Cond takes nothing returns boolean
return GetItemTypeId(GetManipulatedItem())==$49303536 or GetItemTypeId(GetManipulatedItem())==$64657363 and MG(GetManipulatingUnit(),UNIT_TYPE_HERO)
endfunction
function KumaBookReplace takes nothing returns nothing
// a book that was refused (dropped again) is not converted
if not UnitHasItem(GetTriggerUnit(),GetManipulatedItem()) then
return
endif
if GetItemTypeId(GetManipulatedItem())==$49303536 then
call RemoveItem(GetManipulatedItem())
call UnitAddItemByIdSwapped($64657363,GetManipulatingUnit())
endif
endfunction
