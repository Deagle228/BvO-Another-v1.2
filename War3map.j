function Lvv takes nothing returns nothing
if GetPlayerId(GetOwningPlayer(GetTriggerUnit()))<5 then
if GlobalHexCooldownTeamOne<=0 then
set GlobalHexCooldownTeamOne=70
call ForGroupBJ(YG(bj_mapInitialPlayableArea,Condition(function l8v)),function l9v)
else
call SetUnitState(Hero,UNIT_STATE_MANA,GetUnitState(Hero,UNIT_STATE_MANA)+600)
endif
else
if GlobalHexCooldownTeamTwo<=0 then
set GlobalHexCooldownTeamTwo=70
call ForGroupBJ(YG(bj_mapInitialPlayableArea,Condition(function l8v)),function l9v)
else
call SetUnitState(Hero,UNIT_STATE_MANA,GetUnitState(Hero,UNIT_STATE_MANA)+600)
endif
endif
endfunction
