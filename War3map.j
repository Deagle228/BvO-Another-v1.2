else
call UnitRemoveAbility(LoadUnitHandle(ULQ_HashTable,-12189,this),0x5A533032)
call ULQ_SetLuzMarker(LoadUnitHandle(ULQ_HashTable,-12189,this),false)
call ULQ_SyncResurreccionBook(LoadUnitHandle(ULQ_HashTable,-12189,this))
call SaveUnitHandle(ULQ_HashTable,-12189,this,null)
call ULQ_s__UlquiorraSpells__UlquiorraT_StopAction(this,i)
call ULQ_s__UlquiorraSpells__UlquiorraT_deallocate(this)
endif
set i=i+1
endloop
endfunction
