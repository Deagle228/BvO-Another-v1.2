call DamageUnit(inoueCaster,inoueTarget,inoueDamage,CLEAN,SPELL)
call SetUnitState(inoueTarget,UNIT_STATE_MANA,GetUnitState(inoueTarget,UNIT_STATE_MANA)-inoueDamage*.5)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",inoueTarget,"origin"))
endif
if inoueRefreshControl then
call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_POSITIVE,inoueTarget)
call CastToTarget(inoueCaster,inoueTarget,'A0EI',1,"slow")
endif
endif
else
call GroupRemoveUnit(inoueEnemies,inoueTarget)
if not InoueTContainsTarget(inoueTarget) then
call InoueTReleaseControl(inoueTarget)
endif
endif
endloop
if inoueDamageTick then
set inouePeriod=inouePeriod-L_R(inoueFieldId,"damagePeriodic")
endif
if inoueRefreshControl then
set inoueControlPeriod=0.
endif
call S_R(inoueFieldId,"controlPeriod",inoueControlPeriod)
call S_R(inoueFieldId,"period",inouePeriod)
call S_R(inoueFieldId,"time",inoueTime)
endif
call DestroyGroup(inoueTargets)
set inoueTargets=null
set inoueEnemies=null
set inoueTarget=null
set inoueCaster=null
set inoueVisual=null
set inoueFieldTimer=null
endfunction
