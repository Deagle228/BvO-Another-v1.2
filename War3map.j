function KenbunshokuEvasionCheck takes nothing returns nothing
local timer checkTimer=GetExpiredTimer()
local unit holder=LoadUnitHandle(KenbunshokuHash,GetHandleId(checkTimer),0)
local boolean holds=UnitHasItemOfTypeBJ(holder,KENBUNSHOKU_ITEM)
if holds and GetUnitAbilityLevel(holder,KENBUNSHOKU_EVASION)==0 then
call UnitAddAbility(holder,KENBUNSHOKU_EVASION)
call UnitMakeAbilityPermanent(holder,true,KENBUNSHOKU_EVASION)
elseif not holds and GetUnitAbilityLevel(holder,KENBUNSHOKU_EVASION)>0 then
call UnitRemoveAbility(holder,KENBUNSHOKU_EVASION)
endif
call FlushChildHashtable(KenbunshokuHash,GetHandleId(checkTimer))
call DestroyTimer(checkTimer)
set checkTimer=null
set holder=null
endfunction
