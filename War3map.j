return GetItemTypeId(GetManipulatedItem())==$49303149 and o4[1+GetPlayerId(GetOwningPlayer(GetManipulatingUnit()))]==false and MG(GetManipulatingUnit(),UNIT_TYPE_HERO) and Wiv()
