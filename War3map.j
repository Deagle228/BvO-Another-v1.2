endfunction
function LKv takes nothing returns boolean
return GetBooleanAnd(LJv(),Lkv()) and (UnitHasItemOfTypeBJ(m[1+GetPlayerId(GetOwningPlayer(GetKillingUnit()))],$49303039) or UnitHasItemOfTypeBJ(m[1+GetPlayerId(GetOwningPlayer(GetKillingUnit()))],'IY01'))
endfunction
// Blood Sword / Nanatsu Yoru: killing an enemy hero steals 150 maximum life from it for good, Nanatsu Yoru also 2 of
// every attribute. The maximum life changes through AYL1 / AYL2 (item life bonus +150 / -150 at level 2: added, set
// to level 2 and removed, the bonus stays).
function BloodSwordChangeMaxLife takes unit lifeUnit,integer lifeAbility returns nothing
call UnitAddAbility(lifeUnit,lifeAbility)
call SetUnitAbilityLevel(lifeUnit,lifeAbility,2)
call UnitRemoveAbility(lifeUnit,lifeAbility)
endfunction
function BloodSwordOnKill takes unit swordHolder,unit killedUnit returns nothing
if swordHolder==null or killedUnit==null or not IsUnitType(killedUnit,UNIT_TYPE_HERO) or IsUnitIllusion(killedUnit) or not IsUnitEnemy(killedUnit,GetOwningPlayer(swordHolder)) then
return
endif
call BloodSwordChangeMaxLife(swordHolder,'AYL1')
if GetUnitState(killedUnit,UNIT_STATE_MAX_LIFE)>650. then
call BloodSwordChangeMaxLife(killedUnit,'AYL2')
endif
if UnitHasItemOfTypeBJ(swordHolder,'IY01') then
call SetHeroStr(swordHolder,GetHeroStr(swordHolder,false)+4,true)
call SetHeroAgi(swordHolder,GetHeroAgi(swordHolder,false)+4,true)
call SetHeroInt(swordHolder,GetHeroInt(swordHolder,false)+4,true)
call SetHeroStr(killedUnit,IMaxBJ(1,GetHeroStr(killedUnit,false)-4),true)
call SetHeroAgi(killedUnit,IMaxBJ(1,GetHeroAgi(killedUnit,false)-4),true)
call SetHeroInt(killedUnit,IMaxBJ(1,GetHeroInt(killedUnit,false)-4),true)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactCaster.mdl",swordHolder,"origin"))
endfunction
function Llv takes nothing returns nothing
call BloodSwordOnKill(m[1+GetPlayerId(GetOwningPlayer(GetKillingUnit()))],GetDyingUnit())
endfunction
