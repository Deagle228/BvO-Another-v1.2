function BvOFreeSpellsRequested takes string modeText returns boolean
local integer modeTextLength=StringLength(modeText)
local integer modeCodeStart=1
loop
exitwhen modeCodeStart+1>modeTextLength
if SubString(modeText,modeCodeStart,modeCodeStart+1)==" " then
set modeCodeStart=modeCodeStart+1
else
if SubString(modeText,modeCodeStart,modeCodeStart+2)=="fs" then
return true
endif
set modeCodeStart=modeCodeStart+2
endif
endloop
return false
endfunction
function BvOFreeSpellsAppliesTo takes unit freeSpellsHero returns boolean
return BvOFreeSpellsEnabled and freeSpellsHero!=null and GetUnitTypeId(freeSpellsHero)!=0 and IsUnitType(freeSpellsHero,UNIT_TYPE_HERO) and not IsUnitIllusion(freeSpellsHero) and GetPlayerId(GetOwningPlayer(freeSpellsHero))<12
endfunction
function BvOFreeSpellsRefillMana takes unit freeSpellsHero returns nothing
if BvOFreeSpellsAppliesTo(freeSpellsHero) and GetWidgetLife(freeSpellsHero)>.405 then
if GetUnitAbilityLevel(freeSpellsHero,'AFSm')==0 and UnitAddAbility(freeSpellsHero,'AFSm') then
call UnitMakeAbilityPermanent(freeSpellsHero,true,'AFSm')
endif
call SetUnitState(freeSpellsHero,UNIT_STATE_MANA,GetUnitState(freeSpellsHero,UNIT_STATE_MAX_MANA))
endif
endfunction
function BvOFreeSpellsResetAfterCast takes nothing returns nothing
local timer freeSpellsResetTimer=GetExpiredTimer()
local unit freeSpellsHero=LoadUnitHandle(Hash,GetHandleId(freeSpellsResetTimer),StringHash("FreeSpellsHero"))
if BvOFreeSpellsAppliesTo(freeSpellsHero) then
call UnitResetCooldown(freeSpellsHero)
call BvOFreeSpellsRefillMana(freeSpellsHero)
endif
call FlushChildHashtable(Hash,GetHandleId(freeSpellsResetTimer))
call DestroyTimer(freeSpellsResetTimer)
set freeSpellsResetTimer=null
set freeSpellsHero=null
endfunction
function BvOFreeSpellsOnCast takes nothing returns boolean
local unit freeSpellsHero=GetTriggerUnit()
local timer freeSpellsResetTimer
if BvOFreeSpellsAppliesTo(freeSpellsHero) then
call BvOFreeSpellsRefillMana(freeSpellsHero)
set freeSpellsResetTimer=CreateTimer()
call SaveUnitHandle(Hash,GetHandleId(freeSpellsResetTimer),StringHash("FreeSpellsHero"),freeSpellsHero)
call TimerStart(freeSpellsResetTimer,0.,false,function BvOFreeSpellsResetAfterCast)
endif
set freeSpellsResetTimer=null
set freeSpellsHero=null
return false
endfunction
function BvOFreeSpellsRefillPlayerHeroes takes nothing returns nothing
local group freeSpellsHeroes=CreateGroup()
local unit freeSpellsHero
local integer freeSpellsPlayerIndex=0
loop
exitwhen freeSpellsPlayerIndex>=12
call GroupEnumUnitsOfPlayer(freeSpellsHeroes,Player(freeSpellsPlayerIndex),null)
loop
set freeSpellsHero=FirstOfGroup(freeSpellsHeroes)
exitwhen freeSpellsHero==null
call GroupRemoveUnit(freeSpellsHeroes,freeSpellsHero)
call BvOFreeSpellsRefillMana(freeSpellsHero)
endloop
set freeSpellsPlayerIndex=freeSpellsPlayerIndex+1
endloop
call DestroyGroup(freeSpellsHeroes)
set freeSpellsHeroes=null
set freeSpellsHero=null
endfunction
function BvOFreeSpellsEnable takes nothing returns nothing
local trigger freeSpellsCastTrigger
local integer freeSpellsPlayerIndex=0
if BvOFreeSpellsEnabled then
return
endif
set BvOFreeSpellsEnabled=true
set g4=true
set m4=m4+"fs"
if I7 then
set H7=H7+"/|c007ebff1Free Spells|r"
else
set H7=H7+"|c007ebff1Free Spells|r"
endif
set I7=true
loop
exitwhen freeSpellsPlayerIndex>=12
if BvOSlotState(Player(freeSpellsPlayerIndex))==PLAYER_SLOT_STATE_PLAYING then
call SetPlayerState(Player(freeSpellsPlayerIndex),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(freeSpellsPlayerIndex),PLAYER_STATE_RESOURCE_GOLD)+99999)
call SetPlayerState(Player(freeSpellsPlayerIndex),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(freeSpellsPlayerIndex),PLAYER_STATE_RESOURCE_LUMBER)+99999)
endif
set freeSpellsPlayerIndex=freeSpellsPlayerIndex+1
endloop
set freeSpellsCastTrigger=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(freeSpellsCastTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(freeSpellsCastTrigger,Condition(function BvOFreeSpellsOnCast))
call TimerStart(CreateTimer(),.1,true,function BvOFreeSpellsRefillPlayerHeroes)
set freeSpellsCastTrigger=null
endfunction
